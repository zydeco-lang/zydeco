'--lint-types[Re-validate the finished typed arena after every successful check, reporting internal compiler errors (debugging aid)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_zydeco_commands" \
"*::: :->zydeco-cli" \
&& ret=0
    case $state in
    (zydeco-cli)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:zydeco-command-$line[1]:"
        case $line[1] in
            (show)
_arguments "${_arguments_options[@]}" : \
'*-p+[Select declared packages by name; omit to list all packages]:NAME:_default' \
'*--pkg=[Select declared packages by name; omit to list all packages]:NAME:_default' \
'*--package=[Select declared packages by name; omit to list all packages]:NAME:_default' \
'--lint-types[Re-validate the finished typed arena after every successful check, reporting internal compiler errors (debugging aid)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(passes)
_arguments "${_arguments_options[@]}" : \
'--sps-passes=[Explain \`default\`, \`none\`, or a comma-separated list such as normalize,normalize]:PLAN:_default' \
'--lint-types[Re-validate the finished typed arena after every successful check, reporting internal compiler errors (debugging aid)]' \
'-h[Print help]' \
