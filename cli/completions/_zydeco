(( $+functions[_zydeco_commands] )) ||
_zydeco_commands() {
    local commands; commands=(
'show:List the project'\''s packages and relationships without checking or executing code' \
'passes:List optional compiler passes or explain a selected high-SPS plan' \
'__doc-example-worker:' \
'doc:Read, search, generate, or verify project documentation' \
'fmt:Format Zydeco source files in place' \
'run:Run a zydeco program' \
'check:Check a source package and its code dependencies, including its declared executable role' \
'test:Run explicitly selected test packages with empty stdin' \
'repl:Start the declaration-free terminal REPL' \
'build:Build a Zydeco program for the selected target' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'zydeco commands' commands "$@"
}
