use crate::textual::{
    syntax::*, lexer::*, escape::self,
    parser::{LiteralFailure, LiteralParser, ParsedNode, ParserToken, RecoveryAccumulator},
};

// LALRPOP grammar for the textual surface syntax.
grammar<'input, 'arena, 'recovery>(
    input: &'input str,
    parser: &'arena mut Parser,
    recovery: &'recovery mut RecoveryAccumulator<'input>,
);

//* --------------------------------- Tokens --------------------------------- */

extern {
    type Location = usize;
    type Error = LiteralFailure;

    // Token mapping must stay in sync with `textual::lexer::Tok`.
    enum ParserToken<'input> {
        "UpperId" => ParserToken::Lexical(Tok::UpperIdent(<&'input str>)),
        "LowerId" => ParserToken::Lexical(Tok::LowerIdent(<&'input str>)),
        "FieldId" => ParserToken::Lexical(Tok::FieldIdent(<&'input str>)),
        "CtorId" => ParserToken::Lexical(Tok::CtorIdent(<&'input str>)),
        "DtorId" => ParserToken::Lexical(Tok::DtorIdent(<&'input str>)),

        "end" => ParserToken::Lexical(Tok::End),
        "begin" => ParserToken::Lexical(Tok::Begin),
        "data" => ParserToken::Lexical(Tok::Data),
        "codata" => ParserToken::Lexical(Tok::Codata),
        "as" => ParserToken::Lexical(Tok::As),
        "define" => ParserToken::Lexical(Tok::Define),
        "let" => ParserToken::Lexical(Tok::Let),
        "param" => ParserToken::Lexical(Tok::Param),
        "val" => ParserToken::Lexical(Tok::Val),
        "in" => ParserToken::Lexical(Tok::In),
        "that" => ParserToken::Lexical(Tok::That),
        "do" => ParserToken::Lexical(Tok::Do),
        "ret" => ParserToken::Lexical(Tok::Ret),
        "fn" => ParserToken::Lexical(Tok::Fn),
        "pi" => ParserToken::Lexical(Tok::Pi),
        "fix" => ParserToken::Lexical(Tok::Fix),
        "match" => ParserToken::Lexical(Tok::Match),
        "comatch" => ParserToken::Lexical(Tok::Comatch),
        "forall" => ParserToken::Lexical(Tok::Forall),
        "exists" => ParserToken::Lexical(Tok::Exists),
        "sigma" => ParserToken::Lexical(Tok::Sigma),
        "pack" => ParserToken::Lexical(Tok::Pack),
        "where" => ParserToken::Lexical(Tok::Where),
        "is" => ParserToken::Lexical(Tok::Is),

        "FloatLit" => ParserToken::Lexical(Tok::FloatLit(<&'input str>)),
        "IntLit" => ParserToken::Lexical(Tok::IntLit(<&'input str>)),
        "StrLit" => ParserToken::Lexical(Tok::StrLit(<&'input str>)),
        "CharLit" => ParserToken::Lexical(Tok::CharLit(<&'input str>)),

        "(" => ParserToken::Lexical(Tok::ParenOpen),
        ")" => ParserToken::Lexical(Tok::ParenClose),
        "[" => ParserToken::Lexical(Tok::BracketOpen),
        "]" => ParserToken::Lexical(Tok::BracketClose),
        "{" => ParserToken::Lexical(Tok::BraceOpen),
        "}" => ParserToken::Lexical(Tok::BraceClose),
        "," => ParserToken::Lexical(Tok::Comma),
        ":" => ParserToken::Lexical(Tok::Colon),
        "::" => ParserToken::Lexical(Tok::ColonColon),
        "=" => ParserToken::Lexical(Tok::Equals),
        ";" => ParserToken::Lexical(Tok::Semicolon),
        "!" => ParserToken::Lexical(Tok::Force),
        "/" => ParserToken::Lexical(Tok::Slash),
        "|" => ParserToken::Lexical(Tok::Branch),
        "+" => ParserToken::Lexical(Tok::Plus),
        "*" => ParserToken::Lexical(Tok::Star),
        "." => ParserToken::Lexical(Tok::Dot),
        "=>" => ParserToken::Lexical(Tok::TermArrow),
        "->" => ParserToken::Lexical(Tok::TypeArrow),
        "~>" => ParserToken::Lexical(Tok::ViewArrow),
        "|>" => ParserToken::Lexical(Tok::PipeForward),
        "<|" => ParserToken::Lexical(Tok::PipeBackward),
        "<-" => ParserToken::Lexical(Tok::Assign),
        "_" => ParserToken::Lexical(Tok::Hole),
        "@" => ParserToken::Lexical(Tok::At),
        "Completion" => ParserToken::Completion,
        // A known terminal with no successful production: LALRPOP can recover
        // from lexical errors using the same two `!` alternatives as syntax errors.
        "Invalid" => ParserToken::Invalid(<LexicalError>),
    }
}

//* -------------------------------- Utilities ------------------------------- */

// Attach a span to a parsed node.
Sp<T>: Sp<T> = <l:@L> <inner:T> <r:@R> => Sp {
    info: Span::new(l, r), inner,
};

// Parse a delimited sequence with optional trailing item.
SepByDelim<Start, Sep, T, End>: Vec<T> = {
    Start <mut v: (<T> Sep)*> <last: T?> End => {
        match last {
            None => { },
            Some(t) => { v.push(t); }
        };
        v
    }
};

//* -------------------------------- Terminals ------------------------------- */

Integer: IntegerLiteral = <start:@L> <value:"IntLit"> <end:@R> =>? {
    Ok(LiteralParser { range: start..end }.integer(value)?)
};
Float: FloatLiteral = <start:@L> <value:"FloatLit"> <end:@R> =>? {
    Ok(LiteralParser { range: start..end }.float(value)?)
};
String: String = <s:"StrLit"> => {
    escape::apply_string_escapes(&s[1..s.len()-1])
};
Char: char = <"CharLit"> => escape::apply_char_escapes(<>);

Literal: Literal = {
    <Integer> => <>.into(),
    <Float> => <>.into(),
    <String> => Utf8String::from(<>).into(),
    <Char> => <>.into(),
};

//* ------------------------------- Identifiers ------------------------------ */

#[inline]
MixedId: String = { <"UpperId"> => <>.into(), <"LowerId"> => <>.into(), };

// Metadata occupies its own namespace, so language keywords remain useful as
// closed role names inside an annotation.
MetaName: String = {
    <MixedId>,
    "end" => "end".into(),
    "begin" => "begin".into(),
    "data" => "data".into(),
    "codata" => "codata".into(),
    "as" => "as".into(),
    "define" => "define".into(),
    "let" => "let".into(),
    "param" => "param".into(),
    "val" => "val".into(),
    "in" => "in".into(),
    "that" => "that".into(),
    "do" => "do".into(),
    "ret" => "ret".into(),
    "fn" => "fn".into(),
    "pi" => "pi".into(),
    "fix" => "fix".into(),
    "match" => "match".into(),
    "comatch" => "comatch".into(),
    "forall" => "forall".into(),
    "exists" => "exists".into(),
    "sigma" => "sigma".into(),
    "pack" => "pack".into(),
    "where" => "where".into(),
    "is" => "is".into(),
};

VarName: VarName = <MixedId> => VarName(<>);
FieldName: FieldName = <name:VarName> => FieldName(name.0);
// `#field` marks a field name that stands on the left of `=` or `::`,
// where a bare identifier would read as a variable or binder instead.
MarkedFieldName: FieldName = <name:"FieldId"> => FieldName(name[1..].to_string());
CtorName: CtorName = <"CtorId"> => CtorName(<>.into());
DtorName: DtorName = <"DtorId"> => DtorName(<>.into());

NameDef<T>: NameDef<T> = <T> => NameDef(<>);

DefId: DefId = <NameDef<Sp<VarName>>> => parser.def(<>.0);

//* ------------------------------- Structural ------------------------------- */

Paren<T>: Paren<T> = SepByDelim<"(", ",", <T>, ")"> => Paren(<>);
App<T>: App<T> = <T*> => Appli(<>);
Ann<Tm, Ty>: Ann<Tm, Ty> = <tm:Tm> ":" <ty:Ty> => Ann {<>};
Hole: Hole = "_" => Hole;

//* ---------------------------------- Meta ---------------------------------- */

MetaTerm<T>: MetaTerm<T> = "@" "[" <Meta> "]" <T> => MetaTerm(<>);
MetaAnnotation: Sp<MetaId> = <start:@L> <inner:MetaAnnotationInner> <end:@R> => {
    parser.metadata_prefix(inner, start);
    Span::new(start, end).make(inner)
};
MetaAnnotationInner: MetaId = "@" "[" <Meta> "]" => <>;
Meta: MetaId = <Sp<MetaNode>> => parser.meta(<>);
MetaNode: MetaNode = {
    <value:String> => MetaNode::String(value),
    <start:@L> <value:"IntLit"> <end:@R> =>? {
        Ok(MetaNode::Integer(LiteralParser { range: start..end }.metadata_integer(value)?))
    },
    <name:MetaName> => MetaNode::Ident(name),
    <callee:MetaName> <args:SepByDelim<"(", ",", <Meta>, ")">> => MetaNode::Apply { callee, args },
};

//* --------------------------------- Pattern -------------------------------- */

PatternGen<P>: PatId = <Sp<P>> => recovery.alloc_pattern(parser, <>);

#[inline]
PatternAnnId: PatId = <PatternGen<PatternAnn>>;

PatternAnn: ParsedNode<Pattern> = {
    #[precedence(level="0")]
    <Pattern>,

    #[precedence(level="1")] #[assoc(side="none")]
    <Ann<PatternGen<PatternAnn>, TermId>> => ParsedNode::Syntax(<>.into()),

    #[precedence(level="2")] #[assoc(side="right")]
    "=" <l:@L> <field:Sp<FieldName>> <ty:(":" <TermId>)?> <r:@R> => {
        let ty = ty.map(|ty| Sp {
            info: Span::new(l, r),
            inner: ty,
        });
        ParsedNode::Syntax(parser.pun_pattern(field, ty))
    },
    #[precedence(level="2")] #[assoc(side="right")]
    <name:MarkedFieldName> "=" <inner:PatternGen<PatternAnn>> => ParsedNode::Syntax(Named(name, inner).into()),
    #[precedence(level="2")] #[assoc(side="right")]
    "/" <l:@L> <field:Sp<FieldName>> <ty:(":" <TermId>)?> <r:@R> => {
        let ty = ty.map(|ty| Sp {
            info: Span::new(l, r),
            inner: ty,
        });
        ParsedNode::Syntax(parser.pun_projection_pattern(field, ty))
    },
    #[precedence(level="2")] #[assoc(side="right")]
    "/" <name:FieldName> "=" <inner:PatternGen<PatternAnn>> => {
        ParsedNode::Syntax(ProjectionPattern(name, inner).into())
    },
};

#[inline]
PatId: PatId = <PatternGen<Pattern>>;
ViewPatternHead: TermId = {
    <l:@L> <name:VarName> <r:@R> => parser.term(Span::new(l, r).make(Term::Var(name))),
    <l:@L> <name:VarName> "[" <first:TermId> <rest:("," <TermId>)*>
        <_trailing:","?> "]" <r:@R> => {
        let span = Span::new(l, r);
        let head = parser.term(span.make(Term::Var(name)));
        let terms = std::iter::once(head)
            .chain(std::iter::once(first))
            .chain(rest)
            .collect();
        parser.term(span.make(Term::App(Appli(terms))))
    },
};
Pattern: ParsedNode<Pattern> = {
    <l:@L> <error:!> <r:@R> => recovery.recover(l..r, error),
    <function:ViewPatternHead> "~>" <pattern:PatId> => ParsedNode::Syntax(ViewPattern { function, pattern }.into()),
    <Hole> => ParsedNode::Syntax(<>.into()),
    <DefId> => ParsedNode::Syntax(<>.into()),
    <ctor:CtorName> <pat:PatId> => ParsedNode::Syntax(Ctor(<>).into()),
    "(" <binder:PatternAnnId> "as" <definition:TermId> ")" => {
        ParsedNode::Syntax(ManifestPattern { binder, definition }.into())
    },
    "(" <first:PatternAnnId> ";" <second:PatternAnnId>
        <rest:(";" <PatternAnnId>)*> ")" => {
        let patterns = std::iter::once(first)
            .chain(std::iter::once(second))
            .chain(rest)
            .collect::<Vec<_>>();
        ParsedNode::Syntax(Alias(ConsN::from_vec(patterns).unwrap()).into())
    },
    <Paren<PatternAnnId>> => ParsedNode::Syntax(<>.into()),
};

pub SinglePattern: PatId = <pattern:PatId> => {
    parser.capture_source_information(input);
    pattern
};

CoPatternGen<P>: CoPatId = <Sp<P>> => parser.copat(<>);

#[inline]
CoPatId: CoPatId = <CoPatternGen<CoPattern>>;
CoPattern: CoPattern = {
    <CoPatternAtom>,
    <x:CoPatId> <y:CoPatternAtomId> => Appli(vec![<>]).into(),
};

#[inline]
CoPatternAtomId: CoPatId = <CoPatternGen<CoPatternAtom>>;
CoPatternAtom: CoPattern = {
    <PatId> => <>.into(),
    <DtorName> => <>.into(),
};

ExistentialParameter: ExistentialParameter = {
    <start:@L> <annotations:MetaAnnotation*> "(" <binder:PatternAnnId> "as" <definition:TermId>
        <classifier:(":" <TermId>)?> <r:@R> ")" => {
        let binder = parser.manifest_pattern(binder, definition, classifier, r);
        parser.existential_prefix(binder, start);
        ExistentialParameter { annotations, binder }
    },
    <start:@L> <annotations:MetaAnnotation*> "(" <binder:PatternAnnId> ")" => {
        parser.existential_prefix(binder, start);
        ExistentialParameter { annotations, binder }
    },
};

/// One `pack` telescope entry: an ordinary existential parameter optionally
/// followed by sealed evidence after `is`. Manifest parameters carry their
/// evidence in `as`; desugaring rejects a separate `is` for them.
PackParameter: PackParameter = {
    <parameter:ExistentialParameter> <evidence:("is" <PackEvidence>)?> => {
        PackParameter { parameter, evidence }
    },
};

/// Sealed evidence after `is`. Deliberately kept below application
/// precedence so a following parameter's `(` is never absorbed as an
/// argument; compound evidence parenthesizes.
PackEvidence: TermId = {
    <start:@L> <name:VarName> <r:@R> => {
        parser.term(Span::new(start, r).make(Term::Var(name)))
    },
    <start:@L> "(" <term:TermId> ")" <r:@R> => {
        parser.term(Span::new(start, r).make(Term::Paren(Paren(vec![term]))))
    },
};

//* ---------------------------------- Term ---------------------------------- */

TermGen<T>: TermId = <Sp<T>> => recovery.alloc_term(parser, <>);

// Binding headers select one elaboration discipline before their ordinary
// binder, parameters, and result annotation.
GenBind<T>: GenBind<T> = {
    "val" <binder:PatId> <params:CoPatId> <ty:(":" <TermId>)?> <bindee:T> => GenBind {
        flavor: BindingFlavor::Value, binder, params: Some(params), ty, bindee,
    },
    "!" <binder:PatId> <params:CoPatId?> <ty:(":" <TermId>)?> <bindee:T> => GenBind {
        flavor: BindingFlavor::Computation, binder, params, ty, bindee,
    },
    "fix" <binder:PatId> <params:CoPatId?> <ty:(":" <TermId>)?> <bindee:T> => GenBind {
        flavor: BindingFlavor::Recursive, binder, params, ty, bindee,
    },
    <binder:PatId> <params:CoPatId?> <ty:(":" <TermId>)?> <bindee:T> => GenBind {
        flavor: BindingFlavor::Plain, binder, params, ty, bindee,
    },
};
GenBindTerm: GenBind<TermId> = GenBind<("=" <TermId>)>;
GenBindNull: GenBind<()> = GenBind<()>;

Placement: Placement = {
    "in" => Placement::In,
    "that" => Placement::That,
};

Data: Data = <arms:DataArm*> => Data {<>};
#[inline]
DataArm: DataArm = {
    <start:@L> "|" <name:CtorName> ":" <param:TermId> => {
        parser.arm_prefix(param, param, start);
        DataArm { name, param }
    },
};
CoData: CoData = <arms:CoDataArm*> => CoData {<>};
#[inline]
CoDataArm: CoDataArm = {
    <start:@L> "|" <name:DtorName> <params:CoPatId?> ":" <out: TermId> => {
        let first: EntityId = params.map_or_else(|| out.into(), Into::into);
        parser.arm_prefix(first, out, start);
        CoDataArm { name, params, out }
    },
};

Matcher: Matcher<PatId, TermId> = {
    <start:@L> "|" <binder:PatId> "=>" <tail:TermId> => {
        parser.arm_prefix(binder, tail, start);
        Matcher { binder, tail }
    },
};
CoMatcher: CoMatcherParam = {
    <start:@L> "|" <params:CoPatId> "=>" <tail:TermId> => {
        parser.arm_prefix(params, tail, start);
        CoMatcherParam { params, tail }
    },
};

#[inline]
TermAnnId: TermId = <TermGen<TermAnn>>;
TermAnn: ParsedNode<Term> = {
    #[precedence(level="0")]
    <Term>,

    #[precedence(level="1")] #[assoc(side="none")]
    <Ann<TermGen<TermAnn>, TermId>> => ParsedNode::Syntax(<>.into()),

    // A name labels one inner term. Named product types compose parenthesized
    // labels with `*`; comma remains ordinary tuple syntax.
    #[precedence(level="2")] #[assoc(side="right")]
    "=" <l:@L> <field:Sp<FieldName>> <ty:(":" <TermId>)?> <r:@R> => {
        let ty = ty.map(|ty| Sp {
            info: Span::new(l, r),
            inner: ty,
        });
        ParsedNode::Syntax(parser.pun_term(field, ty))
    },
    #[precedence(level="2")] #[assoc(side="right")]
    <name:MarkedFieldName> "=" <inner:TermGen<TermAnn>> => ParsedNode::Syntax(Named(name, inner).into()),
    #[precedence(level="2")] #[assoc(side="right")]
    <name:MarkedFieldName> "::" <inner:TermGen<TermAnn>> => ParsedNode::Syntax(Label(name, inner).into()),
};

#[inline]
TermId: TermId = <TermGen<Term>>;
Term: ParsedNode<Term> = {
    // LALRPOP nominal semantics subtlety:
    // Indirect references (TermId) are full term references;
    // Direct ones (TermGen<Term>) participate in precedence rewriting and
    // accept only the terms admitted at that occurrence's precedence.

    // Precedence summary (tightest -> loosest):
    // level 0 (atom) < level 1 (proj) < level 2 (!/ret/ctor)
    // < level 3 (app/dtor) < level 4 (*) < level 5 (->)
    // < levels 6-7 (value-level cuts)
    // < level 8 (pi/forall/sigma/exists) < level 9 (binders/blocks).

    #[precedence(level="0")]
    <l:@L> <error:!> <r:@R> => recovery.recover(l..r, error),
    #[precedence(level="0")]
    // parentheses
    <Paren<TermAnnId>> => ParsedNode::Syntax(<>.into()),
    // hole and variable
    <Hole> => ParsedNode::Syntax(<>.into()),
    <VarName> => ParsedNode::Syntax(<>.into()),
    // thunk
    "{" <TermId> "}" => ParsedNode::Syntax(Thunk(<>).into()),
    // context-forming block
    "begin" <TermAnnId> "end" => ParsedNode::Syntax(Block(<>).into()),
    // abstraction (alternative syntax)
    "comatch" <params:CoPatId> "=>" <term:TermId> "end" => ParsedNode::Syntax(Abs(<>).into()),
    // structural types
    "data" <Data> "end" => ParsedNode::Syntax(<>.into()),
    "codata" <CoData> "end" => ParsedNode::Syntax(<>.into()),
    // match
    "match" <scrut:TermId> <arms:(<Matcher>)*> "end" => ParsedNode::Syntax(Match {<>}.into()),
    // comatch
    "comatch" <arms:(<CoMatcher>)*> "end" => ParsedNode::Syntax(CoMatchParam {<>}.into()),
    // package introduction; the `where` body is one nonempty comma sequence,
    // kept as a `Paren` so payload components share tuple desugaring.
    // Abstract parameters are rejected during desugaring with a pointed error.
    "pack" <parameters:PackParameter+> "where" <l:@L> <first:TermAnnId>
        <rest:("," <TermAnnId>)*> <_trailing:","?> <r:@R> "end" => {
        let mut components = Vec::new();
        components.push(first);
        components.extend(rest);
        let body = parser.term(Span::new(l, r).make(Term::Paren(Paren(components))));
        ParsedNode::Syntax(Pack { parameters, body }.into())
    },
    <Literal> => ParsedNode::Syntax(<>.into()),

    // Named projection is a tight postfix value operator.
    #[precedence(level="1")] #[assoc(side="left")]
    <term:TermGen<Term>> "/" <name:FieldName> => ParsedNode::Syntax(Proj(<>).into()),

    // Undelimited prefix forms consume projections but stop before
    // computation application and destruction.
    #[precedence(level="2")] #[assoc(side="right")]
    "!" <TermGen<Term>> => ParsedNode::Syntax(Force(<>).into()),
    #[precedence(level="2")] #[assoc(side="right")]
    "ret" <TermGen<Term>> => ParsedNode::Syntax(Return(<>).into()),
    #[precedence(level="2")] #[assoc(side="right")]
    <name:CtorName> <args:TermGen<Term>> => ParsedNode::Syntax(Ctor(<>).into()),

    // Application and computation destruction bind tighter than type operators.
    #[precedence(level="3")] #[assoc(side="left")]
    // application
    <term:TermGen<Term>> <arg:TermGen<Term>> => ParsedNode::Syntax(Appli(vec![<>]).into()),
    // destructor
    <term:TermGen<Term>> <name:DtorName> => ParsedNode::Syntax(Dtor(<>).into()),

    // Product is one flat infix node: A * B * C parses as a single
    // three-component product, while an explicitly parenthesized
    // component stays a distinct nested product.
    #[precedence(level="4")] #[assoc(side="left")]
    // product
    <ty_l:TermGen<Term>> "*" <ty_r:TermGen<Term>> => ParsedNode::Syntax(parser.extend_product(ty_l, ty_r).into()),

    // Arrow associates to the right: A -> B -> C == A -> (B -> C).
    #[precedence(level="5")] #[assoc(side="right")]
    // arrow
    <ty_in:TermGen<Term>> "->" <ty_out:TermGen<Term>> => ParsedNode::Syntax(Arrow(<>).into()),

    // Directional value-function application.
    #[precedence(level="6")] #[assoc(side="left")]
    <subject:TermGen<Term>> "|>" <function:TermGen<Term>> => ParsedNode::Syntax(Pipeline {
        direction: PipelineDirection::Forward,
        subject,
        function,
    }.into()),
    #[precedence(level="7")] #[assoc(side="right")]
    <function:TermGen<Term>> "<|" <subject:TermGen<Term>> => ParsedNode::Syntax(Pipeline {
        direction: PipelineDirection::Backward,
        subject,
        function,
    }.into()),

    // Quantifiers/types bind looser than arrows/products, tighter than binders.
    #[precedence(level="8")]
    // pi
    "pi" <params:CoPatId> "." <term:TermGen<Term>> => ParsedNode::Syntax(Pi(<>).into()),
    // value pi
    "val" "pi" <params:CoPatId> "." <term:TermGen<Term>> => ParsedNode::Syntax(ValPi(<>).into()),
    // forall
    "forall" <params:CoPatId> "." <ty:TermGen<Term>> => ParsedNode::Syntax(Forall(<>).into()),
    // sigma
    "sigma" <params:CoPatId> "." <ty:TermGen<Term>> => ParsedNode::Syntax(Sigma(<>).into()),
    // exists
    "exists" <parameters:ExistentialParameter+> "." <body:TermId> => {
        ParsedNode::Syntax(Exists { parameters, body }.into())
    },

    // Bindings are loosest to capture the largest possible tail.
    #[precedence(level="9")]
    // abstraction
    "fn" <params:CoPatId> "=>" <term:TermGen<Term>> => ParsedNode::Syntax(Abs(<>).into()),
    // total value abstraction
    "val" <params:CoPatId> "=>" <term:TermGen<Term>> => ParsedNode::Syntax(Term::ValAbs(Abs(<>))),
    // fixed point
    "fix" <binder:PatId> "=>" <term:TermGen<Term>> => ParsedNode::Syntax(Fix(<>).into()),
    // bind
    "do" <binder:PatId> "<-" <bindee:TermGen<Term>> ";" <tail:TermGen<Term>> => {
        ParsedNode::Syntax(Bind {<>}.into())
    },
    // context-forming binders
    "param" "val" <binder:PatternAnnId> <placement:Placement> <tail:TermGen<Term>> => {
        ParsedNode::Syntax(Param { flavor: ParameterFlavor::Value, binder, placement, tail }.into())
    },
    "param" <binder:PatternAnnId> <placement:Placement> <tail:TermGen<Term>> => {
        ParsedNode::Syntax(Param { flavor: ParameterFlavor::Plain, binder, placement, tail }.into())
    },
    "let" <binding:GenBindTerm> <placement:Placement> <tail:TermGen<Term>> => {
        ParsedNode::Syntax(ContextBind {
            mode: DefinitionMode::Transparent,
            binding,
            placement,
            tail,
        }.into())
    },
    "define" <binding:GenBindTerm> <placement:Placement> <tail:TermGen<Term>> => {
        ParsedNode::Syntax(ContextBind {
            mode: DefinitionMode::Nominal,
            binding,
            placement,
            tail,
        }.into())
    },
    // meta annotated term
    <MetaTerm<TermGen<Term>>> => ParsedNode::Syntax(<>.into()),
    // meta annotation sugar: `@(meta)` is `@[meta] _` with an implicit hole payload
    <start:@L> "@" "(" <meta:Meta> ")" <end:@R> => {
        let span = Span::new(start, end);
        let payload = parser.term(span.make(Term::Hole(Hole)));
        ParsedNode::Syntax(MetaTerm(meta, payload).into())
    },
};

pub SingleTerm: TermId = <term:TermId> => {
    parser.capture_source_information(input);
    term
};

pub SourceUnit: SourceUnit = {
    <root:TermId> => {
