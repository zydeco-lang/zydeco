-- stage: check-value
-- expect: reject(tyck.type-mismatch)

begin
  let Box =
    exists (X : VType) . X * Thk (X -> Ret Int)
  that
  def ints : Box = (
    Int,
    0,
    { fn (x : Int) => ret x }
  ) that
  def chars : Box = (
    Char,
    'z',
    { fn (_ : Char) => ret 0 }
  ) that

  {
    match ints
    | (XI, xi, _) =>
      match chars
      | (XC, _, from_char) =>
        do status <- ! from_char xi;
        ret status
      end
    end
  }
end
