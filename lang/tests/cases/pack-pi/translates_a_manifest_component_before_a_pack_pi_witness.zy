-- stage: check-value
-- prelude: monadic

begin
  let Mixed =
    exists (Y as Unit) .
      exists (X : VType) .
        exists (Z as X) .
          Z
  that

  def translated = {
    @[monadic] begin
      let reveal = {
        do _ <- ret ();
        fn ((Y, X, Z, value) : Mixed) => ret value
      } in
      ! reveal (Unit, Unit, Unit, ())
    end
  } that

  translated
end
