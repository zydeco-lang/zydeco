-- stage: check-value

begin
  def selective = {
    fn
      (
        (
          /VType = SelectedVType;
          /String = SelectedString;
          /stdio;
          /process;
          builtin
        ) : Builtin
      )
    =>
      let Selected : SelectedVType = SelectedString in
      let message : Selected = "" in
      ! stdio/write_line message { ! process/exit 0 }
  } that

  selective
end
