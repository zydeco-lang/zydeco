-- prelude: monadic
-- expect: reject(tyck.type-mismatch)

let make = {
  begin
    let VType = @(intrinsic(vtype)) in
    let Int = @(intrinsic(int)) in
    def Box =
      data
      | +Box : Int
      end
    in
    ret (+Box(1) : Box)
  end
} in
fn (mo : Thk (Monad Ret)) =>
  do original <- ! make;
  do translated <- (@[monadic] ! make) Ret mo;
  let Original = @[typeof] original in
  ret (translated : Original)
