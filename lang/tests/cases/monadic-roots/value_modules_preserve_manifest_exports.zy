-- stage: run
-- prelude: monadic

let mo : Thk (Monad Ret) = {
  comatch
  | .return A value => ret value
  | .bind A B computation continuation =>
    do value <- ! computation;
    ! continuation value
  end
} in
let factory = @[monadic] val (A : VType) (value : A) =>
  pack (= Item as A)
  where
    = value, #run = { ret value }
  end in
let (/Item; /value; /run) = factory Ret mo Int triv 8 in
let _ : Item = value in
do result <- ! run;
do status <- ! int/sub result 8;
! exit status
