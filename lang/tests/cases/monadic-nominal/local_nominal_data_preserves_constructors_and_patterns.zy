-- stage: run
-- prelude: monadic

let mo : Thk (Monad Ret) = {
  comatch
  | .return A value => ret value
  | .bind A B computation continuation =>
    do value <- ! computation;
    ! continuation value
  end
} in
do result <- (
  @[monadic] begin
    def Box : VType =
      data
      | +Box : Int
      end
    in
    let item = (+Box(1) : Box) in
    match item
    | +Box(n) => ret n
    end
  end
) Ret mo;
do status <- ! int/sub result 1;
! exit status
