-- stage: run
-- prelude: monadic

let mo : Thk (Monad Ret) = {
  comatch
  | .return A value => ret value
  | .bind A B computation continuation =>
    do value <- ! computation;
    ! continuation value
  end
} in
do result <- (
  @[monadic] begin
    let identity_mo : Thk (Monad Ret) = {
      comatch
      | .return A value => ret value
      | .bind A B computation continuation =>
        do value <- ! computation;
        ! continuation value
      end
    } in
    (
      @[monadic] begin
        def Box =
          data
          | +Box : Int
          end
        in
        match (+Box(1) : Box)
        | +Box(value) => ret value
        end
      end
    ) Ret identity_mo
  end
) Ret mo;
do status <- ! int/sub result 1;
! exit status
