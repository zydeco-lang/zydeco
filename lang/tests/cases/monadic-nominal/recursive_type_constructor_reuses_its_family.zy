-- stage: run
-- prelude: monadic

let mo : Thk (Monad Ret) = {
  comatch
  | .return A value => ret value
  | .bind A B computation continuation =>
    do value <- ! computation;
    ! continuation value
  end
} in
do result <- (
  @[monadic] begin
    def List (A : VType) : VType =
      data
      | +Nil : Unit
      | +Cons : A * List A
      end
    that
    let items = (+Cons(1, +Nil()) : List Int) in
    match items
    | +Nil(_) => ret 0
    | +Cons(head, tail) =>
      match tail
      | +Nil(_) => ret head
      | +Cons(_) => ret 0
      end
    end
  end
) Ret mo;
do status <- ! int/sub result 1;
! exit status
