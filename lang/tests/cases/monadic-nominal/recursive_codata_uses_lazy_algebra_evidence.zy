-- stage: run
-- prelude: monadic

let mo : Thk (Monad Ret) = {
  comatch
  | .return A value => ret value
  | .bind A B computation continuation =>
    do value <- ! computation;
    ! continuation value
  end
} in
do result <- (
  @[monadic] begin
    def Stream : CType =
      codata
      | .head : Ret Int
      | .tail : Stream
      end
    that
    let stream : Thk Stream = {
      fix self =>
        do _ <- ret ();
        comatch
        | .head => ret 1
        | .tail => ! self
        end
    } in
    ! stream .tail .tail .head
  end
) Ret mo;
do status <- ! int/sub result 1;
! exit status
