-- stage: run
-- prelude: monadic

let mo : Thk (Monad Ret) = {
  comatch
  | .return A value => ret value
  | .bind A B computation continuation =>
    do value <- ! computation;
    ! continuation value
  end
} in
do result <- (
  @[monadic] begin
    let make = {
      fn (A : VType) (item : A) =>
        begin
          def Box =
            data
            | +Box : A
            end
          in
          ret (
            (
              Box,
              (
                +Box(item),
                {
                  fn boxed =>
                    match boxed
                    | +Box(value) => ret value
                    end
                }
              )
            ) : exists (B : VType) . B * Thk (B -> Ret A)
          )
        end
    } in
    do (B, (boxed, read)) <- ! make Int 1;
    ! read boxed
  end
) Ret mo;
do status <- ! int/sub result 1;
! exit status
