let (/Monad; /Algebra; /WithMonad) = builtin |> (@(import("${std}/effect/monad.zy"))) in
let (/List; /list; data_package) = builtin |> (@(import("${std}/data/package.zy"))) in
let (/NonDet; /NonDetT; /MonadNonDet; /INonDet; nondet) =
  (builtin |> (@(import("${std}/effect/nondet.zy")))) data_package in
let optional = builtin |> (@(import("${std}/effect/option.zy"))) in
let (N, n) = nondet/instance in
let (O, o) = optional/instance in
let (NO, no) = nondet/transformer_instance O in
${body}
