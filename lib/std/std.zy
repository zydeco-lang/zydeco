begin
  let make_bool = @[import("bool.zy")] _ that
  let make_option = @[import("option.zy")] _ that
  let make_result = @[import("result.zy")] _ that
  let make_list = @[import("list.zy")] _ that
  let make_io_types = @[import("io-types.zy")] _ that
  let make_interface = @[import("interface.zy")] _ that

  begin
    param (
      (
        /VType; /CType; /Thk; /Ret;
        /Unit;
        /Int8; /Int16; /Int32; /Int64;
        /UInt8; /UInt16; /UInt32; /UInt64;
        /Float32; /Float64;
        /Char; /String; /Bytes; /Reader; /Writer; /OS;
        /int8; /int16; /int32; /int64;
        /uint8; /uint16; /uint32; /uint64;
        /float32; /float64;
        /char; /string; /bytes;
        /io; /fs; /stdio; /args; /random; /process;
        builtin
      ) :
      @[import("builtin.zy")] _
    ) in
      let (Bool = Bool, bool) =
        make_bool builtin in
      let (Option = Option, option) =
        make_option builtin in
      let (Result = Result, result) =
        make_result builtin in
      let (List = List, list) =
        make_list builtin in
      let (
        IoErrorKind = IoErrorKind,
        IoError = IoError,
        Path = Path,
        io_types
      ) = make_io_types builtin in
      let (
        = Prelude,
        = Additive,
        = Multiplicative,
        = PartialEquality,
        = PartialOrder,
        = Numeric,
        = NumericInstance,
        = IntegerModule,
        = FloatModule,
        = PrimitiveIntegerModule,
        = PrimitiveFloatModule,
        = Std,
        ()
      ) = make_interface builtin in
      let ! compare
        (A : VType)
        (predicate : Thk (
          forall (B : CType) .
            A -> A -> Thk B -> Thk B -> B
        ))
        (left : A)
        (right : A)
        : Ret Bool =
        ! predicate
          (Ret Bool)
          left
          right
          { ret (bool/true) }
          { ret (bool/false) }
      in
      let ! int64_eq (left : Int64) (right : Int64) : Ret Bool =
        ! compare Int64 int64/eq left right
      in
      let ! int64_lt (left : Int64) (right : Int64) : Ret Bool =
        ! compare Int64 int64/lt left right
      in
      let ! str_eq (left : String) (right : String) : Ret Bool =
        ! compare String string/eq left right
      in
      let ! option_is_some (A : VType) (value : Option A) : Ret Bool =
        ! (option/fold)
          A
          (Ret Bool)
          value
          { ret (bool/false) }
          { fn _ => ret (bool/true) }
      in
      let ! option_is_none (A : VType) (value : Option A) : Ret Bool =
        do present <- ! option_is_some A value;
        ! (bool/not) present
      in
      let ! result_is_ok
        (A : VType)
        (E : VType)
        (value : Result A E)
        : Ret Bool =
        ! (result/fold)
          A
          E
          (Ret Bool)
          value
          { fn _ => ret (bool/true) }
          { fn _ => ret (bool/false) }
      in
      let ! result_is_err
        (A : VType)
        (E : VType)
        (value : Result A E)
        : Ret Bool =
        do successful <- ! result_is_ok A E value;
        ! (bool/not) successful
      in
      let ! list_is_empty (A : VType) (values : List A) : Ret Bool =
        ! (list/case)
          A
          (Ret Bool)
          values
          { ret (bool/true) }
          { fn _ _ => ret (bool/false) }
      in
      let ! list_head (A : VType) (values : List A) : Ret (Option A) =
        ! (list/case)
          A
          (Ret (Option A))
          values
          { ! (option/none) A }
          { fn head _ => ! (option/some) A head }
      in
      let ! list_tail (A : VType) (values : List A) : Ret (Option (List A)) =
        ! (list/case)
          A
          (Ret (Option (List A)))
          values
          { ! (option/none) (List A) }
          { fn _ tail => ! (option/some) (List A) tail }
      in
      let fix list_get (A : VType) (values : List A) (index : Int64) : Ret (Option A) =
        do negative <- ! int64_lt index 0;
        ! (bool/if)
          (Ret (Option A))
          negative
          { ! (option/none) A }
          {
            ! (list/case)
              A
              (Ret (Option A))
              values
              { ! (option/none) A }
              {
                fn head tail =>
                  do zero <- ! int64_eq index 0;
                  ! (bool/if)
                    (Ret (Option A))
                    zero
                    { ! (option/some) A head }
                    {
                      do previous <- ! (int64/sub) index 1;
                      ! list_get A tail previous
                    }
              }
          }
      in
      let ! str_split_once (text : String) (separator : Char) : Ret (Option (String * String)) =
        ! (string/split_once)
          (Ret (Option (String * String)))
          text
          separator
          { ! (option/none) (String * String) }
          {
            fn first second =>
              ! (option/some) (String * String) (first, second)
          }
      in
      let ! str_split_at (text : String) (index : Int64) : Ret (Option (String * String)) =
        ! (string/split_at)
          (Ret (Option (String * String)))
          text
          index
          { ! (option/none) (String * String) }
          {
            fn first second =>
              ! (option/some) (String * String) (first, second)
          }
      in
      let ! str_get (text : String) (index : Int64) : Ret (Option Char) =
        ! (string/get)
          (Ret (Option Char))
          text
          index
          { ! (option/none) Char }
          { fn character => ! (option/some) Char character }
      in
      let ! char_from_codepoint (codepoint : Int64) : Ret (Option Char) =
        ! (char/from_codepoint)
          (Ret (Option Char))
          codepoint
          { ! (option/none) Char }
          { fn character => ! (option/some) Char character }
      in
      let ! str_parse_int (text : String) : Ret (Option Int64) =
        ! (string/parse_int)
          (Ret (Option Int64))
          text
          { ! (option/none) Int64 }
          { fn integer => ! (option/some) Int64 integer }
      in
      let ! str_is_empty (text : String) : Ret Bool =
        do length <- ! (string/length) text;
        ! int64_eq length 0
      in
      let ! str_head (text : String) : Ret (Option Char) =
        ! str_get text 0
      in
      let ! str_uncons (text : String) : Ret (Option (Char * String)) =
        do character <- ! str_get text 0;
        ! (option/and_then)
          Char
          (Char * String)
          character
          {
            fn head =>
              do split <- ! str_split_at text 1;
              ! (option/map)
                (String * String)
                (Char * String)
                split
                { fn (_, tail) => ret (head, tail) }
          }
      in
      let fix str_to_chars (text : String) : Ret (List Char) =
        do first <- ! str_uncons text;
        ! (option/fold)
          (Char * String)
          (Ret (List Char))
          first
          { ! (list/nil) Char }
          {
            fn (head, tail) =>
              do rest <- ! str_to_chars tail;
              ! (list/cons) Char head rest
          }
      in
      let fix str_from_chars (characters : List Char) : Ret String =
        ! (list/case)
          Char
          (Ret String)
          characters
          { ret "" }
          {
            fn head tail =>
              do first <- ! (char/to_string) head;
              do rest <- ! str_from_chars tail;
              ! (string/append) first rest
          }
      in
      let ! str_concat (strings : List String) : Ret String =
        ! (list/fold)
          String
          (Ret String)
          strings
          { ret "" }
          {
            fn head tail =>
              do rest <- ! tail;
              ! (string/append) head rest
          }
      in
      let ! bytes_to_string (value : Bytes) : Ret (Option String) =
        ! (bytes/to_string)
          (Ret (Option String))
          value
          { ! (option/none) String }
          { fn string => ! (option/some) String string }
      in
      let ! make_io_error (code : Int64) (message : String) : Ret IoError =
        do kind <- ! (io_types/from_code) code;
        ! (io_types/error) kind message
      in
      let ! io_kind_eq (left : IoErrorKind) (right : IoErrorKind) : Ret Bool =
        ! (io_types/kind_eq_branch)
          (Ret Bool)
          left
          right
          { ret (bool/true) }
          { ret (bool/false) }
      in
      let ! continue_io_ok
        (A : VType)
        (continuation : Thk (Result A IoError -> OS))
        (value : A)
        : OS =
        do result <- ! (result/ok) A IoError value;
        ! continuation result
      in
      let ! continue_io_error
        (A : VType)
        (continuation : Thk (Result A IoError -> OS))
        (error : IoError)
        : OS =
        do result <- ! (result/err) A IoError error;
        ! continuation result
      in
      let ! continue_host_error
        (A : VType)
        (continuation : Thk (Result A IoError -> OS))
        (code : Int64)
        (message : String)
        : OS =
        do error <- ! make_io_error code message;
        ! continue_io_error A continuation error
      in
      let ! io_read
        (reader : Reader)
        (count : Int64)
        (continuation : Thk (Result Bytes IoError -> OS))
        : OS =
        ! (io/read)
          reader
          count
          { fn code message => ! continue_host_error Bytes continuation code message }
          { fn chunk => ! continue_io_ok Bytes continuation chunk }
      in
      let ! io_read_line
        (reader : Reader)
        (continuation : Thk (Result (Option Bytes) IoError -> OS))
        : OS =
        ! (io/read_line)
          reader
          {
            fn code message =>
              ! continue_host_error (Option Bytes) continuation code message
          }
          {
            do absent <- ! (option/none) Bytes;
            ! continue_io_ok (Option Bytes) continuation absent
          }
          {
            fn chunk =>
              do present <- ! (option/some) Bytes chunk;
              ! continue_io_ok (Option Bytes) continuation present
          }
      in
      let ! io_read_all
        (reader : Reader)
        (continuation : Thk (Result Bytes IoError -> OS))
        : OS =
        ! (io/read_all)
          reader
          { fn code message => ! continue_host_error Bytes continuation code message }
          { fn chunk => ! continue_io_ok Bytes continuation chunk }
      in
      let ! io_write_all
        (writer : Writer)
        (chunk : Bytes)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! (io/write_all)
          writer
          chunk
          { fn code message => ! continue_host_error Unit continuation code message }
          { ! continue_io_ok Unit continuation () }
      in
      let ! io_flush
        (writer : Writer)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! (io/flush)
          writer
          { fn code message => ! continue_host_error Unit continuation code message }
          { ! continue_io_ok Unit continuation () }
      in
      let ! io_close_reader
        (reader : Reader)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! (io/close_reader)
          reader
          { fn code message => ! continue_host_error Unit continuation code message }
          { ! continue_io_ok Unit continuation () }
      in
      let ! io_close_writer
        (writer : Writer)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! (io/close_writer)
          writer
          { fn code message => ! continue_host_error Unit continuation code message }
          { ! continue_io_ok Unit continuation () }
      in
      let ! fs_open_reader
        (path : Path)
        (continuation : Thk (Result Reader IoError -> OS))
        : OS =
        do string <- ! (io_types/path_string) path;
        ! (fs/open_reader)
          string
          { fn code message => ! continue_host_error Reader continuation code message }
          { fn reader => ! continue_io_ok Reader continuation reader }
      in
      let ! fs_create_writer
        (path : Path)
        (continuation : Thk (Result Writer IoError -> OS))
        : OS =
        do string <- ! (io_types/path_string) path;
        ! (fs/create_writer)
          string
          { fn code message => ! continue_host_error Writer continuation code message }
          { fn writer => ! continue_io_ok Writer continuation writer }
      in
      let ! fs_append_writer
        (path : Path)
        (continuation : Thk (Result Writer IoError -> OS))
        : OS =
        do string <- ! (io_types/path_string) path;
        ! (fs/append_writer)
          string
          { fn code message => ! continue_host_error Writer continuation code message }
          { fn writer => ! continue_io_ok Writer continuation writer }
      in
      let ! finish_reader
        (A : VType)
        (reader : Reader)
        (operation : Result A IoError)
        (continuation : Thk (Result A IoError -> OS))
        : OS =
        ! (result/fold)
          A
          IoError
          OS
          operation
          {
            fn value =>
              ! io_close_reader reader {
                fn close_result =>
                  ! (result/fold)
                    Unit
                    IoError
                    OS
                    close_result
                    { fn _ => ! continue_io_ok A continuation value }
                    { fn error => ! continue_io_error A continuation error }
              }
          }
          {
            fn operation_error =>
              ! io_close_reader reader {
                fn _ => ! continue_io_error A continuation operation_error
              }
          }
      in
      let ! finish_writer
        (writer : Writer)
        (operation : Result Unit IoError)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! (result/fold)
          Unit
          IoError
          OS
          operation
          {
            fn _ =>
              ! io_close_writer writer continuation
          }
          {
            fn operation_error =>
              ! io_close_writer writer {
                fn _ => ! continue_io_error Unit continuation operation_error
              }
          }
      in
      let ! fs_read_bytes
        (path : Path)
        (continuation : Thk (Result Bytes IoError -> OS))
        : OS =
        ! fs_open_reader path {
          fn opened =>
            ! (result/fold)
              Reader
              IoError
              OS
              opened
              {
                fn reader =>
                  ! io_read_all reader {
                    fn operation => ! finish_reader Bytes reader operation continuation
                  }
              }
              { fn error => ! continue_io_error Bytes continuation error }
        }
      in
      let ! fs_read_text
        (path : Path)
        (continuation : Thk (Result String IoError -> OS))
        : OS =
        ! fs_read_bytes path {
          fn read_result =>
            ! (result/fold)
              Bytes
              IoError
              OS
              read_result
              {
                fn contents =>
                  ! (bytes/to_string)
                    OS
                    contents
                    {
                      do error <- ! (io_types/error)
                        (io_types/invalid_data)
                        "file is not valid UTF-8";
                      ! continue_io_error String continuation error
                    }
                    { fn string => ! continue_io_ok String continuation string }
              }
              { fn error => ! continue_io_error String continuation error }
        }
      in
      let ! fs_write_bytes
        (path : Path)
        (chunk : Bytes)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! fs_create_writer path {
          fn opened =>
            ! (result/fold)
              Writer
              IoError
              OS
              opened
              {
                fn writer =>
                  ! io_write_all writer chunk {
                    fn operation => ! finish_writer writer operation continuation
                  }
              }
              { fn error => ! continue_io_error Unit continuation error }
        }
      in
      let ! fs_write_text
        (path : Path)
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do encoded <- ! (bytes/from_string) string;
        ! fs_write_bytes path encoded continuation
      in
      let ! write_bytes_and_flush
        (writer : Writer)
        (chunk : Bytes)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! io_write_all writer chunk {
          fn written =>
            ! (result/fold)
              Unit
              IoError
              OS
              written
              { fn _ => ! io_flush writer continuation }
              { fn error => ! continue_io_error Unit continuation error }
        }
      in
      let ! stdio_write_to
        (writer : Writer)
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do encoded <- ! (bytes/from_string) string;
        ! write_bytes_and_flush writer encoded continuation
      in
      let ! stdio_write_line_to
        (writer : Writer)
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do encoded <- ! (bytes/from_string) string;
        do newline <- ! (bytes/from_string) "\n";
        do line <- ! (bytes/append) encoded newline;
        ! write_bytes_and_flush writer line continuation
      in
      let ! stdio_read_line
        (continuation : Thk (Result (Option String) IoError -> OS))
        : OS =
        do reader <- ! (stdio/stdin);
        ! io_read_line reader {
          fn read_result =>
            ! (result/fold)
              (Option Bytes)
              IoError
              OS
              read_result
              {
                fn line =>
                  ! (option/fold)
                    Bytes
                    OS
                    line
                    {
                      do absent <- ! (option/none) String;
                      ! continue_io_ok (Option String) continuation absent
                    }
                    {
                      fn line_bytes =>
                        ! (bytes/to_string)
                          OS
                          line_bytes
                          {
                            do error <- ! (io_types/error)
                              (io_types/invalid_data)
                              "standard input is not valid UTF-8";
                            ! continue_io_error (Option String) continuation error
                          }
                          {
                            fn string =>
                              do present <- ! (option/some) String string;
                              ! continue_io_ok (Option String) continuation present
                          }
                    }
              }
              { fn error => ! continue_io_error (Option String) continuation error }
        }
      in
      let ! stdio_write
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do writer <- ! (stdio/stdout);
        ! stdio_write_to writer string continuation
      in
      let ! stdio_write_line
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do writer <- ! (stdio/stdout);
        ! stdio_write_line_to writer string continuation
      in
      let ! stdio_write_error
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do writer <- ! (stdio/stderr);
        ! stdio_write_to writer string continuation
      in
      let ! stdio_write_error_line
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do writer <- ! (stdio/stderr);
        ! stdio_write_line_to writer string continuation
      in
      let ! arg_list (continuation : Thk (List String -> OS)) : OS =
        do arguments <- ! (args/fold)
          (Ret (List String))
          { ! (list/nil) String }
          {
            fn argument remaining =>
              do tail <- ! remaining;
              ! (list/cons) String argument tail
          };
        ! continuation arguments
      in
      let halt : Thk OS = { ! (process/exit) 0 } in
      let ! panic (message : String) : OS =
        ! stdio_write_error_line message { fn _ => ! (process/exit) 1 }
      in
      let int8_module : IntegerModule Bool Int8 String = (
        add = int8/add,
        sub = int8/sub,
        mul = int8/mul,
        div = int8/div,
        mod = int8/mod,
        eq = {
          fn left right => ! compare Int8 (int8/eq) left right
        },
        ne = {
          fn left right =>
            do equal <- ! compare Int8 (int8/eq) left right;
            ! (bool/not) equal
        },
        lt = {
          fn left right => ! compare Int8 (int8/lt) left right
        },
        le = {
          fn left right =>
            do greater <- ! compare Int8 (int8/gt) left right;
            ! (bool/not) greater
        },
        gt = {
          fn left right => ! compare Int8 (int8/gt) left right
        },
        ge = {
          fn left right =>
            do less <- ! compare Int8 (int8/lt) left right;
            ! (bool/not) less
        },
        increment = {
          fn value => ! (int8/add) value 1
        },
        decrement = {
          fn value => ! (int8/sub) value 1
        },
        negate = {
          fn value => ! (int8/sub) 0 value
        },
        min = {
          fn left right =>
            do less <- ! compare Int8 (int8/lt) left right;
            ! (bool/if) (Ret Int8) less { ret left } { ret right }
        },
        max = {
          fn left right =>
            do greater <- ! compare Int8 (int8/gt) left right;
            ! (bool/if) (Ret Int8) greater { ret left } { ret right }
        },
        to_string = int8/to_string,
      ) in
      let int16_module : IntegerModule Bool Int16 String = (
        add = int16/add,
        sub = int16/sub,
        mul = int16/mul,
        div = int16/div,
        mod = int16/mod,
        eq = {
          fn left right => ! compare Int16 (int16/eq) left right
        },
        ne = {
          fn left right =>
            do equal <- ! compare Int16 (int16/eq) left right;
            ! (bool/not) equal
        },
        lt = {
          fn left right => ! compare Int16 (int16/lt) left right
        },
        le = {
          fn left right =>
            do greater <- ! compare Int16 (int16/gt) left right;
            ! (bool/not) greater
        },
        gt = {
          fn left right => ! compare Int16 (int16/gt) left right
        },
        ge = {
          fn left right =>
            do less <- ! compare Int16 (int16/lt) left right;
            ! (bool/not) less
        },
        increment = {
          fn value => ! (int16/add) value 1
        },
        decrement = {
          fn value => ! (int16/sub) value 1
        },
        negate = {
          fn value => ! (int16/sub) 0 value
        },
        min = {
          fn left right =>
            do less <- ! compare Int16 (int16/lt) left right;
            ! (bool/if) (Ret Int16) less { ret left } { ret right }
        },
        max = {
          fn left right =>
            do greater <- ! compare Int16 (int16/gt) left right;
            ! (bool/if) (Ret Int16) greater { ret left } { ret right }
        },
        to_string = int16/to_string,
      ) in
      let int32_module : IntegerModule Bool Int32 String = (
        add = int32/add,
        sub = int32/sub,
        mul = int32/mul,
        div = int32/div,
        mod = int32/mod,
        eq = {
          fn left right => ! compare Int32 (int32/eq) left right
        },
        ne = {
          fn left right =>
            do equal <- ! compare Int32 (int32/eq) left right;
            ! (bool/not) equal
        },
        lt = {
          fn left right => ! compare Int32 (int32/lt) left right
        },
        le = {
          fn left right =>
            do greater <- ! compare Int32 (int32/gt) left right;
            ! (bool/not) greater
        },
        gt = {
          fn left right => ! compare Int32 (int32/gt) left right
        },
        ge = {
          fn left right =>
            do less <- ! compare Int32 (int32/lt) left right;
            ! (bool/not) less
        },
        increment = {
          fn value => ! (int32/add) value 1
        },
        decrement = {
          fn value => ! (int32/sub) value 1
        },
        negate = {
          fn value => ! (int32/sub) 0 value
        },
        min = {
          fn left right =>
            do less <- ! compare Int32 (int32/lt) left right;
            ! (bool/if) (Ret Int32) less { ret left } { ret right }
        },
        max = {
          fn left right =>
            do greater <- ! compare Int32 (int32/gt) left right;
            ! (bool/if) (Ret Int32) greater { ret left } { ret right }
        },
        to_string = int32/to_string,
      ) in
      let int64_module : IntegerModule Bool Int64 String = (
        add = int64/add,
        sub = int64/sub,
        mul = int64/mul,
        div = int64/div,
        mod = int64/mod,
        eq = {
          fn left right => ! compare Int64 (int64/eq) left right
        },
        ne = {
          fn left right =>
            do equal <- ! compare Int64 (int64/eq) left right;
            ! (bool/not) equal
        },
        lt = {
          fn left right => ! compare Int64 (int64/lt) left right
        },
        le = {
          fn left right =>
            do greater <- ! compare Int64 (int64/gt) left right;
            ! (bool/not) greater
        },
        gt = {
          fn left right => ! compare Int64 (int64/gt) left right
        },
        ge = {
          fn left right =>
