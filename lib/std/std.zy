begin
  param val (/VType; /CType; builtin) : @(import("builtin.zy")) that
  let make_data = @(import("data/package.zy")) that
  let make_text = @(import("text/package.zy")) that
  let make_system = @(import("system/package.zy")) that
  let make_numeric = @(import("numeric/package.zy")) that
  let Additive = @(import("numeric/additive.type.zy")) in
  let Multiplicative = @(import("numeric/multiplicative.type.zy")) in
  let PartialEquality = @(import("numeric/partial-equality.type.zy")) in
  let PartialOrder = @(import("numeric/partial-order.type.zy")) in
  let Numeric = @(import("numeric/numeric.type.zy")) in
  let (/Bool; /Option; /Result; /List; /bool; /option; /result; /list; base) =
    builtin |> make_data
  in
  let (/char; /string; /bytes; text) = (builtin, base) |> make_text in
  let (/Path; /IoErrorKind; /IoError; /io; /fs; /stdio; /process; system) =
    (builtin, base) |> make_system
  in
  let (
    /int8;
    /int16;
    /int32;
    /int64;
    /uint8;
    /uint16;
    /uint32;
    /uint64;
    /float32;
    /float64;
    /dictionaries
  )
  =
    (builtin, base) |> make_numeric
  in
  pack
      (= Bool as Bool : VType)
      (= Option as Option : VType -> VType)
      (= Result as Result : VType -> VType -> VType)
      (= List : VType -> VType) is List
      (= Path : VType) is Path
      (= IoErrorKind : VType) is IoErrorKind
      (= IoError : VType) is IoError
      (= Additive as Additive : VType -> VType)
      (= Multiplicative as Multiplicative : VType -> VType)
      (= PartialEquality as PartialEquality : VType -> VType -> VType)
      (= PartialOrder as PartialOrder : VType -> VType -> VType)
      (= Numeric as Numeric : VType -> VType -> VType)
  where
    (
      = bool,
      = option,
      = result,
      = list
    ),
    (
      = int8,
      = int16,
      = int32,
      = int64,
      = uint8,
      = uint16,
      = uint32,
      = uint64,
      = float32,
      = float64
    ),
    (
      = dictionaries
    ),
    (
      = char,
      = string,
      = bytes
    ),
    (
      = io,
      = fs,
      = stdio,
      = process
    )
  end
end
-- end module Std
