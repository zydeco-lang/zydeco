begin
  let make_data = @(import("data/package.zy")) that
  let make_text = @(import("text/package.zy")) that
  let make_system = @(import("system/package.zy")) that
  let make_numeric = @(import("numeric/package.zy")) that
  let Prelude = @(import("data/prelude.type.zy")) in
  let Additive = @(import("numeric/additive.type.zy")) in
  let Multiplicative = @(import("numeric/multiplicative.type.zy")) in
  let PartialEquality = @(import("numeric/partial-equality.type.zy")) in
  let PartialOrder = @(import("numeric/partial-order.type.zy")) in
  let Numeric = @(import("numeric/numeric.type.zy")) in

  begin
    param (
      (/core; /representations; /numeric; /system = (/Reader; /Writer; /OS); builtin)
    ) in
    let (/VType; /CType; /Thk; /Ret; /Unit) = core in
    let (#Int8 = Int8, int8) = numeric/int8 in
    let (#Int16 = Int16, int16) = numeric/int16 in
    let (#Int32 = Int32, int32) = numeric/int32 in
    let (#Int64 = Int64, int64) = numeric/int64 in
    let (#UInt8 = UInt8, uint8) = numeric/uint8 in
    let (#UInt16 = UInt16, uint16) = numeric/uint16 in
    let (#UInt32 = UInt32, uint32) = numeric/uint32 in
    let (#UInt64 = UInt64, uint64) = numeric/uint64 in
    let (#Float32 = Float32, float32) = numeric/float32 in
    let (#Float64 = Float64, float64) = numeric/float64 in
    let (/Char) = representations/char in
    let (/String) = representations/string in
    let (/Bytes) = representations/bytes in
    let (/Bool; /Option; /Result; /List; /bool; /option; /result; /list; base) =
      make_data builtin
    in
    let (/char; /string; /bytes; text) = make_text builtin base in
    let (/Path; /IoErrorKind; /IoError; /io; /fs; /stdio; /process; system) =
      make_system builtin base
    in
    let (
      /numeric;
      /primitives;
      /int8;
      /int16;
      /int32;
      /int64;
      /uint8;
      /uint16;
      /uint32;
      /uint64;
      /float32;
      /float64;
      numeric_modules
    ) =
      make_numeric builtin base
    in
    let prelude : Prelude = (
      #Thunk = Thk,
      #U = Thk,
      #F = Ret,
      ()
    ) in
    (
      = Bool,
      = Option,
      = Result,
      = List,
      = Int8,
      = Int16,
      = Int32,
      = Int64,
      = UInt8,
      = UInt16,
      = UInt32,
      = UInt64,
      = Float32,
      = Float64,
      = Char,
      = String,
      = Bytes,
      = Reader,
      = Writer,
      = Path,
      = IoErrorKind,
      = IoError,
      = OS,
      = Additive,
      = Multiplicative,
      = PartialEquality,
      = PartialOrder,
      = Numeric,
      = prelude,
      (
        = bool,
        = option,
        = result,
        = list,
        ()
      ),
      (
        = numeric,
        = primitives,
        = int8,
        = int16,
        = int32,
        = int64,
        = uint8,
        = uint16,
        = uint32,
        = uint64,
        = float32,
        = float64,
        ()
      ),
      (
        = char,
        = string,
        = bytes,
        ()
      ),
      (
        = io,
        = fs,
        = stdio,
        = process,
        ()
      ),
      ()
    )
  end
end
-- end module Std
