@[package(library, name(std))]
let (/List; /bool; /option; /either; /list) = @(import("data/package.zy")) in
let (
  /int8; /int16; /int32; /int64; /int;
  /uint8; /uint16; /uint32; /uint64; /uint;
  /float32; /float64;
  /dictionaries
)
=
  @(import("numeric/package.zy"))
in
let (/char; /string) = @(import("text/package.zy")) in
let (/Additive; /Multiplicative; /PartialEquality; /PartialOrder; /Numeric) = @(import(
  "numeric/dictionary.zy"
)) in
let MemoryBuiltin = @(import("builtin/memory.zy")) in
begin
  param val (/Addr; /memory_ops; /OS = _; builtin) : @(import("builtin.zy")) that

  let memory_builtin : MemoryBuiltin = (= Addr, memory_ops) in
  let (/Bytes) = memory_builtin |> (@(import("text/bytes.zy"))) in
  let codecs = memory_builtin |> (@(import("numeric/codecs.zy"))) in
  let (= Buffer, buffer) = memory_builtin |> (@(import("memory/buffer.zy"))) in
  let bytes = memory_builtin |> (@(import("text/bytes-ops.zy"))) in
  let memory = memory_builtin |> (@(import("memory/package.zy"))) in
  let (/Path; /IoErrorKind; /IoError; /io; /fs; /stdio; /process; system) =
    builtin |> (@(import("system/package.zy")))
  in
  pack
    (= Bool as Bool)
    (= Option as Option)
    (= Either as Either)
    (= Bytes as Bytes)
    (= Buffer as Buffer)
    (= List as List)
    (= Path as Path)
    (= IoErrorKind as IoErrorKind)
    (= IoError as IoError)
    (= Additive as Additive)
    (= Multiplicative as Multiplicative)
    (= PartialEquality as PartialEquality)
    (= PartialOrder as PartialOrder)
    (= Numeric as Numeric)
  where
    (
      = bool,
      = option,
      = either,
      = list
    ),
    (
      #int8 = (int8, codecs/int8),
      #int16 = (int16, codecs/int16),
      #int32 = (int32, codecs/int32),
      #int64 = (int64, codecs/int64),
      #int = (int, codecs/int),
      #uint8 = (uint8, codecs/uint8),
      #uint16 = (uint16, codecs/uint16),
      #uint32 = (uint32, codecs/uint32),
      #uint64 = (uint64, codecs/uint64),
      #uint = (uint, codecs/uint),
      #float32 = (float32, codecs/float32),
      #float64 = (float64, codecs/float64)
    ),
    (
      = dictionaries, = buffer
    ),
    (
      = char,
      = string,
      = bytes
    ),
    (
      = io,
      = fs,
      = stdio,
      = process
    )
  end
end
-- end module Std
