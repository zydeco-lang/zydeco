begin
  let bool = @[import("bool.zy")] _ that
  let option = @[import("option.zy")] _ that
  let result = @[import("result.zy")] _ that
  let list = @[import("list.zy")] _ that
  let io_types = @[import("io-types.zy")] _ that
  let interface = @[import("interface.zy")] _ that

  begin
    param (
      (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
      @[import("builtin.zy")] _
    ) in
      let (Bool = Bool, bool_api) =
        bool (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) in
      let (Option = Option, option_api) =
        option (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) in
      let (Result = Result, result_api) =
        result (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) in
      let (List = List, list_api) =
        list (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) in
      let (
        IoErrorKind = IoErrorKind,
        IoError = IoError,
        Path = Path,
        io_types_api
      ) = io_types (
        VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api
      ) in
      let (= Prelude, = Public, ()) =
        interface (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) in
      let primitive_add = api/add in
      let primitive_int_eq = api/int_eq_branch in
      let primitive_int_lt = api/int_lt_branch in
      let primitive_int_gt = api/int_gt_branch in
      let primitive_str_split_once = api/str_split_once_branch in
      let primitive_str_split_at = api/str_split_at_branch in
      let primitive_str_eq = api/str_eq_branch in
      let primitive_str_get = api/str_get_branch in
      let primitive_char_from_codepoint = api/char_from_codepoint_branch in
      let primitive_str_parse_int = api/str_parse_int_branch in
      let primitive_bytes_to_str = api/bytes_to_str_branch in
      let primitive_arg_fold = api/arg_fold in
      let ! increment (value : Int) : Ret Int =
        ! primitive_add value 1
      in
      let ! decrement (value : Int) : Ret Int =
        ! (api/sub) value 1
      in
      let ! negate (value : Int) : Ret Int =
        ! (api/sub) 0 value
      in
      let ! compare
        (A : VType)
        (predicate : Thk (
          forall (B : CType) .
            A -> A -> Thk B -> Thk B -> B
        ))
        (left : A)
        (right : A)
        : Ret Bool =
        ! predicate
          (Ret Bool)
          left
          right
          { ret (bool_api/true) }
          { ret (bool_api/false) }
      in
      let ! int_eq (left : Int) (right : Int) : Ret Bool =
        ! compare Int primitive_int_eq left right
      in
      let ! int_lt (left : Int) (right : Int) : Ret Bool =
        ! compare Int primitive_int_lt left right
      in
      let ! int_gt (left : Int) (right : Int) : Ret Bool =
        ! compare Int primitive_int_gt left right
      in
      let ! int_ne (left : Int) (right : Int) : Ret Bool =
        do equal <- ! int_eq left right;
        ! (bool_api/not) equal
      in
      let ! int_le (left : Int) (right : Int) : Ret Bool =
        do greater <- ! int_gt left right;
        ! (bool_api/not) greater
      in
      let ! int_ge (left : Int) (right : Int) : Ret Bool =
        do less <- ! int_lt left right;
        ! (bool_api/not) less
      in
      let ! int_min (left : Int) (right : Int) : Ret Int =
        do less <- ! int_lt left right;
        ! (bool_api/if) (Ret Int) less { ret left } { ret right }
      in
      let ! int_max (left : Int) (right : Int) : Ret Int =
        do greater <- ! int_gt left right;
        ! (bool_api/if) (Ret Int) greater { ret left } { ret right }
      in
      let ! str_eq (left : String) (right : String) : Ret Bool =
        ! compare String primitive_str_eq left right
      in
      let ! option_is_some (A : VType) (option : Option A) : Ret Bool =
        ! (option_api/fold)
          A
          (Ret Bool)
          option
          { ret (bool_api/false) }
          { fn _ => ret (bool_api/true) }
      in
      let ! option_is_none (A : VType) (option : Option A) : Ret Bool =
        do present <- ! option_is_some A option;
        ! (bool_api/not) present
      in
      let ! result_is_ok
        (A : VType)
        (E : VType)
        (result : Result A E)
        : Ret Bool =
        ! (result_api/fold)
          A
          E
          (Ret Bool)
          result
          { fn _ => ret (bool_api/true) }
          { fn _ => ret (bool_api/false) }
      in
      let ! result_is_err
        (A : VType)
        (E : VType)
        (result : Result A E)
        : Ret Bool =
        do successful <- ! result_is_ok A E result;
        ! (bool_api/not) successful
      in
      let ! list_is_empty (A : VType) (list : List A) : Ret Bool =
        ! (list_api/case)
          A
          (Ret Bool)
          list
          { ret (bool_api/true) }
          { fn _ _ => ret (bool_api/false) }
      in
      let ! list_head (A : VType) (list : List A) : Ret (Option A) =
        ! (list_api/case)
          A
          (Ret (Option A))
          list
          { ! (option_api/none) A }
          { fn head _ => ! (option_api/some) A head }
      in
      let ! list_tail (A : VType) (list : List A) : Ret (Option (List A)) =
        ! (list_api/case)
          A
          (Ret (Option (List A)))
          list
          { ! (option_api/none) (List A) }
          { fn _ tail => ! (option_api/some) (List A) tail }
      in
      let fix list_get (A : VType) (list : List A) (index : Int) : Ret (Option A) =
        do negative <- ! int_lt index 0;
        ! (bool_api/if)
          (Ret (Option A))
          negative
          { ! (option_api/none) A }
          {
            ! (list_api/case)
              A
              (Ret (Option A))
              list
              { ! (option_api/none) A }
              {
                fn head tail =>
                  do zero <- ! int_eq index 0;
                  ! (bool_api/if)
                    (Ret (Option A))
                    zero
                    { ! (option_api/some) A head }
                    {
                      do previous <- ! (api/sub) index 1;
                      ! list_get A tail previous
                    }
              }
          }
      in
      let ! str_split_once (string : String) (separator : Char) : Ret (Option (String * String)) =
        ! primitive_str_split_once
          (Ret (Option (String * String)))
          string
          separator
          { ! (option_api/none) (String * String) }
          {
            fn first second =>
              ! (option_api/some) (String * String) (first, second)
          }
      in
      let ! str_split_at (string : String) (index : Int) : Ret (Option (String * String)) =
        ! primitive_str_split_at
          (Ret (Option (String * String)))
          string
          index
          { ! (option_api/none) (String * String) }
          {
            fn first second =>
              ! (option_api/some) (String * String) (first, second)
          }
      in
      let ! str_get (string : String) (index : Int) : Ret (Option Char) =
        ! primitive_str_get
          (Ret (Option Char))
          string
          index
          { ! (option_api/none) Char }
          { fn character => ! (option_api/some) Char character }
      in
      let ! char_from_codepoint (codepoint : Int) : Ret (Option Char) =
        ! primitive_char_from_codepoint
          (Ret (Option Char))
          codepoint
          { ! (option_api/none) Char }
          { fn character => ! (option_api/some) Char character }
      in
      let ! str_parse_int (string : String) : Ret (Option Int) =
        ! primitive_str_parse_int
          (Ret (Option Int))
          string
          { ! (option_api/none) Int }
          { fn integer => ! (option_api/some) Int integer }
      in
      let ! str_is_empty (string : String) : Ret Bool =
        do length <- ! (api/str_scalar_length) string;
        ! int_eq length 0
      in
      let ! str_head (string : String) : Ret (Option Char) =
        ! str_get string 0
      in
      let ! str_uncons (string : String) : Ret (Option (Char * String)) =
        do character <- ! str_get string 0;
        ! (option_api/and_then)
          Char
          (Char * String)
          character
          {
            fn head =>
              do split <- ! str_split_at string 1;
              ! (option_api/map)
                (String * String)
                (Char * String)
                split
                { fn (_, tail) => ret (head, tail) }
          }
      in
      let fix str_to_chars (string : String) : Ret (List Char) =
        do first <- ! str_uncons string;
        ! (option_api/fold)
          (Char * String)
          (Ret (List Char))
          first
          { ! (list_api/nil) Char }
          {
            fn (head, tail) =>
              do rest <- ! str_to_chars tail;
              ! (list_api/cons) Char head rest
          }
      in
      let fix str_from_chars (characters : List Char) : Ret String =
        ! (list_api/case)
          Char
          (Ret String)
          characters
          { ret "" }
          {
            fn head tail =>
              do first <- ! (api/char_to_str) head;
              do rest <- ! str_from_chars tail;
              ! (api/str_append) first rest
          }
      in
      let ! str_concat (strings : List String) : Ret String =
        ! (list_api/fold)
          String
          (Ret String)
          strings
          { ret "" }
          {
            fn head tail =>
              do rest <- ! tail;
              ! (api/str_append) head rest
          }
      in
      let ! bytes_to_string (bytes : Bytes) : Ret (Option String) =
        ! primitive_bytes_to_str
          (Ret (Option String))
          bytes
          { ! (option_api/none) String }
          { fn string => ! (option_api/some) String string }
      in
      let ! make_io_error (code : Int) (message : String) : Ret IoError =
        do kind <- ! (io_types_api/from_code) code;
        ! (io_types_api/error) kind message
      in
      let ! io_kind_eq (left : IoErrorKind) (right : IoErrorKind) : Ret Bool =
        ! (io_types_api/kind_eq_branch)
          (Ret Bool)
          left
          right
          { ret (bool_api/true) }
          { ret (bool_api/false) }
      in
      let ! continue_io_ok
        (A : VType)
        (continuation : Thk (Result A IoError -> OS))
        (value : A)
        : OS =
        do result <- ! (result_api/ok) A IoError value;
        ! continuation result
      in
      let ! continue_io_error
        (A : VType)
        (continuation : Thk (Result A IoError -> OS))
        (error : IoError)
        : OS =
        do result <- ! (result_api/err) A IoError error;
        ! continuation result
      in
      let ! continue_host_error
        (A : VType)
        (continuation : Thk (Result A IoError -> OS))
        (code : Int)
        (message : String)
        : OS =
        do error <- ! make_io_error code message;
        ! continue_io_error A continuation error
      in
      let ! io_read
        (reader : Reader)
        (count : Int)
        (continuation : Thk (Result Bytes IoError -> OS))
        : OS =
        ! (api/io_read)
          reader
          count
          { fn code message => ! continue_host_error Bytes continuation code message }
          { fn bytes => ! continue_io_ok Bytes continuation bytes }
      in
      let ! io_read_line
        (reader : Reader)
        (continuation : Thk (Result (Option Bytes) IoError -> OS))
        : OS =
        ! (api/io_read_line)
          reader
          {
            fn code message =>
              ! continue_host_error (Option Bytes) continuation code message
          }
          {
            do absent <- ! (option_api/none) Bytes;
            ! continue_io_ok (Option Bytes) continuation absent
          }
          {
            fn bytes =>
              do present <- ! (option_api/some) Bytes bytes;
              ! continue_io_ok (Option Bytes) continuation present
          }
      in
      let ! io_read_all
        (reader : Reader)
        (continuation : Thk (Result Bytes IoError -> OS))
        : OS =
        ! (api/io_read_all)
          reader
          { fn code message => ! continue_host_error Bytes continuation code message }
          { fn bytes => ! continue_io_ok Bytes continuation bytes }
      in
      let ! io_write_all
        (writer : Writer)
        (bytes : Bytes)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! (api/io_write_all)
          writer
          bytes
          { fn code message => ! continue_host_error Unit continuation code message }
          { ! continue_io_ok Unit continuation () }
      in
      let ! io_flush
        (writer : Writer)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! (api/io_flush)
          writer
          { fn code message => ! continue_host_error Unit continuation code message }
          { ! continue_io_ok Unit continuation () }
      in
      let ! io_close_reader
        (reader : Reader)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! (api/io_close_reader)
          reader
          { fn code message => ! continue_host_error Unit continuation code message }
          { ! continue_io_ok Unit continuation () }
      in
      let ! io_close_writer
        (writer : Writer)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! (api/io_close_writer)
          writer
          { fn code message => ! continue_host_error Unit continuation code message }
          { ! continue_io_ok Unit continuation () }
      in
      let ! fs_open_reader
        (path : Path)
        (continuation : Thk (Result Reader IoError -> OS))
        : OS =
        do string <- ! (io_types_api/path_string) path;
        ! (api/fs_open_reader)
          string
          { fn code message => ! continue_host_error Reader continuation code message }
          { fn reader => ! continue_io_ok Reader continuation reader }
      in
      let ! fs_create_writer
        (path : Path)
        (continuation : Thk (Result Writer IoError -> OS))
        : OS =
        do string <- ! (io_types_api/path_string) path;
        ! (api/fs_create_writer)
          string
          { fn code message => ! continue_host_error Writer continuation code message }
          { fn writer => ! continue_io_ok Writer continuation writer }
      in
      let ! fs_append_writer
        (path : Path)
        (continuation : Thk (Result Writer IoError -> OS))
        : OS =
        do string <- ! (io_types_api/path_string) path;
        ! (api/fs_append_writer)
          string
          { fn code message => ! continue_host_error Writer continuation code message }
          { fn writer => ! continue_io_ok Writer continuation writer }
      in
      let ! finish_reader
        (A : VType)
        (reader : Reader)
        (operation : Result A IoError)
        (continuation : Thk (Result A IoError -> OS))
        : OS =
        ! (result_api/fold)
          A
          IoError
          OS
          operation
          {
            fn value =>
              ! io_close_reader reader {
                fn close_result =>
                  ! (result_api/fold)
                    Unit
                    IoError
                    OS
                    close_result
                    { fn _ => ! continue_io_ok A continuation value }
                    { fn error => ! continue_io_error A continuation error }
              }
          }
          {
            fn operation_error =>
              ! io_close_reader reader {
                fn _ => ! continue_io_error A continuation operation_error
              }
          }
      in
      let ! finish_writer
        (writer : Writer)
        (operation : Result Unit IoError)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! (result_api/fold)
          Unit
          IoError
          OS
          operation
          {
            fn _ =>
              ! io_close_writer writer continuation
          }
          {
            fn operation_error =>
              ! io_close_writer writer {
                fn _ => ! continue_io_error Unit continuation operation_error
              }
          }
      in
      let ! fs_read_bytes
        (path : Path)
        (continuation : Thk (Result Bytes IoError -> OS))
        : OS =
        ! fs_open_reader path {
          fn opened =>
            ! (result_api/fold)
              Reader
              IoError
              OS
              opened
              {
                fn reader =>
                  ! io_read_all reader {
                    fn operation => ! finish_reader Bytes reader operation continuation
                  }
              }
              { fn error => ! continue_io_error Bytes continuation error }
        }
      in
      let ! fs_read_text
        (path : Path)
        (continuation : Thk (Result String IoError -> OS))
        : OS =
        ! fs_read_bytes path {
          fn result =>
            ! (result_api/fold)
              Bytes
              IoError
              OS
              result
              {
                fn bytes =>
                  ! primitive_bytes_to_str
                    OS
                    bytes
                    {
                      do error <- ! (io_types_api/error)
                        (io_types_api/invalid_data)
                        "file is not valid UTF-8";
                      ! continue_io_error String continuation error
                    }
                    { fn string => ! continue_io_ok String continuation string }
              }
              { fn error => ! continue_io_error String continuation error }
        }
      in
      let ! fs_write_bytes
        (path : Path)
        (bytes : Bytes)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! fs_create_writer path {
          fn opened =>
            ! (result_api/fold)
              Writer
              IoError
              OS
              opened
              {
                fn writer =>
                  ! io_write_all writer bytes {
                    fn operation => ! finish_writer writer operation continuation
                  }
              }
              { fn error => ! continue_io_error Unit continuation error }
        }
      in
      let ! fs_write_text
        (path : Path)
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do bytes <- ! (api/bytes_from_str) string;
        ! fs_write_bytes path bytes continuation
      in
      let ! write_bytes_and_flush
        (writer : Writer)
        (bytes : Bytes)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        ! io_write_all writer bytes {
          fn written =>
            ! (result_api/fold)
              Unit
              IoError
              OS
              written
              { fn _ => ! io_flush writer continuation }
              { fn error => ! continue_io_error Unit continuation error }
        }
      in
      let ! stdio_write_to
        (writer : Writer)
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do bytes <- ! (api/bytes_from_str) string;
        ! write_bytes_and_flush writer bytes continuation
      in
      let ! stdio_write_line_to
        (writer : Writer)
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do bytes <- ! (api/bytes_from_str) string;
        do newline <- ! (api/bytes_from_str) "\n";
        do line <- ! (api/bytes_append) bytes newline;
        ! write_bytes_and_flush writer line continuation
      in
      let ! stdio_read_line
        (continuation : Thk (Result (Option String) IoError -> OS))
        : OS =
        do reader <- ! (api/stdin);
        ! io_read_line reader {
          fn result =>
            ! (result_api/fold)
              (Option Bytes)
              IoError
              OS
              result
              {
                fn line =>
                  ! (option_api/fold)
                    Bytes
                    OS
                    line
                    {
                      do absent <- ! (option_api/none) String;
                      ! continue_io_ok (Option String) continuation absent
                    }
                    {
                      fn bytes =>
                        ! primitive_bytes_to_str
                          OS
                          bytes
                          {
                            do error <- ! (io_types_api/error)
                              (io_types_api/invalid_data)
                              "standard input is not valid UTF-8";
                            ! continue_io_error (Option String) continuation error
                          }
                          {
                            fn string =>
                              do present <- ! (option_api/some) String string;
                              ! continue_io_ok (Option String) continuation present
                          }
                    }
              }
              { fn error => ! continue_io_error (Option String) continuation error }
        }
      in
      let ! stdio_write
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do writer <- ! (api/stdout);
        ! stdio_write_to writer string continuation
      in
      let ! stdio_write_line
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do writer <- ! (api/stdout);
        ! stdio_write_line_to writer string continuation
      in
      let ! stdio_write_error
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do writer <- ! (api/stderr);
        ! stdio_write_to writer string continuation
      in
      let ! stdio_write_error_line
        (string : String)
        (continuation : Thk (Result Unit IoError -> OS))
        : OS =
        do writer <- ! (api/stderr);
        ! stdio_write_line_to writer string continuation
      in
      let ! arg_list (continuation : Thk (List String -> OS)) : OS =
        do arguments <- ! primitive_arg_fold
          (Ret (List String))
          { ! (list_api/nil) String }
          {
            fn argument remaining =>
              do tail <- ! remaining;
              ! (list_api/cons) String argument tail
          };
        ! continuation arguments
      in
      let halt : Thk OS = { ! (api/exit) 0 } in
      let ! panic (message : String) : OS =
        ! stdio_write_error_line message { fn _ => ! (api/exit) 1 }
      in
      let prelude : Prelude = (
        Thunk = Thk,
        U = Thk,
        F = Ret,
        ()
      ) in
      ((
        Bool = Bool,
        Option = Option,
        Result = Result,
        List = List,
        Int = Int,
        Char = Char,
        String = String,
        Bytes = Bytes,
        Reader = Reader,
        Writer = Writer,
        Path = Path,
        IoErrorKind = IoErrorKind,
        IoError = IoError,
        OS = OS,
        prelude = prelude,
        bool = (
          true = bool_api/true,
          false = bool_api/false,
          not = bool_api/not,
          and = bool_api/and,
          or = bool_api/or,
          eq = bool_api/eq,
          xor = bool_api/xor,
          nand = bool_api/nand,
          nor = bool_api/nor,
          if = bool_api/if,
        ),
        option = (
          none = option_api/none,
          some = option_api/some,
          fold = option_api/fold,
          map = option_api/map,
          and_then = option_api/and_then,
          unwrap_or = option_api/unwrap_or,
          or_else = option_api/or_else,
          zip = option_api/zip,
          is_some = option_is_some,
          is_none = option_is_none,
        ),
        result = (
          ok = result_api/ok,
          err = result_api/err,
          fold = result_api/fold,
          map = result_api/map,
          map_err = result_api/map_err,
          and_then = result_api/and_then,
          unwrap_or = result_api/unwrap_or,
          is_ok = result_is_ok,
          is_err = result_is_err,
        ),
        list = (
          nil = list_api/nil,
          cons = list_api/cons,
          case = list_api/case,
          fold = list_api/fold,
          singleton = list_api/singleton,
          append = list_api/append,
          map = list_api/map,
          fold_left = list_api/fold_left,
          reverse = list_api/reverse,
          length = list_api/length,
          is_empty = list_is_empty,
          head = list_head,
          tail = list_tail,
          get = list_get,
        ),
        int = (
          add = primitive_add,
          sub = api/sub,
          mul = api/mul,
          div = api/div,
          mod = api/mod,
          eq = int_eq,
          ne = int_ne,
          lt = int_lt,
          le = int_le,
          gt = int_gt,
          ge = int_ge,
          increment = increment,
          decrement = decrement,
          negate = negate,
          min = int_min,
          max = int_max,
          to_string = api/int_to_str,
        ),
        char = (
          to_string = api/char_to_str,
          codepoint = api/char_codepoint,
          from_codepoint = char_from_codepoint,
        ),
        string = (
          empty = "",
          length = api/str_scalar_length,
          byte_length = api/str_byte_length,
          is_empty = str_is_empty,
          append = api/str_append,
          concat = str_concat,
          split_once = str_split_once,
          split_at = str_split_at,
          eq = str_eq,
          get = str_get,
          head = str_head,
