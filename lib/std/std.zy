begin
  let bool = @[import("bool.zy")] _ that
  let option = @[import("option.zy")] _ that
  let list = @[import("list.zy")] _ that

  begin
    param (
      (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
      @[import("builtin.zy")] _
    ) in
      let (Bool = Bool, bool_api) =
        bool (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
      let (Option = Option, option_api) =
        option (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
      let (List = List, list_api) =
        list (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
      let primitive_add = api/add in
      let primitive_int_eq = api/int_eq_branch in
      let primitive_int_lt = api/int_lt_branch in
      let primitive_int_gt = api/int_gt_branch in
      let primitive_str_split_once = api/str_split_once_branch in
      let primitive_str_split_n = api/str_split_n_branch in
      let primitive_str_eq = api/str_eq_branch in
      let primitive_read_line_as_int = api/read_line_as_int_branch in
      let primitive_arg_fold = api/arg_fold in
      let ! increment (value : Int) : Ret Int =
        ! primitive_add value 1
      in
      let ! compare
        (A : VType)
        (predicate : Thk (
          forall (B : CType) .
            A -> A -> Thk B -> Thk B -> B
        ))
        (left : A)
        (right : A)
        : Ret Bool =
        ! predicate
          (Ret Bool)
          left
          right
          { ret (bool_api/true) }
          { ret (bool_api/false) }
      in
      let ! int_eq (left : Int) (right : Int) : Ret Bool =
        ! compare Int primitive_int_eq left right
      in
      let ! int_lt (left : Int) (right : Int) : Ret Bool =
        ! compare Int primitive_int_lt left right
      in
      let ! int_gt (left : Int) (right : Int) : Ret Bool =
        ! compare Int primitive_int_gt left right
      in
      let ! str_eq (left : String) (right : String) : Ret Bool =
        ! compare String primitive_str_eq left right
      in
      let ! str_split_once (string : String) (separator : Char) : Ret (Option (String * String)) =
        ! primitive_str_split_once
          (Ret (Option (String * String)))
          string
          separator
          { ! (option_api/none) (String * String) }
          {
            fn first second ->
              ! (option_api/some) (String * String) (first, second)
          }
      in
      let ! str_split_n (string : String) (index : Int) : Ret (Option (String * String)) =
        ! primitive_str_split_n
          (Ret (Option (String * String)))
          string
          index
          { ! (option_api/none) (String * String) }
          {
            fn first second ->
              ! (option_api/some) (String * String) (first, second)
          }
      in
      let ! read_line_as_int (continuation : Thk (Option Int -> OS)) : OS =
        ! primitive_read_line_as_int
          {
            do absent <- ! (option_api/none) Int;
            ! continuation absent
          }
          {
            fn integer ->
              do present <- ! (option_api/some) Int integer;
              ! continuation present
          }
      in
      let ! arg_list (continuation : Thk (List String -> OS)) : OS =
        do arguments <- ! primitive_arg_fold
          (Ret (List String))
          { ! (list_api/nil) String }
          {
            fn argument remaining ->
              do tail <- ! remaining;
              ! (list_api/cons) String argument tail
          };
        ! continuation arguments
      in
      let Prelude =
        exists (
          Thunk = PublicThunk as Thk :
          (CType) -> (VType)
        ) .
        exists (
          U = PublicU as Thk :
          (CType) -> (VType)
        ) .
        exists (
          F = PublicF as Ret :
          (VType) -> (CType)
        ) .
          Unit
      in
      let prelude : Prelude = (
        Thunk = Thk,
        U = Thk,
        F = Ret,
        ()
      ) in
      let BoolModule (PublicBool : VType) =
        (true :: PublicBool) *
        (false :: PublicBool) *
        (not :: Thk (PublicBool -> Ret PublicBool)) *
        (and :: Thk (PublicBool -> PublicBool -> Ret PublicBool)) *
        (or :: Thk (PublicBool -> PublicBool -> Ret PublicBool)) *
        (if :: Thk (
          forall (B : CType) .
            PublicBool -> Thk B -> Thk B -> B
        ))
      in
      let OptionModule (PublicOption : (VType) -> (VType)) =
        (none :: Thk (
          forall (A : VType) .
            Ret (PublicOption A)
        )) *
        (some :: Thk (
          forall (A : VType) .
            A -> Ret (PublicOption A)
        )) *
        (fold :: Thk (
          forall (A : VType) .
          forall (B : CType) .
            PublicOption A -> Thk B -> Thk (A -> B) -> B
        ))
      in
      let ListModule (PublicList : (VType) -> (VType)) =
        (nil :: Thk (
          forall (A : VType) .
            Ret (PublicList A)
        )) *
        (cons :: Thk (
          forall (A : VType) .
            A -> PublicList A -> Ret (PublicList A)
        )) *
        (case :: Thk (
          forall (A : VType) .
          forall (B : CType) .
            PublicList A ->
            Thk B ->
            Thk (A -> PublicList A -> B) ->
            B
        )) *
        (fold :: Thk (
          forall (A : VType) .
          forall (B : CType) .
            PublicList A ->
            Thk B ->
            Thk (A -> Thk B -> B) ->
            B
        ))
      in
      --| Conversions
      let IntModule (PublicBool : VType) (PublicInt : VType) (PublicString : VType) =
        (add :: Thk (PublicInt -> PublicInt -> Ret PublicInt)) *
        (sub :: Thk (PublicInt -> PublicInt -> Ret PublicInt)) *
        (mul :: Thk (PublicInt -> PublicInt -> Ret PublicInt)) *
        (div :: Thk (PublicInt -> PublicInt -> Ret PublicInt)) *
        (mod :: Thk (PublicInt -> PublicInt -> Ret PublicInt)) *
        (eq :: Thk (PublicInt -> PublicInt -> Ret PublicBool)) *
        (lt :: Thk (PublicInt -> PublicInt -> Ret PublicBool)) *
        (gt :: Thk (PublicInt -> PublicInt -> Ret PublicBool)) *
        (increment :: Thk (PublicInt -> Ret PublicInt)) *
        (to_str :: Thk (PublicInt -> Ret PublicString))
      in
      let CharModule (PublicChar : VType) (PublicInt : VType) (PublicString : VType) =
        (to_str :: Thk (PublicChar -> Ret PublicString)) *
        (to_int :: Thk (PublicChar -> Ret PublicInt))
      in
      -- module String
      let StringModule
        (PublicBool : VType)
        (PublicOption : (VType) -> (VType))
        (PublicInt : VType)
        (PublicChar : VType)
        (PublicString : VType) =
        (length :: Thk (PublicString -> Ret PublicInt)) *
        (append :: Thk (PublicString -> PublicString -> Ret PublicString)) *
        (split_once :: Thk (
          PublicString ->
          PublicChar ->
          Ret (PublicOption (PublicString * PublicString))
        )) *
        (split_n :: Thk (
          PublicString ->
          PublicInt ->
          Ret (PublicOption (PublicString * PublicString))
        )) *
        (eq :: Thk (PublicString -> PublicString -> Ret PublicBool)) *
        (index :: Thk (PublicString -> PublicInt -> Ret PublicChar)) *
        (to_int :: Thk (PublicString -> Ret PublicInt))
      in
      -- end module String
      -- module OS
      let OSModule
        (PublicOption : (VType) -> (VType))
        (PublicList : (VType) -> (VType))
        (PublicInt : VType)
        (PublicString : VType)
        (PublicOS : CType) =
        (write_str :: Thk (PublicString -> Thk PublicOS -> PublicOS)) *
        (write_int :: Thk (PublicInt -> Thk PublicOS -> PublicOS)) *
        (write_line :: Thk (PublicString -> Thk PublicOS -> PublicOS)) *
        (read_line :: Thk (Thk (PublicString -> PublicOS) -> PublicOS)) *
        (read_line_as_int :: Thk (
          Thk (PublicOption PublicInt -> PublicOS) -> PublicOS
        )) *
        (read_till_eof :: Thk (Thk (PublicString -> PublicOS) -> PublicOS)) *
        (arg_list :: Thk (Thk (PublicList PublicString -> PublicOS) -> PublicOS)) *
        (random_int :: Thk (Thk (PublicInt -> PublicOS) -> PublicOS)) *
        (exit :: Thk (PublicInt -> PublicOS))
      in
      -- end module OS
      let Public =
        exists (Bool = PublicBool : VType) .
        exists (
          Option = PublicOption :
          (VType) -> (VType)
        ) .
        exists (
          List = PublicList :
          (VType) -> (VType)
        ) .
        exists (Int = PublicInt as Int : VType) .
        exists (Char = PublicChar as Char : VType) .
        exists (String = PublicString as String : VType) .
        exists (OS = PublicOS as OS : CType) .
          (prelude :: Prelude) *
          (bool :: BoolModule PublicBool) *
          (option :: OptionModule PublicOption) *
          (list :: ListModule PublicList) *
          (int :: IntModule PublicBool PublicInt PublicString) *
          (char :: CharModule PublicChar PublicInt PublicString) *
          (string :: StringModule PublicBool PublicOption PublicInt PublicChar PublicString) *
          (os :: OSModule PublicOption PublicList PublicInt PublicString PublicOS) *
          Unit
      in
      ((
        Bool = Bool,
        Option = Option,
        List = List,
        Int = Int,
        Char = Char,
        String = String,
        OS = OS,
        prelude = prelude,
        bool = (
          true = bool_api/true,
          false = bool_api/false,
          not = bool_api/not,
          and = bool_api/and,
          or = bool_api/or,
          if = bool_api/if,
        ),
        option = (
          none = option_api/none,
          some = option_api/some,
          fold = option_api/fold,
        ),
        list = (
          nil = list_api/nil,
          cons = list_api/cons,
          case = list_api/case,
          fold = list_api/fold,
        ),
        int = (
          add = primitive_add,
          sub = api/sub,
          mul = api/mul,
          div = api/div,
          mod = api/mod,
          eq = int_eq,
          lt = int_lt,
          gt = int_gt,
          increment = increment,
          to_str = api/int_to_str,
        ),
        char = (
          to_str = api/char_to_str,
          to_int = api/char_to_int,
        ),
        string = (
          length = api/str_length,
          append = api/str_append,
          split_once = str_split_once,
          split_n = str_split_n,
          eq = str_eq,
          index = api/str_index,
          to_int = api/str_to_int,
        ),
        os = (
          write_str = api/write_str,
          write_int = api/write_int,
          write_line = api/write_line,
          read_line = api/read_line,
          read_line_as_int = read_line_as_int,
          read_till_eof = api/read_till_eof,
          arg_list = arg_list,
          random_int = api/random_int,
          exit = api/exit,
        ),
        (),
      ) : Public)
  end
end
