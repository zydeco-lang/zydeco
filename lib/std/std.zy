@[package(library, name(std))]
let (/VType) = @(import("primitive.zy")) in
let (/make = make_bytes) = @(import("text/bytes.zy")) in
let (/Additive; /Multiplicative; /PartialEquality; /PartialOrder; /Numeric) = @(import(
  "numeric/dictionary.zy"
)) in
begin
  param val (/OS = _; builtin) : @(import("builtin.zy")) that
  let (/make = make_data) = @(import("data/package.zy")) that
  let make_text = @(import("text/package.zy")) that
  let make_system = @(import("system/package.zy")) that
  let make_numeric = @(import("numeric/package.zy")) that

  let (/Bool; /Option; /Either; /List; /bool; /option; /either; /list; base) =
    builtin |> make_data
  in
  let (/Bytes; byte_package) = builtin |> make_bytes in
  let codecs = (builtin |> (@(import("numeric/codecs.zy")))) byte_package in
  let (= Buffer, buffer) = (builtin |> (@(import("memory/buffer.zy")))) byte_package in
  let (/char; /string; /bytes; text) = (builtin |> make_text) byte_package base in
  let (/Path; /IoErrorKind; /IoError; /io; /fs; /stdio; /process; system) =
    (builtin |> make_system) byte_package base
  in
  let (
    /int8; /int16; /int32; /int64; /int;
    /uint8; /uint16; /uint32; /uint64; /uint;
    /float32; /float64;
    /dictionaries
  )
  =
    (builtin, base) |> make_numeric
  in
  pack
    (= Bool as Bool)
    (= Option as Option)
    (= Either as Either)
    (= Bytes : VType) is Bytes
    (= Buffer : VType) is Buffer
    (= List : VType -> VType) is List
    (= Path : VType) is Path
    (= IoErrorKind : VType) is IoErrorKind
    (= IoError : VType) is IoError
    (= Additive as Additive)
    (= Multiplicative as Multiplicative)
    (= PartialEquality as PartialEquality)
    (= PartialOrder as PartialOrder)
    (= Numeric as Numeric)
  where
    (
      = bool,
      = option,
      = either,
      = list
    ),
    (
      #int8 = (int8, codecs/int8),
      #int16 = (int16, codecs/int16),
      #int32 = (int32, codecs/int32),
      #int64 = (int64, codecs/int64),
      #int = (int, codecs/int),
      #uint8 = (uint8, codecs/uint8),
      #uint16 = (uint16, codecs/uint16),
      #uint32 = (uint32, codecs/uint32),
      #uint64 = (uint64, codecs/uint64),
      #uint = (uint, codecs/uint),
      #float32 = (float32, codecs/float32),
      #float64 = (float64, codecs/float64)
    ),
    (
      = dictionaries, = buffer
    ),
    (
      = char,
      = string,
      = bytes
    ),
    (
      = io,
      = fs,
      = stdio,
      = process
    )
  end
end
-- end module Std
