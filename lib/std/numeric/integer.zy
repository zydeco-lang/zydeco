begin
  param val Bool : @(intrinsic(vtype)) that
  param val Scalar : @(intrinsic(vtype)) that
  param val String : @(intrinsic(vtype)) that
  param val (
    core : @(import("../builtin/core.zy")),
    bool : (@(import("../data/bool.type.zy"))) Bool,
    primitive : (@(import("primitive-integer.type.zy"))) Scalar String,
    zero : Scalar,
    one : Scalar
  ) that
  let (/VType; /CType; /Thk; /Ret; /Unit) = core in
  let Numeric = @(import("numeric.type.zy")) in
  let IntegerModule = @(import("integer.type.zy")) in
  let zero : Scalar = zero in
  let one : Scalar = one in
  let ! compare
    (
      predicate : Thk (
        forall (B : CType) . Scalar -> Scalar -> Thk B -> Thk B -> B
      )
    )
    (left : Scalar)
    (right : Scalar)
  : Ret Bool = ! predicate
      (Ret Bool)
      left
      right
      { ret bool/true }
      { ret bool/false }
  in
  let operations : IntegerModule Bool Scalar String = (
    #add = primitive/add,
    #sub = primitive/sub,
    #mul = primitive/mul,
    #div = primitive/div,
    #mod = primitive/mod,
    #eq = {
      fn left right => ! compare primitive/eq left right
    },
    #ne = {
      fn left right =>
        do equal <- ! compare primitive/eq left right;
        ! bool/not equal
    },
    #lt = {
      fn left right => ! compare primitive/lt left right
    },
    #le = {
      fn left right =>
        do greater <- ! compare primitive/gt left right;
        ! bool/not greater
    },
    #gt = {
      fn left right => ! compare primitive/gt left right
    },
    #ge = {
      fn left right =>
        do less <- ! compare primitive/lt left right;
        ! bool/not less
    },
    #increment = {
      fn value => ! primitive/add value one
    },
    #decrement = {
      fn value => ! primitive/sub value one
    },
    #negate = {
      fn value => ! primitive/sub zero value
    },
    #min = {
      fn left right =>
        do less <- ! compare primitive/lt left right;
        ! bool/if (Ret Scalar) less { ret left } { ret right }
    },
    #max = {
      fn left right =>
        do greater <- ! compare primitive/gt left right;
        ! bool/if (Ret Scalar) greater { ret left } { ret right }
    },
    #to_string = primitive/to_string
  ) in
  let dictionary : Numeric Bool Scalar = (
    #additive = (
      = zero,
      #add = operations/add,
      #sub = operations/sub,
      #negate = operations/negate
    ),
    #multiplicative = (
      = one,
      #mul = operations/mul
    ),
    #order = (
      #equality = (
        #eq = operations/eq,
        #ne = operations/ne
      ),
      #lt = operations/lt,
      #le = operations/le,
      #gt = operations/gt,
      #ge = operations/ge
    )
  ) in
  (= operations, = dictionary)
end
