@[package(library, name(std/numeric))]
begin
  param val (
    (
      /VType; /CType; /Thk; /Ret; /Unit; /String;
      /Int8; /Int16; /Int32; /Int;
      /UInt8; /UInt16; /UInt32; /UInt;
      /Float32; /Float64;
      /numeric;
      builtin
    ) : @(import("../builtin.zy")),
    (/Bool; /bool) : @(import("../data/package.type.zy"))
  ) that
  let make_integer = @(import("integer.zy")) that
  let make_float = @(import("float.zy")) that
  let int8 = numeric/int8 in
  let int16 = numeric/int16 in
  let int32 = numeric/int32 in
  let int = numeric/int in
  let uint8 = numeric/uint8 in
  let uint16 = numeric/uint16 in
  let uint32 = numeric/uint32 in
  let uint = numeric/uint in
  let float32 = numeric/float32 in
  let float64 = numeric/float64 in
  let (/operations = int8_module; /dictionary = int8_dictionary) =
    (
      builtin,
      bool,
      (
        #add = int8/add,
        #sub = int8/sub,
        #mul = int8/mul,
        #div = int8/div,
        #mod = int8/mod,
        #eq = int8/eq,
        #lt = int8/lt,
        #gt = int8/gt,
        #to_string = int8/to_string
      ),
      0,
      1
    ) |> make_integer Bool Int8 String
  in
  let (/operations = int16_module; /dictionary = int16_dictionary) =
    (
      builtin,
      bool,
      (
        #add = int16/add,
        #sub = int16/sub,
        #mul = int16/mul,
        #div = int16/div,
        #mod = int16/mod,
        #eq = int16/eq,
        #lt = int16/lt,
        #gt = int16/gt,
        #to_string = int16/to_string
      ),
      0,
      1
    ) |> make_integer Bool Int16 String
  in
  let (/operations = int32_module; /dictionary = int32_dictionary) =
    (
      builtin,
      bool,
      (
        #add = int32/add,
        #sub = int32/sub,
        #mul = int32/mul,
        #div = int32/div,
        #mod = int32/mod,
        #eq = int32/eq,
        #lt = int32/lt,
        #gt = int32/gt,
        #to_string = int32/to_string
      ),
      0,
      1
    ) |> make_integer Bool Int32 String
  in
  let (/operations = int_module; /dictionary = int_dictionary) =
    (
      builtin,
      bool,
      (
        #add = int/add,
        #sub = int/sub,
        #mul = int/mul,
        #div = int/div,
        #mod = int/mod,
        #eq = int/eq,
        #lt = int/lt,
        #gt = int/gt,
        #to_string = int/to_string
      ),
      0,
      1
    ) |> make_integer Bool Int String
  in
  let (/operations = uint8_module; /dictionary = uint8_dictionary) =
    (
      builtin,
      bool,
      (
        #add = uint8/add,
        #sub = uint8/sub,
        #mul = uint8/mul,
        #div = uint8/div,
        #mod = uint8/mod,
        #eq = uint8/eq,
        #lt = uint8/lt,
        #gt = uint8/gt,
        #to_string = uint8/to_string
      ),
      0,
      1
    ) |> make_integer Bool UInt8 String
  in
  let (/operations = uint16_module; /dictionary = uint16_dictionary) =
    (
      builtin,
      bool,
      (
        #add = uint16/add,
        #sub = uint16/sub,
        #mul = uint16/mul,
        #div = uint16/div,
        #mod = uint16/mod,
        #eq = uint16/eq,
        #lt = uint16/lt,
        #gt = uint16/gt,
        #to_string = uint16/to_string
      ),
      0,
      1
    ) |> make_integer Bool UInt16 String
  in
  let (/operations = uint32_module; /dictionary = uint32_dictionary) =
    (
      builtin,
      bool,
      (
        #add = uint32/add,
        #sub = uint32/sub,
        #mul = uint32/mul,
        #div = uint32/div,
        #mod = uint32/mod,
        #eq = uint32/eq,
        #lt = uint32/lt,
        #gt = uint32/gt,
        #to_string = uint32/to_string
      ),
      0,
      1
    ) |> make_integer Bool UInt32 String
  in
  let (/operations = uint_module; /dictionary = uint_dictionary) =
    (
      builtin,
      bool,
      (
        #add = uint/add,
        #sub = uint/sub,
        #mul = uint/mul,
        #div = uint/div,
        #mod = uint/mod,
        #eq = uint/eq,
        #lt = uint/lt,
        #gt = uint/gt,
        #to_string = uint/to_string
      ),
      0,
      1
    ) |> make_integer Bool UInt String
  in
  let (/operations = float32_module; /dictionary = float32_dictionary) =
    (
      builtin,
      bool,
      (
        #add = float32/add,
        #sub = float32/sub,
        #mul = float32/mul,
        #div = float32/div,
        #eq = float32/eq,
        #lt = float32/lt,
        #gt = float32/gt,
        #to_string = float32/to_string
      ),
      0.0,
      1.0
    ) |> make_float Bool Float32 String
  in
  let (/operations = float64_module; /dictionary = float64_dictionary) =
    (
      builtin,
      bool,
      (
        #add = float64/add,
        #sub = float64/sub,
        #mul = float64/mul,
        #div = float64/div,
        #eq = float64/eq,
        #lt = float64/lt,
        #gt = float64/gt,
        #to_string = float64/to_string
      ),
      0.0,
      1.0
    ) |> make_float Bool Float64 String
  in
  (
    #int8 = int8_module,
    #int16 = int16_module,
    #int32 = int32_module,
    #int = int_module,
    #uint8 = uint8_module,
    #uint16 = uint16_module,
    #uint32 = uint32_module,
    #uint = uint_module,
    #float32 = float32_module,
    #float64 = float64_module,
    #dictionaries = (
      = int8_dictionary,
      = int16_dictionary,
      = int32_dictionary,
      = int_dictionary,
      = uint8_dictionary,
      = uint16_dictionary,
      = uint32_dictionary,
      = uint_dictionary,
      = float32_dictionary,
      = float64_dictionary
    )
  )
end
-- end module Numeric
