begin
  param val (
    (
      /VType; /CType; /Thk; /Ret; /Unit; /String;
      /Int8; /Int16; /Int32; /Int64;
      /UInt8; /UInt16; /UInt32; /UInt64;
      /Float32; /Float64;
      /numeric;
      builtin
    ) : @(import("../builtin.zy")),
    (/Bool; /bool) : @(import("../data/package.type.zy"))
  ) that
  let make_integer = @(import("integer.zy")) that
  let make_float = @(import("float.zy")) that
  let int8 = numeric/int8 in
  let int16 = numeric/int16 in
  let int32 = numeric/int32 in
  let int64 = numeric/int64 in
  let uint8 = numeric/uint8 in
  let uint16 = numeric/uint16 in
  let uint32 = numeric/uint32 in
  let uint64 = numeric/uint64 in
  let float32 = numeric/float32 in
  let float64 = numeric/float64 in
  let (/operations = int8_module; /dictionary = int8_dictionary) =
    (builtin, bool, int8, 0, 1) |> make_integer Bool Int8 String
  in
  let (/operations = int16_module; /dictionary = int16_dictionary) =
    (builtin, bool, int16, 0, 1) |> make_integer Bool Int16 String
  in
  let (/operations = int32_module; /dictionary = int32_dictionary) =
    (builtin, bool, int32, 0, 1) |> make_integer Bool Int32 String
  in
  let (/operations = int64_module; /dictionary = int64_dictionary) =
    (builtin, bool, int64, 0, 1) |> make_integer Bool Int64 String
  in
  let (/operations = uint8_module; /dictionary = uint8_dictionary) =
    (builtin, bool, uint8, 0, 1) |> make_integer Bool UInt8 String
  in
  let (/operations = uint16_module; /dictionary = uint16_dictionary) =
    (builtin, bool, uint16, 0, 1) |> make_integer Bool UInt16 String
  in
  let (/operations = uint32_module; /dictionary = uint32_dictionary) =
    (builtin, bool, uint32, 0, 1) |> make_integer Bool UInt32 String
  in
  let (/operations = uint64_module; /dictionary = uint64_dictionary) =
    (builtin, bool, uint64, 0, 1) |> make_integer Bool UInt64 String
  in
  let (/operations = float32_module; /dictionary = float32_dictionary) =
    (builtin, bool, float32, 0.0, 1.0) |> make_float Bool Float32 String
  in
  let (/operations = float64_module; /dictionary = float64_dictionary) =
    (builtin, bool, float64, 0.0, 1.0) |> make_float Bool Float64 String
  in
  (
    #int8 = int8_module,
    #int16 = int16_module,
    #int32 = int32_module,
    #int64 = int64_module,
    #uint8 = uint8_module,
    #uint16 = uint16_module,
    #uint32 = uint32_module,
    #uint64 = uint64_module,
    #float32 = float32_module,
    #float64 = float64_module,
    #dictionaries = (
      = int8_dictionary,
      = int16_dictionary,
      = int32_dictionary,
      = int64_dictionary,
      = uint8_dictionary,
      = uint16_dictionary,
      = uint32_dictionary,
      = uint64_dictionary,
      = float32_dictionary,
      = float64_dictionary
    )
  )
end
-- end module Numeric
