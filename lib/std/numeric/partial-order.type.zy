begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let PartialEquality = @(import("partial-equality.type.zy")) in
  let PartialOrder (Bool : VType)
    (A : VType) =
      (equality :: PartialEquality Bool A)
    * (lt :: Thk (A -> A -> Ret Bool))
    * (le :: Thk (A -> A -> Ret Bool))
    * (gt :: Thk (A -> A -> Ret Bool))
    * (ge :: Thk (A -> A -> Ret Bool))
  in
  PartialOrder
end
