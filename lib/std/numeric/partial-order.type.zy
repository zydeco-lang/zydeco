begin
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let PartialEquality = @(import("partial-equality.type.zy")) in
  let PartialOrder (Bool : @(import("../builtin/intrinsic/vtype.zy")))
    (A : @(import("../builtin/intrinsic/vtype.zy"))) =
      (equality :: PartialEquality Bool A)
    * (lt :: Thk (A -> A -> Ret Bool))
    * (le :: Thk (A -> A -> Ret Bool))
    * (gt :: Thk (A -> A -> Ret Bool))
    * (ge :: Thk (A -> A -> Ret Bool))
  in
  PartialOrder
end
