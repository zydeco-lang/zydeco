begin
  let VType = @(intrinsic(vtype)) in
  let BoolModule = @(import("../data/bool.type.zy")) in
  let Numeric = @(import("numeric.type.zy")) in
  let FloatModule = @(import("float.type.zy")) in
  let PrimitiveFloatModule = @(import("primitive-float.type.zy")) in
  let Package
    (Bool : VType)
    (Scalar : VType)
    (String : VType)
  =
      (#operations :: FloatModule Bool Scalar String)
    * (#dictionary :: Numeric Bool Scalar)
  in
  val pi
    (Bool : VType)
    (Scalar : VType)
    (String : VType)
    (
      _ : @(import("../builtin/core.zy")),
      _ : BoolModule Bool,
      _ : PrimitiveFloatModule Scalar String,
      _ : Scalar,
      _ : Scalar
    )
  .
    Package Bool Scalar String
end
