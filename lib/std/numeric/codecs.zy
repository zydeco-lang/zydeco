-- Sequence codecs compose scalar memory leaves with immutable source bytes.
begin
  param val (/VType; /CType; /Thk; /Ret; /Int64; /Addr;
    /Int8; /Int16; /Int32; /UInt8; /UInt16; /UInt32; /UInt64; /Float32; /Float64;
    /numeric; builtin) : @(import("../builtin.zy")) that
  param val (/Bytes; /bytes) : (@(import("../text/bytes.type.zy"))) Addr that
  let int = numeric/int64 in
  let val scalar (A : VType) (width : Int64)
    (store : Thk (forall (R : CType) . Addr -> A -> Thk R -> R))
    (load : Thk (forall (R : CType) . Addr -> Thk (A -> R) -> R))
  =
    (
      #to_le_bytes = {
        fn (value : A) =>
          ! bytes/unsafe/build (Ret Bytes) width 1 {
            fn address _ yes =>
              ! store (Ret Bytes) address value yes
          } {
            fn _ =>
              @[partial]
              let 0 = 1 in
              ! bytes/empty
          } { fn value => ret value }
      },
      #from_le_bytes = {
        fn (R : CType) (value : Bytes) (no : Thk R) (yes : Thk (A -> R)) =>
          do count <- ! bytes/length value;
          ! int/eq R count width {
            ! bytes/unsafe/with_window R value { fn _ => ! no } {
              fn address _ => ! load R address yes
            }
          } no
      }
    )
  in
  (
    #int8 = scalar Int8 1 numeric/int8/store_le numeric/int8/load_le,
    #int16 = scalar Int16 2 numeric/int16/store_le numeric/int16/load_le,
    #int32 = scalar Int32 4 numeric/int32/store_le numeric/int32/load_le,
    #int64 = scalar Int64 8 numeric/int64/store_le numeric/int64/load_le,
    #uint8 = scalar UInt8 1 numeric/uint8/store_le numeric/uint8/load_le,
    #uint16 = scalar UInt16 2 numeric/uint16/store_le numeric/uint16/load_le,
    #uint32 = scalar UInt32 4 numeric/uint32/store_le numeric/uint32/load_le,
    #uint64 = scalar UInt64 8 numeric/uint64/store_le numeric/uint64/load_le,
    #float32 = scalar Float32 4 numeric/float32/store_le numeric/float32/load_le,
    #float64 = scalar Float64 8 numeric/float64/store_le numeric/float64/load_le
  )
end
