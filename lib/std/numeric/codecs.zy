-- Sequence codecs compose scalar memory leaves with immutable source bytes.

let (/BytesPackage) = @(import("../text/bytes.zy")) in
let (/numeric) = @(import("../primitive/package.zy")) in
begin
  param val (/Addr; /scalar = scalar_ops; builtin) : @(import("../builtin/memory.zy")) that
  param val (/Bytes; /bytes) : BytesPackage Addr that
  let int = numeric/int in
  -- The high storage byte must preserve the sign bit (Int), or leave bit 63 clear (UInt).
  let any_bytes = { fn (R : CType) (_ : Bytes) (_ : Thk R) (yes : Thk R) => ! yes } in
  let int_bytes = {
    fn (R : CType) (value : Bytes) (no : Thk R) (yes : Thk R) =>
      ! bytes/get R value 7 no {
        fn high =>
          ! numeric/uint8/lt R high 64 yes {
            ! numeric/uint8/gt R high 191 yes no
          }
      }
  } in
  let uint_bytes = {
    fn (R : CType) (value : Bytes) (no : Thk R) (yes : Thk R) =>
      ! bytes/get R value 7 no { fn high => ! numeric/uint8/lt R high 128 yes no }
  } in
  let val scalar (A : VType) (width : Int)
    (store : Thk (forall (R : CType) . Addr -> A -> Thk R -> R))
    (load : Thk (forall (R : CType) . Addr -> Thk (A -> R) -> R))
    (valid : Thk (forall (R : CType) . Bytes -> Thk R -> Thk R -> R))
  =
    (
      #to_le_bytes = {
        fn (value : A) =>
          ! bytes/unsafe/build (Ret Bytes) width 1 {
            fn address _ yes =>
              ! store (Ret Bytes) address value yes
          } {
            fn _ =>
              @[partial]
              let 0 = 1 in
              ! bytes/empty
          } { fn value => ret value }
      },
      #from_le_bytes = {
        fn (R : CType) (value : Bytes) (no : Thk R) (yes : Thk (A -> R)) =>
          do count <- ! bytes/length value;
          ! int/eq R count width {
            ! valid R value no {
              ! bytes/unsafe/with_window R value { fn _ => ! no } {
                fn address _ => ! load R address yes
              }
            }
          } no
      }
    )
  in
  (
    #int8 = scalar Int8 1 scalar_ops/int8/store_le scalar_ops/int8/load_le any_bytes,
    #int16 = scalar Int16 2 scalar_ops/int16/store_le scalar_ops/int16/load_le any_bytes,
    #int32 = scalar Int32 4 scalar_ops/int32/store_le scalar_ops/int32/load_le any_bytes,
    #int64 = scalar Int64 8 scalar_ops/int64/store_le scalar_ops/int64/load_le any_bytes,
    #int = scalar Int 8 scalar_ops/int/store_le scalar_ops/int/load_le int_bytes,
    #uint8 = scalar UInt8 1 scalar_ops/uint8/store_le scalar_ops/uint8/load_le any_bytes,
    #uint16 = scalar UInt16 2 scalar_ops/uint16/store_le scalar_ops/uint16/load_le any_bytes,
    #uint32 = scalar UInt32 4 scalar_ops/uint32/store_le scalar_ops/uint32/load_le any_bytes,
    #uint64 = scalar UInt64 8 scalar_ops/uint64/store_le scalar_ops/uint64/load_le any_bytes,
    #uint = scalar UInt 8 scalar_ops/uint/store_le scalar_ops/uint/load_le uint_bytes,
    #float32 = scalar Float32 4 scalar_ops/float32/store_le scalar_ops/float32/load_le any_bytes,
    #float64 = scalar Float64 8 scalar_ops/float64/store_le scalar_ops/float64/load_le any_bytes
  )
end
