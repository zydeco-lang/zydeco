begin
  let BoolModule = @[import("../data/bool.type.zy")] _ in
  let NumericInstance = @[import("numeric-instance.type.zy")] _ in
  let IntegerModule = @[import("integer.type.zy")] _ in
  let PrimitiveIntegerModule = @[import("primitive-integer.type.zy")] _ in
  let Unit = @[import("../builtin/intrinsic/unit.zy")] _ in
  let Package
    (Bool : @[import("../builtin/intrinsic/vtype.zy")] _)
    (Scalar : @[import("../builtin/intrinsic/vtype.zy")] _)
    (String : @[import("../builtin/intrinsic/vtype.zy")] _) =
      (operations :: IntegerModule Bool Scalar String)
    * (instance :: NumericInstance Bool Scalar)
    * Unit
  in
  pi (_ : @[import("../builtin/core.zy")] _) .
    forall
      (Bool : @[import("../builtin/intrinsic/vtype.zy")] _)
      (Scalar : @[import("../builtin/intrinsic/vtype.zy")] _)
      (String : @[import("../builtin/intrinsic/vtype.zy")] _)
    .
         BoolModule Bool
      -> PrimitiveIntegerModule Scalar String
      -> Scalar
      -> Scalar
      -> Package Bool Scalar String
end
