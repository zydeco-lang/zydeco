begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let BoolModule = @(import("../data/bool.type.zy")) in
  let NumericInstance = @(import("numeric-instance.type.zy")) in
  let IntegerModule = @(import("integer.type.zy")) in
  let PrimitiveIntegerModule = @(import("primitive-integer.type.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let Package
    (Bool : VType)
    (Scalar : VType)
    (String : VType) =
      (operations :: IntegerModule Bool Scalar String)
    * (instance :: NumericInstance Bool Scalar)
    * Unit
  in
  pi (_ : @(import("../builtin/core.zy"))) .
    forall
      (Bool : VType)
      (Scalar : VType)
      (String : VType)
    .
         BoolModule Bool
      -> PrimitiveIntegerModule Scalar String
      -> Scalar
      -> Scalar
      -> Package Bool Scalar String
end
