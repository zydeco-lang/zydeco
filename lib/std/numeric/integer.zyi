begin
  let VType = @(intrinsic(vtype)) in
  let BoolModule = @(import("../data/bool.type.zy")) in
  let Numeric = @(import("numeric.type.zy")) in
  let IntegerModule = @(import("integer.type.zy")) in
  let PrimitiveIntegerModule = @(import("primitive-integer.type.zy")) in
  let Package
    (Bool : VType)
    (Scalar : VType)
    (String : VType)
  =
      (#operations :: IntegerModule Bool Scalar String)
    * (#dictionary :: Numeric Bool Scalar)
  in
  val pi
    (Bool : VType)
    (Scalar : VType)
    (String : VType)
    (
      _ : @(import("../builtin/core.zy")),
      _ : BoolModule Bool,
      _ : PrimitiveIntegerModule Scalar String,
      _ : Scalar,
      _ : Scalar
    )
  .
    Package Bool Scalar String
end
