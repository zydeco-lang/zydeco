begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let Numeric = @(import("numeric.type.zy")) in
  let NumericInstance (Bool : VType)
    (Representation : VType) =
    exists (Scalar = ScalarType as Representation : VType) .
        (dictionary :: Numeric Bool ScalarType)
      * Unit
  in
  NumericInstance
end
