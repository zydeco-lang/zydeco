begin
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let Additive = @(import("additive.type.zy")) in
  let Multiplicative = @(import("multiplicative.type.zy")) in
  let PartialOrder = @(import("partial-order.type.zy")) in
  let Numeric (Bool : @(import("../builtin/intrinsic/vtype.zy")))
    (A : @(import("../builtin/intrinsic/vtype.zy"))) =
      (additive :: Additive A)
    * (multiplicative :: Multiplicative A)
    * (order :: PartialOrder Bool A)
    * Unit
  in
  Numeric
end
