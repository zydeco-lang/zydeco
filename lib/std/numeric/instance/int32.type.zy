begin
  let VType = @(intrinsic(vtype)) in
  let Unit = @(intrinsic(unit)) in
  let Numeric = @(import("../numeric.type.zy")) in
  let Int32 = @(intrinsic(i32)) in
  let Int32Instance (Bool : VType) =
    exists (#Int32 = ScalarType as Int32 : VType) .
      (#dictionary :: Numeric Bool ScalarType) * Unit
  in
  Int32Instance
end
