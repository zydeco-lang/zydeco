begin
  let Thk = @[import("../builtin/intrinsic/thk.zy")] _ in
  let Ret = @[import("../builtin/intrinsic/ret.zy")] _ in
  let Unit = @[import("../builtin/intrinsic/unit.zy")] _ in
  let PrimitiveFloatModule
    (Floating : @[import("../builtin/intrinsic/vtype.zy")] _)
    (String : @[import("../builtin/intrinsic/vtype.zy")] _) =
      (add :: Thk (Floating -> Floating -> Ret Floating))
    * (sub :: Thk (Floating -> Floating -> Ret Floating))
    * (mul :: Thk (Floating -> Floating -> Ret Floating))
    * (div :: Thk (Floating -> Floating -> Ret Floating))
    * (
        eq :: Thk (
          forall (R : @[import("../builtin/intrinsic/ctype.zy")] _) .
            Floating -> Floating -> Thk R -> Thk R -> R
        )
      )
    * (
        lt :: Thk (
          forall (R : @[import("../builtin/intrinsic/ctype.zy")] _) .
            Floating -> Floating -> Thk R -> Thk R -> R
        )
      )
    * (
        gt :: Thk (
          forall (R : @[import("../builtin/intrinsic/ctype.zy")] _) .
            Floating -> Floating -> Thk R -> Thk R -> R
        )
      )
    * (to_string :: Thk (Floating -> Ret String))
  in
  PrimitiveFloatModule
end
