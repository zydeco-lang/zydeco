begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let CType = @(import("../builtin/intrinsic/ctype.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let PrimitiveFloatModule (Floating : VType)
    (String : VType) =
      (add :: Thk (Floating -> Floating -> Ret Floating))
    * (sub :: Thk (Floating -> Floating -> Ret Floating))
    * (mul :: Thk (Floating -> Floating -> Ret Floating))
    * (div :: Thk (Floating -> Floating -> Ret Floating))
    * (
        eq :: Thk (
          forall (R : CType) .
            Floating -> Floating -> Thk R -> Thk R -> R
        )
      )
    * (
        lt :: Thk (
          forall (R : CType) .
            Floating -> Floating -> Thk R -> Thk R -> R
        )
      )
    * (
        gt :: Thk (
          forall (R : CType) .
            Floating -> Floating -> Thk R -> Thk R -> R
        )
      )
    * (to_string :: Thk (Floating -> Ret String))
  in
  PrimitiveFloatModule
end
