-- module List
{
param (
  (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
  @[import("builtin.zy")] _
) in
ret begin
  def List (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * List A
    end
  that
  def ! nil (A : VType) : Ret (List A) =
    ret +Nil()
  that
  def ! cons (A : VType) (head : A) (tail : List A) : Ret (List A) =
    ret +Cons(head, tail)
  that
  def ! case
    (A : VType)
    (B : CType)
    (list : List A)
    (when_nil : Thk B)
    (when_cons : Thk (A -> List A -> B))
    : B =
    match list
    | +Nil(_) -> ! when_nil
    | +Cons(head, tail) -> ! when_cons head tail
    end
  that
  def fix fold
    (A : VType)
    (B : CType)
    (list : List A)
    (when_nil : Thk B)
    (when_cons : Thk (A -> Thk B -> B))
    : B =
    match list
    | +Nil(_) -> ! when_nil
    | +Cons(head, tail) ->
      ! when_cons head { ! fold A B tail when_nil when_cons }
    end
  that
  let Interface =
    exists (
      List = AbstractList :
      (VType) -> (VType)
    ) .
      (nil :: Thk (
        forall (A : VType) .
          Ret (AbstractList A)
      )) *
      (cons :: Thk (
        forall (A : VType) .
          A -> AbstractList A -> Ret (AbstractList A)
      )) *
      (case :: Thk (
        forall (A : VType) .
        forall (B : CType) .
          AbstractList A ->
          Thk B ->
          Thk (A -> AbstractList A -> B) ->
          B
      )) *
      (fold :: Thk (
        forall (A : VType) .
        forall (B : CType) .
          AbstractList A ->
          Thk B ->
          Thk (A -> Thk B -> B) ->
          B
      ))
  that

  (
    List = List,
    nil = nil,
    cons = cons,
    case = case,
    fold = fold,
  ) : Interface
end
}
-- end module List
