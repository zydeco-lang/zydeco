-- module Monad
{
param (
  (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
  @[import("builtin.zy")] _
) in
ret begin

  --| interface for monads and their algebras
  let Monad (M : (VType) -> (CType)) =
    codata
    | .return :
      forall (A : VType) .
        A -> M A
    | .bind :
      forall (A : VType) .
      forall (B : VType) .
        Thk (M A) ->
        Thk (A -> M B) ->
        M B
    end
  that
  let Algebra (M : (VType) -> (CType)) (R : CType) =
    forall (A : VType) .
      Thk (M A) ->
      Thk (A -> R) ->
      R
  that

  let MonadicBasis =
    exists (
      Monad = ExportedMonad as Monad :
      (
        ((VType) -> (CType)) ->
        (CType)
      )
    ) .
    exists (
      Algebra = ExportedAlgebra as Algebra :
      (
        ((VType) -> (CType)) ->
        (CType) ->
        (CType)
      )
    ) .
      Unit
  that

  ((Monad = Monad, Algebra = Algebra, ()) : MonadicBasis)
end
}
-- end module Monad
