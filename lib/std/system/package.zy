begin
  param (
    (
      /core;
      /representations;
      /numeric;
      /text;
      /system = (/Reader; /Writer; /OS; /io; /fs; /stdio; /args; /random; /process);
      builtin
    )
  ) in
  let (/VType; /CType; /Thk; /Ret; /Unit) = core in
  let (= Int64, int64) = numeric/int64 in
  let (/String) = representations/string in
  let (/Bytes) = representations/bytes in
  let (/bytes) = text in
  param (/Bool; /Option; /Result; /List; /bool; /option; /result; /list) in
  begin
    def IoErrorKind =
      data
      | +NotFound : Unit
      | +PermissionDenied : Unit
      | +AlreadyExists : Unit
      | +InvalidInput : Unit
      | +InvalidData : Unit
      | +BrokenPipe : Unit
      | +Closed : Unit
      | +Other : Unit
      end
    that
    def not_found : IoErrorKind = +NotFound() that
    def permission_denied : IoErrorKind = +PermissionDenied() that
    def already_exists : IoErrorKind = +AlreadyExists() that
    def invalid_input : IoErrorKind = +InvalidInput() that
    def invalid_data : IoErrorKind = +InvalidData() that
    def broken_pipe : IoErrorKind = +BrokenPipe() that
    def closed : IoErrorKind = +Closed() that
    def other : IoErrorKind = +Other() that
    def ! from_code (code : Int64) : Ret IoErrorKind = ! (int64/eq)
      (Ret IoErrorKind)
      code
      0
      { ret not_found }
      {
        ! (int64/eq)
          (Ret IoErrorKind)
          code
          1
          { ret permission_denied }
          {
            ! (int64/eq)
              (Ret IoErrorKind)
              code
              2
              { ret already_exists }
              {
                ! (int64/eq)
                  (Ret IoErrorKind)
                  code
                  3
                  { ret invalid_input }
                  {
                    ! (int64/eq)
                      (Ret IoErrorKind)
                      code
                      4
                      { ret invalid_data }
                      {
                        ! (int64/eq)
                          (Ret IoErrorKind)
                          code
                          5
                          { ret broken_pipe }
                          {
                            ! (int64/eq)
                              (Ret IoErrorKind)
                              code
                              6
                              { ret closed }
                              { ret other }
                          }
                      }
                  }
              }
          }
      } that
    def ! kind_code (kind : IoErrorKind) : Ret Int64 =
      match kind
      | +NotFound(_) => ret 0
      | +PermissionDenied(_) => ret 1
      | +AlreadyExists(_) => ret 2
      | +InvalidInput(_) => ret 3
      | +InvalidData(_) => ret 4
      | +BrokenPipe(_) => ret 5
      | +Closed(_) => ret 6
      | +Other(_) => ret 7
      end
    that
    def ! kind_eq_branch (R : CType)
      (left : IoErrorKind)
      (right : IoErrorKind)
      (when_equal : Thk R)
      (when_different : Thk R)
    : R =
        do left_code <- ! kind_code left;
        do right_code <- ! kind_code right;
        ! (int64/eq) R left_code right_code when_equal when_different
    that
    def IoError =
      data
      | +IoError : (#kind :: IoErrorKind) * (#message :: String)
      end
    that
    def ! error (kind : IoErrorKind) (message : String) : Ret IoError =
      ret +IoError(= kind, = message)
    that
    def ! error_kind (error : IoError) : Ret IoErrorKind =
      match error
      | +IoError(/kind) => ret kind
      end
    that
    def ! error_message (error : IoError) : Ret String =
      match error
      | +IoError(/message) => ret message
      end
    that
    def Path =
      data
      | +Path : String
      end
    that
    def ! path (string : String) : Ret Path = ret +Path(string) that
    def ! path_string (path : Path) : Ret String =
      match path
      | +Path(string) => ret string
      end
    that
    let ! make_io_error (code : Int64) (message : String) : Ret IoError =
      do kind <- ! from_code code;
      ! error kind message
    in
    let ! io_kind_eq (left : IoErrorKind) (right : IoErrorKind) : Ret Bool =
      ! kind_eq_branch
        (Ret Bool)
        left
        right
        { ret (bool/true) }
        { ret (bool/false) }
    in
    let ! continue_io_ok (A : VType)
      (continuation : Thk (Result A IoError -> OS))
      (value : A)
    : OS =
        do result <- ! (result/ok) A IoError value;
        ! continuation result
    in
    let ! continue_io_error (A : VType)
      (continuation : Thk (Result A IoError -> OS))
      (error : IoError)
    : OS =
        do result <- ! (result/err) A IoError error;
        ! continuation result
    in
    let ! continue_host_error (A : VType)
      (continuation : Thk (Result A IoError -> OS))
      (code : Int64)
      (message : String)
    : OS =
        do error <- ! make_io_error code message;
        ! continue_io_error A continuation error
    in
    let ! io_read (reader : Reader)
      (count : Int64)
      (continuation : Thk (Result Bytes IoError -> OS))
    : OS = ! (io/read)
        reader
        count
        { fn code message => ! continue_host_error Bytes continuation code message }
        { fn chunk => ! continue_io_ok Bytes continuation chunk }
    in
    let ! io_read_line (reader : Reader)
      (continuation : Thk (Result (Option Bytes) IoError -> OS))
    : OS = ! (io/read_line)
        reader
        {
          fn code message =>
            ! continue_host_error (Option Bytes) continuation code message
        }
        {
          do absent <- ! (option/none) Bytes;
          ! continue_io_ok (Option Bytes) continuation absent
        }
        {
          fn chunk =>
            do present <- ! (option/some) Bytes chunk;
            ! continue_io_ok (Option Bytes) continuation present
        }
    in
    let ! io_read_all (reader : Reader)
      (continuation : Thk (Result Bytes IoError -> OS))
    : OS = ! (io/read_all)
        reader
        { fn code message => ! continue_host_error Bytes continuation code message }
        { fn chunk => ! continue_io_ok Bytes continuation chunk }
    in
    let ! io_write_all (writer : Writer)
      (chunk : Bytes)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS = ! (io/write_all)
        writer
        chunk
        { fn code message => ! continue_host_error Unit continuation code message }
        { ! continue_io_ok Unit continuation () }
    in
    let ! io_flush (writer : Writer)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS = ! (io/flush)
        writer
        { fn code message => ! continue_host_error Unit continuation code message }
        { ! continue_io_ok Unit continuation () }
    in
    let ! io_close_reader (reader : Reader)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS = ! (io/close_reader)
        reader
        { fn code message => ! continue_host_error Unit continuation code message }
        { ! continue_io_ok Unit continuation () }
    in
    let ! io_close_writer (writer : Writer)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS = ! (io/close_writer)
        writer
        { fn code message => ! continue_host_error Unit continuation code message }
        { ! continue_io_ok Unit continuation () }
    in
    let ! fs_open_reader (path : Path)
      (continuation : Thk (Result Reader IoError -> OS))
    : OS =
        do string <- ! path_string path;
        ! (fs/open_reader)
          string
          { fn code message => ! continue_host_error Reader continuation code message }
          { fn reader => ! continue_io_ok Reader continuation reader }
    in
    let ! fs_create_writer (path : Path)
      (continuation : Thk (Result Writer IoError -> OS))
    : OS =
        do string <- ! path_string path;
        ! (fs/create_writer)
          string
          { fn code message => ! continue_host_error Writer continuation code message }
          { fn writer => ! continue_io_ok Writer continuation writer }
    in
    let ! fs_append_writer (path : Path)
      (continuation : Thk (Result Writer IoError -> OS))
    : OS =
        do string <- ! path_string path;
        ! (fs/append_writer)
          string
          { fn code message => ! continue_host_error Writer continuation code message }
          { fn writer => ! continue_io_ok Writer continuation writer }
    in
    let ! finish_reader (A : VType)
      (reader : Reader)
      (operation : Result A IoError)
      (continuation : Thk (Result A IoError -> OS))
    : OS = ! (result/fold)
        A
        IoError
        OS
        operation
        {
          fn value =>
            ! io_close_reader reader {
              fn close_result =>
                ! (result/fold)
                  Unit
                  IoError
                  OS
                  close_result
                  { fn _ => ! continue_io_ok A continuation value }
                  { fn error => ! continue_io_error A continuation error }
            }
        }
        {
          fn operation_error =>
            ! io_close_reader reader {
              fn _ => ! continue_io_error A continuation operation_error
            }
        }
    in
    let ! finish_writer (writer : Writer)
      (operation : Result Unit IoError)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS = ! (result/fold)
        Unit
        IoError
        OS
        operation
        {
          fn _ => ! io_close_writer writer continuation
        }
        {
          fn operation_error =>
            ! io_close_writer writer {
              fn _ => ! continue_io_error Unit continuation operation_error
            }
        }
    in
    let ! fs_read_bytes (path : Path)
      (continuation : Thk (Result Bytes IoError -> OS))
    : OS = ! fs_open_reader path {
        fn opened =>
          ! (result/fold)
            Reader
            IoError
            OS
            opened
            {
              fn reader =>
                ! io_read_all reader {
                  fn operation => ! finish_reader Bytes reader operation continuation
                }
            }
            { fn error => ! continue_io_error Bytes continuation error }
      }
    in
    let ! fs_read_text (path : Path)
      (continuation : Thk (Result String IoError -> OS))
    : OS = ! fs_read_bytes path {
        fn read_result =>
          ! (result/fold)
            Bytes
            IoError
            OS
            read_result
            {
              fn contents =>
                ! (bytes/to_string)
                  OS
                  contents
                  {
                    do error <- ! error
                      invalid_data
                      "file is not valid UTF-8";
                    ! continue_io_error String continuation error
                  }
                  { fn string => ! continue_io_ok String continuation string }
            }
            { fn error => ! continue_io_error String continuation error }
      }
    in
    let ! fs_write_bytes (path : Path)
      (chunk : Bytes)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS = ! fs_create_writer path {
        fn opened =>
          ! (result/fold)
            Writer
            IoError
            OS
            opened
            {
              fn writer =>
                ! io_write_all writer chunk {
                  fn operation => ! finish_writer writer operation continuation
                }
            }
            { fn error => ! continue_io_error Unit continuation error }
      }
    in
    let ! fs_write_text (path : Path)
      (string : String)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS =
        do encoded <- ! (bytes/from_string) string;
        ! fs_write_bytes path encoded continuation
    in
    let ! write_bytes_and_flush (writer : Writer)
      (chunk : Bytes)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS = ! io_write_all writer chunk {
        fn written =>
          ! (result/fold)
            Unit
            IoError
            OS
            written
            { fn _ => ! io_flush writer continuation }
            { fn error => ! continue_io_error Unit continuation error }
      }
    in
    let ! stdio_write_to (writer : Writer)
      (string : String)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS =
        do encoded <- ! (bytes/from_string) string;
        ! write_bytes_and_flush writer encoded continuation
    in
    let ! stdio_write_line_to (writer : Writer)
      (string : String)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS =
        do encoded <- ! (bytes/from_string) string;
        do newline <- ! (bytes/from_string) "\n";
        do line <- ! (bytes/append) encoded newline;
        ! write_bytes_and_flush writer line continuation
    in
    let ! stdio_read_line (continuation : Thk (Result (Option String) IoError -> OS)) :
      OS =
        do reader <- ! (stdio/stdin);
        ! io_read_line reader {
          fn read_result =>
            ! (result/fold)
              (Option Bytes)
              IoError
              OS
              read_result
              {
                fn line =>
                  ! (option/fold)
                    Bytes
                    OS
                    line
                    {
                      do absent <- ! (option/none) String;
                      ! continue_io_ok (Option String) continuation absent
                    }
                    {
                      fn line_bytes =>
                        ! (bytes/to_string)
                          OS
                          line_bytes
                          {
                            do error <- ! error
                              invalid_data
                              "standard input is not valid UTF-8";
                            ! continue_io_error (Option String) continuation error
                          }
                          {
                            fn string =>
                              do present <- ! (option/some) String string;
                              ! continue_io_ok (Option String) continuation present
                          }
                    }
              }
              { fn error => ! continue_io_error (Option String) continuation error }
        }
    in
    let ! stdio_write (string : String)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS =
        do writer <- ! (stdio/stdout);
        ! stdio_write_to writer string continuation
    in
    let ! stdio_write_line (string : String)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS =
        do writer <- ! (stdio/stdout);
        ! stdio_write_line_to writer string continuation
    in
    let ! stdio_write_error (string : String)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS =
        do writer <- ! (stdio/stderr);
        ! stdio_write_to writer string continuation
    in
    let ! stdio_write_error_line (string : String)
      (continuation : Thk (Result Unit IoError -> OS))
    : OS =
        do writer <- ! (stdio/stderr);
        ! stdio_write_line_to writer string continuation
    in
    let ! arg_list (continuation : Thk (List String -> OS)) : OS =
      do arguments <- ! (args/fold)
        (Ret (List String))
        { ! (list/nil) String }
        {
          fn argument remaining =>
            do tail <- ! remaining;
            ! (list/cons) String argument tail
        };
      ! continuation arguments
    in
    let halt : Thk OS = { ! (process/exit) 0 } in
    let ! panic (message : String) : OS =
      ! stdio_write_error_line message { fn _ => ! (process/exit) 1 }
    in
    pack
        (= Path : VType) is Path
        (= IoErrorKind : VType) is IoErrorKind
        (= IoError : VType) is IoError
    where
      #io = (
        = not_found,
        = permission_denied,
        = already_exists,
        = invalid_input,
        = invalid_data,
        = broken_pipe,
        = closed,
        = other,
        #kind_eq = io_kind_eq,
        = error_kind,
        = error_message,
        #read = io_read,
        #read_line = io_read_line,
        #read_all = io_read_all,
        #write_all = io_write_all,
        #flush = io_flush,
        #close_reader = io_close_reader,
        #close_writer = io_close_writer
      ),
      #fs = (
        = path,
        = path_string,
        #open_reader = fs_open_reader,
        #create_writer = fs_create_writer,
        #append_writer = fs_append_writer,
        #read_bytes = fs_read_bytes,
        #read_text = fs_read_text,
        #write_bytes = fs_write_bytes,
        #write_text = fs_write_text
      ),
      #stdio = (
        #stdin = stdio/stdin,
        #stdout = stdio/stdout,
        #stderr = stdio/stderr,
        #read_line = stdio_read_line,
        #write = stdio_write,
        #write_line = stdio_write_line,
        #write_error = stdio_write_error,
        #write_error_line = stdio_write_error_line
      ),
      #process = (
        = arg_list,
        #random_int = random/generate,
        = halt,
        = panic,
        #exit = process/exit
      ),
      ()
    end
  end
end
