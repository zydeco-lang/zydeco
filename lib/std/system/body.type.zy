begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let Unit = @(intrinsic(unit)) in
  let Int64 = @(intrinsic(i64)) in
  let String = @(intrinsic(string)) in
  let Bytes = @(intrinsic(bytes)) in

  let IoModule (Bool : VType)
    (
      Option : VType -> (
        VType
      )
    )
    (
      Result : VType -> (
        VType
      ) -> VType
    )
    (Reader : VType)
    (Writer : VType)
    (IoErrorKind : VType)
    (IoError : VType)
    (OS : CType) =
      (#not_found :: IoErrorKind)
    * (#permission_denied :: IoErrorKind)
    * (#already_exists :: IoErrorKind)
    * (#invalid_input :: IoErrorKind)
    * (#invalid_data :: IoErrorKind)
    * (#broken_pipe :: IoErrorKind)
    * (#closed :: IoErrorKind)
    * (#other :: IoErrorKind)
    * (
        #kind_eq :: Thk (
          IoErrorKind -> IoErrorKind -> Ret Bool
        )
      )
    * (#error_kind :: Thk (IoError -> Ret IoErrorKind))
    * (#error_message :: Thk (IoError -> Ret String))
    * (
        #read :: Thk (
             Reader -> Int64
          -> Thk (Result Bytes IoError -> OS)
          -> OS
        )
      )
    * (
        #read_line :: Thk (
             Reader
          -> Thk (Result (Option Bytes) IoError -> OS)
          -> OS
        )
      )
    * (
        #read_all :: Thk (
             Reader
          -> Thk (Result Bytes IoError -> OS)
          -> OS
        )
      )
    * (
        #write_all :: Thk (
             Writer -> Bytes
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        #flush :: Thk (
             Writer
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        #close_reader :: Thk (
             Reader
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        #close_writer :: Thk (
             Writer
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
  in

  let FsModule
    (
      Result : VType -> (
        VType
      ) -> VType
    )
    (Reader : VType)
    (Writer : VType)
    (Path : VType)
    (IoError : VType)
    (OS : CType) =
      (#path :: Thk (String -> Ret Path))
    * (#path_string :: Thk (Path -> Ret String))
    * (
        #open_reader :: Thk (
             Path
          -> Thk (Result Reader IoError -> OS)
          -> OS
        )
      )
    * (
        #create_writer :: Thk (
             Path
          -> Thk (Result Writer IoError -> OS)
          -> OS
        )
      )
    * (
        #append_writer :: Thk (
             Path
          -> Thk (Result Writer IoError -> OS)
          -> OS
        )
      )
    * (
        #read_bytes :: Thk (
             Path
          -> Thk (Result Bytes IoError -> OS)
          -> OS
        )
      )
    * (
        #read_text :: Thk (
             Path
          -> Thk (Result String IoError -> OS)
          -> OS
        )
      )
    * (
        #write_bytes :: Thk (
             Path -> Bytes
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        #write_text :: Thk (
             Path -> String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
  in

  let StdioModule
    (
      Option : VType -> (
        VType
      )
    )
    (
      Result : VType -> (
        VType
      ) -> VType
    )
    (Reader : VType)
    (Writer : VType)
    (IoError : VType)
    (OS : CType) =
      (#stdin :: Thk (Ret Reader))
    * (#stdout :: Thk (Ret Writer))
    * (#stderr :: Thk (Ret Writer))
    * (
        #read_line :: Thk (
             Thk (Result (Option String) IoError -> OS)
          -> OS
        )
      )
    * (
        #write :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        #write_line :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        #write_error :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        #write_error_line :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
  in

  let ProcessModule
    (
      List : VType -> (
        VType
      )
    )
    (OS : CType) =
      (#arg_list :: Thk (Thk (List String -> OS) -> OS))
    * (#random_int :: Thk (Thk (Int64 -> OS) -> OS))
    * (#halt :: Thk OS)
    * (#panic :: Thk (String -> OS))
    * (#exit :: Thk (Int64 -> OS))
  in

  param Bool : VType in
  param Option : VType -> VType in
  param Result : VType -> VType -> VType in
  param List : VType -> VType in
  param Reader : VType in
  param Writer : VType in
  param Path : VType in
  param IoErrorKind : VType in
  param IoError : VType in
  param OS : CType in
    (
      #io :: IoModule
        Bool Option Result Reader Writer IoErrorKind IoError OS
    )
  * (
      #fs :: FsModule Result Reader Writer Path IoError OS
    )
  * (
      #stdio :: StdioModule Option Result Reader Writer IoError OS
    )
  * (#process :: ProcessModule List OS)
  * Unit
end
