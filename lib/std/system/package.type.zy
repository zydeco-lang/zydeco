begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let SystemBody = @(import("body.type.zy")) in
  param Bool : VType in
  param Option : VType -> VType in
  param Result : VType -> VType -> VType in
  param List : VType -> VType in
  param Reader : VType in
  param Writer : VType in
  param OS : CType in
  exists (#Path = PathType : VType) .
    exists (#IoErrorKind = IoErrorKindType : VType) .
      exists (#IoError = IoErrorType : VType) .
        SystemBody
          Bool
          Option
          Result
          List
          Reader
          Writer
          PathType
          IoErrorKindType
          IoErrorType
          OS
end
