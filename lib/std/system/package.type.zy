begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let SystemBody = @(import("body.type.zy")) in
  let SystemPackage (Bool : VType)
    (
      Option : VType -> (
        VType
      )
    )
    (
      Result : VType -> (
        VType
      ) -> VType
    )
    (
      List : VType -> (
        VType
      )
    )
    (Reader : VType)
    (Writer : VType)
    (OS : CType) =
    exists (#Path = PathType : VType) .
      exists (#IoErrorKind = IoErrorKindType : VType) .
        exists (#IoError = IoErrorType : VType) .
          SystemBody
            Bool
            Option
            Result
            List
            Reader
            Writer
            PathType
            IoErrorKindType
            IoErrorType
            OS
  in
  SystemPackage
end
