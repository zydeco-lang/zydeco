begin
  let IoModule = @(import("io.type.zy")) in
  let FsModule = @(import("fs.type.zy")) in
  let StdioModule = @(import("stdio.type.zy")) in
  let ProcessModule = @(import("process.type.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let Int64 = @(import("../builtin/intrinsic/i64.zy")) in
  let String = @(import("../builtin/intrinsic/string.zy")) in
  let Bytes = @(import("../builtin/intrinsic/bytes.zy")) in
  let Package (Bool : @(import("../builtin/intrinsic/vtype.zy")))
    (
      Option : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      )
    )
    (
      Result :
      (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      ) -> (@(import("../builtin/intrinsic/vtype.zy")))
    )
    (
      List : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      )
    )
    (Reader : @(import("../builtin/intrinsic/vtype.zy")))
    (Writer : @(import("../builtin/intrinsic/vtype.zy")))
    (OS : @(import("../builtin/intrinsic/ctype.zy"))) =
    exists (Path = PathType : @(import("../builtin/intrinsic/vtype.zy"))) .
      exists (IoErrorKind = IoErrorKindType : @(import("../builtin/intrinsic/vtype.zy"))) .
        exists (IoError = IoErrorType : @(import("../builtin/intrinsic/vtype.zy"))) .
            (
              io :: IoModule
                Bool Option Result Int64 String Bytes Reader Writer
                IoErrorKindType IoErrorType OS
            )
          * (
              fs :: FsModule
                Result String Bytes Reader Writer PathType IoErrorType OS
            )
          * (
              stdio :: StdioModule
                Option Result String Reader Writer IoErrorType OS
            )
          * (process :: ProcessModule List Int64 String OS)
          * Unit
  in
  Package
end
