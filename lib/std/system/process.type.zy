begin
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let ProcessModule
    (
      List : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      )
    )
    (Int64 : @(import("../builtin/intrinsic/vtype.zy")))
    (String : @(import("../builtin/intrinsic/vtype.zy")))
    (OS : @(import("../builtin/intrinsic/ctype.zy"))) =
      (arg_list :: Thk (Thk (List String -> OS) -> OS))
    * (random_int :: Thk (Thk (Int64 -> OS) -> OS))
    * (halt :: Thk OS)
    * (panic :: Thk (String -> OS))
    * (exit :: Thk (Int64 -> OS))
  in
  ProcessModule
end
