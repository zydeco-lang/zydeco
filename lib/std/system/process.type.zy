begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let CType = @(import("../builtin/intrinsic/ctype.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let ProcessModule
    (
      List : VType -> (
        VType
      )
    )
    (Int64 : VType)
    (String : VType)
    (OS : CType) =
      (arg_list :: Thk (Thk (List String -> OS) -> OS))
    * (random_int :: Thk (Thk (Int64 -> OS) -> OS))
    * (halt :: Thk OS)
    * (panic :: Thk (String -> OS))
    * (exit :: Thk (Int64 -> OS))
  in
  ProcessModule
end
