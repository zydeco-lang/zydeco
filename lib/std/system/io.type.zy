begin
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let IoModule (Bool : @(import("../builtin/intrinsic/vtype.zy")))
    (
      Option : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      )
    )
    (
      Result : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      ) -> (@(import("../builtin/intrinsic/vtype.zy")))
    )
    (Int64 : @(import("../builtin/intrinsic/vtype.zy")))
    (String : @(import("../builtin/intrinsic/vtype.zy")))
    (Bytes : @(import("../builtin/intrinsic/vtype.zy")))
    (Reader : @(import("../builtin/intrinsic/vtype.zy")))
    (Writer : @(import("../builtin/intrinsic/vtype.zy")))
    (IoErrorKind : @(import("../builtin/intrinsic/vtype.zy")))
    (IoError : @(import("../builtin/intrinsic/vtype.zy")))
    (OS : @(import("../builtin/intrinsic/ctype.zy"))) =
      (not_found :: IoErrorKind)
    * (permission_denied :: IoErrorKind)
    * (already_exists :: IoErrorKind)
    * (invalid_input :: IoErrorKind)
    * (invalid_data :: IoErrorKind)
    * (broken_pipe :: IoErrorKind)
    * (closed :: IoErrorKind)
    * (other :: IoErrorKind)
    * (
        kind_eq :: Thk (
          IoErrorKind -> IoErrorKind -> Ret Bool
        )
      )
    * (error_kind :: Thk (IoError -> Ret IoErrorKind))
    * (error_message :: Thk (IoError -> Ret String))
    * (
        read :: Thk (
             Reader -> Int64
          -> Thk (Result Bytes IoError -> OS)
          -> OS
        )
      )
    * (
        read_line :: Thk (
             Reader
          -> Thk (Result (Option Bytes) IoError -> OS)
          -> OS
        )
      )
    * (
        read_all :: Thk (
             Reader
          -> Thk (Result Bytes IoError -> OS)
          -> OS
        )
      )
    * (
        write_all :: Thk (
             Writer -> Bytes
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        flush :: Thk (
             Writer
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        close_reader :: Thk (
             Reader
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        close_writer :: Thk (
             Writer
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
  in
  IoModule
end
