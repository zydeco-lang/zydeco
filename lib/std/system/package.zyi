begin
  let DataPackage = @(import("../data/package.type.zy")) in
  let SystemPackage = @(import("package.type.zy")) in
  pi
    (
      (
        /core;
        /representations;
        /numeric;
        /text;
        /system = (/Reader; /Writer; /OS; /io; /fs; /stdio; /args; /random; /process);
        builtin
      )
      : @(import("../builtin.zy"))
    )
  .
    pi
      (
        (/Bool; /Option; /Result; /List) :
        DataPackage
      )
    .
      SystemPackage Bool Option Result List Reader Writer OS
end
