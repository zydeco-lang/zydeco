begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let CType = @(import("../builtin/intrinsic/ctype.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let StdioModule
    (
      Option : VType -> (
        VType
      )
    )
    (
      Result : VType -> (
        VType
      ) -> VType
    )
    (String : VType)
    (Reader : VType)
    (Writer : VType)
    (IoError : VType)
    (OS : CType) =
      (stdin :: Thk (Ret Reader))
    * (stdout :: Thk (Ret Writer))
    * (stderr :: Thk (Ret Writer))
    * (
        read_line :: Thk (
             Thk (Result (Option String) IoError -> OS)
          -> OS
        )
      )
    * (
        write :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        write_line :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        write_error :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        write_error_line :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
  in
  StdioModule
end
