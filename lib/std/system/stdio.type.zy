begin
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let StdioModule
    (
      Option : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      )
    )
    (
      Result : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      ) -> (@(import("../builtin/intrinsic/vtype.zy")))
    )
    (String : @(import("../builtin/intrinsic/vtype.zy")))
    (Reader : @(import("../builtin/intrinsic/vtype.zy")))
    (Writer : @(import("../builtin/intrinsic/vtype.zy")))
    (IoError : @(import("../builtin/intrinsic/vtype.zy")))
    (OS : @(import("../builtin/intrinsic/ctype.zy"))) =
      (stdin :: Thk (Ret Reader))
    * (stdout :: Thk (Ret Writer))
    * (stderr :: Thk (Ret Writer))
    * (
        read_line :: Thk (
             Thk (Result (Option String) IoError -> OS)
          -> OS
        )
      )
    * (
        write :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        write_line :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        write_error :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        write_error_line :: Thk (
             String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
  in
  StdioModule
end
