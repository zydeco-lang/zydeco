begin
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let FsModule
    (
      Result : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      ) -> (@(import("../builtin/intrinsic/vtype.zy")))
    )
    (String : @(import("../builtin/intrinsic/vtype.zy")))
    (Bytes : @(import("../builtin/intrinsic/vtype.zy")))
    (Reader : @(import("../builtin/intrinsic/vtype.zy")))
    (Writer : @(import("../builtin/intrinsic/vtype.zy")))
    (Path : @(import("../builtin/intrinsic/vtype.zy")))
    (IoError : @(import("../builtin/intrinsic/vtype.zy")))
    (OS : @(import("../builtin/intrinsic/ctype.zy"))) =
      (path :: Thk (String -> Ret Path))
    * (path_string :: Thk (Path -> Ret String))
    * (
        open_reader :: Thk (
             Path
          -> Thk (Result Reader IoError -> OS)
          -> OS
        )
      )
    * (
        create_writer :: Thk (
             Path
          -> Thk (Result Writer IoError -> OS)
          -> OS
        )
      )
    * (
        append_writer :: Thk (
             Path
          -> Thk (Result Writer IoError -> OS)
          -> OS
        )
      )
    * (
        read_bytes :: Thk (
             Path
          -> Thk (Result Bytes IoError -> OS)
          -> OS
        )
      )
    * (
        read_text :: Thk (
             Path
          -> Thk (Result String IoError -> OS)
          -> OS
        )
      )
    * (
        write_bytes :: Thk (
             Path -> Bytes
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        write_text :: Thk (
             Path -> String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
  in
  FsModule
end
