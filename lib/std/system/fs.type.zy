begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let CType = @(import("../builtin/intrinsic/ctype.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let FsModule
    (
      Result : VType -> (
        VType
      ) -> VType
    )
    (String : VType)
    (Bytes : VType)
    (Reader : VType)
    (Writer : VType)
    (Path : VType)
    (IoError : VType)
    (OS : CType) =
      (path :: Thk (String -> Ret Path))
    * (path_string :: Thk (Path -> Ret String))
    * (
        open_reader :: Thk (
             Path
          -> Thk (Result Reader IoError -> OS)
          -> OS
        )
      )
    * (
        create_writer :: Thk (
             Path
          -> Thk (Result Writer IoError -> OS)
          -> OS
        )
      )
    * (
        append_writer :: Thk (
             Path
          -> Thk (Result Writer IoError -> OS)
          -> OS
        )
      )
    * (
        read_bytes :: Thk (
             Path
          -> Thk (Result Bytes IoError -> OS)
          -> OS
        )
      )
    * (
        read_text :: Thk (
             Path
          -> Thk (Result String IoError -> OS)
          -> OS
        )
      )
    * (
        write_bytes :: Thk (
             Path -> Bytes
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
    * (
        write_text :: Thk (
             Path -> String
          -> Thk (Result Unit IoError -> OS)
          -> OS
        )
      )
  in
  FsModule
end
