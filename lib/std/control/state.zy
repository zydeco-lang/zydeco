-- The State effect, packaged as a pure library over the Builtin signature.
val
  (
    (/VType; /CType; /Thk; /Ret; /Unit; builtin) : @(import("../builtin.zy"))
  )
=>
  begin
    let monadic_basis = @(import("monad.zy")) that
    let (/Monad; /WithMonad) = builtin |> monadic_basis in
    begin
      -- The operations of the State effect, relative to an ambient monad M.
      let MonadState = @(import("state.type.zy")) that

      -- The canonical State relative monad: thread S through Ret and return
      -- both the answer and the final state.
      let State (S : VType) (A : VType) = S -> Ret (A * S) that

      -- The carrier is supplied by the surrounding composition or WithMonad package.
      let IState (S : VType) (M : VType -> CType) =
        (#state :: Thk (MonadState S M))
      that

      def ! mo_state (S : VType) : Monad (State S) =
        comatch
        | .return A a =>
          fn s =>
            ret (a, s)
        | .bind A A' m f =>
          fn s =>
            do (a, s') <- ! m s;
            ! f a s'
        end
      that

      def ! state (S : VType) : MonadState S (State S) =
        comatch
        | .get =>
          fn s =>
            ret (s, s)
        | .put s' =>
          fn _ =>
            ret ((), s')
        end
      that

      let val instance (S : VType) =
        pack (M as State S : VType -> CType)
        where
          #monad = { ! mo_state S },
          #state = { ! state S }
        end
      that

      def ! modify (S : VType)
        ((M, (/monad; /state)) : WithMonad (IState S))
        (f : Thk (S -> Ret S))
      : M Unit =
          ! monad .bind S Unit { ! state .get } {
            fn s =>
              do s' <- ! f s;
              ! state .put s'
          }
      that

      -- Runners expose the final state to an arbitrary computation continuation,
      -- so the module remains independent of OS.
      def ! run_state (S : VType)
        (A : VType)
        (B : CType)
        (initial : S)
        (m : Thk (State S A))
        (k : Thk (S -> A -> B))
      : B =
          do (a, s') <- ! m initial;
          ! k s' a
      that

      def ! eval_state (S : VType)
        (A : VType)
        (initial : S)
        (m : Thk (State S A))
      : Ret A =
          do (a, _) <- ! m initial;
          ret a
      that

      pack
          (= State as State : VType -> VType -> CType)
          (= MonadState as MonadState : VType -> (VType -> CType) -> CType)
          (= IState as IState : VType -> (VType -> CType) -> VType)
      where
        = instance,
        = modify,
        = run_state,
        = eval_state
      end
    end
  end
-- end module State
