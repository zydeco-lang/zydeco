begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Monad
    (
      M : VType -> (
        CType
      )
    ) =
    codata
    | .return :
      forall (A : VType) . A -> M A
    | .bind :
      forall (A : VType) .
        forall (B : VType) .
             Thk (M A)
          -> Thk (A -> M B)
          -> M B
    end
  in
  Monad
end
