begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let CType = @(import("../builtin/intrinsic/ctype.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let Top = @(import("top.type.zy")) in
  let Monad = @(import("monad.type.zy")) in
  let MonadThrow = @(import("exception.type.zy")) in
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (
        Exception = ExceptionType :
        VType -> (
          VType
        ) -> CType
      )
    .
      exists
        (
          MonadThrow = ExportedMonadThrow as MonadThrow :
          VType -> (
            VType -> (
              CType
            )
          ) -> CType
        )
      .
          (
            mo_exception :: Thk (
              forall (E : VType) .
                Monad (ExceptionType E)
            )
          )
        * (
            throw_ops :: Thk (
              forall (E : VType) .
                MonadThrow E (ExceptionType E)
            )
          )
        * (
            raise :: Thk (
              forall (E : VType) .
                forall (A : VType) .
                     Thk Top
                  -> E
                  -> ExceptionType E A
            )
          )
        * (
            handle_exception :: Thk (
              forall (E : VType) .
                forall (A : VType) .
                  forall (B : CType) .
                       Thk (ExceptionType E A)
                    -> Thk (E -> B)
                    -> Thk (A -> B)
                    -> B
            )
          )
        * (
            try_exception :: Thk (
              forall (E : VType) .
                forall (A : VType) .
                     Thk (ExceptionType E A)
                  -> Thk (E -> ExceptionType E A)
                  -> ExceptionType E A
            )
          )
end
-- end module Exception
