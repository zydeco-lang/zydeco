begin
  let Thk = @[import("../builtin/intrinsic/thk.zy")] _ that
  let Ret = @[import("../builtin/intrinsic/ret.zy")] _ that
  let Unit = @[import("../builtin/intrinsic/unit.zy")] _ that
  let Top =
    codata
    end
  that
  let Monad
    (
      M : (@[import("../builtin/intrinsic/vtype.zy")] _) -> (
        @[import("../builtin/intrinsic/ctype.zy")] _
      )
    ) =
    codata
    | .return :
      forall (A : @[import("../builtin/intrinsic/vtype.zy")] _) .
        A -> M A
    | .bind :
      forall (A : @[import("../builtin/intrinsic/vtype.zy")] _) .
        forall (B : @[import("../builtin/intrinsic/vtype.zy")] _) .
             Thk (M A)
          -> Thk (A -> M B)
          -> M B
    end
  that
  let MonadThrow
    (E : @[import("../builtin/intrinsic/vtype.zy")] _)
    (
      M : (@[import("../builtin/intrinsic/vtype.zy")] _) -> (
        @[import("../builtin/intrinsic/ctype.zy")] _
      )
    ) =
    codata
    | .throw :
      forall (A : @[import("../builtin/intrinsic/vtype.zy")] _) .
        E -> M A
    end
  that
  pi (_ : @[import("../builtin.zy")] _) .
    exists
      (
        Exception = ExceptionType :
        (@[import("../builtin/intrinsic/vtype.zy")] _) -> (
          @[import("../builtin/intrinsic/vtype.zy")] _
        ) -> (@[import("../builtin/intrinsic/ctype.zy")] _)
      )
    .
      exists
        (
          MonadThrow = ExportedMonadThrow as MonadThrow :
          (@[import("../builtin/intrinsic/vtype.zy")] _) -> (
            (@[import("../builtin/intrinsic/vtype.zy")] _) -> (
              @[import("../builtin/intrinsic/ctype.zy")] _
            )
          ) -> (@[import("../builtin/intrinsic/ctype.zy")] _)
        )
      .
        (
          mo_exception :: Thk (
            forall (E : @[import("../builtin/intrinsic/vtype.zy")] _) .
              Monad (ExceptionType E)
          )
        )
      * (
          throw_ops :: Thk (
            forall (E : @[import("../builtin/intrinsic/vtype.zy")] _) .
              MonadThrow E (ExceptionType E)
          )
        )
      * (
          raise :: Thk (
            forall (E : @[import("../builtin/intrinsic/vtype.zy")] _) .
              forall (A : @[import("../builtin/intrinsic/vtype.zy")] _) .
                   Thk Top
                -> E
                -> ExceptionType E A
          )
        )
      * (
          handle_exception :: Thk (
            forall (E : @[import("../builtin/intrinsic/vtype.zy")] _) .
              forall (A : @[import("../builtin/intrinsic/vtype.zy")] _) .
                forall (B : @[import("../builtin/intrinsic/ctype.zy")] _) .
                     Thk (ExceptionType E A)
                  -> Thk (E -> B)
                  -> Thk (A -> B)
                  -> B
          )
        )
      * (
          try_exception :: Thk (
            forall (E : @[import("../builtin/intrinsic/vtype.zy")] _) .
              forall (A : @[import("../builtin/intrinsic/vtype.zy")] _) .
                   Thk (ExceptionType E A)
                -> Thk (E -> ExceptionType E A)
                -> ExceptionType E A
          )
        )
end
-- end module Exception
