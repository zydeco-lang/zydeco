begin
  let Thk = @(import("../builtin/intrinsic/thk.zy")) that
  let Ret = @(import("../builtin/intrinsic/ret.zy")) that
  let Unit = @(import("../builtin/intrinsic/unit.zy")) that
  let Top =
    codata
    end
  that
  let Monad
    (
      M : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/ctype.zy"))
      )
    ) =
    codata
    | .return :
      forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
        A -> M A
    | .bind :
      forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
        forall (B : @(import("../builtin/intrinsic/vtype.zy"))) .
             Thk (M A)
          -> Thk (A -> M B)
          -> M B
    end
  that
  let MonadThrow
    (E : @(import("../builtin/intrinsic/vtype.zy")))
    (
      M : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/ctype.zy"))
      )
    ) =
    codata
    | .throw :
      forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
        E -> M A
    end
  that
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (
        Exception = ExceptionType :
        (@(import("../builtin/intrinsic/vtype.zy"))) -> (
          @(import("../builtin/intrinsic/vtype.zy"))
        ) -> (@(import("../builtin/intrinsic/ctype.zy")))
      )
    .
      exists
        (
          MonadThrow = ExportedMonadThrow as MonadThrow :
          (@(import("../builtin/intrinsic/vtype.zy"))) -> (
            (@(import("../builtin/intrinsic/vtype.zy"))) -> (
              @(import("../builtin/intrinsic/ctype.zy"))
            )
          ) -> (@(import("../builtin/intrinsic/ctype.zy")))
        )
      .
          (
            mo_exception :: Thk (
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                Monad (ExceptionType E)
            )
          )
        * (
            throw_ops :: Thk (
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                MonadThrow E (ExceptionType E)
            )
          )
        * (
            raise :: Thk (
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
                     Thk Top
                  -> E
                  -> ExceptionType E A
            )
          )
        * (
            handle_exception :: Thk (
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
                  forall (B : @(import("../builtin/intrinsic/ctype.zy"))) .
                       Thk (ExceptionType E A)
                    -> Thk (E -> B)
                    -> Thk (A -> B)
                    -> B
            )
          )
        * (
            try_exception :: Thk (
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
                     Thk (ExceptionType E A)
                  -> Thk (E -> ExceptionType E A)
                  -> ExceptionType E A
            )
          )
end
-- end module Exception
