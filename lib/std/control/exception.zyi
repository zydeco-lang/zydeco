begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let Unit = @(intrinsic(unit)) in
  let Top = @(import("top.type.zy")) in
  let Monad = @(import("monad.type.zy")) in
  let MonadThrow = @(import("exception.type.zy")) in
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (= Exception : VType -> VType -> CType)
      (= MonadThrow as MonadThrow : VType -> (VType -> CType) -> CType)
    .
        (#mo_exception :: Thk (forall (E : VType) . Monad (Exception E)))
      * (#throw_ops :: Thk (forall (E : VType) . MonadThrow E (Exception E)))
      * (
          #raise :: Thk (
            forall (E : VType) .
              forall (A : VType) . Thk Top -> E -> Exception E A
          )
        )
      * (
          #handle_exception :: Thk (
            forall (E : VType) .
              forall (A : VType) .
                forall (B : CType) .
                     Thk (Exception E A)
                  -> Thk (E -> B)
                  -> Thk (A -> B)
                  -> B
          )
        )
      * (
          #try_exception :: Thk (
            forall (E : VType) .
              forall (A : VType) .
                   Thk (Exception E A)
                -> Thk (E -> Exception E A)
                -> Exception E A
          )
        )
end
-- end module Exception
