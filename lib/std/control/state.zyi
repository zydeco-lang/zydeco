begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let CType = @(import("../builtin/intrinsic/ctype.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let Monad = @(import("monad.type.zy")) in
  let MonadState = @(import("state.type.zy")) in
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (
        State = StateType :
        VType -> (
          VType
        ) -> CType
      )
    .
      exists
        (
          MonadState = ExportedMonadState as MonadState :
          VType -> (
            VType -> (
              CType
            )
          ) -> CType
        )
      .
          (
            mo_state :: Thk (
              forall (S : VType) .
                Monad (StateType S)
            )
          )
        * (
            state :: Thk (
              forall (S : VType) .
                MonadState S (StateType S)
            )
          )
        * (
            get :: Thk (
              forall (S : VType) .
                StateType S S
            )
          )
        * (
            put :: Thk (
              forall (S : VType) .
                S -> StateType S Unit
            )
          )
        * (
            modify :: Thk (
              forall (S : VType) .
                   Thk (S -> Ret S)
                -> StateType S Unit
            )
          )
        * (
            run_state :: Thk (
              forall (S : VType) .
                forall (A : VType) .
                  forall (B : CType) .
                       S
                    -> Thk (StateType S A)
                    -> Thk (S -> A -> B)
                    -> B
            )
          )
        * (
            eval_state :: Thk (
              forall (S : VType) .
                forall (A : VType) .
                     S
                  -> Thk (StateType S A)
                  -> Ret A
            )
          )
end
-- end module State
