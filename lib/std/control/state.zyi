begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let Unit = @(intrinsic(unit)) in
  let Monad = @(import("monad.type.zy")) in
  let MonadState = @(import("state.type.zy")) in
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (
        #State = StateType :
        VType -> (
          VType
        ) -> CType
      )
    .
      exists
        (
          #MonadState = ExportedMonadState as MonadState :
          VType -> (
            VType -> (
              CType
            )
          ) -> CType
        )
      .
          (
            #mo_state :: Thk (
              forall (S : VType) .
                Monad (StateType S)
            )
          )
        * (
            #state :: Thk (
              forall (S : VType) .
                MonadState S (StateType S)
            )
          )
        * (
            #get :: Thk (
              forall (S : VType) .
                StateType S S
            )
          )
        * (
            #put :: Thk (
              forall (S : VType) .
                S -> StateType S Unit
            )
          )
        * (
            #modify :: Thk (
              forall (S : VType) .
                   Thk (S -> Ret S)
                -> StateType S Unit
            )
          )
        * (
            #run_state :: Thk (
              forall (S : VType) .
                forall (A : VType) .
                  forall (B : CType) .
                       S
                    -> Thk (StateType S A)
                    -> Thk (S -> A -> B)
                    -> B
            )
          )
        * (
            #eval_state :: Thk (
              forall (S : VType) .
                forall (A : VType) .
                     S
                  -> Thk (StateType S A)
                  -> Ret A
            )
          )
end
-- end module State
