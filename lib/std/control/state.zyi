begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let Unit = @(intrinsic(unit)) in
  let Monad = @(import("monad.type.zy")) in
  let MonadState = @(import("state.type.zy")) in
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (= State : VType -> VType -> CType)
      (= MonadState as MonadState : VType -> (VType -> CType) -> CType)
    .
        (#mo_state :: Thk (forall (S : VType) . Monad (State S)))
      * (#state :: Thk (forall (S : VType) . MonadState S (State S)))
      * (#get :: Thk (forall (S : VType) . State S S))
      * (#put :: Thk (forall (S : VType) . S -> State S Unit))
      * (
          #modify :: Thk (
            forall (S : VType) . Thk (S -> Ret S) -> State S Unit
          )
        )
      * (
          #run_state :: Thk (
            forall (S : VType) .
              forall (A : VType) .
                forall (B : CType) .
                     S
                  -> Thk (State S A)
                  -> Thk (S -> A -> B)
                  -> B
          )
        )
      * (
          #eval_state :: Thk (
            forall (S : VType) (A : VType) . S -> Thk (State S A) -> Ret A
          )
        )
end
-- end module State
