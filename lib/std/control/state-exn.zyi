begin
  let Thk = @(import("../builtin/intrinsic/thk.zy")) that
  let Ret = @(import("../builtin/intrinsic/ret.zy")) that
  let Unit = @(import("../builtin/intrinsic/unit.zy")) that
  let Top =
    codata
    end
  that
  let Monad
    (
      M : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/ctype.zy"))
      )
    ) =
    codata
    | .return :
      forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
        A -> M A
    | .bind :
      forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
        forall (B : @(import("../builtin/intrinsic/vtype.zy"))) .
             Thk (M A)
          -> Thk (A -> M B)
          -> M B
    end
  that
  let MonadState
    (S : @(import("../builtin/intrinsic/vtype.zy")))
    (
      M : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/ctype.zy"))
      )
    ) =
    codata
    | .get : M S
    | .put : S -> M Unit
    end
  that
  let MonadThrow
    (E : @(import("../builtin/intrinsic/vtype.zy")))
    (
      M : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/ctype.zy"))
      )
    ) =
    codata
    | .throw :
      forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
        E -> M A
    end
  that
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (
        StateExn = StateExnType :
        (@(import("../builtin/intrinsic/vtype.zy"))) -> (
          @(import("../builtin/intrinsic/vtype.zy"))
        ) -> (
          @(import("../builtin/intrinsic/vtype.zy"))
        ) -> (@(import("../builtin/intrinsic/ctype.zy")))
      )
    .
        (
          mo_state_exn :: Thk (
            forall (S : @(import("../builtin/intrinsic/vtype.zy"))) .
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                Monad (StateExnType S E)
          )
        )
      * (
          state_ops :: Thk (
            forall (S : @(import("../builtin/intrinsic/vtype.zy"))) .
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                MonadState S (StateExnType S E)
          )
        )
      * (
          throw_ops :: Thk (
            forall (S : @(import("../builtin/intrinsic/vtype.zy"))) .
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                MonadThrow E (StateExnType S E)
          )
        )
      * (
          get :: Thk (
            forall (S : @(import("../builtin/intrinsic/vtype.zy"))) .
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                StateExnType S E S
          )
        )
      * (
          put :: Thk (
            forall (S : @(import("../builtin/intrinsic/vtype.zy"))) .
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                S -> StateExnType S E Unit
          )
        )
      * (
          raise :: Thk (
            forall (S : @(import("../builtin/intrinsic/vtype.zy"))) .
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
                     Thk Top
                  -> E
                  -> StateExnType S E A
          )
        )
      * (
          catch :: Thk (
            forall (S : @(import("../builtin/intrinsic/vtype.zy"))) .
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
                     Thk Top
                  -> Thk (StateExnType S E A)
                  -> Thk (E -> StateExnType S E A)
                  -> StateExnType S E A
          )
        )
      * (
          run_state_exn :: Thk (
            forall (S : @(import("../builtin/intrinsic/vtype.zy"))) .
              forall (E : @(import("../builtin/intrinsic/vtype.zy"))) .
                forall (A : @(import("../builtin/intrinsic/vtype.zy"))) .
                  forall (B : @(import("../builtin/intrinsic/ctype.zy"))) .
                       S
                    -> Thk (StateExnType S E A)
                    -> Thk (E -> B)
                    -> Thk (S -> A -> B)
                    -> B
          )
        )
end
-- end module StateExn
