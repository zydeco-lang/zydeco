begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let Unit = @(intrinsic(unit)) in
  let Top = @(import("top.type.zy")) in
  let Monad = @(import("monad.type.zy")) in
  let MonadState = @(import("state.type.zy")) in
  let MonadThrow = @(import("exception.type.zy")) in
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (
        StateExn = StateExnType :
        VType -> (
          VType
        ) -> (
          VType
        ) -> CType
      )
    .
        (
          mo_state_exn :: Thk (
            forall (S : VType) .
              forall (E : VType) .
                Monad (StateExnType S E)
          )
        )
      * (
          state_ops :: Thk (
            forall (S : VType) .
              forall (E : VType) .
                MonadState S (StateExnType S E)
          )
        )
      * (
          throw_ops :: Thk (
            forall (S : VType) .
              forall (E : VType) .
                MonadThrow E (StateExnType S E)
          )
        )
      * (
          get :: Thk (
            forall (S : VType) .
              forall (E : VType) .
                StateExnType S E S
          )
        )
      * (
          put :: Thk (
            forall (S : VType) .
              forall (E : VType) .
                S -> StateExnType S E Unit
          )
        )
      * (
          raise :: Thk (
            forall (S : VType) .
              forall (E : VType) .
                forall (A : VType) .
                     Thk Top
                  -> E
                  -> StateExnType S E A
          )
        )
      * (
          catch :: Thk (
            forall (S : VType) .
              forall (E : VType) .
                forall (A : VType) .
                     Thk Top
                  -> Thk (StateExnType S E A)
                  -> Thk (E -> StateExnType S E A)
                  -> StateExnType S E A
          )
        )
      * (
          run_state_exn :: Thk (
            forall (S : VType) .
              forall (E : VType) .
                forall (A : VType) .
                  forall (B : CType) .
                       S
                    -> Thk (StateExnType S E A)
                    -> Thk (E -> B)
                    -> Thk (S -> A -> B)
                    -> B
          )
        )
end
-- end module StateExn
