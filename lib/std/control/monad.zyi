begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Monad = @(import("monad.type.zy")) in
  let Algebra = @(import("algebra.type.zy")) in
  let Unit = @(intrinsic(unit)) in
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (
        Monad = ExportedMonad as Monad :
        (
          VType -> (
            CType
          )
        ) -> CType
      )
    .
      exists
        (
          Algebra = ExportedAlgebra as Algebra :
          (
               (
                 VType -> (
                   CType
                 )
               )
            -> CType
            -> CType
          )
        )
      .
        Unit
end
