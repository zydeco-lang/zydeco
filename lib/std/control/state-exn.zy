-- A combined State + Exception stack, built from the two effect interfaces.
val
  (
    (/VType; /CType; /Thk; /Ret; /Unit; builtin) : @(import("../builtin.zy"))
  )
=>
  begin
    let monadic_basis = @(import("monad.zy")) that
    let state_basis = @(import("state.zy")) that
    let exception_basis = @(import("exception.zy")) that
    let (= Monad, = Algebra, ()) = builtin |> monadic_basis in
    let (/MonadState) = builtin |> state_basis in
    let (/MonadThrow) = builtin |> exception_basis in
    begin
      def Either (E : VType) (A : VType) =
        data
        | +Left : E
        | +Right : A
        end
      that
      -- State layered over Exception: failure discards the state, and catch
      -- restarts its handler from the state at entry to the protected computation.
      let StateExn (S : VType) (E : VType) (A : VType) =
        S -> Ret (Either E (A * S))
      that

      let IStateExn (S : VType) (E : VType) =
        exists (M : VType -> CType) .
            (#monad :: Thk (Monad M))
          * (#state :: Thk (MonadState S M))
          * (#exception :: Thk (MonadThrow E M))
          * (#catch :: Thk (forall (A : VType) . Thk (M A) -> Thk (E -> M A) -> M A))
      that

      def ! mo_state_exn (S : VType) (E : VType) : Monad (StateExn S E) =
        comatch
        | .return A a =>
          fn s =>
            ret +Right(a, s)
        | .bind A A' m f =>
          fn s =>
            do r <- ! m s;
            match r
            | +Left(e) => ret +Left(e)
            | +Right(a, s') => ! f a s'
            end
        end
      that

      def ! state_ops (S : VType) (E : VType) : MonadState S (StateExn S E) =
        comatch
        | .get =>
          fn s =>
            ret +Right(s, s)
        | .put s' =>
          fn _ =>
            ret +Right((), s')
        end
      that

      def ! throw_ops (S : VType) (E : VType) : MonadThrow E (StateExn S E) =
        comatch
        | .throw A e =>
          fn _ =>
            ret +Left(e)
        end
      that

      def ! catch (S : VType)
        (E : VType)
        (A : VType)
        (m : Thk (StateExn S E A))
        (h : Thk (E -> StateExn S E A))
      : StateExn S E A =
          fn s =>
            do r <- ! m s;
            match r
            | +Left(e) => ! h e s
            | +Right(a, s') => ret +Right(a, s')
            end
      that

      let val instance (S : VType) (E : VType) =
        pack (M as StateExn S E : VType -> CType)
        where
          #monad = { ! mo_state_exn S E },
          #state = { ! state_ops S E },
          #exception = { ! throw_ops S E },
          #catch = { ! catch S E }
        end
      that

      -- Runner: observe the error or the answer and the final state.
      def ! run_state_exn (S : VType)
        (E : VType)
        (A : VType)
        (B : CType)
        (initial : S)
        (m : Thk (StateExn S E A))
        (on_error : Thk (E -> B))
        (on_value : Thk (S -> A -> B))
      : B =
          do r <- ! m initial;
          match r
          | +Left(e) => ! on_error e
          | +Right(a, s') => ! on_value s' a
          end
      that

      pack
          (= StateExn as StateExn : VType -> VType -> VType -> CType)
          (= IStateExn as IStateExn : VType -> VType -> VType)
      where
        = instance,
        = run_state_exn
      end
    end
  end
-- end module StateExn
