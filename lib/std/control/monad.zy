param (
  (/core; builtin) :
  @(import("../builtin.zy"))
) in
let (/VType; /CType; /Thk; /Unit) = core in
begin
  -- Shared Monad and algebra type constructors.
  let Monad = @(import("monad.type.zy")) that
  let Algebra = @(import("algebra.type.zy")) that

  (= Monad, = Algebra, ())
end
-- end module Monad
