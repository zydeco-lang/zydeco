-- Geometry-only array construction; whole-value codecs are selected explicitly afterward.
begin
  param val (/VType; /CType; /Thk; /Ret; /Unit; /Addr; /Int; /numeric; builtin) : @(import(
    "../builtin.zy"
  )) in
  param val (/Uninit; /Init; /Ptr; types) : (@(import("types.type.zy"))) Addr in
  param val (/Storage; /DynamicStorage; /constant; /runtime) : @(import("storage.type.zy")) in
  let Fault = @(import("fault.zy")) in
  let Error = @(import("layout-error.zy")) in
  let Result = @(import("../data/result.zy")) in
  let size = @(import("size.zy")) in
  let dynamic_size = builtin |> (@(import("dynamic-size.zy"))) in
  let (/Array; /make = fixed_core) = (builtin |> (@(import("array-core.zy")))) types Storage in
  let (/Array = RuntimeParts; /make = dynamic_core) = (builtin |> (@(import("array-core.zy"))))
    types DynamicStorage in
  let Codec = (@(import("codec.type.zy"))) Uninit Init Ptr in
  let DynamicCodec = (@(import("dynamic-codec.type.zy"))) Uninit Init Ptr in
  let Alloc = (@(import("allocator.type.zy"))) Addr in
  let DynamicArray (Element : VType) =
    exists (= L : VType) (= Build : VType) (= Values : VType -> VType) .
        (#capacity :: Int) * (#stride :: Int) * (#storage :: DynamicStorage L)
      * (
          #codecs :: Thk (
            forall (A : VType) . DynamicCodec Element A -> Ret (DynamicCodec L (Values A))
          )
        )
      * (
          #values ::
            (#generate :: Thk (forall (A : VType) . Thk (Int -> Ret A) -> Ret (Values A)))
          * (#at :: Thk (forall (A : VType) . Values A -> Int -> Ret (Result A Fault)))
        )
      * (
          #elements :: (
            #unsafe ::
              (#base :: Thk (forall (S : VType) . Ptr L S -> Ret (Ptr Element S)))
            * (
                #at :: Thk (
                  forall (S : VType) (R : CType) .
                    Ptr L S -> Int -> Thk (Fault -> R) -> Thk (Ptr Element S -> R) -> R
                )
              )
            * (
                #init_each :: Thk (
                  forall (R : CType) .
                       Ptr L Uninit
                    -> Thk (
                            Int -> Ptr Element Uninit -> Thk (Fault -> Ptr Element Uninit -> R)
                         -> Thk (Ptr Element Init -> R) -> R
                       )
                    -> Thk (Fault -> Build -> R) -> Thk (Ptr L Init -> R) -> R
                )
              )
          )
        )
      * (
          #buffer :: (
            #unsafe ::
              (#start :: Thk (Ptr L Uninit -> Ret Build))
            * (#resume :: Thk (Ptr L Init -> Ret Build))
            * (#length :: Thk (Build -> Ret Int))
            * (#prefix :: Thk (Build -> Ret (Ptr Element Init * Int)))
            * (
                #push :: Thk (
                  forall (A : VType) (R : CType) .
                       DynamicCodec Element A -> Build -> A
                    -> Thk (Fault -> R) -> Thk (Build -> R) -> R
                )
              )
            * (
                #pop :: Thk (
                  forall (A : VType) (R : CType) .
                       DynamicCodec Element A -> Build
                    -> Thk (Fault -> R) -> Thk (Build -> A -> R) -> R
                )
              )
            * (
                #finish :: Thk (
                  forall (R : CType) . Build -> Thk (Fault -> R) -> Thk (Ptr L Init -> R) -> R
                )
              )
            * (#free :: Thk (forall (R : CType) . Alloc -> Build -> Thk (Fault -> R) -> Thk R -> R))
          )
        )
  in
  let val materialize_parts (Element : VType) (parts : RuntimeParts Element) : DynamicArray Element
  =
    let (
      /L;
      /Build;
      /Values;
      /capacity;
      /stride;
      /storage;
      /dynamic_codecs;
      /values;
      /elements;
      /buffer
    )
    =
      parts
    in
    let val adapt (A : VType) (codec : DynamicCodec Element A) : Codec Element A =
      (#init = val pointer value => { fn R yes => ! codec/init pointer value R yes },
        #read = val pointer => { fn R yes => ! codec/read pointer R yes })
    in
    (
      (
        = L,
        = Build,
        = Values,
        = capacity,
        = stride,
        = storage,
        #codecs = { fn A codec => ret (dynamic_codecs A codec) },
        = values,
        = elements,
        #buffer = (
          #unsafe = (
            #start = buffer/start,
            #resume = buffer/resume,
            #length = buffer/length,
            #prefix = buffer/prefix,
            #push = {
              fn A R codec progress value no yes =>
                ! (buffer/push A (adapt A codec) progress value) R no yes
            },
            #pop = {
              fn A R codec progress no yes => ! (buffer/pop A (adapt A codec) progress) R no yes
            },
            #finish = buffer/finish,
            #free = buffer/free
          )
        )
      ) : DynamicArray Element
    )
  in
  let val make (Element : VType) (element : Storage Element) (capacity : Int) (boundary : Int) :
    Result (Array Element) Error =
      let geometry = constant/query Element element in
      size/bind Int (Array Element) (size/alignment boundary) (
        val boundary =>
          size/bind Int (Array Element) (size/round_up geometry/size geometry/alignment) (
            val stride =>
              size/bind Int (Array Element) (size/multiply stride capacity) (
                val bytes =>
                  let alignment = size/maximum geometry/alignment boundary in
                  size/bind Int (Array Element) (size/round_up bytes alignment) (
                    val count =>
                      size/bind (Storage Unit) (Array Element) (
                        constant/unsafe/for_layout Unit count alignment
                      )
                        (
                          val storage =>
                            +Ok(fixed_core Element storage capacity stride count alignment)
                        )
                  )
              )
          )
      )
  in
  let realize : Thk (
    forall (Element : VType) (R : CType) .
         DynamicStorage Element -> Int -> Int
      -> Thk (Fault -> R) -> Thk (DynamicArray Element -> R) -> R
  ) = {
    fn Element R element capacity boundary no yes =>
      let geometry = runtime/query Element element in
      let ! invalid (error : Error) : R =
        match error
        | +SizeOverflow() => ! no +Overflow()
        | _ => ! no +InvalidLayout()
        end
      in
      do aligned <- ! dynamic_size/alignment boundary;
      match aligned
      | +Err(error) => ! invalid error
      | +Ok(boundary) =>
        do rounded <- ! dynamic_size/round_up geometry/size geometry/alignment;
        match rounded
        | +Err(error) => ! invalid error
        | +Ok(stride) =>
          do multiplied <- ! dynamic_size/multiply stride capacity;
          match multiplied
          | +Err(error) => ! invalid error
          | +Ok(bytes) =>
            do alignment <- ! numeric/int/gt (Ret Int) geometry/alignment boundary
              { ret geometry/alignment } { ret boundary };
            do extent <- ! dynamic_size/round_up bytes alignment;
            match extent
            | +Err(error) => ! invalid error
            | +Ok(count) =>
              do checked <- ! runtime/unsafe/for_layout Unit count alignment;
              match checked
              | +Err(error) => ! invalid error
              | +Ok(storage) => ! yes (
                materialize_parts Element (
                  dynamic_core Element storage capacity stride count alignment
                )
              )
              end
            end
          end
        end
      end
  } in
  pack (= Array as Array : VType -> VType) (= DynamicArray as DynamicArray : VType -> VType)
  where
    (= make, = realize) end
end
