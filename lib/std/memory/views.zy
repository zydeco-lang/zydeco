-- Source-defined cells and views, parameterized by address and access capabilities.
begin
  param val (/VType; /CType; /Thk; /Unit; /Int64; /UInt8; /numeric) : @(import("../builtin.zy")) that
  param val Addr : VType in
  param val Access : VType in
  let Fault = @(import("fault.zy")) in
  let Result = @(import("../data/result.zy")) in
  let LayoutError = @(import("layout-error.zy")) in
  let size = @(import("size.zy")) in
  let int = numeric/int64 in
  let Memory (R : CType) =
    codata
    | .check : Access -> Addr -> Int64 -> Int64 -> Thk (Fault -> R) -> Thk R -> R
    | .load_u8 : Access -> Addr -> Thk (Fault -> R) -> Thk (UInt8 -> R) -> R
    | .offset : Access -> Addr -> Int64 -> Thk (Fault -> R) -> Thk (Addr -> R) -> R
    | .load_i64 : Access -> Addr -> Thk (Fault -> R) -> Thk (Int64 -> R) -> R
    | .load_addr : Access -> Addr -> Thk (Fault -> R) -> Thk (Addr -> R) -> R
    end
  in
  let Mem (A : VType) (R : CType) =
    Thk (Memory R) -> Thk (Fault -> R) -> Thk (A -> R) -> R
  in
  let Cell (A : VType) =
      (#size :: Int64)
    * (#alignment :: Int64)
    * (#read :: Thk (forall (R : CType) . Access -> Addr -> Mem A R))
  in
  let Fat (RuntimeMetadata : VType) =
    (#address :: Addr) * (#runtime_metadata :: RuntimeMetadata)
  in
  let View (Handle : VType) (RuntimeMetadata : VType) =
    (#open :: Thk (forall (R : CType) . Access -> Handle -> Mem (Addr * RuntimeMetadata) R))
  in
  let uint8 : Cell UInt8 =
    (#size = 1, #alignment = 1,
      #read = { fn R access address memory no yes => ! memory .load_u8 access address no yes })
  in
  let int64 : Cell Int64 =
    (#size = 8, #alignment = 8,
      #read = { fn R access address memory no yes => ! memory .load_i64 access address no yes })
  in
  let val address (width : Int64) (alignment : Int64) : Cell Addr =
    (#size = width, = alignment,
      #read = { fn R access address memory no yes => ! memory .load_addr access address no yes })
  in
  let val product (A : VType) (B : VType) (left : Cell A) (right : Cell B) :
    Result (Cell (A * B)) LayoutError =
      size/bind Int64 (Cell (A * B)) (size/alignment left/alignment) (
        val left_alignment =>
          size/bind Int64 (Cell (A * B)) (size/round_up left/size right/alignment) (
            val offset =>
              size/bind Int64 (Cell (A * B)) (size/add offset right/size) (
                val field_end =>
                  let alignment = size/maximum left_alignment right/alignment in
                  size/bind Int64 (Cell (A * B)) (size/round_up field_end alignment) (
                    val count =>
                      +Ok(
                        #size = count,
                        = alignment,
                        #read = {
                          fn R access address memory no yes =>
                            ! memory .check access address count alignment no {
                              ! left/read R access address memory no {
                                fn a =>
                                  ! memory .offset access address offset no {
                                    fn second =>
                                      ! right/read R access second memory no {
                                        fn b => ! yes (a, b)
                                      }
                                  }
                              }
                            }
                        }
                      )
                  )
              )
          )
      )
  in
  let val fat_cell (RuntimeMetadata : VType) (pointer : Cell Addr) (runtime : Cell RuntimeMetadata)
  : Result (Cell (Fat RuntimeMetadata)) LayoutError =
      size/bind (Cell (Addr * RuntimeMetadata)) (Cell (Fat RuntimeMetadata))
        (product Addr RuntimeMetadata pointer runtime) (
        val cell =>
          +Ok(
            #size = cell/size,
            #alignment = cell/alignment,
            #read = {
              fn R access address memory no yes =>
                ! cell/read R access address memory no {
                  fn (payload, runtime_metadata) => ! yes (#address = payload, = runtime_metadata)
                }
            }
          )
      )
  in
  let thin : View Addr Unit =
    (#open = { fn R _ payload _ _ yes => ! yes (payload, ()) })
  in
  let val fat (RuntimeMetadata : VType) :
    View (Fat RuntimeMetadata) RuntimeMetadata =
      (
        #open = {
          fn R _ handle _ _ yes => ! yes (handle/address, handle/runtime_metadata)
        }
      )
  in
  let val with_runtime_metadata (RuntimeMetadata : VType) (payload : Addr)
    (runtime_metadata : RuntimeMetadata)
  : Fat RuntimeMetadata =
      (#address = payload, = runtime_metadata)
  in
  let val runtime_metadata (RuntimeMetadata : VType) (handle : Fat RuntimeMetadata) :
    RuntimeMetadata = handle/runtime_metadata in
  let val indirect (RuntimeMetadata : VType) (runtime : Cell RuntimeMetadata)
    (runtime_offset : Int64) (data_offset : Int64)
  : View Addr RuntimeMetadata =
      (
        #open = {
          fn R access origin memory no yes =>
            ! memory .offset access origin runtime_offset no {
              fn location =>
                ! runtime/read R access location memory no {
                  fn runtime_metadata =>
                    ! memory .offset access origin data_offset no {
                      fn payload => ! yes (payload, runtime_metadata)
                    }
                }
            }
        }
      )
  in
  let val padding (count : Int64) : Result (Cell Unit) LayoutError =
    size/bind Int64 (Cell Unit) (size/size count) (
      val count =>
        +Ok(
          #size = count,
          #alignment = 1,
          #read = {
            fn R access address memory no yes =>
              ! memory .check access address count 1 no { ! yes () }
          }
        )
    )
  in
  let val align (A : VType) (boundary : Int64) (cell : Cell A) : Result (Cell A) LayoutError =
    size/bind Int64 (Cell A) (size/alignment boundary) (
      val boundary =>
        size/bind Int64 (Cell A) (size/alignment cell/alignment) (
          val old_alignment =>
            let alignment = size/maximum boundary old_alignment in
            size/bind Int64 (Cell A) (size/round_up cell/size alignment) (
              val count =>
                +Ok(
                  #size = count,
                  = alignment,
                  #read = {
                    fn R access address memory no yes =>
                      ! memory .check access address count alignment no {
                        ! cell/read R access address memory no yes
                      }
                  }
                )
            )
        )
    )
  in
  let read_at : Thk (forall (A : VType) (R : CType) . Cell A -> Access -> Addr -> Mem A R) = {
    fn A R cell access address memory no yes =>
      ! memory .check access address cell/size cell/alignment no {
        ! cell/read R access address memory no yes
      }
  } in
  let index : Thk (
    forall (H : VType) (A : VType) (R : CType) .
      View H Int64 -> Cell A -> Access -> H -> Int64 -> Mem A R
  ) = {
    fn H A R view cell access handle index memory no yes =>
      ! view/open R access handle memory no {
        fn (base, length) =>
          ! int/lt R length 0 { ! no +InvalidValue() } {
            ! int/lt R index 0 { ! no +Bounds() } {
              ! int/lt R index length {
                ! int/lt R cell/size 0 { ! no +InvalidValue() } {
                  ! int/eq R cell/size 0 {
                    ! read_at A R cell access base memory no yes
                  } {
                    do limit <- ! int/div 9223372036854775807 cell/size;
                    ! int/gt R index limit { ! no +Overflow() } {
                      do displacement <- ! int/mul index cell/size;
                      ! memory .offset access base displacement no {
                        fn location => ! read_at A R cell access location memory no yes
                      }
                    }
                  }
                }
              } { ! no +Bounds() }
            }
          }
      }
  } in
  let val pointer (A : VType) (carrier : Cell Addr) (element : Cell A) :
    exists (= Ptr : VType) .
        (#from_address :: val pi (address : Addr) . Ptr)
      * (#address_of :: val pi (pointer : Ptr) . Addr)
      * (#pointer_cell :: Cell Ptr)
      * (#get :: Thk (forall (R : CType) . Access -> Ptr -> Mem A R))
  = (
    #Ptr = Addr,
    (
      #from_address = val address => address,
      #address_of = val pointer => pointer,
      #pointer_cell = carrier,
      #get = {
        fn R access pointer memory no yes =>
          ! read_at A R element access pointer memory no yes
      }
    )
  ) in
  let val slice (H : VType) (A : VType) (carrier : Cell H) (view : View H Int64) (element : Cell A)
  : exists (= Slice : VType) .
        (#from_handle :: val pi (handle : H) . Slice)
      * (#handle_of :: val pi (slice : Slice) . H)
      * (#slice_cell :: Cell Slice)
      * (#get :: Thk (forall (R : CType) . Access -> Slice -> Int64 -> Mem A R))
  = (
    #Slice = H,
    (
      #from_handle = val handle => handle,
      #handle_of = val slice => slice,
      #slice_cell = carrier,
      #get = {
        fn R access slice position memory no yes =>
          ! index H A R view element access slice position memory no yes
      }
    )
  ) in
  pack (= Fault as Fault : VType)
      (= Memory as Memory : CType -> CType)
      (= Mem as Mem : VType -> CType -> CType)
      (= Cell as Cell : VType -> VType)
      (= Fat as Fat : VType -> VType)
      (= View as View : VType -> VType -> VType)
  where
    = uint8,
    = int64,
    = address,
    = product,
    = padding,
    = align,
    = read_at,
    = index,
    = fat_cell,
    = thin,
    = fat,
    = with_runtime_metadata,
    = runtime_metadata,
    = indirect,
    = pointer,
    = slice
  end
end
