begin
  param val (/Addr; /VType; /CType; /Thk; /Ret; /Unit;
    /Int8; /Int16; /Int32; /Int64; /Int; /UInt8; /UInt16; /UInt32; /UInt64; /UInt;
    /Float32; /Float64; /numeric; /memory; builtin) : @(import("../builtin.zy")) in
  param val (/Uninit; /Init; /Ptr; types) : (@(import("types.type.zy"))) Addr in
  param val (/Storage; /constant; storage_api) : @(import("storage.type.zy")) in
  let Result = @(import("../data/result.zy")) in
  let Error = @(import("layout-error.zy")) in
  let Shape = @(import("shape.zy")) in
  let (/Codec; codecs) = (builtin |> (@(import("codecs.zy")))) types in
  let Representation = (@(import("representation.type.zy"))) Storage Codec in
  let size = @(import("size.zy")) in
  let Plan (A : VType) = (#shape :: Shape) * (#representation :: Representation A) in
  let Layout (A : VType) = Result (Plan A) Error in
  let val make (A : VType) (shape : Shape) (recipe : val pi (L : VType) . Codec L A) : Layout A =
    size/bind (exists (= L : VType) . Storage L) (Plan A)
      (constant/create shape/size shape/alignment) (
      val package =>
        let (= L, storage) = package in
        +Ok(= shape, #representation = (= L, = storage, #codec = recipe L) : Representation A)
    )
  in
  let val scalar (A : VType) (count : Int)
    (write : Thk (forall (R : CType) . Addr -> A -> Thk R -> R))
    (read : Thk (forall (R : CType) . Addr -> Thk (A -> R) -> R))
  : Layout A =
      make A (#size = count, #alignment = count, #form = +Scalar(#width = count))
        (val L => codecs/unsafe/scalar L A write read)
  in
  let val padding (count : Int) : Layout Unit =
    make Unit (#size = count, #alignment = 1, #form = +Padding()) (val L => codecs/unsafe/padding L)
  in
  let val product (A : VType) (B : VType) (left : Layout A) (right : Layout B) : Layout (A * B) =
    size/bind (Plan A) (Plan (A * B)) left (
      val left =>
        size/bind (Plan B) (Plan (A * B)) right (
          val right =>
            size/bind Int (Plan (A * B)) (size/round_up left/shape/size right/shape/alignment) (
              val offset =>
                size/bind Int (Plan (A * B)) (size/add offset right/shape/size) (
                  val field_end =>
                    let alignment = size/maximum left/shape/alignment right/shape/alignment in
                    size/bind Int (Plan (A * B)) (size/round_up field_end alignment) (
                      val count =>
                        let (#L = Left, left_repr) = left/representation in
                        let (#L = Right, right_repr) = right/representation in
                        make (A * B) (#size = count, = alignment,
                          #form = +Product(= offset, #left = left/shape, #right = right/shape))
                          (
                            val L =>
                              codecs/unsafe/product_at L Left Right A B left_repr/codec
                                right_repr/codec 0 offset
                          )
                    )
                )
            )
        )
    )
  in
  let val align (A : VType) (boundary : Int) (layout : Layout A) : Layout A =
    size/bind Int (Plan A) (size/alignment boundary) (
      val boundary =>
        size/bind (Plan A) (Plan A) layout (
          val layout =>
            let alignment = size/maximum boundary layout/shape/alignment in
            size/bind Int (Plan A) (size/round_up layout/shape/size alignment) (
              val count =>
                let (#L = Old, repr) = layout/representation in
                make A (#size = count, = alignment, #form = layout/shape/form)
                  (val L => codecs/unsafe/relabel L Old A repr/codec)
            )
        )
    )
  in
  let val inspect (A : VType) (plan : Plan A) : Shape = plan/shape in
  let val realize (A : VType) (plan : Plan A) : Representation A =
    let known_size = (@(intrinsic(int_add))) plan/shape/size 0 in
    let known_alignment = (@(intrinsic(int_add))) plan/shape/alignment 0 in
    plan/representation
  in
  (
    (
      = Plan,
      = Layout,
      (#unit = padding 0, = padding, = product, = align, = inspect, = realize,
        #int8 = scalar Int8 1 numeric/int8/store_le numeric/int8/load_le,
        #int16 = scalar Int16 2 numeric/int16/store_le numeric/int16/load_le,
        #int32 = scalar Int32 4 numeric/int32/store_le numeric/int32/load_le,
        #int64 = scalar Int64 8 numeric/int64/store_le numeric/int64/load_le,
        #int = scalar Int 8 numeric/int/store_le numeric/int/load_le,
        #uint8 = scalar UInt8 1 numeric/uint8/store_le numeric/uint8/load_le,
        #uint16 = scalar UInt16 2 numeric/uint16/store_le numeric/uint16/load_le,
        #uint32 = scalar UInt32 4 numeric/uint32/store_le numeric/uint32/load_le,
        #uint64 = scalar UInt64 8 numeric/uint64/store_le numeric/uint64/load_le,
        #uint = scalar UInt 8 numeric/uint/store_le numeric/uint/load_le,
        #float32 = scalar Float32 4 numeric/float32/store_le numeric/float32/load_le,
        #float64 = scalar Float64 8 numeric/float64/store_le numeric/float64/load_le,
        #addr = scalar Addr 8 memory/store_addr memory/load_addr)
    ) : (@(import("layout.type.zy"))) Addr Storage Codec
  )
end
