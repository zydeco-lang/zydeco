begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Int = @(intrinsic(int)) in
  let Fault = @(import("fault.zy")) in
  param Addr : VType in
    (
      #allocate :: Thk (
        forall (R : CType) . Int -> Int -> Thk (Fault -> R) -> Thk (Addr -> R) -> R
      )
    )
  * (#free :: Thk (forall (R : CType) . Addr -> Int -> Int -> Thk (Fault -> R) -> Thk R -> R))
end
