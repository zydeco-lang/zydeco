begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Storage = @(import("storage.type.zy")) in
  let Function (A : VType) (B : VType) (R : CType) =
    A -> Thk R -> Thk (B -> R) -> R
  in
  let val between (A : VType) (B : VType) (Input : VType) (Output : VType)
    (input : Storage A Input) (output : Storage B Output)
  =
    let val encode (R : CType) (body : Thk (Function A B R)) :
      Thk (Function Input Output R) = {
        fn stored no yes =>
          ! input/load R stored no {
            fn value => ! body value no { fn result => ! output/store R result no yes }
          }
      }
    in
    let val decode (R : CType) (body : Thk (Function Input Output R)) :
      Thk (Function A B R) = {
        fn value no yes =>
          ! input/store R value no {
            fn stored => ! body stored no { fn result => ! output/load R result no yes }
          }
      }
    in
    (= encode, = decode)
  in
  let val compose (A : VType) (B : VType) (C : VType) (R : CType)
    (first : Thk (Function A B R)) (second : Thk (Function B C R))
  : Thk (Function A C R) = {
      fn value no yes => ! first value no { fn middle => ! second middle no yes }
    }
  in
  let val convert (A : VType) (From : VType) (To : VType)
    (source : Storage A From) (target : Storage A To) (R : CType)
  : Thk (Function From To R) = {
      fn stored no yes => ! source/load R stored no { fn value => ! target/store R value no yes }
    }
  in
  pack (= Function as Function : VType -> VType -> CType -> CType)
  where
    (= between, = compose, = convert) end
end
