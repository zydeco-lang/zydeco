-- A manually managed byte builder. Copies of its handle do not track later state changes.
begin
  param val (/VType; /CType; /Thk; /Ret; /Addr; /Int; /UInt8; /numeric; builtin) : @(import(
    "../builtin.zy"
  )) that
  param val (/Bytes; /bytes) : (@(import("../text/bytes.type.zy"))) Addr in
  let (/Fault; /unsafe; native) = builtin |> (@(import("native.zy"))) in
  let Alloc = (@(import("allocator.type.zy"))) Addr in
  let Buffer = Addr * Int * Int in
  let int = numeric/int in
  let allocate : Thk (
    forall (R : CType) . Alloc -> Int -> Thk (Fault -> R) -> Thk (Buffer -> R) -> R
  ) = {
    fn R allocator capacity no yes =>
      ! allocator/allocate R capacity 1 no { fn p => ! yes (p, capacity, 0) }
  } in
  let length : Thk (Buffer -> Ret Int) = { fn (_, _, length) => ret length } in
  let capacity : Thk (Buffer -> Ret Int) = { fn (_, capacity, _) => ret capacity } in
  let push : Thk (
    forall (R : CType) . Buffer -> UInt8 -> Thk (Fault -> R) -> Thk (Buffer -> R) -> R
  ) = {
    fn R (p, capacity, length) value no yes =>
      ! int/lt R length capacity {
        do target <- ! unsafe/offset p length;
        ! unsafe/store_u8 R target value {
          do next <- ! int/add length 1;
          ! yes (p, capacity, next)
        }
      } { ! no +Bounds() }
  } in
  let extend : Thk (
    forall (R : CType) . Buffer -> Bytes -> Thk (Fault -> R) -> Thk (Buffer -> R) -> R
  ) = {
    fn R (p, capacity, length) source no yes =>
      do count <- ! bytes/length source;
      do remaining <- ! int/sub capacity length;
      ! int/gt R count remaining { ! no +Bounds() } {
        do target <- ! unsafe/offset p length;
        ! bytes/unsafe/copy_to R source target {
          do next <- ! int/add length count;
          ! yes (p, capacity, next)
        }
      }
  } in
  let snapshot : Thk (forall (R : CType) . Buffer -> Thk (Fault -> R) -> Thk (Bytes -> R) -> R) = {
    fn R (p, _, length) no yes =>
      ! bytes/unsafe/build R length 1 { fn target _ done => ! unsafe/copy R p target length done }
        no yes
  } in
  let close : Thk (forall (R : CType) . Alloc -> Buffer -> Thk (Fault -> R) -> Thk R -> R) = {
    fn R allocator (p, capacity, _) no done => ! allocator/free R p capacity 1 no done
  } in
  -- This transfer requires allocation by the builtin heap. The initialized prefix
  -- becomes visible; uninitialized spare capacity remains unreadable through Bytes.
  let finish_heap : Thk (forall (R : CType) . Buffer -> Thk (Fault -> R) -> Thk (Bytes -> R) -> R) =
    {
      fn R (p, capacity, length) no yes =>
        ! unsafe/retain R p capacity 1 no {
          ! bytes/unsafe/from_retained R p length no yes
        }
    }
  in
  pack (= Buffer : VType) is Buffer
  where
    (
      = allocate,
      = length,
      = capacity,
      #unsafe = (= push, = extend, = snapshot, = close, = finish_heap)
    )
  end
end
