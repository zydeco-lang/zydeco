begin
  param val (/Addr; /VType; /CType; /Thk; /Ret; /Unit;
    /Int8; /Int16; /Int32; /Int64; /Int; /UInt8; /UInt16; /UInt32; /UInt64; /UInt;
    /Float32; /Float64; /numeric; /memory; builtin) : @(import("../builtin.zy")) in
  param val (/Uninit; /Init; /Ptr; types) : (@(import("types.type.zy"))) Addr in
  param val (/DynamicStorage; /runtime; storage_api) : @(import("storage.type.zy")) in
  let int = numeric/int in
  let (/Codec; /DynamicCodec; codecs) = (builtin |> (@(import("codecs.zy")))) types in
  let Representation = (@(import("representation.type.zy"))) DynamicStorage DynamicCodec in
  let Layout (A : VType) = Thk (forall (R : CType) . Thk R -> Thk (Representation A -> R) -> R) in
  let size = builtin |> (@(import("dynamic-size.zy"))) in
  let ! make (A : VType) (R : CType) (count : Int) (alignment : Int)
    (codec : DynamicCodec Unit A) (no : Thk R) (yes : Thk (Representation A -> R))
  : R =
      do checked <- ! runtime/unsafe/for_layout Unit count alignment;
      match checked
      | +Err(_) => ! no
      | +Ok(storage) => ! yes ((#L = Unit, = storage, = codec) : Representation A)
      end
  in
  let val scalar (A : VType) (count : Int)
    (write : Thk (forall (R : CType) . Addr -> A -> Thk R -> R))
    (read : Thk (forall (R : CType) . Addr -> Thk (A -> R) -> R))
  : Layout A =
      {
        fn R no yes =>
          ! make A R count count
            (codecs/materialize Unit A (codecs/unsafe/scalar Unit A write read)) no yes
      }
  in
  let val padding (count : Int) : Layout Unit = {
    fn R no yes =>
      ! make Unit R count 1 (codecs/materialize Unit Unit (codecs/unsafe/padding Unit)) no yes
  } in
  let val product (A : VType) (B : VType) (left : Layout A) (right : Layout B) : Layout (A * B) = {
    fn R no yes =>
      ! left R no {
        fn (#L = Left, left) =>
          ! right R no {
            fn (#L = Right, right) =>
              let lg = runtime/query Left left/storage in
              let rg = runtime/query Right right/storage in
              do placement <- ! size/round_up lg/size rg/alignment;
              match placement
              | +Err(_) => ! no
              | +Ok(offset) =>
                do ending <- ! size/add offset rg/size;
                match ending
                | +Err(_) => ! no
                | +Ok(ending) =>
                  do alignment <- ! int/gt (Ret Int) lg/alignment rg/alignment
                    { ret lg/alignment } { ret rg/alignment };
                  do extent <- ! size/round_up ending alignment;
                  match extent
                  | +Err(_) => ! no
                  | +Ok(count) => ! make (A * B) R count alignment
                    (
                      codecs/unsafe/dynamic_product_at Unit Left Right A B left/codec right/codec 0
                        offset
                    ) no yes
                  end
                end
              end
          }
      }
  } in
  let val align (A : VType) (boundary : Int) (layout : Layout A) : Layout A = {
    fn R no yes =>
      do checked <- ! size/alignment boundary;
      match checked
      | +Err(_) => ! no
      | +Ok(boundary) =>
        ! layout R no {
          fn (#L = Old, layout) =>
            let geometry = runtime/query Old layout/storage in
            do alignment <- ! int/gt (Ret Int) boundary geometry/alignment
              { ret boundary } { ret geometry/alignment };
            do extent <- ! size/round_up geometry/size alignment;
            match extent
            | +Err(_) => ! no
            | +Ok(count) => ! make A R count alignment
              (codecs/unsafe/dynamic_relabel Unit Old A layout/codec) no yes
            end
        }
      end
  } in
  let ! realize (A : VType) (R : CType) (layout : Layout A)
    (no : Thk R) (yes : Thk (Representation A -> R))
  : R = ! layout R no yes in
  (
    (
      = Layout,
      = Representation,
      (#unit = padding 0, = padding, = product, = align, = realize,
        #int8 = scalar Int8 1 numeric/int8/store_le numeric/int8/load_le,
        #int16 = scalar Int16 2 numeric/int16/store_le numeric/int16/load_le,
        #int32 = scalar Int32 4 numeric/int32/store_le numeric/int32/load_le,
        #int64 = scalar Int64 8 numeric/int64/store_le numeric/int64/load_le,
        #int = scalar Int 8 numeric/int/store_le numeric/int/load_le,
        #uint8 = scalar UInt8 1 numeric/uint8/store_le numeric/uint8/load_le,
        #uint16 = scalar UInt16 2 numeric/uint16/store_le numeric/uint16/load_le,
        #uint32 = scalar UInt32 4 numeric/uint32/store_le numeric/uint32/load_le,
        #uint64 = scalar UInt64 8 numeric/uint64/store_le numeric/uint64/load_le,
        #uint = scalar UInt 8 numeric/uint/store_le numeric/uint/load_le,
        #float32 = scalar Float32 4 numeric/float32/store_le numeric/float32/load_le,
        #float64 = scalar Float64 8 numeric/float64/store_le numeric/float64/load_le,
        #addr = scalar Addr 8 memory/store_addr memory/load_addr
      )
    ) : (@(import("dynamic-layout.type.zy"))) Addr DynamicStorage DynamicCodec
  )
end
