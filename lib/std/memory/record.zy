-- replace requires the same projected child after its state transition; aliases remain manual.
begin
  param val (/VType; /CType; /Thk; /Ret; /Unit; /Addr; /Int; /memory; builtin) : @(import(
    "../builtin.zy"
  )) in
  param val (/Uninit; /Init; /Fields; /Ptr; /unsafe; types) : (@(import("types.type.zy"))) Addr in
  param val Field : VType -> VType -> VType in
  param val DynamicField : VType -> VType -> VType in
  param val (/constant = /unsafe = field_unsafe) : (@(import("field-operations.type.zy"))) Uninit
    Init Ptr Field DynamicField in
  param val (/Storage; /constant) : @(import("storage.type.zy")) in
  let Codec = (@(import("codec.type.zy"))) Uninit Init Ptr in
  let Result = @(import("../data/result.zy")) in
  let Error = @(import("layout-error.zy")) in
  let size = @(import("size.zy")) in
  let compare = @(intrinsic(int_compare)) in
  let bits = @(intrinsic(int_and)) in
  let sub = @(intrinsic(int_sub)) in
  let Record (Left : VType) (Right : VType) =
    exists (= L : VType) .
        (#storage :: Storage L)
      * (
          #states ::
            (#empty :: val pi (pointer : Ptr L Uninit) . Ptr L (Fields Uninit Uninit))
          * (#full :: val pi (pointer : Ptr L Init) . Ptr L (Fields Init Init))
          * (#finish :: val pi (pointer : Ptr L (Fields Init Init)) . Ptr L Init)
          * (#vacate :: val pi (pointer : Ptr L (Fields Uninit Uninit)) . Ptr L Uninit)
        )
      * (
          #left :: (#path :: Field L Left) * (
            #unsafe ::
              (
                #project :: val pi (T : VType) (S : VType) (pointer : Ptr L (Fields T S)) .
                  Thk (Ret (Ptr Left T))
              )
            * (
                #replace :: val pi (T : VType) (S : VType) (U : VType)
                  (pointer : Ptr L (Fields T S)) (child : Ptr Left U)
                .
                  Ptr L (Fields U S)
              )
            * (
                #init :: val pi (A : VType) (codec : Codec Left A) (S : VType)
                  (pointer : Ptr L (Fields Uninit S)) (value : A)
                .
                  Thk (forall (R : CType) . Thk (Ptr L (Fields Init S) -> R) -> R)
              )
            * (
                #read :: val pi (A : VType) (codec : Codec Left A) (S : VType)
                  (pointer : Ptr L (Fields Init S))
                .
                  Thk (forall (R : CType) . Thk (A -> R) -> R)
              )
            * (
                #take :: val pi (A : VType) (codec : Codec Left A) (S : VType)
                  (pointer : Ptr L (Fields Init S))
                .
                  Thk (forall (R : CType) . Thk (Ptr L (Fields Uninit S) -> A -> R) -> R)
              )
          )
        )
      * (
          #right :: (#path :: Field L Right) * (
            #unsafe ::
              (
                #project :: val pi (T : VType) (S : VType) (pointer : Ptr L (Fields S T)) .
                  Thk (Ret (Ptr Right T))
              )
            * (
                #replace :: val pi (T : VType) (S : VType) (U : VType)
                  (pointer : Ptr L (Fields S T)) (child : Ptr Right U)
                .
                  Ptr L (Fields S U)
              )
            * (
                #init :: val pi (A : VType) (codec : Codec Right A) (S : VType)
                  (pointer : Ptr L (Fields S Uninit)) (value : A)
                .
                  Thk (forall (R : CType) . Thk (Ptr L (Fields S Init) -> R) -> R)
              )
            * (
                #read :: val pi (A : VType) (codec : Codec Right A) (S : VType)
                  (pointer : Ptr L (Fields S Init))
                .
                  Thk (forall (R : CType) . Thk (A -> R) -> R)
              )
            * (
                #take :: val pi (A : VType) (codec : Codec Right A) (S : VType)
                  (pointer : Ptr L (Fields S Init))
                .
                  Thk (forall (R : CType) . Thk (Ptr L (Fields S Uninit) -> A -> R) -> R)
              )
          )
        )
  in
  let val make (Left : VType) (Right : VType) (left_offset : Int) (right_offset : Int)
    (storage : Storage Unit)
  : Record Left Right
  =
    let L = Unit in
    (
      (
        = L,
        = storage,
        #states = (
          #empty = val pointer =>
            unsafe/from_address L (Fields Uninit Uninit) (unsafe/address L Uninit pointer),
          #full = val pointer =>
            unsafe/from_address L (Fields Init Init) (unsafe/address L Init pointer),
          #finish = val pointer =>
            unsafe/from_address L Init (unsafe/address L (Fields Init Init) pointer),
          #vacate = val pointer =>
            unsafe/from_address L Uninit (unsafe/address L (Fields Uninit Uninit) pointer)
        ),
        #left = (
          #path = field_unsafe/from_offset L Left left_offset,
          #unsafe = (
            #project = val T S pointer =>
              {
                do address <- ! memory/offset (unsafe/address L (Fields T S) pointer) left_offset;
                ret (unsafe/from_address Left T address)
              },
            #replace = val T S U pointer child =>
              unsafe/from_address L (Fields U S) (unsafe/address L (Fields T S) pointer),
            #init = val A codec S pointer value =>
              {
                fn R yes =>
                  let base = unsafe/address L (Fields Uninit S) pointer in
                  do address <- ! memory/offset base left_offset;
                  ! (codec/init (unsafe/from_address Left Uninit address) value) R {
                    fn _ => ! yes (unsafe/from_address L (Fields Init S) base) }
              },
            #read = val A codec S pointer =>
              {
                fn R yes =>
                  do address <- ! memory/offset (unsafe/address L (Fields Init S) pointer)
                    left_offset;
                  ! (codec/read (unsafe/from_address Left Init address)) R yes
              },
            #take = val A codec S pointer =>
              {
                fn R yes =>
                  let base = unsafe/address L (Fields Init S) pointer in
                  do address <- ! memory/offset base left_offset;
                  ! (codec/read (unsafe/from_address Left Init address)) R {
                    fn value => ! yes (unsafe/from_address L (Fields Uninit S) base) value }
              }
          )
        ),
        #right = (
          #path = field_unsafe/from_offset L Right right_offset,
          #unsafe = (
            #project = val T S pointer =>
              {
                do address <- ! memory/offset (unsafe/address L (Fields S T) pointer) right_offset;
                ret (unsafe/from_address Right T address)
              },
            #replace = val T S U pointer child =>
              unsafe/from_address L (Fields S U) (unsafe/address L (Fields S T) pointer),
            #init = val A codec S pointer value =>
              {
                fn R yes =>
                  let base = unsafe/address L (Fields S Uninit) pointer in
                  do address <- ! memory/offset base right_offset;
                  ! (codec/init (unsafe/from_address Right Uninit address) value) R {
                    fn _ => ! yes (unsafe/from_address L (Fields S Init) base) }
              },
            #read = val A codec S pointer =>
              {
                fn R yes =>
                  do address <- ! memory/offset (unsafe/address L (Fields S Init) pointer)
                    right_offset;
                  ! (codec/read (unsafe/from_address Right Init address)) R yes
              },
            #take = val A codec S pointer =>
              {
                fn R yes =>
                  let base = unsafe/address L (Fields S Init) pointer in
                  do address <- ! memory/offset base right_offset;
                  ! (codec/read (unsafe/from_address Right Init address)) R {
                    fn value => ! yes (unsafe/from_address L (Fields S Uninit) base) value }
              }
          )
        )
      ) : Record Left Right
    )
  in
  let val at (Left : VType) (Right : VType)
    (left : Storage Left) (right : Storage Right)
    (left_offset : Int) (right_offset : Int) (count : Int) (alignment : Int)
  : Result (Record Left Right) Error =
      let Out = Record Left Right in
      let lg = constant/query Left left in
      let rg = constant/query Right right in
      size/bind Int Out (size/alignment alignment) (
        val alignment =>
          size/bind Int Out (size/alignment lg/alignment) (
            val la =>
              size/bind Int Out (size/alignment rg/alignment) (
                val ra =>
                  size/bind Int Out (size/add left_offset lg/size) (
                    val le =>
                      size/bind Int Out (size/add right_offset rg/size) (
                        val re =>
                          size/bind Int Out (size/size count) (
                            val count =>
                              let val valid () : Result Out Error =
                                size/bind (Storage Unit) Out (
                                  constant/unsafe/for_layout Unit count alignment
                                )
                                  (
                                    val storage =>
                                      +Ok(make Left Right left_offset right_offset storage)
                                  )
                              in
                              let val disjoint () : Result Out Error =
                                match compare le right_offset
                                | 1 =>
                                  match compare re left_offset
                                  | 1 =>
                                    match (compare lg/size 0, compare rg/size 0)
                                    | (0, _) => valid ()
                                    | (_, 0) => valid ()
                                    | _ => +Err(+OverlappingFields())
                                    end
                                  | _ => valid ()
                                  end
                                | _ => valid ()
                                end
                              in
                              match (
                                compare alignment la,
                                compare alignment ra,
                                bits left_offset (sub la 1),
                                bits right_offset (sub ra 1),
                                bits count (sub alignment 1)
                              )
                              | (-1, _, _, _, _) => +Err(+MisalignedField())
                              | (_, -1, _, _, _) => +Err(+MisalignedField())
                              | (_, _, 0, 0, 0) =>
                                match (compare count le, compare count re)
                                | (-1, _) => +Err(+InvalidExtent())
                                | (_, -1) => +Err(+InvalidExtent())
                                | _ => disjoint ()
                                end
                              | _ => +Err(+MisalignedField())
                              end
                          )
                      )
                  )
              )
          )
      )
  in
  let val product (Left : VType) (Right : VType)
    (left : Storage Left) (right : Storage Right)
  : Result (Record Left Right) Error =
      let Out = Record Left Right in
      let lg = constant/query Left left in
      let rg = constant/query Right right in
      size/bind Int Out (size/round_up lg/size rg/alignment) (
        val offset =>
          size/bind Int Out (size/add offset rg/size) (
            val field_end =>
              let alignment = size/maximum lg/alignment rg/alignment in
              size/bind Int Out (size/round_up field_end alignment) (
                val count =>
                  at Left Right left right 0 offset count alignment
              )
          )
      )
  in
  pack (= Record as Record : VType -> VType -> VType)
  where
    (= at, = product) end
end
