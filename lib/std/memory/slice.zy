-- A slice carries only a typed pointer and a runtime element count.
-- The caller guarantees allocation extent, element stride, state, and alias validity.
begin
  param val (/VType; /CType; /Thk; /Ret; /Addr; /Int64; /numeric; /memory; builtin) : @(import(
    "../builtin.zy"
  )) that
  param val (/Uninit; /Init; /Ptr; /unsafe; types) : (@(import("types.type.zy"))) Addr in
  let Fault = @(import("fault.zy")) in
  let int = numeric/int64 in
  let Slice (L : VType) (S : VType) = Ptr L S * Int64 in
  let val length (L : VType) (S : VType) ((_, count) : Slice L S) : Int64 = count in
  let from_parts : Thk (
    forall (L : VType) (S : VType) (R : CType) .
      Ptr L S -> Int64 -> Thk (Fault -> R) -> Thk (Slice L S -> R) -> R
  ) = {
    fn L S R pointer count no yes =>
      ! int/lt R count 0 { ! no +Bounds() } { ! yes (pointer, count) }
  } in
  let Operations = (@(import("operations.type.zy"))) Addr Uninit Init Ptr in
  let (/Cps; /View; /fat; /as_cps; /counted) =
    (builtin |> (@(import("view.zy")))) types
  in
  let val for_layout (L : VType) (A : VType) (layout : Operations L A) =
    let at : Thk (
      forall (S : VType) (R : CType) .
        Slice L S -> Int64 -> Thk (Fault -> R) -> Thk (Ptr L S -> R) -> R
    ) = {
      fn S R slice index no yes =>
        let view = as_cps (Ptr L S * Int64) (Ptr L S * Int64) (fat L S Int64) in
        ! (counted L A S (Ptr L S * Int64) layout view (slice, index)) R no yes
    } in
    (#unsafe = = at)
  in
  pack (= Slice : VType -> VType -> VType) is Slice
  where
    (= length, = for_layout, #unsafe = = from_parts) end
end
