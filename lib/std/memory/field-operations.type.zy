begin
  let VType = @(intrinsic(vtype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let Int64 = @(intrinsic(i64)) in
  param Uninit : VType in
  param Init : VType in
  param Ptr : VType -> VType -> VType in
  param Field : VType -> VType -> VType in
  param DynamicField : VType -> VType -> VType in
    (
      #constant ::
        (#offset :: val pi (P : VType) (C : VType) (field : Field P C) . Int64)
      * (
          #compose :: val pi (P : VType) (C : VType) (D : VType)
            (outer : Field P C) (inner : Field C D)
          .
            Field P D
        )
      * (
          #initialized :: val pi (P : VType) (C : VType) (field : Field P C)
            (pointer : Ptr P Init)
          .
            Thk (Ret (Ptr C Init))
        )
      * (
          #uninitialized :: val pi (P : VType) (C : VType) (field : Field P C)
            (pointer : Ptr P Uninit)
          .
            Thk (Ret (Ptr C Uninit))
        )
      * (#unsafe :: #from_offset :: val pi (P : VType) (C : VType) (offset : Int64) . Field P C)
      * (#materialize :: val pi (P : VType) (C : VType) (field : Field P C) . DynamicField P C)
    )
  * (
      #runtime ::
        (#offset :: Thk (forall (P : VType) (C : VType) . DynamicField P C -> Ret Int64))
      * (
          #compose :: Thk (
            forall (P : VType) (C : VType) (D : VType) .
              DynamicField P C -> DynamicField C D -> Ret (DynamicField P D)
          )
        )
      * (
          #initialized :: Thk (
            forall (P : VType) (C : VType) .
              DynamicField P C -> Ptr P Init -> Ret (Ptr C Init)
          )
        )
      * (
          #uninitialized :: Thk (
            forall (P : VType) (C : VType) .
              DynamicField P C -> Ptr P Uninit -> Ret (Ptr C Uninit)
          )
        )
      * (
          #unsafe :: (
            #from_offset :: Thk (forall (P : VType) (C : VType) . Int64 -> Ret (DynamicField P C))
          )
        )
    )

end
