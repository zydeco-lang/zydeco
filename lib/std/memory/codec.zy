-- Direct destination recipes. No intermediate Bytes, allocation, or padding reads.
begin
  param val (/VType; /CType; /Thk; /Ret; /Unit; /Addr; /Int64; /memory; builtin) : @(import(
    "../builtin.zy"
  )) that
  param val (/Uninit; /Init; /Ptr; /unsafe; types) : (@(import("types.type.zy"))) Addr in
  let Descriptor = (@(import("descriptor.type.zy"))) Addr in
  let Representation = (@(import("representation.type.zy"))) Addr Uninit Init Ptr in
  let Operations = (@(import("operations.type.zy"))) Addr Uninit Init Ptr in
  let Alloc = (@(import("allocator.type.zy"))) Addr in
  let Fault = @(import("fault.zy")) in
  let val scalar (A : VType) (size : Int64) (alignment : Int64)
    (write : Thk (forall (R : CType) . Addr -> A -> Thk R -> R))
    (read : Thk (forall (R : CType) . Addr -> Thk (A -> R) -> R))
  : Descriptor A =
      (
        = size,
        = alignment,
        #write = { fn R value address done => ! write R address value done },
        = read
      )
  in
  let val padding (count : Int64) : Descriptor Unit =
    (
      #size = count,
      #alignment = 1,
      #write = { fn R _ _ done => ! done },
      #read = { fn R _ yes => ! yes () }
    )
  in
  let val product (A : VType) (B : VType) (left : Descriptor A) (right : Descriptor B)
    (offset : Int64) (size : Int64) (alignment : Int64)
  : Descriptor (A * B) =
      (
        = size,
        = alignment,
        #write = {
          fn R (a, b) address done =>
            ! left/write R a address {
              do target <- ! memory/offset address offset;
              ! right/write R b target done
            }
        },
        #read = {
          fn R address yes =>
            ! left/read R address {
              fn a =>
                do target <- ! memory/offset address offset;
                ! right/read R target { fn b => ! yes (a, b) }
            }
        }
      )
  in
  let val align (A : VType) (layout : Descriptor A) (size : Int64) (alignment : Int64) : Descriptor
    A =
    (= size, = alignment, #write = layout/write, #read = layout/read)
  in
  let val operations (L : VType) (A : VType) (layout : Descriptor A) : Operations L A =
    (
      (
        #size = layout/size,
        #alignment = layout/alignment,
        #allocate = {
          fn R allocator no yes =>
            ! allocator/allocate R layout/size layout/alignment no {
              fn address =>
                ! yes (unsafe/from_address L Uninit address)
            }
        },
        #unsafe = (
          #init = {
            fn R pointer value yes =>
              let address = unsafe/address L Uninit pointer in
              ! layout/write R value address { ! yes (unsafe/from_address L Init address) }
          },
          #read = { fn R pointer yes => ! layout/read R (unsafe/address L Init pointer) yes },
          #take = {
            fn R pointer yes =>
              let address = unsafe/address L Init pointer in
              ! layout/read R address {
                fn value => ! yes (unsafe/from_address L Uninit address) value
              }
          },
          #free = {
            fn R allocator pointer no done =>
              ! allocator/free R (unsafe/address L Uninit pointer) layout/size layout/alignment
                no done
          }
        )
      ) : Operations L A
    )
  in
  let val realize (A : VType) (layout : Descriptor A) : Representation A =
    ((#L = Unit, operations Unit A layout) : Representation A)
  in
  (= scalar, = padding, = product, = align, = operations, = realize)
end
