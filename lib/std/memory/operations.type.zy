begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Int64 = @(intrinsic(i64)) in
  let Fault = @(import("fault.zy")) in
  param Addr : VType in
  param Uninit : VType in
  param Init : VType in
  param Ptr : VType -> VType -> VType in
  let Alloc = (@(import("allocator.type.zy"))) Addr in
  fn (L : VType) (A : VType) =>
      (#size :: Int64) * (#alignment :: Int64)
    * (
        #allocate :: Thk (
          forall (R : CType) . Alloc -> Thk (Fault -> R) -> Thk (Ptr L Uninit -> R) -> R
        )
      )
    * (
        #unsafe ::
          (#init :: Thk (forall (R : CType) . Ptr L Uninit -> A -> Thk (Ptr L Init -> R) -> R))
        * (#read :: Thk (forall (R : CType) . Ptr L Init -> Thk (A -> R) -> R))
        * (#take :: Thk (forall (R : CType) . Ptr L Init -> Thk (Ptr L Uninit -> A -> R) -> R))
        * (
            #free :: Thk (
              forall (R : CType) . Alloc -> Ptr L Uninit -> Thk (Fault -> R) -> Thk R -> R
            )
          )
      )
end
