-- Internal layout recipes. Fixed builders eliminate their placement; dynamic layouts retain it.
begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Int = @(intrinsic(int)) in
  param Addr : VType in
  fn (A : VType) =>
      (#size :: Int) * (#alignment :: Int)
    * (#write :: Thk (forall (R : CType) . A -> Addr -> Thk R -> R))
    * (#read :: Thk (forall (R : CType) . Addr -> Thk (A -> R) -> R))
end
