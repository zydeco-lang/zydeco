begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let Bytes = @(intrinsic(bytes)) in
  let Int64 = @(intrinsic(i64)) in
  fn (A : VType) =>
      (#size :: Int64) * (#alignment :: Int64)
    * (#write :: Thk (A -> Ret Bytes))
    * (#read :: Thk (forall (R : CType) . Bytes -> Thk R -> Thk (A -> R) -> R))
end
