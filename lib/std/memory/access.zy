-- Storage access bridges immutable representation contracts and mutable destinations.
begin
  param val (/Addr; /Access; /VType; /CType; /Thk; /Ret; /OS; /Int64; /Buffer; builtin) : @(import(
    "../builtin.zy"
  )) that
  param val (/Bytes; /bytes; byte_package) : (@(import("../text/bytes.type.zy"))) Addr Access that
  let buffer = (builtin |> (@(import("buffer.zy")))) byte_package in
  let Representation = (@(import("representation.type.zy"))) Bytes in
  let ! read_at (A : VType) (R : CType)
    (representation : Representation A)
    (source : Bytes) (offset : Int64) (no : Thk R) (yes : Thk (A -> R))
  : R =
      let (= Stored, repr) = representation in
      ! bytes/slice R source offset repr/size no {
        fn window =>
          ! repr/from_bytes R window no { fn stored => ! repr/load R stored no yes }
      }
  in
  let ! write_to (A : VType) (representation : Representation A)
    (destination : Buffer) (offset : Int64) (value : A)
    (error : Thk (Int64 -> OS)) (done : Thk OS)
  : OS =
      let (= Stored, repr) = representation in
      ! repr/store OS value { ! error 3 } {
        fn stored =>
          do encoded <- ! repr/bytes stored;
          ! buffer/write destination offset encoded error done
      }
  in
  (= read_at, = write_to)
end
