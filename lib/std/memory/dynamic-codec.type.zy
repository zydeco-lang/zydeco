begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  param Uninit : VType in
  param Init : VType in
  param Ptr : VType -> VType -> VType in
  let Cps (A : VType) = forall (R : CType) . Thk (A -> R) -> R in
  fn (L : VType) (A : VType) =>
      (#init :: Thk (Ptr L Uninit -> A -> Cps (Ptr L Init)))
    * (#read :: Thk (Ptr L Init -> Cps A))
end
