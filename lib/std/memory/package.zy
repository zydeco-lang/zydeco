begin
  param val (/VType; /CType; /Thk; /Ret; /Unit; /Bytes;
    /Int8; /Int16; /Int32; /Int64; /UInt8; /UInt16; /UInt32; /UInt64;
    /Float32; /Float64; /numeric; /bytes) : @(import("../builtin.zy")) that
  let int = numeric/int64 in
  let Representation = @(import("representation.type.zy")) in
  let Descriptor (A : VType) =
      (#size :: Int64) * (#alignment :: Int64)
    * (#write :: Thk (A -> Ret Bytes))
    * (#read :: Thk (forall (R : CType) . Bytes -> Thk R -> Thk (A -> R) -> R))
  in
  let Layout (A : VType) =
    Thk (forall (R : CType) . Thk R -> Thk (Descriptor A -> R) -> R)
  in

  -- All arithmetic here operates on nonnegative sizes and validated alignments.
  let ! add (R : CType) (left : Int64) (right : Int64)
    (no : Thk R) (yes : Thk (Int64 -> R))
  : R =
      do limit <- ! int/sub 9223372036854775807 right;
      ! int/gt R left limit no {
        do sum <- ! int/add left right;
        ! yes sum
      }
  in
  let ! round_up (R : CType) (size : Int64) (alignment : Int64)
    (no : Thk R) (yes : Thk (Int64 -> R))
  : R =
      do remainder <- ! int/mod size alignment;
      ! int/eq R remainder 0 { ! yes size } {
        do extra <- ! int/sub alignment remainder;
        ! add R size extra no yes
      }
  in
  let fix power_of_two (R : CType) (value : Int64) (no : Thk R) (yes : Thk R) : R =
    ! int/lt R value 1 no {
      ! int/eq R value 1 yes {
        do remainder <- ! int/mod value 2;
        ! int/eq R remainder 0 {
          do half <- ! int/div value 2;
          ! power_of_two R half no yes
        } no
      }
    }
  in
  -- Doubling keeps the number of returning computations logarithmic in the size.
  let fix zeros (count : Int64) : Ret Bytes =
    ! int/eq (Ret Bytes) count 0 bytes/empty {
      ! int/eq (Ret Bytes) count 1 { ! bytes/singleton (0 : UInt8) } {
        do half <- ! int/div count 2;
        do prefix <- ! zeros half;
        do doubled <- ! bytes/append prefix prefix;
        do remainder <- ! int/mod count 2;
        ! int/eq (Ret Bytes) remainder 0 { ret doubled } {
          do last <- ! bytes/singleton (0 : UInt8);
          ! bytes/append doubled last
        }
      }
    }
  in
  let ! extend (buffer : Bytes) (count : Int64) : Ret Bytes =
    do padding <- ! zeros count;
    ! bytes/append buffer padding
  in
  let val scalar (A : VType) (size : Int64)
    (write : Thk (A -> Ret Bytes))
    (read : Thk (forall (R : CType) . Bytes -> Thk R -> Thk (A -> R) -> R))
  : Layout A = { fn R _ yes => ! yes (= size, #alignment = size, = write, = read) } in
  let val padding (count : Int64) : Layout Unit = {
    fn R no yes =>
      ! int/lt R count 0 no {
        ! yes (#size = count, #alignment = 1,
          #write = { fn _ => ! zeros count },
          #read = { fn R _ _ yes => ! yes () })
      }
  } in
  let val product (A : VType) (B : VType) (left : Layout A) (right : Layout B) :
    Layout (A * B) = {
      fn R no yes =>
        ! left R no {
          fn left =>
            ! right R no {
              fn right =>
                ! round_up R left/size right/alignment no {
                  fn offset =>
                    ! add R offset right/size no {
                      fn field_end =>
                        do alignment <- ! int/gt (Ret Int64) left/alignment right/alignment
                          { ret left/alignment } { ret right/alignment };
                        ! round_up R field_end alignment no {
                          fn size =>
                            do gap <- ! int/sub offset left/size;
                            do tail <- ! int/sub size field_end;
                            ! yes (
                              = size,
                              = alignment,
                              #write = {
                                fn (a, b) =>
                                  do first <- ! left/write a;
                                  do prefix <- ! extend first gap;
                                  do second <- ! right/write b;
                                  do body <- ! bytes/append prefix second;
                                  ! extend body tail
                              },
                              #read = {
                                fn R buffer no yes =>
                                  ! bytes/slice R buffer 0 left/size no {
                                    fn first =>
                                      ! bytes/slice R buffer offset right/size no {
                                        fn second =>
                                          ! left/read R first no {
                                            fn a =>
                                              ! right/read R second no { fn b => ! yes (a, b) }
                                          }
                                      }
                                  }
                              }
                            )
                        }
                    }
                }
            }
        }
    }
  in
  let val align (A : VType) (boundary : Int64) (layout : Layout A) : Layout A = {
    fn R no yes =>
      ! power_of_two R boundary no {
        ! layout R no {
          fn layout =>
            do alignment <- ! int/gt (Ret Int64) boundary layout/alignment
              { ret boundary } { ret layout/alignment };
            ! round_up R layout/size alignment no {
              fn size =>
                do tail <- ! int/sub size layout/size;
                ! yes (
                  = size,
                  = alignment,
                  #write = {
                    fn value =>
                      do body <- ! layout/write value;
                      ! extend body tail
                  },
                  #read = {
                    fn R buffer no yes =>
                      ! bytes/slice R buffer 0 layout/size no {
                        fn body => ! layout/read R body no yes
                      }
                  }
                )
            }
        }
      }
  } in
  let ! realize (A : VType) (R : CType) (layout : Layout A)
    (no : Thk R) (yes : Thk (Representation A -> R))
  : R
  = ! layout R no {
    fn layout =>
      ! yes (
        (
          #Stored = Bytes,
          (
            #size = layout/size,
            #alignment = layout/alignment,
            #store = {
              fn R value no yes =>
                do buffer <- ! layout/write value;
                ! bytes/aligned R buffer layout/alignment no yes
            },
            #load = layout/read,
            #bytes = { fn buffer => ret buffer },
            #from_bytes = {
              fn R buffer no yes =>
                do length <- ! bytes/length buffer;
                ! int/eq R length layout/size {
                  ! layout/read R buffer no {
                    fn value =>
                      -- Re-encoding checks canonical padding without retaining the logical value.
                      do canonical <- ! layout/write value;
                      ! bytes/eq R buffer canonical {
                        ! bytes/aligned R buffer layout/alignment no yes
                      } no
                  }
                } no
            }
          )
        ) : Representation A
      )
  } in
  (
    (
      = Layout,
      = Representation,
      (
        #unit = padding 0, = padding, = product, = align, = realize,
        #int8 = scalar Int8 1 numeric/int8/to_le_bytes numeric/int8/from_le_bytes,
        #int16 = scalar Int16 2 numeric/int16/to_le_bytes numeric/int16/from_le_bytes,
        #int32 = scalar Int32 4 numeric/int32/to_le_bytes numeric/int32/from_le_bytes,
        #int64 = scalar Int64 8 numeric/int64/to_le_bytes numeric/int64/from_le_bytes,
        #uint8 = scalar UInt8 1 numeric/uint8/to_le_bytes numeric/uint8/from_le_bytes,
        #uint16 = scalar UInt16 2 numeric/uint16/to_le_bytes numeric/uint16/from_le_bytes,
        #uint32 = scalar UInt32 4 numeric/uint32/to_le_bytes numeric/uint32/from_le_bytes,
        #uint64 = scalar UInt64 8 numeric/uint64/to_le_bytes numeric/uint64/from_le_bytes,
        #float32 = scalar Float32 4 numeric/float32/to_le_bytes numeric/float32/from_le_bytes,
        #float64 = scalar Float64 8 numeric/float64/to_le_bytes numeric/float64/from_le_bytes
      )
    ) : @(import("package.type.zy"))
  )
end
