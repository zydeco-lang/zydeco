@[package(library, name(std/memory))]
begin
  param val (/Addr; builtin) : @(import("../builtin/memory.zy")) that
  let (/Uninit; /Init; /Fields; /Ptr; /unsafe) = (@(import("types.zy"))) Addr in
  let (
    /Storage;
    /DynamicStorage;
    /SizeAlign;
    /constant = storage_constant;
    /runtime = storage_runtime
  )
  =
    @(import("storage.zy"))
  in
  let (/Codec; /DynamicCodec; /materialize = materialize_codec; /unsafe = codec_unsafe) =
    builtin |> (@(import("codecs.zy")))
  in
  let (= Field, = DynamicField, field_ops) = builtin |> (@(import("field.zy"))) in
  let fields = field_ops/constant in
  let runtime_fields = field_ops/runtime in
  let headers = builtin |> (@(import("header.zy"))) in
  let records = builtin |> (@(import("record.zy"))) in
  let product_codec = builtin |> (@(import("product-codec.zy"))) in
  let arrays = builtin |> (@(import("array.zy"))) in
  let views = builtin |> (@(import("view.zy"))) in
  let fixed = builtin |> (@(import("layout.zy"))) in
  let dynamic = builtin |> (@(import("dynamic-layout.zy"))) in
  let allocation = builtin |> (@(import("allocation.zy"))) in
  let (= Slice, slices) = builtin |> (@(import("slice.zy"))) in
  let raw = builtin |> (@(import("native.zy"))) in
  pack
    (= Uninit as Uninit)
    (= Init as Init)
    (= Field as Field)
    (= DynamicField as DynamicField)
    (= Fields as Fields)
    (= Ptr as Ptr)
    (= Slice as Slice)
    (= Storage as Storage)
    (= DynamicStorage as DynamicStorage)
    (= SizeAlign as SizeAlign)
    (= Codec as Codec)
    (= DynamicCodec as DynamicCodec)
  where
    (
      = slices,
      #storage = (#constant = storage_constant, #runtime = storage_runtime),
      #codecs = (
        #materialize = materialize_codec,
        #product = product_codec,
        #unsafe = codec_unsafe
      ),
      = fields,
      = runtime_fields,
      = records,
      = headers,
      = arrays,
      = views,
      = fixed,
      = dynamic,
      = allocation,
      #pointer = = unsafe,
      = raw
    )
  end
end
