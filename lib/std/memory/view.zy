-- Fixed recipes specialize before execution; dynamic views retain an explicit thunk.
begin
  param val (/VType; /CType; /Thk; /Ret; /Unit; /Addr; /Int; /numeric; /memory; builtin) : @(import(
    "../builtin.zy"
  )) that
  param val (/Uninit; /Init; /Ptr; /unsafe; types) : (@(import("types.type.zy"))) Addr in
  let Cps (A : VType) = forall (R : CType) . Thk (A -> R) -> R in
  let Checked (E : VType) (A : VType) = forall (R : CType) . Thk (E -> R) -> Thk (A -> R) -> R in
  let View (P : VType -> CType) (H : VType) (A : VType) = val pi (handle : H) . Thk (P A) in
  let Dynamic (P : VType -> CType) (H : VType) (A : VType) = Thk (H -> P A) in
  let Operations = (@(import("operations.type.zy"))) Addr Uninit Init Ptr in
  let val identity (A : VType) : View Ret A A = val value => { ret value } in
  let val as_cps (H : VType) (A : VType) (view : View Ret H A) : View Cps H A =
    val handle =>
      {
        fn R yes =>
          do value <- ! (view handle);
          ! yes value
      }
  in
  let val materialize (P : VType -> CType) (H : VType) (A : VType) (view : View P H A) : Dynamic P H
    A =
    { fn handle => ! (view handle) }
  in
  let val precompose (P : VType -> CType) (H : VType) (I : VType) (A : VType)
    (adapt : val pi (handle : H) . I) (view : View P I A)
  : View P H A =
      val handle => view (adapt handle)
  in
  let val compose (A : VType) (B : VType) (C : VType)
    (first : View Ret A B) (second : View Ret B C)
  : View Ret A C =
      val value =>
        {
          do middle <- ! (first value);
          ! (second middle)
        }
  in
  let val compose_cps (A : VType) (B : VType) (C : VType)
    (first : View Cps A B) (second : View Cps B C)
  : View Cps A C =
      val value => { fn R yes => ! (first value) R { fn middle => ! (second middle) R yes } }
  in
  let val map (H : VType) (A : VType) (B : VType)
    (view : View Ret H A) (transform : val pi (value : A) . B)
  : View Ret H B =
      val handle =>
        {
          do value <- ! (view handle);
          ret (transform value)
        }
  in
  let val map_cps (H : VType) (A : VType) (B : VType)
    (view : View Cps H A) (transform : val pi (value : A) . B)
  : View Cps H B =
      val handle => { fn R yes => ! (view handle) R { fn value => ! yes (transform value) } }
  in
  let val thin (L : VType) (S : VType) : View Ret (Ptr L S) (Ptr L S * Unit) =
    val pointer => { ret (pointer, ()) }
  in
  let val fat (L : VType) (S : VType) (M : VType) : View Ret (Ptr L S * M) (Ptr L S * M) =
    identity (Ptr L S * M)
  in
  let val indirect (A : VType) (next : View Cps Addr A) : View Cps Addr A =
    val slot => { fn R yes => ! memory/load_addr R slot { fn address => ! (next address) R yes } }
  in
  let Header (M : VType) (Payload : VType) =
    exists (= H : VType -> VType) .
      (
        #unsafe ::
          (#from_address :: val pi (S : VType) (address : Addr) . H S)
        * (#address :: val pi (S : VType) (handle : H S) . Addr)
        * (#open :: val pi (S : VType) . View Cps (H S) (Ptr Payload S * M))
      )
  in
  let val header (M : VType) (Metadata : VType) (Payload : VType)
    (metadata : Operations Metadata M) (metadata_offset : Int) (payload_offset : Int)
  : Header M Payload =
      let metadata_offset = (@(intrinsic(int_add))) metadata_offset 0 in
      let payload_offset = (@(intrinsic(int_add))) payload_offset 0 in
      let H (S : VType) = Addr in
      let val from_address (S : VType) (address : Addr) : H S = address in
      let val address (S : VType) (handle : H S) : Addr = handle in
      let val open (S : VType) : View Cps (H S) (Ptr Payload S * M) =
        val handle =>
          {
            fn R yes =>
              do location <- ! memory/offset handle metadata_offset;
              ! metadata/unsafe/read R (unsafe/from_address Metadata Init location) {
                fn value =>
                  do payload <- ! memory/offset handle payload_offset;
                  ! yes (unsafe/from_address Payload S payload, value)
              }
          }
      in
      ((= H, #unsafe = (= from_address, = address, = open)) : Header M Payload)
  in
  let val inline (M : VType) (Metadata : VType) (Payload : VType)
    (metadata : Operations Metadata M) (payload_offset : Int)
  : Header M Payload =
      header M Metadata Payload metadata 0 payload_offset
  in
  let val prefix (M : VType) (Metadata : VType) (Payload : VType)
    (metadata : Operations Metadata M) (metadata_offset : Int)
  : Header M Payload =
      header M Metadata Payload metadata metadata_offset 0
  in
  let dynamic_header : Thk (
    forall (M : VType) (Metadata : VType) (Payload : VType) (S : VType) .
      Operations Metadata M -> Int -> Int -> Addr -> Cps (Ptr Payload S * M)
  ) = {
    fn M Metadata Payload S metadata metadata_offset payload_offset handle R yes =>
      do location <- ! memory/offset handle metadata_offset;
      ! metadata/unsafe/read R (unsafe/from_address Metadata Init location) {
        fn value =>
          do payload <- ! memory/offset handle payload_offset;
          ! yes (unsafe/from_address Payload S payload, value)
      }
  } in
  let Fault = @(import("fault.zy")) in
  let indexed = (builtin |> (@(import("indexed.zy")))) types in
  let val as_checked (E : VType) (H : VType) (A : VType) (view : View Cps H A) : View (Checked E) H
    A =
    val handle => { fn R _ yes => ! (view handle) R yes }
  in
  let val compose_checked (E : VType) (A : VType) (B : VType) (C : VType)
    (first : View (Checked E) A B) (second : View (Checked E) B C)
  : View (Checked E) A C =
      val value =>
        { fn R no yes => ! (first value) R no { fn middle => ! (second middle) R no yes } }
  in
  let val map_checked (E : VType) (H : VType) (A : VType) (B : VType)
    (view : View (Checked E) H A) (transform : val pi (value : A) . B)
  : View (Checked E) H B =
      val handle => { fn R no yes => ! (view handle) R no { fn value => ! yes (transform value) } }
  in
  let val bounded (L : VType) (S : VType) (H : VType) (capacity : Int)
    (view : View Cps H (Ptr L S * Int))
  : View (Checked Fault) H (Ptr L S * Int) =
      val handle =>
        {
          fn R no yes =>
            ! numeric/int/lt R capacity 0 { ! no +InvalidLayout() } {
              ! (view handle) R {
                fn (pointer, count) =>
                  ! numeric/int/lt R count 0 { ! no +Bounds() } {
                    ! numeric/int/gt R count capacity { ! no +Bounds() } {
                      ! yes (pointer, count)
                    }
                  }
              }
            }
        }
  in
  let val counted_checked (L : VType) (A : VType) (S : VType) (H : VType)
    (layout : Operations L A) (view : View (Checked Fault) H (Ptr L S * Int))
  : View (Checked Fault) (H * Int) (Ptr L S) =
      val input =>
        {
          fn R no yes =>
            let (handle, index) = input in
            ! (view handle) R no {
              fn (pointer, count) =>
                ! indexed/at L S R layout/size pointer count index no yes
            }
        }
  in
  let val counted (L : VType) (A : VType) (S : VType) (H : VType)
    (layout : Operations L A) (view : View Cps H (Ptr L S * Int))
  : View (Checked Fault) (H * Int) (Ptr L S) =
      counted_checked L A S H layout (as_checked Fault H (Ptr L S * Int) view)
  in
  pack (= Header as Header : VType -> VType -> VType)
      (= Cps as Cps : VType -> CType)
      (= Checked as Checked : VType -> VType -> CType)
      (= View as View : (VType -> CType) -> VType -> VType -> VType)
      (= DynamicView as Dynamic : (VType -> CType) -> VType -> VType -> VType)
  where
    (
      = identity,
      = as_cps,
      = materialize,
      = precompose,
      = compose,
      = compose_cps,
      = map,
      = map_cps,
      = thin,
      = fat,
      = counted,
      = as_checked,
      = compose_checked,
      = map_checked,
      = counted_checked,
      = bounded,
      #unsafe = (= header, = inline, = prefix, = indirect, = dynamic_header)
    )
  end
end
