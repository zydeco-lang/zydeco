-- Pure checked arithmetic for runtime geometry; every public operand is validated.
let (/Either) = @(import("../data/either.zy")) in
let (/Error) = @(import("layout-error.zy")) in
begin
  param val (/numeric; builtin) : @(import("../builtin.zy")) in

  let Checked = Either Error Int in
  let int = numeric/int in
  let ! size (value : Int) : Ret Checked =
    ! int/lt (Ret Checked) value 0 { ret +Left(+NegativeSize()) } { ret +Right(value) }
  in
  let fix power_of_two (value : Int) : Ret Checked =
    ! int/lt (Ret Checked) value 1 { ret +Left(+InvalidAlignment()) } {
      ! int/eq (Ret Checked) value 1 { ret +Right(value) } {
        do remainder <- ! int/mod value 2;
        ! int/eq (Ret Checked) remainder 0 {
          do half <- ! int/div value 2;
          do checked <- ! power_of_two half;
          match checked
          | +Left(error) => ret +Left(error)
          | +Right(_) => ret +Right(value)
          end
        } { ret +Left(+InvalidAlignment()) }
      }
    }
  in
  let ! add (left : Int) (right : Int) : Ret Checked =
    do left <- ! size left;
    do right <- ! size right;
    match (left, right)
    | (+Left(error), _) => ret +Left(error)
    | (_, +Left(error)) => ret +Left(error)
    | (+Right(left), +Right(right)) =>
      do limit <- ! int/sub 4611686018427387903 right;
      ! int/gt (Ret Checked) left limit { ret +Left(+SizeOverflow()) } {
        do value <- ! int/add left right;
        ret +Right(value)
      }
    end
  in
  let ! multiply (left : Int) (right : Int) : Ret Checked =
    do left <- ! size left;
    do right <- ! size right;
    match (left, right)
    | (+Left(error), _) => ret +Left(error)
    | (_, +Left(error)) => ret +Left(error)
    | (+Right(left), +Right(right)) =>
      ! int/eq (Ret Checked) right 0 { ret +Right(0) } {
        do limit <- ! int/div 4611686018427387903 right;
        ! int/gt (Ret Checked) left limit { ret +Left(+SizeOverflow()) } {
          do value <- ! int/mul left right;
          ret +Right(value)
        }
      }
    end
  in
  let ! round_up (count : Int) (boundary : Int) : Ret Checked =
    do count <- ! size count;
    do boundary <- ! power_of_two boundary;
    match (count, boundary)
    | (+Left(error), _) => ret +Left(error)
    | (_, +Left(error)) => ret +Left(error)
    | (+Right(count), +Right(boundary)) =>
      do remainder <- ! int/mod count boundary;
      ! int/eq (Ret Checked) remainder 0 { ret +Right(count) } {
        do extra <- ! int/sub boundary remainder;
        ! add count extra
      }
    end
  in
  (= size, #alignment = power_of_two, = add, = multiply, = round_up)
end
