-- Recover both handle conventions from paths in one finalized enclosing layout.

let (/VType) = @(import("../primitive.zy")) in
let (/Types) = @(import("types.zy")) in
let (/FieldOperations) = @(import("field.zy")) in
let (/StoragePackage) = @(import("storage.zy")) in
let (/Codec) = @(import("codecs.zy")) in
begin
  param val (/Addr; builtin) : @(import("../builtin.zy")) in
  param val (/Uninit; /Init; /Ptr; types) : Types Addr in
  param val Field : VType -> VType -> VType in
  param val DynamicField : VType -> VType -> VType in
  param val (/constant = /offset) : FieldOperations Uninit Init Ptr Field
    DynamicField in
  param val (/Storage; /DynamicStorage; storage) : StoragePackage in
  let Codec = Codec Uninit Init Ptr in
  let (/Header; /unsafe = view) = (builtin |> (@(import("view.zy")))) types storage in
  let val from_fields (Parent : VType) (Metadata : VType) (Payload : VType) (M : VType)
    (metadata : Codec Metadata M) (metadata_path : Field Parent Metadata) (
      payload_path : Field Parent Payload
    )
  : (#inline :: Header M Payload) * (#prefix :: Header M Payload) =
      let metadata_offset = offset Parent Metadata metadata_path in
      let payload_offset = offset Parent Payload payload_path in
      (
        #inline = view/header M Metadata Payload metadata metadata_offset payload_offset,
        #prefix = view/prefix M Metadata Payload metadata (
          (@(intrinsic(int_sub))) metadata_offset payload_offset
        )
      )
  in
  (= from_fields)
end
