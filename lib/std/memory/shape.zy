begin
  let (/VType; /Int; /Unit) = @(import("../primitive.zy")) in
  let Node (Form : VType) =
    (#size :: Int) * (#alignment :: Int) * (#form :: Form)
  in
  begin
    def Form : VType =
      data
      | +Scalar : (#width :: Int)
      | +Padding : Unit
      | +Product : (#offset :: Int) * (#left :: Node Form) * (#right :: Node Form)
      end
    that
    pack (= Shape as Node Form)
    where () end
  end
end
