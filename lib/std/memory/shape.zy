begin
  let VType = @(intrinsic(vtype)) in
  let Int = @(intrinsic(int)) in
  let Unit = @(intrinsic(unit)) in
  let Node (Form : VType) =
    (#size :: Int) * (#alignment :: Int) * (#form :: Form)
  in
  begin
    def Form : VType =
      data
      | +Scalar : (#width :: Int)
      | +Padding : Unit
      | +Product : (#offset :: Int) * (#left :: Node Form) * (#right :: Node Form)
      end
    that
    Node Form
  end
end
