begin
  param val (/VType; /CType; /Thk; /Ret; /Unit; /Bytes;
    /Int8; /Int16; /Int32; /Int64; /UInt8; /UInt16; /UInt32; /UInt64;
    /Float32; /Float64; /numeric; builtin) : @(import("../builtin.zy")) that
  let Result = @(import("../data/result.zy")) in
  let Error = @(import("layout-error.zy")) in
  let Shape = @(import("shape.zy")) in
  let Descriptor = @(import("descriptor.type.zy")) in
  let Representation = @(import("representation.type.zy")) in
  let size = @(import("size.zy")) in
  let sub = @(intrinsic(i64_sub)) in
  let make_codec = @(import("codec.zy")) in
  let codec = builtin |> make_codec in
  let Plan (A : VType) = (#shape :: Shape) * (#codec :: Descriptor A) in
  let Layout (A : VType) = Result (Plan A) Error in
  let val scalar (A : VType) (count : Int64)
    (write : Thk (A -> Ret Bytes))
    (read : Thk (forall (R : CType) . Bytes -> Thk R -> Thk (A -> R) -> R))
  : Layout A =
      +Ok(#shape = (#size = count, #alignment = count, #form = +Scalar(#width = count)),
        #codec = codec/scalar A count write read)
  in
  let val padding (count : Int64) : Layout Unit =
    size/bind Int64 (Plan Unit) (size/size count) (
      val count =>
        +Ok(#shape = (#size = count, #alignment = 1, #form = +Padding()),
          #codec = codec/padding count)
    )
  in
  let val product (A : VType) (B : VType) (left : Layout A) (right : Layout B) :
    Layout (A * B) =
      size/bind (Plan A) (Plan (A * B)) left (
        val left =>
          size/bind (Plan B) (Plan (A * B)) right (
            val right =>
              size/bind Int64 (Plan (A * B))
                (size/round_up left/shape/size right/shape/alignment) (
                val offset =>
                  size/bind Int64 (Plan (A * B)) (size/add offset right/shape/size) (
                    val field_end =>
                      let alignment = size/maximum left/shape/alignment right/shape/alignment in
                      size/bind Int64 (Plan (A * B)) (size/round_up field_end alignment) (
                        val count =>
                          let gap = sub offset left/shape/size in
                          let tail = sub count field_end in
                          +Ok(
                            #shape = (#size = count, = alignment,
                              #form = +Product(= offset, #left = left/shape, #right = right/shape)),
                            #codec = codec/product A B left/codec right/codec offset count alignment
                              gap tail
                          )
                      )
                  )
              )
          )
      )
  in
  let val align (A : VType) (boundary : Int64) (layout : Layout A) : Layout A =
    size/bind Int64 (Plan A) (size/alignment boundary) (
      val boundary =>
        size/bind (Plan A) (Plan A) layout (
          val layout =>
            let alignment = size/maximum boundary layout/shape/alignment in
            size/bind Int64 (Plan A) (size/round_up layout/shape/size alignment) (
              val count =>
                let tail = sub count layout/shape/size in
                +Ok(#shape = (#size = count, = alignment, #form = layout/shape/form),
                  #codec = codec/align A layout/codec count alignment tail)
            )
        )
    )
  in
  let val inspect (A : VType) (plan : Plan A) : Shape = plan/shape in
  let val realize (A : VType) (plan : Plan A) : Representation A =
    codec/realize A plan/codec
  in
  (
    (
      = Plan,
      = Layout,
      (#unit = padding 0, = padding, = product, = align, = inspect, = realize,
        #int8 = scalar Int8 1 numeric/int8/to_le_bytes numeric/int8/from_le_bytes,
        #int16 = scalar Int16 2 numeric/int16/to_le_bytes numeric/int16/from_le_bytes,
        #int32 = scalar Int32 4 numeric/int32/to_le_bytes numeric/int32/from_le_bytes,
        #int64 = scalar Int64 8 numeric/int64/to_le_bytes numeric/int64/from_le_bytes,
        #uint8 = scalar UInt8 1 numeric/uint8/to_le_bytes numeric/uint8/from_le_bytes,
        #uint16 = scalar UInt16 2 numeric/uint16/to_le_bytes numeric/uint16/from_le_bytes,
        #uint32 = scalar UInt32 4 numeric/uint32/to_le_bytes numeric/uint32/from_le_bytes,
        #uint64 = scalar UInt64 8 numeric/uint64/to_le_bytes numeric/uint64/from_le_bytes,
        #float32 = scalar Float32 4 numeric/float32/to_le_bytes numeric/float32/from_le_bytes,
        #float64 = scalar Float64 8 numeric/float64/to_le_bytes numeric/float64/from_le_bytes)
    ) : @(import("static-layout.type.zy"))
  )
end
