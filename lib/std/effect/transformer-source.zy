-- The closed source interface and implementation used by algebra translation.
begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let (/Monad) = @(import("monad.zy")) in
  let Transformer (M : VType -> CType) (T : VType -> CType) =
    codata
    | .monad : Monad T
    | .lift : forall (A : VType) . Thk (M A) -> T A
    end
  in
  let with_lift = {
    fn (S : VType -> CType) (monad : Thk (Monad S)) =>
      (
        comatch
        | .monad => ! monad
        | .lift A computation =>
          do a <- ! computation;
          ! monad .return A a
        end : Transformer Ret S
      )
  } in
  pack (= Transformer as Transformer)
  where = with_lift end
end
