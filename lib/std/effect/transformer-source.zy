-- Import inside the closed monadic payload, together with the source implementation.
begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let Monad = @(import("monad.type.zy")) in
  let Transformer = @(import("transformer-inner.type.zy")) in
  fn (S : VType -> CType) (monad : Thk (Monad S)) =>
    (
      comatch
      | .monad => ! monad
      | .lift A computation =>
        do a <- ! computation;
        ! monad .return A a
      end : Transformer Ret S
    )
end
