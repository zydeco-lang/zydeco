begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let MonadInstance = @(import("monad-instance.type.zy")) in
  let Transformer = @(import("transformer-inner.type.zy")) in
  let MonadTrans (F : (VType -> CType) -> VType -> CType) =
    pi ((M, _) : MonadInstance) . Transformer M (F M)
  in
  MonadTrans
end
