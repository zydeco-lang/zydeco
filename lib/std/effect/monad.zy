param val (/VType; /CType; /Thk; /Unit; builtin) : @(import("../builtin.zy")) in
begin
  -- Shared Monad and algebra type constructors, and the packed base interface.
  let Monad = @(import("monad.type.zy")) that
  let Algebra = @(import("algebra.type.zy")) that
  let MonadInstance = @(import("monad-instance.type.zy")) that

  -- Compose carrier-indexed operations before packaging one carrier and its monad.
  let WithMonad (I : (VType -> CType) -> VType) =
    exists (M : VType -> CType) . (#monad :: Thk (Monad M)) * I M
  that

  pack
      (= Monad as Monad)
      (= Algebra as Algebra)
      (= MonadInstance as MonadInstance)
      (= WithMonad as WithMonad)
  where
    ()
  end
end
