-- Closed relative-monad interfaces; no host capabilities are needed to open them.
begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Top =
    codata
    end
  in
  let Monad (M : VType -> CType) =
    codata
    | .return : forall (A : VType) . A -> M A
    | .bind : forall (A : VType) (B : VType) . Thk (M A) -> Thk (A -> M B) -> M B
    end
  in
  let Algebra (M : VType -> CType) (R : CType) =
    forall (A : VType) . Thk (M A) -> Thk (A -> R) -> R
  in
  -- One base carrier and its dictionary, without additional effect operations.
  let MonadInstance = exists (M : VType -> CType) . Thk (Monad M) in
  let WithMonad (I : (VType -> CType) -> VType) =
    exists (M : VType -> CType) . (#monad :: Thk (Monad M)) * I M
  in
  pack
    (= Top as Top)
    (= Monad as Monad)
    (= Algebra as Algebra)
    (= MonadInstance as MonadInstance)
    (= WithMonad as WithMonad)
  where () end
end
