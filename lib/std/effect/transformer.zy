-- Shared interface adaptation for transformers derived by algebra translation.
val ((/VType; /CType; /Thk; builtin) : @(import("../builtin.zy"))) =>
  begin
    let Monad = @(import("monad.type.zy")) that
    let Transformer = @(import("transformer-inner.type.zy")) that
    let MonadTrans = @(import("transformer.type.zy")) that
    let Top = @(import("top.type.zy")) that
    let triv : Thk Top = {
      comatch
      end
    } that
    let Lift (M : VType -> CType) (T : VType -> CType) =
      forall (A : VType) . Thk (M A) -> T A
    that
    let ITransformer (M : VType -> CType) (T : VType -> CType) =
      (#lift :: Thk (Lift M T))
    that
    let MonadicMonad (T : VType -> CType) =
      codata
      | .return : forall (A : VType) . Thk Top -> A -> T A
      | .bind : forall (A : VType) .
           Thk Top
        -> (forall (B : VType) . Thk Top -> Thk (T A) -> Thk (A -> T B) -> T B)
      end
    that
    let MonadicTransformer (M : VType -> CType) (T : VType -> CType) =
      codata
      | .monad : MonadicMonad T
      | .lift : forall (A : VType) . Thk Top -> Thk (M A) -> T A
      end
    that
    -- Supply only trivial value-type structure; carrier-internal algebras remain intact.
    def ! from_monadic (M : VType -> CType) (T : VType -> CType)
      (translated : Thk (MonadicTransformer M T))
    : Transformer M T =
        comatch
        | .monad =>
          comatch
          | .return A => ! translated .monad .return A triv
          | .bind A B => ! translated .monad .bind A triv B triv
          end
        | .lift A => ! translated .lift A triv
        end
    that
    def ! from_instance (M : VType -> CType) (T : VType -> CType)
      ((/monad; /lift) : (#monad :: Thk (Monad T)) * ITransformer M T)
    : Transformer M T =
        comatch
        | .monad => ! monad
        | .lift => ! lift
        end
    that
    pack
        (= Transformer as Transformer : (VType -> CType) -> (VType -> CType) -> CType)
        (= MonadTrans as MonadTrans : ((VType -> CType) -> VType -> CType) -> CType)
        (= Lift as Lift : (VType -> CType) -> (VType -> CType) -> CType)
        (= ITransformer as ITransformer : (VType -> CType) -> (VType -> CType) -> VType)
    where
      = from_monadic, = from_instance
    end
  end
