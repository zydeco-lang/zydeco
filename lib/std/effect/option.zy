-- Optional computations reuse the standard Option observation and short-circuit on None.
val ((/VType; /CType; /Thk; /Ret; builtin) : @(import("../builtin.zy"))) =>
  begin
    let (/Monad) = builtin |> (@(import("monad.zy"))) in
    let (/instance = ret_instance) = builtin |> (@(import("ret.zy"))) in
    begin
      let Option = @(import("../data/option.zy")) that
      let MonadOption = @(import("option.type.zy")) that
      let OptionT (M : VType -> CType) (A : VType) = M (Option A) that
      let Optional = OptionT Ret that
      let IOption (M : VType -> CType) = (#option :: Thk (MonadOption M)) that

      let val transformer_instance (M : VType -> CType) (base : Thk (Monad M)) =
        pack (T as OptionT M : VType -> CType)
        where
          #monad = (
            {
              comatch
              | .return A a => ! base .return (Option A) +Some(a)
              | .bind A B m f =>
                ! base .bind (Option A) (Option B) m {
                  fn observation =>
                    match observation
                    | +None() => ! base .return (Option B) +None()
                    | +Some(a) => ! f a
                    end
                }
              end
            } : Thk (Monad (OptionT M))
          ),
          #option = (
            {
              comatch
              | .none A => ! base .return (Option A) +None()
              | .or_else A m fallback =>
                ! base .bind (Option A) (Option A) m {
                  fn observation =>
                    match observation
                    | +None() => ! fallback
                    | +Some(a) => ! base .return (Option A) +Some(a)
                    end
                }
              end
            } : Thk (MonadOption (OptionT M))
          )
        end
      that
      let instance = transformer_instance Ret ret_instance/monad that

      def ! lift (M : VType -> CType) (base : Thk (Monad M)) (A : VType) (m : Thk (M A)) :
        OptionT M A =
          ! base .bind A (Option A) m { fn a => ! base .return (Option A) +Some(a) }
      that

      def ! run_option_t (M : VType -> CType) (A : VType) (m : Thk (OptionT M A)) :
        M (Option A) = ! m that

      def ! run_option (A : VType) (m : Thk (Optional A)) :
        Ret (Option A) = ! run_option_t Ret A m that

      pack
          (= Option as Option : VType -> VType)
          (= Optional as Optional : VType -> CType)
          (= OptionT as OptionT : (VType -> CType) -> VType -> CType)
          (= MonadOption as MonadOption : (VType -> CType) -> CType)
          (= IOption as IOption : (VType -> CType) -> VType)
      where
        = instance, = transformer_instance, = lift, = run_option, = run_option_t
      end
    end
  end
