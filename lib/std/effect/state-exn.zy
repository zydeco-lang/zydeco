-- A combined State + Exception stack, built from the two effect interfaces.
val
  (
    (/OS = _; builtin) : @(import("../builtin.zy"))
  )
=>
  begin
    let monadic_basis = @(import("monad.zy")) that
    let state_basis = @(import("state.zy")) that
    let exception_basis = @(import("exception.zy")) that
    let (/Monad; /WithMonad) = monadic_basis in
    let (/MonadState; /IState; /StateT; state_library) = builtin |> state_basis in
    let (/MonadThrow; /IException; /Exception; exception_library) = builtin |> exception_basis in
    begin
      -- State layered over Exception: failure discards the state, and catch
      -- restarts its handler from the state at entry to the protected computation.
      let StateExn (S : VType) (E : VType) = StateT S (Exception E) that

      let IStateExn (S : VType) (E : VType) =
        WithMonad <| fn (M : VType -> CType) =>
          IState S M * IException E M
      that

      let val instance (S : VType) (E : VType) =
        let (X, exception) = exception_library/instance E in
        let (T, state) = state_library/transformer_instance S X exception/monad in
        pack (M as StateExn S E)
        where
          #monad = state/monad,
          (
            #state = state/state,
            (
              #exception = (
                {
                  comatch
                  | .throw A error => ! state/lift A { ! exception/exception .throw A error }
                  end
                } : Thk (MonadThrow E (StateExn S E))
              ),
              #catch = (
                {
                  fn (A : VType) m handler initial =>
                    ! exception/catch (A * S) { ! m initial } {
                      fn error => ! handler error initial
                    }
                } : Thk (
                  forall (A : VType) .
                    Thk (StateExn S E A) -> Thk (E -> StateExn S E A) -> StateExn S E A
                )
              )
            )
          )
        end
      that

      -- Runner: observe the error or the answer and the final state.
      def ! run_state_exn (S : VType)
        (E : VType)
        (A : VType)
        (B : CType)
        (initial : S)
        (m : Thk (StateExn S E A))
        (on_error : Thk (E -> B))
        (on_value : Thk (S -> A -> B))
      : B =
          do r <- ! m initial;
          match r
          | +Left(e) => ! on_error e
          | +Right(a, s') => ! on_value s' a
          end
      that

      pack
        (= StateExn as StateExn)
        (= IStateExn as IStateExn)
      where
        = instance,
        = run_state_exn
      end
    end
  end
-- end module StateExn
