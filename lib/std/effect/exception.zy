-- The Exception effect, packaged as a pure library over the Builtin signature.
val
  (
    (/VType; /CType; /Thk; /Ret; /Unit; builtin) : @(import("../builtin.zy"))
  )
=>
  begin
    let monadic_basis = @(import("monad.zy")) that
    let (/Monad; /WithMonad) = builtin |> monadic_basis in
    begin
      def Either (E : VType) (A : VType) =
        data
        | +Left : E
        | +Right : A
        end
      that
      let Top = @(import("top.type.zy")) that

      -- The operations of the Exception effect, relative to an ambient monad M.
      let MonadThrow = @(import("exception.type.zy")) that

      -- The canonical Exception relative monad: a returned Either observation.
      let Exception (E : VType) (A : VType) = Ret (Either E A) that

      let IException (E : VType) (M : VType -> CType) =
          (#exception :: Thk (MonadThrow E M))
        * (#catch :: Thk (forall (A : VType) . Thk (M A) -> Thk (E -> M A) -> M A))
      that

      def ! mo_exception (E : VType) : Monad (Exception E) =
        comatch
        | .return A a =>
          ret +Right(a)
        | .bind A A' m f =>
          do r <- ! m;
          match r
          | +Left(e) => ret +Left(e)
          | +Right(a) => ! f a
          end
        end
      that

      def ! throw_ops (E : VType) : MonadThrow E (Exception E) =
        comatch
        | .throw A e =>
          ret +Left(e)
        end
      that

      let val instance (E : VType) =
        pack (M as Exception E : VType -> CType)
        where
          #monad = { ! mo_exception E },
          (
            #exception = { ! throw_ops E },
            #catch = (
              {
                fn (A : VType) (m : Thk (Exception E A)) (h : Thk (E -> Exception E A)) =>
                  do r <- ! m;
                  match r
                  | +Left(e) => ! h e
                  | +Right(a) => ret +Right(a)
                  end
              } : Thk <| forall (A : VType) .
                Thk (Exception E A) -> Thk (E -> Exception E A) -> Exception E A
            )
          )
        end
      that

      -- A monadic-block-ready raise function. The leading Top argument carries
      -- the structure required by the algebra translation for the answer type A.
      def ! raise (E : VType) ((M, /exception) : WithMonad (IException E)) :
        forall (A : VType) . Thk Top -> E -> M A =
          fn (A : VType) (_ : Thk Top) (e : E) =>
            ! exception .throw A e
      that

      def ! catch (E : VType) ((M, /catch) : WithMonad (IException E))
        (A : VType) (_ : Thk Top) (m : Thk (M A)) (h : Thk (E -> M A))
      : M A =
          ! catch A m h
      that

      def ! handle_exception (E : VType)
        (A : VType)
        (B : CType)
        (m : Thk (Exception E A))
        (on_error : Thk (E -> B))
        (on_value : Thk (A -> B))
      : B =
          do r <- ! m;
          match r
          | +Left(e) => ! on_error e
          | +Right(a) => ! on_value a
          end
      that

      pack
          (= Exception as Exception : VType -> VType -> CType)
          (= MonadThrow as MonadThrow : VType -> (VType -> CType) -> CType)
          (= IException as IException : VType -> (VType -> CType) -> VType)
      where
        = instance,
        = raise,
        = catch,
        = handle_exception
      end
    end
  end
-- end module Exception
