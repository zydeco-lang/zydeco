param (
  (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
  @[import("builtin.zy")] _
) in
begin
  def IoErrorKind =
    data
    | +NotFound : Unit
    | +PermissionDenied : Unit
    | +AlreadyExists : Unit
    | +InvalidInput : Unit
    | +InvalidData : Unit
    | +BrokenPipe : Unit
    | +Closed : Unit
    | +Other : Unit
    end
  that
  def not_found : IoErrorKind = +NotFound()
  that
  def permission_denied : IoErrorKind = +PermissionDenied()
  that
  def already_exists : IoErrorKind = +AlreadyExists()
  that
  def invalid_input : IoErrorKind = +InvalidInput()
  that
  def invalid_data : IoErrorKind = +InvalidData()
  that
  def broken_pipe : IoErrorKind = +BrokenPipe()
  that
  def closed : IoErrorKind = +Closed()
  that
  def other : IoErrorKind = +Other()
  that
  def ! from_code (code : Int) : Ret IoErrorKind =
    ! (api/int_eq_branch)
      (Ret IoErrorKind)
      code
      0
      { ret not_found }
      {
        ! (api/int_eq_branch)
          (Ret IoErrorKind)
          code
          1
          { ret permission_denied }
          {
            ! (api/int_eq_branch)
              (Ret IoErrorKind)
              code
              2
              { ret already_exists }
              {
                ! (api/int_eq_branch)
                  (Ret IoErrorKind)
                  code
                  3
                  { ret invalid_input }
                  {
                    ! (api/int_eq_branch)
                      (Ret IoErrorKind)
                      code
                      4
                      { ret invalid_data }
                      {
                        ! (api/int_eq_branch)
                          (Ret IoErrorKind)
                          code
                          5
                          { ret broken_pipe }
                          {
                            ! (api/int_eq_branch)
                              (Ret IoErrorKind)
                              code
                              6
                              { ret closed }
                              { ret other }
                          }
                      }
                  }
              }
          }
      }
  that
  def ! kind_code (kind : IoErrorKind) : Ret Int =
    match kind
    | +NotFound(_) => ret 0
    | +PermissionDenied(_) => ret 1
    | +AlreadyExists(_) => ret 2
    | +InvalidInput(_) => ret 3
    | +InvalidData(_) => ret 4
    | +BrokenPipe(_) => ret 5
    | +Closed(_) => ret 6
    | +Other(_) => ret 7
    end
  that
  def ! kind_eq_branch
    (R : CType)
    (left : IoErrorKind)
    (right : IoErrorKind)
    (when_equal : Thk R)
    (when_different : Thk R)
    : R =
    do left_code <- ! kind_code left;
    do right_code <- ! kind_code right;
    ! (api/int_eq_branch) R left_code right_code when_equal when_different
  that
  def IoError =
    data
    | +IoError : (kind :: IoErrorKind) * (message :: String)
    end
  that
  def ! error (kind : IoErrorKind) (message : String) : Ret IoError =
    ret +IoError(= kind, = message)
  that
  def ! error_kind (error : IoError) : Ret IoErrorKind =
    match error
    | +IoError(/kind) => ret kind
    end
  that
  def ! error_message (error : IoError) : Ret String =
    match error
    | +IoError(/message) => ret message
    end
  that
  def Path =
    data
    | +Path : String
    end
  that
  def ! path (string : String) : Ret Path =
    ret +Path(string)
  that
  def ! path_string (path : Path) : Ret String =
    match path
    | +Path(string) => ret string
    end
  that
  let Interface =
    exists (IoErrorKind = AbstractIoErrorKind : VType) .
    exists (IoError = AbstractIoError : VType) .
    exists (Path = AbstractPath : VType) .
      (not_found :: AbstractIoErrorKind) *
      (permission_denied :: AbstractIoErrorKind) *
      (already_exists :: AbstractIoErrorKind) *
      (invalid_input :: AbstractIoErrorKind) *
      (invalid_data :: AbstractIoErrorKind) *
      (broken_pipe :: AbstractIoErrorKind) *
      (closed :: AbstractIoErrorKind) *
      (other :: AbstractIoErrorKind) *
      (from_code :: Thk (Int -> Ret AbstractIoErrorKind)) *
      (kind_eq_branch :: Thk (
        forall (R : CType) .
          AbstractIoErrorKind -> AbstractIoErrorKind -> Thk R -> Thk R -> R
      )) *
      (error :: Thk (AbstractIoErrorKind -> String -> Ret AbstractIoError)) *
      (error_kind :: Thk (AbstractIoError -> Ret AbstractIoErrorKind)) *
      (error_message :: Thk (AbstractIoError -> Ret String)) *
      (path :: Thk (String -> Ret AbstractPath)) *
      (path_string :: Thk (AbstractPath -> Ret String))
  that

  (
    IoErrorKind = IoErrorKind,
    IoError = IoError,
    Path = Path,
    not_found = not_found,
    permission_denied = permission_denied,
    already_exists = already_exists,
    invalid_input = invalid_input,
    invalid_data = invalid_data,
    broken_pipe = broken_pipe,
    closed = closed,
    other = other,
    from_code = from_code,
    kind_eq_branch = kind_eq_branch,
    error = error,
    error_kind = error_kind,
    error_message = error_message,
    path = path,
    path_string = path_string,
  ) : Interface
end
