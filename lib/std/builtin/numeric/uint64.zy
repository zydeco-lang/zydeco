begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let String = @(intrinsic(string)) in
  let Bytes = @(intrinsic(bytes)) in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  let UInt64 = @(intrinsic(u64)) in
    (@[builtin(uint64_add)] (#add :: Binary UInt64))
  * (@[builtin(uint64_sub)] (#sub :: Binary UInt64))
  * (@[builtin(uint64_mul)] (#mul :: Binary UInt64))
  * (@[builtin(uint64_div)] (#div :: Binary UInt64))
  * (@[builtin(uint64_mod)] (#mod :: Binary UInt64))
  * (@[builtin(uint64_eq)] (#eq :: Branch UInt64))
  * (@[builtin(uint64_lt)] (#lt :: Branch UInt64))
  * (@[builtin(uint64_gt)] (#gt :: Branch UInt64))
  * (@[builtin(uint64_to_string)] (#to_string :: Render UInt64))
  * (@[builtin(uint64_to_le_bytes)] (#to_le_bytes :: Thk (UInt64 -> Ret Bytes)))
  * (
      @[builtin(uint64_from_le_bytes)] (
        #from_le_bytes :: Thk (
          forall (R : CType) . Bytes -> Thk R -> Thk (UInt64 -> R) -> R
        )
      )
    )
end
