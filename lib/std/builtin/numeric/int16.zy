begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let String = @(intrinsic(string)) in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  exists
    (#Int16 = ScalarType as @(intrinsic(i16)) : VType)
  .
      (@[builtin(int16_add)] (#add :: Binary ScalarType))
    * (@[builtin(int16_sub)] (#sub :: Binary ScalarType))
    * (@[builtin(int16_mul)] (#mul :: Binary ScalarType))
    * (@[builtin(int16_div)] (#div :: Binary ScalarType))
    * (@[builtin(int16_mod)] (#mod :: Binary ScalarType))
    * (@[builtin(int16_eq)] (#eq :: Branch ScalarType))
    * (@[builtin(int16_lt)] (#lt :: Branch ScalarType))
    * (@[builtin(int16_gt)] (#gt :: Branch ScalarType))
    * (@[builtin(int16_to_string)] (#to_string :: Render ScalarType))
end
