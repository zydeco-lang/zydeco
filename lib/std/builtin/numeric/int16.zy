begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let String = @(intrinsic(string)) in
  let Int64 = @(intrinsic(i64)) in
  param Addr : VType in
  param Access : VType in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  let Int16 = @(intrinsic(i16)) in
    (@[builtin(int16_add)] (#add :: Binary Int16))
  * (@[builtin(int16_sub)] (#sub :: Binary Int16))
  * (@[builtin(int16_mul)] (#mul :: Binary Int16))
  * (@[builtin(int16_div)] (#div :: Binary Int16))
  * (@[builtin(int16_mod)] (#mod :: Binary Int16))
  * (@[builtin(int16_eq)] (#eq :: Branch Int16))
  * (@[builtin(int16_lt)] (#lt :: Branch Int16))
  * (@[builtin(int16_gt)] (#gt :: Branch Int16))
  * (@[builtin(int16_to_string)] (#to_string :: Render Int16))
  * (
      @[builtin(int16_store_le)] (
        #store_le :: Thk (
          forall (R : CType) . Access -> Addr -> Int16 -> Thk (Int64 -> R) -> Thk R -> R
        )
      )
    )
  * (
      @[builtin(int16_load_le)] (
        #load_le :: Thk (
          forall (R : CType) . Access -> Addr -> Thk (Int64 -> R) -> Thk (Int16 -> R) -> R
        )
      )
    )
end
