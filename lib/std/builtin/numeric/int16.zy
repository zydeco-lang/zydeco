exists
  (
    Scalar = ScalarType as @[intrinsic(i16)] _ :
    @[intrinsic(vtype)] _
  )
.
    (
      @[builtin(int16_add)] (
        add :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(int16_sub)] (
        sub :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(int16_mul)] (
        mul :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(int16_div)] (
        div :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(int16_mod)] (
        mod :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(int16_eq)] (
        eq :: (@[intrinsic(thk)] _) (
          forall (R : @[intrinsic(ctype)] _) .
               ScalarType -> ScalarType
            -> (@[intrinsic(thk)] _) R -> (@[intrinsic(thk)] _) R -> R
        )
      )
    )
  * (
      @[builtin(int16_lt)] (
        lt :: (@[intrinsic(thk)] _) (
          forall (R : @[intrinsic(ctype)] _) .
               ScalarType -> ScalarType
            -> (@[intrinsic(thk)] _) R -> (@[intrinsic(thk)] _) R -> R
        )
      )
    )
  * (
      @[builtin(int16_gt)] (
        gt :: (@[intrinsic(thk)] _) (
          forall (R : @[intrinsic(ctype)] _) .
               ScalarType -> ScalarType
            -> (@[intrinsic(thk)] _) R -> (@[intrinsic(thk)] _) R -> R
        )
      )
    )
  * (
      @[builtin(int16_to_string)] (
        to_string :: (@[intrinsic(thk)] _) (
          ScalarType -> (@[intrinsic(ret)] _) (@[intrinsic(string)] _)
        )
      )
    )
