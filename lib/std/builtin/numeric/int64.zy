begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let String = @(intrinsic(string)) in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  exists
    (= Int64 as @(intrinsic(i64)) : VType)
  .
      (@[builtin(int64_add)] (#add :: Binary Int64))
    * (@[builtin(int64_sub)] (#sub :: Binary Int64))
    * (@[builtin(int64_mul)] (#mul :: Binary Int64))
    * (@[builtin(int64_div)] (#div :: Binary Int64))
    * (@[builtin(int64_mod)] (#mod :: Binary Int64))
    * (@[builtin(int64_eq)] (#eq :: Branch Int64))
    * (@[builtin(int64_lt)] (#lt :: Branch Int64))
    * (@[builtin(int64_gt)] (#gt :: Branch Int64))
    * (@[builtin(int64_to_string)] (#to_string :: Render Int64))
end
