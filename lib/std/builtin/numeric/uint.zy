begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let String = @(intrinsic(string)) in
  param Addr : VType in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  let UInt = @(intrinsic(uint)) in
    (@[builtin(uint_add)] (#add :: Binary UInt))
  * (@[builtin(uint_sub)] (#sub :: Binary UInt))
  * (@[builtin(uint_mul)] (#mul :: Binary UInt))
  * (@[builtin(uint_div)] (#div :: Binary UInt))
  * (@[builtin(uint_mod)] (#mod :: Binary UInt))
  * (@[builtin(uint_eq)] (#eq :: Branch UInt))
  * (@[builtin(uint_lt)] (#lt :: Branch UInt))
  * (@[builtin(uint_gt)] (#gt :: Branch UInt))
  * (@[builtin(uint_to_string)] (#to_string :: Render UInt))
  * (
      @[builtin(uint_store_le)] (
        #store_le :: Thk (
          forall (R : CType) . Addr -> UInt -> Thk R -> R
        )
      )
    )
  * (
      @[builtin(uint_load_le)] (
        #load_le :: Thk (
          forall (R : CType) . Addr -> Thk (UInt -> R) -> R
        )
      )
    )
end
