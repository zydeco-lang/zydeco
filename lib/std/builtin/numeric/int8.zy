begin
  let VType = @(import("../intrinsic/vtype.zy")) in
  let CType = @(import("../intrinsic/ctype.zy")) in
  let Thk = @(import("../intrinsic/thk.zy")) in
  let Ret = @(import("../intrinsic/ret.zy")) in
  let String = @(import("../intrinsic/string.zy")) in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  exists
    (Scalar = ScalarType as @(import("../intrinsic/i8.zy")) : VType)
  .
      (@[builtin(int8_add)] (add :: Binary ScalarType))
    * (@[builtin(int8_sub)] (sub :: Binary ScalarType))
    * (@[builtin(int8_mul)] (mul :: Binary ScalarType))
    * (@[builtin(int8_div)] (div :: Binary ScalarType))
    * (@[builtin(int8_mod)] (mod :: Binary ScalarType))
    * (@[builtin(int8_eq)] (eq :: Branch ScalarType))
    * (@[builtin(int8_lt)] (lt :: Branch ScalarType))
    * (@[builtin(int8_gt)] (gt :: Branch ScalarType))
    * (@[builtin(int8_to_string)] (to_string :: Render ScalarType))
end
