begin
  let VType = @(import("../intrinsic/vtype.zy")) in
  let CType = @(import("../intrinsic/ctype.zy")) in
  let Thk = @(import("../intrinsic/thk.zy")) in
  let Ret = @(import("../intrinsic/ret.zy")) in
  let String = @(import("../intrinsic/string.zy")) in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  exists
    (Scalar = ScalarType as @(import("../intrinsic/f64.zy")) : VType)
  .
      (@[builtin(float64_add)] (add :: Binary ScalarType))
    * (@[builtin(float64_sub)] (sub :: Binary ScalarType))
    * (@[builtin(float64_mul)] (mul :: Binary ScalarType))
    * (@[builtin(float64_div)] (div :: Binary ScalarType))
    * (@[builtin(float64_eq)] (eq :: Branch ScalarType))
    * (@[builtin(float64_lt)] (lt :: Branch ScalarType))
    * (@[builtin(float64_gt)] (gt :: Branch ScalarType))
    * (@[builtin(float64_to_string)] (to_string :: Render ScalarType))
end
