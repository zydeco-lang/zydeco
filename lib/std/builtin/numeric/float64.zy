begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let String = @(intrinsic(string)) in
  let Bytes = @(intrinsic(bytes)) in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  let Float64 = @(intrinsic(f64)) in
    (@[builtin(float64_add)] (#add :: Binary Float64))
  * (@[builtin(float64_sub)] (#sub :: Binary Float64))
  * (@[builtin(float64_mul)] (#mul :: Binary Float64))
  * (@[builtin(float64_div)] (#div :: Binary Float64))
  * (@[builtin(float64_eq)] (#eq :: Branch Float64))
  * (@[builtin(float64_lt)] (#lt :: Branch Float64))
  * (@[builtin(float64_gt)] (#gt :: Branch Float64))
  * (@[builtin(float64_to_string)] (#to_string :: Render Float64))
  * (@[builtin(float64_to_le_bytes)] (#to_le_bytes :: Thk (Float64 -> Ret Bytes)))
  * (
      @[builtin(float64_from_le_bytes)] (
        #from_le_bytes :: Thk (
          forall (R : CType) . Bytes -> Thk R -> Thk (Float64 -> R) -> R
        )
      )
    )
end
