exists
  (
    Scalar = ScalarType as @[intrinsic(f64)] _ :
    @[intrinsic(vtype)] _
  )
.
    (
      @[builtin(float64_add)] (
        add :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(float64_sub)] (
        sub :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(float64_mul)] (
        mul :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(float64_div)] (
        div :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(float64_eq)] (
        eq :: (@[intrinsic(thk)] _) (
          forall (R : @[intrinsic(ctype)] _) .
               ScalarType -> ScalarType
            -> (@[intrinsic(thk)] _) R -> (@[intrinsic(thk)] _) R -> R
        )
      )
    )
  * (
      @[builtin(float64_lt)] (
        lt :: (@[intrinsic(thk)] _) (
          forall (R : @[intrinsic(ctype)] _) .
               ScalarType -> ScalarType
            -> (@[intrinsic(thk)] _) R -> (@[intrinsic(thk)] _) R -> R
        )
      )
    )
  * (
      @[builtin(float64_gt)] (
        gt :: (@[intrinsic(thk)] _) (
          forall (R : @[intrinsic(ctype)] _) .
               ScalarType -> ScalarType
            -> (@[intrinsic(thk)] _) R -> (@[intrinsic(thk)] _) R -> R
        )
      )
    )
  * (
      @[builtin(float64_to_string)] (
        to_string :: (@[intrinsic(thk)] _) (
          ScalarType -> (@[intrinsic(ret)] _) (@[intrinsic(string)] _)
        )
      )
    )
