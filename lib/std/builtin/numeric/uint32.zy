begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let String = @(intrinsic(string)) in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  exists
    (Scalar = ScalarType as @(intrinsic(u32)) : VType)
  .
      (@[builtin(uint32_add)] (add :: Binary ScalarType))
    * (@[builtin(uint32_sub)] (sub :: Binary ScalarType))
    * (@[builtin(uint32_mul)] (mul :: Binary ScalarType))
    * (@[builtin(uint32_div)] (div :: Binary ScalarType))
    * (@[builtin(uint32_mod)] (mod :: Binary ScalarType))
    * (@[builtin(uint32_eq)] (eq :: Branch ScalarType))
    * (@[builtin(uint32_lt)] (lt :: Branch ScalarType))
    * (@[builtin(uint32_gt)] (gt :: Branch ScalarType))
    * (@[builtin(uint32_to_string)] (to_string :: Render ScalarType))
end
