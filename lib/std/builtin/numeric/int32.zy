begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let String = @(intrinsic(string)) in
  let Int = @(intrinsic(int)) in
  param Addr : VType in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  let Int32 = @(intrinsic(i32)) in
    (@[builtin(int32_add)] (#add :: Binary Int32))
  * (@[builtin(int32_sub)] (#sub :: Binary Int32))
  * (@[builtin(int32_mul)] (#mul :: Binary Int32))
  * (@[builtin(int32_div)] (#div :: Binary Int32))
  * (@[builtin(int32_mod)] (#mod :: Binary Int32))
  * (@[builtin(int32_eq)] (#eq :: Branch Int32))
  * (@[builtin(int32_lt)] (#lt :: Branch Int32))
  * (@[builtin(int32_gt)] (#gt :: Branch Int32))
  * (@[builtin(int32_to_string)] (#to_string :: Render Int32))
  * (
      @[builtin(int32_store_le)] (
        #store_le :: Thk (
          forall (R : CType) . Addr -> Int32 -> Thk R -> R
        )
      )
    )
  * (
      @[builtin(int32_load_le)] (
        #load_le :: Thk (
          forall (R : CType) . Addr -> Thk (Int32 -> R) -> R
        )
      )
    )
end
