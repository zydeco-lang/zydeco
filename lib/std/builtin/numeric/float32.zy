begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let String = @(intrinsic(string)) in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  exists
    (= Float32 as @(intrinsic(f32)) : VType)
  .
      (@[builtin(float32_add)] (#add :: Binary Float32))
    * (@[builtin(float32_sub)] (#sub :: Binary Float32))
    * (@[builtin(float32_mul)] (#mul :: Binary Float32))
    * (@[builtin(float32_div)] (#div :: Binary Float32))
    * (@[builtin(float32_eq)] (#eq :: Branch Float32))
    * (@[builtin(float32_lt)] (#lt :: Branch Float32))
    * (@[builtin(float32_gt)] (#gt :: Branch Float32))
    * (@[builtin(float32_to_string)] (#to_string :: Render Float32))
end
