exists
  (
    Scalar = ScalarType as @[intrinsic(f32)] _ :
    @[intrinsic(vtype)] _
  )
.
    (
      @[builtin(float32_add)] (
        add :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(float32_sub)] (
        sub :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(float32_mul)] (
        mul :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(float32_div)] (
        div :: (@[intrinsic(thk)] _) (
          ScalarType -> ScalarType -> (@[intrinsic(ret)] _) ScalarType
        )
      )
    )
  * (
      @[builtin(float32_eq)] (
        eq :: (@[intrinsic(thk)] _) (
          forall (R : @[intrinsic(ctype)] _) .
               ScalarType -> ScalarType
            -> (@[intrinsic(thk)] _) R -> (@[intrinsic(thk)] _) R -> R
        )
      )
    )
  * (
      @[builtin(float32_lt)] (
        lt :: (@[intrinsic(thk)] _) (
          forall (R : @[intrinsic(ctype)] _) .
               ScalarType -> ScalarType
            -> (@[intrinsic(thk)] _) R -> (@[intrinsic(thk)] _) R -> R
        )
      )
    )
  * (
      @[builtin(float32_gt)] (
        gt :: (@[intrinsic(thk)] _) (
          forall (R : @[intrinsic(ctype)] _) .
               ScalarType -> ScalarType
            -> (@[intrinsic(thk)] _) R -> (@[intrinsic(thk)] _) R -> R
        )
      )
    )
  * (
      @[builtin(float32_to_string)] (
        to_string :: (@[intrinsic(thk)] _) (
          ScalarType -> (@[intrinsic(ret)] _) (@[intrinsic(string)] _)
        )
      )
    )
