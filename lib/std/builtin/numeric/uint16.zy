begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let String = @(intrinsic(string)) in
  let Int = @(intrinsic(int)) in
  param Addr : VType in
  let Binary (A : VType) = Thk (A -> A -> Ret A) in
  let Branch (A : VType) = Thk (
    forall (R : CType) . A -> A -> Thk R -> Thk R -> R
  ) in
  let Render (A : VType) = Thk (A -> Ret String) in
  let UInt16 = @(intrinsic(u16)) in
    (@[builtin(uint16_add)] (#add :: Binary UInt16))
  * (@[builtin(uint16_sub)] (#sub :: Binary UInt16))
  * (@[builtin(uint16_mul)] (#mul :: Binary UInt16))
  * (@[builtin(uint16_div)] (#div :: Binary UInt16))
  * (@[builtin(uint16_mod)] (#mod :: Binary UInt16))
  * (@[builtin(uint16_eq)] (#eq :: Branch UInt16))
  * (@[builtin(uint16_lt)] (#lt :: Branch UInt16))
  * (@[builtin(uint16_gt)] (#gt :: Branch UInt16))
  * (@[builtin(uint16_to_string)] (#to_string :: Render UInt16))
  * (
      @[builtin(uint16_store_le)] (
        #store_le :: Thk (
          forall (R : CType) . Addr -> UInt16 -> Thk R -> R
        )
      )
    )
  * (
      @[builtin(uint16_load_le)] (
        #load_le :: Thk (
          forall (R : CType) . Addr -> Thk (UInt16 -> R) -> R
        )
      )
    )
end
