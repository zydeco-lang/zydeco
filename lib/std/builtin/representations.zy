begin
  let VType = @(import("intrinsic/vtype.zy")) in
  let Unit = @(import("intrinsic/unit.zy")) in
  let RepresentationPackage (Representation : VType) =
    exists (Scalar = ScalarType as Representation : VType) .
      Unit
  in
    (i8 :: RepresentationPackage (@(import("intrinsic/i8.zy"))))
  * (i16 :: RepresentationPackage (@(import("intrinsic/i16.zy"))))
  * (i32 :: RepresentationPackage (@(import("intrinsic/i32.zy"))))
  * (i64 :: RepresentationPackage (@(import("intrinsic/i64.zy"))))
  * (u8 :: RepresentationPackage (@(import("intrinsic/u8.zy"))))
  * (u16 :: RepresentationPackage (@(import("intrinsic/u16.zy"))))
  * (u32 :: RepresentationPackage (@(import("intrinsic/u32.zy"))))
  * (u64 :: RepresentationPackage (@(import("intrinsic/u64.zy"))))
  * (f32 :: RepresentationPackage (@(import("intrinsic/f32.zy"))))
  * (f64 :: RepresentationPackage (@(import("intrinsic/f64.zy"))))
  * (char :: RepresentationPackage (@(import("intrinsic/char.zy"))))
  * (string :: RepresentationPackage (@(import("intrinsic/string.zy"))))
  * (bytes :: RepresentationPackage (@(import("intrinsic/bytes.zy"))))
  * Unit
end
