exists (VType as @(import("intrinsic/vtype.zy")))
  (CType as @(import("intrinsic/ctype.zy")))
  (
    Thk = CoreThk as @(import("intrinsic/thk.zy")) :
    CType -> VType
  )
  (
    Ret = CoreRet as @(import("intrinsic/ret.zy")) :
    VType -> CType
  )
  (Unit = CoreUnit as @(import("intrinsic/unit.zy")) : VType)
.
  @(import("intrinsic/unit.zy"))
