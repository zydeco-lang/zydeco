@[prelude(none)]
begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let BuiltinUnit = @(intrinsic(unit)) in
  let Int8 = @(intrinsic(i8)) in
  let Int16 = @(intrinsic(i16)) in
  let Int32 = @(intrinsic(i32)) in
  let Int64 = @(intrinsic(i64)) in
  let Int = @(intrinsic(int)) in
  let UInt8 = @(intrinsic(u8)) in
  let UInt16 = @(intrinsic(u16)) in
  let UInt32 = @(intrinsic(u32)) in
  let UInt64 = @(intrinsic(u64)) in
  let UInt = @(intrinsic(uint)) in
  let Float32 = @(intrinsic(f32)) in
  let Float64 = @(intrinsic(f64)) in
  param Addr : VType in
  let Store (A : VType) = Thk (forall (R : CType) . Addr -> A -> Thk R -> R) in
  let Load (A : VType) = Thk (forall (R : CType) . Addr -> Thk (A -> R) -> R) in
    (#memory :: (@(import("raw.zy"))) Addr)
  * (
      #scalar ::
        (
          #int8 ::
            (@[builtin(int8_store_le)] (#store_le :: Store Int8))
          * (@[builtin(int8_load_le)] (#load_le :: Load Int8))
        )
      * (
          #int16 ::
            (@[builtin(int16_store_le)] (#store_le :: Store Int16))
          * (@[builtin(int16_load_le)] (#load_le :: Load Int16))
        )
      * (
          #int32 ::
            (@[builtin(int32_store_le)] (#store_le :: Store Int32))
          * (@[builtin(int32_load_le)] (#load_le :: Load Int32))
        )
      * (
          #int64 ::
            (@[builtin(int64_store_le)] (#store_le :: Store Int64))
          * (@[builtin(int64_load_le)] (#load_le :: Load Int64))
        )
      * (
          #int ::
            (@[builtin(int_store_le)] (#store_le :: Store Int))
          * (@[builtin(int_load_le)] (#load_le :: Load Int))
        )
      * (
          #uint8 ::
            (@[builtin(uint8_store_le)] (#store_le :: Store UInt8))
          * (@[builtin(uint8_load_le)] (#load_le :: Load UInt8))
        )
      * (
          #uint16 ::
            (@[builtin(uint16_store_le)] (#store_le :: Store UInt16))
          * (@[builtin(uint16_load_le)] (#load_le :: Load UInt16))
        )
      * (
          #uint32 ::
            (@[builtin(uint32_store_le)] (#store_le :: Store UInt32))
          * (@[builtin(uint32_load_le)] (#load_le :: Load UInt32))
        )
      * (
          #uint64 ::
            (@[builtin(uint64_store_le)] (#store_le :: Store UInt64))
          * (@[builtin(uint64_load_le)] (#load_le :: Load UInt64))
        )
      * (
          #uint ::
            (@[builtin(uint_store_le)] (#store_le :: Store UInt))
          * (@[builtin(uint_load_le)] (#load_le :: Load UInt))
        )
      * (
          #float32 ::
            (@[builtin(float32_store_le)] (#store_le :: Store Float32))
          * (@[builtin(float32_load_le)] (#load_le :: Load Float32))
        )
      * (
          #float64 ::
            (@[builtin(float64_store_le)] (#store_le :: Store Float64))
          * (@[builtin(float64_load_le)] (#load_le :: Load Float64))
        )
      * BuiltinUnit
    )
  * BuiltinUnit
end
