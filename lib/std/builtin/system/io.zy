begin
  let VType = @(import("../intrinsic/vtype.zy")) in
  let CType = @(import("../intrinsic/ctype.zy")) in
  let Thk = @(import("../intrinsic/thk.zy")) in
  let String = @(import("../intrinsic/string.zy")) in
  let Int64 = @(import("../intrinsic/i64.zy")) in
  let Bytes = @(import("../intrinsic/bytes.zy")) in
  param Reader : VType in
  param Writer : VType in
  param OS : CType in
  let Error = Thk (Int64 -> String -> OS) in
  let Success (A : VType) = Thk (A -> OS) in
  let Done = Thk OS in
    (
      @[builtin(io_read)] (
        read :: Thk (Reader -> Int64 -> Error -> Success Bytes -> OS)
      )
    )
  * (
      @[builtin(io_read_line)] (
        read_line :: Thk (Reader -> Error -> Done -> Success Bytes -> OS)
      )
    )
  * (
      @[builtin(io_read_all)] (
        read_all :: Thk (Reader -> Error -> Success Bytes -> OS)
      )
    )
  * (
      @[builtin(io_write_all)] (
        write_all :: Thk (Writer -> Bytes -> Error -> Done -> OS)
      )
    )
  * (
      @[builtin(io_flush)] (flush :: Thk (Writer -> Error -> Done -> OS))
    )
  * (
      @[builtin(io_close_reader)] (
        close_reader :: Thk (Reader -> Error -> Done -> OS)
      )
    )
  * (
      @[builtin(io_close_writer)] (
        close_writer :: Thk (Writer -> Error -> Done -> OS)
      )
    )
end
