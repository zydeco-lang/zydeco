begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let String = @(intrinsic(string)) in
  let Int64 = @(intrinsic(i64)) in
  param Reader : VType in
  param Writer : VType in
  param OS : CType in
  let Error = Thk (Int64 -> String -> OS) in
  let ReaderCont = Thk (Reader -> OS) in
  let WriterCont = Thk (Writer -> OS) in
  let Path = Thk (String -> Error -> ReaderCont -> OS) in
  let WriterPath = Thk (String -> Error -> WriterCont -> OS) in
    (@[builtin(fs_open_reader)] (#open_reader :: Path))
  * (@[builtin(fs_create_writer)] (#create_writer :: WriterPath))
  * (@[builtin(fs_append_writer)] (#append_writer :: WriterPath))
end
