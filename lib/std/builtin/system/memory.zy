-- Raw operations require caller-established validity, initialization, and lifetime.
begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let Int = @(intrinsic(int)) in
  let UInt8 = @(intrinsic(u8)) in
  let String = @(intrinsic(string)) in
  param Addr : VType in
    (@[builtin(memory_null)] (#null :: Thk (Ret Addr)))
  * (@[builtin(memory_offset)] (#offset :: Thk (Addr -> Int -> Ret Addr)))
  * (
      @[builtin(memory_allocate)] (
        #allocate :: Thk (
          forall (R : CType) . Int -> Int -> Thk (Int -> R) -> Thk (Addr -> R) -> R)
      )
    )
  * (
      @[builtin(memory_free)] (
        #free :: Thk (
          forall (R : CType) . Addr -> Int -> Int -> Thk (Int -> R) -> Thk R -> R)
      )
    )
  * (
      @[builtin(memory_retain)] (
        #retain :: Thk (
          forall (R : CType) . Addr -> Int -> Int -> Thk (Int -> R) -> Thk R -> R)
      )
    )
  * (
      @[builtin(memory_copy)] (
        #copy :: Thk (
          forall (R : CType) . Addr -> Addr -> Int -> Thk R -> R)
      )
    )
  * (
      @[builtin(memory_fill)] (
        #fill :: Thk (
          forall (R : CType) . Addr -> Int -> UInt8 -> Thk R -> R)
      )
    )
  * (
      @[builtin(memory_load_addr)] (
        #load_addr :: Thk (
          forall (R : CType) . Addr -> Thk (Addr -> R) -> R)
      )
    )
  * (
      @[builtin(memory_store_addr)] (
        #store_addr :: Thk (
          forall (R : CType) . Addr -> Addr -> Thk R -> R)
      )
    )
  * (
      @[builtin(memory_from_string)] (
        #from_string :: Thk (
          forall (R : CType) . String -> Thk (Int -> R) -> Thk (Addr -> Int -> R) -> R)
      )
    )
  * (
      @[builtin(memory_to_string)] (
        #to_string :: Thk (
          forall (R : CType) . Addr -> Int -> Thk (Int -> R) -> Thk (String -> R) -> R)
      )
    )
end
