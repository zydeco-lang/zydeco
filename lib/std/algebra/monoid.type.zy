-- A lawful monoid has associative append and a two-sided identity.
-- Writer additionally requires append to be total and observationally pure.
begin
  let VType = @(intrinsic(vtype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  param W : VType in
    (#empty :: W)
  * (#append :: Thk (W -> W -> Ret W))
end
