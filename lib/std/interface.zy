-- The public standard-library package type, kept separate from its implementation.
begin
  param (
    (/VType; /CType; /Thk; /Ret; /Unit; /Int; /Float; /Char; /String; /Bytes; /Reader; /Writer; /OS) :
    @[import("builtin.zy")] _
  ) in
    let Prelude =
      exists (
        Thunk = ThunkType as Thk :
        (CType) -> (VType)
      ) .
      exists (
        U = UType as Thk :
        (CType) -> (VType)
      ) .
      exists (
        F = FType as Ret :
        (VType) -> (CType)
      ) .
        Unit
    in
    let BoolModule (Bool : VType) =
      (true :: Bool) *
      (false :: Bool) *
      (not :: Thk (Bool -> Ret Bool)) *
      (and :: Thk (Bool -> Bool -> Ret Bool)) *
      (or :: Thk (Bool -> Bool -> Ret Bool)) *
      (eq :: Thk (Bool -> Bool -> Ret Bool)) *
      (xor :: Thk (Bool -> Bool -> Ret Bool)) *
      (nand :: Thk (Bool -> Bool -> Ret Bool)) *
      (nor :: Thk (Bool -> Bool -> Ret Bool)) *
      (if :: Thk (
        forall (B : CType) .
          Bool -> Thk B -> Thk B -> B
      ))
    in
    let OptionModule
      (Bool : VType)
      (Option : (VType) -> (VType)) =
      (none :: Thk (
        forall (A : VType) .
          Ret (Option A)
      )) *
      (some :: Thk (
        forall (A : VType) .
          A -> Ret (Option A)
      )) *
      (fold :: Thk (
        forall (A : VType) .
        forall (B : CType) .
          Option A -> Thk B -> Thk (A -> B) -> B
      )) *
      (map :: Thk (
        forall (A : VType) .
        forall (B : VType) .
          Option A -> Thk (A -> Ret B) -> Ret (Option B)
      )) *
      (and_then :: Thk (
        forall (A : VType) .
        forall (B : VType) .
          Option A ->
          Thk (A -> Ret (Option B)) ->
          Ret (Option B)
      )) *
      (unwrap_or :: Thk (
        forall (A : VType) .
          Option A -> A -> Ret A
      )) *
      (or_else :: Thk (
        forall (A : VType) .
          Option A ->
          Thk (Ret (Option A)) ->
          Ret (Option A)
      )) *
      (zip :: Thk (
        forall (A : VType) .
        forall (B : VType) .
          Option A -> Option B -> Ret (Option (A * B))
      )) *
      (is_some :: Thk (
        forall (A : VType) .
          Option A -> Ret Bool
      )) *
      (is_none :: Thk (
        forall (A : VType) .
          Option A -> Ret Bool
      ))
    in
    let ResultModule
      (Bool : VType)
      (Result : (VType) -> (VType) -> (VType)) =
      (ok :: Thk (
        forall (A : VType) .
        forall (E : VType) .
          A -> Ret (Result A E)
      )) *
      (err :: Thk (
        forall (A : VType) .
        forall (E : VType) .
          E -> Ret (Result A E)
      )) *
      (fold :: Thk (
        forall (A : VType) .
        forall (E : VType) .
        forall (B : CType) .
          Result A E -> Thk (A -> B) -> Thk (E -> B) -> B
      )) *
      (map :: Thk (
        forall (A : VType) .
        forall (B : VType) .
        forall (E : VType) .
          Result A E -> Thk (A -> Ret B) -> Ret (Result B E)
      )) *
      (map_err :: Thk (
        forall (A : VType) .
        forall (E : VType) .
        forall (F : VType) .
          Result A E -> Thk (E -> Ret F) -> Ret (Result A F)
      )) *
      (and_then :: Thk (
        forall (A : VType) .
        forall (B : VType) .
        forall (E : VType) .
          Result A E ->
          Thk (A -> Ret (Result B E)) ->
          Ret (Result B E)
      )) *
      (unwrap_or :: Thk (
        forall (A : VType) .
        forall (E : VType) .
          Result A E -> A -> Ret A
      )) *
      (is_ok :: Thk (
        forall (A : VType) .
        forall (E : VType) .
          Result A E -> Ret Bool
      )) *
      (is_err :: Thk (
        forall (A : VType) .
        forall (E : VType) .
          Result A E -> Ret Bool
      ))
    in
    let ListModule
      (Bool : VType)
      (Option : (VType) -> (VType))
      (List : (VType) -> (VType))
      (Int : VType) =
      (nil :: Thk (
        forall (A : VType) .
          Ret (List A)
      )) *
      (cons :: Thk (
        forall (A : VType) .
          A -> List A -> Ret (List A)
      )) *
      (case :: Thk (
        forall (A : VType) .
        forall (B : CType) .
          List A ->
          Thk B ->
          Thk (A -> List A -> B) ->
          B
      )) *
      (fold :: Thk (
        forall (A : VType) .
        forall (B : CType) .
          List A ->
          Thk B ->
          Thk (A -> Thk B -> B) ->
          B
      )) *
      (singleton :: Thk (
        forall (A : VType) .
          A -> Ret (List A)
      )) *
      (append :: Thk (
        forall (A : VType) .
          List A -> List A -> Ret (List A)
      )) *
      (map :: Thk (
        forall (A : VType) .
        forall (B : VType) .
          List A -> Thk (A -> Ret B) -> Ret (List B)
      )) *
      (fold_left :: Thk (
        forall (A : VType) .
        forall (B : VType) .
          List A -> B -> Thk (B -> A -> Ret B) -> Ret B
      )) *
      (reverse :: Thk (
        forall (A : VType) .
          List A -> Ret (List A)
      )) *
      (length :: Thk (
        forall (A : VType) .
          List A -> Ret Int
      )) *
      (is_empty :: Thk (
        forall (A : VType) .
          List A -> Ret Bool
      )) *
      (head :: Thk (
        forall (A : VType) .
          List A -> Ret (Option A)
      )) *
      (tail :: Thk (
        forall (A : VType) .
          List A -> Ret (Option (List A))
      )) *
      (get :: Thk (
        forall (A : VType) .
          List A -> Int -> Ret (Option A)
      ))
    in
    let IntModule (Bool : VType) (Int : VType) (String : VType) =
      (add :: Thk (Int -> Int -> Ret Int)) *
      (sub :: Thk (Int -> Int -> Ret Int)) *
      (mul :: Thk (Int -> Int -> Ret Int)) *
      (div :: Thk (Int -> Int -> Ret Int)) *
      (mod :: Thk (Int -> Int -> Ret Int)) *
      (eq :: Thk (Int -> Int -> Ret Bool)) *
      (ne :: Thk (Int -> Int -> Ret Bool)) *
      (lt :: Thk (Int -> Int -> Ret Bool)) *
      (le :: Thk (Int -> Int -> Ret Bool)) *
      (gt :: Thk (Int -> Int -> Ret Bool)) *
      (ge :: Thk (Int -> Int -> Ret Bool)) *
      (increment :: Thk (Int -> Ret Int)) *
      (decrement :: Thk (Int -> Ret Int)) *
      (negate :: Thk (Int -> Ret Int)) *
      (min :: Thk (Int -> Int -> Ret Int)) *
      (max :: Thk (Int -> Int -> Ret Int)) *
      (to_string :: Thk (Int -> Ret String))
    in
    let FloatModule (Bool : VType) (Float : VType) (String : VType) =
      (add :: Thk (Float -> Float -> Ret Float)) *
      (sub :: Thk (Float -> Float -> Ret Float)) *
      (mul :: Thk (Float -> Float -> Ret Float)) *
      (div :: Thk (Float -> Float -> Ret Float)) *
      (eq :: Thk (Float -> Float -> Ret Bool)) *
      (ne :: Thk (Float -> Float -> Ret Bool)) *
      (lt :: Thk (Float -> Float -> Ret Bool)) *
      (le :: Thk (Float -> Float -> Ret Bool)) *
      (gt :: Thk (Float -> Float -> Ret Bool)) *
      (ge :: Thk (Float -> Float -> Ret Bool)) *
      (negate :: Thk (Float -> Ret Float)) *
      (to_string :: Thk (Float -> Ret String))
    in
    let CharModule
      (Option : (VType) -> (VType))
      (Char : VType)
      (Int : VType)
      (String : VType) =
      (to_string :: Thk (Char -> Ret String)) *
      (codepoint :: Thk (Char -> Ret Int)) *
      (from_codepoint :: Thk (Int -> Ret (Option Char)))
    in
    let StringModule
      (Bool : VType)
      (Option : (VType) -> (VType))
      (List : (VType) -> (VType))
      (Int : VType)
      (Char : VType)
      (String : VType) =
      (empty :: String) *
      (length :: Thk (String -> Ret Int)) *
      (byte_length :: Thk (String -> Ret Int)) *
      (is_empty :: Thk (String -> Ret Bool)) *
      (append :: Thk (String -> String -> Ret String)) *
      (concat :: Thk (List String -> Ret String)) *
      (split_once :: Thk (
        String ->
        Char ->
        Ret (Option (String * String))
      )) *
      (split_at :: Thk (
        String ->
        Int ->
        Ret (Option (String * String))
      )) *
      (eq :: Thk (String -> String -> Ret Bool)) *
      (get :: Thk (String -> Int -> Ret (Option Char))) *
      (head :: Thk (String -> Ret (Option Char))) *
      (uncons :: Thk (
        String -> Ret (Option (Char * String))
      )) *
      (to_chars :: Thk (String -> Ret (List Char))) *
      (from_chars :: Thk (List Char -> Ret String)) *
      (parse_int :: Thk (String -> Ret (Option Int)))
    in
    let BytesModule
      (Option : (VType) -> (VType))
      (Int : VType)
      (String : VType)
      (Bytes : VType) =
      (empty :: Thk (Ret Bytes)) *
      (length :: Thk (Bytes -> Ret Int)) *
      (append :: Thk (Bytes -> Bytes -> Ret Bytes)) *
      (from_string :: Thk (String -> Ret Bytes)) *
      (to_string :: Thk (Bytes -> Ret (Option String)))
    in
    let IoModule
      (Bool : VType)
      (Option : (VType) -> (VType))
      (Result : (VType) -> (VType) -> (VType))
      (Int : VType)
      (String : VType)
      (Bytes : VType)
      (Reader : VType)
      (Writer : VType)
      (IoErrorKind : VType)
      (IoError : VType)
      (OS : CType) =
      (not_found :: IoErrorKind) *
      (permission_denied :: IoErrorKind) *
      (already_exists :: IoErrorKind) *
      (invalid_input :: IoErrorKind) *
      (invalid_data :: IoErrorKind) *
      (broken_pipe :: IoErrorKind) *
      (closed :: IoErrorKind) *
      (other :: IoErrorKind) *
      (kind_eq :: Thk (
        IoErrorKind -> IoErrorKind -> Ret Bool
      )) *
      (error_kind :: Thk (IoError -> Ret IoErrorKind)) *
      (error_message :: Thk (IoError -> Ret String)) *
      (read :: Thk (
        Reader -> Int ->
        Thk (Result Bytes IoError -> OS) ->
        OS
      )) *
      (read_line :: Thk (
        Reader ->
        Thk (Result (Option Bytes) IoError -> OS) ->
        OS
      )) *
      (read_all :: Thk (
        Reader ->
        Thk (Result Bytes IoError -> OS) ->
        OS
      )) *
      (write_all :: Thk (
        Writer -> Bytes ->
        Thk (Result Unit IoError -> OS) ->
        OS
      )) *
      (flush :: Thk (
        Writer ->
        Thk (Result Unit IoError -> OS) ->
        OS
      )) *
      (close_reader :: Thk (
        Reader ->
        Thk (Result Unit IoError -> OS) ->
        OS
      )) *
      (close_writer :: Thk (
        Writer ->
        Thk (Result Unit IoError -> OS) ->
        OS
      ))
    in
    let FsModule
      (Result : (VType) -> (VType) -> (VType))
      (String : VType)
      (Bytes : VType)
      (Reader : VType)
      (Writer : VType)
      (Path : VType)
      (IoError : VType)
      (OS : CType) =
      (path :: Thk (String -> Ret Path)) *
      (path_string :: Thk (Path -> Ret String)) *
      (open_reader :: Thk (
        Path ->
        Thk (Result Reader IoError -> OS) ->
        OS
      )) *
      (create_writer :: Thk (
        Path ->
        Thk (Result Writer IoError -> OS) ->
        OS
      )) *
      (append_writer :: Thk (
        Path ->
        Thk (Result Writer IoError -> OS) ->
        OS
      )) *
      (read_bytes :: Thk (
        Path ->
        Thk (Result Bytes IoError -> OS) ->
        OS
      )) *
      (read_text :: Thk (
        Path ->
        Thk (Result String IoError -> OS) ->
        OS
      )) *
      (write_bytes :: Thk (
        Path -> Bytes ->
        Thk (Result Unit IoError -> OS) ->
        OS
      )) *
      (write_text :: Thk (
        Path -> String ->
        Thk (Result Unit IoError -> OS) ->
        OS
      ))
    in
    let StdioModule
      (Option : (VType) -> (VType))
      (Result : (VType) -> (VType) -> (VType))
      (String : VType)
      (Reader : VType)
      (Writer : VType)
      (IoError : VType)
      (OS : CType) =
      (stdin :: Thk (Ret Reader)) *
      (stdout :: Thk (Ret Writer)) *
      (stderr :: Thk (Ret Writer)) *
      (read_line :: Thk (
        Thk (Result (Option String) IoError -> OS) ->
        OS
      )) *
      (write :: Thk (
        String ->
        Thk (Result Unit IoError -> OS) ->
        OS
      )) *
      (write_line :: Thk (
        String ->
        Thk (Result Unit IoError -> OS) ->
        OS
      )) *
      (write_error :: Thk (
        String ->
        Thk (Result Unit IoError -> OS) ->
        OS
      )) *
      (write_error_line :: Thk (
        String ->
        Thk (Result Unit IoError -> OS) ->
        OS
      ))
    in
    let ProcessModule
      (List : (VType) -> (VType))
      (Int : VType)
      (String : VType)
      (OS : CType) =
      (arg_list :: Thk (Thk (List String -> OS) -> OS)) *
      (random_int :: Thk (Thk (Int -> OS) -> OS)) *
      (halt :: Thk OS) *
      (panic :: Thk (String -> OS)) *
      (exit :: Thk (Int -> OS))
    in
    let Std =
      exists (Bool = BoolType : VType) .
      exists (
        Option = OptionType :
        (VType) -> (VType)
      ) .
      exists (
        Result = ResultType :
        (VType) -> (VType) -> (VType)
      ) .
      exists (
        List = ListType :
        (VType) -> (VType)
      ) .
      exists (Int = IntType as Int : VType) .
      exists (Float = FloatType as Float : VType) .
      exists (Char = CharType as Char : VType) .
      exists (String = StringType as String : VType) .
      exists (Bytes = BytesType as Bytes : VType) .
      exists (Reader = ReaderType as Reader : VType) .
      exists (Writer = WriterType as Writer : VType) .
      exists (Path = PathType : VType) .
      exists (IoErrorKind = IoErrorKindType : VType) .
      exists (IoError = IoErrorType : VType) .
      exists (OS = OSType as OS : CType) .
        (prelude :: Prelude) *
        (bool :: BoolModule BoolType) *
        (option :: OptionModule BoolType OptionType) *
        (result :: ResultModule BoolType ResultType) *
        (list :: ListModule BoolType OptionType ListType IntType) *
        (int :: IntModule BoolType IntType StringType) *
        (float :: FloatModule BoolType FloatType StringType) *
        (char :: CharModule OptionType CharType IntType StringType) *
        (string :: StringModule
          BoolType OptionType ListType IntType CharType StringType) *
        (bytes :: BytesModule OptionType IntType StringType BytesType) *
        (io :: IoModule
          BoolType OptionType ResultType IntType StringType BytesType ReaderType
          WriterType IoErrorKindType IoErrorType OSType) *
        (fs :: FsModule
          ResultType StringType BytesType ReaderType WriterType PathType IoErrorType
          OSType) *
        (stdio :: StdioModule
          OptionType ResultType StringType ReaderType WriterType IoErrorType OSType) *
        (process :: ProcessModule ListType IntType StringType OSType) *
        Unit
    in
    let Interface =
      exists (Prelude = PreludeType as Prelude : VType) .
      exists (Std = PackageType as Std : VType) .
        Unit
    in
    ((Prelude = Prelude, Std = Std, ()) : Interface)
end
