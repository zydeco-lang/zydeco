-- The public standard-library package type, kept separate from its implementation.
begin
  let make_data_interface = @[import("interface/data.zy")] _ that
  let make_numeric_interface = @[import("interface/numeric.zy")] _ that
  let make_text_interface = @[import("interface/text.zy")] _ that
  let make_system_interface = @[import("interface/system.zy")] _ that

  begin
    param (
      (/core; /representations; /system) :
      @[import("builtin.zy")] _
    ) in
    let (/VType; /CType; /Thk; /Ret; /Unit) = core in
    let (/Scalar = Int8) = representations/i8 in
    let (/Scalar = Int16) = representations/i16 in
    let (/Scalar = Int32) = representations/i32 in
    let (/Scalar = Int64) = representations/i64 in
    let (/Scalar = UInt8) = representations/u8 in
    let (/Scalar = UInt16) = representations/u16 in
    let (/Scalar = UInt32) = representations/u32 in
    let (/Scalar = UInt64) = representations/u64 in
    let (/Scalar = Float32) = representations/f32 in
    let (/Scalar = Float64) = representations/f64 in
    let (/Scalar = Char) = representations/char in
    let (/Scalar = String) = representations/string in
    let (/Scalar = Bytes) = representations/bytes in
    let (/Reader; /Writer; /OS) = system in
    let (
      = Prelude,
      = BoolModule,
      = OptionModule,
      = ResultModule,
      = ListModule,
      = DataPackage,
      ()
    ) = make_data_interface core in
    let (
      = Additive,
      = Multiplicative,
      = PartialEquality,
      = PartialOrder,
      = Numeric,
      = NumericInstance,
      = PrimitiveIntegerModule,
      = PrimitiveFloatModule,
      = IntegerModule,
      = FloatModule,
      ()
    ) = make_numeric_interface core in
    let (
      = CharModule,
      = StringModule,
      = BytesModule,
      ()
    ) = make_text_interface core in
    let (
      = IoModule,
      = FsModule,
      = StdioModule,
      = ProcessModule,
      ()
    ) = make_system_interface core in
    let Std =
      exists (Bool = BoolType : VType) .
        exists
          (
            Option = OptionType :
            VType -> VType
          )
        .
          exists
            (
              Result = ResultType :
              VType -> VType -> VType
            )
          .
            exists
              (
                List = ListType :
                VType -> VType
              )
            .
              exists (Int8 = Int8Type as Int8 : VType) .
                exists (Int16 = Int16Type as Int16 : VType) .
                  exists (Int32 = Int32Type as Int32 : VType) .
                    exists (Int64 = Int64Type as Int64 : VType) .
                      exists (UInt8 = UInt8Type as UInt8 : VType) .
                        exists (UInt16 = UInt16Type as UInt16 : VType) .
                          exists (UInt32 = UInt32Type as UInt32 : VType) .
                            exists (UInt64 = UInt64Type as UInt64 : VType) .
                              exists (Float32 = Float32Type as Float32 : VType) .
                                exists (Float64 = Float64Type as Float64 : VType) .
                                  exists (Char = CharType as Char : VType) .
                                    exists (String = StringType as String : VType) .
                                      exists (Bytes = BytesType as Bytes : VType) .
                                        exists (Reader = ReaderType as Reader : VType) .
                                          exists (Writer = WriterType as Writer : VType) .
                                            exists (Path = PathType : VType) .
                                              exists (IoErrorKind = IoErrorKindType : VType) .
                                                exists (IoError = IoErrorType : VType) .
                                                  exists (OS = OSType as OS : CType) .
                                                    exists
                                                      (
                                                        Additive = AdditiveType as Additive :
                                                        VType -> VType
                                                      )
                                                    .
                                                      exists
                                                        (
                                                          Multiplicative = MultiplicativeType as
                                                          Multiplicative :
                                                          VType -> VType
                                                        )
                                                      .
                                                        exists
                                                          (
                                                            PartialEquality = PartialEqualityType as
                                                            PartialEquality :
                                                            VType -> VType -> VType
                                                          )
                                                        .
                                                          exists
                                                            (
                                                              PartialOrder = PartialOrderType as
                                                              PartialOrder :
                                                              VType -> VType -> VType
                                                            )
                                                          .
                                                            exists
                                                              (
                                                                Numeric = NumericType as Numeric :
                                                                VType -> VType -> VType
                                                              )
                                                            .
                                                              exists
                                                                (
                                                                  NumericInstance =
                                                                  NumericInstanceType as
                                                                  NumericInstance :
                                                                  VType -> VType -> VType
                                                                )
                                                              .
                                                                  (prelude :: Prelude)
                                                                * (bool :: BoolModule BoolType)
                                                                * (
                                                                    option :: OptionModule BoolType
                                                                      OptionType
                                                                  )
                                                                * (
                                                                    result :: ResultModule BoolType
                                                                      ResultType
                                                                  )
                                                                * (
                                                                    list :: ListModule BoolType
                                                                      OptionType ListType Int64Type
                                                                  )
                                                                * (
                                                                    numeric ::
                                                                      (
                                                                        int8_instance ::
                                                                        NumericInstanceType BoolType
                                                                          Int8Type
                                                                      )
                                                                    * (
                                                                        int16_instance ::
                                                                        NumericInstanceType BoolType
                                                                          Int16Type
                                                                      )
                                                                    * (
                                                                        int32_instance ::
                                                                        NumericInstanceType BoolType
                                                                          Int32Type
                                                                      )
                                                                    * (
                                                                        int64_instance ::
                                                                        NumericInstanceType BoolType
                                                                          Int64Type
                                                                      )
                                                                    * (
                                                                        uint8_instance ::
                                                                        NumericInstanceType BoolType
                                                                          UInt8Type
                                                                      )
                                                                    * (
                                                                        uint16_instance ::
                                                                        NumericInstanceType BoolType
                                                                          UInt16Type
                                                                      )
                                                                    * (
                                                                        uint32_instance ::
                                                                        NumericInstanceType BoolType
                                                                          UInt32Type
                                                                      )
                                                                    * (
                                                                        uint64_instance ::
                                                                        NumericInstanceType BoolType
                                                                          UInt64Type
                                                                      )
                                                                    * (
                                                                        float32_instance ::
                                                                        NumericInstanceType BoolType
                                                                          Float32Type
                                                                      )
                                                                    * (
                                                                        float64_instance ::
                                                                        NumericInstanceType BoolType
                                                                          Float64Type
                                                                      )
                                                                    * Unit
                                                                  )
                                                                * (
                                                                    primitives ::
                                                                      (
                                                                        i8 :: PrimitiveIntegerModule
                                                                          Int8Type StringType
                                                                      )
                                                                    * (
                                                                        i16 ::
                                                                        PrimitiveIntegerModule
                                                                          Int16Type StringType
                                                                      )
                                                                    * (
                                                                        i32 ::
                                                                        PrimitiveIntegerModule
                                                                          Int32Type StringType
                                                                      )
                                                                    * (
                                                                        i64 ::
                                                                        PrimitiveIntegerModule
                                                                          Int64Type StringType
                                                                      )
                                                                    * (
                                                                        u8 :: PrimitiveIntegerModule
                                                                          UInt8Type StringType
                                                                      )
                                                                    * (
                                                                        u16 ::
                                                                        PrimitiveIntegerModule
                                                                          UInt16Type StringType
                                                                      )
                                                                    * (
                                                                        u32 ::
                                                                        PrimitiveIntegerModule
                                                                          UInt32Type StringType
                                                                      )
                                                                    * (
                                                                        u64 ::
                                                                        PrimitiveIntegerModule
                                                                          UInt64Type StringType
                                                                      )
                                                                    * (
                                                                        f32 :: PrimitiveFloatModule
                                                                          Float32Type StringType
                                                                      )
                                                                    * (
                                                                        f64 :: PrimitiveFloatModule
                                                                          Float64Type StringType
                                                                      )
                                                                    * Unit
                                                                  )
                                                                * (
                                                                    int8 :: IntegerModule BoolType
                                                                      Int8Type StringType
                                                                  )
                                                                * (
                                                                    int16 :: IntegerModule BoolType
                                                                      Int16Type StringType
                                                                  )
                                                                * (
                                                                    int32 :: IntegerModule BoolType
                                                                      Int32Type StringType
                                                                  )
                                                                * (
                                                                    int64 :: IntegerModule BoolType
                                                                      Int64Type StringType
                                                                  )
                                                                * (
                                                                    uint8 :: IntegerModule BoolType
                                                                      UInt8Type StringType
                                                                  )
                                                                * (
                                                                    uint16 :: IntegerModule BoolType
                                                                      UInt16Type StringType
                                                                  )
                                                                * (
                                                                    uint32 :: IntegerModule BoolType
                                                                      UInt32Type StringType
                                                                  )
                                                                * (
                                                                    uint64 :: IntegerModule BoolType
                                                                      UInt64Type StringType
                                                                  )
                                                                * (
                                                                    float32 :: FloatModule BoolType
                                                                      Float32Type StringType
                                                                  )
                                                                * (
                                                                    float64 :: FloatModule BoolType
                                                                      Float64Type StringType
                                                                  )
                                                                * (
                                                                    char :: CharModule OptionType
                                                                      CharType Int64Type StringType
                                                                  )
                                                                * (
                                                                    string :: StringModule
                                                                      BoolType OptionType ListType
                                                                      Int64Type CharType StringType
                                                                  )
                                                                * (
                                                                    bytes :: BytesModule OptionType
                                                                      Int64Type StringType BytesType
                                                                  )
                                                                * (
                                                                    io :: IoModule
                                                                      BoolType OptionType ResultType
                                                                      Int64Type StringType BytesType
                                                                      ReaderType
                                                                      WriterType IoErrorKindType
                                                                      IoErrorType OSType
                                                                  )
                                                                * (
                                                                    fs :: FsModule
                                                                      ResultType StringType
                                                                      BytesType ReaderType
                                                                      WriterType PathType
                                                                      IoErrorType
                                                                      OSType
                                                                  )
                                                                * (
                                                                    stdio :: StdioModule
                                                                      OptionType ResultType
                                                                      StringType ReaderType
                                                                      WriterType IoErrorType OSType
                                                                  )
                                                                * (
                                                                    process :: ProcessModule
                                                                      ListType Int64Type StringType
                                                                      OSType
                                                                  )
                                                                * Unit
    in
    let Interface =
      exists (Prelude = PreludeType as Prelude : VType) .
        exists
          (
            Additive = AdditiveType as Additive :
            VType -> VType
          )
        .
          exists
            (
              Multiplicative = MultiplicativeType as Multiplicative :
              VType -> VType
            )
          .
            exists
              (
                PartialEquality = PartialEqualityType as PartialEquality :
                VType -> VType -> VType
              )
            .
              exists
                (
                  PartialOrder = PartialOrderType as PartialOrder :
                  VType -> VType -> VType
                )
              .
                exists
                  (
                    Numeric = NumericType as Numeric :
                    VType -> VType -> VType
                  )
                .
                  exists
                    (
                      NumericInstance = NumericInstanceType as NumericInstance :
                      VType -> VType -> VType
                    )
                  .
                    exists
                      (
                        IntegerModule = IntegerModuleType as IntegerModule :
                        VType -> VType -> VType -> VType
                      )
                    .
                      exists
                        (
                          FloatModule = FloatModuleType as FloatModule :
                          VType -> VType -> VType -> VType
                        )
                      .
                        exists
                          (
                            PrimitiveIntegerModule = PrimitiveIntegerModuleType as
                            PrimitiveIntegerModule :
                            VType -> VType -> VType
                          )
                        .
                          exists
                            (
                              PrimitiveFloatModule = PrimitiveFloatModuleType as
                              PrimitiveFloatModule :
                              VType -> VType -> VType
                            )
                          .
                            exists (Std = PackageType as Std : VType) .
                              Unit
    in
    (
      (
        = Prelude,
        = Additive,
        = Multiplicative,
        = PartialEquality,
        = PartialOrder,
        = Numeric,
        = NumericInstance,
        = IntegerModule,
        = FloatModule,
        = PrimitiveIntegerModule,
        = PrimitiveFloatModule,
        = Std,
        ()
      )
      : Interface
    )
  end
end
