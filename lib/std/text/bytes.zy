-- Contiguous immutable bytes with explicit retention and no per-copy reference counting.
begin
  param val (
    /VType;
    /CType;
    /Thk;
    /Ret;
    /Unit;
    /Addr;
    /Int;
    /UInt8;
    /String;
    /memory;
    /numeric;
    builtin
  ) : @(import("../builtin.zy")) that
  let Package = @(import("bytes.type.zy")) in
  let (/Fault; /allocate; /unsafe) = builtin |> (@(import("../memory/native.zy"))) in
  let int = numeric/int in
  let octet = numeric/uint8 in
  let Bytes = Addr * Int in
  let panic : Thk (Ret Bytes) = {
    @[partial]
    let 0 = 1 in
    do p <- ! memory/null;
    ret (p, 0)
  } in
  let empty : Thk (Ret Bytes) = {
    do p <- ! memory/null;
    ret (p, 0)
  } in
  let length : Thk (Bytes -> Ret Int) = { fn ((_, count) : Bytes) => ret count } in
  let from_retained : Thk (
    forall (R : CType) . Addr -> Int -> Thk (Fault -> R) -> Thk (Bytes -> R) -> R
  ) = {
    fn (R : CType) (p : Addr) (count : Int) (no : Thk (Fault -> R)) yes =>
      ! int/lt R count 0 { ! no +Bounds() } { ! yes (p, count) }
  } in
  let with_window : Thk (
    forall (R : CType) . Bytes -> Thk (Fault -> R) -> Thk (Addr -> Int -> R) -> R
  ) = { fn (R : CType) ((p, count) : Bytes) (_ : Thk (Fault -> R)) yes => ! yes p count } in
  let copy_to : Thk (forall (R : CType) . Bytes -> Addr -> Thk R -> R) = {
    fn (R : CType) ((p, count) : Bytes) target done => ! unsafe/copy R p target count done
  } in
  -- Fill callbacks must initialize every byte and complete exactly once. Neither this
  -- ordinary thunk type nor raw memory enforces that contract or prevents escaped aliases.
  let build : Thk (
    forall (R : CType) .
      Int -> Int -> Thk (Addr -> Thk (Fault -> R) -> Thk R -> R) -> Thk (Fault -> R) -> Thk (
        Bytes -> R
      ) -> R
  ) = {
    fn (R : CType) (count : Int) (alignment : Int)
      (fill : Thk (Addr -> Thk (Fault -> R) -> Thk R -> R)) (no : Thk (Fault -> R)) yes
    =>
      ! allocate R count alignment no {
        fn p =>
          let fail = {
            fn fault => ! unsafe/free R p count alignment { fn _ => ! no fault } { ! no fault }
          } in
          ! fill p fail { ! unsafe/retain R p count alignment fail { ! yes (p, count) } }
      }
  } in
  let from_string : Thk (String -> Ret Bytes) = {
    fn (value : String) =>
      ! memory/from_string (Ret Bytes) value { fn _ => ! panic } { fn p count => ret (p, count) }
  } in
  let singleton : Thk (UInt8 -> Ret Bytes) = {
    fn (value : UInt8) =>
      ! build (Ret Bytes) 1 1 { fn p _ done => ! unsafe/store_u8 (Ret Bytes) p value done }
        { fn _ => ! panic } { fn value => ret value }
  } in
  let to_string : Thk (forall (R : CType) . Bytes -> Thk R -> Thk (String -> R) -> R) = {
    fn (R : CType) ((p, count) : Bytes) no yes =>
      ! memory/to_string R p count { fn _ => ! no } yes
  } in
  let get : Thk (forall (R : CType) . Bytes -> Int -> Thk R -> Thk (UInt8 -> R) -> R) = {
    fn (R : CType) ((p, count) : Bytes) (index : Int) no yes =>
      ! int/lt R index 0 no {
        ! int/lt R index count {
          do target <- ! unsafe/offset p index;
          ! unsafe/load_u8 R target yes
        } no
      }
  } in
  let slice : Thk (forall (R : CType) . Bytes -> Int -> Int -> Thk R -> Thk (Bytes -> R) -> R) =
    {
      fn (R : CType) ((p, count) : Bytes) (start : Int) (size : Int) no yes =>
        ! int/lt R start 0 no {
          ! int/lt R size 0 no {
            ! int/gt R start count no {
              do remaining <- ! int/sub count start;
              ! int/gt R size remaining no {
                do target <- ! unsafe/offset p start;
                ! yes (target, size)
              }
            }
          }
        }
    }
  in
  let append : Thk (Bytes -> Bytes -> Ret Bytes) = {
    fn (left : Bytes) (right : Bytes) =>
      do first <- ! length left;
      do second <- ! length right;
      do remaining <- ! int/sub 4611686018427387903 first;
      ! int/gt (Ret Bytes) second remaining panic {
        do count <- ! int/add first second;
        ! build (Ret Bytes) count 1 {
          fn p _ done =>
            ! copy_to (Ret Bytes) left p {
              do target <- ! unsafe/offset p first;
              ! copy_to (Ret Bytes) right target done
            }
        } { fn _ => ! panic } { fn value => ret value }
      }
  } in
  let aligned : Thk (forall (R : CType) . Bytes -> Int -> Thk R -> Thk (Bytes -> R) -> R) = {
    fn (R : CType) (value : Bytes) (alignment : Int) no yes =>
      do count <- ! length value;
      ! build R count alignment { fn p _ done => ! copy_to R value p done } { fn _ => ! no } yes
  } in
  let compare : Thk (forall (R : CType) . Bytes -> Bytes -> Thk R -> Thk R -> Thk R -> R) = {
    fn (R : CType) (left : Bytes) (right : Bytes) less equal greater =>
      do first <- ! length left;
      do second <- ! length right;
      let fix at (index : Int) : R =
        ! int/eq R index first { ! int/eq R index second equal less } {
          ! int/eq R index second greater {
            ! get R left index greater {
              fn a =>
                ! get R right index less {
                  fn b =>
                    ! octet/eq R a b {
                      do next <- ! int/add index 1;
                      ! at next
                    } { ! octet/lt R a b less greater }
                }
            }
          }
        }
      in
      ! at 0
  } in
  let eq : Thk (forall (R : CType) . Bytes -> Bytes -> Thk R -> Thk R -> R) = {
    fn (R : CType) (left : Bytes) (right : Bytes) yes no => ! compare R left right no yes no
  } in
  let lt : Thk (forall (R : CType) . Bytes -> Bytes -> Thk R -> Thk R -> R) = {
    fn (R : CType) (left : Bytes) (right : Bytes) yes no => ! compare R left right yes no no
  } in
  (
    (
      = Bytes,
      #bytes = (
        = empty,
        = length,
        = append,
        = from_string,
        = singleton,
        = to_string,
        = get,
        = slice,
        = eq,
        = lt,
        = aligned,
        #unsafe = (= from_retained, = with_window, = copy_to, = build)
      )
    ) : Package Addr
  )
end
