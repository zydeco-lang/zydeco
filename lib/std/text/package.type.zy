begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let CharModule = @(import("char.type.zy")) in
  let StringModule = @(import("string.type.zy")) in
  let BytesModule = @(import("bytes.type.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let Int64 = @(import("../builtin/intrinsic/i64.zy")) in
  let Char = @(import("../builtin/intrinsic/char.zy")) in
  let String = @(import("../builtin/intrinsic/string.zy")) in
  let Bytes = @(import("../builtin/intrinsic/bytes.zy")) in
  let Package (Bool : VType)
    (
      Option : VType -> (
        VType
      )
    )
    (
      List : VType -> (
        VType
      )
    ) =
      (char :: CharModule Option Char Int64 String)
    * (string :: StringModule Bool Option List Int64 Char String)
    * (bytes :: BytesModule Option Int64 String Bytes)
    * Unit
  in
  Package
end
