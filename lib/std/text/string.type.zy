begin
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let StringModule (Bool : @(import("../builtin/intrinsic/vtype.zy")))
    (
      Option : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      )
    )
    (
      List : (@(import("../builtin/intrinsic/vtype.zy"))) -> (
        @(import("../builtin/intrinsic/vtype.zy"))
      )
    )
    (Int64 : @(import("../builtin/intrinsic/vtype.zy")))
    (Char : @(import("../builtin/intrinsic/vtype.zy")))
    (String : @(import("../builtin/intrinsic/vtype.zy"))) =
      (empty :: String)
    * (length :: Thk (String -> Ret Int64))
    * (byte_length :: Thk (String -> Ret Int64))
    * (is_empty :: Thk (String -> Ret Bool))
    * (append :: Thk (String -> String -> Ret String))
    * (concat :: Thk (List String -> Ret String))
    * (
        split_once :: Thk (
             String
          -> Char
          -> Ret (Option (String * String))
        )
      )
    * (
        split_at :: Thk (
             String
          -> Int64
          -> Ret (Option (String * String))
        )
      )
    * (eq :: Thk (String -> String -> Ret Bool))
    * (get :: Thk (String -> Int64 -> Ret (Option Char)))
    * (head :: Thk (String -> Ret (Option Char)))
    * (
        uncons :: Thk (
          String -> Ret (Option (Char * String))
        )
      )
    * (to_chars :: Thk (String -> Ret (List Char)))
    * (from_chars :: Thk (List Char -> Ret String))
    * (parse_int :: Thk (String -> Ret (Option Int64)))
  in
  StringModule
end
