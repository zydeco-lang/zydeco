begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let BytesModule
    (
      Option : VType -> (
        VType
      )
    )
    (Int64 : VType)
    (String : VType)
    (Bytes : VType) =
      (empty :: Thk (Ret Bytes))
    * (length :: Thk (Bytes -> Ret Int64))
    * (append :: Thk (Bytes -> Bytes -> Ret Bytes))
    * (from_string :: Thk (String -> Ret Bytes))
    * (to_string :: Thk (Bytes -> Ret (Option String)))
  in
  BytesModule
end
