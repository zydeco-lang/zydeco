begin
  param val (
    (/core; /representations; /numeric; /text; builtin) : @(import("../builtin.zy")),
    (/Bool; /Option; /List; /bool; /option; /list) : @(import("../data/package.type.zy"))
  ) that
  let (/VType; /CType; /Thk; /Ret; /Unit) = core in
  let (/Char) = representations/char in
  let (/String) = representations/string in
  let (/Bytes) = representations/bytes in
  let (/UInt8) = representations/u8 in
  let (= Int64, int64) = numeric/int64 in
  let (/char; /string; /bytes) = text in
  let ! compare (A : VType)
    (
      predicate : Thk (
        forall (B : CType) . A -> A -> Thk B -> Thk B -> B
      )
    )
    (left : A)
    (right : A)
  : Ret Bool = ! predicate
      (Ret Bool)
      left
      right
      { ret bool/true }
      { ret bool/false }
  in
  let ! int64_eq (left : Int64) (right : Int64) : Ret Bool = ! compare Int64 int64/eq left right in
  let ! int64_lt (left : Int64) (right : Int64) : Ret Bool = ! compare Int64 int64/lt left right in
  let ! str_eq (left : String) (right : String) : Ret Bool = ! compare String string/eq left right
  in
  let ! str_split_once (value : String)
    (separator : Char)
  : Ret (Option (String * String)) = ! string/split_once
      (Ret (Option (String * String)))
      value
      separator
      { ! option/none (String * String) }
      {
        fn first second => ! option/some (String * String) (first, second)
      }
  in
  let ! str_split_at (value : String)
    (index : Int64)
  : Ret (Option (String * String)) = ! string/split_at
      (Ret (Option (String * String)))
      value
      index
      { ! option/none (String * String) }
      {
        fn first second => ! option/some (String * String) (first, second)
      }
  in
  let ! str_get (value : String) (index : Int64) : Ret (Option Char) = ! string/get
    (Ret (Option Char))
    value
    index
    { ! option/none Char }
    {
      fn character => ! option/some Char character
    } in
  let ! char_from_codepoint (codepoint : Int64) : Ret (Option Char) = ! char/from_codepoint
    (Ret (Option Char))
    codepoint
    { ! option/none Char }
    {
      fn character => ! option/some Char character
    } in
  let ! str_parse_int (value : String) : Ret (Option Int64) = ! string/parse_int
    (Ret (Option Int64))
    value
    { ! option/none Int64 }
    {
      fn integer => ! option/some Int64 integer
    } in
  let ! str_is_empty (value : String) : Ret Bool =
    do length <- ! string/length value;
    ! int64_eq length 0
  in
  let ! str_head (value : String) : Ret (Option Char) = ! str_get value 0 in
  let ! str_uncons (value : String) : Ret (Option (Char * String)) =
    do character <- ! str_get value 0;
    ! option/and_then
      Char
      (Char * String)
      character
      {
        fn head =>
          do split <- ! str_split_at value 1;
          ! option/map
            (String * String)
            (Char * String)
            split
            { fn (_, tail) => ret (head, tail) }
      }
  in
  let fix str_to_chars (value : String) : Ret (List Char) =
    do first <- ! str_uncons value;
    ! option/fold
      (Char * String)
      (Ret (List Char))
      first
      { ! list/nil Char }
      {
        fn (head, tail) =>
          do rest <- ! str_to_chars tail;
          ! list/cons Char head rest
      }
  in
  let fix str_from_chars (characters : List Char) : Ret String = ! list/case
    Char
    (Ret String)
    characters
    { ret "" }
    {
      fn head tail =>
        do first <- ! char/to_string head;
        do rest <- ! str_from_chars tail;
        ! string/append first rest
    } in
  let ! str_concat (strings : List String) : Ret String = ! list/fold
    String
    (Ret String)
    strings
    { ret "" }
    {
      fn head tail =>
        do rest <- ! tail;
        ! string/append head rest
    } in
  let ! bytes_to_string (value : Bytes) : Ret (Option String) = ! bytes/to_string
    (Ret (Option String))
    value
    { ! option/none String }
    {
      fn string => ! option/some String string
    } in
  let ! bytes_get (value : Bytes) (index : Int64) : Ret (Option UInt8) = ! bytes/get
    (Ret (Option UInt8))
    value
    index
    { ! option/none UInt8 }
    {
      fn octet => ! option/some UInt8 octet
    } in
  let ! bytes_slice (value : Bytes)
    (start : Int64)
    (length : Int64)
  : Ret (Option Bytes) = ! bytes/slice
      (Ret (Option Bytes))
      value
      start
      length
      { ! option/none Bytes }
      {
        fn window => ! option/some Bytes window
      }
  in
  let ! bytes_singleton (octet : UInt8) : Ret Bytes = ! bytes/singleton octet in
  let ! bytes_eq (left : Bytes) (right : Bytes) : Ret Bool = ! compare Bytes bytes/eq left right in
  let ! bytes_lt (left : Bytes) (right : Bytes) : Ret Bool = ! compare Bytes bytes/lt left right in
  let ! bytes_gt (left : Bytes) (right : Bytes) : Ret Bool = ! compare Bytes bytes/lt right left in
  let ! bytes_le (left : Bytes) (right : Bytes) : Ret Bool =
    do greater <- ! bytes_gt left right;
    ! bool/not greater
  in
  let ! bytes_ge (left : Bytes) (right : Bytes) : Ret Bool =
    do less <- ! bytes_lt left right;
    ! bool/not less
  in
  let ! bytes_is_empty (value : Bytes) : Ret Bool =
    do length <- ! bytes/length value;
    ! int64_eq length 0
  in
  let fix bytes_to_list_from (value : Bytes) (index : Int64) : Ret (List UInt8) =
    do octet <- ! bytes_get value index;
    ! option/fold
      UInt8
      (Ret (List UInt8))
      octet
      { ! list/nil UInt8 }
      {
        fn head =>
          do successor <- ! int64/add index 1;
          do tail <- ! bytes_to_list_from value successor;
          ! list/cons UInt8 head tail
      }
  in
  let ! bytes_to_list (value : Bytes) : Ret (List UInt8) = ! bytes_to_list_from value 0 in
  let ! bytes_from_list (octets : List UInt8) : Ret Bytes = ! list/fold
    UInt8
    (Ret Bytes)
    octets
    { ! bytes/empty }
    {
      fn octet rest =>
        do tail <- ! rest;
        do one <- ! bytes_singleton octet;
        ! bytes/append one tail
    } in
  let ! bytes_concat (buffers : List Bytes) : Ret Bytes = ! list/fold
    Bytes
    (Ret Bytes)
    buffers
    { ! bytes/empty }
    {
      fn head tail =>
        do rest <- ! tail;
        ! bytes/append head rest
    } in
  let ! bytes_starts_with (value : Bytes) (prefix : Bytes) : Ret Bool =
    do value_length <- ! bytes/length value;
    do prefix_length <- ! bytes/length prefix;
    do too_short <- ! int64_lt value_length prefix_length;
    do fits <- ! bool/not too_short;
    ! bool/if
      (Ret Bool)
      fits
      {
        do window <- ! bytes_slice value 0 prefix_length;
        ! option/fold
          Bytes
          (Ret Bool)
          window
          { ret bool/false }
          {
            fn candidate => ! bytes_eq candidate prefix
          }
      }
      { ret bool/false }
  in
  let ! bytes_ends_with (value : Bytes) (suffix : Bytes) : Ret Bool =
    do value_length <- ! bytes/length value;
    do suffix_length <- ! bytes/length suffix;
    do too_short <- ! int64_lt value_length suffix_length;
    do fits <- ! bool/not too_short;
    ! bool/if
      (Ret Bool)
      fits
      {
        do offset <- ! int64/sub value_length suffix_length;
        do window <- ! bytes_slice value offset suffix_length;
        ! option/fold
          Bytes
          (Ret Bool)
          window
          { ret bool/false }
          {
            fn candidate => ! bytes_eq candidate suffix
          }
      }
      { ret bool/false }
  in
  (
    #char = (
      #to_string = char/to_string,
      #codepoint = char/codepoint,
      #from_codepoint = char_from_codepoint
    ),
    #string = (
      #empty = "",
      #length = string/length,
      #byte_length = string/byte_length,
      #is_empty = str_is_empty,
      #append = string/append,
      #concat = str_concat,
      #split_once = str_split_once,
      #split_at = str_split_at,
      #eq = str_eq,
      #get = str_get,
      #head = str_head,
      #uncons = str_uncons,
      #to_chars = str_to_chars,
      #from_chars = str_from_chars,
      #parse_int = str_parse_int
    ),
    #bytes = (
      #empty = bytes/empty,
      #length = bytes/length,
      #is_empty = bytes_is_empty,
      #append = bytes/append,
      #concat = bytes_concat,
      #get = bytes_get,
      #slice = bytes_slice,
      #singleton = bytes_singleton,
      #from_list = bytes_from_list,
      #to_list = bytes_to_list,
      #eq = bytes_eq,
      #lt = bytes_lt,
      #gt = bytes_gt,
      #le = bytes_le,
      #ge = bytes_ge,
      #from_string = bytes/from_string,
      #to_string = bytes_to_string,
      #starts_with = bytes_starts_with,
      #ends_with = bytes_ends_with
    )
  )
end
