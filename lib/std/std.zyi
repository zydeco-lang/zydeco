begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Unit = @(intrinsic(unit)) in
  let Int8 = @(intrinsic(i8)) in
  let Int16 = @(intrinsic(i16)) in
  let Int32 = @(intrinsic(i32)) in
  let Int64 = @(intrinsic(i64)) in
  let UInt8 = @(intrinsic(u8)) in
  let UInt16 = @(intrinsic(u16)) in
  let UInt32 = @(intrinsic(u32)) in
  let UInt64 = @(intrinsic(u64)) in
  let Float32 = @(intrinsic(f32)) in
  let Float64 = @(intrinsic(f64)) in
  let Char = @(intrinsic(char)) in
  let String = @(intrinsic(string)) in
  let Bytes = @(intrinsic(bytes)) in
  let DataBody = @(import("data/body.type.zy")) in
  let TextBody = @(import("text/body.type.zy")) in
  let SystemBody = @(import("system/body.type.zy")) in
  let NumericBody = @(import("numeric/body.type.zy")) in
  let Prelude = @(import("data/prelude.type.zy")) in
  let Additive = @(import("numeric/additive.type.zy")) in
  let Multiplicative = @(import("numeric/multiplicative.type.zy")) in
  let PartialEquality = @(import("numeric/partial-equality.type.zy")) in
  let PartialOrder = @(import("numeric/partial-order.type.zy")) in
  let Numeric = @(import("numeric/numeric.type.zy")) in
  let NumericInstance = @(import("numeric/numeric-instance.type.zy")) in
  pi
    (
      (
        /core;
        /representations;
        /numeric;
        /system = (/Reader; /Writer; /OS);
        builtin
      )
      : @(import("builtin.zy"))
    )
  .
    exists
      (#Bool = BoolType : VType)
      (
        #Option = OptionType :
        VType -> (
          VType
        )
      )
      (
        #Result = ResultType :
        VType -> (
          VType
        ) -> VType
      )
      (
        #List = ListType :
        VType -> (
          VType
        )
      )
      (#Int8 = Int8Type as Int8 : VType)
      (#Int16 = Int16Type as Int16 : VType)
      (#Int32 = Int32Type as Int32 : VType)
      (#Int64 = Int64Type as Int64 : VType)
      (#UInt8 = UInt8Type as UInt8 : VType)
      (#UInt16 = UInt16Type as UInt16 : VType)
      (#UInt32 = UInt32Type as UInt32 : VType)
      (#UInt64 = UInt64Type as UInt64 : VType)
      (#Float32 = Float32Type as Float32 : VType)
      (#Float64 = Float64Type as Float64 : VType)
      (#Char = CharType as Char : VType)
      (#String = StringType as String : VType)
      (#Bytes = BytesType as Bytes : VType)
      (#Reader = ReaderType as Reader : VType)
      (#Writer = WriterType as Writer : VType)
      (#Path = PathType : VType)
      (#IoErrorKind = IoErrorKindType : VType)
      (#IoError = IoErrorType : VType)
      (#OS = OSType as OS : CType)
      (#Additive = AdditiveType as Additive : VType -> VType)
      (
        #Multiplicative = MultiplicativeType as Multiplicative :
        VType -> (
          VType
        )
      )
      (
        #PartialEquality = PartialEqualityType as PartialEquality :
        VType -> VType -> VType
      )
      (
        #PartialOrder = PartialOrderType as PartialOrder :
        VType -> VType -> VType
      )
      (
        #Numeric = NumericType as Numeric :
        VType -> VType -> VType
      )
      (
        #NumericInstance = NumericInstanceType as NumericInstance :
        VType -> VType -> VType
      )
    .
        (#prelude :: Prelude)
      * DataBody BoolType OptionType ResultType ListType
      * NumericBody BoolType
      * TextBody BoolType OptionType ListType
      * SystemBody
          BoolType
          OptionType
          ResultType
          ListType
          Reader
          Writer
          PathType
          IoErrorKindType
          IoErrorType
          OS
      * Unit
end
