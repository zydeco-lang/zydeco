begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let CType = @(import("../builtin/intrinsic/ctype.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let ListCore
    (
      List : VType -> (
        VType
      )
    )
    (Int64 : VType) =
      (
        nil :: Thk (
          forall (A : VType) . Ret (List A)
        )
      )
    * (
        cons :: Thk (
          forall (A : VType) . A -> List A -> Ret (List A)
        )
      )
    * (
        case :: Thk (
          forall (A : VType) .
            forall (B : CType) .
                 List A
              -> Thk B
              -> Thk (A -> List A -> B)
              -> B
        )
      )
    * (
        fold :: Thk (
          forall (A : VType) .
            forall (B : CType) .
                 List A
              -> Thk B
              -> Thk (A -> Thk B -> B)
              -> B
        )
      )
    * (
        singleton :: Thk (
          forall (A : VType) . A -> Ret (List A)
        )
      )
    * (
        append :: Thk (
          forall (A : VType) . List A -> List A -> Ret (List A)
        )
      )
    * (
        map :: Thk (
          forall (A : VType) .
            forall (B : VType) .
              List A -> Thk (A -> Ret B) -> Ret (List B)
        )
      )
    * (
        fold_left :: Thk (
          forall (A : VType) .
            forall (B : VType) .
              List A -> B -> Thk (B -> A -> Ret B) -> Ret B
        )
      )
    * (
        reverse :: Thk (
          forall (A : VType) . List A -> Ret (List A)
        )
      )
    * (
        length :: Thk (
          forall (A : VType) . List A -> Ret Int64
        )
      )
  in
  ListCore
end
