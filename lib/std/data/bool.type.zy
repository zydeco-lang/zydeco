begin
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let BoolModule (Bool : @(import("../builtin/intrinsic/vtype.zy"))) =
      (true :: Bool)
    * (false :: Bool)
    * (not :: Thk (Bool -> Ret Bool))
    * (and :: Thk (Bool -> Bool -> Ret Bool))
    * (or :: Thk (Bool -> Bool -> Ret Bool))
    * (eq :: Thk (Bool -> Bool -> Ret Bool))
    * (xor :: Thk (Bool -> Bool -> Ret Bool))
    * (nand :: Thk (Bool -> Bool -> Ret Bool))
    * (nor :: Thk (Bool -> Bool -> Ret Bool))
    * (
        if :: Thk (
          forall (B : @(import("../builtin/intrinsic/ctype.zy"))) . Bool -> Thk B -> Thk B -> B
        )
      )
  in
  BoolModule
end
