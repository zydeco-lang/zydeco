begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let ListCore = @(import("list-core.type.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let ListModule
    (Bool : VType)
    (
      Option : VType -> (
        VType
      )
    )
    (
      List : VType -> (
        VType
      )
    )
    (Int64 : VType) =
      (core :: ListCore List Int64)
    * (
        is_empty :: Thk (
          forall (A : VType) . List A -> Ret Bool
        )
      )
    * (
        head :: Thk (
          forall (A : VType) . List A -> Ret (Option A)
        )
      )
    * (
        tail :: Thk (
          forall (A : VType) . List A -> Ret (Option (List A))
        )
      )
    * (
        get :: Thk (
          forall (A : VType) .
            List A -> Int64 -> Ret (Option A)
        )
      )
  in
  ListModule
end
