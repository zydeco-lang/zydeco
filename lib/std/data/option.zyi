begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let OptionCore = @(import("option-core.type.zy")) in
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (
        Option = AbstractOption :
        VType -> (
          VType
        )
      )
    .
      OptionCore AbstractOption
end
