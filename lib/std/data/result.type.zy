begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let ResultCore = @(import("result-core.type.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let ResultModule
    (Bool : VType)
    (
      Result : VType -> (
        VType
      ) -> VType
    ) =
      (core :: ResultCore Result)
    * (
        is_ok :: Thk (
          forall (A : VType) .
            forall (E : VType) . Result A E -> Ret Bool
        )
      )
    * (
        is_err :: Thk (
          forall (A : VType) .
            forall (E : VType) . Result A E -> Ret Bool
        )
      )
  in
  ResultModule
end
