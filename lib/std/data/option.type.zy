begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let OptionCore = @(import("option-core.type.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let OptionModule
    (Bool : VType)
    (
      Option : VType -> (
        VType
      )
    ) =
      (core :: OptionCore Option)
    * (
        is_some :: Thk (
          forall (A : VType) . Option A -> Ret Bool
        )
      )
    * (
        is_none :: Thk (
          forall (A : VType) . Option A -> Ret Bool
        )
      )
  in
  OptionModule
end
