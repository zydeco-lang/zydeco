begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let ListCore = @(import("list-core.type.zy")) in
  let Int64 = @(import("../builtin/intrinsic/i64.zy")) in
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (
        List = AbstractList :
        VType -> (
          VType
        )
      )
    .
      ListCore AbstractList Int64
end
