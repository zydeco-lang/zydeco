begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let ResultCore = @(import("result-core.type.zy")) in
  pi (_ : @(import("../builtin.zy"))) .
    exists
      (
        Result = AbstractResult :
        VType -> (
          VType
        ) -> VType
      )
    .
      ResultCore AbstractResult
end
