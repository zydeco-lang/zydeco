begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let CType = @(import("../builtin/intrinsic/ctype.zy")) in
  let Thk = @(import("../builtin/intrinsic/thk.zy")) in
  let Ret = @(import("../builtin/intrinsic/ret.zy")) in
  let OptionCore
    (
      Option : VType -> (
        VType
      )
    ) =
      (
        none :: Thk (
          forall (A : VType) . Ret (Option A)
        )
      )
    * (
        some :: Thk (
          forall (A : VType) . A -> Ret (Option A)
        )
      )
    * (
        fold :: Thk (
          forall (A : VType) .
            forall (B : CType) .
              Option A -> Thk B -> Thk (A -> B) -> B
        )
      )
    * (
        map :: Thk (
          forall (A : VType) .
            forall (B : VType) .
              Option A -> Thk (A -> Ret B) -> Ret (Option B)
        )
      )
    * (
        and_then :: Thk (
          forall (A : VType) .
            forall (B : VType) .
                 Option A
              -> Thk (A -> Ret (Option B))
              -> Ret (Option B)
        )
      )
    * (
        unwrap_or :: Thk (
          forall (A : VType) . Option A -> A -> Ret A
        )
      )
    * (
        or_else :: Thk (
          forall (A : VType) .
               Option A
            -> Thk (Ret (Option A))
            -> Ret (Option A)
        )
      )
    * (
        zip :: Thk (
          forall (A : VType) .
            forall (B : VType) .
              Option A -> Option B -> Ret (Option (A * B))
        )
      )
  in
  OptionCore
end
