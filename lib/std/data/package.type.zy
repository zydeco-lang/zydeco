begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let BoolModule = @(import("bool.type.zy")) in
  let OptionModule = @(import("option.type.zy")) in
  let ResultModule = @(import("result.type.zy")) in
  let ListModule = @(import("list.type.zy")) in
  let Unit = @(import("../builtin/intrinsic/unit.zy")) in
  let Int64 = @(import("../builtin/intrinsic/i64.zy")) in
  exists (Bool = BoolType : VType)
    (
      Option = OptionType :
      VType -> (
        VType
      )
    )
  .
    exists
      (
        Result = ResultType :
        VType -> (
          VType
        ) -> VType
      )
    .
      exists
        (
          List = ListType :
          VType -> (
            VType
          )
        )
      .
          (bool :: BoolModule BoolType)
        * (option :: OptionModule BoolType OptionType)
        * (result :: ResultModule BoolType ResultType)
        * (list :: ListModule BoolType OptionType ListType Int64)
        * Unit
end
