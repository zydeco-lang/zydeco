begin
  let VType = @(import("../builtin/intrinsic/vtype.zy")) in
  let DataBody = @(import("body.type.zy")) in
  let DataPackage =
    exists
      (Bool = BoolType : VType)
      (
        Option = OptionType :
        VType -> (
          VType
        )
      )
      (
        Result = ResultType :
        VType -> (
          VType
        ) -> VType
      )
      (
        List = ListType :
        VType -> (
          VType
        )
      )
    .
      DataBody BoolType OptionType ResultType ListType
  in
  DataPackage
end
