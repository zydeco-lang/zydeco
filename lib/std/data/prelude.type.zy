begin
  let Thk = @[import("../builtin/intrinsic/thk.zy")] _ in
  let Ret = @[import("../builtin/intrinsic/ret.zy")] _ in
  let Unit = @[import("../builtin/intrinsic/unit.zy")] _ in
  let Prelude =
    exists
      (
        Thunk = ThunkType as Thk : (@[import("../builtin/intrinsic/ctype.zy")] _) -> (
          @[import("../builtin/intrinsic/vtype.zy")] _
        )
      )
    .
      exists
        (
          U = UType as Thk : (@[import("../builtin/intrinsic/ctype.zy")] _) -> (
            @[import("../builtin/intrinsic/vtype.zy")] _
          )
        )
      .
        exists
          (
            F = FType as Ret : (@[import("../builtin/intrinsic/vtype.zy")] _) -> (
              @[import("../builtin/intrinsic/ctype.zy")] _
            )
          )
        .
          Unit
  in
  Prelude
end
