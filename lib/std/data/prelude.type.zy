begin
  let VType = @(intrinsic(vtype)) in
  let CType = @(intrinsic(ctype)) in
  let Thk = @(intrinsic(thk)) in
  let Ret = @(intrinsic(ret)) in
  let Unit = @(intrinsic(unit)) in
  let Prelude = exists
    (
      Thunk = ThunkType as Thk : CType -> (
        VType
      )
    )
  .
    exists
      (
        U = UType as Thk : CType -> (
          VType
        )
      )
    .
      exists
        (
          F = FType as Ret : VType -> (
            CType
          )
        )
      .
        Unit in
  Prelude
end
