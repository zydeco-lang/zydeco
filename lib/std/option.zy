param (
  (
    /VType;
    /CType;
    /Thk;
    /Ret;
    /Unit
  ) :
  @[import("builtin.zy")] _
) in
begin
  def Option (A : VType) =
    data
    | +None : Unit
    | +Some : A
    end
  that
  def ! none (A : VType) : Ret (Option A) =
    ret +None()
  that
  def ! some (A : VType) (value : A) : Ret (Option A) =
    ret +Some(value)
  that
  def ! fold
    (A : VType)
    (B : CType)
    (option : Option A)
    (when_none : Thk B)
    (when_some : Thk (A -> B))
    : B =
    match option
    | +None(_) => ! when_none
    | +Some(value) => ! when_some value
    end
  that
  def ! map
    (A : VType)
    (B : VType)
    (option : Option A)
    (transform : Thk (A -> Ret B))
    : Ret (Option B) =
    match option
    | +None(_) => ! none B
    | +Some(value) =>
      do transformed <- ! transform value;
      ! some B transformed
    end
  that
  def ! and_then
    (A : VType)
    (B : VType)
    (option : Option A)
    (transform : Thk (A -> Ret (Option B)))
    : Ret (Option B) =
    match option
    | +None(_) => ! none B
    | +Some(value) => ! transform value
    end
  that
  def ! unwrap_or (A : VType) (option : Option A) (default : A) : Ret A =
    match option
    | +None(_) => ret default
    | +Some(value) => ret value
    end
  that
  def ! or_else
    (A : VType)
    (option : Option A)
    (default : Thk (Ret (Option A)))
    : Ret (Option A) =
    match option
    | +None(_) => ! default
    | +Some(value) => ! some A value
    end
  that
  def ! zip
    (A : VType)
    (B : VType)
    (left : Option A)
    (right : Option B)
    : Ret (Option (A * B)) =
    match left
    | +None(_) => ! none (A * B)
    | +Some(left_value) =>
      match right
      | +None(_) => ! none (A * B)
      | +Some(right_value) => ! some (A * B) (left_value, right_value)
      end
    end
  that
  let Interface =
    exists (
      Option = AbstractOption :
      (VType) -> (VType)
    ) .
      (none :: Thk (
        forall (A : VType) .
          Ret (AbstractOption A)
      )) *
      (some :: Thk (
        forall (A : VType) .
          A -> Ret (AbstractOption A)
      )) *
      (fold :: Thk (
        forall (A : VType) .
        forall (B : CType) .
          AbstractOption A -> Thk B -> Thk (A -> B) -> B
      )) *
      (map :: Thk (
        forall (A : VType) .
        forall (B : VType) .
          AbstractOption A -> Thk (A -> Ret B) -> Ret (AbstractOption B)
      )) *
      (and_then :: Thk (
        forall (A : VType) .
        forall (B : VType) .
          AbstractOption A ->
          Thk (A -> Ret (AbstractOption B)) ->
          Ret (AbstractOption B)
      )) *
      (unwrap_or :: Thk (
        forall (A : VType) .
          AbstractOption A -> A -> Ret A
      )) *
      (or_else :: Thk (
        forall (A : VType) .
          AbstractOption A ->
          Thk (Ret (AbstractOption A)) ->
          Ret (AbstractOption A)
      )) *
      (zip :: Thk (
        forall (A : VType) .
        forall (B : VType) .
          AbstractOption A ->
          AbstractOption B ->
          Ret (AbstractOption (A * B))
      ))
  that

  (
    Option = Option,
    none = none,
    some = some,
    fold = fold,
    map = map,
    and_then = and_then,
    unwrap_or = unwrap_or,
    or_else = or_else,
    zip = zip,
  ) : Interface
end
