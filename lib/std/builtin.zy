-- module Builtin
exists
  --| VType and CType
  (VType as @[intrinsic(vtype)] _)
  (CType as @[intrinsic(ctype)] _)
  --| Thk and Ret
  (Thk as @[intrinsic(thk)] _)
  (Ret as @[intrinsic(ret)] _)
  --| primitive base types

  --| we support the constructors externally because
  --| the parsers of their constructors are customized
  --| so the type is registered as a data type but the constructors
  --| are not implemented as internal constructors

  (Unit as @[intrinsic(unit)] _)
.
  @[builtin(int)] exists (Int : VType) .
    (@[builtin(char)] exists (Char : VType) .
      (@[builtin(string)] exists (String : VType) .
        (@[builtin(bytes)] exists (Bytes : VType) .
          (@[builtin(reader)] exists (Reader : VType) .
            (@[builtin(writer)] exists (Writer : VType) .
              (@[builtin(os)] exists (OS : CType) .
                ((@[builtin(add)] (add :: Thk (Int -> Int -> Ret Int))) *
                (@[builtin(sub)] (sub :: Thk (Int -> Int -> Ret Int))) *
                (@[builtin(mul)] (mul :: Thk (Int -> Int -> Ret Int))) *
                (@[builtin(div)] (div :: Thk (Int -> Int -> Ret Int))) *
                (@[builtin(mod)] (mod :: Thk (Int -> Int -> Ret Int))) *
                (@[builtin(int_eq)] (int_eq_branch :: Thk (
             forall (R : CType) .
               Int -> Int -> Thk R -> Thk R -> R
           ))) *
                (@[builtin(int_lt)] (int_lt_branch :: Thk (
             forall (R : CType) .
               Int -> Int -> Thk R -> Thk R -> R
           ))) *
                (@[builtin(int_gt)] (int_gt_branch :: Thk (
             forall (R : CType) .
               Int -> Int -> Thk R -> Thk R -> R
           ))) *
                (@[builtin(str_scalar_length)] (str_scalar_length :: Thk (String -> Ret Int))) *
                (@[builtin(str_byte_length)] (str_byte_length :: Thk (String -> Ret Int))) *
                (@[builtin(str_append)] (str_append :: Thk (String -> String -> Ret String))) *
                (@[builtin(str_split_once)] (str_split_once_branch :: Thk (
             forall (R : CType) .
               String -> Char -> Thk R -> Thk (String -> String -> R) -> R
           ))) *
                (@[builtin(str_split_at)] (str_split_at_branch :: Thk (
             forall (R : CType) .
               String -> Int -> Thk R -> Thk (String -> String -> R) -> R
           ))) *
                (@[builtin(str_eq)] (str_eq_branch :: Thk (
             forall (R : CType) .
               String -> String -> Thk R -> Thk R -> R
           ))) *
                (@[builtin(str_get)] (str_get_branch :: Thk (
             forall (R : CType) .
               String -> Int -> Thk R -> Thk (Char -> R) -> R
           ))) *
                (@[builtin(int_to_str)] (int_to_str :: Thk (Int -> Ret String))) *
                (@[builtin(char_to_str)] (char_to_str :: Thk (Char -> Ret String))) *
                (@[builtin(char_codepoint)] (char_codepoint :: Thk (Char -> Ret Int))) *
                (@[builtin(char_from_codepoint)] (char_from_codepoint_branch :: Thk (
             forall (R : CType) .
               Int -> Thk R -> Thk (Char -> R) -> R
           ))) *
                (@[builtin(str_parse_int)] (str_parse_int_branch :: Thk (
             forall (R : CType) .
               String -> Thk R -> Thk (Int -> R) -> R
           ))) *
                (@[builtin(bytes_empty)] (bytes_empty :: Thk (Ret Bytes))) *
                (@[builtin(bytes_length)] (bytes_length :: Thk (Bytes -> Ret Int))) *
                (@[builtin(bytes_append)] (bytes_append :: Thk (Bytes -> Bytes -> Ret Bytes))) *
                (@[builtin(bytes_from_str)] (bytes_from_str :: Thk (String -> Ret Bytes))) *
                (@[builtin(bytes_to_str)] (bytes_to_str_branch :: Thk (
             forall (R : CType) .
               Bytes -> Thk R -> Thk (String -> R) -> R
           ))) *
                (@[builtin(stdin)] (stdin :: Thk (Ret Reader))) *
                (@[builtin(stdout)] (stdout :: Thk (Ret Writer))) *
                (@[builtin(stderr)] (stderr :: Thk (Ret Writer))) *
                (@[builtin(io_read)] (io_read :: Thk (
             Reader -> Int ->
             Thk (Int -> String -> OS) ->
             Thk (Bytes -> OS) ->
             OS
           ))) *
                (@[builtin(io_read_line)] (io_read_line :: Thk (
             Reader ->
             Thk (Int -> String -> OS) ->
             Thk OS ->
             Thk (Bytes -> OS) ->
             OS
           ))) *
                (@[builtin(io_read_all)] (io_read_all :: Thk (
             Reader ->
             Thk (Int -> String -> OS) ->
             Thk (Bytes -> OS) ->
             OS
           ))) *
                (@[builtin(io_write_all)] (io_write_all :: Thk (
             Writer -> Bytes ->
             Thk (Int -> String -> OS) ->
             Thk OS ->
             OS
           ))) *
                (@[builtin(io_flush)] (io_flush :: Thk (
             Writer -> Thk (Int -> String -> OS) -> Thk OS -> OS
           ))) *
                (@[builtin(io_close_reader)] (io_close_reader :: Thk (
             Reader -> Thk (Int -> String -> OS) -> Thk OS -> OS
           ))) *
                (@[builtin(io_close_writer)] (io_close_writer :: Thk (
             Writer -> Thk (Int -> String -> OS) -> Thk OS -> OS
           ))) *
                (@[builtin(fs_open_reader)] (fs_open_reader :: Thk (
             String ->
             Thk (Int -> String -> OS) ->
             Thk (Reader -> OS) ->
             OS
           ))) *
                (@[builtin(fs_create_writer)] (fs_create_writer :: Thk (
             String ->
             Thk (Int -> String -> OS) ->
             Thk (Writer -> OS) ->
             OS
           ))) *
                (@[builtin(fs_append_writer)] (fs_append_writer :: Thk (
             String ->
             Thk (Int -> String -> OS) ->
             Thk (Writer -> OS) ->
             OS
           ))) *
                (@[builtin(write_str)] (write_str :: Thk (String -> Thk OS -> OS))) *
                (@[builtin(write_int)] (write_int :: Thk (Int -> Thk OS -> OS))) *
                (@[builtin(write_line)] (write_line :: Thk (String -> Thk OS -> OS))) *
                (@[builtin(read_line)] (read_line :: Thk (Thk (String -> OS) -> OS))) *
                (@[builtin(read_line_as_int)] (read_line_as_int_branch :: Thk (
             Thk OS -> Thk (Int -> OS) -> OS
           ))) *
                (@[builtin(read_till_eof)] (read_till_eof :: Thk (Thk (String -> OS) -> OS))) *
                (@[builtin(arg_list)] (arg_fold :: Thk (
             forall (R : CType) .
               Thk R -> Thk (String -> Thk R -> R) -> R
           ))) *
                (@[builtin(random_int)] (random_int :: Thk (Thk (Int -> OS) -> OS))) *
                (@[builtin(exit)] (exit :: Thk (Int -> OS))))))))))
-- end module Builtin
