exists
  -- Kind-valued manifest components establish the two CBPV universes used by
  -- the rest of the signature.
  (VType as @[intrinsic(vtype)] _)
  (CType as @[intrinsic(ctype)] _)
.
  begin
    let BuiltinUnit = @[intrinsic(unit)] _ that

    -- Effect capabilities remain generative at the provider boundary.
    exists
      @[builtin(reader)] (SystemReader : VType)
      @[builtin(writer)] (SystemWriter : VType)
      @[builtin(os)] (SystemOS : CType)
    .
        (
          core :: @[import("builtin/core.zy")] _
        )
      * (
          representations :: @[import("builtin/representations.zy")] _
        )
      * (
          numeric :: @[import("builtin/numeric.zy")] _
        )
      * (
          text :: @[import("builtin/text.zy")] _
        )
      * (
          system ::
          exists
            (Reader = ReaderType as SystemReader : VType)
            (Writer = WriterType as SystemWriter : VType)
            (OS = OSType as SystemOS : CType)
          .
              (
                io ::
                (@[import("builtin/system/io.zy")] _) SystemReader SystemWriter SystemOS
              )
            * (
                fs ::
                (@[import("builtin/system/fs.zy")] _) SystemReader SystemWriter SystemOS
              )
            * (
                stdio ::
                (@[import("builtin/system/stdio.zy")] _) SystemReader SystemWriter SystemOS
              )
            * (args :: @[import("builtin/system/args.zy")] _)
            * (random :: (@[import("builtin/system/random.zy")] _) SystemOS)
            * (process :: (@[import("builtin/system/process.zy")] _) SystemOS)
            * BuiltinUnit
        )
      * BuiltinUnit
  end
-- end module Builtin
