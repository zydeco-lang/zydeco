-- module Bool
{
param (
  (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
  @[import("builtin.zy")] _
) in
ret begin
  def Bool =
    data
    | +False : Unit
    | +True : Unit
    end
  that
  def true : Bool = +True() that
  def false : Bool = +False() that
  def not : Thk (Bool -> Ret Bool) = {
    fn (value : Bool) ->
      match value
      | +False(_) -> ret true
      | +True(_) -> ret false
      end
  } that
  def and : Thk (Bool -> Bool -> Ret Bool) = {
    fn (left : Bool) (right : Bool) ->
      match left
      | +False(_) -> ret false
      | +True(_) -> ret right
      end
  } that
  def or : Thk (Bool -> Bool -> Ret Bool) = {
    fn (left : Bool) (right : Bool) ->
      match left
      | +False(_) -> ret right
      | +True(_) -> ret true
      end
  } that
  def if : Thk (
    forall (B : CType) .
      Bool -> Thk B -> Thk B -> B
  ) = {
    fn (B : CType)
       (condition : Bool)
       (when_true : Thk B)
       (when_false : Thk B) ->
      match condition
      | +False(_) -> ! when_false
      | +True(_) -> ! when_true
      end
  } that
  let Interface =
    exists (Bool = AbstractBool : VType) .
      (true :: AbstractBool) *
      (false :: AbstractBool) *
      (not :: Thk (AbstractBool -> Ret AbstractBool)) *
      (and :: Thk (AbstractBool -> AbstractBool -> Ret AbstractBool)) *
      (or :: Thk (AbstractBool -> AbstractBool -> Ret AbstractBool)) *
      (if :: Thk (
        forall (B : CType) .
          AbstractBool -> Thk B -> Thk B -> B
      ))
  that

  (
    Bool = Bool,
    true = true,
    false = false,
    not = not,
    and = and,
    or = or,
    if = if,
  ) : Interface
end
}
-- end module Bool
