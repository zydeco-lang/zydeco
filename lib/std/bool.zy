-- module Bool
param (
  (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
  @[import("builtin.zy")] _
) in
begin
  def Bool =
    data
    | +False : Unit
    | +True : Unit
    end
  that
  def true : Bool = +True() that
  def false : Bool = +False() that
  def ! not (value : Bool) : Ret Bool =
    match value
    | +False(_) => ret true
    | +True(_) => ret false
    end
  that
  def ! and (left : Bool) (right : Bool) : Ret Bool =
    match left
    | +False(_) => ret false
    | +True(_) => ret right
    end
  that
  def ! or (left : Bool) (right : Bool) : Ret Bool =
    match left
    | +False(_) => ret right
    | +True(_) => ret true
    end
  that
  def ! eq (left : Bool) (right : Bool) : Ret Bool =
    match left
    | +False(_) => ! not right
    | +True(_) => ret right
    end
  that
  def ! xor (left : Bool) (right : Bool) : Ret Bool =
    match left
    | +False(_) => ret right
    | +True(_) => ! not right
    end
  that
  def ! nand (left : Bool) (right : Bool) : Ret Bool =
    do both <- ! and left right;
    ! not both
  that
  def ! nor (left : Bool) (right : Bool) : Ret Bool =
    do either <- ! or left right;
    ! not either
  that
  def ! if (B : CType) (condition : Bool) (when_true : Thk B) (when_false : Thk B) : B =
    match condition
    | +False(_) => ! when_false
    | +True(_) => ! when_true
    end
  that
  let Interface =
    exists (Bool = AbstractBool : VType) .
      (true :: AbstractBool) *
      (false :: AbstractBool) *
      (not :: Thk (AbstractBool -> Ret AbstractBool)) *
      (and :: Thk (AbstractBool -> AbstractBool -> Ret AbstractBool)) *
      (or :: Thk (AbstractBool -> AbstractBool -> Ret AbstractBool)) *
      (eq :: Thk (AbstractBool -> AbstractBool -> Ret AbstractBool)) *
      (xor :: Thk (AbstractBool -> AbstractBool -> Ret AbstractBool)) *
      (nand :: Thk (AbstractBool -> AbstractBool -> Ret AbstractBool)) *
      (nor :: Thk (AbstractBool -> AbstractBool -> Ret AbstractBool)) *
      (if :: Thk (
        forall (B : CType) .
          AbstractBool -> Thk B -> Thk B -> B
      ))
  that

  (
    Bool = Bool,
    true = true,
    false = false,
    not = not,
    and = and,
    or = or,
    eq = eq,
    xor = xor,
    nand = nand,
    nor = nor,
    if = if,
  ) : Interface
end
-- end module Bool
