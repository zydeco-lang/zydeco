data Seal (X : VType) (A : VType) where
| +Seal : Thunk(A -> Ret X) * Thunk(X -> Ret A)
end

def nat : exists (X : VType) . Seal X Int = (
  Int, +Seal(
    { ! id (Int) },
    { ! id (Int) },
  )
) end

def packed : exists (X : VType) . exists (Y : VType) . X * (Y * Int) = (
  Int, Char, 0, ('z', 0)
) end

main
  match packed
  | (Left, Right, zero, letter, status) ->
    match nat
    | (Nat, seal) ->
      match seal
      | +Seal(of, to) ->
        do n <- ! of 0;
        do i <- ! to n;
        ! exit i
      end
    end
  end
end
