begin
  param val (/Thk; /Ret; /UInt32; /Int; /Addr; builtin) : @(import("../std/builtin.zy")) that
  param val (/Bytes; /bytes) : (@(import("../std/text/bytes.type.zy"))) Addr in
  let Window = Addr in
  let hash32 : Thk (Window -> Int -> UInt32 -> Ret UInt32) =
    @(ffi(c, library("xxhash"), symbol("XXH32")))
  in
  let Fault = @(import("../std/memory/fault.zy")) in
  let fail : Thk (Fault -> Ret UInt32) = {
    fn _ =>
      @[partial]
      let 0 = 1 in
      ret (0 : UInt32)
  } in
  (
    #xxh32 = {
      fn (value : Bytes) (seed : UInt32) =>
        ! bytes/unsafe/with_window (Ret UInt32) value fail {
          fn address length => ! hash32 address length seed
        }
    }
  )
end
