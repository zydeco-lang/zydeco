param (/process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  def Bool =
    data
    | +False : Unit
    | +True : Unit
    end
  that

  def ! f : Bool -> Thk (Int -> OS) -> OS = fn (b : Bool) (k : Thk (Int -> OS)) =>
    -- k might be large
    match b
    | +True(_) => ! k 0
    | +False(_) => ! k 1
    end that

  ! f +True() {
    -- a large continuation gets inlined
    fn x =>
      match (+True() : Bool)
      | +True(_) => ! process/exit x
      | +False(_) => ! process/exit 0
      end
  }
end
