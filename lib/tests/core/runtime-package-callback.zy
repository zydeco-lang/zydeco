param (/process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let Entry = exists (X : VType) . X * Thk (X -> Ret Int) that
  let HiddenByPackage =
    codata
    | .open : forall (R : CType) .
      Thk (pi ((X, _, _) : Entry) . R) -> R
    end
  that

  def boxed : Thk HiddenByPackage = {
    comatch
    | .open R use =>
      ! use ((Int, 0, { fn value => ret value }) : Entry)
    end
  } that
  do selected <- ret boxed;
  do status <- ! selected .open (Ret Int) {
    fn (X, value, read) => ! read value
  };
  ! process/exit status
end
