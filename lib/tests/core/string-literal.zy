begin
  param (/OS; /process; /Int64; /numeric; /text; /system) : @(import("../../std/builtin.zy")) that
  let int64 = numeric/int64 that
  let string = text/string that
  do unicode_length <- ! string/length "λx";
  do joined <- ! string/append "uniform " "terms";
  ! int64/eq
    OS
    unicode_length
    2
    {
      ! string/eq
        OS
        joined
        "uniform terms"
        { ! process/exit 0 }
        { ! process/exit 2 }
    }
    { ! process/exit 1 }
end
