param (/OS = _; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let make_std = @(import("../../std/std.zy")) that

  let (/bool; /int; /process) = builtin |> make_std in
  let fix fact (i : Int) : Ret Int =
    -- extern def add : Thk (Int -> Int -> Ret Int) end
    do zero? <- ! int/eq i 0;
    ! bool/if
      (Ret Int)
      zero?
      { ret 1 }
      {
        -- do i <- ret i;
        do i' <- ! int/sub i 1;
        do acc <- ! fact i';
        ! int/mul i acc
      }
  in
  do x <- ! fact 10;
  do r <- ! int/sub x 3628800;
  ! process/exit r
end
