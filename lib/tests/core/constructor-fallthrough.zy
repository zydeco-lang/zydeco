param (/numeric; /process; builtin) : @(import(
  "../../std/builtin.zy"
)) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
let Choice =
  data
  | +First : Int
  | +Second : Int
  | +Third : Unit
  end
in
let classify : Thk (Choice -> Ret Int) = {
  fn choice =>
    match choice
    | +First(value) => ret value
    | remaining =>
      match remaining
      | +Second(value) => ret value
      | _ => ret 30
      end
    end
} in
do first <- ! classify +First(10);
do second <- ! classify +Second(20);
do third <- ! classify +Third();
! numeric/int/eq OS first 10 {
  ! numeric/int/eq OS second 20 {
    ! numeric/int/eq OS third 30 { ! process/exit 0 } { ! process/exit 3 }
  } { ! process/exit 2 }
} { ! process/exit 1 }
