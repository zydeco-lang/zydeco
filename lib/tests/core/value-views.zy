begin
  param (/VType; /Unit; /process; /Int; /system) : @(import("../../std/builtin.zy")) that
  let Tagged =
    data
    | +Tagged : Int
    | +Other : Unit
    end
  that

  let val keep (A : VType) (value : A) : A = value that
  let val tag (value : Int) : Tagged = +Tagged(value) that
  let val other (_ : Int) : Tagged = +Other(()) that

  let forward : Int = 0 |> keep Int that
  let backward : Int = keep Int <| forward that
  let keep[Int] ~> via_pattern = backward that
  match via_pattern
  | other ~> +Tagged(_) => ! process/exit 1
  | tag ~> +Tagged(status) => ! process/exit status
  | _ => ! process/exit 1
  end
end
