-- Ret describes an installed continuation; pending argument/tag depth is dynamic.
begin
  param (/VType; /CType; /Unit; /Int64; /String; /Thk; /Ret; /OS;
    /numeric; /int64; /string; /args; /process) : @(import("../../std/builtin.zy")) that
  def Stream : CType =
    codata
    | .item : Int64 -> Stream
    | .done : Ret Int64
    end
  that
  def fix consume (total : Int64) : Stream =
    comatch
    | .item value =>
      do next <- ! int64/add total value;
      ! consume next
    | .done => ret total
    end
  in
  def fix push (remaining : Int64) : Stream =
    ! int64/eq Stream remaining 0 { ! consume 0 } {
      do next <- ! int64/sub remaining 1;
      ! push next .item remaining
    }
  in
  def fix forward (R : CType) (remaining : Int64) (worker : Thk (Int64 -> R)) : Int64 -> R =
    ! int64/eq (Int64 -> R) remaining 0 {
      fn value =>
        do same <- ! int64/add value 0;
        ! worker same
    } {
      do next <- ! int64/sub remaining 1;
      ! forward R next worker
    }
  in
  def ! choose (length : Int64) : Ret (Thk (Int64 -> Ret Int64)) =
    ! int64/eq (Ret (Thk (Int64 -> Ret Int64))) length 3
      { ret { fn value => ! int64/add value 1 } }
      { ret { fn value => ! int64/sub value -1 } }
  in
  do input <- ! args/at (Ret String) 0 { ret "abc" } { fn value => ret value };
  do length <- ! string/length input;
  do total <- ! push length .done;
  do successor <- ! int64/add length 1;
  do product <- ! int64/mul length successor;
  do expected <- ! int64/div product 2;
  do worker <- ! choose length;
  do result <- ! forward (Ret Int64) length worker total;
  do expected <- ! int64/add expected 1;
  do difference <- ! numeric/int64/sub result expected;
  ! process/exit difference
end
