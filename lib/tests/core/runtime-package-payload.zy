begin
  param (/VType; /Unit; /Thk; /Ret; /Int; /process) : @(import("../../std/builtin.zy")) that
  let Entry = exists (X : VType) . X * Thk (X -> Ret Int) that
  let Holder =
    data
    | +Hold : Entry
    end
  that

  def ! choose (which : Int) : Ret Entry =
    match which
    | 0 => ret ((Int, 0, { fn (value : Int) => ret value }) : Entry)
    | _ => ret ((Unit, (), { fn (_ : Unit) => ret 1 }) : Entry)
    end
  that
  def ! consume (entry : Entry) : Ret Int =
    let (X, value, read) = entry in
    ! read value
  that

  do hidden <- ! choose 0;
  do stored <- ret (+Hold(hidden) : Holder);
  match stored
  | +Hold(entry) =>
    do status <- ! consume entry;
    ! process/exit status
  end
end
