begin
  param (/VType; /Unit; /Thk; /Ret; /Int; /process) : @(import("../../std/builtin.zy")) that

  let Transform = val pi (_ : Int) . Int that
  let val compose (first : Transform) (second : Transform) : Transform =
    val (value : Int) => second (first value)
  that
  let val keep (A : VType) (value : A) : A = value that
  let Stored =
    data
    | +Store : Transform * Thk (Ret Int)
    end
  that

  do captured <- ret 17;
  let val constant (_ : Int) : Int = captured in
  let mixed : Stored = +Store(compose (keep Int) constant, { ret captured }) in
  match mixed
  | +Store(function, suspended) =>
    let module = pack (= Int as Int : VType)
    where
      (#apply = function, #read = suspended)
    end in
    let (/apply; /read) = module in
    let composed = (apply, keep Int) in
    let (first, second) = composed in
    let result = second (first 0) in
    do observed <- ! read;
    match (result, observed)
    | (17, 17) => ! process/exit 0
    | _ => ! process/exit 1
    end
  end
end
