param (/process; /numeric; builtin) : @(import("../../std/builtin.zy")) in
begin
  let int = numeric/int that
  let uint = numeric/uint that
  do wrapped_min <- ! int/add 4611686018427387903 1;
  ! int/eq OS wrapped_min -4611686018427387904 {
    do wrapped_max <- ! int/sub -4611686018427387904 1;
    ! int/eq OS wrapped_max 4611686018427387903 {
      do wrapped_zero <- ! uint/add 9223372036854775807 1;
      ! uint/eq OS wrapped_zero 0 {
        do maximum_again <- ! int/sub wrapped_min 1;
        ! int/eq
          OS
          maximum_again
          4611686018427387903
          { ! process/exit 0 }
          { ! process/exit 1 }
      } { ! process/exit 1 }
    } { ! process/exit 1 }
  } { ! process/exit 1 }
end
