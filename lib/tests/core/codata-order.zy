-- Structural codata interfaces agree even when their declarations order tags differently.
param (/int; /process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let First =
    codata
    | .read : Ret Int
    | .shift : Int -> Ret Int
    end
  that
  let Second =
    codata
    | .shift : Int -> Ret Int
    | .read : Ret Int
    end
  that
  def ! relay (worker : Thk First) : Ret Int =
    do value <- ! worker .read;
    ! worker .shift value
  that
  let object : Thk Second = {
    comatch
    | .read => ret 12
    | .shift value => ! int/sub value 12
    end
  } in
  do result <- ! relay object;
  ! process/exit result
end
