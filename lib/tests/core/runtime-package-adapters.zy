param (/process; builtin) : @(import("../../std/builtin.zy")) in
begin
  let Box = exists (X : VType) . X that
  let Methods (X : VType) =
    codata
    | .get : Ret X
    | .replace : X -> Ret X
    end
  that
  let Curried = forall (X : VType) . X -> Methods X that
  let Packaged = pi ((X, _) : Box) . Methods X that

  def curried : Thk Curried = {
    fn X value =>
      comatch
      | .get => ret value
      | .replace replacement => ret replacement
      end
  } that
  def packaged : Thk Packaged = {
    fn (X, value) => ! curried X value
  } that
  def restored : Thk Curried = {
    fn X value => ! packaged ((X, value) : Box)
  } that

  do selected <- ret packaged;
  do first <- ! selected ((Int, 0) : Box) .get;
  do second <- ! restored Int first .replace 0;
  ! process/exit second
end
