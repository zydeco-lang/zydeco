param (/process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  def ! id (A : VType) (a : A) : Ret A = ret a that

  do x <- ! id Int 0;
  do y <- ! id Int x;
  do z <- ! id Int y;
  do r <- ! id Int z;
  ! process/exit r
end
