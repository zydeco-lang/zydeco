-- The recursive closure is opened locally; its captured wide scalar remains live.
begin
  param (/VType; /Unit; /Int; /Float64; /String; /Ret; /OS; /process; /numeric;
    /int; /string; /args) : @(import("../../std/builtin.zy")) that
  def Chain : VType =
    data
    | +End : Unit
    | +Link : Chain
    end
  that
  do input <- ! args/at (Ret String) 0 { ret "alpha" } { fn value => ret value };
  do length <- ! string/length input;
  do wide <- ! numeric/float64/add 1e18 4e18;
  def fix walk (chain : Chain) (again : Chain) (remaining : Chain) : OS =
    match chain
    | +End() =>
      match remaining
      | +End() =>
        ! numeric/float64/eq OS wide 5e18 {
          do result <- ! int/sub length 5;
          ! process/exit result
        } { ! process/exit 1 }
      | +Link(next) => ! walk again again next
      end
    | +Link(tail) => ! walk tail again remaining
    end
  in
  def fix make (remaining : Int) (chain : Chain) : OS =
    ! int/eq OS remaining 0 { ! walk chain chain chain } {
      do next <- ! int/sub remaining 1;
      ! make next +Link(chain)
    }
  in
  ! make 300 +End()
end
