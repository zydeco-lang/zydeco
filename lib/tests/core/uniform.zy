begin
  let TypeIdentity = begin
    let Result = A that
    param A : VType that
    Result
  end that
  let IdentityResult = TypeIdentity Int64 that
  param (/VType; /OS; /process; /Int64; /numeric; /system) : @(import("../../std/builtin.zy")) that
  let int64 = numeric/int64 that
  def ! run :
    forall (A : VType) . A -> OS =
      begin
        let copy : Number = seed that
        param seed : Number that
        def expected : Int64 = 0 that
        let Number = A that
        param A : VType that
        def Opaque : VType = Int64 that
        do status <- ! int64/add expected 0;
        ! process/exit status
      end
  that

  ! run IdentityResult 7
end
