param (/process; /numeric; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let TypeIdentity = begin
    let Result = A that
    param A : VType that
    Result
  end that
  let IdentityResult = TypeIdentity Int that

  let int = numeric/int that
  def ! run :
    forall (A : VType) . A -> OS =
      begin
        let copy : Number = seed that
        param seed : Number that
        def expected : Int = 0 that
        let Number = A that
        param A : VType that
        def Opaque = Int that
        do status <- ! int/add expected 0;
        ! process/exit status
      end
  that

  ! run IdentityResult 7
end
