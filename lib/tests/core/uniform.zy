begin
  let TypeIdentity = begin
    let Result = A that
    param A : VType that
    Result
  end that
  let IdentityResult = TypeIdentity Int that
  param (/VType; /OS; /process; /Int; /numeric; /system) : @(import("../../std/builtin.zy")) that
  let int = numeric/int that
  def ! run :
    forall (A : VType) . A -> OS =
      begin
        let copy : Number = seed that
        param seed : Number that
        def expected : Int = 0 that
        let Number = A that
        param A : VType that
        def Opaque : VType = Int that
        do status <- ! int/add expected 0;
        ! process/exit status
      end
  that

  ! run IdentityResult 7
end
