param (/process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  def Y (B : CType) : CType =
    codata
    | .y : Thk (Y B) -> B
    end
  that
  def Self (B : VType) : VType =
    data
    | +Roll : Thk (Self B -> Ret B)
    end
  that
  def ! fix' (B : CType) (f : Thk (Thk B -> B)) : B =
    let ! prim : Y B =
      comatch
      | .y x => ! f { ! x .y x }
      end
    in
    ! prim .y prim
  that
  def ! m : OS = ! fix' OS { fn loop => ! loop } that

  ! process/exit 0
end
