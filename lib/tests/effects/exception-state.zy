-- Packed-pi clients use State and Exception without choosing their carriers.
param (
  /VType;
  /Thk;
  /Ret;
  /Unit;
  /Int;
  /String;
  /numeric;
  /string;
  /stdio;
  /process;
  builtin
) : @(import("../../std/builtin.zy")) in
let (/Monad; /Algebra; /WithMonad) = @(import("../../std/effect/monad.zy")) in
let (/IState; /instance = state_instance; /modify; /run_state; /eval_state) =
  builtin |> (@(import("../../std/effect/state.zy")))
in
let (/IException; /instance = exception_instance; /raise; /catch; /handle_exception) =
  builtin |> (@(import("../../std/effect/exception.zy")))
in
let step : Thk (pi ((M, _) : WithMonad (IState Int)) . M Int) = {
  fn (M, (/monad; /state)) =>
    (
      @[monadic] fn (get : Thk (Ret Int)) (put : Thk (Int -> Ret Unit))
        (add : Thk (Int -> Int -> Ret Int))
      =>
        do n <- ! get;
        do n <- ! add n 1;
        do _ <- ! put n;
        ret n
    ) M monad { ! state .get } { ! state .put } {
      fn x y =>
        do z <- ! numeric/int/add x y;
        ! monad .return Int z
    }
} in
let fail : Thk (pi ((M, _) : WithMonad (IException String)) . String -> M Int) = {
  fn (M, (/monad; ops)) =>
    (
      @[monadic] fn (raise : Thk (forall (A : VType) . String -> Ret A)) (msg : String) =>
        do n <- ! raise Int msg;
        ret n
    ) M monad { ! raise String (M, ops) }
} in
let (S, s) = state_instance Int in
let (E, e) = exception_instance String in
-- Runtime-selected clients still carry their witness-dependent signatures.
do step <- ! numeric/int/eq (Ret (@[typeof] step)) 0 0 { ret step } { ret step };
do (answer, final_state) <- ! run_state Int Int (Ret (Int * Int)) 40 {
  ! s/monad .bind Int Int { ! step (S, s) } {
    fn answer =>
      ! s/monad .bind Unit Int { ! modify Int (S, s) { fn n => ! numeric/int/add n 1 } } {
        fn _ => ! s/monad .return Int answer
      }
  }
} { fn final_state answer => ret (answer, final_state) };
do initial <- ! eval_state Int Int 7 { ! s/state .get };
do direct <- ! handle_exception String Int (Ret Int) {
  ! catch String (E, e) Int {
    comatch
    end
  }
    { ! e/exception .throw Int "direct" }
    {
      fn msg =>
        ! string/eq (E Int) msg "direct" { ! e/monad .return Int -3 } { ! e/monad .return Int 0 }
    }
} { fn _ => ret -1 } { fn n => ret n };
do monadic <- ! handle_exception String Int (Ret Int) { ! fail (E, e) "monadic" }
  { fn msg => ! string/eq (Ret Int) msg "monadic" { ret -2 } { ret 0 } }
  { fn n => ret n };
do success <- ! handle_exception String Int (Ret Int) {
  ! e/catch Int { ! e/monad .return Int 5 } { fn _ => ! e/monad .return Int -1 }
} { fn _ => ret -1 } { fn n => ret n };
match (direct, monadic, success, initial, answer, final_state)
| (-3, -2, 5, 7, 41, 42) =>
  ! stdio/write_line "-3 -2" { ! stdio/write_line "41 42" { ! process/exit 0 } }
| _ => ! process/exit 1
end
