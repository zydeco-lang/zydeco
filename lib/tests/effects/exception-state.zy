-- Exception and State as packaged relative-monad effects.
begin
  let monadic_basis = @(import("../../std/control/monad.zy")) that
  let exception_basis = @(import("../../std/control/exception.zy")) that
  let state_basis = @(import("../../std/control/state.zy")) that
  param (
    /numeric;
    /system;
    /VType;
    /CType;
    /Thk;
    /Ret;
    /Unit;
    /OS;
    /stdio;
    /process;
    /String;
    /Int;
    builtin
  ) : @(import("../../std/builtin.zy")) that
  let int = numeric/int that
  let (= Monad, = Algebra, ()) = builtin |> monadic_basis in
  let (
    = Exception,
    = MonadThrow,
    = mo_exception,
    = throw_ops,
    = raise,
    = handle_exception,
    = try_exception
  )
  =
    builtin |> exception_basis
  in
  let (
    = State,
    = MonadState,
    = mo_state,
    = state,
    = get,
    = put,
    = modify,
    = run_state,
    = eval_state
  )
  =
    builtin |> state_basis
  in
  begin

    -- A monadic block whose only effect operation is `raise`. The exception
    -- monad and its instance are supplied at the use site.
    def ! fail (E : VType) =
      @[monadic] begin
        fn (raise : Thk (forall (A : VType) . E -> Ret A)) (msg : E) =>
          do answer <- ! raise Int msg;
          ret answer
      end
    that

    -- A monadic State program. Its operation arguments use `Ret` in their
    -- source signatures; the algebra translation replaces `Ret` with the
    -- ambient monad, so the concrete arguments are State operations.
    def ! add_state (x : Int) (y : Int) : State Int Int =
      do z <- ! int/add x y;
      ! mo_state Int .return Int z
    that

    def ! state_program =
      @[monadic] begin
        fn (get : Thk (Ret Int))
          (put : Thk (Int -> Ret Unit))
          (add : Thk (Int -> Int -> Ret Int))
        =>
          do n <- ! get;
          do n' <- ! add n 1;
          do _ <- ! put n';
          ret n'
      end
    that

    let ! state_run : State Int Int =
      ! state_program
        (State Int)
        { ! mo_state Int }
        { ! get Int }
        { ! put Int }
        add_state
    in
    let ! state_run_with_modify : State Int Int =
      ! mo_state Int .bind Int Int { ! state_run } {
        fn answer =>
          ! mo_state Int .bind Unit Int {
            ! modify Int {
              fn n => ! int/add n 1
            }
          } {
            fn _ => ! mo_state Int .return Int answer
          }
      }
    in

    -- Two ways to introduce the Exception effect into user code: call the
    -- dictionary method directly, or instantiate a monadic block with the
    -- packaged raise operation.
    let ! direct_failure : Exception String Int =
      ! throw_ops String .throw Int "direct"
    in
    let ! monadic_failure : Exception String Int =
      ! fail String (Exception String) { ! mo_exception String } { ! raise String } "monadic"
    in
    let ! direct_recovered : Exception String Int =
      ! try_exception String Int { ! direct_failure } {
        fn _ => ! mo_exception String .return Int -3
      }
    in
    let ! caught_direct : Ret Int =
      ! handle_exception String Int (Ret Int) { ! direct_recovered }
        { fn _ => ret -1 }
        { fn answer => ret answer }
    in
    let ! caught_monadic : Ret Int =
      ! handle_exception String Int (Ret Int) monadic_failure
        { fn _ => ret -2 }
        { fn answer => ret answer }
    in

    def ! check_int (actual : Int) (expected : Int) (k : Thk OS) : OS =
      ! int/eq OS actual expected k {
        ! process/exit 1
      }
    that

    do direct <- ! caught_direct;
    do monadic <- ! caught_monadic;
    ! stdio/write_int direct {
      ! stdio/write " " {
        ! stdio/write_int monadic {
          ! stdio/write "\n" {
            ! check_int direct -3 {
              ! check_int monadic -2 {
                ! run_state Int Int OS 40 { ! state_run_with_modify } {
                  fn final_state answer =>
                    ! stdio/write_int answer {
                      ! stdio/write " " {
                        ! stdio/write_int final_state {
                          ! stdio/write "\n" {
                            ! check_int answer 41 {
                              ! check_int final_state 42 {
                                ! process/exit 0
                              }
                            }
                          }
                        }
                      }
                    }
                }
              }
            }
          }
        }
      }
    }
  end
end
