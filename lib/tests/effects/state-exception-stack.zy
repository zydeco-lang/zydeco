-- User code over an unspecified M that supports State and Exception.
begin
  let monadic_basis = @(import("../../std/control/monad.zy")) that
  let state_basis = @(import("../../std/control/state.zy")) that
  let exception_basis = @(import("../../std/control/exception.zy")) that
  let state_exn_basis = @(import("../../std/control/state-exn.zy")) that
  param (
    (/core; /representations; /numeric; /system; builtin) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/VType; /CType; /Thk; /Ret; /Unit) = core that
  let (/String) = representations/string that
  let (= Int64, int64) = numeric/int64 that
  let (/OS; /stdio; /process) = system that
  let (= Monad, = Algebra, ()) = builtin |> monadic_basis in
  let (/MonadState) = builtin |> state_basis in
  let (/MonadThrow) = builtin |> exception_basis in
  let (
    = StateExn,
    = mo_state_exn,
    = state_ops,
    = throw_ops,
    = get,
    = put,
    = raise,
    = catch,
    = run_state_exn
  )
  =
    builtin |> state_exn_basis
  in
  begin

    -- The user-facing capability signature. Every field is written with `Ret`;
    -- the algebra translation turns it into the ambient monad M.
    let StateExnCapability (S : VType) (E : VType) =
        (#get :: Thk (Ret S))
      * (#put :: Thk (S -> Ret Unit))
      * (#raise :: Thk (forall (A : VType) . E -> Ret A))
      * (
          #catch :: Thk (
            forall (A : VType) .
              Thk (Ret A) -> Thk (E -> Ret A) -> Ret A
          )
        )
      * (#add :: Thk (S -> S -> Ret S))
    that
    let Top =
      codata
      end
    that

    -- The user writes this once. Projection under force must be parenthesized:
    -- `! (cap/get)` forces the selected thunk, while `! cap/get` means
    -- `(! cap) / get`.
    def ! user_program (S : VType) (E : VType) =
      @[monadic] begin
        fn (cap : StateExnCapability S E) (one : S) (msg : E) =>
          do n <- ! (cap/get);
          do recovered <- ! (cap/catch) S
            {
              do _ <- ! (cap/raise) S msg;
              ret n
            }
            {
              fn _ =>
                do m <- ! (cap/get);
                ret m
            };
          do n' <- ! (cap/add) recovered one;
          do _ <- ! (cap/put) n';
          ret n'
      end
    that

    -- A State-specific operation lifted into the concrete stack.
    def ! add_state_exn (x : Int64) (y : Int64) : StateExn Int64 String Int64 =
      do z <- ! (int64/add) x y;
      ! mo_state_exn Int64 String .return Int64 z
    that

    -- Only here do we choose M, its Monad instance, and one capability package
    -- implementing the source signature above.
    let capability : (
      #get :: Thk (StateExn Int64 String Int64)
    ) * (
      #put :: Thk (Int64 -> StateExn Int64 String Unit)
    ) * (
      #raise :: Thk (
        forall (A : VType) .
          Thk Top -> String -> StateExn Int64 String A
      )
    ) * (
      #catch :: Thk (
        forall (A : VType) .
             Thk Top -> Thk (StateExn Int64 String A)
          -> Thk (String -> StateExn Int64 String A)
          -> StateExn Int64 String A
      )
    ) * (
      #add :: Thk (Int64 -> Int64 -> StateExn Int64 String Int64)
    ) = (
      #get = { ! get Int64 String },
      #put = { ! put Int64 String },
      #raise = { ! raise Int64 String },
      #catch = { ! catch Int64 String },
      #add = add_state_exn
    ) in

    let ! production : StateExn Int64 String Int64 =
      ! user_program Int64 String
        (StateExn Int64 String)
        { ! mo_state_exn Int64 String }
        capability
        1
        "boom"
    in

    ! run_state_exn Int64 String Int64 OS 7 { ! production }
      {
        fn msg =>
          ! (stdio/write_line) msg {
            ! (process/exit) 1
          }
      }
      {
        fn final_state answer =>
          ! (stdio/write_int) answer {
            ! (stdio/write) " " {
              ! (stdio/write_int) final_state {
                ! (stdio/write) "\n" {
                  ! (int64/eq) OS answer 8 {
                    ! (int64/eq) OS final_state 8 {
                      ! (process/exit) 0
                    } {
                      ! (process/exit) 2
                    }
                  } {
                    ! (process/exit) 3
                  }
                }
              }
            }
          }
      }
  end
end
