-- User code over an unspecified M that supports State and Exception.
begin
  let monadic_basis = @(import("../../std/control/monad.zy")) that
  let state_basis = @(import("../../std/control/state.zy")) that
  let exception_basis = @(import("../../std/control/exception.zy")) that
  let state_exn_basis = @(import("../../std/control/state-exn.zy")) that
  param (
    /numeric;
    /system;
    /VType;
    /CType;
    /Thk;
    /Ret;
    /Unit;
    /OS;
    /stdio;
    /process;
    /String;
    /Int;
    builtin
  ) : @(import("../../std/builtin.zy")) that
  let int = numeric/int that
  let (= Monad, = Algebra, ()) = builtin |> monadic_basis in
  let (/MonadState) = builtin |> state_basis in
  let (/MonadThrow) = builtin |> exception_basis in
  let (
    = StateExn,
    = mo_state_exn,
    = state_ops,
    = throw_ops,
    = get,
    = put,
    = raise,
    = catch,
    = run_state_exn
  )
  =
    builtin |> state_exn_basis
  in
  begin

    -- The user-facing capability signature. Every field is written with `Ret`;
    -- the algebra translation turns it into the ambient monad M.
    let StateExnCapability (S : VType) (E : VType) =
        (#get :: Thk (Ret S))
      * (#put :: Thk (S -> Ret Unit))
      * (#raise :: Thk (forall (A : VType) . E -> Ret A))
      * (
          #catch :: Thk (
            forall (A : VType) .
              Thk (Ret A) -> Thk (E -> Ret A) -> Ret A
          )
        )
      * (#add :: Thk (S -> S -> Ret S))
    that
    let Top =
      codata
      end
    that

    -- Projection binds tighter than force, so `! cap/get` forces the selected thunk.
    -- Projecting from the result of a force instead requires `(! cap)/get`.
    def ! user_program (S : VType) (E : VType) =
      @[monadic] begin
        fn (cap : StateExnCapability S E) (one : S) (msg : E) =>
          do n <- ! cap/get;
          do recovered <- ! cap/catch S
            {
              do _ <- ! cap/raise S msg;
              ret n
            }
            {
              fn _ =>
                do m <- ! cap/get;
                ret m
            };
          do n' <- ! cap/add recovered one;
          do _ <- ! cap/put n';
          ret n'
      end
    that

    -- A State-specific operation lifted into the concrete stack.
    def ! add_state_exn (x : Int) (y : Int) : StateExn Int String Int =
      do z <- ! int/add x y;
      ! mo_state_exn Int String .return Int z
    that

    -- Only here do we choose M, its Monad instance, and one capability package
    -- implementing the source signature above.
    let capability : (
      #get :: Thk (StateExn Int String Int)
    ) * (
      #put :: Thk (Int -> StateExn Int String Unit)
    ) * (
      #raise :: Thk (
        forall (A : VType) .
          Thk Top -> String -> StateExn Int String A
      )
    ) * (
      #catch :: Thk (
        forall (A : VType) .
             Thk Top -> Thk (StateExn Int String A)
          -> Thk (String -> StateExn Int String A)
          -> StateExn Int String A
      )
    ) * (
      #add :: Thk (Int -> Int -> StateExn Int String Int)
    ) = (
      #get = { ! get Int String },
      #put = { ! put Int String },
      #raise = { ! raise Int String },
      #catch = { ! catch Int String },
      #add = add_state_exn
    ) in

    let ! production : StateExn Int String Int =
      ! user_program Int String
        (StateExn Int String)
        { ! mo_state_exn Int String }
        capability
        1
        "boom"
    in

    ! run_state_exn Int String Int OS 7 { ! production }
      {
        fn msg =>
          ! stdio/write_line msg {
            ! process/exit 1
          }
      }
      {
        fn final_state answer =>
          ! stdio/write_int answer {
            ! stdio/write " " {
              ! stdio/write_int final_state {
                ! stdio/write "\n" {
                  ! int/eq OS answer 8 {
                    ! int/eq OS final_state 8 {
                      ! process/exit 0
                    } {
                      ! process/exit 2
                    }
                  } {
                    ! process/exit 3
                  }
                }
              }
            }
          }
      }
  end
end
