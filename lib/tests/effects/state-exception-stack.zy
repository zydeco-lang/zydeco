-- A single packed carrier supports both effects; catch rolls State back on failure.
param (
  /VType;
  /CType;
  /Thk;
  /Ret;
  /Unit;
  /Int;
  /String;
  /numeric;
  /string;
  /stdio;
  /process;
  builtin
) : @(import("../../std/builtin.zy")) in
let (/Monad; /Algebra) = builtin |> (@(import("../../std/effect/monad.zy"))) in
let (/raise; /catch) = builtin |> (@(import("../../std/effect/exception.zy"))) in
let (/modify) = builtin |> (@(import("../../std/effect/state.zy"))) in
let (/IStateExn; /instance; /run_state_exn) =
  builtin |> (@(import("../../std/effect/state-exn.zy")))
in
let p : Thk (pi ((M, _) : IStateExn Int String) . M Int) = {
  fn ((M, (/monad; /state; /exception; /catch = recover)) : IStateExn Int String) =>
    (
      @[monadic] fn (get : Thk (Ret Int)) (put : Thk (Int -> Ret Unit))
        (raise : Thk (forall (A : VType) . String -> Ret A))
        (catch : Thk (forall (A : VType) . Thk (Ret A) -> Thk (String -> Ret A) -> Ret A))
        (add : Thk (Int -> Int -> Ret Int))
      =>
        do n <- ! catch Int {
          do _ <- ! put 99;
          ! raise Int "boom"
        } { fn _ => ! get };
        do n <- ! add n 1;
        do _ <- ! put n;
        ret n
    ) M monad { ! state .get } { ! state .put }
      { ! raise String (M, = monad, (= exception, #catch = recover)) }
      { ! catch String (M, = monad, (= exception, #catch = recover)) } {
      fn x y =>
        do z <- ! numeric/int/add x y;
        ! monad .return Int z
    }
} in
let (M, ops) = instance Int String in
-- Repacking the State subset preserves M for the generic modify operation.
do (answer, final_state) <- ! run_state_exn Int String Int (Ret (Int * Int)) 6 {
  ! ops/monad .bind Unit Int {
    ! modify Int (M, #monad = ops/monad, #state = ops/state) { fn n => ! numeric/int/add n 1 }
  } {
    fn _ => ! p (M, ops)
  }
} { fn _ => ret (-1, -1) } { fn s x => ret (x, s) };
-- The success arm of catch retains updates; an uncaught exception skips the continuation.
do success <- ! run_state_exn Int String Int (Ret (Int * Int)) 0 {
  ! ops/catch Int {
    ! ops/monad .bind Unit Int { ! ops/state .put 4 } { fn _ => ! ops/monad .return Int 3 }
  } { fn _ => ! ops/monad .return Int -1 }
} { fn _ => ret (-1, -1) } { fn s x => ret (x, s) };
do failure <- ! run_state_exn Int String Int (Ret Int) 0 {
  ! ops/monad .bind Int Int { ! ops/exception .throw Int "stop" } {
    fn _ => ! ops/monad .return Int -1
  }
} { fn msg => ! string/eq (Ret Int) msg "stop" { ret 1 } { ret 0 } } { fn _ _ => ret 0 };
match (answer, final_state, success, failure)
| (8, 8, (3, 4), 1) => ! stdio/write_line "8 8" { ! process/exit 0 }
| _ => ! process/exit 1
end
