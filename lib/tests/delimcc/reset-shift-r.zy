begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) in
  begin

  let Kont (R : CType) (A : VType) =
    Thk (A -> R) -> R
  that
  def ! mkont (R : CType) : Monad (Kont R) =
    comatch
    | .return A a =>
      fn k =>
        ! k a
    | .bind A A' m f =>
      fn k =>
        ! m {
          fn a =>
            ! f a k
        }
    end
  that
  def ! reset' (A : VType) (e : Thk (Kont (Ret A) A)) : Ret A =
    ! e {
      fn x =>
        ret x
    }
  that
  def ! shift'
    (A : VType)
    (A' : VType)
    (e : Thk (
      Thk (A -> Ret A') ->
      Kont (Ret A') A'
    ))
    : Kont (Ret A') A =
    fn ka' =>
      ! e
        ka'
        {
          fn x' =>
            ret x'
        }
  that
  -- reset' and shift' are the primitives of delimited continuations.
  -- example:
  -- def ! _ : F Int =
  --   ! reset' {
  --     do x <- ! shift' { fn cont =>
  --       do y <- ! cont { ret 4 };
  --       ! add 17 y
  --     };
  --     ! mul 2 x
  --   }
  -- end
  def ! ex : Ret Int =
    ! reset' Int {
      ! mkont (Ret Int) .bind Int Int
        {
          ! shift' Int Int {
            fn cont =>
              do y <- ! cont 4;
              do res <- ! (api/add) 17 y;
              ! mkont (Ret Int) .return Int res
          }
        }
        {
          fn x =>
            do res <- ! (api/mul) 2 x;
            ! mkont (Ret Int) .return Int res
        }
    }
  that

  do x <- ! ex;
  do s <- ! (api/int_to_str) x;
  ! (api/write_line) s {
    do zero <- ! (api/sub) x 25;
    ! (api/exit) zero
  }
end
end
