begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (/VType; /CType; /Thk; /Ret; /Int; /OS; /int; /process; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    monadic_basis builtin in
  begin

  let Kont (R : CType) (A : VType) =
    Thk (A -> R) -> R
  that
  def ! mret : Monad Ret =
    comatch
    | .return A a =>
      ret a
    | .bind A A' m f =>
      do a <- ! m;
      ! f a
    end
  that
  def ! reset
    (
      M :
      (VType) -> (CType)
    )
    (monad : Thk (Monad M))
    (A : VType)
    (expression : Thk (Kont (M A) A))
    : M A =
    ! expression {
      fn value =>
        ! monad .return A value
    }
  that
  def ! shift
    (
      M :
      (VType) -> (CType)
    )
    (monad : Thk (Monad M))
    (A : VType)
    (B : VType)
    (handler : Thk (
      Thk (A -> M B) ->
      Kont (M B) B
    ))
    : Kont (M B) A =
    fn continuation =>
      ! handler
        continuation
        {
          fn value =>
            ! monad .return B value
        }
  that
  def ! attempt
    (
      M :
      (VType) -> (CType)
    )
    (monad : Thk (Monad M))
    (A : VType)
    (E : VType)
    (computation : Thk (Kont (M A) E))
    (handler : Thk (E -> M A))
    : M A =
    ! monad .bind
      (Thk (Kont (M A) E))
      A
      {
        ! reset M monad (Thk (Kont (M A) E)) {
          fn ignored =>
            ! monad .return
              (Thk (Kont (M A) E))
              computation
        }
      }
      {
        fn suspended =>
          ! suspended handler
      }
  that
  def ! throw
    (
      M :
      (VType) -> (CType)
    )
    (monad : Thk (Monad M))
    (A : VType)
    (E : VType)
    (exception : E)
    : Kont (M A) E =
    ! shift M monad E A {
      fn continuation ignored =>
        ! continuation exception
    }
  that

  do i <- ! attempt Ret mret Int Int
    {
      ! throw Ret mret Int Int 42
    -- fn _ => ret 0
    }
    {
      fn x =>
        ! (int/sub) x 42
    };
  do j <- ! attempt Ret mret Int Int
    {
      -- ! throw Ret mret Int Int 42
      fn _ =>
        ret 0
    }
    {
      fn x =>
        ! (int/sub) x 42
    };
  ! (int/eq)
    OS
    i
    0
    {
      ! (int/eq)
        OS
        j
        0
        { ! (process/exit) 0 }
        { ! (process/exit) 2 }
    }
    { ! (process/exit) 1 }
end
end
