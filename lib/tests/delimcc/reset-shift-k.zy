begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  let Kont (R : CType) (A : VType) =
    Thk (A -> R) -> R
  that
  def mkont : Thk (
    forall (R : CType) .
      Monad (Kont R)
  ) = {
    fn R ->
      comatch
      | .return A a ->
        fn k ->
          ! k a
      | .bind A A' m f ->
        fn k ->
          ! m {
            fn a ->
              ! f a k
          }
      end
  } that
  def reset' : Thk (
    forall (A : VType) .
      Thk (Kont (Ret A) A) ->
      (
        forall (R : CType) .
          Kont R A
      )
  ) = {
    fn A e R k ->
      do x <- ! e {
        fn x ->
          ret x
      };
      ! k x
  } that
  def shift' : Thk (
    forall (A : VType) .
    forall (A' : VType) .
      Thk (
        Thk (
          A ->
          (
            forall (R : CType) .
              Kont R A'
          )
        ) ->
        Kont (Ret A') A'
      ) ->
      Kont (Ret A') A
  ) = {
    fn A A' e kaa' ->
      ! e
        {
          fn x R ka' ->
            do x' <- ! kaa' x;
            ! ka' x'
        }
        {
          fn x' ->
            ret x'
        }
  } that
  -- reset and shift are the primitives of delimited continuations.
  -- example:
  -- def ! _ : F Int =
  --   ! reset' {
  --     do x <- ! shift' { fn cont ->
  --       do y <- ! cont { ret 4 };
  --       ! add 17 y
  --     };
  --     ! mul 2 x
  --   }
  -- end
  def ex : Thk (
    forall (R : CType) .
      Kont R Int
  ) = {
    ! reset' Int {
      ! mkont (Ret Int) .bind Int Int
        {
          ! shift' Int Int {
            fn cont ->
              ! mkont (Ret Int) .bind Int Int
                { ! cont 4 (Ret Int) }
                {
                  fn y ->
                    do res <- ! (api/add) 17 y;
                    ! mkont (Ret Int) .return Int res
                }
          }
        }
        {
          fn x ->
            do res <- ! (api/mul) 2 x;
            ! mkont (Ret Int) .return Int res
        }
    }
  } that

  ! ex OS {
    fn x ->
      do s <- ! (api/int_to_str) x;
      ! (api/write_line) s {
        do zero <- ! (api/sub) x 25;
        ! (api/exit) zero
      }
  }
end
end
