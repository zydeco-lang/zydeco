begin
  let monadic_basis = @(import("../../std/control/monad.zy")) that
  param (/numeric; /system; /VType; /CType; /Thk; /Ret; /OS; /stdio; /process; /Int; builtin) :
  @(import("../../std/builtin.zy")) that
  let int = numeric/int that
  let (= Monad, = Algebra, ()) = builtin |> monadic_basis in
  begin

    let Kont (R : CType) (A : VType) = Thk (A -> R) -> R that
    def ! mkont (R : CType) : Monad (Kont R) =
      comatch
      | .return A a => fn k => ! k a
      | .bind A A' m f => fn k =>
        ! m {
          fn a => ! f a k
        }
      end
    that
    def ! reset' (A : VType) (e : Thk (Kont (Ret A) A)) (R : CType) : Kont R A = fn k =>
      do x <- ! e {
        fn x => ret x
      };
      ! k x that
    def ! shift' (A : VType)
      (A' : VType)
      (
        e : Thk (
             Thk (
                  A
               -> (
                    forall (R : CType) . Kont R A'
                  )
             )
          -> Kont (Ret A') A'
        )
      )
    : Kont (Ret A') A = fn kaa' =>
        ! e
          {
            fn x R ka' =>
              do x' <- ! kaa' x;
              ! ka' x'
          }
          {
            fn x' => ret x'
          }
    that
    -- reset and shift are the primitives of delimited continuations.
    -- example:
    -- def ! _ : F Int =
    --   ! reset' {
    --     do x <- ! shift' { fn cont =>
    --       do y <- ! cont { ret 4 };
    --       ! int/add 17 y
    --     };
    --     ! int/mul 2 x
    --   }
    -- end
    def ! ex :
      forall (R : CType) . Kont R Int =
        ! reset' Int {
          ! mkont (Ret Int) .bind Int Int
            {
              ! shift' Int Int {
                fn cont =>
                  ! mkont (Ret Int) .bind Int Int
                    { ! cont 4 (Ret Int) }
                    {
                      fn y =>
                        do res <- ! int/add 17 y;
                        ! mkont (Ret Int) .return Int res
                    }
              }
            }
            {
              fn x =>
                do res <- ! int/mul 2 x;
                ! mkont (Ret Int) .return Int res
            }
        }
    that

    ! ex OS {
      fn x =>
        do s <- ! int/to_string x;
        ! stdio/write_line s {
          do zero <- ! int/sub x 25;
          ! process/exit zero
        }
    }
  end
end
