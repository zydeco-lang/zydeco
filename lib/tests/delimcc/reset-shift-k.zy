begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  let Kont :
    (CType) ->
    (VType) ->
    (CType) =
    begin
      param (R : CType) that
      param (A : VType) that
      Thk (A -> R) -> R
    end
  that
  def mkont : Thk (
    forall (R : CType) .
      Monad (Kont R)
  ) = {
    fn R ->
      comatch
      | .return A value ->
        fn continuation ->
          ! continuation value
      | .bind A B computation function ->
        fn continuation ->
          ! computation {
            fn value ->
              ! function value continuation
          }
      end
  } that
  def reset : Thk (
    forall (A : VType) .
      Thk (Kont (Ret A) A) ->
      (
        forall (R : CType) .
          Kont R A
      )
  ) = {
    fn A expression R continuation ->
      do value <- ! expression {
        fn value ->
          ret value
      };
      ! continuation value
  } that
  def shift : Thk (
    forall (A : VType) .
    forall (B : VType) .
      Thk (
        Thk (
          A ->
          (
            forall (R : CType) .
              Kont R B
          )
        ) ->
        Kont (Ret B) B
      ) ->
      Kont (Ret B) A
  ) = {
    fn A B expression continuation ->
      ! expression
        {
          fn value R next ->
            do result <- ! continuation value;
            ! next result
        }
        {
          fn value ->
            ret value
        }
  } that
  def example : Thk (
    forall (R : CType) .
      Kont R Int
  ) = {
    ! reset Int {
      ! mkont (Ret Int) .bind Int Int
        {
          ! shift Int Int {
            fn continuation ->
              ! mkont (Ret Int) .bind Int Int
                { ! continuation 4 (Ret Int) }
                {
                  fn value ->
                    do result <- ! (api/add) 17 value;
                    ! mkont (Ret Int) .return Int result
                }
          }
        }
        {
          fn value ->
            do result <- ! (api/mul) 2 value;
            ! mkont (Ret Int) .return Int result
        }
    }
  } that

  ! example OS {
    fn result ->
      do rendered <- ! (api/int_to_str) result;
      ! (api/write_line) rendered {
        do status <- ! (api/sub) result 25;
        ! (api/exit) status
      }
  }
end
end
