param (/process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  def FnRet (A : VType) =
    codata
    | .arg : A -> Ret A
    end
  that
  def FnOpt (A : VType) =
    codata
    | .one : A -> Ret A
    | .zero : Ret A
    end
  that
  def ! fn_int : FnRet Int =
    comatch
    | .arg i => ret i
    end
  that
  def ! fn_opt_int : FnOpt Int =
    comatch
    | .one i => ! fn_int .arg i
    | .zero => ! fn_int .arg 0
    end
  that

  do x <- ! fn_opt_int .zero;
  ! process/exit x
end
