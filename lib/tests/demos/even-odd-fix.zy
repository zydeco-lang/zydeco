param (/process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def fix odd : Nat -> Ret Bool =
    let fix even (x : Nat) : Ret Bool =
      match x
      | +Z() => ret +True()
      | +S(x) => ! odd x
      end
    in
    fn x =>
      match x
      | +Z() => ret +False()
      | +S(x) => ! even x
      end
  that

  do b <- ! odd +S(+S(+S(+Z())));
  match b
  | +True() => ! process/exit 0
  | +False() => ! process/exit 1
  end
end
