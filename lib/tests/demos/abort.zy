param (/process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  def Stack (A : VType) : CType =
    codata
    | .app : A -> Stack A
    | .return : Ret A
    end
  that
  def fix abort (x : Int) : Stack Int =
    comatch
    | .app _ => ! abort x
    | .return => ret x
    end
  that

  do x <- ! abort 0 .app 1 .app 2 .app 3 .return;
  ! process/exit x
end
