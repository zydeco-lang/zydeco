param (/process; builtin) : @(import(
  "../../std/builtin.zy"
)) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  def ! id (A : VType) (value : A) : Ret A = ret value that
  def ! id~ (B : CType) (b : Thk B) : B = ! b that

  do x <- ! id Int 0;
  ! id~ OS { ! process/exit x }
end
