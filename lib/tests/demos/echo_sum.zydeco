-- The Echo Sum Server
-- When the program starts, it waits for a number followed by a newline.
-- It then prints the sum of all numbers received so far, followed by a newline.
-- Then it loops.
-- If the input is not a number, the program exits.
param (/stdio; /process; /numeric; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let int = numeric/int that
  (
    fix (loop : Thk (Int -> OS)) =>
      fn sum =>
        ! stdio/read_int
          { ! process/exit 0 }
          {
            fn i =>
              do sum <- ! int/add i sum;
              ! stdio/write_int sum {
                ! stdio/write_line " = sum" {
                  ! loop sum
                }
              }
          }
  )
    0
end
