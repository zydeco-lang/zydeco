-- We can do good old object-oriented programming in here
-- e.g. define a Counter that can incr and project out Int64 or String
begin
  param (/CType; /Thk; /Ret; /stdio; /process; /String; /Int64; /numeric; /system) : @(import(
    "../../std/builtin.zy"
  )) that
  let int64 = numeric/int64 that
  def Counter : CType =
    codata
    | .num : Ret Int64
    | .incr : Int64 -> Counter
    | .fmt : Ret String
    end
  that
  -- We can use `this` (or `self`) as in normal OO languages
  def fix mk_counter (n : Int64) : Counter =
    fix (this : Thk Counter) =>
      comatch
      | .num => ret n
      | .incr i =>
        do j <- ! this .num;
        do n <- ! int64/add i j;
        ! mk_counter n
      | .fmt =>
        do n <- ! this .num;
        ! int64/to_string n
      end
  that

  let ! counter_42 : Counter =
    ! mk_counter 42
  in
  do s <- ! counter_42 .fmt;
  ! stdio/write_line s {
    do n <- ! counter_42 .incr -42 .num;
    ! process/exit n
  }
end
