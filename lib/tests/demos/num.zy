begin
  param (/Ret; /Unit; /process; /Int; /numeric; /system) : @(import("../../std/builtin.zy")) that
  let int = numeric/int that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that

  do x <- (fn x => ret 1 : Bool -> Ret Int) +True();
  do y <- (fn x => ret +True() : Int -> Ret Bool) 123;
  do z <- (fn x => ret +True() : Int -> Ret Bool) -123;
  do x <- ! int/mul x -1;
  do x <- ! int/add 1 x;
  ! process/exit x
end
