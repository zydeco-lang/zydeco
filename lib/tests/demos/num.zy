param (/process; /numeric; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let int = numeric/int that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that

  do x <- (fn x => ret 1 : Bool -> Ret Int) +True();
  do y <- (fn x => ret +True() : Int -> Ret Bool) 123;
  do z <- (fn x => ret +True() : Int -> Ret Bool) -123;
  do x <- ! int/mul x -1;
  do x <- ! int/add 1 x;
  ! process/exit x
end
