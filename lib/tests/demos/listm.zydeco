begin
  let make_std = @(import("../../std/std.zy")) that
  param (/system; /VType; /CType; /Thk; /Ret; /Unit; /OS; /Int; builtin) : @(import(
    "../../std/builtin.zy"
  )) that
  def List~ (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * Thk (Ret (List~ A))
    end
  that
  def fix foldr~
    (A : VType)
    (B : CType)
    (ll : Thk (Ret (List~ A)))
    (f : Thk (A -> Thk B -> B))
    (b : Thk B)
  : B =
      do llv <- ! ll;
      match llv
      | +Nil() => ! b
      | +Cons(a, ll) =>
        ! f a { ! foldr~ A B ll f b }
      end
  that

  let (/bool; /int; /stdio; /process) = builtin |> make_std in
  -- List~ is actually coinductive type
  def fix loop : Ret (List~ Int) =
    ret +Cons(0, loop)
  in
  -- Since it's coinductive, here's iota
  def fix iota (i : Int) : Ret (List~ Int) =
    do i+1 <- ! int/add i 1;
    ret +Cons(i, { ! iota i+1 })
  in

  -- foldr~ and an example of summing up the list and exiting with the sum
  let ! loopy : OS =
    ! foldr~
      Int
      OS
      { ! iota 0 }
      {
        fn x b =>
          do next? <- ! int/lt x 10;
          ! bool/if
            OS
            next?
            {
              do rendered <- ! int/to_string x;
              ! stdio/write_line rendered { fn _ => ! b }
            }
            { ! process/exit 0 }
      }
      { ! process/exit 1 }
  in

  ! loopy
end
