param (/process; builtin) : @(import("../../std/builtin.zy")) in
begin
  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def fix add (x : Nat) (y : Nat) : Ret Nat =
    match x
    | +Z() => ret y
    | +S(x) => ! add x +S(y)
    end
  that
  def ! add' (x : Nat) (y : Nat) : Ret Nat =
    match x
    | +Z() => ret y
    | +S(x) => ! add x +S(y)
    end
  that

  do x <- ! add +S(+S(+Z())) +S(+Z());
  do y <- ! add' x +S(+S(+S(+Z())));
  ! process/exit 0
end
