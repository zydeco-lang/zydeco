-- A `@[literal]` splice becomes a multi-line string value.
begin
  param (/Ret; /Unit; /stdio; /process; /String; /system) : @(import("../../std/builtin.zy")) that
  let message : String =
    --| Hello literal
    --| second line
    @(literal)
  in
  ! stdio/write_line message { ! process/exit 0 }
end
