@[package(test(of(std)))]
begin
  param (/VType; /CType; /Thk; /Addr; /OS; /UInt8; /UInt32; /Int; /numeric; /process; builtin) :
  @(import(std/builtin)) that
  let (/Uninit; /Init; /Ptr; /fixed; /allocation; /pointer; /raw) = builtin |> (
    @(import(std/memory))
  ) in
  let (= Plan, = Layout, layout) = fixed in
  let (/Alloc; /heap) = allocation in
  let fail = { ! process/exit 1 } in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let error = { fn (_ : Fault) => ! fail } in
  let ! check_padding (address : Addr) (next : Thk OS) : OS =
    do gap <- ! raw/unsafe/offset address 1;
    do tail <- ! raw/unsafe/offset address 15;
    ! raw/unsafe/load_u8 OS gap {
      fn a =>
        ! raw/unsafe/load_u8 OS tail {
          fn b =>
            ! numeric/uint8/eq OS a 88 { ! numeric/uint8/eq OS b 88 next fail } fail
        }
    }
  in
  let record = layout/align (UInt8 * UInt32) 16 (
    layout/product UInt8 UInt32 layout/uint8 layout/uint32
  ) in
  match record
  | +Err(_) => ! fail
  | +Ok(plan) =>
    let shape = layout/inspect (UInt8 * UInt32) plan in
    let (= L, repr) = layout/realize (UInt8 * UInt32) plan in
    let shape_ok =
      match shape/form
      | +Product(fields) =>
        match (shape/size, shape/alignment, fields/offset)
        | (16, 16, 4) => 0
        | _ => 1
        end
      | _ => 1
      end
    in
    ! numeric/int/eq OS shape_ok 0 {
      ! repr/allocate OS heap error {
        fn vacant =>
          let address = pointer/unsafe/address L Uninit vacant in
          ! raw/unsafe/fill OS address 16 88 {
            ! repr/unsafe/init OS vacant (7 : UInt8, 16909060 : UInt32) {
              fn initialized =>
                ! repr/unsafe/read OS initialized {
                  fn (tag, value) =>
                    ! numeric/uint8/eq OS tag 7 {
                      ! numeric/uint32/eq OS value 16909060 {
                        ! repr/unsafe/take OS initialized {
                          fn vacant _ =>
                            ! check_padding address {
                              ! repr/unsafe/free OS heap vacant error { ! process/exit 0 }
                            }
                        }
                      } fail
                    } fail
                }
            }
          }
      }
    } fail
  end
end
