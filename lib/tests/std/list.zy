begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    /Int = StdInt;
    /OS = StdOS;
    /list;
    /int;
    /process
  ) = make_std (
    VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api
  ) in
  do empty <- ! (list/nil) StdInt;
  do one <- ! (list/cons) StdInt 1 empty;
  do values <- ! (list/cons) StdInt 2 one;
  ! (list/case)
    StdInt
    StdOS
    values
    { ! (process/exit) 1 }
    {
      fn head tail =>
        do total <- ! (list/fold)
          StdInt
          (Ret StdInt)
          tail
          { ret head }
          {
            fn value rest =>
              do subtotal <- ! rest;
              ! (int/add) value subtotal
          };
        do status <- ! (int/sub) total 3;
        ! (process/exit) status
    }
end
