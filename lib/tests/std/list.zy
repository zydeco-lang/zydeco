@[package(test(of(std)))]
begin
  let make_std = @(import(std)) that
  param (/system; /Ret; /OS; /Int; builtin) : @(import(std/builtin)) that
  let (/list; /int; /process) = builtin |> make_std in
  do empty <- ! list/nil Int;
  do one <- ! list/cons Int 1 empty;
  do values <- ! list/cons Int 2 one;
  ! list/case
    Int
    OS
    values
    { ! process/exit 1 }
    {
      fn head tail =>
        do total <- ! list/fold
          Int
          (Ret Int)
          tail
          { ret head }
          {
            fn value rest =>
              do subtotal <- ! rest;
              ! int/add value subtotal
          };
        do status <- ! int/sub total 3;
        ! process/exit status
    }
end
