begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/Ret; /Int64; /OS; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/list; /int64; /process) = make_std builtin in
  do empty <- ! (list/nil) Int64;
  do one <- ! (list/cons) Int64 1 empty;
  do values <- ! (list/cons) Int64 2 one;
  ! (list/case)
    Int64
    OS
    values
    { ! (process/exit) 1 }
    {
      fn head tail =>
        do total <- ! (list/fold)
          Int64
          (Ret Int64)
          tail
          { ret head }
          {
            fn value rest =>
              do subtotal <- ! rest;
              ! (int64/add) value subtotal
          };
        do status <- ! (int64/sub) total 3;
        ! (process/exit) status
    }
end
