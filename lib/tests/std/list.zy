begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) = std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
  do empty <- ! (std/list/nil) StdInt;
  do one <- ! (std/list/cons) StdInt 1 empty;
  do values <- ! (std/list/cons) StdInt 2 one;
  ! (std/list/case)
    StdInt
    StdOS
    values
    { ! (std/os/exit) 1 }
    {
      fn head tail =>
        do total <- ! (std/list/fold)
          StdInt
          (Ret StdInt)
          tail
          { ret head }
          {
            fn value rest =>
              do subtotal <- ! rest;
              ! (std/int/add) value subtotal
          };
        do status <- ! (std/int/sub) total 3;
        ! (std/os/exit) status
    }
end
