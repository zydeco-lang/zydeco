begin
  let make_std = @(import("../../std/std.zy")) that
  param (/core; /representations; /system; builtin) : @(import("../../std/builtin.zy")) that
  let (/Ret) = core that
  let (/Int64) = representations/i64 that
  let (/OS) = system that

  let (/list; /int64; /process) = builtin |> make_std in
  do empty <- ! list/nil Int64;
  do one <- ! list/cons Int64 1 empty;
  do values <- ! list/cons Int64 2 one;
  ! list/case
    Int64
    OS
    values
    { ! process/exit 1 }
    {
      fn head tail =>
        do total <- ! list/fold
          Int64
          (Ret Int64)
          tail
          { ret head }
          {
            fn value rest =>
              do subtotal <- ! rest;
              ! int64/add value subtotal
          };
        do status <- ! int64/sub total 3;
        ! process/exit status
    }
end
