begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/Ret; /Int; /OS; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/list; /int; /process) = make_std builtin in
  do empty <- ! (list/nil) Int;
  do one <- ! (list/cons) Int 1 empty;
  do values <- ! (list/cons) Int 2 one;
  ! (list/case)
    Int
    OS
    values
    { ! (process/exit) 1 }
    {
      fn head tail =>
        do total <- ! (list/fold)
          Int
          (Ret Int)
          tail
          { ret head }
          {
            fn value rest =>
              do subtotal <- ! rest;
              ! (int/add) value subtotal
          };
        do status <- ! (int/sub) total 3;
        ! (process/exit) status
    }
end
