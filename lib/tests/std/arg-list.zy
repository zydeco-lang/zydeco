begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) = std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
  ! (std/os/arg_list) {
    fn arguments =>
      ! (std/list/case)
        StdString
        StdOS
        arguments
        { ! (std/os/exit) 1 }
        {
          fn first remaining =>
            do first_matches <- ! (std/string/eq) first "alpha";
            ! (std/bool/if)
              StdOS
              first_matches
              { ! (std/os/exit) 0 }
              { ! (std/os/exit) 1 }
        }
  }
end
