begin
  let make_std = @(import("../../std/std.zy")) that
  param (
    (/representations; /system; builtin) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/Scalar = String) = representations/string that
  let (/OS) = system that

  let (/bool; /list; /string; /process) = make_std builtin in
  ! (process/arg_list) {
    fn arguments =>
      ! (list/case)
        String
        OS
        arguments
        { ! (process/exit) 1 }
        {
          fn first remaining =>
            do first_matches <- ! (string/eq) first "alpha";
            ! (bool/if)
              OS
              first_matches
              { ! (process/exit) 0 }
              { ! (process/exit) 1 }
        }
  }
end
