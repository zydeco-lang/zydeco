begin
  let make_std = @(import("../../std/std.zy")) that
  param (/system; /OS; /String; builtin) : @(import("../../std/builtin.zy")) that
  let (/bool; /list; /string; /process) = builtin |> make_std in
  ! process/arg_list {
    fn arguments =>
      ! list/case
        String
        OS
        arguments
        { ! process/exit 1 }
        {
          fn first remaining =>
            do first_matches <- ! string/eq first "alpha";
            ! bool/if
              OS
              first_matches
              { ! process/exit 0 }
              { ! process/exit 1 }
        }
  }
end
