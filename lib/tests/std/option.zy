begin
  let make_std = @(import("../../std/std.zy")) that
  param (
    (/representations; /system; builtin) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/Int64) = representations/i64 that
  let (/OS) = system that

  let (/option; /process) = builtin |> make_std in
  do value <- ! (option/some) Int64 0;
  ! (option/fold)
    Int64
    OS
    value
    { ! (process/exit) 1 }
    {
      fn status => ! (process/exit) status
    }
end
