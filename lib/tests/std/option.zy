begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/Int; /OS; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/option; /process) = make_std builtin in
  do value <- ! (option/some) Int 0;
  ! (option/fold)
    Int
    OS
    value
    { ! (process/exit) 1 }
    {
      fn status =>
        ! (process/exit) status
    }
end
