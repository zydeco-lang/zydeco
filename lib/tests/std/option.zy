begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) = std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
  do value <- ! (std/option/some) StdInt 0;
  ! (std/option/fold)
    StdInt
    StdOS
    value
    { ! (std/os/exit) 1 }
    {
      fn status ->
        ! (std/os/exit) status
    }
end
