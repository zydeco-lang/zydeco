begin
  let make_std = @(import("../../std/std.zy")) that
  param (/representations; /system; builtin) : @(import("../../std/builtin.zy")) that
  let (/Int64) = representations/i64 that
  let (/OS) = system that

  let (/Option; /option; /process) = builtin |> make_std in
  do value <- ! option/map
    Int64
    Int64
    (+Some(0) : Option Int64)
    { fn status => ret status };
  match value
  | +None() => ! process/exit 1
  | +Some(status) => ! process/exit status
  end
end
