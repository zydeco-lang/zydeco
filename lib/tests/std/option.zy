begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    /Int = StdInt;
    /OS = StdOS;
    /option;
    /process
  ) = make_std (
    VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api
  ) in
  do value <- ! (option/some) StdInt 0;
  ! (option/fold)
    StdInt
    StdOS
    value
    { ! (process/exit) 1 }
    {
      fn status =>
        ! (process/exit) status
    }
end
