@[package(test(of(/std)))]
begin
  let make_std = @(import(/std)) that
  param (/system; /OS; /Int; builtin) : @(import(/std/builtin)) that
  let (/Option; /option; /process) = builtin |> make_std in
  do value <- ! option/map
    Int
    Int
    (+Some(0) : Option Int)
    { fn status => ret status };
  match value
  | +None() => ! process/exit 1
  | +Some(status) => ! process/exit status
  end
end
