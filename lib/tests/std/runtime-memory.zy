@[package(test(of(/std)))]
begin
  param (/VType; /CType; /Thk; /Ret; /Int; /Addr; /OS; /numeric; /process; /Unit; builtin) :
  @(import(
    /std/builtin
  )) that
  let (/storage; /codecs;
    /Uninit;
    /Init;
    /Ptr;
    /DynamicField;
    /runtime_fields;
    /views;
    /arrays;
    /records;
    /fixed;
    /allocation;
    /pointer
  )
  =
    builtin |> (@(import(/std/memory)))
  in
  let (= Plan, = Layout, layout) = fixed in
  let (/Cps; /DynamicView; /unsafe = view_unsafe) = views in
  let (/heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in
  let int = numeric/int in
  let run =
    match layout/int
    | +Err(_) => fail
    | +Ok(plan) =>
      let (#L = Element, element) = layout/realize Int plan in
      let allocate : Thk (Int -> OS) = {
        fn count =>
          ! arrays/realize Element OS (storage/constant/materialize Element element/storage) count
            16 no {
            fn array =>
              let (
                /L = Array;
                /Values = Sequence;
                /storage = array_storage;
                /values;
                /elements;
                /buffer;
                /codecs = array_codecs
              )
              =
                array
              in
              let Values = Sequence Int in
              let element_codec = codecs/materialize Element Int element/codec in
              do contents_codec <- ! array_codecs Int element_codec;
              let contents = (#storage = array_storage, #codec = contents_codec) in
              do generated <- ! values/generate Int { fn index => ret index };
              ! allocation/dynamic_reserve Array OS heap contents/storage no {
                fn vacant =>
                  ! contents/codec/init vacant generated OS {
                    fn live =>
                      ! elements/at Init OS live 2 no {
                        fn third =>
                          ! (element/codec/read third) OS {
                            fn value =>
                              ! int/eq OS value 2 {
                                do progress <- ! buffer/resume live;
                                ! buffer/pop Int OS element_codec progress no {
                                  fn progress _ =>
                                    ! buffer/push Int OS element_codec progress 17 no {
                                      fn progress =>
                                        ! buffer/finish OS progress no {
                                          fn live =>
                                            ! codecs/unsafe/dynamic_take Array Values contents/codec
                                              live OS {
                                              fn vacant copied =>
                                                do last <- ! values/at Int copied 2;
                                                match last
                                                | +Err(_) => ! fail
                                                | +Ok(value) => ! int/eq OS value 17 {
                                                  ! allocation/unsafe/dynamic_release Array OS heap
                                                    contents/storage vacant no {
                                                    ! process/exit 0
                                                  }
                                                } fail
                                                end
                                            }
                                        }
                                    }
                                }
                              } fail
                          }
                      }
                  }
              }
          }
      } in
      match records/product Element Element element/storage element/storage
      | +Err(_) => fail
      | +Ok(record) =>
        let (/L; /storage = object_storage; /left; /right) = record in
        let object = (
          #storage = object_storage,
          #codec = codecs/product L Element Element Int Int left/path right/path element/codec
            element/codec
        ) in
        {
          ! (allocation/reserve L Unit allocation/static_heap () object/storage) OS no {
            fn vacant =>
              ! (object/codec/init vacant (1, 99)) OS {
                fn live =>
                  do displacement <- ! int/add 4 4;
                  do path <- ! runtime_fields/unsafe/from_offset L Element displacement;
                  do member <- ! runtime_fields/initialized L Element path live;
                  ! (element/codec/read member) OS {
                    fn value =>
                      ! int/eq OS value 99 {
                        let view : DynamicView Cps Addr (Ptr Element Init * Int) = {
                          fn handle =>
                            ! view_unsafe/dynamic_header Int Element Element Init (
                              codecs/materialize Element Int element/codec
                            ) 0 displacement handle
                        } in
                        ! view (pointer/unsafe/address L Init live) OS {
                          fn (member, length) =>
                            ! int/eq OS length 1 {
                              ! (element/codec/read member) OS {
                                fn value =>
                                  ! int/eq OS value 99 {
                                    ! (codecs/unsafe/take L (Int * Int) object/codec live) OS {
                                      fn vacant _ =>
                                        ! (
                                          allocation/unsafe/release L Unit allocation/static_heap ()
                                            object/storage vacant
                                        ) OS no {
                                          ! allocate 3
                                        }
                                    }
                                  } fail
                              }
                            } fail
                        }
                      } fail
                  }
              }
          }
        }
      end
    end
  in
  ! run
end
