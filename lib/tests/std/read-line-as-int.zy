begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  ! (std/os/read_line_as_int) {
    fn first ->
      ! (std/option/fold)
        StdInt
        StdOS
        first
        { ! (std/os/exit) 1 }
        {
          fn integer ->
            ! (std/os/read_line_as_int) {
              fn second ->
                ! (std/option/fold)
                  StdInt
                  StdOS
                  second
                  { ! (std/os/exit) 0 }
                  {
                    fn unexpected ->
                      ! (std/os/exit) 1
                  }
            }
        }
  }
end
