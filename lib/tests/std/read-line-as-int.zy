begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (
      /Thk;
      /Int;
      /String;
      /OS;
      builtin
    ) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    /Option = StdOption;
    /Int = StdInt;
    /String = StdString;
    /IoError = StdIoError;
    /OS = StdOS;
    /option;
    /result;
    /string;
    /stdio;
    /process
  ) = make_std builtin in
  let ! read_int (continuation : Thk (StdOption StdInt -> StdOS)) : StdOS =
    ! (stdio/read_line) {
      fn read =>
        ! (result/fold)
          (StdOption StdString)
          StdIoError
          StdOS
          read
          {
            fn line =>
              ! (option/fold)
                StdString
                StdOS
                line
                {
                  do absent <- ! (option/none) StdInt;
                  ! continuation absent
                }
                {
                  fn text =>
                    do parsed <- ! (string/parse_int) text;
                    ! continuation parsed
                }
          }
          {
            fn _ =>
              do absent <- ! (option/none) StdInt;
              ! continuation absent
          }
    }
  in
  ! read_int {
    fn first =>
      ! (option/fold)
        StdInt
        StdOS
        first
        { ! (process/exit) 1 }
        {
          fn integer =>
            ! read_int {
              fn second =>
                ! (option/fold)
                  StdInt
                  StdOS
                  second
                  { ! (process/exit) 0 }
                  {
                    fn unexpected =>
                      ! (process/exit) 1
                  }
            }
        }
  }
end
