begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/core; /representations; /system; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/Thk) = core that
  let (/Scalar = Int64) = representations/i64 that
  let (/Scalar = String) = representations/string that
  let (/OS) = system that

  let (/Option; /IoError; /option; /result; /string; /stdio; /process) = make_std builtin in
  let ! read_int (continuation : Thk (Option Int64 -> OS)) : OS =
    ! (stdio/read_line) {
      fn read =>
        ! (result/fold)
          (Option String)
          IoError
          OS
          read
          {
            fn line =>
              ! (option/fold)
                String
                OS
                line
                {
                  do absent <- ! (option/none) Int64;
                  ! continuation absent
                }
                {
                  fn text =>
                    do parsed <- ! (string/parse_int) text;
                    ! continuation parsed
                }
          }
          {
            fn _ =>
              do absent <- ! (option/none) Int64;
              ! continuation absent
          }
    }
  in
  ! read_int {
    fn first =>
      ! (option/fold)
        Int64
        OS
        first
        { ! (process/exit) 1 }
        {
          fn integer =>
            ! read_int {
              fn second =>
                ! (option/fold)
                  Int64
                  OS
                  second
                  { ! (process/exit) 0 }
                  {
                    fn unexpected =>
                      ! (process/exit) 1
                  }
            }
        }
  }
end
