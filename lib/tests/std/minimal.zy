begin
  let (/Ret; /Int64) = @(import("../../std/prelude.zy")) that
  let make_std = @(import("../../std/std.zy")) that
  param (/core; builtin) : @(import("../../std/builtin.zy")) that

  let (/int64; /process) = builtin |> make_std in
  let ! square (value : Int64) : Ret Int64 = ! int64/mul value value in
  do answer <- ! square 7;
  do status <- ! int64/sub answer 49;
  ! process/exit status
end
