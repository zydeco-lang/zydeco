begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/representations; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/Scalar = _) = representations/i64 that

  let (/int64; /process) =
    make_std builtin
  in
  do one <- ! (int64/increment) 0;
  do status <- ! (int64/sub) one 1;
  ! (process/exit) status
end
