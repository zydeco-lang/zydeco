begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/Ret; /Int; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/Bool; /bool; /option; /list; /int; /process) = make_std builtin in
  let ! status (condition : Bool) : Ret Int =
    ! (bool/if)
      (Ret Int)
      condition
      { ret 0 }
      { ret 1 }
  in

  do empty <- ! (list/nil) Int;
  do one <- ! (list/singleton) Int 3;
  do two <- ! (list/cons) Int 2 one;
  do three <- ! (list/cons) Int 1 two;
  do joined <- ! (list/append) Int three empty;
  do mapped <- ! (list/map)
    Int
    Int
    joined
    { fn value => ! (int/increment) value };
  do reversed <- ! (list/reverse) Int mapped;

  do length <- ! (list/length) Int reversed;
  do length_ok <- ! (int/eq) length 3;
  do length_status <- ! status length_ok;

  do middle <- ! (list/get) Int reversed 1;
  do middle_status <- ! (option/fold)
    Int
    (Ret Int)
    middle
    { ret 1 }
    {
      fn value =>
        do correct <- ! (int/eq) value 3;
        ! status correct
    };

  do head <- ! (list/head) Int reversed;
  do head_status <- ! (option/fold)
    Int
    (Ret Int)
    head
    { ret 1 }
    {
      fn value =>
        do correct <- ! (int/eq) value 4;
        ! status correct
    };

  do negative <- ! (list/get) Int reversed -1;
  do negative_ok <- ! (option/is_none) Int negative;
  do negative_status <- ! status negative_ok;

  do present <- ! (option/some) Int 2;
  do transformed <- ! (option/map)
    Int
    Int
    present
    { fn value => ! (int/increment) value };
  do transformed_value <- ! (option/unwrap_or) Int transformed 0;
  do transformed_ok <- ! (int/eq) transformed_value 3;
  do transformed_status <- ! status transformed_ok;

  do exclusive <- ! (bool/xor) (bool/true) (bool/false);
  do exclusive_status <- ! status exclusive;

  do minimum <- ! (int/min) -3 4;
  do maximum <- ! (int/max) -3 4;
  do minimum_ok <- ! (int/eq) minimum -3;
  do maximum_ok <- ! (int/eq) maximum 4;
  do extrema_ok <- ! (bool/and) minimum_ok maximum_ok;
  do extrema_status <- ! status extrema_ok;

  do first <- ! (int/add) length_status middle_status;
  do second <- ! (int/add) head_status negative_status;
  do third <- ! (int/add) transformed_status exclusive_status;
  do first_half <- ! (int/add) first second;
  do second_half <- ! (int/add) third extrema_status;
  do result <- ! (int/add) first_half second_half;
  ! (process/exit) result
end
