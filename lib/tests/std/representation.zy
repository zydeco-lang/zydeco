@[package(test(of(std)))]
begin
  param (/VType; /CType; /Thk; /Ret; /Unit; /Int; /UInt8; /UInt32; /Addr; /OS;
    /numeric; /process; builtin) : @(import(std/builtin)) that
  let (/Uninit; /Init; /Ptr; /Slice; /slices; /fixed; /dynamic; /allocation; /pointer; /raw) =
    builtin |> (@(import(std/memory)))
  in
  let (= Plan, = Layout, layout) = fixed in
  let (/Alloc; /heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in

  let (#Layout = DynLayout, = Representation, layouts) = dynamic in
  let ! run (alignment : Int) : OS =
    ! layouts/realize (UInt8 * UInt32) OS
      (
        layouts/align (UInt8 * UInt32) alignment (
          layouts/product UInt8 UInt32 layouts/uint8 layouts/uint32
        )
      )
      fail {
      fn (= L, repr) =>
        ! numeric/int/eq OS repr/alignment alignment {
          ! repr/allocate OS heap no {
            fn pointer =>
              ! repr/unsafe/init OS pointer (7 : UInt8, 42 : UInt32) {
                fn value =>
                  ! repr/unsafe/take OS value {
                    fn vacant (tag, payload) =>
                      ! numeric/uint8/eq OS tag 7 {
                        ! numeric/uint32/eq OS payload 42 {
                          ! repr/unsafe/free OS heap vacant no { ! process/exit 0 }
                        } fail
                      } fail
                  }
              }
          }
        } fail
    }
  in
  ! run 64
end
