-- stage: run
-- backends: all
@[package(test(of(/std)))]
param (/Addr; /process; /memory_ops; builtin) : @(import(/std/builtin)) in
let (/numeric) = @(import(/std/primitive/ops)) in
let memory_builtin : @(import(/std/builtin/memory)) = (= Addr, memory_ops) in
begin
  let (
    /storage; /codecs;
    /Uninit; /Init; /Ptr; /Slice;
    /slices; /fixed; /dynamic; /allocation; /pointer; /raw
  )
  =
    memory_builtin |> (@(import(/std/memory)))
  in
  let (= Plan, = Layout, layout) = fixed in
  let (/Alloc; /heap) = allocation in
  let (/Fault) = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in

  let (#Layout = DynLayout, = Representation, layouts) = dynamic in
  let ! run (alignment : Int) : OS =
    ! layouts/realize (UInt8 * UInt32) OS
      (
        layouts/align (UInt8 * UInt32) alignment (
          layouts/product UInt8 UInt32 layouts/uint8 layouts/uint32
        )
      )
      fail {
      fn (= L, repr) =>
        ! numeric/int/eq OS (storage/runtime/query L repr/storage)/alignment alignment {
          ! allocation/dynamic_reserve L OS heap repr/storage no {
            fn pointer =>
              ! repr/codec/init pointer (7 : UInt8, 42 : UInt32) OS {
                fn value =>
                  ! codecs/unsafe/dynamic_take L (UInt8 * UInt32) repr/codec value OS {
                    fn vacant (tag, payload) =>
                      ! numeric/uint8/eq OS tag 7 {
                        ! numeric/uint32/eq OS payload 42 {
                          ! allocation/unsafe/dynamic_release L OS heap repr/storage vacant no {
                            ! process/exit 0
                          }
                        } fail
                      } fail
                  }
              }
          }
        } fail
    }
  in
  ! run 64
end
