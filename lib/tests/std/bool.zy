begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/system; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/OS) = system that

  let (/bool; /process) = make_std builtin in
  do result <- ! (bool/not) (bool/false);
  ! (bool/if)
    OS
    result
    { ! (process/exit) 0 }
    { ! (process/exit) 1 }
end
