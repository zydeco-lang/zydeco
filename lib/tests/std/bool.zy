begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    /OS = StdOS;
    /bool;
    /process
  ) = make_std (
    VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api
  ) in
  do result <- ! (bool/not) (bool/false);
  ! (bool/if)
    StdOS
    result
    { ! (process/exit) 0 }
    { ! (process/exit) 1 }
end
