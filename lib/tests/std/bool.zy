begin
  let make_std = @(import("../../std/std.zy")) that
  param (/system; /OS; builtin) : @(import("../../std/builtin.zy")) that
  let (/Bool; /bool; /process) = builtin |> make_std in
  do result <- ! bool/not (+False() : Bool);
  match result
  | +False() => ! process/exit 1
  | +True() => ! process/exit 0
  end
end
