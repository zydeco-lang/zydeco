-- stage: run
-- backends: all
@[package(test(of(/std)))]
param (/system; builtin) : @(import(/std/builtin)) in
begin
  let make_std = @(import(/std)) that

  let (/Bool; /bool; /process) = builtin |> make_std in
  do result <- ! bool/not (+False() : Bool);
  match result
  | +False() => ! process/exit 1
  | +True() => ! process/exit 0
  end
end
