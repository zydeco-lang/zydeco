begin
  let make_std = @(import("../../std/std.zy")) that
  param (/system; builtin) : @(import("../../std/builtin.zy")) that
  let (/OS) = system that

  let (/bool; /process) = builtin |> make_std in
  do result <- ! (bool/not) bool/false;
  ! (bool/if)
    OS
    result
    { ! (process/exit) 0 }
    { ! (process/exit) 1 }
end
