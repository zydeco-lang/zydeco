begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/OS; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/OS = StdOS; /bool; /process) = make_std builtin in
  do result <- ! (bool/not) (bool/false);
  ! (bool/if)
    StdOS
    result
    { ! (process/exit) 0 }
    { ! (process/exit) 1 }
end
