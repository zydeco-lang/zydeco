@[package(test(of(std)))]
begin
  param (/VType; /CType; /Thk; /Ret; /Int; /UInt32; /OS; /numeric; /process; /Unit; builtin) :
  @(import(
    std/builtin
  )) that
  let (/storage; /codecs;
    /Uninit;
    /Init;
    /Fields;
    /Ptr;
    /arrays;
    /records;
    /headers;
    /views;
    /fixed;
    /allocation;
    /pointer
  )
  =
    builtin |> (@(import(std/memory)))
  in
  let (= Plan, = Layout, layout) = fixed in
  let (/heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in
  let run =
    match layout/int
    | +Err(_) => fail
    | +Ok(plan) =>
      let (#L = Length, length) = layout/realize Int plan in
      match layout/uint32
      | +Err(_) => fail
      | +Ok(plan) =>
        let (#L = Element, element) = layout/realize UInt32 plan in
        match arrays/make Element element/storage 4 16
        | +Err(_) => fail
        | +Ok(array) =>
          let (/L = Array; /storage = array_storage; /elements) = array in
          match records/product Length Array length/storage array_storage
          | +Err(_) => fail
          | +Ok(record) =>
            let (/L; /storage = object_storage; /states; /left; /right) = record in
            let forms = headers/from_fields L Length Array Int length/codec left/path right/path in
            let (/H; /unsafe = inline) = forms/inline in
            let (/H = Prefix; /unsafe = prefix) = forms/prefix in
            let checked = views/bounded Array Init (H Init) 4 (inline/open Init) in
            {
              ! (allocation/reserve L Unit allocation/static_heap () object_storage) OS no
                {
                  fn vacant =>
                    let base = pointer/unsafe/address L Uninit vacant in
                    -- Stored scalars own no resources. Discard their values before releasing the base.
                    let finish = {
                      let vacant = pointer/unsafe/from_address L Uninit base in
                      ! (
                        allocation/unsafe/release L Unit allocation/static_heap () object_storage
                          vacant
                      )
                        OS no { ! process/exit 0 }
                    } in
                    ! (left/init Int length/codec Uninit (states/empty vacant) 4) OS {
                      fn building =>
                        do destination <- ! (right/project Uninit Init building);
                        ! elements/init_each OS destination {
                          fn _ slot _ yes =>
                            ! (element/codec/init slot 73) OS yes
                        } { fn _ _ => ! fail } {
                          fn initialized =>
                            let completed = right/replace Uninit Init Init building initialized in
                            let live = states/finish completed in
                            let base = pointer/unsafe/address L Init live in
                            ! (checked (inline/from_address Init base)) OS no {
                              fn (payload, count) =>
                                ! numeric/int/eq OS count 4 {
                                  let payload_address = pointer/unsafe/address Array Init payload in
                                  ! (prefix/open Init (prefix/from_address Init payload_address)) OS
                                    {
                                      fn (payload, saved_count) =>
                                        ! elements/at Init OS payload 3 no {
                                          fn last =>
                                            ! (element/codec/read last) OS {
                                              fn item =>
                                                ! numeric/uint32/eq OS item 73 {
                                                  ! numeric/int/store_le OS base 0 {
                                                    ! (
                                                      inline/open Init (
                                                        inline/from_address Init base
                                                      )
                                                    )
                                                      OS {
                                                      fn (_, current_count) =>
                                                        ! numeric/int/eq OS saved_count 4 {
                                                          ! numeric/int/eq OS current_count 0 {
                                                            ! numeric/int/store_le OS base 9 {
                                                              ! (
                                                                checked (
                                                                  inline/from_address Init base
                                                                )
                                                              ) OS {
                                                                fn fault =>
                                                                  match fault
                                                                  | +Bounds() => ! finish
                                                                  | _ => ! fail
                                                                  end
                                                              } { fn _ => ! fail }
                                                            }
                                                          } fail
                                                        } fail
                                                    }
                                                  }
                                                } fail
                                            }
                                        }
                                    }
                                } fail
                            }
                        }
                    }
                }
            }
          end
        end
      end
    end
  in
  ! run
end
