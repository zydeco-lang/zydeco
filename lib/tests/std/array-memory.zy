@[package(test(of(/std)))]
begin
  param (/VType; /CType; /Thk; /Ret; /Int; /UInt32; /OS; /numeric; /process; /Unit; builtin) :
  @(import(
    /std/builtin
  )) that
  let (/storage; /codecs; /Uninit; /Init; /Ptr; /arrays; /fixed; /allocation) = builtin |> (
    @(import(/std/memory))
  ) in
  let (= Plan, = Layout, layout) = fixed in
  let (/heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in
  let run =
    match layout/uint32
    | +Err(_) => fail
    | +Ok(plan) =>
      let (#L = Element, element) = layout/realize UInt32 plan in
      match arrays/make Element element/storage 4 16
      | +Err(_) => fail
      | +Ok(array) =>
        let (
          /L;
          /Build;
          /Values = Sequence;
          /storage = array_storage;
          /values;
          /capacity;
          /elements;
          /buffer;
          /codecs = array_codecs;
          /dynamic_codecs = array_dynamic_codecs
        )
        =
          array
        in
        let Values = Sequence UInt32 in
        let contents = (#storage = array_storage, #codec = array_codecs UInt32 element/codec) in
        let complete =
          {
            -- The second allocation reaches whole-array Init without intermediate values.
            ! (allocation/reserve L Unit allocation/static_heap () contents/storage) OS no
              {
                fn vacant =>
                  ! elements/init_each OS vacant {
                    fn _ pointer _ yes =>
                      ! (element/codec/init pointer 19) OS yes
                  } { fn _ _ => ! fail }
                    {
                      fn live =>
                        ! elements/at Init OS live 3 no
                          {
                            fn last =>
                              ! (element/codec/read last) OS
                                {
                                  fn item =>
                                    ! numeric/uint32/eq OS item 19
                                      {
                                        -- Whole-value taking explicitly copies the elements into a logical value.
                                        ! (codecs/unsafe/take L Values contents/codec live) OS {
                                          fn vacant copied =>
                                            do last <- ! values/at UInt32 copied 3;
                                            match last
                                            | +Err(_) => ! fail
                                            | +Ok(item) => ! numeric/uint32/eq OS item 19 {
                                              ! (
                                                allocation/unsafe/release L Unit
                                                  allocation/static_heap () contents/storage vacant
                                              ) OS no {
                                                ! process/exit 0
                                              }
                                            } fail
                                            end
                                        }
                                      } fail
                                }
                          }
                    }
              }
          }
        in
        {
          ! (allocation/reserve L Unit allocation/static_heap () contents/storage) OS no {
            fn vacant =>
              ! elements/init_each OS vacant {
                fn index pointer error yes =>
                  ! numeric/int/eq OS index 2 { ! error +Bounds() pointer } {
                    ! (element/codec/init pointer 7) OS yes
                  }
              } {
                fn fault progress =>
                  match fault
                  | +Bounds() =>
                    do length <- ! buffer/length progress;
                    ! numeric/int/eq OS length 2 {
                      ! buffer/free OS heap progress {
                        fn fault =>
                          match fault
                          | +Bounds() =>
                            ! (buffer/pop UInt32 element/codec progress) OS no {
                              fn progress item =>
                                ! numeric/uint32/eq OS item 7 {
                                  ! (buffer/pop UInt32 element/codec progress) OS no {
                                    fn empty _ =>
                                      ! buffer/free OS heap empty no {
                                        ! complete
                                      }
                                  }
                                } fail
                            }
                          | _ => ! fail
                          end
                      } fail
                    } fail
                  | _ => ! fail
                  end
              } { fn _ => ! fail }
          }
        }
      end
    end
  in
  ! run
end
