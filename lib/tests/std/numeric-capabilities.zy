begin
  let make_std = @(import("../../std/std.zy")) that
  param (/VType; /Ret; /OS; /Int64; /Float64; /numeric; builtin) : @(import("../../std/builtin.zy")) that
  let (/Bool; /Numeric; /bool; /int64; /float64; /process; dictionaries) = builtin |> make_std in
  let int64_raw = numeric/int64 in
  let ! multiply_add_equal (A : VType)
    (dictionary : Numeric Bool A)
    (left : A)
    (right : A)
    (offset : A)
    (expected : A)
  : Ret Bool =
      do product <- ! dictionary/multiplicative/mul left right;
      do total <- ! dictionary/additive/add product offset;
      ! dictionary/order/equality/eq total expected
  in
  let ! strictly_less (A : VType)
    (dictionary : Numeric Bool A)
    (left : A)
    (right : A)
  : Ret Bool = ! dictionary/order/lt left right in

  let IntScalar = Int64 in
  let (/int64_dictionary = int_dictionary) = dictionaries in
  do primitive_total <- ! int64_raw/add 40 2;
  do primitive_ok <- ! int_dictionary/order/equality/eq primitive_total 42;
  do int_arithmetic <- ! multiply_add_equal
    IntScalar int_dictionary 6 7 0 42;
  do int_order <- ! strictly_less IntScalar int_dictionary 41 42;
  do int_operations_ok <- ! bool/and int_arithmetic int_order;
  do int_ok <- ! bool/and primitive_ok int_operations_ok;

  let FloatScalar = Float64 in
  let (/float64_dictionary = float_dictionary) = dictionaries in
  do float_arithmetic <- ! multiply_add_equal
    FloatScalar float_dictionary 1.5 2.0 0.5 3.5;
  do float_order <- ! strictly_less
    FloatScalar float_dictionary 3.5 4.0;
  do float_ok <- ! bool/and float_arithmetic float_order;

  do success <- ! bool/and int_ok float_ok;
  ! bool/if
    OS
    success
    { ! process/exit 0 }
    { ! process/exit 1 }
end
