@[package(test(of(std)))]
begin
  param (/VType; /CType; /Thk; /Ret; /Unit; /OS; /Int;
    /UInt8; /numeric; /process; builtin) : @(import(std/builtin)) that
  let (/Bytes; /bytes) = builtin |> (@(import("../../std/text/bytes.zy"))) in
  let (/storage; /codecs; /allocation; /dynamic) = builtin |> (@(import(std/memory))) in
  let (= Layout, = Representation, memory) = dynamic in
  let fail = { ! process/exit 1 } in
  let ! rejected (A : VType) (layout : Layout A) (next : Thk OS) : OS =
    ! memory/realize A OS layout next { fn _ => ! fail }
  in
  let ! bad_alignment (buffer : Bytes) (alignment : Int) (next : Thk OS) : OS =
    ! bytes/aligned OS buffer alignment next { fn _ => ! fail }
  in
  do buffer <- ! bytes/from_string "test";
  ! bad_alignment buffer 0
    {
      ! bad_alignment buffer 3
        {
          ! bad_alignment buffer -8
            {
              ! rejected Unit (memory/padding -1)
                {
                  ! rejected Unit (memory/padding -4611686018427387904)
                    {
                      ! rejected Int (memory/align Int 0 memory/int)
                        {
                          ! rejected Int (memory/align Int 3 memory/int)
                            {
                              ! rejected Int (memory/align Int -8 memory/int)
                                {
                                  ! rejected (Unit * UInt8)
                                    (
                                      memory/product Unit UInt8 (memory/padding 4611686018427387903)
                                        memory/uint8
                                    )
                                    {
                                      ! rejected Unit (
                                        memory/align Unit 8 (memory/padding 4611686018427387903)
                                      )
                                        {
                                          -- Maximum size is representable as metadata until rounding or adding overflows.
                                          ! memory/realize Unit OS (
                                            memory/padding 4611686018427387903
                                          ) fail
                                            {
                                              fn (= L, repr) =>
                                                ! numeric/int/eq OS (
                                                  storage/runtime/query L repr/storage
                                                )/size 4611686018427387903
                                                  {
                                                    -- Validation did not modify an aliased input buffer.
                                                    do expected <- ! bytes/from_string "test";
                                                    ! bytes/eq OS buffer expected {
                                                      ! process/exit 0
                                                    } fail
                                                  } fail
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
end
