@[package(test(of(std)))]
begin
  param (/Thk; /Ret; /OS; /Int64; /UInt8; /UInt32; /Buffer;
    /numeric; /process; builtin) : @(import(std/builtin)) that
  let (/Bytes; /bytes; byte_package) = builtin |> (@(import("../../std/text/bytes.zy"))) in
  let buffer = (builtin |> (@(import("../../std/memory/buffer.zy")))) byte_package in

  let make_memory = @(import(std/memory)) in
  let make_access = @(import("../../std/memory/access.zy")) in
  let make_allocation = @(import("../../std/memory/allocation.zy")) in
  let (= Layout, = Representation, memory) = (builtin |> make_memory) byte_package in
  let (= Allocator, = Allocate, allocation) = (builtin |> make_allocation) byte_package in
  let access = (builtin |> make_access) byte_package in
  let fail = { ! process/exit 1 } in
  let error = { fn (_ : Int64) => ! fail } in
  let ! check_reads (byte_repr : Representation UInt8) (word_repr : Representation UInt32)
    (frozen : Bytes)
  : OS =
      ! access/read_at UInt8 OS byte_repr frozen 0 fail {
        fn tag =>
          ! numeric/uint8/eq OS tag 7 {
            ! access/read_at UInt32 OS word_repr frozen 4 fail {
              fn word =>
                ! numeric/uint32/eq OS word 16909060 {
                  ! access/read_at UInt32 OS word_repr frozen -1 {
                    ! access/read_at UInt32 OS word_repr frozen 62 {
                      ! process/exit 0
                    } { fn _ => ! fail }
                  } { fn _ => ! fail }
                } fail
            }
          } fail
      }
  in
  ! memory/realize UInt8 OS memory/uint8 fail {
    fn byte_repr =>
      ! memory/realize UInt32 OS memory/uint32 fail {
        fn word_repr =>
          let allocator = allocation/limited 64 allocation/heap in
          ! allocation/allocate 64 64 allocator error {
            fn destination =>
              ! access/write_to UInt8 byte_repr destination 0 7 error {
                ! access/write_to UInt32 word_repr destination 4 16909060 error {
                  ! access/write_to UInt32 word_repr destination 62 0 {
                    fn code =>
                      ! numeric/int64/eq OS code 2 {
                        ! buffer/freeze destination error {
                          fn frozen =>
                            ! check_reads byte_repr word_repr frozen
                        }
                      } fail
                  } fail
                }
              }
          }
      }
  }
end
