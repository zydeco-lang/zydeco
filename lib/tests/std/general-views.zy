@[package(test(of(std)))]
begin
  param (
    /VType;
    /CType;
    /Thk;
    /Ret;
    /Unit;
    /Int;
    /UInt32;
    /Addr;
    /OS;
    /numeric;
    /process;
    builtin
  ) : @(import(std/builtin)) that
  let (/storage; /codecs;
    /Uninit;
    /Init;
    /Fields;
    /Field;
    /Ptr;
    /fields;
    /records;
    /headers;
    /views;
    /fixed;
    /allocation;
    /pointer;
    /raw
  )
  =
    builtin |> (@(import(std/memory)))
  in
  let (= Plan, = Layout, layout) = fixed in
  let (/initialized) = fields in
  let (/Cps; /precompose; /materialize; /unsafe = view_unsafe) = views in
  let (/heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in
  let run =
    match layout/int
    | +Err(_) => fail
    | +Ok(length_plan) =>
      let (#L = Length, length) = layout/realize Int length_plan in
      match layout/uint32
      | +Err(_) => fail
      | +Ok(value_plan) =>
        let (#L = Value, value) = layout/realize UInt32 value_plan in
        match records/at Length Value length/storage value/storage 0 16 32 16
        | +Err(_) => fail
        | +Ok(record) =>
          let (/L; /storage = object_storage; /states; /left; /right) = record in
          let object = (
            #storage = object_storage,
            #codec = codecs/product L Length Value Int UInt32 left/path right/path length/codec
              value/codec
          ) in
          let named = (#length = left, #payload = right) in
          let forms = headers/from_fields L Length Value Int length/codec named/length/path
            named/payload/path in
          let (/H; /unsafe = inline) = forms/inline in
          let (/H = Prefix; /unsafe = prefix) = forms/prefix in
          let check_padding : Thk (Ptr L Init -> OS) = {
            fn live =>
              -- Padding remains untouched by direct field initialization.
              let base = pointer/unsafe/address L Init live in
              do gap <- ! raw/unsafe/offset base 8;
              ! numeric/uint/load_le OS gap {
                fn padding =>
                  ! numeric/uint/eq OS padding 6148914691236517205 {
                    ! (codecs/unsafe/take L (Int * UInt32) object/codec live) OS {
                      fn vacant _ =>
                        ! (
                          allocation/unsafe/release L Unit allocation/static_heap () object/storage
                            vacant
                        ) OS no { ! process/exit 0 }
                    }
                  } fail
              }
          } in
          let check_dynamic : Thk (Ptr L Init -> Addr -> OS) = {
            fn live slot =>
              -- A retained dynamic opener has the same explicit read effects.
              let base = pointer/unsafe/address L Init live in
              let runtime_view = materialize Cps (H Init) (Ptr Value Init * Int) (
                inline/open Init
              ) in
              ! runtime_view (inline/from_address Init base) OS {
                fn (_, observed) =>
                  ! numeric/int/eq OS observed 1 {
                    ! raw/unsafe/free OS slot 8 8 no { ! check_padding live }
                  } fail
              }
          } in
          let check_indirect : Thk (Ptr L Init -> OS) = {
            fn live =>
              let base = pointer/unsafe/address L Init live in
              let open_address = precompose Cps Addr (H Init) (Ptr Value Init * Int)
                (inline/from_address Init) (inline/open Init) in
              ! raw/allocate OS 8 8 no {
                fn slot =>
                  ! raw/unsafe/store_addr OS slot base {
                    ! (view_unsafe/indirect (Ptr Value Init * Int) open_address slot) OS {
                      fn (restored, _) =>
                        ! (value/codec/read restored) OS {
                          fn read =>
                            ! numeric/uint32/eq OS read 41 { ! check_dynamic live slot } fail
                        }
                    }
                  }
              }
          } in
          let check_headers : Thk (Ptr L Init -> OS) = {
            fn live =>
              let base = pointer/unsafe/address L Init live in
              do payload <- ! (initialized L Value named/payload/path live);
              ! (value/codec/read payload) OS {
                fn read =>
                  ! numeric/uint32/eq OS read 41 {
                    ! (inline/open Init (inline/from_address Init base)) OS {
                      fn (_, first_count) =>
                        do payload_address <- ! raw/unsafe/offset base 16;
                        ! (prefix/open Init (prefix/from_address Init payload_address)) OS {
                          fn (payload, count) =>
                            ! numeric/int/eq OS first_count count {
                              ! (value/codec/read payload) OS {
                                fn read =>
                                  ! numeric/uint32/eq OS read 41 { ! check_indirect live } fail
                              }
                            } fail
                        }
                    }
                  } fail
              }
          } in
          {
            ! (allocation/reserve L Unit allocation/static_heap () object/storage) OS no {
              fn vacant =>
                let base = pointer/unsafe/address L Uninit vacant in
                ! raw/unsafe/fill OS base 32 85 {
                  ! (named/length/init Int length/codec Uninit (states/empty vacant) 1) OS {
                    fn partial =>
                      ! (named/payload/init UInt32 value/codec Init partial 41) OS {
                        fn complete =>
                          ! check_headers (states/finish complete)
                      }
                  }
                }
            }
          }
        end
      end
    end
  in
  ! run
end
