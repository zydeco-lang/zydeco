begin
  param (/Thk; /Ret; /OS; /Int64; /UInt8; /UInt32; /numeric; /process; builtin) : @(import(
    "../../std/builtin.zy"
  )) that
  let (/Bytes; /bytes; byte_package) = builtin |> (@(import("../../std/text/bytes.zy"))) in
  let buffer = (builtin |> (@(import("../../std/memory/buffer.zy")))) byte_package in

  let make_memory = @(import("../../std/memory/static-layout.zy")) in
  let make_access = @(import("../../std/memory/access.zy")) in
  let (= Plan, = Layout, memory) = (builtin |> make_memory) byte_package in
  let access = (builtin |> make_access) byte_package in
  let fail = { ! process/exit 1 } in
  let error = { fn (_ : Int64) => ! fail } in
  let record = memory/align (UInt8 * UInt32) 16
    (
      memory/product UInt8 UInt32 memory/uint8 memory/uint32
    ) in
  match (record, memory/uint8, memory/uint32)
  | (+Ok(plan), +Ok(byte_plan), +Ok(word_plan)) =>
    let shape = memory/inspect (UInt8 * UInt32) plan in
    let offset =
      match shape/form
      | +Product(fields) => fields/offset
      | _ => -1
      end
    in
    let byte_repr = memory/realize UInt8 byte_plan in
    let word_repr = memory/realize UInt32 word_plan in
    let (= Stored, repr) = memory/realize (UInt8 * UInt32) plan in
    ! buffer/allocate shape/size shape/alignment error {
      fn destination =>
        ! access/write_to UInt8 byte_repr destination 0 7 error {
          ! access/write_to UInt32 word_repr destination offset 16909060 error {
            ! buffer/freeze destination error {
              fn frozen =>
                ! repr/from_bytes OS frozen fail {
                  fn stored =>
                    ! repr/load OS stored fail {
                      fn (tag, word) =>
                        ! numeric/uint8/eq OS tag 7 {
                          ! numeric/uint32/eq OS word 16909060 { ! process/exit 0 } fail
                        } fail
                    }
                }
            }
          }
        }
    }
  | _ => ! fail
  end
end
