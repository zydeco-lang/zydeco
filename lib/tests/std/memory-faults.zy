@[package(test(of(/std)))]
begin
  param (/VType; /CType; /Thk; /Ret; /Unit; /Int; /UInt8; /UInt32; /Addr; /OS;
    /numeric; /process; builtin) : @(import(/std/builtin)) that
  let (/Uninit; /Init; /Ptr; /Slice; /slices; /fixed; /dynamic; /allocation; /pointer; /raw) =
    builtin |> (@(import(/std/memory)))
  in
  let (= Plan, = Layout, layout) = fixed in
  let (/Alloc; /heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in

  let ! invalid (count : Int) (alignment : Int) (next : Thk OS) : OS =
    ! raw/allocate OS count alignment {
      fn fault =>
        match fault
        | +InvalidLayout() => ! next
        | _ => ! fail
        end
    } { fn _ => ! fail }
  in
  let ! copy_test (next : Thk OS) : OS =
    ! raw/allocate OS 4 1 no {
      fn base =>
        ! numeric/uint32/store_le OS base 67305985 {
          do second <- ! raw/unsafe/offset base 1;
          ! raw/unsafe/copy OS base second 3 {
            ! numeric/uint32/load_le OS base {
              fn right =>
                ! numeric/uint32/eq OS right 50462977 {
                  ! raw/unsafe/copy OS second base 3 {
                    ! numeric/uint32/load_le OS base {
                      fn left =>
                        ! numeric/uint32/eq OS left 50528769 {
                          do empty <- ! raw/unsafe/null;
                          ! raw/unsafe/copy OS empty empty 0 {
                            ! raw/unsafe/fill OS empty 0 0 {
                              ! raw/unsafe/free OS base 4 1 no next
                            }
                          }
                        } fail
                    }
                  }
                } fail
            }
          }
        }
    }
  in
  let small = allocation/limited 4 heap in
  ! invalid -1 8 {
    ! invalid 4 0 {
      ! invalid 4 3 {
        ! small/allocate OS 5 8 {
          fn fault =>
            match fault
            | +AllocationFailed() =>
              ! raw/allocate OS 0 64 no {
                fn pointer =>
                  ! raw/unsafe/free OS pointer 0 64 no { ! copy_test { ! process/exit 0 } }
              }
            | _ => ! fail
            end
        } { fn _ => ! fail }
      }
    }
  }
end
