begin
  let make_std = @(import("../../std/std.zy")) that
  param (/VType; /CType; /Thk; /Ret; /Int64; builtin) : @(import("../../std/builtin.zy")) that

  let (/process) = builtin |> make_std in
  let ! first : Ret Int64 = ret 0 in
  do first <- ! first;
  let ! second : Ret Int64 = ret first in
  do status <- ! second;
  ! process/exit status
end
