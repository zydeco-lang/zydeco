begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  let (= Thunk, = U, = F, ()) = std/prelude in
  let first : Thunk (F StdInt) = { ret 0 } in
  do first <- ! first;
  let second : U (Ret StdInt) = { ret first } in
  do status <- ! second;
  ! (std/os/exit) status
end
