begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/core; /representations; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/Ret) = core that
  let (/Scalar = Int64) = representations/i64 that

  let (/prelude; /process) = make_std builtin in
  let (= Thunk, = U, = F, ()) = prelude in
  let ! first : F Int64 =
    ret 0
  in
  do first <- ! first;
  let ! second : Ret Int64 =
    ret first
  in
  do status <- ! second;
  ! (process/exit) status
end
