begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/Ret; /Int; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/prelude; /process) = make_std builtin in
  let (= Thunk, = U, = F, ()) = prelude in
  let ! first : F Int =
    ret 0
  in
  do first <- ! first;
  let ! second : Ret Int =
    ret first
  in
  do status <- ! second;
  ! (process/exit) status
end
