@[package(test(of(/std)))]
begin
  let make_std = @(import(/std)) that
  param (/VType; /CType; /Thk; /Ret; /Int; builtin) : @(import(/std/builtin)) that

  let (/process) = builtin |> make_std in
  let ! first : Ret Int = ret 0 in
  do first <- ! first;
  let ! second : Ret Int = ret first in
  do status <- ! second;
  ! process/exit status
end
