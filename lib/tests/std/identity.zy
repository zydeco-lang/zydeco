begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    Bool = StdBool,
    Option = StdOption,
    Result = StdResult,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    Bytes = StdBytes,
    Reader = StdReader,
    Writer = StdWriter,
    Path = StdPath,
    IoErrorKind = StdIoErrorKind,
    IoError = StdIoError,
    OS = StdOS,
    std
  ) = std (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) in
  let (= Thunk, = U, = F, ()) = std/prelude in
  let ! first : F StdInt =
    ret 0
  in
  do first <- ! first;
  let ! second : Ret StdInt =
    ret first
  in
  do status <- ! second;
  ! (std/process/exit) status
end
