@[package(test(of(/std)))]
param (/OS = _; builtin) : @(import(/std/builtin)) in
let (/make = make_prelude) = @(import(/std/prelude)) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let make_std = @(import(/std)) that

  let (/process) = builtin |> make_std in
  let ! first : Ret Int = ret 0 in
  do first <- ! first;
  let ! second : Ret Int = ret first in
  do status <- ! second;
  ! process/exit status
end
