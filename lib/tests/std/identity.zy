begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    /Int = StdInt;
    /prelude;
    /process
  ) = make_std (
    VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api
  ) in
  let (= Thunk, = U, = F, ()) = prelude in
  let ! first : F StdInt =
    ret 0
  in
  do first <- ! first;
  let ! second : Ret StdInt =
    ret first
  in
  do status <- ! second;
  ! (process/exit) status
end
