begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    public
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin
    def identity : Thk (forall (A : VType) . A -> Ret A) = {
      fn (A : VType) (value : A) ->
        ret value
    } that

    do first <- ! identity StdInt 0;
    do second <- ! identity StdInt first;
    do third <- ! identity StdInt second;
    do status <- ! identity StdInt third;
    ! (public/exit) status
  end
end
