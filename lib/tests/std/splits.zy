@[package(test(of(/std)))]
param (/OS = _; builtin) : @(import(/std/builtin)) in
let (/make = make_prelude) = @(import(/std/prelude)) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let make_std = @(import(/std)) that

  let (/option; /int; /string; /process) = builtin |> make_std in
  do present <- ! string/split_once "left:right" ':';
  do present_status <- ! option/fold
    (String * String)
    (Ret Int)
    present
    { ret 1 }
    {
      fn pair => ret 0
    };
  do absent <- ! string/split_at "short" 99;
  do absent_status <- ! option/fold
    (String * String)
    (Ret Int)
    absent
    { ret 0 }
    {
      fn pair => ret 1
    };
  do status <- ! int/add present_status absent_status;
  ! process/exit status
end
