begin
  let make_std = @(import("../../std/std.zy")) that
  param (/core; /representations; builtin) : @(import("../../std/builtin.zy")) that
  let (/Ret) = core that
  let (/Int64) = representations/i64 that
  let (/String) = representations/string that

  let (/option; /int64; /string; /process) = builtin |> make_std in
  do present <- ! (string/split_once) "left:right" ':';
  do present_status <- ! (option/fold)
    (String * String)
    (Ret Int64)
    present
    { ret 1 }
    {
      fn pair => ret 0
    };
  do absent <- ! (string/split_at) "short" 99;
  do absent_status <- ! (option/fold)
    (String * String)
    (Ret Int64)
    absent
    { ret 0 }
    {
      fn pair => ret 1
    };
  do status <- ! (int64/add) present_status absent_status;
  ! (process/exit) status
end
