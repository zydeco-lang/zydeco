begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/core; /representations; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/Ret) = core that
  let (/Scalar = Int64) = representations/i64 that
  let (/Scalar = String) = representations/string that

  let (/option; /int64; /string; /process) = make_std builtin in
  do present <- ! (string/split_once) "left:right" ':';
  do present_status <- ! (option/fold)
    (String * String)
    (Ret Int64)
    present
    { ret 1 }
    {
      fn pair =>
        ret 0
    };
  do absent <- ! (string/split_at) "short" 99;
  do absent_status <- ! (option/fold)
    (String * String)
    (Ret Int64)
    absent
    { ret 0 }
    {
      fn pair =>
        ret 1
    };
  do status <- ! (int64/add) present_status absent_status;
  ! (process/exit) status
end
