begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) = std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
  do present <- ! (std/string/split_once) "left:right" ':';
  do present_status <- ! (std/option/fold)
    (StdString * StdString)
    (Ret StdInt)
    present
    { ret 1 }
    {
      fn pair ->
        ret 0
    };
  do absent <- ! (std/string/split_n) "short" 99;
  do absent_status <- ! (std/option/fold)
    (StdString * StdString)
    (Ret StdInt)
    absent
    { ret 0 }
    {
      fn pair ->
        ret 1
    };
  do status <- ! (std/int/add) present_status absent_status;
  ! (std/os/exit) status
end
