begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/Ret; /Int; /String; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/Int = StdInt; /String = StdString; /option; /int; /string; /process) = make_std builtin in
  do present <- ! (string/split_once) "left:right" ':';
  do present_status <- ! (option/fold)
    (StdString * StdString)
    (Ret StdInt)
    present
    { ret 1 }
    {
      fn pair =>
        ret 0
    };
  do absent <- ! (string/split_at) "short" 99;
  do absent_status <- ! (option/fold)
    (StdString * StdString)
    (Ret StdInt)
    absent
    { ret 0 }
    {
      fn pair =>
        ret 1
    };
  do status <- ! (int/add) present_status absent_status;
  ! (process/exit) status
end
