@[package(test(of(/std)))]
begin
  param (/VType; /CType; /Thk; /OS; /UInt8; /UInt32; /numeric; /process; /Unit; builtin) : @(import(
    std/builtin
  )) in
  let (/storage; /codecs; /Uninit; /Init; /Ptr; /fixed; /allocation) = builtin |> (
    @(import(/std/memory))
  ) in
  let (= Plan, = Layout, layouts) = fixed in
  let (/Alloc; /heap) = allocation in
  let Fault = @(import("../../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in
  let make_worker = builtin |> (@(import("worker.zy"))) in
  match layouts/product UInt8 UInt32 layouts/uint8 layouts/uint32
  | +Err(_) => ! fail
  | +Ok(plan) =>
    let (= L, repr) = layouts/realize (UInt8 * UInt32) plan in
    let worker = make_worker (Ptr L Init) (Ptr L Uninit) {
      fn R pointer yes => ! (codecs/unsafe/take L (UInt8 * UInt32) repr/codec pointer) R yes
    } { fn R pointer value yes => ! (repr/codec/init pointer value) R yes } in
    ! (allocation/reserve L Unit allocation/static_heap () repr/storage) OS no {
      fn vacant =>
        ! (repr/codec/init vacant (7 : UInt8, 41 : UInt32)) OS {
          fn live =>
            ! worker OS live {
              fn updated =>
                ! (codecs/unsafe/take L (UInt8 * UInt32) repr/codec updated) OS {
                  fn vacant (tag, payload) =>
                    ! numeric/uint8/eq OS tag 7 {
                      ! numeric/uint32/eq OS payload 42 {
                        ! (
                          allocation/unsafe/release L Unit allocation/static_heap () repr/storage
                            vacant
                        ) OS no { ! process/exit 0 }
                      } fail
                    } fail
                }
            }
        }
    }
  end
end
