@[package(test(of(std)))]
begin
  param (/VType; /CType; /Thk; /OS; /UInt8; /UInt32; /numeric; /process; builtin) : @(import(
    std/builtin
  )) in
  let (/Uninit; /Init; /Ptr; /fixed; /allocation) = builtin |> (@(import(std/memory))) in
  let (= Plan, = Layout, layouts) = fixed in
  let (/Alloc; /heap) = allocation in
  let Fault = @(import("../../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in
  let make_worker = builtin |> (@(import("worker.zy"))) in
  match layouts/product UInt8 UInt32 layouts/uint8 layouts/uint32
  | +Err(_) => ! fail
  | +Ok(plan) =>
    let (= L, repr) = layouts/realize (UInt8 * UInt32) plan in
    let worker = make_worker (Ptr L Init) (Ptr L Uninit) repr/unsafe/take repr/unsafe/init in
    ! repr/allocate OS heap no {
      fn vacant =>
        ! repr/unsafe/init OS vacant (7 : UInt8, 41 : UInt32) {
          fn live =>
            ! worker OS live {
              fn updated =>
                ! repr/unsafe/take OS updated {
                  fn vacant (tag, payload) =>
                    ! numeric/uint8/eq OS tag 7 {
                      ! numeric/uint32/eq OS payload 42 {
                        ! repr/unsafe/free OS heap vacant no { ! process/exit 0 }
                      } fail
                    } fail
                }
            }
        }
    }
  end
end
