begin
  param val (/VType; /Thk; /OS; /UInt8; /UInt32; /numeric) : @(import("../../../std/builtin.zy")) that
  param val Bytes : VType in
  let Storage = (@(import("../../../std/memory/storage.type.zy"))) Bytes in
  let (/Function; calls) = (@(import("../../../std/memory/call.zy"))) Bytes in
  let val worker (Stored : VType) (storage : Storage (UInt8 * UInt32) Stored) :
    Thk (Function Stored Stored OS) =
      let boundary = calls/between (UInt8 * UInt32) (UInt8 * UInt32) Stored Stored storage storage
      in
      boundary/encode OS {
        fn (tag, payload) no yes =>
          do next <- ! numeric/uint32/add payload 1;
          ! yes (tag, next)
      }
  in
  worker
end
