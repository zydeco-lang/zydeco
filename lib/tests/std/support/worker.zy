-- Share the pointer types and CPS operations across a source-module boundary.
begin
  param val (/numeric; builtin) : @(import("../../../std/builtin.zy")) in
  let (/make = make_prelude) = @(import("../../../std/prelude.zy")) in
  let prelude = make_prelude builtin in
  @[prelude(core, from(prelude))]
  let Record = UInt8 * UInt32 in
  let val worker (Live : VType) (Vacant : VType)
    (take : Thk (forall (R : CType) . Live -> Thk (Vacant -> Record -> R) -> R))
    (init : Thk (forall (R : CType) . Vacant -> Record -> Thk (Live -> R) -> R))
  : Thk (forall (R : CType) . Live -> Thk (Live -> R) -> R) = {
      fn R pointer yes =>
        ! take R pointer {
          fn vacant (tag, payload) =>
            do next <- ! numeric/uint32/add payload 1;
            ! init R vacant (tag, next) yes
        }
    }
  in
  worker
end
