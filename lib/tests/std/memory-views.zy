@[package(test(of(std)))]
begin
  param (/VType; /CType; /Thk; /Ret; /Unit; /Int64; /UInt8; /UInt32; /Addr; /OS;
    /numeric; /process; builtin) : @(import(std/builtin)) that
  let (/Uninit; /Init; /Ptr; /Slice; /slices; /fixed; /dynamic; /allocation; /pointer; /raw) =
    builtin |> (@(import(std/memory)))
  in
  let (= Plan, = Layout, layout) = fixed in
  let (/Alloc; /heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in

  match layout/int64
  | +Err(_) => ! fail
  | +Ok(plan) =>
    let (= L, repr) = layout/realize Int64 plan in
    let access = slices/for_layout L Int64 repr in
    ! raw/allocate OS 24 8 no {
      fn base =>
        do second <- ! raw/unsafe/offset base 8;
        do slot <- ! raw/unsafe/offset base 16;
        ! repr/unsafe/init OS (pointer/unsafe/from_address L Uninit base) 11 {
          fn first =>
            ! repr/unsafe/init OS (pointer/unsafe/from_address L Uninit second) 22 {
              fn _ =>
                ! raw/unsafe/store_addr OS slot base {
                  ! raw/unsafe/load_addr OS slot {
                    fn restored =>
                      ! slices/unsafe/from_parts L Init OS (
                        pointer/unsafe/from_address L Init restored
                      ) 2 no {
                        fn slice =>
                          ! access/unsafe/at Init OS slice 2 {
                            fn fault =>
                              match fault
                              | +Bounds() =>
                                ! access/unsafe/at Init OS slice 1 no {
                                  fn pointer =>
                                    ! repr/unsafe/read OS pointer {
                                      fn value =>
                                        ! numeric/int64/eq OS value 22 {
                                          ! raw/unsafe/free OS base 24 8 no { ! process/exit 0 }
                                        } fail
                                    }
                                }
                              | _ => ! fail
                              end
                          } { fn _ => ! fail }
                      }
                  }
                }
            }
        }
    }
  end
end
