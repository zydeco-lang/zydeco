@[package(test(of(std)))]
begin
  param (/VType; /CType; /Thk; /Ret; /Unit; /Int; /UInt8; /UInt32; /Addr; /OS;
    /numeric; /process; builtin) : @(import(std/builtin)) that
  let (
    /storage;
    /codecs;
    /Uninit;
    /Init;
    /Ptr;
    /Slice;
    /slices;
    /fixed;
    /dynamic;
    /allocation;
    /pointer;
    /raw
  )
  =
    builtin |> (@(import(std/memory)))
  in
  let (= Plan, = Layout, layout) = fixed in
  let (/Alloc; /heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in

  match layout/int
  | +Err(_) => ! fail
  | +Ok(plan) =>
    let (= L, repr) = layout/realize Int plan in
    let access = slices/for_layout L repr/storage in
    ! raw/allocate OS 24 8 no {
      fn base =>
        do second <- ! raw/unsafe/offset base 8;
        do slot <- ! raw/unsafe/offset base 16;
        ! (repr/codec/init (pointer/unsafe/from_address L Uninit base) 11) OS {
          fn first =>
            ! (repr/codec/init (pointer/unsafe/from_address L Uninit second) 22) OS {
              fn _ =>
                ! raw/unsafe/store_addr OS slot base {
                  ! raw/unsafe/load_addr OS slot {
                    fn restored =>
                      ! slices/unsafe/from_parts L Init OS (
                        pointer/unsafe/from_address L Init restored
                      ) 2 no {
                        fn slice =>
                          ! access/unsafe/at Init OS slice 2 {
                            fn fault =>
                              match fault
                              | +Bounds() =>
                                ! access/unsafe/at Init OS slice 1 no {
                                  fn pointer =>
                                    ! (repr/codec/read pointer) OS {
                                      fn value =>
                                        ! numeric/int/eq OS value 22 {
                                          ! raw/unsafe/free OS base 24 8 no { ! process/exit 0 }
                                        } fail
                                    }
                                }
                              | _ => ! fail
                              end
                          } { fn _ => ! fail }
                      }
                  }
                }
            }
        }
    }
  end
end
