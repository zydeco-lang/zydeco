@[package(test(of(std)))]
begin
  param (/VType; /CType; /Thk; /Ret; /Unit; /Int64; /UInt8; /UInt32; /Addr; /OS;
    /numeric; /process; builtin) : @(import(std/builtin)) that
  let (/Uninit; /Init; /Ptr; /Slice; /slices; /fixed; /dynamic; /allocation; /pointer; /raw) =
    builtin |> (@(import(std/memory)))
  in
  let (= Plan, = Layout, layout) = fixed in
  let (/Alloc; /heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in

  let (/Bytes; /bytes; byte_package) = builtin |> (@(import("../../std/text/bytes.zy"))) in
  let (= Buffer, buffer) = (builtin |> (@(import("../../std/memory/buffer.zy")))) byte_package in
  do first <- ! bytes/from_string "ab";
  do expected <- ! bytes/from_string "abc";
  ! buffer/allocate OS heap 4 no {
    fn empty =>
      ! buffer/unsafe/extend OS empty first no {
        fn two =>
          ! buffer/unsafe/snapshot OS two no {
            fn snapshot =>
              ! buffer/unsafe/push OS two 99 no {
                fn three =>
                  ! buffer/unsafe/extend OS three first {
                    fn fault =>
                      match fault
                      | +Bounds() =>
                        ! bytes/eq OS snapshot first {
                          ! buffer/unsafe/finish_heap OS three no {
                            fn result =>
                              ! bytes/eq OS result expected {
                                ! buffer/allocate OS heap 0 no {
                                  fn empty =>
                                    ! buffer/unsafe/close OS heap empty no { ! process/exit 0 }
                                }
                              } fail
                          }
                        } fail
                      | _ => ! fail
                      end
                  } { fn _ => ! fail }
              }
          }
      }
  }
end
