begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    Bool = StdBool,
    Option = StdOption,
    Result = StdResult,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    Bytes = StdBytes,
    Reader = StdReader,
    Writer = StdWriter,
    Path = StdPath,
    IoErrorKind = StdIoErrorKind,
    IoError = StdIoError,
    OS = StdOS,
    std
  ) = std (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) in
  do equal <- ! (std/int/eq) 3 3;
  do equal_status <- ! (std/bool/if)
    (Ret StdInt)
    equal
    { ret 0 }
    { ret 1 };
  do less <- ! (std/int/lt) 2 3;
  do less_status <- ! (std/bool/if)
    (Ret StdInt)
    less
    { ret 0 }
    { ret 1 };
  do greater <- ! (std/int/gt) 3 2;
  do greater_status <- ! (std/bool/if)
    (Ret StdInt)
    greater
    { ret 0 }
    { ret 1 };
  do string_equal <- ! (std/string/eq) "zydeco" "zydeco";
  do string_status <- ! (std/bool/if)
    (Ret StdInt)
    string_equal
    { ret 0 }
    { ret 1 };
  do first <- ! (std/int/add) equal_status less_status;
  do second <- ! (std/int/add) greater_status string_status;
  do status <- ! (std/int/add) first second;
  ! (std/process/exit) status
end
