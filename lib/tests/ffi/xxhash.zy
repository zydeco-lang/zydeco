begin
  let make_xxhash = @(import("../../ffi/xxhash.zy")) that
  param (/Int; /Addr; /text; /numeric; /system; /OS; /process; /UInt32; builtin) : @(import(
    "../../std/builtin.zy"
  )) that
  let (/Bytes; /bytes; byte_package) = builtin |> (@(import("../../std/text/bytes.zy"))) in

  let uint32 = numeric/uint32 that
  let (/xxh32) = (builtin |> make_xxhash) byte_package in

  do input <- ! bytes/from_string "hello";
  do actual <- ! xxh32 input 0;
  ! uint32/eq OS actual 4211111929 { ! process/exit 0 } { ! process/exit 1 }
end
