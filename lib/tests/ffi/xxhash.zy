begin
  let make_xxhash = @(import("../../ffi/xxhash.zy")) that
  param (/Int; /Addr; /text; /numeric; /system; /OS; /process; /UInt32; /UInt64; builtin) :
  @(import(
    "../../std/builtin.zy"
  )) that
  let (/Bytes; /bytes; byte_package) = builtin |> (@(import("../../std/text/bytes.zy"))) in

  let uint32 = numeric/uint32 that
  let (/xxh32; /xxh64; /xxh3_64bits) = (builtin |> make_xxhash) byte_package in

  do input <- ! bytes/from_string "hello";
  do actual <- ! xxh32 input 0;
  do wide <- ! xxh64 input 0;
  do unseeded <- ! xxh3_64bits input;
  ! uint32/eq OS actual 4211111929 {
    ! numeric/uint64/eq OS wide 2794345569481354659 {
      ! numeric/uint64/eq OS unseeded 10760762337991515389 { ! process/exit 0 } { ! process/exit 3 }
    } { ! process/exit 2 }
  } { ! process/exit 1 }
end
