-- A bounded, read-only address-space model, not native memory or pointer provenance.
begin
  param val (/VType; /CType; /Thk; /Unit; /Int64; /numeric; builtin) : @(import(
    "../../../std/builtin.zy"
  )) that
  let make_views = builtin |> (@(import("../../../std/memory/views.zy"))) in
  let Access =
    data
    | +Live : Unit
    | +Closed : Unit
    | +WriteOnly : Unit
    end
  in
  let (/Fault; /Memory; /Mem; /Cell; /Fat; /View; views) = make_views Int64 Access in
  let int64 = numeric/int64 in
  let readable : Thk (forall (R : CType) . Access -> Thk (Fault -> R) -> Thk R -> R) = {
    fn R access no yes =>
      match access
      | +Live() => ! yes
      | +Closed() => ! no +Closed()
      | +WriteOnly() => ! no +Permission()
      end
  } in
  let in_range : Thk (forall (R : CType) . Int64 -> Int64 -> Int64 -> Thk R -> Thk R -> R) = {
    fn R low high value no yes =>
      ! int64/lt R value low no { ! int64/gt R value high no yes }
  } in
  let memory : Thk (forall (R : CType) . Memory R) = {
    fn R =>
      comatch
      | .check access origin count alignment no yes =>
        ! readable R access no {
          ! in_range R 0 32 origin { ! no +Bounds() } {
            ! in_range R 0 32 count { ! no +Bounds() } {
              do limit <- ! int64/sub 32 count;
              ! int64/gt R origin limit { ! no +Bounds() } {
                ! int64/lt R alignment 1 { ! no +Alignment() } {
                  do remainder <- ! int64/mod origin alignment;
                  ! int64/eq R remainder 0 yes { ! no +Alignment() }
                }
              }
            }
          }
        }
      | .load_u8 _ _ no _ => ! no +Unavailable()
      | .offset access origin delta no yes =>
        ! readable R access no {
          ! in_range R 0 32 origin { ! no +Bounds() } {
            ! in_range R -32 32 delta { ! no +Bounds() } {
              -- Both operands are bounded before addition, so it cannot overflow.
              do location <- ! int64/add origin delta;
              ! in_range R 0 32 location { ! no +Bounds() } { ! yes location }
            }
          }
        }
      | .load_i64 access location no yes =>
        ! readable R access no {
          match location
          | 0 => ! yes 3
          | 8 => ! yes 5
          | 24 => ! yes 7
          | _ => ! no +Bounds()
          end
        }
      | .load_addr access location no yes =>
        ! readable R access no {
          match location
          | 16 => ! yes 24
          | _ => ! no +Bounds()
          end
        }
      end
  } in
  let unavailable : Thk (forall (R : CType) . Memory R) = {
    fn R =>
      comatch
      | .check _ _ _ _ no _ => ! no +Unavailable()
      | .load_u8 _ _ no _ => ! no +Unavailable()
      | .offset _ _ _ no _ => ! no +Unavailable()
      | .load_i64 _ _ no _ => ! no +Unavailable()
      | .load_addr _ _ no _ => ! no +Unavailable()
      end
  } in
  pack (= Access as Access : VType)
  where
    = views, = memory, = unavailable end
end
