param (/VType; /Thk; /Ret; /OS; /Int64; /UInt64; /Access; /Addr;
  /args; /string; /process; builtin) : @(import("../../std/builtin.zy")) in
let (/Fault; native) = builtin |> (@(import("../../std/memory/native.zy"))) in
let foreign = (
  @(ffi(c, library("zyffi_boundary"), symbol("zyffi_must_not_run"))) : Thk (
    Access * Addr * Int64 -> Ret UInt64
  )
) in
let fail = { ! process/exit 2 } in
let no : Thk (Fault -> OS) = { fn _ => ! fail } in
! args/at OS 0 fail {
  fn mode =>
    ! native/allocate OS 1 1 no {
      fn owner =>
        ! native/grant OS owner 0 1 +ReadWrite() no {
          fn access =>
            ! native/base OS access no {
              fn address =>
                let invoke : Thk (Access -> Int64 -> OS) = {
                  fn access extent =>
                    do _ <- ! foreign (access, address, extent);
                    ! process/exit 3
                } in
                ! string/eq OS mode "uninitialized" { ! invoke access 1 } {
                  ! native/store_u8 OS access address 7 no {
                    ! string/eq OS mode "closed" {
                      ! native/close OS owner no { ! invoke access 1 }
                    } {
                      ! string/eq OS mode "bounds" { ! invoke access 2 } {
                        ! native/grant OS owner 0 1 +Write() no { fn write => ! invoke write 1 }
                      }
                    }
                  }
                }
            }
        }
    }
}
