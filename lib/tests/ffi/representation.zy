begin
  param (/VType; /CType; /Thk; /Ret; /OS; /Bytes;
    /UInt8; /UInt32; /UInt64; /numeric; /process; builtin) : @(import("../../std/builtin.zy")) that
  let make_memory = @(import("../../std/memory/package.zy")) in
  let (= Layout, = Representation, memory) = builtin |> make_memory in
  let inspect = (
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_record"))) : Thk (Bytes -> Ret UInt64)
  ) in
  let fail = { ! process/exit 1 } in
  let layout = memory/align (UInt8 * UInt32) 64
    (
      memory/product UInt8 UInt32 memory/uint8 memory/uint32
    ) in
  ! memory/realize (UInt8 * UInt32) OS layout fail {
    fn (= Stored, repr) =>
      ! repr/store OS (7 : UInt8, 16909060 : UInt32) fail {
        fn value =>
          do buffer <- ! repr/bytes value;
          do valid <- ! inspect buffer;
          ! numeric/uint64/eq OS valid 1 {
            ! repr/from_bytes OS buffer fail {
              fn imported =>
                do buffer <- ! repr/bytes imported;
                do valid <- ! inspect buffer;
                ! numeric/uint64/eq OS valid 1 { ! process/exit 0 } fail
            }
          } fail
      }
  }
end
