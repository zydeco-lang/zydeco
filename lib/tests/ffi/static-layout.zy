begin
  param (
    /Int64;
    /Access;
    /Addr;
    /VType;
    /CType;
    /Thk;
    /Ret;
    /OS;
    /UInt8;
    /UInt32;
    /UInt64;
    /numeric;
    /process;
    builtin
  ) : @(import("../../std/builtin.zy")) that
  let (/Bytes; /bytes; byte_package) = builtin |> (@(import("../../std/text/bytes.zy"))) in

  let make_memory = @(import("../../std/memory/static-layout.zy")) in
  let (= Plan, = Layout, memory) = (builtin |> make_memory) byte_package in
  let inspect_raw = (
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_record"))) : Thk (
      Access * Addr * Int64 -> Int64 -> Ret UInt64
    )
  ) in
  let inspect : Thk (Bytes -> Ret UInt64) = {
    fn value =>
      ! bytes/with_window (Ret UInt64) value
        {
          fn _ =>
            @[partial]
            let 0 = 1 in
            ret (0 : UInt64)
        }
        { fn access address length => ! inspect_raw (access, address, length) length }
  } in
  let fail = { ! process/exit 1 } in
  let layout = memory/align (UInt8 * UInt32) 64
    (
      memory/product UInt8 UInt32 memory/uint8 memory/uint32
    ) in
  match layout
  | +Err(_) => ! fail
  | +Ok(plan) =>
    let (= Stored, repr) = memory/realize (UInt8 * UInt32) plan in
    ! repr/store OS (7 : UInt8, 16909060 : UInt32) fail {
      fn value =>
        do buffer <- ! repr/bytes value;
        do valid <- ! inspect buffer;
        ! numeric/uint64/eq OS valid 1 {
          ! repr/from_bytes OS buffer fail {
            fn imported =>
              do buffer <- ! repr/bytes imported;
              do valid <- ! inspect buffer;
              ! numeric/uint64/eq OS valid 1 { ! process/exit 0 } fail
          }
        } fail
    }
  end
end
