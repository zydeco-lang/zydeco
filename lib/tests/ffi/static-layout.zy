begin
  param (/VType; /CType; /Thk; /Ret; /OS; /Addr; /UInt8; /UInt32; /UInt; /Int;
    /numeric; /process; /Unit; builtin) : @(import("../../std/builtin.zy")) that
  let (/storage; /codecs; /Uninit; /Init; /Ptr; /fixed; /allocation; /pointer; /raw) = builtin |> (
    @(import("../../std/memory/package.zy"))
  ) in
  let (= Plan, = Layout, layouts) = fixed in
  let (/Alloc; /heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in
  let inspect : Thk (Addr -> Int -> Ret UInt) =
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_record")))
  in
  match layouts/align (UInt8 * UInt32) 64 (
    layouts/product UInt8 UInt32 layouts/uint8 layouts/uint32
  )
  | +Err(_) => ! fail
  | +Ok(plan) =>
    let (= L, repr) = layouts/realize (UInt8 * UInt32) plan in
    ! (allocation/reserve L Unit allocation/static_heap () repr/storage) OS no {
      fn vacant =>
        let address = pointer/unsafe/address L Uninit vacant in
        -- This C function inspects all bytes, including padding; initialize them explicitly.
        ! raw/unsafe/fill OS address (storage/constant/query L repr/storage)/size 0 {
          ! (repr/codec/init vacant (7 : UInt8, 16909060 : UInt32)) OS {
            fn value =>
              do result <- ! inspect (pointer/unsafe/address L Init value) (
                storage/constant/query L repr/storage
              )/size;
              ! numeric/uint/eq OS result 1 {
                ! (codecs/unsafe/take L (UInt8 * UInt32) repr/codec value) OS {
                  fn vacant _ =>
                    ! (
                      allocation/unsafe/release L Unit allocation/static_heap () repr/storage vacant
                    ) OS no { ! process/exit 0 }
                }
              } fail
          }
        }
    }
  end
end
