begin
  param (/VType; /CType; /Thk; /Ret; /OS; /Addr; /UInt8; /UInt32; /UInt; /Int;
    /numeric; /process; builtin) : @(import("../../std/builtin.zy")) that
  let (/Uninit; /Init; /Ptr; /fixed; /allocation; /pointer; /raw) = builtin |> (
    @(import("../../std/memory/package.zy"))
  ) in
  let (= Plan, = Layout, layouts) = fixed in
  let (/Alloc; /heap) = allocation in
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail = { ! process/exit 1 } in
  let no = { fn (_ : Fault) => ! fail } in
  let inspect : Thk (Addr -> Int -> Ret UInt) =
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_record")))
  in
  match layouts/align (UInt8 * UInt32) 64 (
    layouts/product UInt8 UInt32 layouts/uint8 layouts/uint32
  )
  | +Err(_) => ! fail
  | +Ok(plan) =>
    let (= L, repr) = layouts/realize (UInt8 * UInt32) plan in
    ! repr/allocate OS heap no {
      fn vacant =>
        let address = pointer/unsafe/address L Uninit vacant in
        -- This C function inspects all bytes, including padding; initialize them explicitly.
        ! raw/unsafe/fill OS address repr/size 0 {
          ! repr/unsafe/init OS vacant (7 : UInt8, 16909060 : UInt32) {
            fn value =>
              do result <- ! inspect (pointer/unsafe/address L Init value) repr/size;
              ! numeric/uint/eq OS result 1 {
                ! repr/unsafe/take OS value {
                  fn vacant _ =>
                    ! repr/unsafe/free OS heap vacant no { ! process/exit 0 }
                }
              } fail
          }
        }
    }
  end
end
