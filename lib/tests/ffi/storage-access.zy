begin
  param (/Thk; /Ret; /OS; /Int64; /Bytes; /UInt8; /UInt32; /UInt64;
    /buffer; /numeric; /process; builtin) : @(import("../../std/builtin.zy")) that
  let make_memory = @(import("../../std/memory/package.zy")) in
  let make_access = @(import("../../std/memory/access.zy")) in
  let make_allocation = @(import("../../std/memory/allocation.zy")) in
  let (= Layout, = Representation, memory) = builtin |> make_memory in
  let access = builtin |> make_access in
  let (= Allocator, = Allocate, allocation) = builtin |> make_allocation in
  let inspect = (
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_record"))) : Thk (Bytes -> Ret UInt64)
  ) in
  let fail = { ! process/exit 1 } in
  let error = { fn (_ : Int64) => ! fail } in
  ! memory/realize UInt8 OS memory/uint8 fail {
    fn byte_repr =>
      ! memory/realize UInt32 OS memory/uint32 fail {
        fn word_repr =>
          ! allocation/allocate 64 64 allocation/heap error {
            fn destination =>
              ! access/write_to UInt8 byte_repr destination 0 7 error {
                ! access/write_to UInt32 word_repr destination 4 16909060 error {
                  ! buffer/freeze destination error {
                    fn frozen =>
                      do valid <- ! inspect frozen;
                      ! numeric/uint64/eq OS valid 1 { ! process/exit 0 } fail
                  }
                }
              }
          }
      }
  }
end
