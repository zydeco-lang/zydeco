begin
  param (
    /Int;

    /Addr;
    /Thk;
    /Ret;
    /OS;
    /process;
    /UInt;
    /text;
    /numeric;
    /system;
    builtin
  ) : @(import(
    "../../std/builtin.zy"
  )) that
  let (/Bytes; /bytes; byte_package) = builtin |> (@(import("../../std/text/bytes.zy"))) in

  let uint = numeric/uint that
  let zero = (@(ffi(c, library("zyffi_boundary"), symbol("zyffi_zero"))) : Thk (Ret UInt)) that
  let echo = (
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_echo"))) : Thk (UInt -> Ret UInt)
  ) that
  let inspect_raw = (
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_bytes"))) : Thk (
      Addr -> Int -> Ret UInt
    )
  ) that
  let first_raw = (
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_first"))) : Thk (
      Addr -> Ret UInt
    )
  ) that
  let options_raw = (
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_options"))) : Thk (
      Addr -> UInt -> UInt -> UInt -> UInt -> UInt -> Ret UInt
    )
  ) that
  let mixed_raw = (
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_mixed"))) : Thk (
      UInt -> Addr -> Int -> Addr -> Int -> UInt -> Ret
        UInt
    )
  ) that
  let triple_raw = (
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_three_bytes"))) : Thk (
      Addr -> Int -> Addr -> Int -> (
        Addr
      ) -> Int -> Ret UInt
    )
  ) that
  let six = (
    @(ffi(c, library("zyffi_boundary"), symbol("zyffi_six"))) : Thk (
      UInt -> UInt -> UInt -> UInt -> UInt -> UInt -> Ret UInt
    )
  ) that
  let Fault = @(import("../../std/memory/fault.zy")) in
  let fail : Thk (Fault -> Ret UInt) = {
    fn _ =>
      @[partial]
      let 0 = 1 in
      ret (0 : UInt)
  } in
  let inspect : Thk (Bytes -> Ret UInt) = {
    fn value =>
      ! bytes/unsafe/with_window (Ret UInt) value fail {
        fn address length => ! inspect_raw address length
      }
  } in
  let mixed : Thk (UInt -> Bytes -> Bytes -> UInt -> Ret UInt) = {
    fn seed left right tail =>
      ! bytes/unsafe/with_window (Ret UInt) left fail {
        fn p n =>
          ! bytes/unsafe/with_window (Ret UInt) right fail {
            fn q m =>
              ! mixed_raw seed p n q m tail
          }
      }
  } in
  let triple : Thk (Bytes -> Bytes -> Bytes -> Ret UInt) = {
    fn first second third =>
      ! bytes/unsafe/with_window (Ret UInt) first fail {
        fn p n =>
          ! bytes/unsafe/with_window (Ret UInt) second fail {
            fn q m =>
              ! bytes/unsafe/with_window (Ret UInt) third fail {
                fn r k =>
                  ! triple_raw p n q m r k
              }
          }
      }
  } in
  let ensure : Thk (UInt -> UInt -> Thk OS -> OS) = {
    fn actual expected next =>
      ! uint/eq OS actual expected next { ! process/exit 1 }
  } in
  def fix churn (remaining : UInt) (live : UInt) (buffer : Bytes) : Ret UInt =
    ! uint/eq (Ret UInt) remaining 0
      {
        do inspected <- ! inspect buffer;
        ! uint/eq (Ret UInt) inspected 1389 { ret live } { ret 0 }
      }
      {
        do live' <- ! echo live;
        do remaining' <- ! uint/sub remaining 1;
        ! churn remaining' live' buffer
      }
  in

  do padded <- ! bytes/from_string "..hello!!";
  do hello <- ! bytes/slice (Ret Bytes) padded 2 5 { ! bytes/empty } { fn window => ret window };
  do world <- ! bytes/from_string "world";
  do empty <- ! bytes/slice (Ret Bytes) hello 5 0 { ret hello } { fn window => ret window };
  do constant <- ! zero;
  do maximum <- ! echo 9223372036854775807;
  do high_bit <- ! echo 4611686018427387904;
  do immediate <- ! echo 7;
  do empty_result <- ! inspect empty;
  do bytes_result <- ! inspect hello;
  do first_result <- ! bytes/unsafe/with_window (Ret UInt) hello fail {
    fn address _ => ! first_raw address
  };
  do options_result <- ! bytes/unsafe/with_window (Ret UInt) hello fail {
    fn address _ => ! options_raw address 1 2 3 4 5
  };
  do ordered <- ! mixed 4611686018427387904 hello world 7;
  do three_buffers <- ! triple hello empty world;
  do all_registers <- ! six 1 2 3 4 5 6;
  do after_gc <- ! churn 100000 maximum hello;
  ! ensure options_result 209 {
    ! ensure first_result 104 {
      ! ensure constant 9223372036854775807 {
        ! ensure maximum 9223372036854775807 {
          ! ensure high_bit 4611686018427387904 {
            ! ensure immediate 7 {
              ! ensure empty_result 0 {
                ! ensure bytes_result 1389 {
                  ! ensure ordered 4611692048561472874 {
                    ! ensure three_buffers 8409 {
                      ! ensure all_registers 183 {
                        ! ensure after_gc 9223372036854775807 { ! process/exit 0 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
end
