param (/process; /numeric; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let int = numeric/int in
  let fix helper (x : Int) : Ret Int =
    do one <- ret 1;
    ! int/add x one
  in
  let fix dead_plain (x : Int) : Ret Int = ! int/mul x 7 in
  let fix dead_loop (x : Int) : Ret Int = ! dead_loop x in

  do z <- ! helper -1;
  ! process/exit z
end
