-- module OS
  let write_str = api/write_str that
  let write_int = api/write_int that
  let write_line = api/write_line that
  let read_line = api/read_line that
  def ! read_line_as_int (k : Thk(Option Int -> OS)) : OS =
    ! (api/read_line_as_int_branch)
      { ! k +None() }
      { fn i => ! k +Some(i) }
  that
  let random_int = api/random_int that
  let exit = api/exit that

  def halt : Thk OS = { ! exit 0 } that

  def panic : Thk(String -> OS) = {
    fn (msg: String) =>
      -- do msg <- ! str_append "Program panicked with message: " msg;
      ! write_line msg { ! exit 1 }
  } that

  -- pub def write_line : Thk(String -> Thk OS -> OS) = {
  --   fn (s: String) (k: Thk OS) =>
