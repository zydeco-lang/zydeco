-- module Builtin
begin
  --| Value Type and Computation Type
  --| Thunk Type and Return Type
  --| Primitive Base Types
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  let Thunk (B : CType) = Thk B that

  --| Interface for Monads and Their Algebras
  let Monad (M: VType -> CType) =
    codata
    | .return : forall (A: VType) .
      A -> M A
    | .bind : forall (A: VType) (A': VType) .
      Thk (M A) -> Thk (A -> M A') -> M A'
    end
  that
  let Algebra (M: VType -> CType) (R: CType) =
    forall (A: VType) . Thk (M A) -> Thk (A -> R) -> R
  that
-- end module Builtin


-- module Monad
  --| Interface for Monad Transformers
  let MonadTrans (T: (VType -> CType) -> VType -> CType) =
    forall (M: VType -> CType) . Thk (Monad M) -> codata
    | .monad : Monad (T M)
    | .lift  : forall (A: VType) . Thk (M A) -> T M A
    end
  that
  
  --| The Trivial Algebra (Structure)
  def ! triv : Top = comatch end that

  --| Interface for Monad, Lifted
  let Monad' (M: VType -> CType) =
    codata
    | .return : forall (A: VType) . Thk Top ->
      A -> M A
    | .bind : forall (A: VType) . Thk Top -> (forall (A': VType) . Thk Top ->
      Thk (M A) -> Thk (A -> M A') -> M A')
    end
  that

  --| Removing the need of trivial algebra for generated monads
  def ! detriv-mo (M: VType -> CType) (mo: Thk (Monad' M)) : Monad M =
    comatch
    | .return A => ! mo .return A triv
    | .bind A A' => ! mo .bind A triv A' triv
    end
  that

  --| Interface for Monad Transformers, used for annotating terms inside the monadic block
  let MonadTransInner (T_M: VType -> CType) =
    codata
    | .monad : Monad T_M
    | .lift  : forall (A: VType) . Thk (Ret A) -> T_M A
    end
  that

  --| Interface for Monad Transformers, Lifted
  let MonadTrans' (T: (VType -> CType) -> VType -> CType) =
    forall (M: VType -> CType) . Thk (Monad M) -> codata
    | .monad : Monad' (T M)
    | .lift  : forall (A: VType) . Thk Top -> Thk (M A) -> T M A
    end
  that

  --| Removing the need of trivial algebra for generated monad transformers
  def ! detriv-mt (T: (VType -> CType) -> VType -> CType) (mt: Thk (MonadTrans' T)) : MonadTrans T =
    fn (M: VType -> CType) (mo: Thk (Monad M)) => comatch
    | .monad => ! detriv-mo (T M) { ! mt M mo .monad }
    | .lift A => ! mt M mo .lift A triv
    end
  that
-- end module Monad


-- module Core
  let Empty = data end that
  let Top = codata end that

  let Option (A : VType) =
    data
    | +None : Unit
    | +Some : A
    end
  that

  let Either (E : VType) (A : VType) =
    data
    | +Left : E
    | +Right : A
    end
  that

  let Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
-- end module Core


-- module Arith
  let add = api/add that
  let sub = api/sub that
  let mul = api/mul that
  def mult = mul that
  def times = mul that
  -- pub extern def div : Thk(Int -> Int -> Ret Int) end
  -- pub extern def mod : Thk(Int -> Int -> Ret Int) end

  def ! int_eq (x : Int) (y : Int) : Ret Bool =
    ! (api/int_eq_branch) (Ret Bool) x y { ret +True() } { ret +False() }
  that
  def ! int_lt (x : Int) (y : Int) : Ret Bool =
    ! (api/int_lt_branch) (Ret Bool) x y { ret +True() } { ret +False() }
  that
  def ! int_gt (x : Int) (y : Int) : Ret Bool =
    ! (api/int_gt_branch) (Ret Bool) x y { ret +True() } { ret +False() }
  that
-- end module Arith


