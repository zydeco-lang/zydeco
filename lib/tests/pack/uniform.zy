begin
  param (
    (/core; /numeric; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/VType; /Ret; /Unit) = core that
  let (Scalar = Int64, int64) = numeric/int64 that
  let (/process) = system that

  let TypeIdentity = begin
    let Result = A that
    param A : VType that
    Result
  end that
  let IdentityResult = TypeIdentity Int64 that
  let InferredType :
    VType -> VType = begin
      param A that
      A
    end
  that
  let LexicalTypeIdentity =
    param A : VType in
    let Result = A in
    Result
  that
  let LexicalHidden =
    def Secret : VType = Int64 in
    Secret
  that
  let Hidden = begin
    def Secret : VType = Int64 that
    Secret
  end that
  let RecursiveList = begin
    def RecursiveList : VType =
      data
      | +Nil : Unit
      | +Cons : Int64 * RecursiveList
      end
    that
    RecursiveList
  end that
  def plain : Int64 = begin
    42
  end that
  def ! inferred : Int64 -> Ret Int64 = begin
    param value that
    ret value
  end that
  def ! lexical_run =
    param value : Int64 in
    def expected : Int64 = 42 in
    let answer = value in
    do status <- ! (int64/sub) answer expected;
    ! (process/exit) status
  that
  def ! run = begin
    let answer : Number = seed that
    param seed : Number that
    def expected : Int64 = 42 that
    let Number = A that
    param A : VType that
    def Opaque : VType = Int64 that
    do status <- ! (int64/sub) expected 42;
    ! (process/exit) status
  end that

  ! run IdentityResult 42
end
