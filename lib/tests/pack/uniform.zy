begin
  param (
    (/VType; /Ret; /Unit; /Int; /int; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  let TypeIdentity =
    begin
      let Result = A that
      param (A : VType) that
      Result
    end
  that
  let IdentityResult = TypeIdentity Int that
  let InferredType :
    (VType) -> (VType) =
    begin
      param A that
      A
    end
  that
  let LexicalTypeIdentity =
    param (A : VType) in
    let Result = A in
    Result
  that
  let LexicalHidden =
    def Secret : VType = Int in
    Secret
  that
  let Hidden =
    begin
      def Secret : VType = Int that
      Secret
    end
  that
  let RecursiveList =
    begin
      def RecursiveList : VType =
        data
        | +Nil : Unit
        | +Cons : Int * RecursiveList
        end
      that
      RecursiveList
    end
  that
  def plain : Int = begin 42 end that
  def ! inferred : Int -> Ret Int =
    begin
      param value that
      ret value
    end
  that
  def ! lexical_run =
    param (value : Int) in
    def expected : Int = 42 in
    let answer = value in
    do status <- ! (int/sub) answer expected;
    ! (process/exit) status
  that
  def ! run =
    begin
      let answer : Number = seed that
      param (seed : Number) that
      def expected : Int = 42 that
      let Number = A that
      param (A : VType) that
      def Opaque : VType = Int that
      do status <- ! (int/sub) expected 42;
      ! (process/exit) status
    end
  that

  ! run IdentityResult 42
end
