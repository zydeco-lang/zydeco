param (/process; /numeric; builtin) : @(import(
  "../../std/builtin.zy"
)) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let int = numeric/int that
  let Interleaved = exists (Leading as Unit)
    (X : VType)
    (AliasX as X)
    (Middle as Unit)
    (Y : VType)
    (AliasY as Y)
  .
    X * Y that
  let Reveal = pi
    (
      (
        Leading,
        X,
        AliasX,
        Middle,
        Y,
        AliasY,
        _,
        _
      ) : Interleaved
    )
  .
    Ret (
      X * Y
    ) that
  def ! reveal : Reveal = fn
    (
      (
        Leading,
        X,
        AliasX,
        Middle,
        Y,
        AliasY,
        x,
        y
      ) : Interleaved
    )
  =>
    ret (
      x,
      y
    ) that
  def packed : Interleaved = (
    Unit,
    Int,
    Int,
    Unit,
    Char,
    Char,
    40,
    'z'
  ) that

  do (value, _) <- ! reveal packed;
  do status <- ! int/sub value 40;
  ! process/exit status
end
