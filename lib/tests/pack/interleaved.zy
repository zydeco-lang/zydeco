begin
  param (
    (/core; /representations; /numeric; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/VType; /Ret; /Unit) = core that
  let (Scalar = Int64, int64) = numeric/int64 that
  let (/Scalar = Char) = representations/char that
  let (/process) = system that
  let Interleaved =
    exists
      (Leading as Unit : VType)
      (X : VType)
      (AliasX as X : VType)
      (Middle as Unit : VType)
      (Y : VType)
      (AliasY as Y : VType)
    .
      X * Y
  that
  let Reveal =
    pi
      (
        (
          Leading,
          X,
          AliasX,
          Middle,
          Y,
          AliasY,
          _,
          _
        )
        : Interleaved
      )
    .
      Ret (X * Y)
  that
  def ! reveal : Reveal =
    fn
      (
        (
          Leading,
          X,
          AliasX,
          Middle,
          Y,
          AliasY,
          x,
          y
        )
        : Interleaved
      )
    =>
      ret (x, y)
  that
  def packed : Interleaved = (
    Unit,
    Int64,
    Int64,
    Unit,
    Char,
    Char,
    40,
    'z'
  ) that

  do (value, _) <- ! reveal packed;
  do status <- ! (int64/sub) value 40;
  ! (process/exit) status
end
