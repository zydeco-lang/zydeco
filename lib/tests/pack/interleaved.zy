begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  let Interleaved =
    exists
      (Leading as Unit : VType)
      (X : VType)
      (AliasX as X : VType)
      (Middle as Unit : VType)
      (Y : VType)
      (AliasY as Y : VType)
    .
      X * Y
  that
  let Reveal =
    pi (
      (
        Leading,
        X,
        AliasX,
        Middle,
        Y,
        AliasY,
        _,
        _
      ) : Interleaved
    ) .
      Ret (X * Y)
  that
  def ! reveal : Reveal =
    fn (
      (
        Leading,
        X,
        AliasX,
        Middle,
        Y,
        AliasY,
        x,
        y
      ) : Interleaved
    ) =>
      ret (x, y)
  that
  def packed : Interleaved = (
    Unit,
    Int,
    Int,
    Unit,
    Char,
    Char,
    40,
    'z',
  ) that

  do (value, _) <- ! reveal packed;
  do status <- ! (api/sub) value 40;
  ! (api/exit) status
end
