begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  let Transparent =
    exists (Representation as Int : VType) .
      Representation
  that
  def packed : Transparent = (
    Int,
    42,
  ) that
  def ! reveal ((Representation, value) : Transparent) : Ret Int =
    ret value
  that

  do value <- ! reveal packed;
  do status <- ! (api/sub) value 42;
  ! (api/exit) status
end
