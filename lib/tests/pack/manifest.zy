begin
  param (/VType; /Ret; /process; /Int64; /numeric; /system) : @(import("../../std/builtin.zy")) that
  let int64 = numeric/int64 that
  let Transparent = exists (Representation as Int64 : VType) . Representation that
  def packed : Transparent = (
    Int64,
    42
  ) that
  let val reveal ((Representation, value) : Transparent) : Int64 = value that

  do status <- ! int64/sub (reveal packed) 42;
  ! process/exit status
end
