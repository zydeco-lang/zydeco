begin
  param (/VType; /Ret; /process; /Int; /numeric; /system) : @(import("../../std/builtin.zy")) that
  let int = numeric/int that
  let Transparent = exists (Representation as Int : VType) . Representation that
  def packed : Transparent = (
    Int,
    42
  ) that
  let val reveal ((Representation, value) : Transparent) : Int = value that

  do status <- ! int/sub (reveal packed) 42;
  ! process/exit status
end
