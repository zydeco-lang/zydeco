begin
  param (
    (/core; /numeric; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/VType; /Ret) = core that
  let (= Int64, int64) = numeric/int64 that
  let (/process) = system that
  let Transparent = exists (Representation as Int64 : VType) . Representation that
  def packed : Transparent = (
    Int64,
    42
  ) that
  def ! reveal ((Representation, value) : Transparent) : Ret Int64 = ret value that

  do value <- ! reveal packed;
  do status <- ! (int64/sub) value 42;
  ! (process/exit) status
end
