param (/process; /numeric; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let int = numeric/int that
  let Transparent = exists (Representation as Int) . Representation that
  def packed : Transparent = (
    Int,
    42
  ) that
  let val reveal ((Representation, value) : Transparent) : Int = value that

  do status <- ! int/sub (reveal packed) 42;
  ! process/exit status
end
