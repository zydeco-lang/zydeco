begin
  param (
    (/VType; /Ret; /Int; /sub; /exit) :
    @[import("../../std/builtin.zy")] _
  ) that
  let Transparent =
    exists (Representation as Int : VType) .
      Representation
  that
  def packed : Transparent = (
    Int,
    42,
  ) that
  def ! reveal ((Representation, value) : Transparent) : Ret Int =
    ret value
  that

  do value <- ! reveal packed;
  do status <- ! (sub) value 42;
  ! (exit) status
end
