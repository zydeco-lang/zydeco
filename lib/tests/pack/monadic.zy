param (/process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let monadic_basis = @(import("../../std/effect/monad.zy")) that

  let (/Monad; /Algebra) = monadic_basis in
  begin
    let Mixed = exists (Leading as Unit) (X : VType) .
      exists (AliasX as X) (Trailing as Unit) .
        X that
    def ! mo_ret : Monad Ret =
      comatch
      | .return A value => ret value
      | .bind A B computation continuation =>
        do value <- ! computation;
        ! continuation value
      end
    that
    def ! translated = @[monadic] begin
      let ! reveal =
        do _ <- ret ();
        fn
          (
            (
              Leading,
              X,
              AliasX,
              Trailing,
              value
            ) : Mixed
          )
        =>
          ret value
      in
      ! reveal (
        Unit,
        Int,
        Int,
        Unit,
        0
      )
    end that

    do status <- ! translated Ret mo_ret;
    ! process/exit status
  end
end
