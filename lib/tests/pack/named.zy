begin
  param (/VType; /Thk; /Ret; /process; /Int64; /numeric; /system) :
  @(import("../../std/builtin.zy")) that
  let int64 = numeric/int64 that
  let CounterLibrary = exists
    (
      #Counter = Representation as Int64 :
      VType
    )
  .
      (#zero :: Representation)
    * (
        #increment :: Thk (Representation -> Ret Representation)
      ) that
  def counter : CounterLibrary = (
    #Counter = Int64,
    #zero = 0,
    #increment = {
      fn (value : Int64) => ! int64/add value 1
    }
  ) that
  let val use_counter
    ((= Counter, = zero, = increment) : CounterLibrary)
  : Thk (Ret Int64) =
      { ! increment zero }
  that

  do value <- ! (counter |> use_counter);
  do status <- ! int64/sub value 1;
  ! process/exit status
end
