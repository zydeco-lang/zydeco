begin
  param (/core; /numeric; /system) : @(import("../../std/builtin.zy")) that
  let (/VType; /Thk; /Ret) = core that
  let (= Int64, int64) = numeric/int64 that
  let (/process) = system that
  let CounterLibrary = exists
    (
      #Counter = Representation as Int64 :
      VType
    )
  .
      (#zero :: Representation)
    * (
        #increment :: Thk (Representation -> Ret Representation)
      ) that
  def counter : CounterLibrary = (
    #Counter = Int64,
    #zero = 0,
    #increment = {
      fn (value : Int64) => ! int64/add value 1
    }
  ) that
  match counter
  | ((= Counter, = zero, = increment)) =>
    do value <- ! increment zero;
    do status <- ! int64/sub value 1;
    ! process/exit status
  end
end
