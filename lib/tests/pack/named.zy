begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  let CounterLibrary =
    exists (
      Counter = Representation as Int :
      VType
    ) .
      (zero :: Representation) *
      (increment :: Thk (Representation -> Ret Representation))
  that
  def counter : CounterLibrary = (
    Counter = Int,
    zero = 0,
    increment = {
      fn (value : Int) ->
        ! (api/add) value 1
    },
  ) that
  def ! use_counter ((= Counter, = zero, = increment) : CounterLibrary) : Ret Int =
    ! increment zero
  that

  do value <- ! use_counter counter;
  do status <- ! (api/sub) value 1;
  ! (api/exit) status
end
