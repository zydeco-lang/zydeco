param (/process; /numeric; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let int = numeric/int that
  let CounterLibrary = exists (#Counter = Representation as Int) .
      (#zero :: Representation)
    * (
        #increment :: Thk (Representation -> Ret Representation)
      ) that
  def counter : CounterLibrary = (
    #Counter = Int,
    #zero = 0,
    #increment = {
      fn value => ! int/add value 1
    }
  ) that
  let val use_counter
    ((= Counter, = zero, = increment) : CounterLibrary)
  : Thk (Ret Int) =
      { ! increment zero }
  that

  do value <- ! (counter |> use_counter);
  do status <- ! int/sub value 1;
  ! process/exit status
end
