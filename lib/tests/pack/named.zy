begin
  param (/VType; /Thk; /Ret; /process; /Int; /numeric; /system) : @(import("../../std/builtin.zy")) that
  let int = numeric/int that
  let CounterLibrary = exists
    (
      #Counter = Representation as Int :
      VType
    )
  .
      (#zero :: Representation)
    * (
        #increment :: Thk (Representation -> Ret Representation)
      ) that
  def counter : CounterLibrary = (
    #Counter = Int,
    #zero = 0,
    #increment = {
      fn (value : Int) => ! int/add value 1
    }
  ) that
  let val use_counter
    ((= Counter, = zero, = increment) : CounterLibrary)
  : Thk (Ret Int) =
      { ! increment zero }
  that

  do value <- ! (counter |> use_counter);
  do status <- ! int/sub value 1;
  ! process/exit status
end
