begin
  param (
    (/core; /system) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/Unit) = core that
  let (/process) = system that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that

  match +True()
  | +True() => ! (process/exit) 0
  | +False() => ! (process/exit) 1
  end
end
