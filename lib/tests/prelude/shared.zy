param (/OS = HostOS; /process; builtin) : @(import("../../std/builtin.zy")) in
let forward : Thk (Thk OS -> HostOS) = { fn next => ! next } in
let same : Thk (Thk HostOS -> OS) = { fn next => ! next } in
let stop : Thk (Int -> OS) = process/exit in
let choice : Option Int = +Some(0) in
match choice
| +None(_) => ! stop 1
| +Some(result) => ! stop result
end
