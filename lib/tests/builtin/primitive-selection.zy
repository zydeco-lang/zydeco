begin
  param (/Thk; /Ret; /Int; /numeric; /process) : @(import("../../std/builtin.zy")) that
  let int = numeric/int in
  let Operation = Thk (Int -> Int -> Ret Int) in
  do selected <- ! int/eq
    (Ret Operation)
    1
    1
    { ret int/add }
    { ret int/sub };
  do first <- ! selected 19 23;
  do second <- ! selected -21 -21;
  do status <- ! int/add first second;
  ! process/exit status
end
