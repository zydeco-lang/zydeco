begin
  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def Bool =
    data
    | +False : Unit
    | +True : Unit
    end
  that
  def ! successor (value : Nat) : Ret Nat =
    ret +S(value)
  that
  def ! is_nonzero (value : Nat) : Ret Bool =
    match value
    | +Z(_) => ret +False()
    | +S(_) => ret +True()
    end
  that
  param (
    (/VType; /Ret; /Unit; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  do one <- ! successor +Z();
  do result <- ! is_nonzero one;
  match result
  | +False(_) => ! (process/exit) 1
  | +True(_) => ! (process/exit) 0
  end
end
