begin
  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def Bool =
    data
    | +False : Unit
    | +True : Unit
    end
  that
  def successor : Thk (Nat -> Ret Nat) = {
    fn (value : Nat) ->
      ret +S(value)
  } that
  def is_nonzero : Thk (Nat -> Ret Bool) = {
    fn (value : Nat) ->
      match value
      | +Z(_) -> ret +False()
      | +S(_) -> ret +True()
      end
  } that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do one <- ! successor +Z();
  do result <- ! is_nonzero one;
  match result
  | +False(_) -> ! (api/exit) 1
  | +True(_) -> ! (api/exit) 0
  end
end
