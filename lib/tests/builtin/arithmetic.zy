begin
  param (
    (/add; /sub; /div; /mod; /exit) :
    @[import("../../std/builtin.zy")] _
  ) that

  do quotient <- ! (div) -7 3;
  do remainder <- ! (mod) -7 3;
  do quotient_error <- ! (sub) quotient -2;
  do remainder_error <- ! (sub) remainder -1;
  do status <- ! (add) quotient_error remainder_error;
  ! (exit) status
end
