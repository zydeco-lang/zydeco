begin
  param (
    (/core; /representations; /text; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/Ret) = core that
  let (/Scalar = String) = representations/string that
  let string = text/string that
  let (/OS; /args; /process) = system that

  do joined <- ! (args/fold)
    (Ret String)
    { ret "" }
    {
      fn argument remaining =>
        do suffix <- ! remaining;
        ! (string/append) argument suffix
    };
  ! (string/eq)
    OS
    joined
    "alphabeta"
    { ! (process/exit) 0 }
    { ! (process/exit) 1 }
end
