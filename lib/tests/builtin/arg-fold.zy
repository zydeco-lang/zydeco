-- stage: run
-- backends: interpreter, exe
-- args: ["alpha", "beta"]
param (/process; /text; builtin) : @(import(
  "../../std/builtin.zy"
)) in
begin
  let make_arguments = @(import("../../std/system/arguments.zy")) in
  let arguments = builtin |> make_arguments in
  let string = text/string that
  do joined <- ! arguments/fold
    (Ret String)
    { ret "" }
    {
      fn argument remaining =>
        do suffix <- ! remaining;
        ! string/append argument suffix
    };
  ! string/eq
    OS
    joined
    "alphabeta"
    { ! process/exit 0 }
    { ! process/exit 1 }
end
