begin
  param (/Ret; /OS; /args; /process; /String; /text; /system) : @(import("../../std/builtin.zy")) that
  let string = text/string that
  do joined <- ! args/fold
    (Ret String)
    { ret "" }
    {
      fn argument remaining =>
        do suffix <- ! remaining;
        ! string/append argument suffix
    };
  ! string/eq
    OS
    joined
    "alphabeta"
    { ! process/exit 0 }
    { ! process/exit 1 }
end
