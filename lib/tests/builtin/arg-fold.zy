begin
  param (
    (
      /Ret;
      /String;
      /OS;
      /str_append;
      /str_eq_branch;
      /arg_fold;
      /exit
    ) :
    @[import("../../std/builtin.zy")] _
  ) that

  do joined <- ! (arg_fold)
    (Ret String)
    { ret "" }
    {
      fn argument remaining =>
        do suffix <- ! remaining;
        ! (str_append) argument suffix
    };
  ! (str_eq_branch)
    OS
    joined
    "alphabeta"
    { ! (exit) 0 }
    { ! (exit) 1 }
end
