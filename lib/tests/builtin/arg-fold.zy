begin
  param (
    (/Ret; /String; /OS; /string; /args; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  do joined <- ! (args/fold)
    (Ret String)
    { ret "" }
    {
      fn argument remaining =>
        do suffix <- ! remaining;
        ! (string/append) argument suffix
    };
  ! (string/eq)
    OS
    joined
    "alphabeta"
    { ! (process/exit) 0 }
    { ! (process/exit) 1 }
end
