begin
  param (/Thk; /Ret; /Unit; /OS; /Int; /Float64; /numeric; /String; /args; /process;
    /int; /string; builtin) : @(import("../../std/builtin.zy")) that
  let make_arguments = @(import("../../std/system/arguments.zy")) in
  let arguments = builtin |> make_arguments in
  let fail = { ! process/exit 1 } in
  def fix churn (remaining : Int) : Ret Unit =
    ! int/eq (Ret Unit) remaining 0 { ret () } {
      do next <- ! int/sub remaining 1;
      ! churn next
    }
  in
  def fix discard (remaining : Int) : Ret Int =
    ! int/eq (Ret Int) remaining 0 { ret 0 } {
      do first_length <- ! arguments/fold (Ret Int) { ret 0 } {
        fn argument tail => ! string/length argument
      };
      do next <- ! int/sub remaining 1;
      do rest <- ! discard next;
      ! int/add first_length rest
    }
  in
  let check_indices : Thk OS = {
    ! args/at OS -1 {
      ! args/at OS 2 {
        ! args/at OS 4611686018427387903 {
          ! args/at OS 1 fail {
            fn second => ! string/eq OS second "beta" { ! process/exit 0 } fail
          }
        } { fn _ => ! fail }
      } { fn _ => ! fail }
    } { fn _ => ! fail }
  } in
  do first <- ! args/at (Ret String) 0 { ret "" } { fn value => ret value };
  do length <- ! string/length first;
  do captured <- ! numeric/float64/add 1e18 4e18;
  do folded <- ! arguments/fold (Ret Float64) { ret captured } {
    fn argument tail =>
      ! string/eq (Ret Float64) argument "alpha" {
        do before <- ! tail;
        do () <- ! churn 100000;
        do after <- ! tail;
        ! numeric/float64/eq (Ret Float64) before after { ret after } { ret 0.0 }
      } { ! tail }
  };
  do discarded <- ! discard 300;
  ! numeric/float64/eq OS folded 5e18 {
    ! int/eq OS discarded 1500 check_indices fail
  } fail
end
