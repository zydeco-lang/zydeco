param (/stdio; /process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  ! stdio/read_line {
    fn line =>
      let ! f (z : Int) : OS =

        ! process/exit z
      in
      ! f 0
  }
end
