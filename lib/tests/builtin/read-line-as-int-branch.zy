param (
  (/OS; /int; /stdio; /process) :
  @[import("../../std/builtin.zy")] _
) in
  ! (stdio/read_int)
    { ! (process/exit) 1 }
    {
      fn integer =>
        ! (int/eq)
          OS
          integer
          42
          {
            ! (stdio/read_int)
              { ! (process/exit) 0 }
              {
                fn unexpected =>
                  ! (process/exit) 1
              }
          }
          { ! (process/exit) 1 }
    }
