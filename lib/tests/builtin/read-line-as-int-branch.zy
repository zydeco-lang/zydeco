param (/OS; /stdio; /process; /Int64; /numeric; /system) : @(import("../../std/builtin.zy")) in
let int64 = numeric/int64 in
! stdio/read_int
  { ! process/exit 1 }
  {
    fn integer =>
      ! int64/eq
        OS
        integer
        42
        {
          ! stdio/read_int
            { ! process/exit 0 }
            {
              fn unexpected => ! process/exit 1
            }
        }
        { ! process/exit 1 }
  }
