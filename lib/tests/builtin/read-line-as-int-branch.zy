-- stage: run
-- backends: interpreter, exe
-- input: "42\nnot-an-integer\n"
param (/stdio; /process; builtin) : @(import("../../std/builtin.zy")) in
let (/numeric) = @(import("../../std/primitive/package.zy")) in
let int = numeric/int in
! stdio/read_int
  { ! process/exit 1 }
  {
    fn integer =>
      ! int/eq
        OS
        integer
        42
        {
          ! stdio/read_int
            { ! process/exit 0 }
            {
              fn unexpected => ! process/exit 1
            }
        }
        { ! process/exit 1 }
  }
