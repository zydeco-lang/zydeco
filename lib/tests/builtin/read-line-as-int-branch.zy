param (
  (/OS; /int_eq_branch; /read_line_as_int_branch; /exit) :
  @[import("../../std/builtin.zy")] _
) in
  ! (read_line_as_int_branch)
    { ! (exit) 1 }
    {
      fn integer =>
        ! (int_eq_branch)
          OS
          integer
          42
          {
            ! (read_line_as_int_branch)
              { ! (exit) 0 }
              {
                fn unexpected =>
                  ! (exit) 1
              }
          }
          { ! (exit) 1 }
    }
