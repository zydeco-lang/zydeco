-- stage: run
-- backends: interpreter, exe
-- | Keep every projection: this fixture checks the complete Builtin signature and its witness roles.
let (/numeric; /text) = @(import("../../std/primitive/package.zy")) in
param (
  /VType; /CType; /Thk; /Ret; /Unit;
  /Reader; /Writer; /OS;
  /io; /fs; /stdio; /args; /random; /process;
  /Addr; /memory_ops; /memory; /scalar;
  /Int8; /Int16; /Int32; /Int;
  /UInt8; /UInt16; /UInt32; /UInt;
  /Float32; /Float64;
  /Char; /String;
  /system
) : @(import("../../std/builtin.zy")) in
let int = numeric/int in
let char = text/char in
let string = text/string in
do zero <- ! int/add 0 0;
! process/exit zero
