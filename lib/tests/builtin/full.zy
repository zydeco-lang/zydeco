param (
  /VType;
  /CType;
  /Thk;
  /Ret;
  /Unit;
  /Reader;
  /Writer;
  /OS;
  /io;
  /fs;
  /stdio;
  /args;
  /random;
  /process;
  /Int8;
  /Int16;
  /Int32;
  /Int64;
  /UInt8;
  /UInt16;
  /UInt32;
  /UInt64;
  /Float32;
  /Float64;
  /Char;
  /String;
  /Bytes;
  /numeric;
  /text;
  /system
) : @(import("../../std/builtin.zy")) in
let int64 = numeric/int64 in
let char = text/char in
let string = text/string in
let bytes = text/bytes in
do zero <- ! int64/add 0 0;
! process/exit zero
