-- Call-by-value regions inside monadic blocks, run end to end.
--
-- Alone, a region's only effect is divergence, which cannot tell one evaluation
-- order from another. Nested in `@[monadic]`, the block reinterprets every `Ret`
-- and `do` the region emitted under its carrier, and the region abstracts over
-- the operations the block supplies. Under `State Int` the final state then
-- says which call ran last, so each order below is checked beside its
-- counterfactual: the same two calls, the other way round, which must flip it.
begin
  let (/Monad; /Algebra) = @(import("../../std/effect/monad.zy")) that
  param (/VType; /CType; /Thk; /Ret; /Unit; /OS; /Int; /int; /process; builtin) : @(import(
    "../../std/builtin.zy"
  )) that
  let (/State; /instance; /run_state) = builtin |> (@(import("../../std/effect/state.zy"))) in
  let (_, state_instance) = instance Int in
  begin
    def ! require (want : Int) (got : Int) (k : Thk OS) : OS =
      ! int/eq OS want got k { ! process/exit 1 }
    that
    -- Each region binds the built-in types and the kind it names, and declares
    -- the types it uses: a region is closed over types, so the host's `Int` is
    -- not the region's to name. The bindings are static, so the block's
    -- reinterpretation of the region's `Ret` and `do` meets none of them.

    -- a tuple runs its components left to right: `b` sets 2 last
    def ! tuple_ab =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <- @[cbv] (
            let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
            let Unit : VType = @(intrinsic(unit)) that
            fn (a : Unit -> Int) (b : Unit -> Int) => (a (), b ()));
          do h <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 1;
              ret 0
          };
          do _ <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 2;
              ret 0
          };
          ret 0
      end
    that
    -- the counterfactual: the same calls written the other way round
    def ! tuple_ba =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <- @[cbv] (
            let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
            let Unit : VType = @(intrinsic(unit)) that
            fn (a : Unit -> Int) (b : Unit -> Int) => (b (), a ()));
          do h <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 1;
              ret 0
          };
          do _ <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 2;
              ret 0
          };
          ret 0
      end
    that
    -- an application runs its function before its argument: `x` sets 2 last
    def ! app_fx =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <- @[cbv] (
            let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
            let Unit : VType = @(intrinsic(unit)) that
            fn (f : Unit -> Int -> Int) (x : Unit -> Int) => f () (x ()));
          do h <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 1;
              ret { fn (n : Int) => ret n }
          };
          do _ <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 2;
              ret 0
          };
          ret 0
      end
    that
    -- the counterfactual: a lambda is already a value, so the argument runs
    -- first and `f ()` runs in the body
    def ! app_xf =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <-
            @[cbv] (
              let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
              let Unit : VType = @(intrinsic(unit)) that
              fn (f : Unit -> Int -> Int) (x : Unit -> Int) => (fn (n : Int) => f () n) (x ()));
          do h <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 1;
              ret { fn (n : Int) => ret n }
          };
          do _ <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 2;
              ret 0
          };
          ret 0
      end
    that
    -- each remaining former carrying the effect of `t` through the composed
    -- translation: a quantifier, codata, data, a package, a record, a type
    -- operator, and a recursive binding
    def ! through_forall =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <-
            @[cbv] (
              let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
              let Unit : VType = @(intrinsic(unit)) that
              fn (t : Unit -> Int) =>
                let id = fn (X : VType) (x : X) => x in
                id Int (t ())
            );
          ! h {
            fn (u : Unit) =>
              do _ <- ! put 7;
              ret 3
          }
      end
    that
    def ! through_codata =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <-
            @[cbv] (
              let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
              let Unit : VType = @(intrinsic(unit)) that
              let Pair : VType = codata | .fst : Int | .snd : Int end that
              fn (t : Unit -> Int) =>
                let p : Pair =
                  comatch
                  | .fst => t ()
                  | .snd => 0
                  end
                in
                p .fst
            );
          ! h {
            fn (u : Unit) =>
              do _ <- ! put 7;
              ret 3
          }
      end
    that
    def ! through_data =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <-
            @[cbv] (
              let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
              let Unit : VType = @(intrinsic(unit)) that
              let Box : VType = data | +Box : Int -> Int end that
              fn (t : Unit -> Int) =>
                let +Box(f) = (+Box(fn (x : Int) => x) : Box) in
                f (t ())
            );
          ! h {
            fn (u : Unit) =>
              do _ <- ! put 7;
              ret 3
          }
      end
    that

    def ! through_pack =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <-
            @[cbv] (
              let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
              let Unit : VType = @(intrinsic(unit)) that
              fn (t : Unit -> Int) =>
                let (X, x) = ((Int, t ()) : exists (X : VType) . X) in
                0
            );
          ! h {
            fn (u : Unit) =>
              do _ <- ! put 7;
              ret 3
          }
      end
    that
    def ! through_record =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <-
            @[cbv] (
              let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
              let Unit : VType = @(intrinsic(unit)) that
              let Rec : VType = (#fst :: Int, #snd :: Int) that
              fn (t : Unit -> Int) =>
                let r : Rec = (#fst = t (), #snd = 0) in
                r/fst
            );
          ! h {
            fn (u : Unit) =>
              do _ <- ! put 7;
              ret 3
          }
      end
    that
    def ! through_operator =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <-
            @[cbv] (
              let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
              let Unit : VType = @(intrinsic(unit)) that
              fn (t : Unit -> Int) =>
                let F : VType -> VType = fn X => X * X in
                let p : F Int = (t (), 0) in
                0
            );
          ! h {
            fn (u : Unit) =>
              do _ <- ! put 7;
              ret 3
          }
      end
    that
    def ! through_fix =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <- @[cbv] (
            let VType = @(intrinsic(vtype)) that let Int : VType = @(intrinsic(int)) that
            let Unit : VType = @(intrinsic(unit)) that
            fn (t : Unit -> Int) =>
              let fix f (x : Int) : Int = t () in
              f 0
          );
          ! h {
            fn (u : Unit) =>
              do _ <- ! put 7;
              ret 3
          }
      end
    that

    let ! final (program : Thk (Thk (Int -> State Int Unit) -> State Int Int)) (k : Thk (Int -> OS))
    : OS =
        ! run_state Int Int OS 0 { ! program { fn value => ! state_instance/state .put value } } { fn s _ => ! k s }
    in
    ! final { ! tuple_ab (State Int) state_instance/monad } {
      fn s =>
        ! require 2 s {
          ! final { ! tuple_ba (State Int) state_instance/monad } {
            fn s =>
              ! require 1 s {
                ! final { ! app_fx (State Int) state_instance/monad } {
                  fn s =>
                    ! require 2 s {
                      ! final { ! app_xf (State Int) state_instance/monad } {
                        fn s =>
                          ! require 1 s {
                            ! final { ! through_forall (State Int) state_instance/monad } {
                              fn s =>
                                ! require 7 s {
                                  ! final { ! through_codata (State Int) state_instance/monad } {
                                    fn s =>
                                      ! require 7 s {
                                        ! final { ! through_data (State Int) state_instance/monad } {
                                          fn s =>
                                            ! require 7 s {
                                              ! final {
                                                ! through_pack (State Int) state_instance/monad
                                              } {
                                                fn s =>
                                                  ! require 7 s {
                                                    ! final {
                                                      ! through_record (State Int) state_instance/monad
                                                    } {
                                                      fn s =>
                                                        ! require 7 s {
                                                          ! final {
                                                            ! through_operator (State Int) state_instance/monad
                                                          } {
                                                            fn s =>
                                                              ! require 7 s {
                                                                ! final {
                                                                  ! through_fix (State Int) state_instance/monad
                                                                } {
                                                                  fn s =>
                                                                    ! require 7 s {
                                                                      ! process/exit 0 }
                                                                }
                                                              }
                                                          }
                                                        }
                                                    }
                                                  }
                                              }
                                            }
                                        }
                                      }
                                  }
                                }
                            }
                          }
                      }
                    }
                }
              }
          }
        }
    }
  end
end
