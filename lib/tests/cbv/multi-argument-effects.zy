-- The evaluation order of a multi-argument call, observed under `State Int`.
--
-- The final state says which call ran last. A multi-argument function receives
-- all of its arguments before its body runs; a curried one runs what comes
-- between its parameters as soon as the first arrives. Each row is checked beside
-- a counterfactual that must flip the answer.
begin
  let (/Monad; /Algebra) = @(import("../../std/effect/monad.zy")) that
  param (/VType; /CType; /Thk; /Ret; /Unit; /OS; /Int; /int; /process; builtin) : @(import(
    "../../std/builtin.zy"
  )) that
  let (/State; /instance; /run_state) = builtin |> (@(import("../../std/effect/state.zy"))) in
  let (_, state_instance) = instance Int in
  begin
    def ! require (want : Int) (got : Int) (k : Thk OS) : OS =
      ! int/eq OS want got k { ! process/exit 1 }
    that

    -- arguments run left to right: `b` sets 2 last
    def ! arguments_ab =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <- @[cbv] (
            let VType = @(intrinsic(vtype)) that
            let Int : VType = @(intrinsic(int)) that
            let Unit : VType = @(intrinsic(unit)) that
            fn (a : Unit -> Int) =>
              fn (b : Unit -> Int) =>
                (fn (x : Int) (y : Int) => x) (a ()) (b ())
          );
          do h <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 1;
              ret 0
          };
          do _ <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 2;
              ret 0
          };
          ret 0
      end
    that
    -- the counterfactual: the same two arguments the other way round
    def ! arguments_ba =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <- @[cbv] (
            let VType = @(intrinsic(vtype)) that
            let Int : VType = @(intrinsic(int)) that
            let Unit : VType = @(intrinsic(unit)) that
            fn (a : Unit -> Int) =>
              fn (b : Unit -> Int) =>
                (fn (x : Int) (y : Int) => x) (b ()) (a ())
          );
          do h <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 1;
              ret 0
          };
          do _ <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 2;
              ret 0
          };
          ret 0
      end
    that
    -- a multi-argument body runs after its last argument: `body` sets 1 last
    def ! grouped =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <- @[cbv] (
            let VType = @(intrinsic(vtype)) that
            let Int : VType = @(intrinsic(int)) that
            let Unit : VType = @(intrinsic(unit)) that
            fn (body : Unit -> Int) =>
              fn (argument : Unit -> Int) =>
                (fn (x : Int) (y : Int) => body ()) 0 (argument ())
          );
          do h <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 1;
              ret 0
          };
          do _ <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 2;
              ret 0
          };
          ret 0
      end
    that
    -- the counterfactual: curried, the same effect runs before the second
    -- argument is even evaluated, so `argument` sets 2 last
    def ! curried =
      @[monadic] begin
        fn (put : Thk (Int -> Ret Unit)) =>
          do h <- @[cbv] (
            let VType = @(intrinsic(vtype)) that
            let Int : VType = @(intrinsic(int)) that
            let Unit : VType = @(intrinsic(unit)) that
            fn (body : Unit -> Int) =>
              fn (argument : Unit -> Int) =>
                (
                  fn (x : Int) =>
                    let _ = body () in
                    fn (y : Int) => y
                ) 0 (argument ())
          );
          do h <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 1;
              ret 0
          };
          do _ <- ! h {
            fn (u : Unit) =>
              do _ <- ! put 2;
              ret 0
          };
          ret 0
      end
    that

    let ! final (program : Thk (Thk (Int -> State Int Unit) -> State Int Int)) (k : Thk (Int -> OS))
    : OS =
        ! run_state Int Int OS 0 { ! program { fn value => ! state_instance/state .put value } } {
          fn s _ => ! k s
        }
    in
    ! final { ! arguments_ab (State Int) state_instance/monad } {
      fn s =>
        ! require 2 s {
          ! final { ! arguments_ba (State Int) state_instance/monad } {
            fn s =>
              ! require 1 s {
                ! final { ! grouped (State Int) state_instance/monad } {
                  fn s =>
                    ! require 1 s {
                      ! final { ! curried (State Int) state_instance/monad } {
                        fn s =>
                          ! require 2 s {
                            ! process/exit 0 }
                      }
                    }
                }
              }
          }
        }
    }
  end
end
