begin
  param (
    (/core; /numeric; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/Ret) = core that
  let (Scalar = Int64, int64) = numeric/int64 that
  let (/process) = system that
  def ! f (x : Int64) : Ret Int64 = ! (int64/eq)
    (Ret Int64)
    x
    0
    { ret 0 }
    {
      ret 1
    } that

  do z <- ! f 0;
  ! (process/exit) z
end
