begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def ! f (x : Int) : Ret Int =
    ! (api/int_eq_branch)
      (Ret Int)
      x
      0
      { ret 0 }
      { ret 1 }
  that

  do z <- ! f 0;
  ! (api/exit) z
end
