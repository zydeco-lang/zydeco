begin
  param (
    (/core; /numeric; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/Thk; /Ret; /Unit) = core that
  let (Scalar = Int64, int64) = numeric/int64 that
  let (/process) = system that

  -- Named components remain ordinary product components. They may be mixed with
  -- unnamed components, nested explicitly, and destructured by ordinary tuple
  -- patterns.
  let FlatMixed = (
    first :: Int64
  ) * Int64 * (third :: Int64) that
  let NestedMixed = ((left :: Int64) * Int64) * (right :: Int64) that
  def flat_mixed : FlatMixed = (
    first = 1 : Int64,
    2 : Int64,
    third = 3 : Int64
  ) that
  def nested_mixed : NestedMixed = (
    (left = 4 : Int64, 5 : Int64),
    right = 6 : Int64
  ) that

  def Packet =
    -- Data constructors do not interpret field names. Their payload may simply be
    -- a mixed product, whose labels are checked when its pattern is checked.
    data
    | +Packet : (
      kind :: Int64
    ) * Int64 * (payload :: Int64)
    | +Empty : Unit
    end
  that
  def packet : Packet = +Packet(
    kind = 7 : Int64,
    8 : Int64,
    payload = 9 : Int64
  ) that

  -- Named value types may contain thunked arrows. The arrow itself is unchanged:
  -- its parameter and result are merely ordinary value types containing names.
  let FunctionInput = (lhs :: Int64) * Int64 that
  let FunctionOutput = Int64 * (result :: Int64) that
  let FunctionBox = (apply :: Thk (FunctionInput -> Ret FunctionOutput)) * Int64 that
  def ! transform ((= lhs : Int64, rhs : Int64) : FunctionInput) : Ret FunctionOutput =
    do result <- ! (int64/add) lhs rhs;
    ret (lhs, = result)
  that
  def function_box : FunctionBox = (
    apply = transform,
    0
  ) that

  def Gauge =
    -- Codata also remains unchanged. A destructor may accept or return named value
    -- types, and a thunked codata object may itself occupy a named product field.
    codata
    | .read : Ret ((reading :: Int64) * Int64)
    | .shift : (delta :: Int64) -> Ret (reading :: Int64)
    end
  that
  let GaugeBox = Int64 * (gauge :: Thk Gauge) that
  def ! gauge : Gauge = comatch
  | .read => ret (reading = 12 : Int64, 13 : Int64)
  | .shift (= delta : Int64) => ret (reading = delta : Int64)
  end that
  def gauge_box : GaugeBox = (
    0,
    = gauge
  ) that

  -- Positional weighting makes an accidental field permutation visible.
  def ! checksum3 (a : Int64) (b : Int64) (c : Int64) : Ret Int64 =
    do tens <- ! (int64/mul) b 10;
    do hundreds <- ! (int64/mul) c 100;
    do low <- ! (int64/add) a tens;
    ! (int64/add) low hundreds
  that

  let (
    = first : Int64,
    middle : Int64,
    = third : Int64
  ) = flat_mixed in
  do flat_checksum <- ! checksum3 first middle third;
  do flat_check <- ! (int64/sub) flat_checksum 321;

  -- A variable pattern may bind a named component opaquely. It can then be
  -- opened by either a whole-pattern annotation or a payload annotation.
  let (
    first_field : (first :: Int64),
    opaque_middle : Int64,
    third_field : (third :: Int64)
  ) = flat_mixed in
  let ((first = opaque_first) : (first :: Int64)) = first_field in
  let (third = opaque_third : Int64) = third_field in
  do opaque_checksum <- ! checksum3 opaque_first opaque_middle opaque_third;
  do opaque_check <- ! (int64/sub) opaque_checksum 321;

  let (
    (= left : Int64, center : Int64),
    = right : Int64
  ) = nested_mixed in
  do nested_checksum <- ! checksum3 left center right;
  do nested_check <- ! (int64/sub) nested_checksum 654;

  match packet
  | +Packet(
    = kind : Int64,
    body : Int64,
    = payload : Int64
  ) =>
    do packet_checksum <- ! checksum3 kind body payload;
    do packet_check <- ! (int64/sub) packet_checksum 987;

    let (
      = apply : Thk (FunctionInput -> Ret FunctionOutput),
      function_marker : Int64
    ) = function_box in
    do transformed <- ! apply (lhs = 10 : Int64, 11 : Int64);
    let (
      echoed : Int64,
      = result : Int64
    ) = transformed in
    do function_checksum <- ! checksum3 echoed result 0;
    do function_check <- ! (int64/sub) function_checksum 220;

    let (
      gauge_marker : Int64,
      gauge = active_gauge : Thk Gauge
    ) = gauge_box in
    do observation <- ! active_gauge .read;
    let (
      = reading : Int64,
      drift : Int64
    ) = observation in
    do gauge_checksum <- ! checksum3 reading drift 0;
    do gauge_check <- ! (int64/sub) gauge_checksum 142;

    do shifted <- ! active_gauge .shift (delta = 14 : Int64);
    let (reading = shifted_reading : Int64) = shifted in
    do shift_pattern_check <- ! (int64/sub) shifted_reading 14;
    do shift_projection_check <- ! (int64/sub) shifted/reading 14;

    do total <- ! (int64/add) flat_check nested_check;
    do total <- ! (int64/add) total opaque_check;
    do total <- ! (int64/add) total packet_check;
    do total <- ! (int64/add) total function_marker;
    do total <- ! (int64/add) total function_check;
    do total <- ! (int64/add) total gauge_marker;
    do total <- ! (int64/add) total gauge_check;
    do total <- ! (int64/add) total shift_pattern_check;
    do total <- ! (int64/add) total shift_projection_check;
    ! (process/exit) total
  | +Empty() => ! (process/exit) 1
  end
end
