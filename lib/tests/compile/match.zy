begin
  def Bool =
    data
    | +False : Unit
    | +True : Unit
    end
  that
  param (
    (/core; /system) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/Unit) = core that
  let (/process) = system that

  let x : Bool = +False() in
  match x
  | +True(_) => ! (process/exit) 10
  | +False(_) => ! (process/exit) 0
  end
end
