begin
  def Bool =
    data
    | +False : Unit
    | +True : Unit
    end
  that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let x : Bool = +False() in
  match x
  | +True(_) => ! (api/exit) 10
  | +False(_) => ! (api/exit) 0
  end
end
