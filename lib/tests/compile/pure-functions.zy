begin
  param (
    (/Int; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  let captured : Int = 0 that
  let constant : Int -> Int = fn (_ : Int) => captured that
  let apply : (Int -> Int) -> Int -> Int =
    fn function => fn argument => function argument
  that
  let result : Int = apply constant 42 that

  ! (process/exit) result
end
