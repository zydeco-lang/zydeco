begin
  param (
    (/representations; /system) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/Scalar = Int64) = representations/i64 that
  let (/process) = system that

  let captured : Int64 = 0 that
  let constant : Int64 -> Int64 = fn (_ : Int64) => captured that
  let apply : (Int64 -> Int64) -> Int64 -> Int64 =
    fn function => fn argument => function argument
  that
  let result : Int64 = apply constant 42 that

  ! (process/exit) result
end
