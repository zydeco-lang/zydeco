begin
  param (
    (/representations; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/Int64) = representations/i64 that
  let (/process) = system that

  let captured : Int64 = 0 that
  let constant : Int64 -> Int64 = fn (_ : Int64) => captured that
  let apply : (Int64 -> Int64) -> Int64 -> Int64 = fn function argument => function argument that
  let result : Int64 = apply constant 42 that

  ! (process/exit) result
end
