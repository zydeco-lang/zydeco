extern def add : Thk (Int -> Int -> Ret Int) end
extern def exit : Thk (Int -> OS) end

alias TypeIdentity =
  begin
    let Result = A that
    param (A : VType) that
    Result
  end
end

alias IdentityResult = TypeIdentity Int end

def run = {
  begin
    let copy : Number = seed that
    param (seed : Number) that
    def expected : Int = 0 that
    let Number = A that
    param (A : VType) that
    def Opaque : VType = Int that
    do status <- ! add expected 0;
    ! exit status
  end
} end

main
  ! run Int 7
end
