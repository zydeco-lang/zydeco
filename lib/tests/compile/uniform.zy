begin
  let TypeIdentity =
    begin
      let Result = A that
      param (A : VType) that
      Result
    end
  that
  let IdentityResult = TypeIdentity Int that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def ! run
    : forall (A : VType) .
    A -> OS =
    begin
      let copy : Number = seed that
      param (seed : Number) that
      def expected : Int = 0 that
      let Number = A that
      param (A : VType) that
      def Opaque : VType = Int that
      do status <- ! (api/add) expected 0;
      ! (api/exit) status
    end
  that

  ! run IdentityResult 7
end
