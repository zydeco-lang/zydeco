begin
  param (
    (
      /Ret;
      /Int;
      /Char;
      /OS;
      /add;
      /sub;
      /int_eq_branch;
      /str_scalar_length;
      /str_append;
      /str_split_once_branch;
      /str_split_at_branch;
      /str_eq_branch;
      /str_get_branch;
      /int_to_str;
      /char_to_str;
      /char_codepoint;
      /str_parse_int_branch;
      /arg_fold;
      /exit
    ) :
    @[import("../../std/builtin.zy")] _
  ) that

  do twelve <- ! (int_to_str) 12;
  do combined <- ! (str_append) twelve twelve;
  do length <- ! (str_scalar_length) combined;
  do parsed <- ! (str_parse_int_branch)
    (Ret Int)
    combined
    { ret 0 }
    { fn integer => ret integer };
  do first <- ! (str_get_branch)
    (Ret Char)
    combined
    0
    { ret ' ' }
    { fn character => ret character };
  do first_code <- ! (char_codepoint) first;
  do first_string <- ! (char_to_str) first;
  do one_string <- ! (int_to_str) 1;
  do negative <- ! (int_to_str) -1;
  do dash <- ! (str_get_branch)
    (Ret Char)
    negative
    0
    { ret ' ' }
    { fn character => ret character };
  do fold_status <- ! (arg_fold)
    (Ret Int)
    { ret 0 }
    {
      fn argument remaining =>
        ret 1
    };
  do length_status <- ! (sub) length 4;
  do parsed_status <- ! (sub) parsed 1212;
  do first_status <- ! (sub) first_code 49;
  do status <- ! (add) length_status parsed_status;
  do status <- ! (add) status first_status;
  do status <- ! (add) status fold_status;
  ! (str_eq_branch)
    OS
    first_string
    one_string
    {
      ! (str_split_once_branch)
        OS
        negative
        dash
        { ! (exit) 1 }
        {
          fn prefix suffix =>
            do prefix_length <- ! (str_scalar_length) prefix;
            ! (int_eq_branch)
              OS
              prefix_length
              0
              {
                ! (str_eq_branch)
                  OS
                  suffix
                  one_string
                  {
                    ! (str_split_at_branch)
                      OS
                      combined
                      2
                      { ! (exit) 1 }
                      {
                        fn left right =>
                          ! (str_eq_branch)
                            OS
                            left
                            twelve
                            {
                              ! (str_eq_branch)
                                OS
                                right
                                twelve
                                { ! (exit) status }
                                { ! (exit) 1 }
                            }
                            { ! (exit) 1 }
                      }
                  }
                  { ! (exit) 1 }
              }
              { ! (exit) 1 }
        }
    }
    { ! (exit) 1 }
end
