begin
  param (
    (
      /Ret;
      /Int;
      /OS;
      /add;
      /int_eq_branch;
      /str_scalar_length;
      /arg_fold;
      /exit
    ) :
    @[import("../../std/builtin.zy")] _
  ) that

  do length <- ! (arg_fold)
    (Ret Int)
    { ret 0 }
    {
      fn argument remaining =>
        do suffix_length <- ! remaining;
        do argument_length <- ! (str_scalar_length) argument;
        ! (add) argument_length suffix_length
    };
  ! (int_eq_branch)
    OS
    length
    9
    { ! (exit) 0 }
    { ! (exit) 1 }
end
