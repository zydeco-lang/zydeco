begin
  param (
    (/Ret; /Int64; /OS; /int64; /string; /args; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  do length <- ! (args/fold)
    (Ret Int64)
    { ret 0 }
    {
      fn argument remaining =>
        do suffix_length <- ! remaining;
        do argument_length <- ! (string/length) argument;
        ! (int64/add) argument_length suffix_length
    };
  ! (int64/eq)
    OS
    length
    9
    { ! (process/exit) 0 }
    { ! (process/exit) 1 }
end
