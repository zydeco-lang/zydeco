begin
  param (
    (/Ret; /Int; /OS; /int; /string; /args; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  do length <- ! (args/fold)
    (Ret Int)
    { ret 0 }
    {
      fn argument remaining =>
        do suffix_length <- ! remaining;
        do argument_length <- ! (string/length) argument;
        ! (int/add) argument_length suffix_length
    };
  ! (int/eq)
    OS
    length
    9
    { ! (process/exit) 0 }
    { ! (process/exit) 1 }
end
