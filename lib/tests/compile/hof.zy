begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def apply : Thk (
    forall (A : VType) .
    forall (B : CType) .
      Thk (A -> B) -> A -> B
  ) = {
    fn (A : VType)
       (B : CType)
       (function : Thk (A -> B))
       (argument : A) ->
      ! function argument
  } that

  do status <- ! apply Int (Ret Int) { fn value -> ret value } 0;
  ! (api/exit) status
end
