begin
  param (
    (/core; /representations; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/VType; /CType; /Thk; /Ret) = core that
  let (/Int64) = representations/i64 that
  let (/process) = system that
  def ! apply (A : VType) (B : CType) (f : Thk (A -> B)) (x : A) : B = ! f x that

  do x <- ! apply Int64 (Ret Int64) { fn x => ret x } 0;
  ! (process/exit) x
end
