begin
  param (
    (/core; /representations; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/VType) = core that
  let (/Int64) = representations/i64 that
  let (/process) = system that
  def packed :
    exists (X : VType) (Y : VType) . X * Y * Int64 =
      (Int64, Int64, 10, (20, 0))
  that

  match packed
  | (Left, Right, x, y, status) =>
    let flat = (x, status, y) in
    let (a, (code, c)) = flat in
    let nested = (a, (code, c)) in
    let (p, result, q) = nested in
    ! (process/exit) result
  end
end
