begin
  param (
    (
      /VType;
      /Int;
      /exit
    ) :
    @[import("../../std/builtin.zy")] _
  ) that
  def packed :
    exists (X : VType) .
    exists (Y : VType) .
      X * (Y * Int) =
    (Int, Int, 10, (20, 0))
  that

  match packed
  | (Left, Right, x, y, status) =>
    let flat = (x, status, y) in
    let (a, (code, c)) = flat in
    let nested = (a, (code, c)) in
    let (p, result, q) = nested in
    ! (exit) result
  end
end
