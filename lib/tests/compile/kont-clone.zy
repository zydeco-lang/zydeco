begin
  def Bool =
    data
    | +False : Unit
    | +True : Unit
    end
  that
  param (
    (/Thk; /Unit; /Int64; /OS; /process) :
    @[import("../../std/builtin.zy")] _
  ) that
  def ! f : Bool -> Thk (Int64 -> OS) -> OS =
    fn (b : Bool) (k : Thk (Int64 -> OS)) =>
      -- k might be large
      match b
      | +True(_) => ! k 0
      | +False(_) => ! k 1
      end
  that

  ! f (+True()) {
    -- a large continuation gets inlined
    fn x =>
      match (+True() : Bool)
      | +True(_) => ! (process/exit) x
      | +False(_) => ! (process/exit) 0
      end
  }
end
