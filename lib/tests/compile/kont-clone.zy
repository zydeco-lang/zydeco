extern def exit : Thk (Int -> OS) end

alias Bool : VType =
  data
  | +False : Unit
  | +True : Unit
  end
end

def ! f (b: Bool) (k: Thk (Int -> OS)) =
  -- k might be large
  match b
  | +True _ -> ! k 0
  | +False _ -> ! k 1
  end
end

main
  ! f (+True ()) {
    -- a large continuation gets inlined
    fn x -> match (+True (): Bool)
    | +True _ -> ! exit x
    | +False _ -> ! exit 0
    end
  }
end
