begin
  def Bool =
    data
    | +False : Unit
    | +True : Unit
    end
  that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def f : Thk (Bool -> Thk (Int -> OS) -> OS) = {
    fn (b : Bool) (k : Thk (Int -> OS)) ->
      -- k might be large
      match b
      | +True(_) -> ! k 0
      | +False(_) -> ! k 1
      end
  } that

  ! f (+True()) {
    -- a large continuation gets inlined
    fn x ->
      match (+True() : Bool)
      | +True(_) -> ! (api/exit) x
      | +False(_) -> ! (api/exit) 0
      end
  }
end
