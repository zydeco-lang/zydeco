begin
  param (/core; /representations; /system) : @(import("../../std/builtin.zy")) that
  let (/VType; /Unit) = core that
  let (/Int64) = representations/i64 that
  let (/process) = system that

  let Tagged =
    data
    | +Tagged : Int64
    | +Other : Unit
    end
  that

  let val keep (A : VType) (value : A) : A = value that
  let val tag (value : Int64) : Tagged = +Tagged(value) that
  let val other (_ : Int64) : Tagged = +Other(()) that

  let forward : Int64 = 0 |> keep Int64 that
  let backward : Int64 = keep Int64 <| forward that
  let keep[Int64] ~> via_pattern = backward that
  match via_pattern
  | other ~> +Tagged(_) => ! (process/exit) 1
  | tag ~> +Tagged(status) => ! (process/exit) status
  | _ => ! (process/exit) 1
  end
end
