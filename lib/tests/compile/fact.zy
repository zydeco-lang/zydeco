begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    public
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  let factorial : Thk (StdInt -> Ret StdInt) = {
    fix (factorial : Thk (StdInt -> Ret StdInt)) ->
      fn (value : StdInt) ->
        do zero <- ! (public/int_eq) value 0;
        ! (public/branch)
          (Ret StdInt)
          zero
          { ret 1 }
          {
            do predecessor <- ! (public/sub) value 1;
            do accumulated <- ! factorial predecessor;
            ! (public/mul) value accumulated
          }
  } in
  do result <- ! factorial 10;
  do status <- ! (public/sub) result 3628800;
  ! (public/exit) status
end
