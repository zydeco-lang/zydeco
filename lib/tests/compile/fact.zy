begin
  let make_std = @(import("../../std/std.zy")) that
  param (
    (/core; /representations; builtin) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/Ret) = core that
  let (/Scalar = Int64) = representations/i64 that

  let (/bool; /int64; /process) =
    make_std builtin
  in
  let fix fact (i : Int64) : Ret Int64 =
    -- extern def add : Thk (Int64 -> Int64 -> Ret Int64) end
    do zero? <- ! (int64/eq) i 0;
    ! (bool/if)
      (Ret Int64)
      zero?
      { ret 1 }
      {
        -- do i <- ret i;
        do i' <- ! (int64/sub) i 1;
        do acc <- ! fact i';
        ! (int64/mul) i acc
      }
  in
  do x <- ! fact 10;
  do r <- ! (int64/sub) x 3628800;
  ! (process/exit) r
end
