begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/Int = StdInt; /bool; /int; /process) =
    make_std (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api)
  in
  let fix fact (i : StdInt) : Ret StdInt =
    -- extern def add : Thk (Int -> Int -> Ret Int) end
    do zero? <- ! (int/eq) i 0;
    ! (bool/if)
      (Ret StdInt)
      zero?
      { ret 1 }
      {
        -- do i <- ret i;
        do i' <- ! (int/sub) i 1;
        do acc <- ! fact i';
        ! (int/mul) i acc
      }
  in
  do x <- ! fact 10;
  do r <- ! (int/sub) x 3628800;
  ! (process/exit) r
end
