begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  ! (api/read_line) {
    fn line ->
      let f : Thk (Int -> OS) = {
        fn z ->
          let line = line in
          ! (api/exit) z
      } in
      ! f 0
  }
end
