begin
  param (
    (/representations; /system) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/Scalar = Int64) = representations/i64 that
  let (/OS; /stdio; /process) = system that

  ! (stdio/read_line) {
    fn line =>
      let ! f (z : Int64) : OS =
        let line = line in
        ! (process/exit) z
      in
      ! f 0
  }
end
