begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def id : Thk (
    forall (A : VType) .
      A -> Ret A
  ) = {
    fn (A : VType) (a : A) ->
      ret a
  } that

  do x <- ! id Int 0;
  do y <- ! id Int x;
  do z <- ! id Int y;
  do r <- ! id Int z;
  ! (api/exit) r
end
