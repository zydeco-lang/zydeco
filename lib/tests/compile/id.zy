begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def identity : Thk (
    forall (A : VType) .
      A -> Ret A
  ) = {
    fn (A : VType) (value : A) ->
      ret value
  } that

  do first <- ! identity Int 0;
  do second <- ! identity Int first;
  do third <- ! identity Int second;
  do status <- ! identity Int third;
  ! (api/exit) status
end
