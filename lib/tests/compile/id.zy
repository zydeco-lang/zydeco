begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def ! id (A : VType) (a : A) : Ret A =
    ret a
  that

  do x <- ! id Int 0;
  do y <- ! id Int x;
  do z <- ! id Int y;
  do r <- ! id Int z;
  ! (api/exit) r
end
