begin
  param (
    (/core; /representations; /system) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/VType; /Ret) = core that
  let (/Scalar = Int64) = representations/i64 that
  let (/process) = system that
  def ! id (A : VType) (a : A) : Ret A =
    ret a
  that

  do x <- ! id Int64 0;
  do y <- ! id Int64 x;
  do z <- ! id Int64 y;
  do r <- ! id Int64 z;
  ! (process/exit) r
end
