begin
  param (
    (/core; /representations; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/VType; /Ret) = core that
  let (/Scalar = Int64) = representations/i64 that
  let (/process) = system that
  let x = 100 that
  def ! const (A : VType) (A' : VType) (a : A) (_ : A') : Ret A = let _ = x in
  ret a that
  def ! one : Int64 -> Ret Int64 = ! const Int64 Int64 0 that

  do x <- ! one 20;
  ! (process/exit) x
end
