begin
  param (
    (/VType; /Ret; /Int; /process) :
    @[import("../../std/builtin.zy")] _
  ) that
  let x = 100 that
  def ! const (A : VType) (A' : VType) (a : A) (_ : A') : Ret A =
    let _ = x in
    ret a
  that
  def ! one : Int -> Ret Int =
    ! const Int Int 0
  that

  do x <- ! one 20;
  ! (process/exit) x
end
