begin
  param (
    (/OS; /int_eq_branch; /str_scalar_length; /str_append; /str_eq_branch; /exit) :
    @[import("../../std/builtin.zy")] _
  ) that

  do unicode_length <- ! (str_scalar_length) "λx";
  do joined <- ! (str_append) "uniform " "terms";
  ! (int_eq_branch)
    OS
    unicode_length
    2
    {
      ! (str_eq_branch)
        OS
        joined
        "uniform terms"
        { ! (exit) 0 }
        { ! (exit) 2 }
    }
    { ! (exit) 1 }
end
