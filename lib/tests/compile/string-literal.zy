begin
  param (
    (/OS; /int; /string; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  do unicode_length <- ! (string/length) "λx";
  do joined <- ! (string/append) "uniform " "terms";
  ! (int/eq)
    OS
    unicode_length
    2
    {
      ! (string/eq)
        OS
        joined
        "uniform terms"
        { ! (process/exit) 0 }
        { ! (process/exit) 2 }
    }
    { ! (process/exit) 1 }
end
