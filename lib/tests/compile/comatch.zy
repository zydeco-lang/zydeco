begin
  param (
    (/representations; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/Scalar = Int64) = representations/i64 that
  let (/OS; /process) = system that
  def Choice =
    codata
    | .left : OS
    | .right : Int64 -> OS
    end
  that

  (
    comatch
    | .left => ! (process/exit) 10
    | .right i => ! (process/exit) i
    end
    : Choice
  ) .right 0
end
