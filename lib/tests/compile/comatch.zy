begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def Choice =
    codata
    | .left : OS
    | .right : Int -> OS
    end
  that

  (comatch
  | .left => ! (api/exit) 10
  | .right i => ! (api/exit) i
  end : Choice) .right 0
end
