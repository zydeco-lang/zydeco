begin
  param (
    (/numeric; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (#Scalar = Int64, int64) = numeric/int64 that
  let (/process) = system that

  do x <- ret 40;
  do y <- ret 30;
  do z <-
    do a <- ! (int64/add) x y;
    do b <- ! (int64/add) a 10;
    ret b;
  do r <- ! (int64/sub) z 80;
  ! (process/exit) r
end
