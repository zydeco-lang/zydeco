begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do left <- ret 40;
  do right <- ret 30;
  do total <-
    do subtotal <- ! (api/add) left right;
    do total <- ! (api/add) subtotal 10;
    ret total;
  do status <- ! (api/sub) total 80;
  ! (api/exit) status
end
