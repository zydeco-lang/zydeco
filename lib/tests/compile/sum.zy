begin
  param (
    (/Ret; /Int; /int; /process) :
    @[import("../../std/builtin.zy")] _
  ) that
  def fix sum (i : Int) (acc : Int) : Ret Int =
    ! (int/eq)
      (Ret Int)
      i
      0
      { ret acc }
      {
        -- do i <- ret i;
        do i' <- ! (int/sub) i 1;
        do acc' <- ! (int/add) i acc;
        ! sum i' acc'
      }
  that

  do z <- ! sum 10 0;
  do r <- ! (int/sub) z 55;
  ! (process/exit) r
end
