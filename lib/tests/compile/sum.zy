begin
  param (
    (/Ret; /Int; /add; /sub; /int_eq_branch; /exit) :
    @[import("../../std/builtin.zy")] _
  ) that
  def fix sum (i : Int) (acc : Int) : Ret Int =
    ! (int_eq_branch)
      (Ret Int)
      i
      0
      { ret acc }
      {
        -- do i <- ret i;
        do i' <- ! (sub) i 1;
        do acc' <- ! (add) i acc;
        ! sum i' acc'
      }
  that

  do z <- ! sum 10 0;
  do r <- ! (sub) z 55;
  ! (exit) r
end
