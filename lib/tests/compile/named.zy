begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  let Point = (x :: Int) * (y :: Int) that
  let Rectangle = (top_left :: Point) * (status :: Int) that
  let Triple = (first :: Int) * ((middle :: Int) * (last :: Int)) that
  let Nested = ((inner_x :: Int) * (inner_y :: Int)) * (outer :: Int) that
  def rectangle : Rectangle = (
    top_left = (x = 5, y = 1),
    status = 0
  ) that
  def triple : Triple = (first = 7, middle = -3, last = -4) that
  def nested : Nested = ((inner_x = 0, inner_y = -12), outer = 0) that
  def first_global : Int = triple/first that

  let (top_left = point, = status : Int) = rectangle in
  let status_field = (= status : Int) in
  let direct = (code = point/x) in
  let (inner, outer = ignored_outer) = nested in
  let pair = (triple/first, triple/last) in
  let (first, last) = pair in
  do total <- ! (api/add) first triple/middle;
  do total <- ! (api/add) total last;
  do total <- ! (api/add) total inner/inner_y;
  do total <- ! (api/add) total direct/code;
  do total <- ! (api/add) total first_global;
  do total <- ! (api/add) total status_field/status;
  ! (api/exit) total
end
