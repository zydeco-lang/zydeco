-- a binary tree
begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Tree (A : VType) : VType =
    data
    | +Leaf : Unit
    | +Node : Tree A * A * Tree A
    end
  that
  -- capture the shape of do binding with a kont type
  let TreeKont (A : VType) =
    codata
    | .run :
      Thk (Tree A -> Ret (Tree A)) ->
      Ret (Tree A)
    end
  that
  -- a normal invert without tail-call opt.
  def invert : Thk (
    forall (A : VType) .
      Tree A ->
      Ret (Tree A)
  ) = {
    fix (invert : Thk (
      forall (A : VType) .
        Tree A ->
        Ret (Tree A)
    )) ->
      fn A tree ->
        match tree
        | +Leaf() -> ret +Leaf()
        | +Node(l, a, r) ->
          do l <- ! invert A l;
          do r <- ! invert A r;
          ret +Node(r, a, l)
        end
  } that
  -- now we have the tree kont version of invert, tail recursive by default
  def invert_tree_kont : Thk (
    forall (A : VType) .
      Tree A ->
      TreeKont A
  ) = {
    fix (invert_tree_kont : Thk (
      forall (A : VType) .
        Tree A ->
        TreeKont A
    )) ->
      fn A tree ->
        match tree
        | +Leaf() ->
          comatch
          | .run k ->
            ! k +Leaf()
          end
        | +Node(l, a, r) ->
          comatch
          | .run k ->
            ! invert_tree_kont A l .run {
              fn l ->
                ! invert_tree_kont A r .run {
                  fn r ->
                    ! k +Node(r, a, l)
                }
            }
          end
        end
  } that
  def invert' : Thk (
    forall (A : VType) .
      Tree A ->
      Ret (Tree A)
  ) = {
    fn A tree ->
      ! invert_tree_kont A tree .run {
        fn t ->
          ret t
      }
  } that
  -- and below is the correct cps solution
  def invert_kont : Thk (
    forall (A : VType) .
      Tree A ->
      Thk (Tree A -> Ret (Tree A)) ->
      Ret (Tree A)
  ) = {
    fix (invert_kont : Thk (
      forall (A : VType) .
        Tree A ->
        Thk (Tree A -> Ret (Tree A)) ->
        Ret (Tree A)
    )) ->
      fn A tree k ->
        match tree
        | +Leaf() -> ! k +Leaf()
        | +Node(l, a, r) ->
          ! invert_kont A l {
            fn l ->
              ! invert_kont A r {
                fn r ->
                  ! k +Node(r, a, l)
              }
          }
        end
  } that
  def invert'' : Thk (
    forall (A : VType) .
      Tree A ->
      Ret (Tree A)
  ) = {
    fn A tree ->
      ! invert_kont A tree {
        fn t ->
          ret t
      }
  } that
  -- here's a test
  def t0 : Tree Int =
    +Node(
      +Node(
        +Node(+Leaf(), 1, +Leaf()),
        2,
        +Leaf()
      ),
      0,
      +Node(+Leaf(), 3, +Leaf())
    )
  that
  def write_tree : Thk (
    Tree Int ->
    Thk OS ->
    OS
  ) = {
    fix (write_tree : Thk (
      Tree Int ->
      Thk OS ->
      OS
    )) ->
      fn t k ->
        match t
        | +Leaf() ->
          ! (api/write_str) "()" k
        | +Node(l, a, r) ->
          ! (api/write_str) "(" {
            ! write_tree l {
              ! (api/write_int) a {
                ! write_tree r {
                  ! (api/write_str) ")" k
                }
              }
            }
          }
        end
  } that

  do t1 <- ! invert Int t0;
  do t2 <- ! invert' Int t0;
  do t3 <- ! invert'' Int t0;
  ! write_tree t0 {
    ! (api/write_line) "" {
      ! write_tree t1 {
        ! (api/write_line) "" {
          ! write_tree t2 {
            ! (api/write_line) "" {
              ! write_tree t3 {
                ! (api/write_line) "" {
                  ! (api/exit) 0
                }
              }
            }
          }
        }
      }
    }
  }
end
