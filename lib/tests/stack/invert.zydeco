begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Tree :
    (VType) ->
    (VType) =
    begin
      param (A : VType) that
      data
      | +Leaf : Unit
      | +Node : Tree A * A * Tree A
      end
    end
  that
  def TreeKont :
    (VType) ->
    (CType) =
    begin
      param (A : VType) that
      codata
      | .run :
        Thk (Tree A -> Ret (Tree A)) ->
        Ret (Tree A)
      end
    end
  that
  def invert : Thk (
    forall (A : VType) .
      Tree A ->
      Ret (Tree A)
  ) = {
    fix (invert : Thk (
      forall (A : VType) .
        Tree A ->
        Ret (Tree A)
    )) ->
      fn A tree ->
        match tree
        | +Leaf() -> ret +Leaf()
        | +Node(left, value, right) ->
          do left <- ! invert A left;
          do right <- ! invert A right;
          ret +Node(right, value, left)
        end
  } that
  def invert_tree_kont : Thk (
    forall (A : VType) .
      Tree A ->
      TreeKont A
  ) = {
    fix (invert_tree_kont : Thk (
      forall (A : VType) .
        Tree A ->
        TreeKont A
    )) ->
      fn A tree ->
        match tree
        | +Leaf() ->
          comatch
          | .run continuation ->
            ! continuation +Leaf()
          end
        | +Node(left, value, right) ->
          comatch
          | .run continuation ->
            ! invert_tree_kont A left .run {
              fn left ->
                ! invert_tree_kont A right .run {
                  fn right ->
                    ! continuation +Node(right, value, left)
                }
            }
          end
        end
  } that
  def invert_tree : Thk (
    forall (A : VType) .
      Tree A ->
      Ret (Tree A)
  ) = {
    fn A tree ->
      ! invert_tree_kont A tree .run {
        fn result ->
          ret result
      }
  } that
  def invert_kont : Thk (
    forall (A : VType) .
      Tree A ->
      Thk (Tree A -> Ret (Tree A)) ->
      Ret (Tree A)
  ) = {
    fix (invert_kont : Thk (
      forall (A : VType) .
        Tree A ->
        Thk (Tree A -> Ret (Tree A)) ->
        Ret (Tree A)
    )) ->
      fn A tree continuation ->
        match tree
        | +Leaf() -> ! continuation +Leaf()
        | +Node(left, value, right) ->
          ! invert_kont A left {
            fn left ->
              ! invert_kont A right {
                fn right ->
                  ! continuation +Node(right, value, left)
              }
          }
        end
  } that
  def invert_cps : Thk (
    forall (A : VType) .
      Tree A ->
      Ret (Tree A)
  ) = {
    fn A tree ->
      ! invert_kont A tree {
        fn result ->
          ret result
      }
  } that
  def tree : Tree Int =
    +Node(
      +Node(
        +Node(+Leaf(), 1, +Leaf()),
        2,
        +Leaf()
      ),
      0,
      +Node(+Leaf(), 3, +Leaf())
    )
  that
  def write_tree : Thk (
    Tree Int ->
    Thk OS ->
    OS
  ) = {
    fix (write_tree : Thk (
      Tree Int ->
      Thk OS ->
      OS
    )) ->
      fn tree continuation ->
        match tree
        | +Leaf() ->
          ! (api/write_str) "()" continuation
        | +Node(left, value, right) ->
          ! (api/write_str) "(" {
            ! write_tree left {
              ! (api/write_int) value {
                ! write_tree right {
                  ! (api/write_str) ")" continuation
                }
              }
            }
          }
        end
  } that

  do direct <- ! invert Int tree;
  do explicit_stack <- ! invert_tree Int tree;
  do cps <- ! invert_cps Int tree;
  ! write_tree tree {
    ! (api/write_line) "" {
      ! write_tree direct {
        ! (api/write_line) "" {
          ! write_tree explicit_stack {
            ! (api/write_line) "" {
              ! write_tree cps {
                ! (api/write_line) "" {
                  ! (api/exit) 0
                }
              }
            }
          }
        }
      }
    }
  }
end
