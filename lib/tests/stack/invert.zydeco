-- a binary tree
begin
  param (
    (/VType; /Thk; /Ret; /Unit; /Int; /OS; /stdio; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Tree (A : VType) : VType =
    data
    | +Leaf : Unit
    | +Node : Tree A * A * Tree A
    end
  that
  -- capture the shape of do binding with a kont type
  def TreeKont (A : VType) =
    codata
    | .run :
      Thk (Tree A -> Ret (Tree A)) ->
      Ret (Tree A)
    end
  that
  -- a normal invert without tail-call opt.
  def fix invert (A : VType) (tree : Tree A) : Ret (Tree A) =
    match tree
    | +Leaf() => ret +Leaf()
    | +Node(l, a, r) =>
      do l <- ! invert A l;
      do r <- ! invert A r;
      ret +Node(r, a, l)
    end
  that
  -- now we have the tree kont version of invert, tail recursive by default
  def fix invert_tree_kont (A : VType) (tree : Tree A) : TreeKont A =
    match tree
    | +Leaf() =>
      comatch
      | .run k =>
        ! k +Leaf()
      end
    | +Node(l, a, r) =>
      comatch
      | .run k =>
        ! invert_tree_kont A l .run {
          fn l =>
            ! invert_tree_kont A r .run {
              fn r =>
                ! k +Node(r, a, l)
            }
        }
      end
    end
  that
  def ! invert' (A : VType) (tree : Tree A) : Ret (Tree A) =
    ! invert_tree_kont A tree .run {
      fn t =>
        ret t
    }
  that
  -- and below is the correct cps solution
  def fix invert_kont (A : VType) (tree : Tree A) (k : Thk (Tree A -> Ret (Tree A))) : Ret (Tree A) =
    match tree
    | +Leaf() => ! k +Leaf()
    | +Node(l, a, r) =>
      ! invert_kont A l {
        fn l =>
          ! invert_kont A r {
            fn r =>
              ! k +Node(r, a, l)
          }
      }
    end
  that
  def ! invert'' (A : VType) (tree : Tree A) : Ret (Tree A) =
    ! invert_kont A tree {
      fn t =>
        ret t
    }
  that
  -- here's a test
  def t0 : Tree Int =
    +Node(
      +Node(
        +Node(+Leaf(), 1, +Leaf()),
        2,
        +Leaf()
      ),
      0,
      +Node(+Leaf(), 3, +Leaf())
    )
  that
  def fix write_tree (t : Tree Int) (k : Thk OS) : OS =
    match t
    | +Leaf() =>
      ! (stdio/write) "()" k
    | +Node(l, a, r) =>
      ! (stdio/write) "(" {
        ! write_tree l {
          ! (stdio/write_int) a {
            ! write_tree r {
              ! (stdio/write) ")" k
            }
          }
        }
      }
    end
  that

  do t1 <- ! invert Int t0;
  do t2 <- ! invert' Int t0;
  do t3 <- ! invert'' Int t0;
  ! write_tree t0 {
    ! (stdio/write_line) "" {
      ! write_tree t1 {
        ! (stdio/write_line) "" {
          ! write_tree t2 {
            ! (stdio/write_line) "" {
              ! write_tree t3 {
                ! (stdio/write_line) "" {
                  ! (process/exit) 0
                }
              }
            }
          }
        }
      }
    }
  }
end
