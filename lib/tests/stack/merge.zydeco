begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def List (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * List A
    end
  that
  def fix merge (a : List Int) (b : List Int) : Ret (List Int) =
    match a
    | +Nil() => ret b
    | +Cons(a_head, a_tail) =>
      match b
      | +Nil() => ret a
      | +Cons(b_head, b_tail) =>
        ! (api/int_gt_branch)
          (Ret (List Int))
          a_head
          b_head
          {
            do res <- ! merge a b_tail;
            ret +Cons(b_head, res)
          }
          {
            do res <- ! merge a_tail b;
            ret +Cons(a_head, res)
          }
      end
    end
  that

  ! (api/exit) 0
end
