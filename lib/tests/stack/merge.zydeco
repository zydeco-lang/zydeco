begin
  param (
    (/core; /numeric; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/VType; /Ret; /Unit) = core that
  let (#Int64 = Int64, int64) = numeric/int64 that
  let (/process) = system that

  def List (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * List A
    end
  that
  def fix merge (a : List Int64) (b : List Int64) : Ret (List Int64) =
    match a
    | +Nil() => ret b
    | +Cons(a_head, a_tail) =>
      match b
      | +Nil() => ret a
      | +Cons(b_head, b_tail) =>
        ! (int64/gt)
          (Ret (List Int64))
          a_head
          b_head
          {
            do res <- ! merge a b_tail;
            ret +Cons(b_head, res)
          }
          {
            do res <- ! merge a_tail b;
            ret +Cons(a_head, res)
          }
      end
    end
  that

  ! (process/exit) 0
end
