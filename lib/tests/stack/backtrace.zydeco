begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Tree :
    (VType) ->
    (VType) =
    begin
      param (A : VType) that
      data
      | +Leaf : Unit
      | +Node : Tree A * A * Tree A
      end
    end
  that
  def List :
    (VType) ->
    (VType) =
    begin
      param (A : VType) that
      data
      | +Nil : Unit
      | +Cons : A * List A
      end
    end
  that
  def trace : Thk (
    forall (A : VType) .
      Tree A ->
      List A ->
      Ret (Tree (List A))
  ) = {
    fix (trace : Thk (
      forall (A : VType) .
        Tree A ->
        List A ->
        Ret (Tree (List A))
    )) ->
      fn A tree stack ->
        match tree
        | +Leaf() -> ret +Leaf()
        | +Node(left, value, right) ->
          let stack : List A = +Cons(value, stack) in
          do left <- ! trace A left stack;
          do right <- ! trace A right stack;
          ret +Node(left, stack, right)
        end
  } that
  def tree : Tree Int =
    +Node(
      +Node(
        +Node(+Leaf(), 1, +Leaf()),
        2,
        +Leaf()
      ),
      0,
      +Node(+Leaf(), 3, +Leaf())
    )
  that
  def write_list : Thk (
    forall (A : VType) .
      Thk (A -> Thk OS -> OS) ->
      List A ->
      Thk OS ->
      OS
  ) = {
    fn A write list continuation ->
      let write_tail : Thk (
        List A ->
        Thk OS ->
        OS
      ) = {
        fix (write_tail : Thk (
          List A ->
          Thk OS ->
          OS
        )) ->
          fn list continuation ->
            match list
            | +Nil() -> ! continuation
            | +Cons(value, tail) ->
              ! write value {
                ! (api/write_str) "," {
                  ! write_tail tail continuation
                }
              }
            end
      } in
      ! (api/write_str) "[" {
        ! write_tail list {
          ! (api/write_str) "]" continuation
        }
      }
  } that
  def write_tree : Thk (
    forall (A : VType) .
      Thk (A -> Thk OS -> OS) ->
      Tree A ->
      Thk OS ->
      OS
  ) = {
    fix (write_tree : Thk (
      forall (A : VType) .
        Thk (A -> Thk OS -> OS) ->
        Tree A ->
        Thk OS ->
        OS
    )) ->
      fn A write tree continuation ->
        match tree
        | +Leaf() ->
          ! (api/write_str) "()" continuation
        | +Node(left, value, right) ->
          ! (api/write_str) "(" {
            ! write_tree A write left {
              ! write value {
                ! write_tree A write right {
                  ! (api/write_str) ")" continuation
                }
              }
            }
          }
        end
  } that

  do traced <- ! trace Int tree +Nil();
  ! write_tree Int (api/write_int) tree {
    ! (api/write_line) "" {
      ! write_tree
        (List Int)
        { ! write_list Int (api/write_int) }
        traced
        {
          ! (api/write_line) "" {
            ! (api/exit) 0
          }
        }
    }
  }
end
