-- a binary tree
begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Tree (A : VType) : VType =
    data
    | +Leaf : Unit
    | +Node : Tree A * A * Tree A
    end
  that
  -- codata Trace (A: VType) where
  -- | .done : Ret (Tree (List A))
  -- | .step : A -> Trace A
  -- end
  def List (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * List A
    end
  that
  def trace : Thk (
    forall (A : VType) .
      Tree A ->
      List A ->
      Ret (Tree (List A))
  ) = {
    fix (trace : Thk (
      forall (A : VType) .
        Tree A ->
        List A ->
        Ret (Tree (List A))
    )) ->
      fn A t stk ->
        match t
        | +Leaf() -> ret +Leaf()
        | +Node(l, a, r) ->
          let stk : List A = +Cons(a, stk) in
          do l <- ! trace A l stk;
          do r <- ! trace A r stk;
          ret +Node(l, stk, r)
        end
  } that
  -- here's a test
  def t0 : Tree Int =
    +Node(
      +Node(
        +Node(+Leaf(), 1, +Leaf()),
        2,
        +Leaf()
      ),
      0,
      +Node(+Leaf(), 3, +Leaf())
    )
  that
  def write_list : Thk (
    forall (A : VType) .
      Thk (A -> Thk OS -> OS) ->
      List A ->
      Thk OS ->
      OS
  ) = {
    fn A write l k ->
      let write_list_aux : Thk (
        List A ->
        Thk OS ->
        OS
      ) = {
        fix (write_list_aux : Thk (
          List A ->
          Thk OS ->
          OS
        )) ->
          fn l k ->
            match l
            | +Nil() -> ! k
            | +Cons(a, l) ->
              ! write a {
                ! (api/write_str) "," {
                  ! write_list_aux l k
                }
              }
            end
      } in
      ! (api/write_str) "[" {
        ! write_list_aux l {
          ! (api/write_str) "]" k
        }
      }
  } that
  def write_tree : Thk (
    forall (A : VType) .
      Thk (A -> Thk OS -> OS) ->
      Tree A ->
      Thk OS ->
      OS
  ) = {
    fix (write_tree : Thk (
      forall (A : VType) .
        Thk (A -> Thk OS -> OS) ->
        Tree A ->
        Thk OS ->
        OS
    )) ->
      fn A write t k ->
        match t
        | +Leaf() ->
          ! (api/write_str) "()" k
        | +Node(l, a, r) ->
          ! (api/write_str) "(" {
            ! write_tree A write l {
              ! write a {
                ! write_tree A write r {
                  ! (api/write_str) ")" k
                }
              }
            }
          }
        end
  } that

  do t1 <- ! trace Int t0 +Nil();
  ! write_tree Int (api/write_int) t0 {
    ! (api/write_line) "" {
      ! write_tree
        (List Int)
        { ! write_list Int (api/write_int) }
        t1
        {
          ! (api/write_line) "" {
            ! (api/exit) 0
          }
        }
    }
  }
end
