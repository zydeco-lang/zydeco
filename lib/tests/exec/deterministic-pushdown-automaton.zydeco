begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  let Tok =
    data
    | +LParen : Unit
    | +RParen : Unit
    end
  that
  def LList' (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * Thk (Ret (LList' A))
    end
  that
  let ParenCounterState =
    data
    | +Ok : Unit
    | +Reject : Unit
    end
  that
  def ParenCounterStk : CType =
    codata
    | .none : Ret Bool
    | .some : ParenCounterStk
    end
  that
  let ParenCounterTrans : CType =
    ParenCounterState -> ParenCounterStk
  that

  def bool_eq : Thk (Bool -> Bool -> Ret Bool) = {
    fn left right ->
      match left
      | +True() ->
        match right
        | +True() -> ret +True()
        | +False() -> ret +False()
        end
      | +False() ->
        match right
        | +True() -> ret +False()
        | +False() -> ret +True()
        end
      end
  } that
  def bool_to_str : Thk (Bool -> Ret String) = {
    fn b ->
      match b
      | +True() -> ret "true"
      | +False() -> ret "false"
      end
  } that
  def paren_foldr : Thk (
    Thk (Ret (LList' Tok)) ->
    Thk (Tok -> Thk ParenCounterTrans -> ParenCounterTrans) ->
    Thk ParenCounterTrans ->
    ParenCounterTrans
  ) = {
    fix (
      paren_foldr :
      Thk (
        Thk (Ret (LList' Tok)) ->
        Thk (Tok -> Thk ParenCounterTrans -> ParenCounterTrans) ->
        Thk ParenCounterTrans ->
        ParenCounterTrans
      )
    ) ->
      fn ll step final ->
        do l <- ! ll;
        match l
        | +Nil() -> ! final
        | +Cons(c, k) ->
          ! step c { ! paren_foldr k step final }
        end
  } that
  def reject : Thk ParenCounterStk = {
    fix (reject : Thk ParenCounterStk) ->
      comatch
      | .none -> ret +False()
      | .some -> ! reject
      end
  } that
  def try_accept : Thk ParenCounterStk = {
    comatch
    | .none -> ret +True()
    | .some -> ! reject
    end
  } that
  def accept_or_not : Thk (ParenCounterState -> ParenCounterStk) = {
    fn s ->
      match s
      | +Ok() -> ! try_accept
      | +Reject() -> ! reject
      end
  } that
  def paren_counter_step : Thk (
    Tok ->
    Thk ParenCounterTrans ->
    ParenCounterTrans
  ) = {
    fn c k state ->
      match c
      | +LParen() -> ! k state .some
      | +RParen() ->
        (comatch
        | .none -> ! k (+Reject() : ParenCounterState) .none
        -- Note: would be more efficient to just ! reject here
        | .some -> ! k state
        end)
      end
  } that
  def demonstrate : Thk (
    String ->
    Bool ->
    Thk (Ret (LList' Tok)) ->
    Thk OS ->
    OS
  ) = {
    fn s expect toks t ->
      do s' <- ! (api/str_append)
        "The following parens are balanced? "
        s;
      do b <- ! paren_foldr
        toks
        paren_counter_step
        accept_or_not
        (+Ok() : ParenCounterState)
        .none;
      do pass <- ! bool_eq expect b;
      match pass
      | +True() ->
        do s <- ! bool_to_str b;
        ! (api/write_line) s' {
          ! (api/write_line) s t
        }
      | +False() ->
        ! (api/write_line) "WRONG ANSWER" { ! (api/exit) 1 }
      end
  } that

  ! demonstrate
    "(())"
    (+True() : Bool)
    {
      ret +Cons(
        +LParen(),
        {
          ret +Cons(
            +LParen(),
            {
              ret +Cons(
                +RParen(),
                {
                  ret +Cons(+RParen(), { ret +Nil() })
                }
              )
            }
          )
        }
      )
    }
    {
      ! demonstrate
        "()()"
        (+True() : Bool)
        {
          ret +Cons(
            +LParen(),
            {
              ret +Cons(
                +RParen(),
                {
                  ret +Cons(
                    +LParen(),
                    {
                      ret +Cons(+RParen(), { ret +Nil() })
                    }
                  )
                }
              )
            }
          )
        }
        {
          ! demonstrate
            ")(()"
            (+False() : Bool)
            {
              ret +Cons(
                +RParen(),
                {
                  ret +Cons(
                    +LParen(),
                    {
                      ret +Cons(
                        +LParen(),
                        {
                          ret +Cons(+RParen(), { ret +Nil() })
                        }
                      )
                    }
                  )
                }
              )
            }
            {
              ! demonstrate
                "()("
                (+False() : Bool)
                {
                  ret +Cons(
                    +LParen(),
                    {
                      ret +Cons(
                        +RParen(),
                        {
                          ret +Cons(+LParen(), { ret +Nil() })
                        }
                      )
                    }
                  )
                }
                {
                  ! demonstrate
                    "()"
                    (+True() : Bool)
                    {
                      ret +Cons(
                        +LParen(),
                        {
                          ret +Cons(+RParen(), { ret +Nil() })
                        }
                      )
                    }
                    {
                      ! demonstrate
                        "("
                        (+False() : Bool)
                        {
                          ret +Cons(+LParen(), { ret +Nil() })
                        }
                        {
                          ! demonstrate
                            ")"
                            (+False() : Bool)
                            {
                              ret +Cons(+RParen(), { ret +Nil() })
                            }
                            {
                              ! demonstrate
                                ""
                                (+True() : Bool)
                                { ret +Nil() }
                                { ! (api/exit) 0 }
                            }
                        }
                    }
                }
            }
        }
    }
end
