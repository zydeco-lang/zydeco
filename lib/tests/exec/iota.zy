begin
  param (
    (/VType; /Thk; /Ret; /Unit; /Int; /String; /OS; /int; /stdio; /process) :
    @[import("../../std/builtin.zy")] _
  ) that
  let U = Thk that
  let F = Ret that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def ! int_lt (x : Int) (y : Int) : Ret Bool =
    ! (int/lt)
      (Ret Bool)
      x
      y
      { ret +True() }
      { ret +False() }
  that
  def ! write_int_line (x : Int) (b : U OS) : OS =
    ! (stdio/write_int) x {
      ! (stdio/write_line) "" b
    }
  that
  def ! panic (msg : String) : OS =
    ! (stdio/write_line) msg {
      ! (process/exit) 1
    }
  that

  def LList' (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * U (F (LList' A))
    end
  that

  def fix iota : Int -> F(LList' Int) =
    fn (i: Int) =>
      do i+1 <- ! (int/add) i 1;
      ret +Cons(i, { ! iota i+1 })
  that

  def fix llist_foldr (ll: U(F(LList' Int))) (f: U(Int -> U OS -> OS)) (b: U OS) : OS =
    do llv <- ! ll;
    match llv
    | +Nil() => ! b
    | +Cons(a, ll) => ! f a { ! llist_foldr ll f b }
    end
  that

  def ! loopy =
    ! llist_foldr
    { ! iota 0 }
    { fn (x: Int) (b: U OS) =>
      do next? <- ! int_lt x 10;
      ! write_int_line x b
    }
    { ! panic "unreachable" }
  that

  (loopy = { ! loopy })
end
