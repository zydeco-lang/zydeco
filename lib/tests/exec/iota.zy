begin
  param (
    (/core; /representations; /numeric; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/VType; /Thk; /Ret; /Unit) = core that
  let (Scalar = Int64, int64) = numeric/int64 that
  let (/Scalar = String) = representations/string that
  let (/OS; /stdio; /process) = system that
  let U = Thk that
  let F = Ret that
  def Bool = data
  | +True : Unit
  | +False : Unit
  end that
  def ! int_lt (x : Int64) (y : Int64) : Ret Bool = ! (int64/lt)
    (Ret Bool)
    x
    y
    { ret +True() }
    {
      ret +False()
    } that
  def ! write_int_line (x : Int64) (b : U OS) : OS = ! (stdio/write_int) x {
    ! (stdio/write_line) "" b
  } that
  def ! panic (msg : String) : OS = ! (stdio/write_line) msg {
    ! (process/exit) 1
  } that

  def LList' (A : VType) : VType = data
  | +Nil : Unit
  | +Cons : A * U (F (LList' A))
  end that

  def fix iota : Int64 -> F (LList' Int64) = fn (i : Int64) =>
    do i+1 <- ! (int64/add) i 1;
    ret +Cons(
      i,
      { ! iota i+1 }
    ) that

  def fix llist_foldr (ll : U (F (LList' Int64))) (f : U (Int64 -> U OS -> OS)) (b : U OS) : OS =
    do llv <- ! ll;
    match llv
    | +Nil() => ! b
    | +Cons(a, ll) => ! f a { ! llist_foldr ll f b }
    end
  that

  def ! loopy = ! llist_foldr
    { ! iota 0 }
    {
      fn (x : Int64) (b : U OS) =>
        do next? <- ! int_lt x 10;
        ! write_int_line x b
    }
    {
      ! panic "unreachable"
    } that

  (loopy = { ! loopy })
end
