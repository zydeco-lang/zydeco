begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (/VType; /CType; /Thk; /Ret; /Int; /String; /OS; /int; /process; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    monadic_basis builtin in
  begin

  def Either (E : VType) (A : VType) =
    data
    | +Left : E
    | +Right : A
    end
  that
  let Exn (E : VType) (A : VType) =
    Ret (Either E A)
  that
  let Top =
    codata
    end
  that
  let ! top : Top =
    comatch
    end
  that

  def ! mo-exn (E : VType) : Monad (Exn E) =
    comatch
    | .return A a =>
      ret +Right(a)
    | .bind A A' m f =>
      do a? <- ! m;
      match a?
      | +Left(e) => ret +Left(e)
      | +Right(a) => ! f a
      end
    end
  that
  def ! alg-exn-os (E : VType) : Algebra (Exn E) OS =
    fn X m f =>
      do a? <- ! m;
      match a?
      | +Left(e) => ! (process/exit) 1
      | +Right(a) => ! f a
      end
  that
  -- test algebra generation for ret and bind
  def ! mo-return (E : VType) (mo : Thk (Monad (Exn E))) : Exn E Int =
    let ! translated =
      -- use mo
      monadic
        do a <- ret 1;
        ret a
      end
    in
    ! translated (Exn E) mo
  that
  -- test algebra generation for thunk
  def ! mo-thunk (E : VType) (mo : Thk (Monad (Exn E))) : Exn E Int =
    let ! translated =
      -- use mo
      monadic
        do _ <- ret 1;
        ! { ret 1 }
      end
    in
    ! translated (Exn E) mo
  that
  -- test algebra generation for thunk at argument position
  def ! mo-thunk-arg (E : VType) (mo : Thk (Monad (Exn E))) : Exn E Int =
    let ! translated =
      -- use mo
      monadic
        do _ <- ret 1;
        (fn (x : Thk _) => ! x) {
          ret 1
        }
      end
    in
    ! translated (Exn E) mo
  that
  -- test algebra generation for forall vtype
  def ! mo-forallv
    (E : VType)
    (mo : Thk (Monad (Exn E)))
    : forall (X : VType) .
    Thk Top ->
    X -> Exn E X =
    let ! translated =
      -- use mo
      monadic
        do _ <- ret -1;
        fn (X : VType) (a : X) =>
          ret a
      end
    in
    ! translated (Exn E) mo
  that
  -- test algebra generation for forall ctype
  def ! mo-forallc
    (E : VType)
    (mo : Thk (Monad (Exn E)))
    : forall (X : CType) .
    Thk (Algebra (Exn E) X) ->
    Thk X ->
    X =
    let ! translated =
      -- ( comatch .bindA X m f => fn (Y: CType) (strY: U (Algebra _ Y)) =>
      --   ( comatch .bindA X m f => fn (a: U Y) =>
      --     ! strY .bindA X m { fn x => ! f x a }
      --   end : Algebra (Exn E) (U Y -> Y)) .bindA X m { fn x => ! f x Y strY }
      -- end : Algebra (Exn E) (forall (X: CType) . U (Algebra (Exn E) X) -> U X -> X))
      -- .bindA Int { ! mo .return Int -1 }
      -- { fn (_: Int) => fn (X: CType) (algX: U (Algebra (Exn E) X)) (b: U X) => ! b }
      -- use mo
      monadic
        do _ <- ret -1;
        fn (X : CType) (b : Thk X) =>
          ! b
      end
    in
    ! translated (Exn E) mo
  that

  -- -- test algebra generation for forall (ctype -> ctype)
  -- alias IdCType (B: CType) : CType = B end
  -- def ! mo-forallcc (E: VType)
  --   (mo: U (Monad (Exn E)))
  -- :
  --   forall (X: CType -> CType) .
  --   U (forall (Y: CType) . U (Algebra (Exn E) Y) -> Algebra (Exn E) (X Y)) ->
  --   (forall (Y: CType) .
  --   U (Algebra (Exn E) Y) -> U (X Y) -> (X Y))
  --   -- forall (X: CType -> CType) .
  --   -- U (forall (Y: CType) . U (Algebra (Exn E) Y) -> Algebra (Exn E) (X Y)) ->
  --   -- (forall (Y: CType) .
  --   -- U (Algebra (Exn E) Y) -> U (X Y) -> (X Y))
  -- =
  --   use mo
  --   monadic
  --     do _ <- ret -1;
  --     -- forall (X: CType -> CType) (Y: CType) . U (X Y) -> X Y
  --     --
  --     -- |> Sig =
  --     --
  --     -- forall (X: CType -> CType) .
  --     --   U (forall (Y: CType) . U (Algebra M Y) -> Algebra M (X Y)) ->
  --     --     forall (Y: CType) . U (Algebra M Y) ->
  --     --       U (X Y) -> X Y
  --     fn (X: CType -> CType) (Y: CType) (b: U (X Y)) => ! b
  --   end
  -- end
  -- -- run it
  -- def ! _mo-forallcc : OS =
  --   ! mo-forallcc String { ! mo-exn String } IdCType OS { ! alg-exn-os String } { ! process/exit 0 }
  -- end
  -- -- using primitive id
  -- def ! mo-prim-id (M: VType -> CType) (mo: U (Monad M)) : forall (A: VType) . A -> M A =
  --   use mo
  --     import id : Thunk (forall (A: VType) . A -> Ret A) = ({
  --       comatch A a =>
  --         do a <- ! id A a;
  --         ! mo .return A a
  --       end
  --     } : Thunk (forall (A: VType) . A -> M A))
  --   monadic
  --     ! id
  --   end
  -- end
  -- -- run it
  -- def ! _mo-prim-id : OS =
  --   do i? <- ! mo-prim-id (Exn String) { ! mo-exn String } Int 0;
  --   match i?
  --   | +Left(e) => ! panic "error"
  --   | +Right(i) => ! process/exit i
  --   end
  -- end
  -- -- using primitive id~
  -- def ! mo-prim-id~ (M: VType -> CType) (mo: U (Monad M)) : forall (B: CType) . Thunk (Algebra M B) -> Thunk B -> B =
  --   use mo
  --     import id~ : Thunk (forall (B: CType) . Thunk B -> B) = ({
  --       comatch B algB b =>
  --         ! id~ B b
  --       end
  --     } : Thunk (forall (B: CType) . Thunk (Algebra M B) -> Thunk B -> B))
  --   monadic
  --     ! id~
  --   end
  -- end
  -- -- run it
  -- def ! _mo-prim-id~ : OS =
  --   ! mo-prim-id~ (Exn String) { ! mo-exn String } OS { ! alg-exn-os String } { ! process/exit 0 }
  -- end
  -- def ! _mo-prim-id~' : OS =
  --   do i <- ! mo-prim-id~ (Exn String) { ! mo-exn String } (Ret Int) { _ } { ret 0 };
  --   ! process/exit i
  -- end
  -- -- primitive ret in contravariant position
  -- def ! dethunk (A: VType) (a : Thunk (Ret A)) : Ret A =
  --   ! a
  -- end
  -- def ! mo-prim-return-contra
  --   (M: VType -> CType) (mo: U (Monad M))
  --   (alg: U (Algebra M _))
  -- : forall (A: VType) . U (M A) -> M A =
  --   with mo with alg
  --     import dethunk : Thunk (forall (A: VType) . Thunk (Ret A) -> Ret A) = ({
  --       comatch A ma =>
  --         ! alg .bindA A ma { fn a => do a <- ! dethunk A { ret a }; ! mo .return A a }
  --       end
  --     } : Thunk (forall (A: VType) . Thunk (M A) -> M A))
  --   monadic
  --     ! dethunk
  --   end
  -- end

  -- run it
  -- ! _mo-forallc
  -- ! _mo-prim-id
  -- ! _mo-prim-id~
  -- ! _mo-prim-id~'
  do returned <- ! mo-return String { ! mo-exn String };
  match returned
  | +Left(_) => ! (process/exit) 1
  | +Right(returned) =>
    ! (int/eq)
      OS
      returned
      1
      {
        do thunked <- ! mo-thunk String { ! mo-exn String };
        match thunked
        | +Left(_) => ! (process/exit) 1
        | +Right(thunked) =>
          ! (int/eq)
            OS
            thunked
            1
            {
              do argument <- ! mo-thunk-arg String {
                ! mo-exn String
              };
              match argument
              | +Left(_) => ! (process/exit) 1
              | +Right(argument) =>
                ! (int/eq)
                  OS
                  argument
                  1
                  {
                    do quantified <- ! mo-forallv
                      String
                      { ! mo-exn String }
                      Int
                      top
                      0;
                    match quantified
                    | +Left(_) => ! (process/exit) 1
                    | +Right(quantified) =>
                      ! (int/eq)
                        OS
                        quantified
                        0
                        {
                          -- run it
                          ! mo-forallc
                            String
                            { ! mo-exn String }
                            OS
                            { ! alg-exn-os String }
                            { ! (process/exit) 0 }
                        }
                        { ! (process/exit) 1 }
                    end
                  }
                  { ! (process/exit) 1 }
              end
            }
            { ! (process/exit) 1 }
        end
      }
      { ! (process/exit) 1 }
  end
end
end
