begin
  param (
    (/VType; /CType; /Ret; /Int; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Stack (A : VType) : CType =
    codata
    | .app : A -> Stack A
    | .return : Ret A
    end
  that
  def fix abort (x : Int) : Stack Int =
    comatch
    | .app _ => ! abort x
    | .return => ret x
    end
  that

  do x <- ! abort 0 .app 1 .app 2 .app 3 .return;
  ! (process/exit) x
end
