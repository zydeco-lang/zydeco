begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    public
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  def fold_lengths : Thk (
    StdList StdString ->
    StdInt ->
    Ret StdInt
  ) = {
    fix (
      fold_lengths :
      Thk (
        StdList StdString ->
        StdInt ->
        Ret StdInt
      )
    ) ->
      fn values accumulated ->
        ! (public/list_eliminate)
          StdString
          (Ret StdInt)
          values
          { ret accumulated }
          {
            fn head tail ->
              do length <- ! (public/str_length) head;
              do next <- ! (public/add) accumulated length;
              ! fold_lengths tail next
          }
  } in
  do nil <- ! (public/nil) StdString;
  do ys <- ! (public/cons) StdString "y" nil;
  do empty_and_ys <- ! (public/cons) StdString "" ys;
  do values <- ! (public/cons) StdString "abc" empty_and_ys;
  do length <- ! fold_lengths values 0;
  do rendered <- ! (public/int_to_str) length;
  ! (public/write_line) rendered { ! (public/exit) 0 }
end
