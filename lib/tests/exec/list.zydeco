begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/Ret; /Int; /String; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/List; /list; /int; /string; /stdio; /process) = make_std builtin in
  def fix foldl (xs : List String) (i : Int) : Ret Int =
    ! (list/case)
      String
      (Ret Int)
      xs
      { ret i }
      {
        fn s xs =>
          do i' <- ! (string/length) s;
          do i' <- ! (int/add) i i';
          ! foldl xs i'
      }
  in
  do nil <- ! (list/nil) String;
  do ys <- ! (list/cons) String "y" nil;
  do empty_and_ys <- ! (list/cons) String "" ys;
  do xs <- ! (list/cons) String "abc" empty_and_ys;
  do l <- ! foldl xs 0;
  do s <- ! (int/to_string) l;
  ! (stdio/write_line) s { fn _ => ! (process/exit) 0 }
end
