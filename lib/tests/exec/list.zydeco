begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (
      /Ret;
      /Int;
      /String;
      builtin
    ) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (
    /List = StdList;
    /Int = StdInt;
    /String = StdString;
    /list;
    /int;
    /string;
    /stdio;
    /process
  ) = make_std builtin in
  def fix foldl (xs : StdList StdString) (i : StdInt) : Ret StdInt =
    ! (list/case)
      StdString
      (Ret StdInt)
      xs
      { ret i }
      {
        fn s xs =>
          do i' <- ! (string/length) s;
          do i' <- ! (int/add) i i';
          ! foldl xs i'
      }
  in
  do nil <- ! (list/nil) StdString;
  do ys <- ! (list/cons) StdString "y" nil;
  do empty_and_ys <- ! (list/cons) StdString "" ys;
  do xs <- ! (list/cons) StdString "abc" empty_and_ys;
  do l <- ! foldl xs 0;
  do s <- ! (int/to_string) l;
  ! (stdio/write_line) s { fn _ => ! (process/exit) 0 }
end
