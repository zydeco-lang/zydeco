begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  def foldl : Thk (
    StdList StdString ->
    StdInt ->
    Ret StdInt
  ) = {
    fix (
      foldl :
      Thk (
        StdList StdString ->
        StdInt ->
        Ret StdInt
      )
    ) ->
      fn xs i ->
        ! (std/list/case)
          StdString
          (Ret StdInt)
          xs
          { ret i }
          {
            fn s xs ->
              do i' <- ! (std/string/length) s;
              do i' <- ! (std/int/add) i i';
              ! foldl xs i'
          }
  } in
  do nil <- ! (std/list/nil) StdString;
  do ys <- ! (std/list/cons) StdString "y" nil;
  do empty_and_ys <- ! (std/list/cons) StdString "" ys;
  do xs <- ! (std/list/cons) StdString "abc" empty_and_ys;
  do l <- ! foldl xs 0;
  do s <- ! (std/int/to_str) l;
  ! (std/os/write_line) s { ! (std/os/exit) 0 }
end
