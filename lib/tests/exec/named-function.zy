-- Arrows do not gain special named-field behavior. Their ordinary value
-- parameter and result types may contain names, and a thunked arrow may occupy
-- a named tuple component.
begin
  param (
    (/core; /numeric; /system) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/Thk; /Ret) = core that
  let (Scalar = Int64, int64) = numeric/int64 that
  let (/process) = system that

  let Arguments =
    (lhs :: Int64) * Int64
  that
  let FunctionResult =
    Int64 * (sum :: Int64)
  that
  let FunctionBox =
    (apply :: Thk (Arguments -> Ret FunctionResult)) * Int64
  that
  def ! combine ((lhs = lhs : Int64, rhs : Int64) : Arguments) : Ret FunctionResult =
    do sum <- ! (int64/add) lhs rhs;
    ret (lhs, sum = sum : Int64)
  that
  def function_box : FunctionBox = (
    apply = combine,
    0
  ) that

  let (
    apply = apply : Thk (Arguments -> Ret FunctionResult),
    marker : Int64
  ) = function_box in
  do result <- ! apply (lhs = 10 : Int64, 11 : Int64);
  let (
    echoed : Int64,
    sum = sum : Int64
  ) = result in
  do echoed_check <- ! (int64/sub) echoed 10;
  do sum_check <- ! (int64/sub) sum 21;
  do total <- ! (int64/add) marker echoed_check;
  do total <- ! (int64/add) total sum_check;
  ! (process/exit) total
end
