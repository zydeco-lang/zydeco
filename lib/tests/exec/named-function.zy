-- Arrows do not gain special named-field behavior. Their ordinary value
-- parameter and result types may contain names, and a thunked arrow may occupy
-- a named tuple component.
begin
  param (
    (/Thk; /Ret; /Int; /add; /sub; /exit) :
    @[import("../../std/builtin.zy")] _
  ) that

  let Arguments =
    (lhs :: Int) * Int
  that
  let FunctionResult =
    Int * (sum :: Int)
  that
  let FunctionBox =
    (apply :: Thk (Arguments -> Ret FunctionResult)) * Int
  that
  def ! combine ((lhs = lhs : Int, rhs : Int) : Arguments) : Ret FunctionResult =
    do sum <- ! (add) lhs rhs;
    ret (lhs, sum = sum : Int)
  that
  def function_box : FunctionBox = (
    apply = combine,
    0
  ) that

  let (
    apply = apply : Thk (Arguments -> Ret FunctionResult),
    marker : Int
  ) = function_box in
  do result <- ! apply (lhs = 10 : Int, 11 : Int);
  let (
    echoed : Int,
    sum = sum : Int
  ) = result in
  do echoed_check <- ! (sub) echoed 10;
  do sum_check <- ! (sub) sum 21;
  do total <- ! (add) marker echoed_check;
  do total <- ! (add) total sum_check;
  ! (exit) total
end
