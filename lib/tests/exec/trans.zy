begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  def Option (A : VType) =
    data
    | +None : Unit
    | +Some : A
    end
  that
  def MonadTrans'' (T : (((VType) -> (CType)) -> (VType) -> (CType))) =
    codata
    | .lift :
      forall (
        M :
        (VType) ->
        (CType)
      ) .
      forall (A : VType) .
        Thk (Monad M) ->
        Thk (M A) ->
        T M A
    end
  that
  def ReaderT (R : VType) (M : (VType) -> (CType)) (A : VType) =
    codata
    | .run : R -> M A
    end
  that
  def OptionT (M : (VType) -> (CType)) (A : VType) =
    codata
    | .run : M (Option A)
    end
  that
  def KOptionT (M : (VType) -> (CType)) (A : VType) =
    codata
    | .run :
      forall (R : CType) .
        Thk (Algebra M R) ->
        Thk (A -> R) ->
        Thk R ->
        R
    end
  that

  def reader_t_monad : Thk (
    forall (R : VType) .
    forall (
      M :
      (VType) -> (CType)
    ) .
      Thk (Monad M) ->
      Monad (ReaderT R M)
  ) = {
    fn R M mo ->
      comatch
      | .return A a ->
        -- goal: ReaderT R M A
        comatch
        | .run _ -> ! mo .return A a
        end
      | .bind A A' m f -> -- m: U (ReaderT R M A), f: U (A -> ReaderT R M A')
        -- goal: ReaderT R M A'
        comatch
        | .run r ->
          ! mo .bind A A'
            { ! m .run r }
            {
              fn a ->
                ! f a .run r
            }
        end
      end
  } that
  def reader_t_trans : Thk (
    forall (R : VType) .
      MonadTrans'' (ReaderT R)
  ) = {
    fn R ->
      comatch
      | .lift M A mo m ->
        -- goal: ReaderT R M A
        comatch
        | .run _ -> ! m
        -- basically ignoring the reader input
        end
      end
  } that
  def option_t_monad : Thk (
    forall (
      M :
      (VType) -> (CType)
    ) .
      Thk (Monad M) ->
      Monad (OptionT M)
  ) = {
    fn M mo ->
      comatch
      | .return A a ->
        -- goal: OptionT M A
        comatch
        | .run -> ! mo .return (Option A) +Some(a)
        end
      | .bind A A' m f -> -- m: U (OptionT M A), f: U (A -> OptionT M A')
        -- goal: OptionT M A'
        comatch
        | .run ->
          ! mo .bind
            (Option A)
            (Option A')
            { ! m .run }
            {
              fn a? ->
                match a?
                | +Some(a) -> ! f a .run
                | +None() -> ! mo .return (Option A') +None()
                end
            }
        end
      end
  } that
  def option_t_trans : Thk (MonadTrans'' OptionT) = {
    comatch
    | .lift M A mo m ->
      comatch
      | .run ->
        ! mo .bind A (Option A) m {
          fn a ->
            ! mo .return (Option A) +Some(a)
        }
      end
    end
  } that
  def koption_t_trans : Thk (MonadTrans'' KOptionT) = {
    comatch
    | .lift M A mo m -> -- m : U(M A)
      comatch
      | .run R bAlg kS kE -> -- kS : U(A -> R), bAlg : Algebra M B
        ! bAlg A m kS
      end
    end
  } that
  def koption_t_monad : Thk (
    forall (
      M :
      (VType) -> (CType)
    ) .
      Thk (Monad M) ->
      Monad (KOptionT M)
  ) = {
    fn M monadM ->
      comatch
      | .return A a ->
        comatch
        | .run R bAlg kS kE ->
          ! kS a
        end
      | .bind A A' m k -> -- m : U(KOptT M A), k : U(A -> KOptT M A'), goal: KOptT M A'
        comatch
        | .run R bAlg kS kE -> -- kS : U(A' -> R), kE: U R, bAlg: Algebra M R, goal: R
          ! m .run
            R
            bAlg
            {
              fn a ->
                ! k a .run R bAlg kS kE
            }
            kE
        end
      end
  } that

  ! (api/exit) 0
end
end
