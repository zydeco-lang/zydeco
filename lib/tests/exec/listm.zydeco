begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def List~ (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * Thk (Ret (List~ A))
    end
  that
  def fix foldr~
    (A : VType)
    (B : CType)
    (ll : Thk (Ret (List~ A)))
    (f : Thk (A -> Thk B -> B))
    (b : Thk B)
    : B =
    do llv <- ! ll;
    match llv
    | +Nil() -> ! b
    | +Cons(a, ll) ->
      ! f a { ! foldr~ A B ll f b }
    end
  that

  let (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) = std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
  -- List~ is actually coinductive type
  def fix loop : Ret (List~ StdInt) =
    ret +Cons(0, loop)
  in
  -- Since it's coinductive, here's iota
  def fix iota (i : StdInt) : Ret (List~ StdInt) =
    do i+1 <- ! (std/int/add) i 1;
    ret +Cons(i, { ! iota i+1 })
  in

  -- foldr~ and an example of summing up the list and exiting with the sum
  let ! loopy : StdOS =
    ! foldr~
      StdInt
      StdOS
      { ! iota 0 }
      {
        fn x b ->
          do next? <- ! (std/int/lt) x 10;
          ! (std/bool/if)
            StdOS
            next?
            {
              ! (std/os/write_int) x {
                ! (std/os/write_line) "" b
              }
            }
            { ! (std/os/exit) 0 }
      }
      { ! (std/os/exit) 1 }
  in

  ! loopy
end
