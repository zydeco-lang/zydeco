begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/core; /representations; /system; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/VType; /CType; /Thk; /Ret; /Unit) = core that
  let (/Scalar = Int64) = representations/i64 that
  let (/OS) = system that
  def List~ (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * Thk (Ret (List~ A))
    end
  that
  def fix foldr~
    (A : VType)
    (B : CType)
    (ll : Thk (Ret (List~ A)))
    (f : Thk (A -> Thk B -> B))
    (b : Thk B)
    : B =
    do llv <- ! ll;
    match llv
    | +Nil() => ! b
    | +Cons(a, ll) =>
      ! f a { ! foldr~ A B ll f b }
    end
  that

  let (/bool; /int64; /stdio; /process) = make_std builtin in
  -- List~ is actually coinductive type
  def fix loop : Ret (List~ Int64) =
    ret +Cons(0, loop)
  in
  -- Since it's coinductive, here's iota
  def fix iota (i : Int64) : Ret (List~ Int64) =
    do i+1 <- ! (int64/add) i 1;
    ret +Cons(i, { ! iota i+1 })
  in

  -- foldr~ and an example of summing up the list and exiting with the sum
  let ! loopy : OS =
    ! foldr~
      Int64
      OS
      { ! iota 0 }
      {
        fn x b =>
          do next? <- ! (int64/lt) x 10;
          ! (bool/if)
            OS
            next?
            {
              do rendered <- ! (int64/to_string) x;
              ! (stdio/write_line) rendered { fn _ => ! b }
            }
            { ! (process/exit) 0 }
      }
      { ! (process/exit) 1 }
  in

  ! loopy
end
