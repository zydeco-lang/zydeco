-- `= field` expands to `field = field` without introducing a downstream
-- syntax form. The inferred payload is resolved according to its context.
alias Slot (pun_value : VType) : VType =
  (pun_value :: pun_value)
end

alias UpperSlot (PunValue : VType) : VType =
  (PunValue :: PunValue)
end

alias PunPair =
  (pun_x :: Int) * (pun_y :: Int)
end

alias Wrapped =
  (outer :: (pun_inner :: Int))
end

def pun_value : Int = 4 end
def slot : Slot Int = (= pun_value) end

def PunValue : Int = 5 end
def upper_slot : UpperSlot Int = (= PunValue) end

def pun_x : Int = 10 end
def pun_y : Int = 11 end
def pun_pair : PunPair = (
  = pun_x : Int,
  = pun_y : Int
) end

def pun_inner : Int = 12 end
def wrapped : Wrapped = (
  outer = (= pun_inner)
) end

main
  let (= pun_value : Int) = slot in
  let (= PunValue : Int) = upper_slot in
  let (
    = pun_x : Int,
    = pun_y : Int
  ) = pun_pair in
  let (
    outer = (= pun_inner : Int)
  ) = wrapped in

  do value_check <- ! sub pun_value 4;
  do upper_value_check <- ! sub PunValue 5;
  do upper_projection_check <- ! sub upper_slot/PunValue 5;
  do x_check <- ! sub pun_x 10;
  do y_check <- ! sub pun_y 11;
  do inner_check <- ! sub pun_inner 12;

  do total <- ! add value_check x_check;
  do total <- ! add total upper_value_check;
  do total <- ! add total upper_projection_check;
  do total <- ! add total y_check;
  do total <- ! add total inner_check;
  ! exit total
end
