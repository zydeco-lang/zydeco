-- `= field` expands to `field = field` without introducing a downstream
-- syntax form. The inferred payload is resolved according to its context.
begin
  param (
    (/core; /numeric; /system) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/VType) = core that
  let (Scalar = Int64, int64) = numeric/int64 that
  let (/process) = system that

  let Slot (pun_value : VType) =
    (pun_value :: pun_value)
  that
  let UpperSlot (PunValue : VType) =
    (PunValue :: PunValue)
  that
  let PunPair =
    (pun_x :: Int64) * (pun_y :: Int64)
  that
  let Wrapped =
    (outer :: (pun_inner :: Int64))
  that
  def pun_value : Int64 = 4 that
  def slot : Slot Int64 = (= pun_value) that
  def PunValue : Int64 = 5 that
  def upper_slot : UpperSlot Int64 = (= PunValue) that
  def pun_x : Int64 = 10 that
  def pun_y : Int64 = 11 that
  def pun_pair : PunPair = (
    = pun_x : Int64,
    = pun_y : Int64
  ) that
  def pun_inner : Int64 = 12 that
  def wrapped : Wrapped = (
    outer = (= pun_inner)
  ) that

  let (= pun_value : Int64) = slot in
  let (= PunValue : Int64) = upper_slot in
  let (
    = pun_x : Int64,
    = pun_y : Int64
  ) = pun_pair in
  let (
    outer = (= pun_inner : Int64)
  ) = wrapped in
  do value_check <- ! (int64/sub) pun_value 4;
  do upper_value_check <- ! (int64/sub) PunValue 5;
  do upper_projection_check <- ! (int64/sub) upper_slot/PunValue 5;
  do x_check <- ! (int64/sub) pun_x 10;
  do y_check <- ! (int64/sub) pun_y 11;
  do inner_check <- ! (int64/sub) pun_inner 12;
  do total <- ! (int64/add) value_check x_check;
  do total <- ! (int64/add) total upper_value_check;
  do total <- ! (int64/add) total upper_projection_check;
  do total <- ! (int64/add) total y_check;
  do total <- ! (int64/add) total inner_check;
  ! (process/exit) total
end
