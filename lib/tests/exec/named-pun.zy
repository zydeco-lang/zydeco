-- `= field` expands to `field = field` without introducing a downstream
-- syntax form. The inferred payload is resolved according to its context.
begin
  param (
    (/VType; /Int; /int; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  let Slot (pun_value : VType) =
    (pun_value :: pun_value)
  that
  let UpperSlot (PunValue : VType) =
    (PunValue :: PunValue)
  that
  let PunPair =
    (pun_x :: Int) * (pun_y :: Int)
  that
  let Wrapped =
    (outer :: (pun_inner :: Int))
  that
  def pun_value : Int = 4 that
  def slot : Slot Int = (= pun_value) that
  def PunValue : Int = 5 that
  def upper_slot : UpperSlot Int = (= PunValue) that
  def pun_x : Int = 10 that
  def pun_y : Int = 11 that
  def pun_pair : PunPair = (
    = pun_x : Int,
    = pun_y : Int
  ) that
  def pun_inner : Int = 12 that
  def wrapped : Wrapped = (
    outer = (= pun_inner)
  ) that

  let (= pun_value : Int) = slot in
  let (= PunValue : Int) = upper_slot in
  let (
    = pun_x : Int,
    = pun_y : Int
  ) = pun_pair in
  let (
    outer = (= pun_inner : Int)
  ) = wrapped in
  do value_check <- ! (int/sub) pun_value 4;
  do upper_value_check <- ! (int/sub) PunValue 5;
  do upper_projection_check <- ! (int/sub) upper_slot/PunValue 5;
  do x_check <- ! (int/sub) pun_x 10;
  do y_check <- ! (int/sub) pun_y 11;
  do inner_check <- ! (int/sub) pun_inner 12;
  do total <- ! (int/add) value_check x_check;
  do total <- ! (int/add) total upper_value_check;
  do total <- ! (int/add) total upper_projection_check;
  do total <- ! (int/add) total y_check;
  do total <- ! (int/add) total inner_check;
  ! (process/exit) total
end
