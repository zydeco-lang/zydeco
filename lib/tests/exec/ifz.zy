begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  let Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def suc : Thk (Nat -> Ret Nat) = {
    fn (x : Nat) ->
      ret +S(x)
  } that
  def ifz : Thk (
    Bool ->
    Thk (Nat -> Ret Bool) ->
    Nat ->
    Ret Bool
  ) = {
    fn (z : Bool)
       (pred : Thk (Nat -> Ret Bool))
       (x : Nat) ->
      match x
      | +Z() -> ret z
      | +S(x) -> ! pred x
      end
  } that
  def ifz' : Thk (Nat -> Ret Bool) = {
    fn (x : Nat) ->
      ! ifz
        +False()
        { fn (_ : Nat) -> ret +True() }
        x
  } that

  let zero : Nat = +Z() in
  do one <- ! suc zero;
  do two <- ! suc one;
  do two' <- ! ifz' two;
  do one' <- ! ifz' one;
  do zero' <- ! ifz' zero;
  do b <- (
    match two'
    | +True() ->
      match one'
      | +True() ->
        match zero'
        | +False() -> ret +True()
        | +True() -> ret +False()
        end
      | +False() -> ret +False()
      end
    | +False() -> ret +False()
    end
    : Ret Bool
  );
  match b
  | +True() -> ! (api/exit) 0
  | +False() -> ! (api/exit) 1
  end
end
