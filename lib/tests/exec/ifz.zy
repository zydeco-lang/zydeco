begin
  param (
    (/core; /system) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/VType; /Thk; /Ret; /Unit) = core that
  let (/process) = system that

  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def ! suc (x : Nat) : Ret Nat =
    ret +S(x)
  that
  def ! ifz (z : Bool) (pred : Thk (Nat -> Ret Bool)) (x : Nat) : Ret Bool =
    match x
    | +Z() => ret z
    | +S(x) => ! pred x
    end
  that
  def ! ifz' (x : Nat) : Ret Bool =
    ! ifz
      +False()
      { fn (_ : Nat) => ret +True() }
      x
  that

  let zero : Nat = +Z() in
  do one <- ! suc zero;
  do two <- ! suc one;
  do two' <- ! ifz' two;
  do one' <- ! ifz' one;
  do zero' <- ! ifz' zero;
  do b <- (
    match two'
    | +True() =>
      match one'
      | +True() =>
        match zero'
        | +False() => ret +True()
        | +True() => ret +False()
        end
      | +False() => ret +False()
      end
    | +False() => ret +False()
    end
    : Ret Bool
  );
  match b
  | +True() => ! (process/exit) 0
  | +False() => ! (process/exit) 1
  end
end
