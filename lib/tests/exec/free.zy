begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
  begin

  let Kont (R : CType) (A : VType) =
    Thk (A -> R) -> R
  that
  let Free (H : (CType) -> (VType)) (A : VType) =
    forall (R : CType) .
      H R -> Kont R A
  that

  def ! mkont (R : CType) : Monad (Kont R) =
    comatch
    | .return A a ->
      fn k ->
        ! k a
    | .bind A A' m f ->
      fn k ->
        ! m {
          fn a ->
            ! f a k
        }
    end
  that
  def ! mfree
    (
      H :
      (CType) -> (VType)
    )
    : Monad (Free H) =
    comatch
    | .return A a ->
      fn R h ->
        ! mkont R .return A a
    | .bind A A' m f ->
      fn R h ->
        ! mkont R .bind A A'
          { ! m R h }
          {
            fn a ->
              ! f a R h
          }
    end
  that

  ! (api/exit) 0
end
end
