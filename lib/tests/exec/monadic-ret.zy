begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (/Ret; /process; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    monadic_basis builtin in
  begin

  def ! ret_monad : Monad Ret =
    comatch
    | .return A value => ret value
    | .bind A B computation continuation =>
      do value <- ! computation;
      ! continuation value
    end
  that
  def ! translated =
    @[monadic] begin
      ret ()
    end
  that

  do _ <- ! translated Ret { ! ret_monad };
  ! (process/exit) 0
end
end
