begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
  begin

  def ! ret_monad : Monad Ret =
    comatch
    | .return A value -> ret value
    | .bind A B computation continuation ->
      do value <- ! computation;
      ! continuation value
    end
  that
  def ! translated =
    monadic
      ret ()
    end
  that

  do _ <- ! translated Ret { ! ret_monad };
  ! (api/exit) 0
end
end
