begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let RetPrime =
    begin
      param (A : VType) that
      forall (R : CType) .
        Thk (A -> R) -> R
    end
  that
  def to_ret : Thk (
    forall (A : VType) .
      Thk (RetPrime A) -> Ret A
  ) = {
    fn (A : VType) (encoded : Thk (RetPrime A)) ->
      ! encoded (Ret A) { fn (value : A) -> ret value }
  } that
  def from_ret : Thk (
    forall (A : VType) .
      Thk (Ret A) -> RetPrime A
  ) = {
    fn (A : VType)
       (computation : Thk (Ret A))
       (R : CType)
       (continuation : Thk (A -> R)) ->
      do value <- ! computation;
      ! continuation value
  } that
  def identity_ret : Thk (
    forall (A : VType) .
      Thk (Ret A) -> Ret A
  ) = {
    fn (A : VType) (computation : Thk (Ret A)) ->
      ! to_ret A { ! from_ret A computation }
  } that
  def identity_ret_prime : Thk (
    forall (A : VType) .
      Thk (RetPrime A) -> RetPrime A
  ) = {
    fn (A : VType) (encoded : Thk (RetPrime A)) ->
      ! from_ret A { ! to_ret A encoded }
  } that

  do status <- ! identity_ret Int { ret 0 };
  ! identity_ret_prime
    Int
    { fn (R : CType) continuation -> ! continuation status }
    OS
    (api/exit)
end
