-- An example that uses forall and type aliases to prove that
-- `Ret' A` and the `Ret A` primitive are isomorphic to each other.
begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let Ret' (A : VType) =
    forall (R : CType) .
      Thk (A -> R) -> R
  that
  def f : Thk (
    forall (A : VType) .
      Thk (Ret' A) -> Ret A
  ) = {
    fn (A : VType) (rr : Thk (Ret' A)) ->
      ! rr (Ret A) { fn (a : A) -> ret a }
  } that
  def g : Thk (
    forall (A : VType) .
      Thk (Ret A) -> Ret' A
  ) = {
    fn (A : VType)
       (r : Thk (Ret A))
       (R : CType)
       (ar : Thk (A -> R)) ->
      do a <- ! r;
      ! ar a
  } that
  def id_ret : Thk (
    forall (A : VType) .
      Thk (Ret A) -> Ret A
  ) = {
    fn (A : VType) (r : Thk (Ret A)) ->
      ! f A { ! g A r }
  } that
  def id_ret' : Thk (
    forall (A : VType) .
      Thk (Ret' A) -> Ret' A
  ) = {
    fn (A : VType) (rr : Thk (Ret' A)) ->
      ! g A { ! f A rr }
  } that

  do n <- ! id_ret Int { ret 0 };
  ! id_ret'
    Int
    { fn (R : CType) ar -> ! ar n }
    OS
    (api/exit)
end
