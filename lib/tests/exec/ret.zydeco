-- An example that uses forall and type aliases to prove that
-- `Ret' A` and the `Ret A` primitive are isomorphic to each other.
begin
  param (/core; /representations; /system) : @(import("../../std/builtin.zy")) that
  let (/VType; /CType; /Thk; /Ret) = core that
  let (/Int64) = representations/i64 that
  let (/OS; /process) = system that

  let Ret' (A : VType) =
    forall (R : CType) .
      Thk (A -> R) -> R
  that
  def ! f (A : VType) (rr : Thk (Ret' A)) : Ret A =
    ! rr (Ret A) { fn (a : A) => ret a }
  that
  def ! g (A : VType) (r : Thk (Ret A)) : Ret' A =
    fn
      (R : CType)
      (ar : Thk (A -> R))
    =>
      do a <- ! r;
      ! ar a
  that
  def ! id_ret (A : VType) (r : Thk (Ret A)) : Ret A =
    ! f A { ! g A r }
  that
  def ! id_ret' (A : VType) (rr : Thk (Ret' A)) : Ret' A =
    ! g A { ! f A rr }
  that

  do n <- ! id_ret Int64 { ret 0 };
  ! id_ret'
    Int64
    { fn (R : CType) ar => ! ar n }
    OS
    process/exit
end
