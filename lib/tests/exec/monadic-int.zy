begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (/Ret; /OS; /int; /process; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    monadic_basis builtin in
  begin

  def ! ret_monad : Monad Ret =
    comatch
    | .return A value => ret value
    | .bind A B computation function =>
      do value <- ! computation;
      ! function value
    end
  that
  def ! translated =
    monadic
      do value <- ret 1;
      ret value
    end
  that

  do value <- ! translated Ret { ! ret_monad };
  ! (int/eq)
    OS
    value
    1
    { ! (process/exit) 0 }
    { ! (process/exit) 1 }
end
end
