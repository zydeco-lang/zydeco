begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (/VType; /CType; /Thk; /Ret; /Unit; /Int; /OS; /int; /stdio; /process; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    monadic_basis builtin in
  begin

  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def Pair (A : VType) (A' : VType) =
    data
    | +Cons : A * A'
    end
  that
  def List (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * List A
    end
  that
  def Monoid (M : (VType) -> (CType)) =
    codata
    | .empty :
      forall (A : VType) .
        M A
    | .append :
      forall (A : VType) .
        Thk (M A) ->
        Thk (M A) ->
        M A
    end
  that
  -- codata Monad (M: VType -> CType) where
  --   | .return : forall (A: VType) . A -> M A
  --   | .bind : forall (A: VType) (A': VType) . U (M A) -> U (A -> M A') -> M A'
  -- end
  def MList (A : VType) =
    codata
    | .done : Ret (List A)
    -- | .run : forall (R: CType) . U (U R -> A -> R) -> U R -> R
    end
  that

  def ! int_eq (left : Int) (right : Int) : Ret Bool =
    ! (int/eq)
      (Ret Bool)
      left
      right
      { ret +True() }
      { ret +False() }
  that
  def ! mnlist : Monoid MList =
    comatch
    | .empty A =>
      fn .done =>
        ret +Nil()
    | .append A m1 m2 =>
      fn .done =>
        do xs <- ! m1 .done;
        do ys <- ! m2 .done;
        let fix loop (xs : List A) : Ret (List A) =
          match xs
          | +Nil() => ret ys
          | +Cons(x, xs) =>
            do ys <- ! loop xs;
            ret +Cons(x, ys)
          end
        in
        ! loop xs
    end
  that
  def ! mlist : Monad MList =
    comatch
    | .return A a =>
      fn .done =>
        ret +Cons(a, +Nil())
    | .bind A A' m f =>
      do xs <- ! m .done;
      let fix loop (xs : List A) (g : Thk (Thk (MList A') -> MList A')) : MList A' =
        match xs
        | +Nil() =>
          ! g { ! mnlist .empty A' }
        | +Cons(x, xs) =>
          ! loop xs {
            fn ys =>
              ! g {
                ! mnlist .append A'
                  { ! f x }
                  ys
              }
          }
        end
      in
      ! loop xs {
        fn ys =>
          ! ys
      }
    end
  that
  def ! choose (xs : List Int) : MList Int =
    fn .done =>
      ret xs
  that
  def ! guard (b : Bool) : MList Unit =
    match b
    | +True() => ! mlist .return Unit ()
    | +False() => ! mnlist .empty Unit
    end
  that

  let ! demo : MList (Pair Int Int) =
    ! mlist .bind Int (Pair Int Int)
      { ! choose +Cons(1, +Cons(2, +Nil())) }
      {
        fn x =>
          ! mlist .bind Int (Pair Int Int)
            { ! choose +Cons(3, +Cons(4, +Nil())) }
            {
              fn y =>
                ! mlist .bind Unit (Pair Int Int)
                  {
                    do r <- ! (int/add) x y;
                    do b <- ! int_eq r 5;
                    ! guard b
                  }
                  {
                    fn _ =>
                      ! mlist .return
                        (Pair Int Int)
                        +Cons(x, y)
                  }
            }
      }
  in
  do ps <- ! demo .done;
  let fix print (ps : List (Pair Int Int)) (kont : Thk OS) : OS =
    match ps
    | +Nil() => ! kont
    | +Cons(p, ps) =>
      match p
      | +Cons(x, y) =>
        ! (stdio/write_int) x {
          ! (stdio/write) " + " {
            ! (stdio/write_int) y {
              ! (stdio/write_line) "" {
                ! print ps kont
              }
            }
          }
        }
      end
    end
  in
  ! print ps { ! (process/exit) 0 }
end
end
