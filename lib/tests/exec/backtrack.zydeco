begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  def Bool : VType =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def Pair :
    (VType) ->
    (VType) ->
    (VType) =
    begin
      param (A : VType) that
      param (B : VType) that
      data
      | +Pair : A * B
      end
    end
  that
  def List : (VType) -> (VType) =
    begin
      param (A : VType) that
      data
      | +Nil : Unit
      | +Cons : A * List A
      end
    end
  that
  def Monoid :
    (
      (
        (VType) ->
        (CType)
      ) ->
      (CType)
    ) =
    begin
      param (
        M :
        (VType) ->
        (CType)
      ) that
      codata
      | .empty :
        forall (A : VType) .
          M A
      | .append :
        forall (A : VType) .
          Thk (M A) ->
          Thk (M A) ->
          M A
      end
    end
  that
  def MList :
    (VType) ->
    (CType) =
    begin
      param (A : VType) that
      codata
      | .done : Ret (List A)
      end
    end
  that

  def int_eq : Thk (Int -> Int -> Ret Bool) = {
    fn left right ->
      ! (api/int_eq_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def list_monoid : Thk (Monoid MList) = {
    comatch
    | .empty A ->
      fn .done ->
        ret +Nil()
    | .append A left right ->
      fn .done ->
        do left <- ! left .done;
        do right <- ! right .done;
        let append : Thk (List A -> Ret (List A)) = {
          fix (append : Thk (List A -> Ret (List A))) ->
            fn values ->
              match values
              | +Nil() -> ret right
              | +Cons(head, tail) ->
                do tail <- ! append tail;
                ret +Cons(head, tail)
              end
        } in
        ! append left
    end
  } that
  def list_monad : Thk (Monad MList) = {
    comatch
    | .return A value ->
      fn .done ->
        ret +Cons(value, +Nil())
    | .bind A B computation function ->
      do values <- ! computation .done;
      let loop : Thk (
        List A ->
        Thk (Thk (MList B) -> MList B) ->
        MList B
      ) = {
        fix (
          loop :
          Thk (
            List A ->
            Thk (Thk (MList B) -> MList B) ->
            MList B
          )
        ) ->
          fn values continuation ->
            match values
            | +Nil() ->
              ! continuation { ! list_monoid .empty B }
            | +Cons(head, tail) ->
              ! loop tail {
                fn accumulated ->
                  ! continuation {
                    ! list_monoid .append B
                      { ! function head }
                      accumulated
                  }
              }
            end
      } in
      ! loop values {
        fn result ->
          ! result
      }
    end
  } that
  def choose : Thk (List Int -> MList Int) = {
    fn values ->
      fn .done ->
        ret values
  } that
  def guard : Thk (Bool -> MList Unit) = {
    fn condition ->
      match condition
      | +True() -> ! list_monad .return Unit ()
      | +False() -> ! list_monoid .empty Unit
      end
  } that

  let demo : Thk (MList (Pair Int Int)) = {
    ! list_monad .bind Int (Pair Int Int)
      { ! choose +Cons(1, +Cons(2, +Nil())) }
      {
        fn left ->
          ! list_monad .bind Int (Pair Int Int)
            { ! choose +Cons(3, +Cons(4, +Nil())) }
            {
              fn right ->
                ! list_monad .bind Unit (Pair Int Int)
                  {
                    do sum <- ! (api/add) left right;
                    do equal <- ! int_eq sum 5;
                    ! guard equal
                  }
                  {
                    fn _ ->
                      ! list_monad .return
                        (Pair Int Int)
                        +Pair(left, right)
                  }
            }
      }
  } in
  do pairs <- ! demo .done;
  let print : Thk (List (Pair Int Int) -> Thk OS -> OS) = {
    fix (
      print :
      Thk (List (Pair Int Int) -> Thk OS -> OS)
    ) ->
      fn pairs continuation ->
        match pairs
        | +Nil() -> ! continuation
        | +Cons(pair, tail) ->
          match pair
          | +Pair(left, right) ->
            ! (api/write_int) left {
              ! (api/write_str) " + " {
                ! (api/write_int) right {
                  ! (api/write_line) "" {
                    ! print tail continuation
                  }
                }
              }
            }
          end
        end
  } in
  ! print pairs { ! (api/exit) 0 }
end
end
