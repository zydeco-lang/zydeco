begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def Pair (A : VType) (A' : VType) =
    data
    | +Cons : A * A'
    end
  that
  def List (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * List A
    end
  that
  def Monoid (M : (VType) -> (CType)) =
    codata
    | .empty :
      forall (A : VType) .
        M A
    | .append :
      forall (A : VType) .
        Thk (M A) ->
        Thk (M A) ->
        M A
    end
  that
  -- codata Monad (M: VType -> CType) where
  --   | .return : forall (A: VType) . A -> M A
  --   | .bind : forall (A: VType) (A': VType) . U (M A) -> U (A -> M A') -> M A'
  -- end
  def MList (A : VType) =
    codata
    | .done : Ret (List A)
    -- | .run : forall (R: CType) . U (U R -> A -> R) -> U R -> R
    end
  that

  def int_eq : Thk (Int -> Int -> Ret Bool) = {
    fn left right ->
      ! (api/int_eq_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def mnlist : Thk (Monoid MList) = {
    comatch
    | .empty A ->
      fn .done ->
        ret +Nil()
    | .append A m1 m2 ->
      fn .done ->
        do xs <- ! m1 .done;
        do ys <- ! m2 .done;
        let loop : Thk (List A -> Ret (List A)) = {
          fix (loop : Thk (List A -> Ret (List A))) ->
            fn xs ->
              match xs
              | +Nil() -> ret ys
              | +Cons(x, xs) ->
                do ys <- ! loop xs;
                ret +Cons(x, ys)
              end
        } in
        ! loop xs
    end
  } that
  def mlist : Thk (Monad MList) = {
    comatch
    | .return A a ->
      fn .done ->
        ret +Cons(a, +Nil())
    | .bind A A' m f ->
      do xs <- ! m .done;
      let loop : Thk (
        List A ->
        Thk (Thk (MList A') -> MList A') ->
        MList A'
      ) = {
        fix (
          loop :
          Thk (
            List A ->
            Thk (Thk (MList A') -> MList A') ->
            MList A'
          )
        ) ->
          fn xs g ->
            match xs
            | +Nil() ->
              ! g { ! mnlist .empty A' }
            | +Cons(x, xs) ->
              ! loop xs {
                fn ys ->
                  ! g {
                    ! mnlist .append A'
                      { ! f x }
                      ys
                  }
              }
            end
      } in
      ! loop xs {
        fn ys ->
          ! ys
      }
    end
  } that
  def choose : Thk (List Int -> MList Int) = {
    fn xs ->
      fn .done ->
        ret xs
  } that
  def guard : Thk (Bool -> MList Unit) = {
    fn b ->
      match b
      | +True() -> ! mlist .return Unit ()
      | +False() -> ! mnlist .empty Unit
      end
  } that

  let demo : Thk (MList (Pair Int Int)) = {
    ! mlist .bind Int (Pair Int Int)
      { ! choose +Cons(1, +Cons(2, +Nil())) }
      {
        fn x ->
          ! mlist .bind Int (Pair Int Int)
            { ! choose +Cons(3, +Cons(4, +Nil())) }
            {
              fn y ->
                ! mlist .bind Unit (Pair Int Int)
                  {
                    do r <- ! (api/add) x y;
                    do b <- ! int_eq r 5;
                    ! guard b
                  }
                  {
                    fn _ ->
                      ! mlist .return
                        (Pair Int Int)
                        +Cons(x, y)
                  }
            }
      }
  } in
  do ps <- ! demo .done;
  let print : Thk (List (Pair Int Int) -> Thk OS -> OS) = {
    fix (
      print :
      Thk (List (Pair Int Int) -> Thk OS -> OS)
    ) ->
      fn ps kont ->
        match ps
        | +Nil() -> ! kont
        | +Cons(p, ps) ->
          match p
          | +Cons(x, y) ->
            ! (api/write_int) x {
              ! (api/write_str) " + " {
                ! (api/write_int) y {
                  ! (api/write_line) "" {
                    ! print ps kont
                  }
                }
              }
            }
          end
        end
  } in
  ! print ps { ! (api/exit) 0 }
end
end
