begin
  let U = Thk that
  let F = Ret that
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin
  let Ret = F that
  let add = api/add that
  let mul = api/mul that
  let str_length = api/str_length that
  let str_append = api/str_append that
  let str_index = api/str_index that
  let int_to_str = api/int_to_str that
  let char_to_str = api/char_to_str that
  let char_to_int = api/char_to_int that
  let write_str = api/write_str that
  let write_line = api/write_line that
  let read_line = api/read_line that
  let exit = api/exit that

  let Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  let Option (A : VType) =
    data
    | +None : Unit
    | +Some : A
    end
  that
  def List (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * List A
    end
  that
  let Pair (A : VType) (A' : VType) =
    data
    | +Cons : A * A'
    end
  that

  def if : U (
    forall (B : CType) .
      Bool -> U B -> U B -> B
  ) = {
    fn B condition consequent alternative ->
      match condition
      | +True() -> ! consequent
      | +False() -> ! alternative
      end
  } that
  def if~ : U (
    forall (B : CType) .
      U (Ret Bool) -> U B -> U B -> B
  ) = {
    fn B condition consequent alternative ->
      do condition <- ! condition;
      ! if B condition consequent alternative
  } that
  def int_eq : U (Int -> Int -> Ret Bool) = {
    fn left right ->
      ! (api/int_eq_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def int_lt : U (Int -> Int -> Ret Bool) = {
    fn left right ->
      ! (api/int_lt_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def int_le : U (Int -> Int -> Ret Bool) = {
    fn left right ->
      ! (api/int_gt_branch)
        (Ret Bool)
        left
        right
        { ret +False() }
        { ret +True() }
  } that
  def str_eq : U (String -> String -> Ret Bool) = {
    fn left right ->
      ! (api/str_eq_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def char_eq : U (Char -> Char -> Ret Bool) = {
    fn left right ->
      do left <- ! char_to_int left;
      do right <- ! char_to_int right;
      ! int_eq left right
  } that
  def bool_eq : U (Bool -> Bool -> Ret Bool) = {
    fn left right ->
      match left
      | +True() -> ret right
      | +False() ->
        match right
        | +True() -> ret +False()
        | +False() -> ret +True()
        end
      end
  } that
  def bool_to_str : U (Bool -> Ret String) = {
    fn b ->
      match b
      | +True() -> ret "true"
      | +False() -> ret "false"
      end
  } that
  def and~ : U (U (Ret Bool) -> U (Ret Bool) -> Ret Bool) = {
    fn left right ->
      do left <- ! left;
      match left
      | +True() -> ! right
      | +False() -> ret +False()
      end
  } that
  def or~ : U (U (Ret Bool) -> U (Ret Bool) -> Ret Bool) = {
    fn left right ->
      do left <- ! left;
      match left
      | +True() -> ret +True()
      | +False() -> ! right
      end
  } that
  def foldl : U (
    forall (A : VType) .
    forall (R : VType) .
      List A -> U (A -> R -> Ret R) -> R -> Ret R
  ) = {
    fix (foldl : U (
      forall (A : VType) .
      forall (R : VType) .
        List A -> U (A -> R -> Ret R) -> R -> Ret R
    )) ->
      fn A R values function result ->
        match values
        | +Nil() -> ret result
        | +Cons(value, remaining) ->
          do result <- ! function value result;
          ! foldl A R remaining function result
        end
  } that
  def panic : U (String -> OS) = {
    fn message ->
      ! write_line message {
        ! exit 1
      }
  } that

  -- A monad structure that supports fail
  let MonadErr (M : (VType) -> (CType)) =
    codata
    | .fail :
      forall (A : VType) .
        Exception -> M A
    end
  that

  -- A monad structure that supports print
  let MonadPrint (M : (VType) -> (CType)) =
    codata
    | .print : String -> M Unit
    end
  that

  let MonadAlt (M : (VType) -> (CType)) =
    codata
    | .alt :
      forall (A : VType) .
        U (M A) -> U (M A) -> M A
    end
  that

  let MonadReduce (M : (VType) -> (CType)) =
    codata
    | .reduce :
      forall (A : VType) .
        List (U (M A)) -> U (M A) -> M A
    end
  that

  -- A comonad structure
  let Comonad (W : (CType) -> (VType)) =
    codata
    | .extract :
      forall (B : CType) .
        W B -> B
    | .extend :
      forall (B : CType) .
      forall (B' : CType) .
        W B -> U (W B -> B') -> F (W B')
    end
  that

  -- An algebra structure that supports fail
  let AlgebraErr (M : (VType) -> (CType)) (B : CType) =
    codata
    | .failA : Exception -> B
    end
  that

  let Exception =
    data
    | +ParseError : Int * String
    | +FreeVariable : Unit
    | +TypeError : Unit
    end
  that

  -- Continuation-based error monad
  let MExnOS (A : VType) =
    codata
    | .run : U (A -> OS) -> U (Exception -> OS) -> OS
    end
  that

  def Value : VType =
    data
    | +Bool : Bool
    | +Int : Int
    | +Thunk : U Compu
    end
  that

  def Compu : CType =
    codata
    | .app : Value -> Compu
    | .bind : String -> SCompu -> U (Value -> Compu) -> Compu
    | .os : MExnOS Value
    end
  that

  def SValue : VType =
    data
    | +Var : String
    | +Bool : Bool
    | +Int : Int
    | +Thunk : SCompu
    end
  that

  def SCompu : VType =
    data
    | +Lam : String * SCompu
    | +App : SCompu * SValue
    | +Ret : SValue
    | +Bind : SCompu * String * SCompu
    | +Force : SValue
    | +Rec : String * SCompu
    | +If : SValue * SCompu * SCompu
    -- | +Add : SValue * SValue
    -- | +Mul : SValue * SValue
    | +Env : SCompu
    end
  that

-- module MExnOS
  def mexn : U (Monad MExnOS) = {
    comatch
    | .return A a ->
      comatch
      | .run ka _ -> ! ka a
      end
    | .bind A A' m f ->
      comatch
      | .run ka ke ->
        ! m .run { fn a -> ! f a .run ka ke } ke
      end
    end
  } that

  def mexn-err : U (MonadErr MExnOS) = {
    comatch
    | .fail A e ->
      comatch
      | .run _ ke -> ! ke e
      end
    end
  } that

  def mexn-print : U (MonadPrint MExnOS) = {
    comatch
    | .print s ->
      comatch
      | .run ka _ ->
        do~ ! write_line s;
        ! ka ()
      end
    end
  } that

  def mexn-alt : U (MonadAlt MExnOS) = {
    comatch
    | .alt A m1 m2 ->
      comatch
      | .run ka ke ->
        ! m1 .run ka { fn _ ->
          ! m2 .run ka ke
        }
      end
    end
  } that

  def mexn-reduce : U (MonadReduce MExnOS) = {
    comatch
    | .reduce A ms m ->
      do m~ <- ! foldl (U (MExnOS A)) (U (MExnOS A)) ms {
        fn m' m -> ret {
          comatch
          | .run ka ke ->
            ! m' .run ka { fn _ -> ! m .run ka ke }
          end
        }
      } m;
      ! m~
    end
  } that

  def malg : U (Algebra MExnOS Compu) = {
    fix (malg : U (Algebra MExnOS Compu)) ->
      fn A m f ->
        -- m : U (MExnOS A), f: U (A -> Compu)
        comatch
        | .app a -> -- goal: Compu
          ! malg A m { fn v -> ! f v .app a }
        | .bind x sc k -> -- goal: Compu
          ! malg A m { fn v -> ! f v .bind x sc k }
        | .os -> -- goal: MExnOS Value, use ordinary bind
          ! mexn .bind A Value m { fn x -> ! f x .os }
        end
  } that

  def malg-err : U (AlgebraErr MExnOS Compu) = {
    fix (malg-err : U (AlgebraErr MExnOS Compu)) ->
      comatch
      | .failA e ->
        fix unwind -> comatch
        | .app _ -> ! unwind
        | .bind _ _ _ -> ! unwind
        | .os -> ! mexn-err .fail Value e
        end
      end
  } that
-- end module MExnOS

-- module Print
  let PrintSCbpv =
    codata
    | .value : SValue -> U OS -> OS
    | .compu : SCompu -> U OS -> OS
    end
  that
  def print-scbpv : U PrintSCbpv = {
    fix (print-scbpv : U PrintSCbpv) ->
    comatch
    | .value sv kont ->
      match sv
      | +Var(x) -> ! write_str x kont
      | +Bool(b) -> ! if (OS) b { ! write_str "true" kont } { ! write_str "false" kont }
      | +Int(i) ->
        do i <- ! int_to_str i;
        ! write_str i kont
      | +Thunk(sc) ->
        -- Note: `do <comp1>; <comp2>` is a syntactic sugar for `<comp1> { <comp2> }`
        do~ ! write_str "{ ";
        do~ ! print-scbpv .compu sc;
        do~ ! write_str " }";
        ! kont
      end
    | .compu sc kont ->
      match sc
      | +Lam(x, sc) ->
        do~ ! write_str "fn ";
        do~ ! write_str x;
        do~ ! write_str " -> ";
        do~ ! print-scbpv .compu sc;
        ! kont
      | +App(sc, sv) ->
        do~ ! write_str "(";
        do~ ! print-scbpv .compu sc;
        do~ ! write_str " ";
        do~ ! print-scbpv .value sv;
        do~ ! write_str ")";
        ! kont
      | +Ret(sv) ->
        do~ ! write_str "ret ";
        do~ ! print-scbpv .value sv;
        ! kont
      | +Bind(sc1, x, sc2) ->
        do m <- ! str_append "bind " x;
        do m <- ! str_append m " <- ";
        do~ ! write_str m;
        do~ ! print-scbpv .compu sc1;
        do~ ! write_str "; ";
        do~ ! print-scbpv .compu sc2;
        ! kont
      | +Force(sv) ->
        do~ ! write_str "! ";
        do~ ! print-scbpv .value sv;
        ! kont
      | +Rec(x, sc) ->
        do~ ! write_str "fix ";
        do~ ! write_str x;
        do~ ! write_str " -> ";
        do~ ! print-scbpv .compu sc;
        ! kont
      | +If(sv, sc1, sc2) ->
        do~ ! write_str "if ";
        do~ ! print-scbpv .value sv;
        do~ ! write_str " then ";
        do~ ! print-scbpv .compu sc1;
        do~ ! write_str " else ";
        do~ ! print-scbpv .compu sc2;
        ! kont
      | +Env(sc) ->
        do~ ! write_str "env[";
        do~ ! print-scbpv .compu sc;
        do~ ! write_str "]";
        ! kont
      end
    end
  } that
  def print-svalue : U (SValue -> U OS -> OS) = {
    ! print-scbpv .value
  } that
  def print-scompu : U (SCompu -> U OS -> OS) = {
    ! print-scbpv .compu
  } that

  let PrintCbpv =
    codata
    | .value : Value -> U OS -> OS
    | .compu : U Compu -> U OS -> OS
    end
  that
  def print-cbpv : U PrintCbpv = {
    fix (print-cbpv : U PrintCbpv) ->
      comatch
      | .value v kont ->
        match v
        | +Bool(b) -> ! if (OS) b { ! write_str "true" kont } { ! write_str "false" kont }
        | +Int(i) ->
          do i <- ! int_to_str i;
          ! write_str i kont
        | +Thunk(c) ->
          do~ ! write_str "{ ";
          do~ ! print-cbpv .compu c;
          do~ ! write_str " }";
          ! kont
        end
      | .compu c kont ->
        ! write_str "<compu>" kont
      end
  } that
  def print-value : U (Value -> U OS -> OS) = {
    ! print-cbpv .value
  } that
  def print-compu : U (U Compu -> U OS -> OS) = {
    ! print-cbpv .compu
  } that
-- end module Print

-- module Env
  def EnvT : VType =
    data
    | +Empty : Unit
    | +Extend : String * Value * EnvT
    end
  that

  def EnvO : CType =
    codata
    | .lookup : String -> Ret (Option Value)
    | .extend : String -> Value -> EnvO
    | .print : U OS -> OS
    end
  that

  def envo : U (EnvT -> EnvO) = {
    fix (envo : U (EnvT -> EnvO)) ->
      fn env ->
        comatch
        | .lookup x ->
          match env
          | +Empty() -> ret +None()
          | +Extend(x', v, env') ->
            do is-eq? <- ! str_eq x x';
            match is-eq?
            | +True() -> ret +Some(v)
            | +False() -> ! envo env' .lookup x
            end
          end
        | .extend x v ->
          ! envo +Extend(x, v, env)
        | .print k ->
          do~ ! write_line "[";
          (fix (p : U (EnvT -> OS)) -> fn env -> match env
          | +Empty() -> ! write_line "]" k
          | +Extend(x, v, env') ->
            do~ ! write_str "  ";
            do~ ! write_str x;
            do~ ! write_str " = ";
            do~ ! print-value v;
            do~ ! write_line ",";
            ! p env'
          end) env
        end
  } that
-- end module Env

-- module Trace
  let TraceItem =
    data
    | +App : Value
    -- | +App : SValue * Value
    -- | +Bind : U (Value -> Compu)
    | +Bind : String * SCompu * U (Value -> Compu)
    end
  that

  let TraceO =
    codata
    | .print : U OS -> OS
    end
  that

  def traceo : U (List TraceItem -> TraceO) = {
    fn items ->
      comatch
      | .print kont ->
        do~ ! write_line "[";
        do kont <-
          do~ ! foldl (TraceItem) (U OS) items { fn item kont -> ret {
            match item
            | +App(v) ->
              -- | +App(_sv, v) ->
              do~ ! write_str "  app ";
              do~ ! print-value v;
              do~ ! write_line ",";
              ! kont
            -- | +Bind(_k) ->
            | +Bind(x, sc, _k) ->
              do~ ! write_str "  bind ";
              do~ ! write_str x;
              do~ ! write_str ". ";
              do~ ! print-scompu sc;
              do~ ! write_line ",";
              ! kont
            end
          }};
          ! write_line "]" kont
        ;
        ! kont
      end
  } that
-- end module Trace

/- Parser -/

-- module Parser
  let Parser (A : VType) =
    codata
    | .run : String -> Int -> MExnOS (Pair A Int)
    end
  that

  def mp : U (Monad Parser) = {
    comatch
    | .return A a ->
      comatch
      | .run s i -> ! mexn .return (Pair A Int) +Cons(a, i)
      end
    | .bind A A' ma f ->
      comatch
      | .run s i ->
        comatch
        | .run ka ke ->
          ! ma .run s i .run { fn p -> match p | +Cons(a, i) ->
            ! f a .run s i .run ka ke
          end } ke
        end
      end
    end
  } that

  def mp-err : U (MonadErr Parser) = {
    comatch
    | .fail A e ->
      comatch
      | .run s i ->
        comatch
        | .run _ ke -> ! ke e
        end
      end
    end
  } that

  def mp-alt : U (MonadAlt Parser) = {
    comatch
    | .alt A m1 m2 ->
      comatch
      | .run s i ->
        ! mexn-alt .alt (Pair A Int) { ! m1 .run s i } { ! m2 .run s i }
      end
    end
  } that

  def mp-cnt : U (
    forall (A : VType) .
      Int -> U (Parser A) -> Parser A
  ) = {
    fn A cnt m ->
      comatch | .run s i ->
        do len <- ! str_length s;
        do i' <- ! add i cnt;
        ! if~ (MExnOS (Pair A Int)) { ! int_le i' len } {
          ! m .run s i
        } {
          ! mexn-err .fail (Pair A Int) +ParseError(i, "unexpected eof")
        }
      end
  } that

  def p_char : U (Char -> Parser Char) = {
    fn c ->
      ! mp-cnt (Char) 1 {
        comatch | .run s i ->
          ! if~ (MExnOS (Pair Char Int)) {
            do c' <- ! str_index s i;
            ! char_eq c' c
          } {
            do i' <- ! add i 1;
            ! mexn .return (Pair Char Int) +Cons(c, i')
          } {
            do msg <- ! char_to_str c;
            do msg <- ! str_append "missing `" msg;
            do msg <- ! str_append msg "`";
            ! mexn-err .fail (Pair Char Int) +ParseError(i, msg)
          }
        end
      }
  } that

  def p_word : U (String -> Parser String) = {
    fn w ->
      do len <- ! str_length w;
      ! mp-cnt (String) len {
        comatch | .run s i ->
          let fix word_match (j: Int) =
            ! if~ (Ret Bool) { ! int_eq j len } {
              ret +True()
            } {
              do l <- ! add i j;
              do c1 <- ! str_index s l;
              do c2 <- ! str_index w j;
              ! if~ (Ret Bool) { ! char_eq c1 c2 } {
                do j' <- ! add j 1;
                ! word_match j'
              } {
                ret +False()
              }
            }
          in
          ! if~ (MExnOS (Pair String Int)) { ! word_match 0 } {
            do i' <- ! add i len;
            ! mexn .return (Pair String Int) +Cons(w, i')
          } {
            do msg <- ! str_append "word `" w;
            do msg <- ! str_append msg "` mismatch";
            ! mexn-err .fail (Pair String Int) +ParseError(i, msg)
          }
        end
      }
  } that

  def p_var : U (Parser String) = {
    let ! p_vc (c: Char) : Ret (Option Char) =
      do ascii <- ! char_to_int c;
      let digit = { ! and~ { ! int_lt 47 ascii } { ! int_lt ascii 58 } } in
      let cap = { ! and~ { ! int_lt 64 ascii } { ! int_lt ascii 91 } } in
      let sml = { ! and~ { ! int_lt 96 ascii } { ! int_lt ascii 123 } } in
      ! if~ (Ret (Option Char))
        { ! or~ digit { ! or~ cap sml } }
        { ret +Some(c) }
        { ret +None() }
    in
    comatch | .run s i ->
      let fix var (v: String) (i: Int) =
        do c <- ! str_index s i;
        do c? <- ! p_vc c;
        do i' <- ! add i 1;
        match c?
        | +None() ->
          ! if~ (MExnOS (Pair String Int)) {
            do len <- ! str_length v;
            ! int_eq len 0
          } {
            ! mexn-err .fail (Pair String Int) +ParseError(i, "variable of length 0")
          } {
            ! mexn .return (Pair String Int) +Cons(v, i)
          }
        | +Some(c) ->
          do c <- ! char_to_str c;
          do v <- ! str_append v c;
          ! var v i'
        end
      in
      ! var "" i
    end
  } that

  let ParserCbpv =
    codata
    | .value : Parser SValue
    | .compu : Parser SCompu
    end
  that

  def p_cbpv : U ParserCbpv = {
    fix (p_cbpv : U ParserCbpv) ->
      comatch
    | .value ->
      let ! _true =
        do~ ! mp .bind (String) (SValue) { ! p_word "true" }; fn _ ->
        ! mp .return (SValue) +Bool(+True())
      in
      let ! _false =
        do~ ! mp .bind (String) (SValue) { ! p_word "false" }; fn _ ->
        ! mp .return (SValue) +Bool(+False())
      in
      let ! _var =
        do~ ! mp .bind (String) (SValue) p_var; fn v ->
        ! mp .return (SValue) +Var(v)
      in
      let ! _thunk =
        do~ ! mp .bind (Char) (SValue) { ! p_char '{' }; fn _ ->
        do~ ! mp .bind (SCompu) (SValue) { ! p_cbpv .compu }; fn sc ->
        do~ ! mp .bind (Char) (SValue) { ! p_char '}' }; fn _ ->
        ! mp .return (SValue) +Thunk(sc)
      in
      do~ ! mp-alt .alt (SValue) _true;
      do~ ! mp-alt .alt (SValue) _false;
      do~ ! mp-alt .alt (SValue) _var;
      do~ ! mp-alt .alt (SValue) _thunk;
      comatch | .run s i ->
        ! mexn-err .fail (Pair SValue Int) +ParseError(i, "expected value")
      end
    | .compu ->
      let ! _env =
        do~ ! mp .bind (Char) (SCompu) { ! p_char '(' }; fn _ ->
        do~ ! mp .bind (String) (SCompu) { ! p_word "env" }; fn _ ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu }; fn sc ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ')' }; fn _ ->
        ! mp .return (SCompu) +Env(sc)
      in
      let ! _ret =
        do~ ! mp .bind (Char) (SCompu) { ! p_char '(' }; fn _ ->
        do~ ! mp .bind (String) (SCompu) { ! p_word "ret" }; fn _ ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (SValue) (SCompu) { ! p_cbpv .value }; fn sv ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ')' }; fn _ ->
        ! mp .return (SCompu) +Ret(sv)
      in
      let ! _bind =
        do~ ! mp .bind (Char) (SCompu) { ! p_char '(' }; fn _ ->
        do~ ! mp .bind (String) (SCompu) { ! p_word "bind" }; fn _ ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu }; fn sc1 ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (String) (SCompu) p_var; fn v ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu }; fn sc2 ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ')' }; fn _ ->
        ! mp .return (SCompu) +Bind(sc1, v, sc2)
      in
      let ! _force =
        do~ ! mp .bind (Char) (SCompu) { ! p_char '!' }; fn _ ->
        -- do~ ! mp .bind (String) (SCompu) { ! p_word "call" }; fn _ ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (SValue) (SCompu) { ! p_cbpv .value }; fn sv ->
        -- do~ ! mp .bind (Char) (SCompu) { ! p_char ')' }; fn _ ->
        ! mp .return (SCompu) +Force(sv)
      in
      let ! _if =
        do~ ! mp .bind (Char) (SCompu) { ! p_char '(' }; fn _ ->
        do~ ! mp .bind (String) (SCompu) { ! p_word "if" }; fn _ ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (SValue) (SCompu) { ! p_cbpv .value }; fn sv ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu }; fn sc1 ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu }; fn sc2 ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ')' }; fn _ ->
        ! mp .return (SCompu) +If(sv, sc1, sc2)
      in
      let ! _lam =
        do~ ! mp .bind (Char) (SCompu) { ! p_char '(' }; fn _ ->
        do~ ! mp .bind (String) (SCompu) { ! p_word "fn" }; fn _ ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (String) (SCompu) p_var; fn v ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu }; fn sc ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ')' }; fn _ ->
        ! mp .return (SCompu) +Lam(v, sc)
      in
      let ! _app =
        do~ ! mp .bind (Char) (SCompu) { ! p_char '(' }; fn _ ->
        do~ ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu }; fn sc ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ' ' }; fn _ ->
        do~ ! mp .bind (SValue) (SCompu) { ! p_cbpv .value }; fn sv ->
        do~ ! mp .bind (Char) (SCompu) { ! p_char ')' }; fn _ ->
        ! mp .return (SCompu) +App(sc, sv)
      in
      do~ ! mp-alt .alt (SCompu) _env;
      do~ ! mp-alt .alt (SCompu) _ret;
      do~ ! mp-alt .alt (SCompu) _bind;
      do~ ! mp-alt .alt (SCompu) _force;
      do~ ! mp-alt .alt (SCompu) _if;
      do~ ! mp-alt .alt (SCompu) _lam;
      do~ ! mp-alt .alt (SCompu) _app;
      comatch | .run s i ->
        ! mexn-err .fail (Pair SCompu Int) +ParseError(i, "expected computation")
      end
      end
  } that

  def p_main : U (String -> MExnOS SCompu) = {
    fn s ->
      do~ ! mexn .bind (Pair SCompu Int) (SCompu) { ! p_cbpv .compu .run s 0 }; fn sci ->
      match sci
      | +Cons(sc, i) ->
        ! if~ (MExnOS SCompu) {
          do len <- ! str_length s;
          ! int_eq i len
        } {
          ! mexn .return (SCompu) sc
        } {
          ! mexn-err .fail (SCompu) +ParseError(i, "not eof after parsing")
        }
      end
  } that
-- end module Parser

/- Interpretor -/

  let Interp =
    codata
    | .value : SValue -> MExnOS Value
    | .compu : SCompu -> Compu
    end
  that

  def interp : U (U EnvO -> Interp) = {
    fix (interp : U (U EnvO -> Interp)) ->
      fn env ->
        comatch
  | .value sv ->
    match sv
    | +Var(x) ->
      do x? <- ! env .lookup x;
      match x?
      | +None() -> ! mexn-err .fail Value +FreeVariable()
      | +Some(v) ->
        ! mexn .return Value v
      end
    | +Bool(b) ->
      ! mexn .return Value +Bool(b)
    | +Int(i) ->
      ! mexn .return Value +Int(i)
    | +Thunk(c) ->
      ! mexn .return Value +Thunk({ ! interp env .compu c })
    end
  | .compu sc ->
    let ! type-error = 
      ! mexn-err .fail Value +TypeError()
    in
    match sc
    | +Lam(x, sc) ->
      comatch
      | .app v ->
        ! interp { ! env .extend x v } .compu sc
      | .bind _ _ k ->
        do~ ! malg Value type-error; fn v ->
        -- the following is unreachable
        ! k v .app v
      | .os -> ! type-error
      end
    | +App(sc, sv) ->
      do~ ! malg Value { ! interp env .value sv }; fn v ->
      ! interp env .compu sc .app v
    | +Ret(sv) ->
      comatch
      | .app _ -> ! malg-err .failA +TypeError()
      | .bind _ _ k ->
        do~ ! malg Value { ! interp env .value sv }; fn v ->
        ! k v
      | .os -> ! interp env .value sv
      end
    | +Bind(sc1, x, sc2) ->
      do~ ! interp env .compu sc1 .bind x sc2; fn v ->
      ! interp { ! env .extend x v } .compu sc2
    | +Force(sv) ->
      do~ ! malg Value { ! interp env .value sv }; fn v ->
      match v
      | +Bool(_) -> ! malg-err .failA +TypeError()
      | +Int(_) -> ! malg-err .failA +TypeError()
      | +Thunk(c) -> ! c
      end
    | +Rec(x, sc) ->
      ! interp { ! env .extend x +Thunk({ ! interp env .compu +Rec(x, sc) }) } .compu sc
    | +If(sv, c1, c2) ->
      do~ ! malg Value { ! interp env .value sv }; fn v ->
      match v
      | +Bool(b) ->
        match b
        | +True() -> ! interp env .compu c1
        | +False() -> ! interp env .compu c2
        end
      | +Int(_) -> ! malg-err .failA +TypeError()
      | +Thunk(_) -> ! malg-err .failA +TypeError()
      end
    | +Env(sc) -> 
      let fix walk (items: List TraceItem): Compu =
        comatch
        | .app v ->
          ! walk +Cons(+App(v), items)
        | .bind x sc k ->
          ! walk +Cons(+Bind(x, sc, k), items)
        | .os ->
          let mp: U (MExnOS Unit) = {
            comatch | .run ka _ ->
              do~ ! write_line "[[DEBUG]]";
              do~ ! write_str "[env]: ";
              do~ ! env .print;
              do~ ! write_str "[term]: ";
              do~ ! print-scompu sc;
              do~ ! write_line "";
              do~ ! write_str "[stack]: ";
              do~ ! traceo items .print;
              do~ ! write_str "Continue? ";
              do~ ! read_line; fn _ ->
              ! ka ()
            end
          } in
          do~ ! mexn .bind (Unit) Value mp; fn _ ->
          let fix cowalk (items: List TraceItem): Compu =
            match items
            | +Nil() -> ! interp env .compu sc
            | +Cons(item, items) ->
              match item
              | +App(v) -> ! cowalk items .app v
              | +Bind(x, sc, k) -> ! cowalk items .bind x sc k
              end
            end
          in
          ! cowalk items .os
        end
      in
      ! walk +Nil()
        end
      end
  } that

-- module Utils
  def value-eq : U (Value -> Value -> U OS -> OS) = {
    fn v1 v2 k ->
    let expect-bool-panic = { ! panic "expected bool value" } in
    let expect-int-panic = { ! panic "expected int value" } in
    let correct = { ! write_line "\\^o^/" k } in
    match v1
    | +Bool(b1) ->
      match v2
      | +Bool(b2) ->
        do eq? <- ! bool_eq b1 b2;
        match eq?
        | +True() -> ! correct
        | +False() ->
          do b1 <- ! bool_to_str b1;
          do b2 <- ! bool_to_str b2;
          do msg <- ! str_append b1 " != ";
          do msg <- ! str_append msg b2;
          do msg <- ! str_append "wrong bool value: " msg;
          ! panic msg
        end
      | +Int(_) -> ! expect-bool-panic
      | +Thunk(_) -> ! expect-bool-panic
      end
    | +Int(i1) ->
      match v2
      | +Bool(_) -> ! expect-int-panic
      | +Int(i2) ->
        do eq? <- ! int_eq i1 i2;
        match eq?
        | +True() -> ! correct
        | +False() ->
          do i1 <- ! int_to_str i1;
          do i2 <- ! int_to_str i2;
          do msg <- ! str_append i1 " != ";
          do msg <- ! str_append msg i2;
          do msg <- ! str_append "wrong int value: " msg;
          ! panic msg
        end
      | +Thunk(_) -> ! expect-int-panic
      end
    | +Thunk(_) -> ! panic "thunks are not comparable"
    end
  } that

  def report : U (Exception -> OS) = {
    fn e ->
    match e
    | +ParseError(loc, msg) ->
      do loc <- ! int_to_str loc;
      do loc <- ! str_append loc ": ";
      do msg <- ! str_append loc msg;
      ! panic msg
    | +FreeVariable() -> ! panic "free variable"
    | +TypeError() -> ! panic "type error"
    end
  } that
-- end module Utils

  def nil-env : U EnvO = {
    ! envo +Empty()
  } that

  def cbpv-env : U EnvO = {
  let ! app-int (f: U (Int -> Compu)) : Compu =
    comatch
    | .app v ->
      match v
      | +Bool(_) -> ! malg-err .failA +TypeError()
      | +Thunk(_) -> ! malg-err .failA +TypeError()
      | +Int(i) -> ! f i
      end
    | .bind _ _ _ ->
      ! malg-err .failA +TypeError()
    | .os ->
      ! mexn-err .fail Value +TypeError()
    end
  in
  let ! int-op (op: U (Int -> Int -> Ret Value)) : Compu =
    do~ ! app-int; fn i1 ->
    do~ ! app-int; fn i2 ->
    do v <- ! op i1 i2;
    comatch
    | .app _ -> ! malg-err .failA +TypeError()
    | .bind _ _ k ->
      do~ ! malg Value { ! mexn .return Value v }; fn v ->
      ! k v
    | .os -> ! mexn .return Value v
    end
  in
  ! envo +Extend("add", +Thunk({
    do~ ! int-op; fn i1 i2 ->
    do i <- ! add i1 i2;
    ret +Int(i)
  }), +Extend("mul", +Thunk({
    do~ ! int-op; fn i1 i2 ->
    do i <- ! mul i1 i2;
    ret +Int(i)
  }), +Extend("eq", +Thunk({
    do~ ! int-op; fn i1 i2 ->
    do b <- ! int_eq i1 i2;
    ret +Bool(b)
  }), +Empty())))
  } that

  def demo-scompu : U (U EnvO -> SCompu -> Value -> U OS -> OS) = {
    fn env term ans k ->
      ! interp env .compu term .os .run { fn v ->
        ! value-eq v ans k
      } report
  } that

  def demo : U (U EnvO -> String -> Value -> U OS -> OS) = {
    fn env src ans k ->
      ! p_main src .run { fn term ->
        ! demo-scompu env term ans k
      } report
  } that

  -- if clause
  do~ ! demo nil-env "(if true (ret true) (ret false))" +Bool(+True());

  -- 4 envs: first with a bind stack, second with x in env, third with an app stack, and last with only variables in env
  -- do~ ! demo nil-env "(bind (env (ret true)) x (env ((env (fn b (if b (env (ret x)) (ret false)))) true)))" +Bool(+True());

  -- lambda in thunk
  -- do~ ! demo nil-env "(bind (ret {(fn x (if x (ret false) (ret true)))}) not (bind (env (ret false)) x (! not x)))" +Bool(+True());

  -- bind to lambda should fail
  -- do~ ! demo nil-env "(bind (fn x (ret x)) f (ret true))" +Bool(+True());

  -- apply to ret should fail
  -- do~ ! demo nil-env "((ret true) true)" +Bool(+True());

  -- call a bool should fail
  -- do~ ! demo nil-env "! true" +Bool(+True());

  -- test `! add 1 2`
  do~ ! demo-scompu cbpv-env +App(+App(+Force(+Var("add")), +Int(1)), +Int(2)) +Int(3);

  -- test `! mul 3 2`
  do~ ! demo-scompu cbpv-env +App(+App(+Force(+Var("mul")), +Int(3)), +Int(2)) +Int(6);

  -- test infinite loop
  -- do~ ! demo-scompu cbpv-env +Rec("loop", +Force(+Var("loop"))) +Int(1);

  -- test `do x <- ! add 2 3; ! add 1 x`
  do~ ! demo-scompu cbpv-env +Bind(
    +App(+App(+Force(+Var("add")), +Int(2)), +Int(3)),
    "x",
    +App(+App(+Force(+Var("add")), +Int(1)), +Var("x"))
  ) +Int(6);

  -- factorial, poor usage of stack
  -- do~ ! demo-scompu cbpv-env +App(+Rec("fact", +Env(+Lam("x",
  --   +Bind(
