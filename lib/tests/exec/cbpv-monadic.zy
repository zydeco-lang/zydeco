begin
  let U = Thk that
  let F = Ret that
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (
      /VType; /CType; /Thk; /Ret;
      /Unit; /Int; /Char; /String; /OS;
      /int; /char; /string; /stdio; /process;
      builtin
    ) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    monadic_basis builtin in
  begin
  let Ret = F that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def Option (A : VType) =
    data
    | +None : Unit
    | +Some : A
    end
  that
  def ! str_get_or_space (text : String) (index : Int) : Ret Char =
    ! (string/get)
      (Ret Char)
      text
      index
      { ret ' ' }
      { fn character => ret character }
  that
  def List (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * List A
    end
  that
  def Pair (A : VType) (A' : VType) =
    data
    | +Cons : A * A'
    end
  that

  def ! if (B : CType) (condition : Bool) (consequent : U B) (alternative : U B) : B =
    match condition
    | +True() => ! consequent
    | +False() => ! alternative
    end
  that
  def ! if~ (B : CType) (condition : U (Ret Bool)) (consequent : U B) (alternative : U B) : B =
    do condition <- ! condition;
    ! if B condition consequent alternative
  that
  def ! int_eq (left : Int) (right : Int) : Ret Bool =
    ! (int/eq)
      (Ret Bool)
      left
      right
      { ret +True() }
      { ret +False() }
  that
  def ! int_lt (left : Int) (right : Int) : Ret Bool =
    ! (int/lt)
      (Ret Bool)
      left
      right
      { ret +True() }
      { ret +False() }
  that
  def ! int_le (left : Int) (right : Int) : Ret Bool =
    ! (int/gt)
      (Ret Bool)
      left
      right
      { ret +False() }
      { ret +True() }
  that
  def ! str_eq (left : String) (right : String) : Ret Bool =
    ! (string/eq)
      (Ret Bool)
      left
      right
      { ret +True() }
      { ret +False() }
  that
  def ! char_eq (left : Char) (right : Char) : Ret Bool =
    do left <- ! (char/codepoint) left;
    do right <- ! (char/codepoint) right;
    ! int_eq left right
  that
  def ! bool_eq (left : Bool) (right : Bool) : Ret Bool =
    match left
    | +True() => ret right
    | +False() =>
      match right
      | +True() => ret +False()
      | +False() => ret +True()
      end
    end
  that
  def ! bool_to_str (b : Bool) : Ret String =
    match b
    | +True() => ret "true"
    | +False() => ret "false"
    end
  that
  def ! and~ (left : U (Ret Bool)) (right : U (Ret Bool)) : Ret Bool =
    do left <- ! left;
    match left
    | +True() => ! right
    | +False() => ret +False()
    end
  that
  def ! or~ (left : U (Ret Bool)) (right : U (Ret Bool)) : Ret Bool =
    do left <- ! left;
    match left
    | +True() => ret +True()
    | +False() => ! right
    end
  that
  def fix foldl
    (A : VType)
    (R : VType)
    (values : List A)
    (function : U (A -> R -> Ret R))
    (result : R)
    : Ret R =
    match values
    | +Nil() => ret result
    | +Cons(value, remaining) =>
      do result <- ! function value result;
      ! foldl A R remaining function result
    end
  that
  def ! panic (message : String) : OS =
    ! (stdio/write_line) message {
      ! (process/exit) 1
    }
  that

  -- A monad structure that supports fail
  def MonadErr (M : (VType) -> (CType)) =
    codata
    | .fail :
      forall (A : VType) .
        Exception -> M A
    end
  that

  -- A monad structure that supports print
  def MonadPrint (M : (VType) -> (CType)) =
    codata
    | .print : String -> M Unit
    end
  that

  def MonadAlt (M : (VType) -> (CType)) =
    codata
    | .alt :
      forall (A : VType) .
        U (M A) -> U (M A) -> M A
    end
  that

  def MonadReduce (M : (VType) -> (CType)) =
    codata
    | .reduce :
      forall (A : VType) .
        List (U (M A)) -> U (M A) -> M A
    end
  that

  -- A comonad structure
  def Comonad (W : (CType) -> (VType)) =
    codata
    | .extract :
      forall (B : CType) .
        W B -> B
    | .extend :
      forall (B : CType) .
      forall (B' : CType) .
        W B -> U (W B -> B') -> F (W B')
    end
  that

  -- An algebra structure that supports fail
  def AlgebraErr (M : (VType) -> (CType)) (B : CType) =
    codata
    | .failA : Exception -> B
    end
  that

  def Exception =
    data
    | +ParseError : Int * String
    | +FreeVariable : Unit
    | +TypeError : Unit
    end
  that

  -- Continuation-based error monad
  def MExnOS (A : VType) =
    codata
    | .run : U (A -> OS) -> U (Exception -> OS) -> OS
    end
  that

  def Value : VType =
    data
    | +Bool : Bool
    | +Int : Int
    | +Thunk : U Compu
    end
  that

  def Compu : CType =
    codata
    | .app : Value -> Compu
    | .bind : String -> SCompu -> U (Value -> Compu) -> Compu
    | .os : MExnOS Value
    end
  that

  def SValue : VType =
    data
    | +Var : String
    | +Bool : Bool
    | +Int : Int
    | +Thunk : SCompu
    end
  that

  def SCompu : VType =
    data
    | +Lam : String * SCompu
    | +App : SCompu * SValue
    | +Ret : SValue
    | +Bind : SCompu * String * SCompu
    | +Force : SValue
    | +Rec : String * SCompu
    | +If : SValue * SCompu * SCompu
    -- | +Add : SValue * SValue
    -- | +Mul : SValue * SValue
    | +Env : SCompu
    end
  that

-- module MExnOS
  def ! mexn : Monad MExnOS =
    comatch
    | .return A a =>
      comatch
      | .run ka _ => ! ka a
      end
    | .bind A A' m f =>
      comatch
      | .run ka ke =>
        ! m .run { fn a => ! f a .run ka ke } ke
      end
    end
  that

  def ! mexn-err : MonadErr MExnOS =
    comatch
    | .fail A e =>
      comatch
      | .run _ ke => ! ke e
      end
    end
  that

  def ! mexn-print : MonadPrint MExnOS =
    comatch
    | .print s =>
      comatch
      | .run ka _ =>
        ! (stdio/write_line) s {
          ! ka () }
      end
    end
  that

  def ! mexn-alt : MonadAlt MExnOS =
    comatch
    | .alt A m1 m2 =>
      comatch
      | .run ka ke =>
        ! m1 .run ka { fn _ =>
          ! m2 .run ka ke
        }
      end
    end
  that

  def ! mexn-reduce : MonadReduce MExnOS =
    comatch
    | .reduce A ms m =>
      do m~ <- ! foldl (U (MExnOS A)) (U (MExnOS A)) ms {
        fn m' m => ret {
          comatch
          | .run ka ke =>
            ! m' .run ka { fn _ => ! m .run ka ke }
          end
        }
      } m;
      ! m~
    end
  that

  def fix malg : Algebra MExnOS Compu =
    fn A m f =>
      -- m : U (MExnOS A), f: U (A -> Compu)
      comatch
      | .app a => -- goal: Compu
        ! malg A m { fn v => ! f v .app a }
      | .bind x sc k => -- goal: Compu
        ! malg A m { fn v => ! f v .bind x sc k }
      | .os => -- goal: MExnOS Value, use ordinary bind
        ! mexn .bind A Value m { fn x => ! f x .os }
      end
  that

  def fix malg-err : AlgebraErr MExnOS Compu =
    comatch
    | .failA e =>
      fix unwind => comatch
      | .app _ => ! unwind
      | .bind _ _ _ => ! unwind
      | .os => ! mexn-err .fail Value e
      end
    end
  that
-- end module MExnOS

-- module Print
  def PrintSCbpv =
    codata
    | .value : SValue -> U OS -> OS
    | .compu : SCompu -> U OS -> OS
    end
  that
  def fix print-scbpv : PrintSCbpv =
    comatch
    | .value sv kont =>
      match sv
      | +Var(x) => ! (stdio/write) x kont
      | +Bool(b) => ! if (OS) b { ! (stdio/write) "true" kont } { ! (stdio/write) "false" kont }
      | +Int(i) =>
        do i <- ! (int/to_string) i;
        ! (stdio/write) i kont
      | +Thunk(sc) =>
        -- Continuation sequencing is written explicitly as `<comp1> { <comp2> }`.
        ! (stdio/write) "{ " {
          ! print-scbpv .compu sc {
            ! (stdio/write) " }" {
              ! kont } } }
      end
    | .compu sc kont =>
      match sc
      | +Lam(x, sc) =>
        ! (stdio/write) "fn " {
          ! (stdio/write) x {
            ! (stdio/write) " -> " {
              ! print-scbpv .compu sc {
                ! kont } } } }
      | +App(sc, sv) =>
        ! (stdio/write) "(" {
          ! print-scbpv .compu sc {
            ! (stdio/write) " " {
              ! print-scbpv .value sv {
                ! (stdio/write) ")" {
                  ! kont } } } } }
      | +Ret(sv) =>
        ! (stdio/write) "ret " {
          ! print-scbpv .value sv {
            ! kont } }
      | +Bind(sc1, x, sc2) =>
        do m <- ! (string/append) "bind " x;
        do m <- ! (string/append) m " <- ";
        ! (stdio/write) m {
          ! print-scbpv .compu sc1 {
            ! (stdio/write) "; " {
              ! print-scbpv .compu sc2 {
                ! kont } } } }
      | +Force(sv) =>
        ! (stdio/write) "! " {
          ! print-scbpv .value sv {
            ! kont } }
      | +Rec(x, sc) =>
        ! (stdio/write) "fix " {
          ! (stdio/write) x {
            ! (stdio/write) " -> " {
              ! print-scbpv .compu sc {
                ! kont } } } }
      | +If(sv, sc1, sc2) =>
        ! (stdio/write) "if " {
          ! print-scbpv .value sv {
            ! (stdio/write) " then " {
              ! print-scbpv .compu sc1 {
                ! (stdio/write) " else " {
                  ! print-scbpv .compu sc2 {
                    ! kont } } } } } }
      | +Env(sc) =>
        ! (stdio/write) "env[" {
          ! print-scbpv .compu sc {
            ! (stdio/write) "]" {
              ! kont } } }
      end
    end
  that
  def ! print-svalue : SValue -> U OS -> OS =
    ! print-scbpv .value
  that
  def ! print-scompu : SCompu -> U OS -> OS =
    ! print-scbpv .compu
  that

  def PrintCbpv =
    codata
    | .value : Value -> U OS -> OS
    | .compu : U Compu -> U OS -> OS
    end
  that
  def fix print-cbpv : PrintCbpv =
    comatch
    | .value v kont =>
      match v
      | +Bool(b) => ! if (OS) b { ! (stdio/write) "true" kont } { ! (stdio/write) "false" kont }
      | +Int(i) =>
        do i <- ! (int/to_string) i;
        ! (stdio/write) i kont
      | +Thunk(c) =>
        ! (stdio/write) "{ " {
          ! print-cbpv .compu c {
            ! (stdio/write) " }" {
              ! kont } } }
      end
    | .compu c kont =>
      ! (stdio/write) "<compu>" kont
    end
  that
  def ! print-value : Value -> U OS -> OS =
    ! print-cbpv .value
  that
  def ! print-compu : U Compu -> U OS -> OS =
    ! print-cbpv .compu
  that
-- end module Print

-- module Env
  def EnvT : VType =
    data
    | +Empty : Unit
    | +Extend : String * Value * EnvT
    end
  that

  def EnvO : CType =
    codata
    | .lookup : String -> Ret (Option Value)
    | .extend : String -> Value -> EnvO
    | .print : U OS -> OS
    end
  that

  def fix envo (env : EnvT) : EnvO =
    comatch
    | .lookup x =>
      match env
      | +Empty() => ret +None()
      | +Extend(x', v, env') =>
        do is-eq? <- ! str_eq x x';
        match is-eq?
        | +True() => ret +Some(v)
        | +False() => ! envo env' .lookup x
        end
      end
    | .extend x v =>
      ! envo +Extend(x, v, env)
    | .print k =>
      ! (stdio/write_line) "[" {
        (fix (p : U (EnvT -> OS)) => fn env => match env
        | +Empty() => ! (stdio/write_line) "]" k
        | +Extend(x, v, env') =>
          ! (stdio/write) "  " {
            ! (stdio/write) x {
              ! (stdio/write) " = " {
                ! print-value v {
                  ! (stdio/write_line) "," {
                    ! p env' } } } } }
        end) env }
    end
  that
-- end module Env

-- module Trace
  def TraceItem =
    data
    | +App : Value
    -- | +App : SValue * Value
    -- | +Bind : U (Value -> Compu)
    | +Bind : String * SCompu * U (Value -> Compu)
    end
  that

  def TraceO =
    codata
    | .print : U OS -> OS
    end
  that

  def ! traceo (items : List TraceItem) : TraceO =
    comatch
    | .print kont =>
      ! (stdio/write_line) "[" {
        do kont <-
          ! foldl (TraceItem) (U OS) items { fn item kont => ret {
            match item
            | +App(v) =>
              -- | +App(_sv, v) =>
              ! (stdio/write) "  app " {
                ! print-value v {
                  ! (stdio/write_line) "," {
                    ! kont } } }
            -- | +Bind(_k) =>
            | +Bind(x, sc, _k) =>
              ! (stdio/write) "  bind " {
                ! (stdio/write) x {
                  ! (stdio/write) ". " {
                    ! print-scompu sc {
                      ! (stdio/write_line) "," {
                        ! kont } } } } }
            end
          }} {
            ! (stdio/write_line) "]" kont }
        ;
        ! kont }
    end
  that
-- end module Trace

/- Parser -/

-- module Parser
  def Parser (A : VType) =
    codata
    | .run : String -> Int -> MExnOS (Pair A Int)
    end
  that

  def ! mp : Monad Parser =
    comatch
    | .return A a =>
      comatch
      | .run s i => ! mexn .return (Pair A Int) +Cons(a, i)
      end
    | .bind A A' ma f =>
      comatch
      | .run s i =>
        comatch
        | .run ka ke =>
          ! ma .run s i .run { fn p => match p | +Cons(a, i) =>
            ! f a .run s i .run ka ke
          end } ke
        end
      end
    end
  that

  def ! mp-err : MonadErr Parser =
    comatch
    | .fail A e =>
      comatch
      | .run s i =>
        comatch
        | .run _ ke => ! ke e
        end
      end
    end
  that

  def ! mp-alt : MonadAlt Parser =
    comatch
    | .alt A m1 m2 =>
      comatch
      | .run s i =>
        ! mexn-alt .alt (Pair A Int) { ! m1 .run s i } { ! m2 .run s i }
      end
    end
  that

  def ! mp-cnt (A : VType) (cnt : Int) (m : U (Parser A)) : Parser A =
    comatch | .run s i =>
      do len <- ! (string/length) s;
      do i' <- ! (int/add) i cnt;
      ! if~ (MExnOS (Pair A Int)) { ! int_le i' len } {
        ! m .run s i
      } {
        ! mexn-err .fail (Pair A Int) +ParseError(i, "unexpected eof")
      }
    end
  that

  def ! p_char (c : Char) : Parser Char =
    ! mp-cnt (Char) 1 {
      comatch | .run s i =>
        ! if~ (MExnOS (Pair Char Int)) {
          do c' <- ! str_get_or_space s i;
          ! char_eq c' c
        } {
          do i' <- ! (int/add) i 1;
          ! mexn .return (Pair Char Int) +Cons(c, i')
        } {
          do msg <- ! (char/to_string) c;
          do msg <- ! (string/append) "missing `" msg;
          do msg <- ! (string/append) msg "`";
          ! mexn-err .fail (Pair Char Int) +ParseError(i, msg)
        }
      end
    }
  that

  def ! p_word (w : String) : Parser String =
    do len <- ! (string/length) w;
    ! mp-cnt (String) len {
      comatch | .run s i =>
        let fix word_match (j: Int) =
          ! if~ (Ret Bool) { ! int_eq j len } {
            ret +True()
          } {
            do l <- ! (int/add) i j;
            do c1 <- ! str_get_or_space s l;
            do c2 <- ! str_get_or_space w j;
            ! if~ (Ret Bool) { ! char_eq c1 c2 } {
              do j' <- ! (int/add) j 1;
              ! word_match j'
            } {
              ret +False()
            }
          }
        in
        ! if~ (MExnOS (Pair String Int)) { ! word_match 0 } {
          do i' <- ! (int/add) i len;
          ! mexn .return (Pair String Int) +Cons(w, i')
        } {
          do msg <- ! (string/append) "word `" w;
          do msg <- ! (string/append) msg "` mismatch";
          ! mexn-err .fail (Pair String Int) +ParseError(i, msg)
        }
      end
    }
  that

  def ! p_var : Parser String =
    let ! p_vc (c: Char) : Ret (Option Char) =
      do ascii <- ! (char/codepoint) c;
      let ! digit =
        ! and~ { ! int_lt 47 ascii } { ! int_lt ascii 58 }
      in
      let ! cap =
        ! and~ { ! int_lt 64 ascii } { ! int_lt ascii 91 }
      in
      let ! sml =
        ! and~ { ! int_lt 96 ascii } { ! int_lt ascii 123 }
      in
      ! if~ (Ret (Option Char))
        { ! or~ digit { ! or~ cap sml } }
        { ret +Some(c) }
        { ret +None() }
    in
    comatch | .run s i =>
      let fix var (v: String) (i: Int) =
        do c <- ! str_get_or_space s i;
        do c? <- ! p_vc c;
        do i' <- ! (int/add) i 1;
        match c?
        | +None() =>
          ! if~ (MExnOS (Pair String Int)) {
            do len <- ! (string/length) v;
            ! int_eq len 0
          } {
            ! mexn-err .fail (Pair String Int) +ParseError(i, "variable of length 0")
          } {
            ! mexn .return (Pair String Int) +Cons(v, i)
          }
        | +Some(c) =>
          do c <- ! (char/to_string) c;
          do v <- ! (string/append) v c;
          ! var v i'
        end
      in
      ! var "" i
    end
  that

  def ParserCbpv =
    codata
    | .value : Parser SValue
    | .compu : Parser SCompu
    end
  that

  def fix p_cbpv : ParserCbpv =
    comatch
  | .value =>
    let ! _true =
      ! mp .bind (String) (SValue) { ! p_word "true" } { fn _ =>
        ! mp .return (SValue) +Bool(+True()) }
    in
    let ! _false =
      ! mp .bind (String) (SValue) { ! p_word "false" } { fn _ =>
        ! mp .return (SValue) +Bool(+False()) }
    in
    let ! _var =
      ! mp .bind (String) (SValue) p_var { fn v =>
        ! mp .return (SValue) +Var(v) }
    in
    let ! _thunk =
      ! mp .bind (Char) (SValue) { ! p_char '{' } { fn _ =>
        ! mp .bind (SCompu) (SValue) { ! p_cbpv .compu } { fn sc =>
          ! mp .bind (Char) (SValue) { ! p_char '}' } { fn _ =>
            ! mp .return (SValue) +Thunk(sc) } } }
    in
    ! mp-alt .alt (SValue) _true {
      ! mp-alt .alt (SValue) _false {
        ! mp-alt .alt (SValue) _var {
          ! mp-alt .alt (SValue) _thunk {
            comatch | .run s i =>
              ! mexn-err .fail (Pair SValue Int) +ParseError(i, "expected value")
            end } } } }
  | .compu =>
    let ! _env =
      ! mp .bind (Char) (SCompu) { ! p_char '(' } { fn _ =>
        ! mp .bind (String) (SCompu) { ! p_word "env" } { fn _ =>
          ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
            ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu } { fn sc =>
              ! mp .bind (Char) (SCompu) { ! p_char ')' } { fn _ =>
                ! mp .return (SCompu) +Env(sc) } } } } }
    in
    let ! _ret =
      ! mp .bind (Char) (SCompu) { ! p_char '(' } { fn _ =>
        ! mp .bind (String) (SCompu) { ! p_word "ret" } { fn _ =>
          ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
            ! mp .bind (SValue) (SCompu) { ! p_cbpv .value } { fn sv =>
              ! mp .bind (Char) (SCompu) { ! p_char ')' } { fn _ =>
                ! mp .return (SCompu) +Ret(sv) } } } } }
    in
    let ! _bind =
      ! mp .bind (Char) (SCompu) { ! p_char '(' } { fn _ =>
        ! mp .bind (String) (SCompu) { ! p_word "bind" } { fn _ =>
          ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
            ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu } { fn sc1 =>
              ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
                ! mp .bind (String) (SCompu) p_var { fn v =>
                  ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
                    ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu } { fn sc2 =>
                      ! mp .bind (Char) (SCompu) { ! p_char ')' } { fn _ =>
                        ! mp .return (SCompu) +Bind(sc1, v, sc2) } } } } } } } } }
    in
    let ! _force =
      ! mp .bind (Char) (SCompu) { ! p_char '!' } { fn _ =>
        -- An optional `call` keyword parser could continue here.
        ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
          ! mp .bind (SValue) (SCompu) { ! p_cbpv .value } { fn sv =>
            -- An optional closing-parenthesis parser could continue here.
            ! mp .return (SCompu) +Force(sv) } } }
    in
    let ! _if =
      ! mp .bind (Char) (SCompu) { ! p_char '(' } { fn _ =>
        ! mp .bind (String) (SCompu) { ! p_word "if" } { fn _ =>
          ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
            ! mp .bind (SValue) (SCompu) { ! p_cbpv .value } { fn sv =>
              ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
                ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu } { fn sc1 =>
                  ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
                    ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu } { fn sc2 =>
                      ! mp .bind (Char) (SCompu) { ! p_char ')' } { fn _ =>
                        ! mp .return (SCompu) +If(sv, sc1, sc2) } } } } } } } } }
    in
    let ! _lam =
      ! mp .bind (Char) (SCompu) { ! p_char '(' } { fn _ =>
        ! mp .bind (String) (SCompu) { ! p_word "fn" } { fn _ =>
          ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
            ! mp .bind (String) (SCompu) p_var { fn v =>
              ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
                ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu } { fn sc =>
                  ! mp .bind (Char) (SCompu) { ! p_char ')' } { fn _ =>
                    ! mp .return (SCompu) +Lam(v, sc) } } } } } } }
    in
    let ! _app =
      ! mp .bind (Char) (SCompu) { ! p_char '(' } { fn _ =>
        ! mp .bind (SCompu) (SCompu) { ! p_cbpv .compu } { fn sc =>
          ! mp .bind (Char) (SCompu) { ! p_char ' ' } { fn _ =>
            ! mp .bind (SValue) (SCompu) { ! p_cbpv .value } { fn sv =>
              ! mp .bind (Char) (SCompu) { ! p_char ')' } { fn _ =>
                ! mp .return (SCompu) +App(sc, sv) } } } } }
    in
    ! mp-alt .alt (SCompu) _env {
      ! mp-alt .alt (SCompu) _ret {
        ! mp-alt .alt (SCompu) _bind {
          ! mp-alt .alt (SCompu) _force {
            ! mp-alt .alt (SCompu) _if {
              ! mp-alt .alt (SCompu) _lam {
                ! mp-alt .alt (SCompu) _app {
                  comatch | .run s i =>
                    ! mexn-err .fail (Pair SCompu Int) +ParseError(i, "expected computation")
                  end } } } } } } }
    end
  that

  def ! p_main (s : String) : MExnOS SCompu =
    ! mexn .bind (Pair SCompu Int) (SCompu) { ! p_cbpv .compu .run s 0 } { fn sci =>
      match sci
      | +Cons(sc, i) =>
        ! if~ (MExnOS SCompu) {
          do len <- ! (string/length) s;
          ! int_eq i len
        } {
          ! mexn .return (SCompu) sc
        } {
          ! mexn-err .fail (SCompu) +ParseError(i, "not eof after parsing")
        }
      end }
  that
-- end module Parser

/- Interpretor -/

  def Interp =
    codata
    | .value : SValue -> MExnOS Value
    | .compu : SCompu -> Compu
    end
  that

  def fix interp (env : U EnvO) : Interp =
    comatch
| .value sv =>
match sv
| +Var(x) =>
  do x? <- ! env .lookup x;
  match x?
  | +None() => ! mexn-err .fail Value +FreeVariable()
  | +Some(v) =>
    ! mexn .return Value v
  end
| +Bool(b) =>
  ! mexn .return Value +Bool(b)
| +Int(i) =>
  ! mexn .return Value +Int(i)
| +Thunk(c) =>
  ! mexn .return Value +Thunk({ ! interp env .compu c })
end
| .compu sc =>
let ! type-error =
  ! mexn-err .fail Value +TypeError()
in
match sc
| +Lam(x, sc) =>
  comatch
  | .app v =>
    ! interp { ! env .extend x v } .compu sc
  | .bind _ _ k =>
    ! malg Value type-error { fn v =>
      -- the following is unreachable
      ! k v .app v }
  | .os => ! type-error
  end
| +App(sc, sv) =>
  ! malg Value { ! interp env .value sv } { fn v =>
    ! interp env .compu sc .app v }
| +Ret(sv) =>
  comatch
  | .app _ => ! malg-err .failA +TypeError()
  | .bind _ _ k =>
    ! malg Value { ! interp env .value sv } { fn v =>
      ! k v }
  | .os => ! interp env .value sv
  end
| +Bind(sc1, x, sc2) =>
  ! interp env .compu sc1 .bind x sc2 { fn v =>
    ! interp { ! env .extend x v } .compu sc2 }
| +Force(sv) =>
  ! malg Value { ! interp env .value sv } { fn v =>
    match v
    | +Bool(_) => ! malg-err .failA +TypeError()
    | +Int(_) => ! malg-err .failA +TypeError()
    | +Thunk(c) => ! c
    end }
| +Rec(x, sc) =>
  ! interp { ! env .extend x +Thunk({ ! interp env .compu +Rec(x, sc) }) } .compu sc
| +If(sv, c1, c2) =>
  ! malg Value { ! interp env .value sv } { fn v =>
    match v
    | +Bool(b) =>
      match b
      | +True() => ! interp env .compu c1
      | +False() => ! interp env .compu c2
      end
    | +Int(_) => ! malg-err .failA +TypeError()
    | +Thunk(_) => ! malg-err .failA +TypeError()
    end }
| +Env(sc) =>
  let fix walk (items: List TraceItem): Compu =
    comatch
    | .app v =>
      ! walk +Cons(+App(v), items)
    | .bind x sc k =>
      ! walk +Cons(+Bind(x, sc, k), items)
    | .os =>
      let ! mp : MExnOS Unit =
        comatch | .run ka _ =>
          ! (stdio/write_line) "[[DEBUG]]" {
            ! (stdio/write) "[env]: " {
              ! env .print {
                ! (stdio/write) "[term]: " {
                  ! print-scompu sc {
                    ! (stdio/write_line) "" {
                      ! (stdio/write) "[stack]: " {
                        ! traceo items .print {
                          ! (stdio/write) "Continue? " {
                            ! (stdio/read_line) { fn _ =>
                              ! ka () } } } } } } } } } }
        end
      in
      ! mexn .bind (Unit) Value mp { fn _ =>
        let fix cowalk (items: List TraceItem): Compu =
          match items
          | +Nil() => ! interp env .compu sc
          | +Cons(item, items) =>
            match item
            | +App(v) => ! cowalk items .app v
            | +Bind(x, sc, k) => ! cowalk items .bind x sc k
            end
          end
        in
        ! cowalk items .os }
    end
  in
  ! walk +Nil()
    end
  end
  that

-- module Utils
  def ! value-eq (v1 : Value) (v2 : Value) (k : U OS) : OS =
    let ! expect-bool-panic =
      ! panic "expected bool value"
    in
    let ! expect-int-panic =
      ! panic "expected int value"
    in
    let ! correct =
      ! (stdio/write_line) "\\^o^/" k
    in
    match v1
    | +Bool(b1) =>
      match v2
      | +Bool(b2) =>
        do eq? <- ! bool_eq b1 b2;
        match eq?
        | +True() => ! correct
        | +False() =>
          do b1 <- ! bool_to_str b1;
          do b2 <- ! bool_to_str b2;
          do msg <- ! (string/append) b1 " != ";
          do msg <- ! (string/append) msg b2;
          do msg <- ! (string/append) "wrong bool value: " msg;
          ! panic msg
        end
      | +Int(_) => ! expect-bool-panic
      | +Thunk(_) => ! expect-bool-panic
      end
    | +Int(i1) =>
      match v2
      | +Bool(_) => ! expect-int-panic
      | +Int(i2) =>
        do eq? <- ! int_eq i1 i2;
        match eq?
        | +True() => ! correct
        | +False() =>
          do i1 <- ! (int/to_string) i1;
          do i2 <- ! (int/to_string) i2;
          do msg <- ! (string/append) i1 " != ";
          do msg <- ! (string/append) msg i2;
          do msg <- ! (string/append) "wrong int value: " msg;
          ! panic msg
        end
      | +Thunk(_) => ! expect-int-panic
      end
    | +Thunk(_) => ! panic "thunks are not comparable"
    end
  that

  def ! report (e : Exception) : OS =
    match e
    | +ParseError(loc, msg) =>
      do loc <- ! (int/to_string) loc;
      do loc <- ! (string/append) loc ": ";
      do msg <- ! (string/append) loc msg;
      ! panic msg
    | +FreeVariable() => ! panic "free variable"
    | +TypeError() => ! panic "type error"
    end
  that
-- end module Utils

  def ! nil-env : EnvO =
    ! envo +Empty()
  that

  def ! cbpv-env : EnvO =
    let ! app-int (f: U (Int -> Compu)) : Compu =
    comatch
    | .app v =>
      match v
      | +Bool(_) => ! malg-err .failA +TypeError()
      | +Thunk(_) => ! malg-err .failA +TypeError()
      | +Int(i) => ! f i
      end
    | .bind _ _ _ =>
      ! malg-err .failA +TypeError()
    | .os =>
      ! mexn-err .fail Value +TypeError()
    end
  in
  let ! int-op (op: U (Int -> Int -> Ret Value)) : Compu =
    ! app-int { fn i1 =>
      ! app-int { fn i2 =>
        do v <- ! op i1 i2;
        comatch
        | .app _ => ! malg-err .failA +TypeError()
        | .bind _ _ k =>
          ! malg Value { ! mexn .return Value v } { fn v =>
            ! k v }
        | .os => ! mexn .return Value v
        end } }
  in
  ! envo +Extend("add", +Thunk({
    ! int-op { fn i1 i2 =>
      do i <- ! (int/add) i1 i2;
      ret +Int(i) }
  }), +Extend("mul", +Thunk({
    ! int-op { fn i1 i2 =>
      do i <- ! (int/mul) i1 i2;
      ret +Int(i) }
  }), +Extend("eq", +Thunk({
    ! int-op { fn i1 i2 =>
      do b <- ! int_eq i1 i2;
      ret +Bool(b) }
  }), +Empty())))
  that

  def ! demo-scompu (env : U EnvO) (term : SCompu) (ans : Value) (k : U OS) : OS =
    ! interp env .compu term .os .run { fn v =>
      ! value-eq v ans k
    } report
  that

  def ! demo (env : U EnvO) (src : String) (ans : Value) (k : U OS) : OS =
    ! p_main src .run { fn term =>
      ! demo-scompu env term ans k
    } report
  that

  -- if clause
  ! demo nil-env "(if true (ret true) (ret false))" +Bool(+True()) {

  -- 4 envs: first with a bind stack, second with x in env, third with an app stack, and last with only variables in env
  -- Disabled continuation: ! demo nil-env "(bind (env (ret true)) x (env ((env (fn b (if b (env (ret x)) (ret false)))) true)))" +Bool(+True())

  -- lambda in thunk
  -- Disabled continuation: ! demo nil-env "(bind (ret {(fn x (if x (ret false) (ret true)))}) not (bind (env (ret false)) x (! not x)))" +Bool(+True())

  -- bind to lambda should fail
  -- Disabled continuation: ! demo nil-env "(bind (fn x (ret x)) f (ret true))" +Bool(+True())

  -- apply to ret should fail
  -- Disabled continuation: ! demo nil-env "((ret true) true)" +Bool(+True())

  -- call a bool should fail
  -- Disabled continuation: ! demo nil-env "! true" +Bool(+True())

  -- test `! add 1 2`
    ! demo-scompu cbpv-env +App(+App(+Force(+Var("add")), +Int(1)), +Int(2)) +Int(3) {

    -- test `! mul 3 2`
