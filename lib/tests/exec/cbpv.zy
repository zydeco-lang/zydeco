-- A monad structure that supports fail and print as well
begin
  let monadic_basis = @(import("../../std/control/monad.zy")) that
  param (
    (/core; /representations; /text; /system; builtin) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/VType; /CType; /Thk; /Ret; /Unit) = core that
  let (/String) = representations/string that
  let string = text/string that
  let (/OS; /stdio; /process) = system that
  let (= Monad, = Algebra, ()) = monadic_basis builtin in
  begin

    def Bool =
      data
      | +True : Unit
      | +False : Unit
      end
    that
    def Option (A : VType) =
      data
      | +None : Unit
      | +Some : A
      end
    that
    def Exception =
      data
      | +TypeError : Unit
      | +FreeVariable : Unit
      end
    that
    def MonadErrPrint (M : VType -> CType) =
      codata
      | .return :
        forall (A : VType) . A -> M A
      | .bind :
        forall (A : VType) (A' : VType) .
             Thk (M A)
          -> Thk (A -> M A')
          -> M A'
      | .fail :
        forall (A : VType) . Exception -> M A
      | .print :
        String -> M Unit
      end
    that
    def MExnOS (A : VType) =
      -- Continuation-based error monad
      codata
      | .run :
           Thk (A -> OS)
        -> Thk (Exception -> OS)
        -> OS
      end
    that

    def EnvT : VType =
      data
      | +Empty : Unit
      | +Extend : String * Value * EnvT
      end
    that
    def EnvO : CType =
      codata
      | .lookup : String -> Ret (Option Value)
      | .extend : String -> Value -> EnvO
      end
    that
    def Value : VType =
      data
      | +Bool : Bool
      | +Thunk : Thk Compu
      end
    that
    def Compu : CType =
      codata
      | .app : Value -> Compu
      | .bind : MExnOS Value
      end
    that
    def SValue : VType =
      data
      | +Var : String
      | +Bool : Bool
      | +Thunk : SCompu
      end
    that
    def SCompu : VType =
      data
      | +Lam : String * SCompu
      | +App : SCompu * SValue
      | +Ret : SValue
      | +Bind : SCompu * String * SCompu
      | +Force : SValue
      | +If : SValue * SCompu * SCompu
      end
    that
    def Interp =
      codata
      | .value : SValue -> MExnOS Value
      | .compu : SCompu -> Compu
      end
    that

    def ! mexn : MonadErrPrint MExnOS =
      comatch
      | .return A a =>
        comatch
        | .run ka _ => ! ka a
        end
      | .bind A A' m f =>
        comatch
        | .run ka ke => ! m .run
          {
            fn a => ! f a .run ka ke
          }
          {
            fn e => ! ke e
          }
        end
      | .fail A e =>
        comatch
        | .run _ ke => ! ke e
        end
      | .print s =>
        comatch
        | .run ka _ => ! (stdio/write_line) s {
          ! ka ()
        }
        end
      end
    that
    def ! bool_eq (b : Bool) (b' : Bool) : Ret Bool =
      match b
      | +True() =>
        match b'
        | +True() => ret +True()
        | +False() => ret +False()
        end
      | +False() =>
        match b'
        | +True() => ret +False()
        | +False() => ret +True()
        end
      end
    that
    def ! str_eq (left : String) (right : String) : Ret Bool = ! (string/eq)
      (Ret Bool)
      left
      right
      { ret +True() }
      {
        ret +False()
      } that
    def fix envo (env : EnvT) : EnvO =
      comatch
      | .lookup x =>
        match env
        | +Empty() => ret +None()
        | +Extend(x', v, env') =>
          do is-eq? <- ! str_eq x x';
          match is-eq?
          | +True() => ret +Some(v)
          | +False() => ! envo env' .lookup x
          end
        end
      | .extend x v => ! envo +Extend(x, v, env)
      end
    that
    def ! abort (e : Exception) : Compu = fix (unwind : Thk Compu) =>
      comatch
      | .app _ => ! unwind
      | .bind => ! mexn .fail Value e
      end that
    def fix malg : Algebra MExnOS Compu = fn A m f =>
      -- m : U (MExnOS A), f: U (A -> Compu)
      comatch
      | .app a =>
        -- goal: Compu
        ! malg A m {
          fn v => ! f v .app a
        }
      | .bind =>
        -- goal: MExnOS Value, use ordinary bind
        ! mexn .bind A Value m {
          fn x => ! f x .bind
        }
      end that
    def fix interp (env : Thk EnvO) : Interp =
      comatch
      | .value sv =>
        match sv
        | +Var(x) =>
          do x? <- ! env .lookup x;
          match x?
          | +None() => ! mexn .fail Value +FreeVariable()
          | +Some(v) => ! mexn .return Value v
          end
        | +Bool(b) => ! mexn .return Value +Bool(b)
        | +Thunk(c) => ! mexn .return Value +Thunk(
          {
            ! interp env .compu c
          }
        )
        end
      | .compu sc =>
        match sc
        | +Lam(x, sc) =>
          comatch
          | .app v => ! interp
            { ! env .extend x v } .compu
            sc
          | .bind => ! mexn .fail Value +TypeError()
          end
        | +App(sc, sv) =>
          let ! mv = ! interp env .value sv in
          ! malg Value mv {
            fn v => ! interp env .compu sc .app v
          }
        | +Ret(sv) =>
          let fix unwind (m : Thk (MExnOS Value)) : Compu =
            comatch
            | .app _ => ! unwind {
              ! mexn .fail Value +TypeError()
            }
            | .bind => ! m
            end
          in
          ! unwind {
            ! interp env .value sv
          }
        | +Bind(sc1, x, sc2) =>
          let ! mv = ! interp env .compu sc1 .bind in
          ! malg Value mv {
            fn v =>
              ! interp
                { ! env .extend x v } .compu
                sc2
          }
        | +Force(sv) =>
          let ! mv = ! interp env .value sv in
          ! malg Value mv {
            fn v =>
              match v
              | +Bool(_) => ! abort +TypeError()
              | +Thunk(c) => ! c
              end
          }
        | +If(sv, c1, c2) =>
          let ! mv = ! interp env .value sv in
          ! malg Value mv {
            fn v =>
              match v
              | +Bool(b) =>
                match b
                | +True() => ! interp env .compu c1
                | +False() => ! interp env .compu c2
                end
              | +Thunk(_) => ! abort +TypeError()
              end
          }
        end
      end
    that

    let ! env : EnvO = ! envo +Empty() in
    let ! report (e : Exception) : OS =
      match e
      | +TypeError() => ! (process/exit) 1
      | +FreeVariable() => ! (process/exit) 1
      end
    in
    let ! value-eq (v1 : Value) (v2 : Value) (k : Thk OS) : OS =
      let ! bool-value-panic =
        ! (process/exit) 1
      in
      let ! thunk-panic = ! (process/exit) 1 in
      match v1
      | +Bool(b1) =>
        match v2
        | +Bool(b2) =>
          do eq? <- ! bool_eq b1 b2;
          match eq?
          | +True() => ! (stdio/write_line) "\\^o^/" k
          | +False() => ! bool-value-panic
          end
        | +Thunk(_) => ! thunk-panic
        end
      | +Thunk(_) => ! thunk-panic
      end
    in
    let ! demo (term : SCompu) (ans : Value) (k : Thk OS) : OS = ! interp env .compu term .bind .run
      {
        fn v => ! value-eq v ans k
      }
      report in
    -- if true then ret true else ret false
    let term1 : SCompu = +If(
      +Bool(+True()),
      +Ret(+Bool(+True())),
      +Ret(+Bool(+False()))
    ) in
    let ans1 : Value = +Bool(+True()) in
    -- (do x <- ret True in \b -> if b then x else false) True
    let term2 : SCompu = +App(
      +Bind(
        +Ret(+Bool(+True())),
        "x",
        +Lam(
          "b",
          +If(
            +Var("b"),
            +Ret(+Var("x")),
            +Ret(+Bool(+False()))
          )
        )
      ),
      +Bool(+True())
    ) in
    let ans2 : Value = +Bool(+True()) in
    ! demo term1 ans1 {
      ! demo term2 ans2 {
        ! (process/exit) 0
      }
    }
  end
end
