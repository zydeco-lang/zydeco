alias Point = (x :: Int) * (y :: Int) end
alias Rectangle = (top_left :: Point) * (status :: Int) end
alias Triple = (first :: Int) * ((middle :: Int) * (last :: Int)) end
alias Nested = ((inner_x :: Int) * (inner_y :: Int)) * (outer :: Int) end

def rectangle : Rectangle = (
  top_left = (x = 5, y = 1),
  status = 0
) end

def triple : Triple = (first = 7, middle = -3, last = -4) end
def nested : Nested = ((inner_x = 0, inner_y = -12), outer = 0) end
def first_global : Int = triple/first end

main
  let (top_left = point, = status : Int) = rectangle in
  let status_field = (= status : Int) in
  let direct = (code = point/x) in
  let (inner, outer = _) = nested in
  let pair = (triple/first, triple/last) in
  let (first, last) = pair in
  do total <- ! add first triple/middle;
  do total <- ! add total last;
  do total <- ! add total inner/inner_y;
  do total <- ! add total direct/code;
  do total <- ! add total first_global;
  do total <- ! add total status_field/status;
  ! exit total
end
