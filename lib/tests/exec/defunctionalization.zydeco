begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def List : (VType) -> (VType) =
    begin
      param (A : VType) that
      data
      | +Nil : Unit
      | +Cons : A * List A
      end
    end
  that
  def Summer : CType =
    codata
    | .done : Ret Int
    | .addN : Int -> Summer
    end
  that
  def Summer' : CType =
    codata
    | .add : Int -> Ret Int
    end
  that

  def sum_bad : Thk (List Int -> Ret Int) = {
    fix (sum_bad : Thk (List Int -> Ret Int)) ->
      fn values ->
        match values
        | +Nil() -> ret 0
        | +Cons(head, tail) ->
          do accumulated <- ! sum_bad tail;
          ! (api/add) accumulated head
        end
  } that
  def ret_summer : Thk (Int -> Summer) = {
    fix (ret_summer : Thk (Int -> Summer)) ->
      fn accumulated ->
        comatch
        | .done -> ret accumulated
        | .addN next ->
          do accumulated <- ! (api/add) accumulated next;
          ! ret_summer accumulated
        end
  } that
  def sum_ok : Thk (List Int -> Summer) = {
    fix (sum_ok : Thk (List Int -> Summer)) ->
      fn values ->
        match values
        | +Nil() -> ! ret_summer 0
        | +Cons(head, tail) -> ! sum_ok tail .addN head
        end
  } that
  def sum_better : Thk (List Int -> Summer) = {
    fix (sum_better : Thk (List Int -> Summer)) ->
      fn values ->
        match values
        | +Nil() -> ! ret_summer 0
        | +Cons(head, tail) ->
          comatch
          | .done -> ! sum_better tail .addN head .done
          | .addN next ->
            do accumulated <- ! (api/add) head next;
            ! sum_better tail .addN accumulated
          end
        end
  } that
  def sum_best : Thk (List Int -> Summer') = {
    fix (sum_best : Thk (List Int -> Summer')) ->
      fn values ->
        match values
        | +Nil() ->
          comatch
          | .add accumulated -> ret accumulated
          end
        | +Cons(head, tail) ->
          comatch
          | .add accumulated ->
            do accumulated <- ! (api/add) head accumulated;
            ! sum_best tail .add accumulated
          end
        end
  } that
  def sum : Thk (List Int -> Ret Int) = {
    fn values ->
      ! sum_best values .add 0
  } that

  do result <- ! sum (+Cons(5, +Cons(13, +Nil())));
  do rendered <- ! (api/int_to_str) result;
  ! (api/write_line) rendered { ! (api/exit) 0 }
end
