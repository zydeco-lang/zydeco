begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let FnRet (A : VType) =
    codata
    | .arg : A -> Ret A
    end
  that
  let FnOpt (A : VType) =
    codata
    | .one : A -> Ret A
    | .zero : Ret A
    end
  that
  def fn_int : Thk (FnRet Int) = {
    comatch
    | .arg i -> ret i
    end
  } that
  def fn_opt_int : Thk (FnOpt Int) = {
    comatch
    | .one i -> ! fn_int .arg i
    | .zero -> ! fn_int .arg 0
    end
  } that

  do x <- ! fn_opt_int .zero;
  ! (api/exit) x
end
