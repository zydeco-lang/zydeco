begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def FnRet : (VType) -> (CType) =
    begin
      param (A : VType) that
      codata
      | .arg : A -> Ret A
      end
    end
  that
  def FnOpt : (VType) -> (CType) =
    begin
      param (A : VType) that
      codata
      | .one : A -> Ret A
      | .zero : Ret A
      end
    end
  that
  def fn_int : Thk (FnRet Int) = {
    comatch
    | .arg value -> ret value
    end
  } that
  def fn_opt_int : Thk (FnOpt Int) = {
    comatch
    | .one value -> ! fn_int .arg value
    | .zero -> ! fn_int .arg 0
    end
  } that

  do status <- ! fn_opt_int .zero;
  ! (api/exit) status
end
