begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def fix odd : Nat -> Ret Bool =
    let fix even (x : Nat) : Ret Bool =
        match x
      | +Z() => ret +True()
      | +S(x) => ! odd x
      end
      in
    fn (x : Nat) =>
      match x
      | +Z() => ret +False()
      | +S(x) => ! even x
      end
  that

  do b <- ! odd +S(+S(+S(+Z())));
  match b
  | +True() => ! (api/exit) 0
  | +False() => ! (api/exit) 1
  end
end
