begin
  param (/core; /system) : @(import("../../std/builtin.zy")) that
  let (/VType; /Ret; /Unit) = core that
  let (/process) = system that

  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def fix odd : Nat -> Ret Bool =
    let fix even (x : Nat) : Ret Bool =
      match x
      | +Z() => ret +True()
      | +S(x) => ! odd x
      end
    in
    fn (x : Nat) =>
      match x
      | +Z() => ret +False()
      | +S(x) => ! even x
      end
  that

  do b <- ! odd +S(+S(+S(+Z())));
  match b
  | +True() => ! process/exit 0
  | +False() => ! process/exit 1
  end
end
