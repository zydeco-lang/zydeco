-- Semicolon patterns observe one bindee repeatedly while preserving source order.
begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let Pair = Int * Int that
  def pair : Pair = (20, 22) that

  def compare_aliases : Thk (Pair -> Ret Int) = {
    fn ((left : Int, right : Int); whole; copy) =>
      let (whole_left : Int, whole_right : Int) = whole in
      let (copy_left : Int, copy_right : Int) = copy in
      do direct <- ! (api/add) left right;
      do through_whole <- ! (api/add) whole_left whole_right;
      do through_copy <- ! (api/add) copy_left copy_right;
      do whole_delta <- ! (api/sub) direct through_whole;
      do copy_delta <- ! (api/sub) direct through_copy;
      do total <- ! (api/add) whole_delta copy_delta;
      ret total
  } that

  do result <- ! compare_aliases pair;
  ! (api/exit) result
end
