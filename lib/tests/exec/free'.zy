begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  let Kont :
    (CType) ->
    (VType) ->
    (CType) =
    begin
      param (R : CType) that
      param (A : VType) that
      Thk (A -> R) -> R
    end
  that
  def Bool : VType =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def Empty : VType =
    data
    end
  that
  def Err : VType =
    data
    | +Msg : String
    end
  that
  def Handlers :
    (
      (CType) ->
      (CType) ->
      (CType)
    ) =
    begin
      param (R : CType) that
      param (K : CType) that
      codata
      | .eff :
        Thk (String -> Kont R Bool) ->
        Thk (Err -> Kont R Empty) ->
        Thk (Unit -> Kont R Bool) ->
        K
      end
    end
  that
  def Free :
    (
      (
        (CType) ->
        (CType) ->
        (CType)
      ) ->
      (VType) ->
      (CType)
    ) =
    begin
      param (
        H :
        (CType) ->
        (CType) ->
        (CType)
      ) that
      param (A : VType) that
      codata
      | .run :
        forall (R : CType) .
          H R (Kont R A)
      end
    end
  that

  def mfree : Thk (Monad (Free Handlers)) = {
    comatch
    | .return A value ->
      fn .run R ->
        fn .eff print_handler fail_handler flip_handler continuation ->
          ! continuation value
    | .bind A B computation function ->
      fn .run R ->
        fn .eff print_handler fail_handler flip_handler continuation ->
          ! computation .run R
            .eff
            print_handler
            fail_handler
            flip_handler
            {
              fn value ->
                ! function value .run R
                  .eff
                  print_handler
                  fail_handler
                  flip_handler
                  continuation
            }
    end
  } that
  def print : Thk (String -> Free Handlers Bool) = {
    fn string ->
      fn .run R ->
        fn .eff print_handler fail_handler flip_handler ->
          ! print_handler string
  } that
  def fail : Thk (Err -> Free Handlers Empty) = {
    fn error ->
      fn .run R ->
        fn .eff print_handler fail_handler flip_handler ->
          ! fail_handler error
  } that
  def flip : Thk (Free Handlers Bool) = {
    fn .run R ->
      fn .eff print_handler fail_handler flip_handler ->
        ! flip_handler ()
  } that
  def print_os : Thk (String -> Thk (Bool -> OS) -> OS) = {
    fn string continuation ->
      ! (api/write_line) string { ! continuation +True() }
  } that
  def print_string : Thk (
    String ->
    Thk (Bool -> Ret String) ->
    Ret String
  ) = {
    fn string continuation ->
      do suffix <- ! continuation +True();
      ! (api/str_append) string suffix
  } that
  def fail_os : Thk (Err -> Thk (Empty -> OS) -> OS) = {
    fn error continuation ->
      match error
      | +Msg(message) ->
        ! (api/write_line) message { ! (api/exit) 1 }
      end
  } that
  def flip_os : Thk (Unit -> Thk (Bool -> OS) -> OS) = {
    fn unit continuation ->
      ! (api/random_int) {
        fn random ->
          do remainder <- ! (api/mod) random 2;
          ! (api/int_eq_branch)
            OS
            remainder
            0
            { ! continuation +True() }
            { ! continuation +False() }
      }
  } that

  let program : Thk (Free Handlers Unit) = {
    ! mfree .bind Bool Unit
      { ! print "a" }
      {
        fn _ ->
          ! mfree .bind Bool Unit
            { ! print "b" }
            {
              fn _ ->
                ! mfree .bind Bool Unit
                  { ! flip }
                  {
                    fn choice ->
                      ! mfree .bind Bool Unit
                        {
                          match choice
                          | +True() -> ! print "+"
                          | +False() -> ! print "-"
                          end
                        }
                        {
                          fn _ ->
                            ! mfree .return Unit ()
                        }
                  }
            }
      }
  } in
  ! program .run OS .eff print_os fail_os flip_os {
    fn _ ->
      ! (api/exit) 0
  }
end
end
