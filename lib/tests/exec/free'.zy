begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
  begin

  let Kont (R : CType) (A : VType) =
    Thk (A -> R) -> R
  that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def Empty =
    data
    end
  that
  def Err =
    data
    | +Msg : String
    end
  that
  def Handlers (R : CType) (K : CType) =
    codata
    | .eff :
      -- print : String ~> Bool
      Thk (String -> Kont R Bool) ->
      -- fail : Err ~> Empty
      Thk (Err -> Kont R Empty) ->
      -- flip : Unit ~> Bool
      Thk (Unit -> Kont R Bool) ->
      K
    end
  that
  def Free (H : (CType) -> (CType) -> (CType)) (A : VType) =
    codata
    | .run :
      forall (R : CType) .
        H R (Kont R A)
    end
  that

  def ! mfree : Monad (Free Handlers) =
    comatch
    | .return A a ->
      fn .run R ->
        fn .eff print fail flip k ->
          ! k a
    | .bind A A' m f ->
      fn .run R ->
        fn .eff print fail flip k' ->
          ! m .run R
            .eff
            print
            fail
            flip
            {
              fn a ->
                ! f a .run R
                  .eff
                  print
                  fail
                  flip
                  k'
            }
    end
  that
  def ! print (string : String) : Free Handlers Bool =
    fn .run R ->
      fn .eff print fail flip ->
        ! print string
  that
  def ! fail (error : Err) : Free Handlers Empty =
    fn .run R ->
      fn .eff print fail flip ->
        ! fail error
  that
  def ! flip : Free Handlers Bool =
    fn .run R ->
      fn .eff print fail flip ->
        ! flip ()
  that
  def ! print-os (string : String) (k : Thk (Bool -> OS)) : OS =
    ! (api/write_line) string { ! k +True() }
  that
  def ! print-str (string : String) (k : Thk (Bool -> Ret String)) : Ret String =
    do suffix <- ! k +True();
    ! (api/str_append) string suffix
  that
  def ! fail-os (error : Err) (continuation : Thk (Empty -> OS)) : OS =
    match error
    | +Msg(message) ->
      ! (api/write_line) message { ! (api/exit) 1 }
    end
  that
  def ! flip-os (unit : Unit) (continuation : Thk (Bool -> OS)) : OS =
    ! (api/random_int) {
      fn random ->
        do remainder <- ! (api/mod) random 2;
        ! (api/int_eq_branch)
          OS
          remainder
          0
          { ! continuation +True() }
          { ! continuation +False() }
    }
  that

  let ! m : Free Handlers Unit =
    ! mfree .bind Bool Unit
      { ! print "a" }
      {
        fn _ ->
          ! mfree .bind Bool Unit
            { ! print "b" }
            {
              fn _ ->
                ! mfree .bind Bool Unit
                  { ! flip }
                  {
                    fn choice ->
                      ! mfree .bind Bool Unit
                        {
                          match choice
                          | +True() -> ! print "+"
                          | +False() -> ! print "-"
                          end
                        }
                        {
                          fn _ ->
                            ! mfree .return Unit ()
                        }
                  }
            }
      }
  in
  ! m .run OS .eff print-os fail-os flip-os {
    fn _ ->
      ! (api/exit) 0
  }
end
end
