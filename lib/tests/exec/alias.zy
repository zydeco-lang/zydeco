begin
  let make_std = @(import("../../std/std.zy")) that
  param (
    (/representations; /system; builtin) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/Int64) = representations/i64 that
  let (/OS) = system that

  let (/process) = builtin |> make_std in
  begin
    let Num = Int64 that
    def ! done (x : Num) : OS = ! (process/exit) x that

    ! done 0
  end
end
