begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (/Int64; /OS; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/process) =
    make_std builtin
  in
  begin
    let Num = Int64 that
    def ! done (x : Num) : OS =
      ! (process/exit) x
    that

    ! done 0
  end
end
