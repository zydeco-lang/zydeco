begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin
    let Num = StdInt that
    def done : Thk (Num -> StdOS) = {
      fn (x : Num) ->
        ! (std/os/exit) x
    } that

    ! done 0
  end
end
