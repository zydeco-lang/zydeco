begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let (/Int = StdInt; /OS = StdOS; /process) =
    make_std (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api)
  in
  begin
    let Num = StdInt that
    def ! done (x : Num) : StdOS =
      ! (process/exit) x
    that

    ! done 0
  end
end
