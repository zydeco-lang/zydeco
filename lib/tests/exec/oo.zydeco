-- We can do good old object-oriented programming in here
-- e.g. define a Counter that can incr and project out Int or String
begin
  param (
    (/CType; /Thk; /Ret; /Int; /String; /int; /stdio; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Counter : CType =
    codata
    | .num : Ret Int
    | .incr : Int -> Counter
    | .fmt : Ret String
    end
  that
  -- We can use `this` (or `self`) as in normal OO languages
  def fix mk_counter (n : Int) : Counter =
    fix (this : Thk Counter) =>
      comatch
      | .num => ret n
      | .incr i =>
        do j <- ! this .num;
        do n <- ! (int/add) i j;
        ! mk_counter n
      | .fmt =>
        do n <- ! this .num;
        ! (int/to_string) n
      end
  that

  let ! counter_42 : Counter =
    ! mk_counter 42
  in
  do s <- ! counter_42 .fmt;
  ! (stdio/write_line) s {
    do n <- ! counter_42 .incr -42 .num;
    ! (process/exit) n
  }
end
