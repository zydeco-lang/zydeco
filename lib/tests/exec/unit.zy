-- Unit defined in std.zydeco
begin
  param (
    (
      /Ret;
      /Unit;
      /String;
      /write_line;
      /exit
    ) :
    @[import("../../std/builtin.zy")] _
  ) that

  def ! unit_to_str (_ : Unit) : Ret String =
    ret "()"
  that

  let v : Unit = () in
  do x <- ! unit_to_str v;
  ! (write_line) x { ! (exit) 0 }
end
