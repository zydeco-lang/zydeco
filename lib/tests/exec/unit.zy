-- Unit defined in std.zydeco
begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def unit_to_str : Thk (Unit -> Ret String) = {
    fn (_ : Unit) ->
      ret "()"
  } that

  let v : Unit = () in
  do x <- ! unit_to_str v;
  ! (api/write_line) x { ! (api/exit) 0 }
end
