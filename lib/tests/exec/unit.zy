-- Unit defined in std.zydeco
begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, Bytes, Reader, Writer, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def ! unit_to_str (_ : Unit) : Ret String =
    ret "()"
  that

  let v : Unit = () in
  do x <- ! unit_to_str v;
  ! (api/write_line) x { ! (api/exit) 0 }
end
