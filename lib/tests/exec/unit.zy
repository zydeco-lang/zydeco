-- Unit defined in std.zydeco
begin
  param (
    (/Ret; /Unit; /String; /stdio; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  def ! unit_to_str (_ : Unit) : Ret String =
    ret "()"
  that

  let v : Unit = () in
  do x <- ! unit_to_str v;
  ! (stdio/write_line) x { ! (process/exit) 0 }
end
