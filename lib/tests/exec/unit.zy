-- Unit defined in std.zydeco
begin
  param (
    (/core; /representations; /system) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/Ret; /Unit) = core that
  let (/Scalar = String) = representations/string that
  let (/stdio; /process) = system that

  def ! unit_to_str (_ : Unit) : Ret String =
    ret "()"
  that

  let v : Unit = () in
  do x <- ! unit_to_str v;
  ! (stdio/write_line) x { ! (process/exit) 0 }
end
