-- Codata destructors remain dot eliminations. Their arguments and results may
-- use named value types, and slash can project from a returned named value.
begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Gauge =
    codata
    | .read : Ret ((reading :: Int) * Int)
    | .shift : (delta :: Int) -> Ret (reading :: Int)
    end
  that
  let GaugeBox =
    Int * (gauge :: Thk Gauge)
  that
  def gauge : Thk Gauge = {
    comatch
    | .read ->
      ret (reading = 12 : Int, 13 : Int)
    | .shift (delta = delta : Int) ->
      ret (reading = delta : Int)
    end
  } that
  def gauge_box : GaugeBox = (
    0,
    gauge = gauge
  ) that

  let (
    marker : Int,
    gauge = active_gauge : Thk Gauge
  ) = gauge_box in
  do observation <- ! active_gauge .read;
  let (
    reading = reading : Int,
    drift : Int
  ) = observation in
  do reading_check <- ! (api/sub) reading 12;
  do drift_check <- ! (api/sub) drift 13;
  do shifted <- ! active_gauge .shift (delta = 14 : Int);
  let (reading = shifted_reading : Int) = shifted in
  do shifted_pattern_check <- ! (api/sub) shifted_reading 14;
  do shifted_projection_check <- ! (api/sub) shifted/reading 14;
  do total <- ! (api/add) marker reading_check;
  do total <- ! (api/add) total drift_check;
  do total <- ! (api/add) total shifted_pattern_check;
  do total <- ! (api/add) total shifted_projection_check;
  ! (api/exit) total
end
