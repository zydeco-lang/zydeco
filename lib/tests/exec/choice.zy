begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def Tree (A : VType) : VType =
    data
    | +Fork : Tree A * Tree A
    | +Final : A
    end
  that
  def Choice (B : CType) =
    data
    | +L : Thk B
    | +R : Thk B
    end
  that
  def Path (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * Path A
    end
  that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  def beep : Choice (Thk StdOS -> StdOS) =
    +L({
      fn k ->
        ! (std/os/write_line) "0" k
    })
  in
  def boop : Choice (Thk StdOS -> StdOS) =
    +R({
      fn k ->
        ! (std/os/write_line) "1" k
    })
  in
  def tree : Tree StdString =
    +Fork(
      +Fork(+Final("x"), +Final("o")),
      +Final("x")
    )
  in
  def path : Path (Choice (Thk StdOS -> StdOS)) =
    +Cons(beep, +Cons(boop, +Nil()))
  in
  def walk : Thk (
    Tree StdString ->
    Path (Choice (Thk StdOS -> StdOS)) ->
    StdOS
  ) = {
    fix (
      walk :
      Thk (
        Tree StdString ->
        Path (Choice (Thk StdOS -> StdOS)) ->
        StdOS
      )
    ) ->
      fn t p ->
        match t
        | +Final(res) ->
          match p
          | +Nil() ->
            ! (std/os/write_line) res {
              do correct <- ! (std/string/eq) res "o";
              ! (std/bool/if)
                StdOS
                correct
                { ! (std/os/exit) 0 }
                { ! (std/os/exit) 1 }
            }
          | +Cons(_, _) -> ! (std/os/exit) 2
          end
        | +Fork(tl, tr) ->
          match p
          | +Nil() -> ! (std/os/exit) 3
          | +Cons(c, p') ->
            match c
            | +L(k) -> ! k { ! walk tl p' }
            | +R(k) -> ! k { ! walk tr p' }
            end
          end
        end
  } in

  ! walk tree path
end
