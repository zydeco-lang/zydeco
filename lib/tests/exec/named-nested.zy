-- Explicit product nesting remains significant, while directly nested Named
-- wrappers support chained patterns and projections.
begin
  param (
    (/numeric; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (#Scalar = Int64, int64) = numeric/int64 that
  let (/process) = system that

  let Inner = (#x :: Int64) * Int64 that
  let Outer = Inner * (#z :: Int64) that
  let Wrapped = (#outer :: #inner :: Int64) that
  let Ambiguous = (#left :: #x :: Int64) * (#right :: #x :: Int64) that
  let Punnable = (#punned :: Int64) that
  def nested : Outer = (
    (#x = 5 : Int64, 6 : Int64),
    #z = 7 : Int64
  ) that
  def wrapped : Wrapped = (
    #outer = #inner = 8 : Int64
  ) that
  def ambiguous : Ambiguous = (
    #left = #x = 9 : Int64,
    #right = #x = 10 : Int64
  ) that
  def punnable : Punnable = (
    #punned = 11 : Int64
  ) that

  let (
    inner : Inner,
    = z : Int64
  ) = nested in
  let (
    = x : Int64,
    y : Int64
  ) = inner in
  let (
    #outer = #inner = wrapped_value : Int64
  ) = wrapped in
  let (
    /x = projected_x : Int64;
    /z = projected_z : Int64;
    projected_nested
  ) = nested in
  let (
    /inner = projected_inner : Int64;
    /outer = /inner = chained_projected_inner : Int64;
    projected_wrapped
  ) = wrapped in
  let (/left = /x = left_x : Int64; /right = /x = right_x : Int64) = ambiguous in
  let (
    /punned : Int64;
    punnable_whole
  ) = punnable in
  do tens <- ! (int64/mul) y 10;
  do hundreds <- ! (int64/mul) z 100;
  do low <- ! (int64/add) x tens;
  do checksum <- ! (int64/add) low hundreds;
  do layout_check <- ! (int64/sub) checksum 765;
  do nested_projection_check <- ! (int64/sub) nested/x 5;
  do outer_projection_check <- ! (int64/sub) nested/z 7;
  do recursive_label_projection_check <- ! (int64/sub) wrapped/inner 8;
  do chained_projection_check <- ! (int64/sub) wrapped/outer/inner 8;
  do chained_pattern_check <- ! (int64/sub) wrapped_value 8;
  do x_pattern_check <- ! (int64/sub) projected_x 5;
  do z_pattern_check <- ! (int64/sub) projected_z 7;
  do nested_alias_check <- ! (int64/sub) projected_nested/x 5;
  do inner_pattern_check <- ! (int64/sub) projected_inner 8;
  do chained_projection_pattern_check <- ! (int64/sub) chained_projected_inner 8;
  do wrapped_alias_check <- ! (int64/sub) projected_wrapped/inner 8;
  do disambiguated_left_check <- ! (int64/sub) left_x 9;
  do disambiguated_right_check <- ! (int64/sub) right_x 10;
  do punned_projection_pattern_check <- ! (int64/sub) punned 11;
  do punned_alias_check <- ! (int64/sub) punnable_whole/punned 11;
  do total <- ! (int64/add) layout_check nested_projection_check;
  do total <- ! (int64/add) total outer_projection_check;
  do total <- ! (int64/add) total recursive_label_projection_check;
  do total <- ! (int64/add) total chained_projection_check;
  do total <- ! (int64/add) total chained_pattern_check;
  do total <- ! (int64/add) total x_pattern_check;
  do total <- ! (int64/add) total z_pattern_check;
  do total <- ! (int64/add) total nested_alias_check;
  do total <- ! (int64/add) total inner_pattern_check;
  do total <- ! (int64/add) total chained_projection_pattern_check;
  do total <- ! (int64/add) total wrapped_alias_check;
  do total <- ! (int64/add) total disambiguated_left_check;
  do total <- ! (int64/add) total disambiguated_right_check;
  do total <- ! (int64/add) total punned_projection_pattern_check;
  do total <- ! (int64/add) total punned_alias_check;
  ! (process/exit) total
end
