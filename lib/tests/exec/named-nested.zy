-- Explicit product nesting remains significant, while directly nested Named
-- wrappers support chained patterns and projections.
alias Inner =
  (x :: Int) * Int
end

alias Outer =
  Inner * (z :: Int)
end

alias Wrapped =
  (outer :: inner :: Int)
end

def nested : Outer = (
  (x = 5 : Int, 6 : Int),
  z = 7 : Int
) end

def wrapped : Wrapped = (
  outer = inner = 8 : Int
) end

main
  let (
    inner : Inner,
    z = z : Int
  ) = nested in
  let (
    x = x : Int,
    y : Int
  ) = inner in
  let (
    outer = inner = wrapped_value : Int
  ) = wrapped in

  do tens <- ! mul y 10;
  do hundreds <- ! mul z 100;
  do low <- ! add x tens;
  do checksum <- ! add low hundreds;
  do layout_check <- ! sub checksum 765;

  do inner_projection_check <- ! sub inner/x 5;
  do outer_projection_check <- ! sub nested/z 7;
  do chained_projection_check <- ! sub wrapped/outer/inner 8;
  do chained_pattern_check <- ! sub wrapped_value 8;

  do total <- ! add layout_check inner_projection_check;
  do total <- ! add total outer_projection_check;
  do total <- ! add total chained_projection_check;
  do total <- ! add total chained_pattern_check;
  ! exit total
end
