-- Explicit product nesting remains significant, while directly nested Named
-- wrappers support chained patterns and projections.
begin
  param (
    (/Int; /int; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  let Inner =
    (x :: Int) * Int
  that
  let Outer =
    Inner * (z :: Int)
  that
  let Wrapped =
    (outer :: inner :: Int)
  that
  let Ambiguous =
    (left :: (x :: Int)) * (right :: (x :: Int))
  that
  let Punnable =
    (punned :: Int)
  that
  def nested : Outer = (
    (x = 5 : Int, 6 : Int),
    z = 7 : Int
  ) that
  def wrapped : Wrapped = (
    outer = inner = 8 : Int
  ) that
  def ambiguous : Ambiguous = (
    left = x = 9 : Int,
    right = x = 10 : Int
  ) that
  def punnable : Punnable = (
    punned = 11 : Int
  ) that

  let (
    inner : Inner,
    z = z : Int
  ) = nested in
  let (
    x = x : Int,
    y : Int
  ) = inner in
  let (
    outer = inner = wrapped_value : Int
  ) = wrapped in
  let (
    /x = projected_x : Int;
    /z = projected_z : Int;
    projected_nested
  ) = nested in
  let (
    /inner = projected_inner : Int;
    /outer = /inner = chained_projected_inner : Int;
    projected_wrapped
  ) = wrapped in
  let (/left = /x = left_x : Int; /right = /x = right_x : Int) = ambiguous in
  let (
    /punned : Int;
    punnable_whole
  ) = punnable in
  do tens <- ! (int/mul) y 10;
  do hundreds <- ! (int/mul) z 100;
  do low <- ! (int/add) x tens;
  do checksum <- ! (int/add) low hundreds;
  do layout_check <- ! (int/sub) checksum 765;
  do nested_projection_check <- ! (int/sub) nested/x 5;
  do outer_projection_check <- ! (int/sub) nested/z 7;
  do recursive_label_projection_check <- ! (int/sub) wrapped/inner 8;
  do chained_projection_check <- ! (int/sub) wrapped/outer/inner 8;
  do chained_pattern_check <- ! (int/sub) wrapped_value 8;
  do x_pattern_check <- ! (int/sub) projected_x 5;
  do z_pattern_check <- ! (int/sub) projected_z 7;
  do nested_alias_check <- ! (int/sub) projected_nested/x 5;
  do inner_pattern_check <- ! (int/sub) projected_inner 8;
  do chained_projection_pattern_check <- ! (int/sub) chained_projected_inner 8;
  do wrapped_alias_check <- ! (int/sub) projected_wrapped/inner 8;
  do disambiguated_left_check <- ! (int/sub) left_x 9;
  do disambiguated_right_check <- ! (int/sub) right_x 10;
  do punned_projection_pattern_check <- ! (int/sub) punned 11;
  do punned_alias_check <- ! (int/sub) punnable_whole/punned 11;
  do total <- ! (int/add) layout_check nested_projection_check;
  do total <- ! (int/add) total outer_projection_check;
  do total <- ! (int/add) total recursive_label_projection_check;
  do total <- ! (int/add) total chained_projection_check;
  do total <- ! (int/add) total chained_pattern_check;
  do total <- ! (int/add) total x_pattern_check;
  do total <- ! (int/add) total z_pattern_check;
  do total <- ! (int/add) total nested_alias_check;
  do total <- ! (int/add) total inner_pattern_check;
  do total <- ! (int/add) total chained_projection_pattern_check;
  do total <- ! (int/add) total wrapped_alias_check;
  do total <- ! (int/add) total disambiguated_left_check;
  do total <- ! (int/add) total disambiguated_right_check;
  do total <- ! (int/add) total punned_projection_pattern_check;
  do total <- ! (int/add) total punned_alias_check;
  ! (process/exit) total
end
