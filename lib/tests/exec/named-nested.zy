-- Explicit product nesting remains significant, while directly nested Named
-- wrappers support chained patterns and projections.
begin
  param (
    (
      /Int;
      /add;
      /sub;
      /mul;
      /exit
    ) :
    @[import("../../std/builtin.zy")] _
  ) that

  let Inner =
    (x :: Int) * Int
  that
  let Outer =
    Inner * (z :: Int)
  that
  let Wrapped =
    (outer :: inner :: Int)
  that
  let Ambiguous =
    (left :: (x :: Int)) * (right :: (x :: Int))
  that
  let Punnable =
    (punned :: Int)
  that
  def nested : Outer = (
    (x = 5 : Int, 6 : Int),
    z = 7 : Int
  ) that
  def wrapped : Wrapped = (
    outer = inner = 8 : Int
  ) that
  def ambiguous : Ambiguous = (
    left = x = 9 : Int,
    right = x = 10 : Int
  ) that
  def punnable : Punnable = (
    punned = 11 : Int
  ) that

  let (
    inner : Inner,
    z = z : Int
  ) = nested in
  let (
    x = x : Int,
    y : Int
  ) = inner in
  let (
    outer = inner = wrapped_value : Int
  ) = wrapped in
  let (
    /x = projected_x : Int;
    /z = projected_z : Int;
    projected_nested
  ) = nested in
  let (
    /inner = projected_inner : Int;
    /outer = /inner = chained_projected_inner : Int;
    projected_wrapped
  ) = wrapped in
  let (
    /left = /x = left_x : Int;
    /right = /x = right_x : Int
  ) = ambiguous in
  let (
    /punned : Int;
    punnable_whole
  ) = punnable in
  do tens <- ! (mul) y 10;
  do hundreds <- ! (mul) z 100;
  do low <- ! (add) x tens;
  do checksum <- ! (add) low hundreds;
  do layout_check <- ! (sub) checksum 765;
  do nested_projection_check <- ! (sub) nested/x 5;
  do outer_projection_check <- ! (sub) nested/z 7;
  do recursive_label_projection_check <- ! (sub) wrapped/inner 8;
  do chained_projection_check <- ! (sub) wrapped/outer/inner 8;
  do chained_pattern_check <- ! (sub) wrapped_value 8;
  do x_pattern_check <- ! (sub) projected_x 5;
  do z_pattern_check <- ! (sub) projected_z 7;
  do nested_alias_check <- ! (sub) projected_nested/x 5;
  do inner_pattern_check <- ! (sub) projected_inner 8;
  do chained_projection_pattern_check <- ! (sub) chained_projected_inner 8;
  do wrapped_alias_check <- ! (sub) projected_wrapped/inner 8;
  do disambiguated_left_check <- ! (sub) left_x 9;
  do disambiguated_right_check <- ! (sub) right_x 10;
  do punned_projection_pattern_check <- ! (sub) punned 11;
  do punned_alias_check <- ! (sub) punnable_whole/punned 11;
  do total <- ! (add) layout_check nested_projection_check;
  do total <- ! (add) total outer_projection_check;
  do total <- ! (add) total recursive_label_projection_check;
  do total <- ! (add) total chained_projection_check;
  do total <- ! (add) total chained_pattern_check;
  do total <- ! (add) total x_pattern_check;
  do total <- ! (add) total z_pattern_check;
  do total <- ! (add) total nested_alias_check;
  do total <- ! (add) total inner_pattern_check;
  do total <- ! (add) total chained_projection_pattern_check;
  do total <- ! (add) total wrapped_alias_check;
  do total <- ! (add) total disambiguated_left_check;
  do total <- ! (add) total disambiguated_right_check;
  do total <- ! (add) total punned_projection_pattern_check;
  do total <- ! (add) total punned_alias_check;
  ! (exit) total
end
