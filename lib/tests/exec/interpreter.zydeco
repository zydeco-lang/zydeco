begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def SynVal : VType =
    data
    | +Var : String
    | +True : Unit
    | +False : Unit
    | +ThunkV : SynComp
    end
  that
  def SynComp : VType =
    data
    | +If : SynVal * SynComp * SynComp
    | +Force : SynVal
    | +Lam : String * SynComp
    | +App : SynComp * SynVal
    | +Return : SynVal
    | +Bind : SynComp * String * SynComp
    end
  that
  def Env : VType =
    data
    | +Empty : Unit
    | +Cons : String * SemVal * Env
    end
  that
  def SemVal : VType =
    data
    | +True : Unit
    | +False : Unit
    | +ThunkV : Thk SemComp
    end
  that
  def Answer : (VType) -> (VType) =
    begin
      param (A : VType) that
      data
      | +Ok : A
      | +Err : Unit
      end
    end
  that
  def SemComp : CType =
    codata
    | .app : SemVal -> SemComp
    | .bind : Ret (Answer SemVal)
    end
  that
  def Interpreter : CType =
    codata
    | .valu : SynVal -> Env -> Ret (Answer SemVal)
    | .comp : SynComp -> Env -> SemComp
    end
  that

  def lookup : Thk (String -> Env -> Ret (Answer SemVal)) = {
    fix (lookup : Thk (String -> Env -> Ret (Answer SemVal))) ->
      fn requested environment ->
        match environment
        | +Empty() -> ret +Err()
        | +Cons(name, value, tail) ->
          ! (api/str_eq_branch)
            (Ret (Answer SemVal))
            requested
            name
            { ret +Ok(value) }
            { ! lookup requested tail }
        end
  } that
  def sem_val_to_string : Thk (SemVal -> Ret String) = {
    fn value ->
      match value
      | +True(_) -> ret "true"
      | +False(_) -> ret "false"
      | +ThunkV(_) -> ret "<thunk>"
      end
  } that
  def error : Thk SemComp = {
    fix (error : Thk SemComp) ->
      comatch
      | .app _ -> ! error
      | .bind -> ret +Err()
      end
  } that
  def interp : Thk Interpreter = {
    fix (interp : Thk Interpreter) ->
      comatch
      | .valu value environment ->
        match value
        | +Var(name) -> ! lookup name environment
        | +True(_) -> ret +Ok(+True())
        | +False(_) -> ret +Ok(+False())
        | +ThunkV(computation) ->
          ret +Ok(+ThunkV({ ! interp .comp computation environment }))
        end
      | .comp computation environment ->
        match computation
        | +If(condition, consequent, alternative) ->
          match condition
          | +Var(_) -> ! error
          | +True(_) -> ! interp .comp consequent environment
          | +False(_) -> ! interp .comp alternative environment
          | +ThunkV(_) -> ! error
          end
        | +Force(syntax_value) ->
          do result <- ! interp .valu syntax_value environment;
          match result
          | +Ok(value) ->
            match value
            | +ThunkV(thunk) -> ! thunk
            | +True(_) -> ! error
            | +False(_) -> ! error
            end
          | +Err() -> ! error
          end
        | +Return(syntax_value) ->
          do result <- ! interp .valu syntax_value environment;
          comatch
          | .bind -> ret result
          | .app _ -> ! error
          end
        | +Bind(bindee, name, body) ->
          do result <- ! interp .comp bindee environment .bind;
          match result
          | +Ok(value) ->
            ! interp .comp body +Cons(name, value, environment)
          | +Err() -> ! error
          end
        | +Lam(name, body) ->
          comatch
          | .app value ->
            ! interp .comp body +Cons(name, value, environment)
          | .bind -> ret +Err()
          end
        | +App(function, argument) ->
          do result <- ! interp .valu argument environment;
          match result
          | +Ok(value) -> ! interp .comp function environment .app value
          | +Err() -> ! error
          end
        end
      end
  } that

  do result <- ! interp
    .comp
    +App(
      +Lam("x", +Return(+Var("x"))),
      +False()
    )
    +Empty()
    .bind;
  match result
  | +Err(_) -> ! (api/exit) 1
  | +Ok(value) ->
    do rendered <- ! sem_val_to_string value;
    ! (api/write_line) rendered { ! (api/exit) 0 }
  end
end
