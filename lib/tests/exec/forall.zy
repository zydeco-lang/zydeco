begin
  param (
    (/VType; /CType; /Thk; /Ret; /Int; /OS; /process) :
    @[import("../../std/builtin.zy")] _
  ) that

  def ! id (A : VType) (value : A) : Ret A =
    ret value
  that
  def ! id~ (B : CType) (b : Thk B) : B =
    ! b
  that

  do x <- ! id Int 0;
  ! id~ OS { ! (process/exit) x }
end
