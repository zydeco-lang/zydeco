begin
  param (
    (/core; /representations; /system) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (/VType; /CType; /Thk; /Ret) = core that
  let (/Scalar = Int64) = representations/i64 that
  let (/OS; /process) = system that

  def ! id (A : VType) (value : A) : Ret A =
    ret value
  that
  def ! id~ (B : CType) (b : Thk B) : B =
    ! b
  that

  do x <- ! id Int64 0;
  ! id~ OS { ! (process/exit) x }
end
