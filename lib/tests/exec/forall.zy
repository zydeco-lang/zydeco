begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def id : Thk (
    forall (A : VType) (value : A) .
      Ret A
  ) = {
    fn (A : VType) (value : A) ->
      ret value
  } that
  def id~ : Thk (
    forall (B : CType) .
      Thk B -> B
  ) = {
    fn (B : CType) (b : Thk B) ->
      ! b
  } that

  do x <- ! id Int 0;
  ! id~ OS { ! (api/exit) x }
end
