begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def ! id (A : VType) (value : A) : Ret A =
    ret value
  that
  def ! id~ (B : CType) (b : Thk B) : B =
    ! b
  that

  do x <- ! id Int 0;
  ! id~ OS { ! (api/exit) x }
end
