begin
  param (
    (
      /VType; /Thk; /Ret;
      /Unit; /Int; /Char; /String; /OS;
      /add; /int_eq_branch; /int_lt_branch;
      /char_to_str; /char_codepoint;
      /str_scalar_length; /str_append; /str_get_branch;
      /write_line;
      /exit
    ) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def Option (A : VType) =
    data
    | +None : Unit
    | +Some : A
    end
  that
  def Syn : VType =
    data
    | +Str : String
    | +Concat : Syn * Syn
    | +Kleene : Syn
    | +Choose : Syn * Syn
    end
  that
  def Matcher =
    codata
    | .str : String -> Ret (Option String)
    | .concat : Syn -> Syn -> Ret (Option String)
    | .kleene : Syn -> Ret (Option String)
    | .choose : Syn -> Syn -> Ret (Option String)
    | .bind : Syn -> Ret (Option String)
    end
  that
  def Regex =
    codata
    | .run : String -> Matcher
    end
  that

  def ! int_lt (left : Int) (right : Int) : Ret Bool =
    ! (int_lt_branch)
      (Ret Bool)
      left
      right
      { ret +True() }
      { ret +False() }
  that
  def ! str_get_or_space (string : String) (index : Int) : Ret Char =
    ! (str_get_branch)
      (Ret Char)
      string
      index
      { ret ' ' }
      { fn character => ret character }
  that
  def ! char_eq (left : Char) (right : Char) : Ret Bool =
    do left <- ! (char_codepoint) left;
    do right <- ! (char_codepoint) right;
    ! (int_eq_branch)
      (Ret Bool)
      left
      right
      { ret +True() }
      { ret +False() }
  that
  def ! str_chop_hd (s : String) (i : Int) : Ret String =
    do l <- ! (str_scalar_length) s;
    let fix str_collect (s : String) (i : Int) (r : String) : Ret String =
      do continue? <- ! int_lt i l;
      match continue?
      | +False() => ret r
      | +True() =>
        do tl <- ! str_get_or_space s i;
        do tl <- ! (char_to_str) tl;
        do r <- ! (str_append) r tl;
        do i+1 <- ! (add) i 1;
        ! str_collect s i+1 r
      end
    in
    ! str_collect s i ""
  that
  def ! str_eq_at (a : String) (b : String) (i : Int) : Ret Bool =
    do ai <- ! str_get_or_space a i;
    do bi <- ! str_get_or_space b i;
    ! char_eq ai bi
  that
  def ! str_match (s : String) (p : String) : Ret (Option String) =
    let fix str_match (i : Int) (s : String) (p : String) : Ret (Option String) =
        do s_len <- ! (str_scalar_length) s;
      do p_len <- ! (str_scalar_length) p;
      do i_lt_s <- ! int_lt i s_len;
      do i_lt_p <- ! int_lt i p_len;
      match i_lt_p
      | +False() =>
        do s' <- ! str_chop_hd s i;
        ret +Some(s')
      | +True() =>
        match i_lt_s
        | +False() => ret +None()
        | +True() =>
          do eq? <- ! str_eq_at s p i;
          match eq?
          | +False() => ret +None()
          | +True() =>
            do i+1 <- ! (add) i 1;
            ! str_match i+1 s p
          end
        end
      end
      in
    ! str_match 0 s p
  that
  def fix regex : Regex =
    comatch
    | .run s =>
      comatch
      | .str p => ! str_match s p
      | .concat sy1 sy2 =>
        do s? <- ! regex .run s .bind sy1;
        match s?
        | +None() => ret +None()
        | +Some(s) =>
          ! regex .run s .bind sy2
        end
      | .kleene sy =>
        do s? <- ! regex .run s .bind sy;
        match s?
        | +None() => ret +Some(s)
        | +Some(s) => ! regex .run s .kleene sy
        end
      | .choose sy1 sy2 =>
        do s? <- ! regex .run s .bind sy1;
        match s?
        | +Some(s) => ret +Some(s)
        | +None() => ! regex .run s .bind sy2
        end
      | .bind sy =>
        match sy
        | +Str(p) => ! regex .run s .str p
        | +Concat(sy1, sy2) => ! regex .run s .concat sy1 sy2
        | +Kleene(sy) => ! regex .run s .kleene sy
        | +Choose(sy1, sy2) => ! regex .run s .choose sy1 sy2
        end
      end
    end
  that
  def ! demo (syn : Syn) (str : String) (kont : Thk OS) : OS =
    do res <- ! regex .run str .bind syn;
    match res
    | +Some(s) => ! (write_line) s kont
    | +None() => ! (exit) 1
    end
  that

  -- p*q*(xos|sox)
  ! demo
    +Concat(
      +Kleene(+Str("p")),
      +Concat(
        +Kleene(+Str("q")),
        +Choose(+Str("xos"), +Str("sox"))
      )
    )
    "pppqqqsox\\^o^/"
    { ! (exit) 0 }
end
