begin
  param (/core; /system) : @(import("../../std/builtin.zy")) that
  let (/VType; /Thk; /Ret; /Unit) = core that
  let (/process) = system that

  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def OddEven =
    data
    | +OddEven : Thk (Nat -> Ret Bool) * Thk (Nat -> Ret Bool)
    end
  that
  def fix fp : Ret OddEven = ret +OddEven(
    {
      do fp <- ! fp;
      match fp
      | +OddEven(odd, even) => fn (x : Nat) =>
        match x
        | +Z() => ret +False()
        | +S(x) => ! even x
        end
      end
    },
    {
      do fp <- ! fp;
      match fp
      | +OddEven(odd, even) => fn (x : Nat) =>
        match x
        | +Z() => ret +True()
        | +S(x) => ! odd x
        end
      end
    }
  ) that

  do odd <- (
    do fp <- ! fp;
    match fp
    | +OddEven(odd, even) => ret { ! odd }
    end
  );
  do b <- ! odd +S(+S(+S(+Z())));
  match b
  | +True() => ! (process/exit) 0
  | +False() => ! (process/exit) 1
  end
end
