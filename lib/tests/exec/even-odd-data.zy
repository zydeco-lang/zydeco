begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def OddEven =
    data
    | +OddEven : Thk (Nat -> Ret Bool) * Thk (Nat -> Ret Bool)
    end
  that
  def fp : Thk (Ret OddEven) = {
    fix (fp : Thk (Ret OddEven)) ->
      ret +OddEven(
        {
          do fp <- ! fp;
          match fp
          | +OddEven(odd, even) ->
            fn (x : Nat) ->
              match x
              | +Z() -> ret +False()
              | +S(x) -> ! even x
              end
          end
        },
        {
          do fp <- ! fp;
          match fp
          | +OddEven(odd, even) ->
            fn (x : Nat) ->
              match x
              | +Z() -> ret +True()
              | +S(x) -> ! odd x
              end
          end
        },
      )
  } that

  do odd <- (
    do fp <- ! fp;
    match fp
    | +OddEven(odd, even) -> ret { ! odd }
    end
  );
  do b <- ! odd +S(+S(+S(+Z())));
  match b
  | +True() -> ! (api/exit) 0
  | +False() -> ! (api/exit) 1
  end
end
