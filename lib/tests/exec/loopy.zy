begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Y (B : CType) : CType =
    codata
    | .y : Thk (Y B) -> B
    end
  that
  def Self (B : VType) : VType =
    data
    | +Roll : Thk (Self B -> Ret B)
    end
  that
  def fix' : Thk (
    forall (B : CType) .
      Thk (Thk B -> B) -> B
  ) = {
    fn (B : CType) (f : Thk (Thk B -> B)) ->
      let prim : Thk (Y B) = {
        comatch
        | .y x -> ! f { ! x .y x }
        end
      } in
      ! prim .y prim
  } that
  def m : Thk OS = {
    ! fix' OS { fn loop -> ! loop }
  } that

  ! (api/exit) 0
end
