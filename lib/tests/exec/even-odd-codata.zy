begin
  param (/core; /system) : @(import("../../std/builtin.zy")) that
  let (/VType; /Ret; /Unit) = core that
  let (/process) = system that

  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def OddEven =
    codata
    | .even : Nat -> Ret Bool
    | .odd : Nat -> Ret Bool
    end
  that
  def fix eo : OddEven =
    comatch
    | .even n =>
      match n
      | +Z() => ret +True()
      | +S(n) => ! eo .odd n
      end
    | .odd n =>
      match n
      | +Z() => ret +False()
      | +S(n) => ! eo .even n
      end
    end
  that

  do b <- ! eo .even +S(+S(+S(+S(+Z()))));
  match b
  | +True() => ! (process/exit) 0
  | +False() => ! (process/exit) 1
  end
end
