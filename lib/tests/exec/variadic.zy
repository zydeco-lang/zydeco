begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def List : (VType) -> (VType) =
    begin
      param (A : VType) that
      data
      | +Nil : Unit
      | +Cons : A * List A
      end
    end
  that
  def Variadic :
    (VType) ->
    (CType) ->
    (CType) =
    begin
      param (A : VType) that
      param (B : CType) that
      codata
      | .more : A -> Variadic A B
      | .done : B
      end
    end
  that
  def restore : Thk (
    forall (A : VType) .
    forall (B : CType) .
      Thk (Variadic A B) ->
      List A ->
      B
  ) = {
    fix (
      restore :
      Thk (
        forall (A : VType) .
        forall (B : CType) .
          Thk (Variadic A B) ->
          List A ->
          B
      )
    ) ->
      fn (A : VType)
         (B : CType)
         variadic
         values ->
        match values
        | +Nil() -> ! variadic .done
        | +Cons(head, tail) ->
          ! restore A B { ! variadic .more head } tail
        end
  } that
  def capture : Thk (
    forall (A : VType) .
    forall (B : CType) .
      Thk (List A -> B) ->
      Variadic A B
  ) = {
    fn (A : VType)
       (B : CType)
       function ->
      let recursive : Thk (
        Thk (List A -> B) ->
        Variadic A B
      ) = {
        fix (
          recursive :
          Thk (
            Thk (List A -> B) ->
            Variadic A B
          )
        ) ->
          fn continuation ->
            comatch
            | .more value ->
              ! recursive {
                fn values ->
                  ! continuation +Cons(value, values)
              }
            | .done -> ! continuation +Nil()
            end
      } in
      ! recursive { fn values -> ! function values }
  } that
  def print_list : Thk (
    List String ->
    Thk OS ->
    OS
  ) = {
    fix (
      print_list :
      Thk (
        List String ->
        Thk OS ->
        OS
      )
    ) ->
      fn values continuation ->
        match values
        | +Nil() -> ! continuation
        | +Cons(head, tail) ->
          ! (api/write_line) head { ! print_list tail continuation }
        end
  } that
  def print_variadic : Thk (
    Variadic String (Thk OS -> OS)
  ) = {
    ! capture String (Thk OS -> OS) print_list
  } that

  ! restore
    String
    (Thk OS -> OS)
    { ! capture String (Thk OS -> OS) print_list }
    (+Cons("hello", +Cons("world", +Nil())))
    {
      ! capture
        String
        (Thk OS -> OS)
        { ! restore String (Thk OS -> OS) print_variadic }
        .more "hello"
        .more "world"
        .done
        { ! (api/exit) 0 }
    }
end
