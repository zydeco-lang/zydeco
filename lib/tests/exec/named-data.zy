-- Data constructors treat a named tuple as an ordinary payload type.
begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Packet =
    data
    | +Packet : (tag :: Int) * (Int * (payload :: Int))
    | +Empty : Unit
    end
  that
  def packet : Packet = +Packet(
    tag = 7 : Int,
    8 : Int,
    payload = 9 : Int
  ) that

  match packet
  | +Packet(
      tag = tag : Int,
      body : Int,
      payload = payload : Int
    ) ->
    do tag_check <- ! (api/sub) tag 7;
    do body_check <- ! (api/sub) body 8;
    do payload_check <- ! (api/sub) payload 9;
    do total <- ! (api/add) tag_check body_check;
    do total <- ! (api/add) total payload_check;
    ! (api/exit) total
  | +Empty() ->
    ! (api/exit) 1
  end
end
