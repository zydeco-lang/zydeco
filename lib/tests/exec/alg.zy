begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  let With (B1 : CType) (B2 : CType) =
    codata
    | .l : B1
    | .r : B2
    end
  that

  def alg_arrow : Thk (
    forall (
      M :
      (VType) -> (CType)
    ) .
    forall (A : VType) .
    forall (B : CType) .
      Thk (Algebra M B) ->
      Algebra M (A -> B)
  ) = {
    fn M A B alg ->
      comatch X m f ->
        fn a ->
          ! alg X m {
            fn x ->
              ! f x a
          }
      end
  } that
  def alg_with : Thk (
    forall (
      M :
      (VType) -> (CType)
    ) .
    forall (B1 : CType) .
      Thk (Algebra M B1) ->
      (
        forall (B2 : CType) .
          Thk (Algebra M B2) ->
          Algebra M (With B1 B2)
      )
  ) = {
    fn M B1 alg1 B2 alg2 ->
      comatch X m f ->
        comatch
        | .l ->
          ! alg1 X m {
            fn x ->
              ! f x .l
          }
        | .r ->
          ! alg2 X m {
            fn x ->
              ! f x .r
          }
        end
      end
  } that
  def alg_ret : Thk (
    forall (
      M :
      (VType) -> (CType)
    ) .
      Thk (Monad M) ->
      (
        forall (A : VType) .
          Algebra M (M A)
      )
  ) = {
    fn M mo A ->
      comatch X m f ->
        ! mo .bind X A m f
      end
  } that
  def alg_forall_ctype : Thk (
    forall (
      M :
      (VType) -> (CType)
    ) .
    forall (
      S :
      (CType) -> (CType)
    ) .
      Thk (
        forall (Y : CType) .
          Thk (Algebra M Y) ->
          Algebra M (S Y)
      ) ->
      Algebra M (
        forall (Y : CType) .
          Thk (Algebra M Y) ->
          S Y
      )
  ) = {
    fn M S algS ->
      comatch X m f ->
        comatch Y algY ->
          ! algS Y algY X m {
            fn a ->
              ! f a Y algY
          }
        end
      end
  } that
  def alg_forall_ctype_constructor : Thk (
    forall (
      M :
      (VType) -> (CType)
    ) .
    forall (
      S :
      (
        ((CType) -> (CType)) ->
        (CType)
      )
    ) .
      Thk (
        forall (
          F :
          (CType) -> (CType)
        ) .
          Thk (
            forall (Z : CType) .
              Thk (Algebra M Z) ->
              Algebra M (F Z)
          ) ->
          Algebra M (S F)
      ) ->
      Algebra M (
        forall (
          F :
          (CType) -> (CType)
        ) .
          Thk (
            forall (Z : CType) .
              Thk (Algebra M Z) ->
              Algebra M (F Z)
          ) ->
          S F
      )
  ) = {
    fn M S algS ->
      comatch X m f ->
        comatch F algZFZ ->
          ! algS F algZFZ X m {
            fn a ->
              ! f a F algZFZ
          }
        end
      end
  } that
  def alg_of_ret : Thk (
    forall (R : CType) .
      Algebra Ret R
  ) = {
    fn R ->
      comatch X m f ->
        do x <- ! m;
        ! f x
      end
  } that

  do x <- ! alg_of_ret
    (Ret Int)
    Int
    { ret 0 }
    {
      fn x ->
        ret x
    };
  ! (api/exit) x
end
end
