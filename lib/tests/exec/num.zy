begin
  param (
    (/core; /numeric; /system) :
    @(import("../../std/builtin.zy"))
  ) that
  let (/Ret; /Unit) = core that
  let (= Int64, int64) = numeric/int64 that
  let (/process) = system that

  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that

  do x <- (fn x => ret 1 : Bool -> Ret Int64) +True();
  do y <- (fn x => ret +True() : Int64 -> Ret Bool) 123;
  do z <- (fn x => ret +True() : Int64 -> Ret Bool) -123;
  do x <- ! (int64/mul) x -1;
  do x <- ! (int64/add) 1 x;
  ! (process/exit) x
end
