begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that

  do x <- (fn x -> ret 1 : Bool -> Ret Int) +True();
  do y <- (fn x -> ret +True() : Int -> Ret Bool) +123;
  do z <- (fn x -> ret +True() : Int -> Ret Bool) -123;
  do x <- ! (api/mul) x -1;
  do x <- ! (api/add) 1 x;
  ! (api/exit) x
end
