begin
  let make_std = @[import("../../std/std.zy")] _ that
  param (
    (
      /CType;
      /Thk;
      /Ret;
      /Int;
      /OS;
      builtin
    ) :
    @[import("../../std/builtin.zy")] _
  ) that
  def Y (B : CType) : CType =
    codata
    | .y : Thk (Y B) -> B
    end
  that
  /-
    \f. (\x. f (x x)) (\x. f (x x))
    The famous Y combinator in call-by-name sense actually works
    under call-by-push-value - thanks to thunks, we are able to
    preserve the intention of lazy evaluation in `x` above.
  -/
  def ! fix' (B : CType) (f : Thk (Thk B -> B)) : Ret (Thk B) =
    let ! prim : Y B =
        comatch
      | .y x => ! f { ! x .y x }
      end
      in
    ret { ! prim .y prim }
  that

  let (
    /Int = StdInt;
    /OS = StdOS;
    /bool;
    /int;
    /string;
    /stdio;
    /process
  ) = make_std builtin in
  -- good old factorial
  def ! fact (f : Thk (StdInt -> Ret StdInt)) (n : StdInt) : Ret StdInt =
    do is_zero <- ! (int/eq) n 0;
    ! (bool/if)
      (Ret StdInt)
      is_zero
      { ret 1 }
      {
        do n-1 <- ! (int/sub) n 1;
        do rest <- ! f n-1;
        ! (int/mul) n rest
      }
  in
  do fact <- ! fix' (StdInt -> Ret StdInt) fact;
  -- tests
  def ! demo (input : StdInt) (expected : StdInt) (t : Thk StdOS) : StdOS =
    do x <- ! fact input;
    do correct <- ! (int/eq) x expected;
    ! (bool/if)
      StdOS
      correct
      { ! t }
      {
        do input <- ! (int/to_string) input;
        do expected <- ! (int/to_string) expected;
        do got <- ! (int/to_string) x;
        do msg <- ! (string/append) "f " input;
        do msg <- ! (string/append) msg " = ";
        do msg <- ! (string/append) msg expected;
        do msg <- ! (string/append) msg ", got ";
        do msg <- ! (string/append) msg got;
        ! (stdio/write_line) msg { fn _ => ! (process/exit) 1 }
      }
  in

  ! demo 5 120 {
    ! demo 10 3628800 {
      ! (process/exit) 0
    }
  }
end
