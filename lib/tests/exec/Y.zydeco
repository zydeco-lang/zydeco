begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def Y (B : CType) : CType =
    codata
    | .y : Thk (Y B) -> B
    end
  that
  /-
    \f. (\x. f (x x)) (\x. f (x x))
    The famous Y combinator in call-by-name sense actually works
    under call-by-push-value - thanks to thunks, we are able to
    preserve the intention of lazy evaluation in `x` above.
  -/
  def ! fix' (B : CType) (f : Thk (Thk B -> B)) : Ret (Thk B) =
    let ! prim : Y B =
        comatch
      | .y x -> ! f { ! x .y x }
      end
      in
    ret { ! prim .y prim }
  that

  let (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    std
  ) = std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) in
  -- good old factorial
  def ! fact (f : Thk (StdInt -> Ret StdInt)) (n : StdInt) : Ret StdInt =
    do is_zero <- ! (std/int/eq) n 0;
    ! (std/bool/if)
      (Ret StdInt)
      is_zero
      { ret 1 }
      {
        do n-1 <- ! (std/int/sub) n 1;
        do rest <- ! f n-1;
        ! (std/int/mul) n rest
      }
  in
  do fact <- ! fix' (StdInt -> Ret StdInt) fact;
  -- tests
  def ! demo (input : StdInt) (expected : StdInt) (t : Thk StdOS) : StdOS =
    do x <- ! fact input;
    do correct <- ! (std/int/eq) x expected;
    ! (std/bool/if)
      StdOS
      correct
      { ! t }
      {
        do input <- ! (std/int/to_str) input;
        do expected <- ! (std/int/to_str) expected;
        do got <- ! (std/int/to_str) x;
        do msg <- ! (std/string/append) "f " input;
        do msg <- ! (std/string/append) msg " = ";
        do msg <- ! (std/string/append) msg expected;
        do msg <- ! (std/string/append) msg ", got ";
        do msg <- ! (std/string/append) msg got;
        ! (std/os/write_line) msg { ! (std/os/exit) 1 }
      }
  in

  ! demo 5 120 {
    ! demo 10 3628800 {
      ! (std/os/exit) 0
    }
  }
end
