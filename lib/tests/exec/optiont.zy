begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  let Option (A : VType) =
    data
    | +None : Unit
    | +Some : A
    end
  that
  let OptionT (M : (VType) -> (CType)) (A : VType) =
    codata
    | .trans : M (Option A)
    end
  that
  let Return (X : VType) =
    Ret X
  that
  let Option' (A : VType) =
    OptionT Return A
  that
  def o : Thk (Option' Int) = {
    comatch
    | .trans ->
      ret +Some(1)
    end
  } that

  ! (api/exit) 0
end
