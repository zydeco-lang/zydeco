begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Kont :
    (VType) ->
    (CType) ->
    (VType) =
    begin
      param (A : VType) that
      param (B : CType) that
      data
      | +Running : Thk B
      | +Done : A
      end
    end
  that

  let continuation : Kont _ OS = +Done(1) in
  ! (api/exit) 0
end
