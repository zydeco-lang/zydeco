begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  def Option : (VType) -> (VType) =
    begin
      param (A : VType) that
      data
      | +None : Unit
      | +Some : A
      end
    end
  that
  def MonadTransformer :
    (
      (
        (
          (VType) ->
          (CType)
        ) ->
        (VType) ->
        (CType)
      ) ->
      (CType)
    ) =
    begin
      param (
        T :
        (
          (
            (VType) ->
            (CType)
          ) ->
          (VType) ->
          (CType)
        )
      ) that
      codata
      | .lift :
        forall (
          M :
          (VType) ->
          (CType)
        ) .
        forall (A : VType) .
          Thk (Monad M) ->
          Thk (M A) ->
          T M A
      end
    end
  that
  def ReaderT :
    (
      (VType) ->
      (
        (
          (VType) ->
          (CType)
        ) ->
        (VType) ->
        (CType)
      )
    ) =
    begin
      param (R : VType) that
      param (
        M :
        (VType) ->
        (CType)
      ) that
      param (A : VType) that
      codata
      | .run : R -> M A
      end
    end
  that
  def OptionT :
    (
      (
        (VType) ->
        (CType)
      ) ->
      (VType) ->
      (CType)
    ) =
    begin
      param (
        M :
        (VType) ->
        (CType)
      ) that
      param (A : VType) that
      codata
      | .run : M (Option A)
      end
    end
  that
  def KOptionT :
    (
      (
        (VType) ->
        (CType)
      ) ->
      (VType) ->
      (CType)
    ) =
    begin
      param (
        M :
        (VType) ->
        (CType)
      ) that
      param (A : VType) that
      codata
      | .run :
        forall (R : CType) .
          Thk (Algebra M R) ->
          Thk (A -> R) ->
          Thk R ->
          R
      end
    end
  that

  def reader_t_monad : Thk (
    forall (R : VType) .
    forall (
      M :
      (VType) -> (CType)
    ) .
      Thk (Monad M) ->
      Monad (ReaderT R M)
  ) = {
    fn R M monad ->
      comatch
      | .return A value ->
        comatch
        | .run _ -> ! monad .return A value
        end
      | .bind A B computation function ->
        comatch
        | .run environment ->
          ! monad .bind A B
            { ! computation .run environment }
            {
              fn value ->
                ! function value .run environment
            }
        end
      end
  } that
  def reader_t_trans : Thk (
    forall (R : VType) .
      MonadTransformer (ReaderT R)
  ) = {
    fn R ->
      comatch
      | .lift M A monad computation ->
        comatch
        | .run _ -> ! computation
        end
      end
  } that
  def option_t_monad : Thk (
    forall (
      M :
      (VType) -> (CType)
    ) .
      Thk (Monad M) ->
      Monad (OptionT M)
  ) = {
    fn M monad ->
      comatch
      | .return A value ->
        comatch
        | .run -> ! monad .return (Option A) +Some(value)
        end
      | .bind A B computation function ->
        comatch
        | .run ->
          ! monad .bind
            (Option A)
            (Option B)
            { ! computation .run }
            {
              fn possible ->
                match possible
                | +Some(value) -> ! function value .run
                | +None() -> ! monad .return (Option B) +None()
                end
            }
        end
      end
  } that
  def option_t_trans : Thk (MonadTransformer OptionT) = {
    comatch
    | .lift M A monad computation ->
      comatch
      | .run ->
        ! monad .bind A (Option A) computation {
          fn value ->
            ! monad .return (Option A) +Some(value)
        }
      end
    end
  } that
  def koption_t_trans : Thk (MonadTransformer KOptionT) = {
    comatch
    | .lift M A monad computation ->
      comatch
      | .run R algebra success failure ->
        ! algebra A computation success
      end
    end
  } that
  def koption_t_monad : Thk (
    forall (
      M :
      (VType) -> (CType)
    ) .
      Thk (Monad M) ->
      Monad (KOptionT M)
  ) = {
    fn M monad ->
      comatch
      | .return A value ->
        comatch
        | .run R algebra success failure ->
          ! success value
        end
      | .bind A B computation function ->
        comatch
        | .run R algebra success failure ->
          ! computation .run
            R
            algebra
            {
              fn value ->
                ! function value .run R algebra success failure
            }
            failure
        end
      end
  } that

  ! (api/exit) 0
end
end
