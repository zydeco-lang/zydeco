begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    public
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  do present <- ! (public/str_split_once) "left:right" ':';
  do present_status <- ! (public/option_eliminate)
    (StdString * StdString)
    (Ret StdInt)
    present
    { ret 1 }
    {
      fn pair ->
        ret 0
    };
  do absent <- ! (public/str_split_n) "short" 99;
  do absent_status <- ! (public/option_eliminate)
    (StdString * StdString)
    (Ret StdInt)
    absent
    { ret 0 }
    {
      fn pair ->
        ret 1
    };
  do status <- ! (public/add) present_status absent_status;
  ! (public/exit) status
end
