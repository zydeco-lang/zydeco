begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  def Either :
    (VType) ->
    (VType) ->
    (VType) =
    begin
      param (A : VType) that
      param (B : VType) that
      data
      | +Left : A
      | +Right : B
      end
    end
  that
  let Exn :
    (VType) ->
    (VType) ->
    (CType) =
    begin
      param (E : VType) that
      param (A : VType) that
      Ret (Either E A)
    end
  that
  let Top : CType =
    codata
    end
  that
  let top : Thk Top = {
    comatch
    end
  } that

  def mo_exn : Thk (
    forall (E : VType) .
      Monad (Exn E)
  ) = {
    fn E ->
      comatch
      | .return A value ->
        ret +Right(value)
      | .bind A B computation function ->
        do outcome <- ! computation;
        match outcome
        | +Left(error) -> ret +Left(error)
        | +Right(value) -> ! function value
        end
      end
  } that
  def alg_exn_os : Thk (
    forall (E : VType) .
      Algebra (Exn E) OS
  ) = {
    fn E A computation function ->
      do outcome <- ! computation;
      match outcome
      | +Left(_) -> ! (api/exit) 1
      | +Right(value) -> ! function value
      end
  } that
  def mo_return : Thk (
    forall (E : VType) .
      Thk (Monad (Exn E)) ->
      Exn E Int
  ) = {
    fn E monad ->
      let translated = {
        monadic
          do value <- ret 1;
          ret value
        end
      } in
      ! translated (Exn E) monad
  } that
  def mo_thunk : Thk (
    forall (E : VType) .
      Thk (Monad (Exn E)) ->
      Exn E Int
  ) = {
    fn E monad ->
      let translated = {
        monadic
          do _ <- ret 1;
          ! { ret 1 }
        end
      } in
      ! translated (Exn E) monad
  } that
  def mo_thunk_arg : Thk (
    forall (E : VType) .
      Thk (Monad (Exn E)) ->
      Exn E Int
  ) = {
    fn E monad ->
      let translated = {
        monadic
          do _ <- ret 1;
          (fn (computation : Thk _) -> ! computation) {
            ret 1
          }
        end
      } in
      ! translated (Exn E) monad
  } that
  def mo_forallv : Thk (
    forall (E : VType) .
      Thk (Monad (Exn E)) ->
      (
        forall (X : VType) .
          Thk Top ->
          X -> Exn E X
      )
  ) = {
    fn E monad ->
      let translated = {
        monadic
          do _ <- ret -1;
          fn (X : VType) (value : X) ->
            ret value
        end
      } in
      ! translated (Exn E) monad
  } that
  def mo_forallc : Thk (
    forall (E : VType) .
      Thk (Monad (Exn E)) ->
      (
        forall (X : CType) .
          Thk (Algebra (Exn E) X) ->
          Thk X ->
          X
      )
  ) = {
    fn E monad ->
      let translated = {
        monadic
          do _ <- ret -1;
          fn (X : CType) (computation : Thk X) ->
            ! computation
        end
      } in
      ! translated (Exn E) monad
  } that

  do returned <- ! mo_return String { ! mo_exn String };
  match returned
  | +Left(_) -> ! (api/exit) 1
  | +Right(returned) ->
    ! (api/int_eq_branch)
      OS
      returned
      1
      {
        do thunked <- ! mo_thunk String { ! mo_exn String };
        match thunked
        | +Left(_) -> ! (api/exit) 1
        | +Right(thunked) ->
          ! (api/int_eq_branch)
            OS
            thunked
            1
            {
              do argument <- ! mo_thunk_arg String {
                ! mo_exn String
              };
              match argument
              | +Left(_) -> ! (api/exit) 1
              | +Right(argument) ->
                ! (api/int_eq_branch)
                  OS
                  argument
                  1
                  {
                    do quantified <- ! mo_forallv
                      String
                      { ! mo_exn String }
                      Int
                      top
                      0;
                    match quantified
                    | +Left(_) -> ! (api/exit) 1
                    | +Right(quantified) ->
                      ! (api/int_eq_branch)
                        OS
                        quantified
                        0
                        {
                          ! mo_forallc
                            String
                            { ! mo_exn String }
                            OS
                            { ! alg_exn_os String }
                            { ! (api/exit) 0 }
                        }
                        { ! (api/exit) 1 }
                    end
                  }
                  { ! (api/exit) 1 }
              end
            }
            { ! (api/exit) 1 }
        end
      }
      { ! (api/exit) 1 }
  end
end
end
