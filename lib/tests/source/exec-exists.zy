begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Seal :
    (VType) ->
    (VType) ->
    (VType) =
    begin
      param (X : VType) that
      param (A : VType) that
      data
      | +Seal : Thk (A -> Ret X) * Thk (X -> Ret A)
      end
    end
  that
  def identity : Thk (
    forall (A : VType) .
      A -> Ret A
  ) = {
    fn (A : VType) (value : A) ->
      ret value
  } that
  def natural :
    exists (X : VType) .
      Seal X Int =
    (
      Int,
      +Seal(
        { ! identity Int },
        { ! identity Int },
      )
    )
  that
  def packed :
    exists (X : VType) (Y : VType) .
      X * (Y * Int) =
    (Int, Char, 0, ('z', 0))
  that

  match packed
  | (Left, Right, zero, letter, status) ->
    match natural
    | (Natural, seal) ->
      match seal
      | +Seal(from_int, to_int) ->
        do number <- ! from_int 0;
        do integer <- ! to_int number;
        ! (api/exit) integer
      end
    end
  end
end
