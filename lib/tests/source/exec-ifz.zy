begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Nat : VType =
    data
    | +Z : Unit
    | +S : Nat
    end
  that
  def Bool : VType =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def successor : Thk (Nat -> Ret Nat) = {
    fn (number : Nat) ->
      ret +S(number)
  } that
  def eliminate_zero : Thk (
    Bool ->
    Thk (Nat -> Ret Bool) ->
    Nat ->
    Ret Bool
  ) = {
    fn (when_zero : Bool)
       (when_successor : Thk (Nat -> Ret Bool))
       (number : Nat) ->
      match number
      | +Z() -> ret when_zero
      | +S(predecessor) -> ! when_successor predecessor
      end
  } that
  def is_successor : Thk (Nat -> Ret Bool) = {
    fn (number : Nat) ->
      ! eliminate_zero
        +False()
        { fn (_ : Nat) -> ret +True() }
        number
  } that

  do one <- ! successor +Z();
  do two <- ! successor one;
  do two_is_successor <- ! is_successor two;
  do one_is_successor <- ! is_successor one;
  do zero_is_successor <- ! is_successor +Z();
  do result <- (
    match two_is_successor
    | +True() ->
      match one_is_successor
      | +True() ->
        match zero_is_successor
        | +False() -> ret +True()
        | +True() -> ret +False()
        end
      | +False() -> ret +False()
      end
    | +False() -> ret +False()
    end
    : Ret Bool
  );
  match result
  | +True() -> ! (api/exit) 0
  | +False() -> ! (api/exit) 1
  end
end
