begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def classify : Thk (Int -> Ret Int) = {
    fn value ->
      ! (api/int_eq_branch)
        (Ret Int)
        value
        0
        { ret 0 }
        { ret 1 }
  } that

  do status <- ! classify 0;
  ! (api/exit) status
end
