begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def Y : (CType) -> (CType) =
    begin
      param (B : CType) that
      codata
      | .y : Thk (Y B) -> B
      end
    end
  that
  def fix_prime : Thk (
    forall (B : CType) .
      Thk (Thk B -> B) -> Ret (Thk B)
  ) = {
    fn (B : CType)
       (function : Thk (Thk B -> B)) ->
      let primitive : Thk (Y B) = {
        comatch
        | .y recursive -> ! function { ! recursive .y recursive }
        end
      } in
      ret { ! primitive .y primitive }
  } that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    public
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  def factorial_step : Thk (
    Thk (StdInt -> Ret StdInt) ->
    StdInt ->
    Ret StdInt
  ) = {
    fn recursive number ->
      do is_zero <- ! (public/int_eq) number 0;
      ! (public/branch)
        (Ret StdInt)
        is_zero
        { ret 1 }
        {
          do predecessor <- ! (public/sub) number 1;
          do rest <- ! recursive predecessor;
          ! (public/mul) number rest
        }
  } in
  do factorial <- ! fix_prime (StdInt -> Ret StdInt) factorial_step;
  def demo : Thk (
    StdInt ->
    StdInt ->
    Thk StdOS ->
    StdOS
  ) = {
    fn input expected continuation ->
      do actual <- ! factorial input;
      do correct <- ! (public/int_eq) actual expected;
      ! (public/branch)
        StdOS
        correct
        { ! continuation }
        {
          do rendered_input <- ! (public/int_to_str) input;
          do rendered_expected <- ! (public/int_to_str) expected;
          do rendered_actual <- ! (public/int_to_str) actual;
          do message <- ! (public/str_append) "f " rendered_input;
          do message <- ! (public/str_append) message " = ";
          do message <- ! (public/str_append) message rendered_expected;
          do message <- ! (public/str_append) message ", got ";
          do message <- ! (public/str_append) message rendered_actual;
          ! (public/write_line) message { ! (public/exit) 1 }
        }
  } in

  ! demo 5 120 {
    ! demo 10 3628800 {
      ! (public/exit) 0
    }
  }
end
