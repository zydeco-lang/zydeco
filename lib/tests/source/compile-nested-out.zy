param (
  (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
  @[import("../../std/builtin.zy")] _
) in
  do left <- ret 40;
  do right <- ret 30;
  do retained <-
    do sum <- ! (api/add) left right;
    do ignored <- ! (api/add) sum 10;
    ret left;
  do status <- ! (api/sub) retained 40;
  ! (api/exit) status
