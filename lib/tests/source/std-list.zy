begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    public
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  do empty <- ! (public/nil) StdInt;
  do values <- ! (public/cons) StdInt 0 empty;
  ! (public/list_eliminate)
    StdInt
    StdOS
    values
    { ! (public/exit) 1 }
    {
      fn head tail ->
        ! (public/exit) head
    }
end
