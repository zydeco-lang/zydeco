begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def identity : Thk (
    forall (A : VType) .
      A -> Ret A
  ) = {
    fn (A : VType) (value : A) ->
      ret value
  } that
  def force : Thk (
    forall (B : CType) .
      Thk B -> B
  ) = {
    fn (B : CType) (computation : Thk B) ->
      ! computation
  } that

  do status <- ! identity Int 0;
  ! force OS { ! (api/exit) status }
end
