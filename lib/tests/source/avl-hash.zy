begin
  let std = @[import("../../std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    public
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin
    let Cmp =
      begin
        param (A : VType) that
        Thk (A -> A -> Ret StdBool)
      end
    that
    def Avl :
      (VType) ->
      (VType) =
      begin
        param (A : VType) that
        data
        | +Leaf : Unit
        | +Node : Avl A * A * StdInt * Avl A
        end
      end
    that
    def leaf : Thk (
      forall (A : VType) .
        Ret (Avl A)
    ) = {
      fn (A : VType) ->
        ret +Leaf()
    } that
    def singleton : Thk (
      forall (A : VType) .
        A -> Ret (Avl A)
    ) = {
      fn (A : VType) (value : A) ->
        ret +Node(+Leaf(), value, 1, +Leaf())
    } that
    def height : Thk (
      forall (A : VType) .
        Avl A -> Ret StdInt
    ) = {
      fn (A : VType) (tree : Avl A) ->
        match tree
        | +Leaf() -> ret 0
        | +Node(_, _, value, _) -> ret value
        end
    } that
    def int_max : Thk (
      StdInt -> StdInt -> Ret StdInt
    ) = {
      fn left right ->
        do greater <- ! (public/int_gt) left right;
        ! (public/branch)
          (Ret StdInt)
          greater
          { ret left }
          { ret right }
    } that
    def fix_height : Thk (
      forall (A : VType) .
        Avl A -> Ret (Avl A)
    ) = {
      fn (A : VType) (tree : Avl A) ->
        match tree
        | +Leaf() -> ret +Leaf()
        | +Node(left, value, old_height, right) ->
          do left_height <- ! height A left;
          do right_height <- ! height A right;
          do child_height <- ! int_max left_height right_height;
          do new_height <- ! (public/add) child_height 1;
          ret +Node(left, value, new_height, right)
        end
    } that
    def balance_factor : Thk (
      forall (A : VType) .
        Avl A -> Ret StdInt
    ) = {
      fn (A : VType) (tree : Avl A) ->
        match tree
        | +Leaf() -> ret 0
        | +Node(left, _, _, right) ->
          do left_height <- ! height A left;
          do right_height <- ! height A right;
          ! (public/sub) left_height right_height
        end
    } that
    def left : Thk (
      forall (A : VType) .
        Avl A -> Ret (Avl A)
    ) = {
      fn (A : VType) (tree : Avl A) ->
        match tree
        | +Leaf() -> ret +Leaf()
        | +Node(value, _, _, _) -> ret value
        end
    } that
    def right : Thk (
      forall (A : VType) .
        Avl A -> Ret (Avl A)
    ) = {
      fn (A : VType) (tree : Avl A) ->
        match tree
        | +Leaf() -> ret +Leaf()
        | +Node(_, _, _, value) -> ret value
        end
    } that
    def min_element : Thk (
      forall (A : VType) .
        Avl A -> Cmp A -> Ret (StdOption A)
    ) = {
      fix (
        min_element :
        Thk (
          forall (A : VType) .
            Avl A -> Cmp A -> Ret (StdOption A)
        )
      ) ->
        fn (A : VType)
           (tree : Avl A)
           (comparison : Cmp A) ->
          match tree
          | +Leaf() -> ! (public/none) A
          | +Node(left, value, _, _) ->
            do minimum <- ! min_element A left comparison;
            ! (public/option_eliminate)
              A
              (Ret (StdOption A))
              minimum
              { ! (public/some) A value }
              {
                fn found ->
                  ! (public/some) A found
              }
          end
    } that
    def rotate_right : Thk (
      forall (A : VType) .
        Avl A -> Ret (Avl A)
    ) = {
      fn (A : VType) (tree : Avl A) ->
        match tree
        | +Leaf() -> ret +Leaf()
        | +Node(left, value, tree_height, right) ->
          match left
          | +Leaf() -> ret +Leaf()
          | +Node(left_left, left_value, left_height, left_right) ->
            do new_right <- ! fix_height A +Node(left_right, value, tree_height, right);
            ! fix_height A +Node(left_left, left_value, left_height, new_right)
          end
        end
    } that
    def rotate_left : Thk (
      forall (A : VType) .
        Avl A -> Ret (Avl A)
    ) = {
      fn (A : VType) (tree : Avl A) ->
        match tree
        | +Leaf() -> ret +Leaf()
        | +Node(left, value, tree_height, right) ->
          match right
          | +Leaf() -> ret +Leaf()
          | +Node(right_left, right_value, right_height, right_right) ->
            do new_left <- ! fix_height A +Node(left, value, tree_height, right_left);
            ! fix_height A +Node(new_left, right_value, right_height, right_right)
          end
        end
    } that
    def balance : Thk (
      forall (A : VType) .
        Avl A -> Ret (Avl A)
    ) = {
      fn (A : VType) (tree : Avl A) ->
        match tree
        | +Leaf() -> ret +Leaf()
        | +Node(left, value, _, right) ->
          do factor <- ! balance_factor A tree;
          do left_heavy <- ! (public/int_gt) factor 1;
          ! (public/branch)
            (Ret (Avl A))
            left_heavy
            {
              do left_factor <- ! balance_factor A left;
              do double_rotation <- ! (public/int_lt) left_factor 0;
              ! (public/branch)
                (Ret (Avl A))
                double_rotation
                {
                  do new_left <- ! rotate_left A left;
                  do tree_height <- ! height A tree;
                  ! rotate_right A +Node(new_left, value, tree_height, right)
                }
                { ! rotate_right A tree }
            }
            {
              do right_heavy <- ! (public/int_lt) factor -1;
              ! (public/branch)
                (Ret (Avl A))
                right_heavy
                {
                  do right_factor <- ! balance_factor A right;
                  do double_rotation <- ! (public/int_gt) right_factor 0;
                  ! (public/branch)
                    (Ret (Avl A))
                    double_rotation
                    {
                      do new_right <- ! rotate_right A right;
                      do tree_height <- ! height A tree;
                      ! rotate_left A +Node(left, value, tree_height, new_right)
                    }
                    { ! rotate_left A tree }
                }
                { ret tree }
            }
        end
    } that
    def insert : Thk (
      forall (A : VType) .
        A -> Avl A -> Cmp A -> Ret (Avl A)
    ) = {
      fix (
        insert :
        Thk (
          forall (A : VType) .
            A -> Avl A -> Cmp A -> Ret (Avl A)
        )
      ) ->
        fn (A : VType)
           (item : A)
           (tree : Avl A)
           (comparison : Cmp A) ->
          match tree
          | +Leaf() -> ! singleton A item
          | +Node(left, value, tree_height, right) ->
            do goes_left <- ! comparison item value;
            ! (public/branch)
              (Ret (Avl A))
              goes_left
              {
                do new_left <- ! insert A item left comparison;
                do unbalanced <- ! fix_height A +Node(new_left, value, tree_height, right);
                ! balance A unbalanced
              }
              {
                do new_right <- ! insert A item right comparison;
                do unbalanced <- ! fix_height A +Node(left, value, tree_height, new_right);
                ! balance A unbalanced
              }
          end
    } that
    def search : Thk (
      forall (A : VType) .
        A -> Avl A -> Cmp A -> Cmp A -> Ret (StdOption A)
    ) = {
      fix (
        search :
        Thk (
          forall (A : VType) .
            A -> Avl A -> Cmp A -> Cmp A -> Ret (StdOption A)
        )
      ) ->
        fn (A : VType)
           (item : A)
           (tree : Avl A)
           (equal : Cmp A)
           (less : Cmp A) ->
          match tree
          | +Leaf() -> ! (public/none) A
          | +Node(left, value, _, right) ->
            do found <- ! equal item value;
            ! (public/branch)
              (Ret (StdOption A))
              found
              { ! (public/some) A value }
              {
                do goes_left <- ! less item value;
                ! (public/branch)
                  (Ret (StdOption A))
                  goes_left
                  { ! search A item left equal less }
                  { ! search A item right equal less }
              }
          end
    } that
    def change : Thk (
      forall (A : VType) .
        A -> Avl A -> Cmp A -> Cmp A -> Ret (Avl A)
    ) = {
      fix (
        change :
        Thk (
          forall (A : VType) .
            A -> Avl A -> Cmp A -> Cmp A -> Ret (Avl A)
        )
      ) ->
        fn (A : VType)
           (item : A)
           (tree : Avl A)
           (equal : Cmp A)
           (less : Cmp A) ->
          match tree
          | +Leaf() -> ret tree
          | +Node(left, value, tree_height, right) ->
            do found <- ! equal item value;
            ! (public/branch)
              (Ret (Avl A))
              found
              { ret +Node(left, item, tree_height, right) }
              {
                do goes_left <- ! less item value;
                ! (public/branch)
                  (Ret (Avl A))
                  goes_left
                  {
                    do new_left <- ! change A item left equal less;
                    ret +Node(new_left, value, tree_height, right)
                  }
                  {
                    do new_right <- ! change A item right equal less;
                    ret +Node(left, value, tree_height, new_right)
                  }
              }
          end
    } that
    def delete : Thk (
      forall (A : VType) .
        A -> Avl A -> Cmp A -> Cmp A -> Ret (Avl A)
    ) = {
      fix (
        delete :
        Thk (
          forall (A : VType) .
            A -> Avl A -> Cmp A -> Cmp A -> Ret (Avl A)
        )
      ) ->
        fn (A : VType)
           (item : A)
           (tree : Avl A)
           (equal : Cmp A)
           (less : Cmp A) ->
          match tree
          | +Leaf() -> ret tree
          | +Node(left, value, tree_height, right) ->
            do found <- ! equal item value;
            ! (public/branch)
              (Ret (Avl A))
              found
              {
                match left
                | +Leaf() -> ret right
                | +Node(_, _, _, _) ->
                  match right
                  | +Leaf() -> ret left
                  | +Node(_, _, _, _) ->
                    do minimum <- ! min_element A right less;
                    ! (public/option_eliminate)
                      A
                      (Ret (Avl A))
                      minimum
                      { ret left }
                      {
                        fn replacement ->
                          do new_right <- ! delete A replacement right equal less;
                          do unbalanced <-
                            ! fix_height A +Node(left, replacement, tree_height, new_right);
                          ! balance A unbalanced
                      }
                  end
                end
              }
              {
                do goes_left <- ! less item value;
                ! (public/branch)
                  (Ret (Avl A))
                  goes_left
                  {
                    do new_left <- ! delete A item left equal less;
                    do unbalanced <- ! fix_height A +Node(new_left, value, tree_height, right);
                    ! balance A unbalanced
                  }
                  {
                    do new_right <- ! delete A item right equal less;
                    do unbalanced <- ! fix_height A +Node(left, value, tree_height, new_right);
                    ! balance A unbalanced
                  }
              }
          end
    } that
    def equal : Thk (
      forall (A : VType) .
        Avl A -> Avl A -> Cmp A -> Ret StdBool
    ) = {
      fix (
        equal :
        Thk (
          forall (A : VType) .
            Avl A -> Avl A -> Cmp A -> Ret StdBool
        )
      ) ->
        fn (A : VType)
           (first : Avl A)
           (second : Avl A)
           (item_equal : Cmp A) ->
          match first
          | +Leaf() ->
            match second
            | +Leaf() -> ret (public/truth)
            | +Node(_, _, _, _) -> ret (public/falsehood)
            end
          | +Node(first_left, first_value, _, first_right) ->
            match second
            | +Leaf() -> ret (public/falsehood)
            | +Node(second_left, second_value, _, second_right) ->
              do values_equal <- ! item_equal first_value second_value;
              ! (public/branch)
                (Ret StdBool)
                values_equal
                {
                  do left_equal <- ! equal A first_left second_left item_equal;
                  do right_equal <- ! equal A first_right second_right item_equal;
                  ! (public/and) left_equal right_equal
                }
                { ret (public/falsehood) }
            end
          end
    } that
    def pre_traversal : Thk (
      forall (A : VType) .
        Avl A ->
        Thk (A -> Ret StdString) ->
        Thk StdOS ->
        StdOS
    ) = {
      fix (
        pre_traversal :
        Thk (
          forall (A : VType) .
            Avl A ->
            Thk (A -> Ret StdString) ->
            Thk StdOS ->
            StdOS
        )
      ) ->
        fn (A : VType)
           (tree : Avl A)
           (format : Thk (A -> Ret StdString))
           (continuation : Thk StdOS) ->
          match tree
          | +Leaf() -> ! continuation
          | +Node(left, value, tree_height, right) ->
            do rendered_value <- ! format value;
            do with_label <- ! (public/str_append) rendered_value " h:";
            do rendered_height <- ! (public/int_to_str) tree_height;
            do line <- ! (public/str_append) with_label rendered_height;
            ! (public/write_line) line {
              ! pre_traversal A left format {
                ! pre_traversal A right format continuation
              }
            }
          end
    } that
    def Hash :
      (VType) ->
      (VType) ->
      (VType) =
      begin
        param (K : VType) that
        param (V : VType) that
        data
        | +Hash :
          Avl (K * V) *
          Cmp (K * V) *
          Cmp (K * V) *
          Cmp (K * V)
        end
      end
    that
    def hash_new : Thk (
      forall (K : VType) .
      forall (V : VType) .
        Cmp K -> Cmp K -> Cmp V -> Ret (Hash K V)
    ) = {
      fn (K : VType)
         (V : VType)
         (insert_key_less : Cmp K)
         (search_key_equal : Cmp K)
         (value_equal : Cmp V) ->
        do body <- ! leaf (K * V);
        ret +Hash(
          body,
          {
            fn first second ->
              match first
              | (first_key, _) ->
                match second
                | (second_key, _) ->
                  ! insert_key_less first_key second_key
                end
              end
          },
          {
            fn first second ->
              match first
              | (first_key, _) ->
                match second
                | (second_key, _) ->
                  ! search_key_equal first_key second_key
                end
              end
          },
          {
            fn first second ->
              match first
              | (first_key, first_value) ->
                match second
                | (second_key, second_value) ->
                  do values_equal <- ! value_equal first_value second_value;
                  do keys_equal <- ! search_key_equal first_key second_key;
                  ! (public/and) values_equal keys_equal
                end
              end
          }
        )
    } that
    def hash_insert : Thk (
      forall (K : VType) .
      forall (V : VType) .
        K -> V -> Hash K V -> Ret (Hash K V)
    ) = {
      fn (K : VType)
         (V : VType)
         (key : K)
         (value : V)
         (hash : Hash K V) ->
        match hash
        | +Hash(body, insert_less, search_equal, item_equal) ->
          do new_body <- ! insert (K * V) (key, value) body insert_less;
          ret +Hash(new_body, insert_less, search_equal, item_equal)
        end
    } that
    def hash_search : Thk (
      forall (K : VType) .
      forall (V : VType) .
        K -> V -> Hash K V -> Ret (StdOption V)
    ) = {
      fn (K : VType)
         (V : VType)
         (key : K)
         (default : V)
         (hash : Hash K V) ->
        match hash
        | +Hash(body, insert_less, search_equal, _) ->
          do result <- ! search (K * V) (key, default) body search_equal insert_less;
          ! (public/option_eliminate)
            (K * V)
            (Ret (StdOption V))
            result
            { ! (public/none) V }
            {
              fn pair ->
                match pair
                | (_, value) -> ! (public/some) V value
                end
            }
        end
    } that
    def hash_delete : Thk (
      forall (K : VType) .
      forall (V : VType) .
        K -> V -> Hash K V -> Ret (Hash K V)
    ) = {
      fn (K : VType)
         (V : VType)
         (key : K)
         (default : V)
         (hash : Hash K V) ->
        match hash
        | +Hash(body, insert_less, search_equal, item_equal) ->
          do new_body <- ! delete (K * V) (key, default) body search_equal insert_less;
          ret +Hash(new_body, insert_less, search_equal, item_equal)
        end
    } that
    def hash_change : Thk (
      forall (K : VType) .
      forall (V : VType) .
        K -> V -> Hash K V -> Ret (Hash K V)
    ) = {
      fn (K : VType)
         (V : VType)
         (key : K)
         (value : V)
         (hash : Hash K V) ->
        match hash
        | +Hash(body, insert_less, search_equal, item_equal) ->
          do new_body <- ! change (K * V) (key, value) body search_equal insert_less;
          ret +Hash(new_body, insert_less, search_equal, item_equal)
        end
    } that
    def hash_equal : Thk (
      forall (K : VType) .
      forall (V : VType) .
        Hash K V -> Hash K V -> Ret StdBool
    ) = {
      fn (K : VType)
         (V : VType)
         (first : Hash K V)
         (second : Hash K V) ->
        match first
        | +Hash(first_body, _, _, first_item_equal) ->
          match second
          | +Hash(second_body, _, _, _) ->
            ! equal (K * V) first_body second_body first_item_equal
          end
        end
    } that

    do hash <- ! hash_new StdInt StdString
      (public/int_lt)
      (public/int_eq)
      (public/str_eq);
    do hash <- ! hash_insert StdInt StdString 1 "one" hash;
    do hash <- ! hash_insert StdInt StdString 2 "two" hash;
    do hash <- ! hash_insert StdInt StdString 3 "three" hash;
    do hash <- ! hash_insert StdInt StdString 4 "four" hash;
    do hash <- ! hash_insert StdInt StdString 5 "five" hash;
    do hash <- ! hash_insert StdInt StdString 6 "six" hash;
    do hash <- ! hash_insert StdInt StdString 7 "seven" hash;
    do hash <- ! hash_insert StdInt StdString 8 "eight" hash;
    do hash <- ! hash_insert StdInt StdString 9 "nine" hash;
    do hash <- ! hash_insert StdInt StdString 10 "ten" hash;

    do expected <- ! hash_new StdInt StdString
      (public/int_lt)
      (public/int_eq)
      (public/str_eq);
    do expected <- ! hash_insert StdInt StdString 1 "one change" expected;
    do expected <- ! hash_insert StdInt StdString 2 "two" expected;
    do expected <- ! hash_insert StdInt StdString 3 "three" expected;
    do expected <- ! hash_insert StdInt StdString 4 "four change" expected;
    do expected <- ! hash_insert StdInt StdString 7 "seven" expected;
    do expected <- ! hash_insert StdInt StdString 8 "eight" expected;
    do expected <- ! hash_insert StdInt StdString 9 "nine" expected;
    do expected <- ! hash_insert StdInt StdString 10 "ten change" expected;

    do hash <- ! hash_delete StdInt StdString 5 "default" hash;
    do hash <- ! hash_delete StdInt StdString 6 "default" hash;
    do hash <- ! hash_change StdInt StdString 1 "one change" hash;
    do hash <- ! hash_change StdInt StdString 4 "four change" hash;
    do hash <- ! hash_change StdInt StdString 10 "ten change" hash;
    do hashes_equal <- ! hash_equal StdInt StdString hash expected;
    do first <- ! hash_search StdInt StdString 1 "default" hash;
    do second <- ! hash_search StdInt StdString 1 "default" hash;
    ! (public/option_eliminate)
      StdString
      StdOS
      first
      { ! (public/exit) 1 }
      {
        fn first_value ->
          ! (public/option_eliminate)
            StdString
            StdOS
            second
            { ! (public/exit) 1 }
            {
              fn second_value ->
                do values_equal <- ! (public/str_eq) first_value second_value;
                do result <- ! (public/and) hashes_equal values_equal;
                ! (public/branch)
                  StdOS
                  result
                  { ! (public/exit) 0 }
                  { ! (public/exit) 1 }
            }
      }
  end
end
