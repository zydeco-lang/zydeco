begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Bool : VType =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def Option : (VType) -> (VType) =
    begin
      param (A : VType) that
      data
      | +None : Unit
      | +Some : A
      end
    end
  that
  def Syn : VType =
    data
    | +Str : String
    | +Concat : Syn * Syn
    | +Kleene : Syn
    | +Choose : Syn * Syn
    end
  that
  def Matcher : CType =
    codata
    | .str : String -> Ret (Option String)
    | .concat : Syn -> Syn -> Ret (Option String)
    | .kleene : Syn -> Ret (Option String)
    | .choose : Syn -> Syn -> Ret (Option String)
    | .bind : Syn -> Ret (Option String)
    end
  that
  def Regex : CType =
    codata
    | .run : String -> Matcher
    end
  that

  def int_lt : Thk (Int -> Int -> Ret Bool) = {
    fn left right ->
      ! (api/int_lt_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def char_eq : Thk (Char -> Char -> Ret Bool) = {
    fn left right ->
      do left <- ! (api/char_to_int) left;
      do right <- ! (api/char_to_int) right;
      ! (api/int_eq_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def str_chop_head : Thk (String -> Int -> Ret String) = {
    fn source index ->
      do length <- ! (api/str_length) source;
      let collect : Thk (String -> Int -> String -> Ret String) = {
        fix (
          collect :
          Thk (String -> Int -> String -> Ret String)
        ) ->
          fn source index result ->
            do continues <- ! int_lt index length;
            match continues
            | +False() -> ret result
            | +True() ->
              do character <- ! (api/str_index) source index;
              do suffix <- ! (api/char_to_str) character;
              do result <- ! (api/str_append) result suffix;
              do next <- ! (api/add) index 1;
              ! collect source next result
            end
      } in
      ! collect source index ""
  } that
  def str_eq_at : Thk (String -> String -> Int -> Ret Bool) = {
    fn left right index ->
      do left <- ! (api/str_index) left index;
      do right <- ! (api/str_index) right index;
      ! char_eq left right
  } that
  def str_match : Thk (String -> String -> Ret (Option String)) = {
    fn source pattern ->
      let match_from : Thk (
        Int ->
        String ->
        String ->
        Ret (Option String)
      ) = {
        fix (
          match_from :
          Thk (
            Int ->
            String ->
            String ->
            Ret (Option String)
          )
        ) ->
          fn index source pattern ->
            do source_length <- ! (api/str_length) source;
            do pattern_length <- ! (api/str_length) pattern;
            do source_continues <- ! int_lt index source_length;
            do pattern_continues <- ! int_lt index pattern_length;
            match pattern_continues
            | +False() ->
              do remainder <- ! str_chop_head source index;
              ret +Some(remainder)
            | +True() ->
              match source_continues
              | +False() -> ret +None()
              | +True() ->
                do matches <- ! str_eq_at source pattern index;
                match matches
                | +False() -> ret +None()
                | +True() ->
                  do next <- ! (api/add) index 1;
                  ! match_from next source pattern
                end
              end
            end
      } in
      ! match_from 0 source pattern
  } that
  def regex : Thk Regex = {
    fix (regex : Thk Regex) ->
      comatch
      | .run source ->
        comatch
        | .str pattern -> ! str_match source pattern
        | .concat left right ->
          do remainder <- ! regex .run source .bind left;
          match remainder
          | +None() -> ret +None()
          | +Some(remainder) ->
            ! regex .run remainder .bind right
          end
        | .kleene syntax ->
          do remainder <- ! regex .run source .bind syntax;
          match remainder
          | +None() -> ret +Some(source)
          | +Some(remainder) -> ! regex .run remainder .kleene syntax
          end
        | .choose left right ->
          do remainder <- ! regex .run source .bind left;
          match remainder
          | +Some(remainder) -> ret +Some(remainder)
          | +None() -> ! regex .run source .bind right
          end
        | .bind syntax ->
          match syntax
          | +Str(pattern) -> ! regex .run source .str pattern
          | +Concat(left, right) -> ! regex .run source .concat left right
          | +Kleene(body) -> ! regex .run source .kleene body
          | +Choose(left, right) -> ! regex .run source .choose left right
          end
        end
      end
  } that
  def demo : Thk (Syn -> String -> Thk OS -> OS) = {
    fn syntax source continuation ->
      do result <- ! regex .run source .bind syntax;
      match result
      | +Some(remainder) -> ! (api/write_line) remainder continuation
      | +None() -> ! (api/exit) 1
      end
  } that

  ! demo
    +Concat(
      +Kleene(+Str("p")),
      +Concat(
        +Kleene(+Str("q")),
        +Choose(+Str("xos"), +Str("sox"))
      )
    )
    "pppqqqsox\\^o^/"
    { ! (api/exit) 0 }
end
