begin
  def Bool : VType =
    data
    | +False : Unit
    | +True : Unit
    end
  that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  def choose : Thk (Bool -> Thk (Int -> OS) -> OS) = {
    fn (condition : Bool) (continuation : Thk (Int -> OS)) ->
      match condition
      | +True(_) -> ! continuation 0
      | +False(_) -> ! continuation 1
      end
  } that

  ! choose (+True()) {
    fn value ->
      match (+True() : Bool)
      | +True(_) -> ! (api/exit) value
      | +False(_) -> ! (api/exit) 0
      end
  }
end
