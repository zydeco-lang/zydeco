begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def List :
    (VType) ->
    (VType) =
    begin
      param (A : VType) that
      data
      | +Nil : Unit
      | +Cons : A * List A
      end
    end
  that
  def merge : Thk (
    List Int ->
    List Int ->
    Ret (List Int)
  ) = {
    fix (merge : Thk (
      List Int ->
      List Int ->
      Ret (List Int)
    )) ->
      fn left right ->
        match left
        | +Nil() -> ret right
        | +Cons(left_head, left_tail) ->
          match right
          | +Nil() -> ret left
          | +Cons(right_head, right_tail) ->
            ! (api/int_gt_branch)
              (Ret (List Int))
              left_head
              right_head
              {
                do result <- ! merge left right_tail;
                ret +Cons(right_head, result)
              }
              {
                do result <- ! merge left_tail right;
                ret +Cons(left_head, result)
              }
          end
        end
  } that

  ! (api/exit) 0
end
