begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  let captured = 100 that
  def constant : Thk (
    forall (A : VType) .
    forall (B : VType) .
      A -> B -> Ret A
  ) = {
    fn (A : VType)
       (B : VType)
       (value : A)
       (ignored : B) ->
      let _ = captured in
      ret value
  } that
  def zero : Thk (Int -> Ret Int) = {
    fn ignored ->
      ! constant Int Int 0 ignored
  } that

  do status <- ! zero 20;
  ! (api/exit) status
end
