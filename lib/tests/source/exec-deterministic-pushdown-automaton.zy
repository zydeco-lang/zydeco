begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Bool : VType =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def Tok : VType =
    data
    | +LParen : Unit
    | +RParen : Unit
    end
  that
  def LazyList : (VType) -> (VType) =
    begin
      param (A : VType) that
      data
      | +Nil : Unit
      | +Cons : A * Thk (Ret (LazyList A))
      end
    end
  that
  def ParenCounterState : VType =
    data
    | +Ok : Unit
    | +Reject : Unit
    end
  that
  def ParenCounterStack : CType =
    codata
    | .none : Ret Bool
    | .some : ParenCounterStack
    end
  that
  let ParenCounterTransition : CType =
    ParenCounterState -> ParenCounterStack
  that

  def bool_eq : Thk (Bool -> Bool -> Ret Bool) = {
    fn left right ->
      match left
      | +True() ->
        match right
        | +True() -> ret +True()
        | +False() -> ret +False()
        end
      | +False() ->
        match right
        | +True() -> ret +False()
        | +False() -> ret +True()
        end
      end
  } that
  def bool_to_string : Thk (Bool -> Ret String) = {
    fn value ->
      match value
      | +True() -> ret "true"
      | +False() -> ret "false"
      end
  } that
  def paren_foldr : Thk (
    Thk (Ret (LazyList Tok)) ->
    Thk (Tok -> Thk ParenCounterTransition -> ParenCounterTransition) ->
    Thk ParenCounterTransition ->
    ParenCounterTransition
  ) = {
    fix (
      paren_foldr :
      Thk (
        Thk (Ret (LazyList Tok)) ->
        Thk (Tok -> Thk ParenCounterTransition -> ParenCounterTransition) ->
        Thk ParenCounterTransition ->
        ParenCounterTransition
      )
    ) ->
      fn values step final ->
        do layer <- ! values;
        match layer
        | +Nil() -> ! final
        | +Cons(head, tail) ->
          ! step head { ! paren_foldr tail step final }
        end
  } that
  def reject : Thk ParenCounterStack = {
    fix (reject : Thk ParenCounterStack) ->
      comatch
      | .none -> ret +False()
      | .some -> ! reject
      end
  } that
  def try_accept : Thk ParenCounterStack = {
    comatch
    | .none -> ret +True()
    | .some -> ! reject
    end
  } that
  def accept_or_not : Thk (ParenCounterState -> ParenCounterStack) = {
    fn state ->
      match state
      | +Ok() -> ! try_accept
      | +Reject() -> ! reject
      end
  } that
  def paren_counter_step : Thk (
    Tok ->
    Thk ParenCounterTransition ->
    ParenCounterTransition
  ) = {
    fn token continuation state ->
      match token
      | +LParen() -> ! continuation state .some
      | +RParen() ->
        (comatch
        | .none -> ! continuation (+Reject() : ParenCounterState) .none
        | .some -> ! continuation state
        end)
      end
  } that
  def demonstrate : Thk (
    String ->
    Bool ->
    Thk (Ret (LazyList Tok)) ->
    Thk OS ->
    OS
  ) = {
    fn source expected tokens continuation ->
      do heading <- ! (api/str_append)
        "The following parens are balanced? "
        source;
      do actual <- ! paren_foldr
        tokens
        paren_counter_step
        accept_or_not
        (+Ok() : ParenCounterState)
        .none;
      do passes <- ! bool_eq expected actual;
      match passes
      | +True() ->
        do rendered <- ! bool_to_string actual;
        ! (api/write_line) heading {
          ! (api/write_line) rendered continuation
        }
      | +False() ->
        ! (api/write_line) "WRONG ANSWER" { ! (api/exit) 1 }
      end
  } that

  ! demonstrate
    "(())"
    (+True() : Bool)
    {
      ret +Cons(
        +LParen(),
        {
          ret +Cons(
            +LParen(),
            {
              ret +Cons(
                +RParen(),
                {
                  ret +Cons(+RParen(), { ret +Nil() })
                }
              )
            }
          )
        }
      )
    }
    {
      ! demonstrate
        "()()"
        (+True() : Bool)
        {
          ret +Cons(
            +LParen(),
            {
              ret +Cons(
                +RParen(),
                {
                  ret +Cons(
                    +LParen(),
                    {
                      ret +Cons(+RParen(), { ret +Nil() })
                    }
                  )
                }
              )
            }
          )
        }
        {
          ! demonstrate
            ")(()"
            (+False() : Bool)
            {
              ret +Cons(
                +RParen(),
                {
                  ret +Cons(
                    +LParen(),
                    {
                      ret +Cons(
                        +LParen(),
                        {
                          ret +Cons(+RParen(), { ret +Nil() })
                        }
                      )
                    }
                  )
                }
              )
            }
            {
              ! demonstrate
                "()("
                (+False() : Bool)
                {
                  ret +Cons(
                    +LParen(),
                    {
                      ret +Cons(
                        +RParen(),
                        {
                          ret +Cons(+LParen(), { ret +Nil() })
                        }
                      )
                    }
                  )
                }
                {
                  ! demonstrate
                    "()"
                    (+True() : Bool)
                    {
                      ret +Cons(
                        +LParen(),
                        {
                          ret +Cons(+RParen(), { ret +Nil() })
                        }
                      )
                    }
                    {
                      ! demonstrate
                        "("
                        (+False() : Bool)
                        {
                          ret +Cons(+LParen(), { ret +Nil() })
                        }
                        {
                          ! demonstrate
                            ")"
                            (+False() : Bool)
                            {
                              ret +Cons(+RParen(), { ret +Nil() })
                            }
                            {
                              ! demonstrate
                                ""
                                (+True() : Bool)
                                { ret +Nil() }
                                { ! (api/exit) 0 }
                            }
                        }
                    }
                }
            }
        }
    }
end
