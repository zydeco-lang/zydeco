begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Stack : (VType) -> (CType) =
    begin
      param (A : VType) that
      codata
      | .app : A -> Stack A
      | .return : Ret A
      end
    end
  that
  def abort : Thk (Int -> Stack Int) = {
    fix (abort : Thk (Int -> Stack Int)) ->
      fn (value : Int) ->
        comatch
        | .app _ -> ! abort value
        | .return -> ret value
        end
  } that

  do status <- ! abort 0 .app 1 .app 2 .app 3 .return;
  ! (api/exit) status
end
