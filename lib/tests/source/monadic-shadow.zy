begin
  let outer_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! outer_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);

  begin
    let inner_basis = @[import("../../std/monad.zy")] _ that
    do (= Monad, = Algebra, ()) <-
      ! inner_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);

    begin
      monadic
        ret ()
      end
    end
  end
end
