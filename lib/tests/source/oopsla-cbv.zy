begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Bool : VType =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def Expr : VType =
    data
    | +Var : String
    | +Lam : String * Expr
    | +App : Expr * Expr
    | +True : Unit
    | +False : Unit
    | +If : Expr * Expr * Expr
    end
  that
  def Env : VType =
    data
    | +Empty : Unit
    | +Cons : String * Value * Env
    end
  that
  def Value : VType =
    data
    | +True : Unit
    | +False : Unit
    | +Closure : Thk (Value -> Machine)
    end
  that
  def Machine : CType =
    codata
    | .fun : Expr * Env -> Machine
    | .app : Value -> Machine
    | .if : Expr * Expr * Env -> Machine
    | .bind : Ret Answer
    end
  that
  def Answer : VType =
    data
    | +Ok : Value
    | +Err : Unit
    end
  that
  def Interp : CType =
    codata
    | .descend : Expr * Env -> Machine
    | .ascend : Value -> Machine
    end
  that

  def str_eq : Thk (String -> String -> Ret Bool) = {
    fn left right ->
      ! (api/str_eq_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def panic : Thk (String -> OS) = {
    fn message ->
      ! (api/write_line) message {
        ! (api/exit) 1
      }
  } that
  def lookup : Thk (String -> Env -> Ret Answer) = {
    fix (lookup : Thk (String -> Env -> Ret Answer)) ->
      fn requested environment ->
        match environment
        | +Empty() -> ret +Err()
        | +Cons(name, value, remaining) ->
          do equal <- ! str_eq requested name;
          match equal
          | +True() -> ret +Ok(value)
          | +False() -> ! lookup requested remaining
          end
        end
  } that
  def value_to_str : Thk (Value -> Ret String) = {
    fn value ->
      match value
      | +True() -> ret "true"
      | +False() -> ret "false"
      | +Closure(_) -> ret "<closure>"
      end
  } that
  def error : Thk Machine = {
    fix (error : Thk Machine) ->
      comatch
      | .fun _ -> ! error
      | .app _ -> ! error
      | .if _ -> ! error
      | .bind -> ret +Err()
      end
  } that
  def interp : Thk Interp = {
    fix (interp : Thk Interp) ->
      comatch
      | .descend (expression, environment) ->
        match expression
        | +Var(name) ->
          do result <- ! lookup name environment;
          match result
          | +Err(_) -> ! error
          | +Ok(value) -> ! interp .ascend value
          end
        | +True() -> ! interp .ascend +True()
        | +False() -> ! interp .ascend +False()
        | +Lam(name, body) ->
          ! interp .ascend +Closure({
            fn value ->
              ! interp .descend (body, +Cons(name, value, environment))
          })
        | +App(function, argument) ->
          ! interp .descend (function, environment) .fun (argument, environment)
        | +If(condition, consequent, alternative) ->
          ! interp
            .descend
            (condition, environment)
            .if
            (consequent, alternative, environment)
        end
      | .ascend value ->
        comatch
        | .fun (argument, environment) ->
          ! interp .descend (argument, environment) .app value
        | .app function ->
          match function
          | +True(_) -> ! error
          | +False(_) -> ! error
          | +Closure(body) -> ! body value
          end
        | .if (consequent, alternative, environment) ->
          match value
          | +True(_) -> ! interp .descend (consequent, environment)
          | +False(_) -> ! interp .descend (alternative, environment)
          | +Closure(_) -> ! error
          end
        | .bind -> ret +Ok(value)
        end
      end
  } that

  def identity : Expr =
    +Lam("x", +Var("x"))
  that
  def idff : Expr =
    +App(identity, +False())
  that
  def true_ : Expr =
    +Lam("x", +Lam("y", +Var("x")))
  that
  def false_ : Expr =
    +Lam("x", +Lam("y", +Var("y")))
  that
  def if_ : Expr =
    +Lam(
      "c",
      +Lam(
        "t",
        +Lam(
          "f",
          +App(+App(+Var("c"), +Var("t")), +Var("f"))
        )
      )
    )
  that
  def w : Expr =
    +Lam("x", +App(+Var("x"), +Var("x")))
  that
  def omega : Expr =
    +App(w, w)
  that
  def if_true : Expr =
    +App(+App(+App(if_, true_), +True()), +False())
  that

  do result <- ! interp .descend (if_true, +Empty()) .bind;
  match result
  | +Err(_) -> ! panic "ERROR"
  | +Ok(value) ->
    do output <- ! value_to_str value;
    ! (api/write_line) output {
      ! (api/exit) 0
    }
  end
end
