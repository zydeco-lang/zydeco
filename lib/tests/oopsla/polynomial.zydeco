begin
  param (
    (
      /Ret;
      /Int;
      /add;
      /sub;
      /mul;
      /exit
    ) :
    @[import("../../std/builtin.zy")] _
  ) that

  def ! poly (x : Int) : Ret Int =
    -- f(x) = x^2 + x + 10
    do s <- ! (mul) x x;
    do y <- ! (add) x 10;
    ! (add) s y
  that

  -- the exit code should be 0 for the test to pass
  do r <- ! poly 10;
  -- since f(10) = 120, we minus the result by 120 to get 0
  do e <- ! (sub) r 120;
  ! (exit) e
end
