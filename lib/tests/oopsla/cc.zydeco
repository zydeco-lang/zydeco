begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that

  def Fn :
    (VType) ->
    (CType) ->
    (CType) =
    begin
      param (A : VType) that
      param (B : CType) that
      codata
      | .push : A -> B
      end
    end
  that
  def FnOpt :
    (VType) ->
    (CType) ->
    (CType) =
    begin
      param (A : VType) that
      param (B : CType) that
      codata
      | .some : A -> B
      | .none : B
      end
    end
  that
  def FnVar :
    (VType) ->
    (CType) ->
    (CType) =
    begin
      param (A : VType) that
      param (B : CType) that
      codata
      | .more : A -> FnVar A B
      | .done : B
      end
    end
  that
  let FnVarOnce :
    (VType) ->
    (CType) ->
    (CType) =
    begin
      param (A : VType) that
      param (B : CType) that
      A -> FnVar A B
    end
  that

  def sum_and_mult : Thk (FnVar Int (FnOpt Int (Ret Int))) = {
    (fix (
      loop :
      Thk (Int -> FnVar Int (FnOpt Int (Ret Int)))
    ) ->
      fn sum ->
        comatch
        | .more integer ->
          do sum <- ! (api/add) sum integer;
          ! loop sum
        | .done ->
          comatch
          | .some integer -> ! (api/mul) sum integer
          | .none -> ret sum
          end
        end)
      0
  } that
  def sum_and_mult' : Thk (FnVar Int (FnOpt Int (Ret Int))) = {
    let fix loop (sum : Int) : FnVar Int (FnOpt Int (Ret Int)) =
      comatch
      | .more integer ->
        do sum <- ! (api/add) sum integer;
        ! loop sum
      | .done ->
        comatch
        | .some integer -> ! (api/mul) sum integer
        | .none -> ret sum
        end
      end
    in
    ! loop 0
  } that

  do result <- ! sum_and_mult .more 1 .more 2 .more 3 .done .some 4;
  do status <- ! (api/sub) result 24;
  ! (api/exit) status
end
