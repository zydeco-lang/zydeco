--| Examples of exception monads
begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  let Either (E : VType) (A : VType) =
    data
    | +Left : E
    | +Right : A
    end
  that
  let MonadErr (E : VType) (M : (VType) -> (CType)) =
    codata
    | .fail :
      forall (A : VType) .
        E -> M A
    end
  that
  --| Ret Either exception monad
  let Exn (E : VType) (A : VType) =
    codata
    | .done : Ret (Either E A)
    end
  that
  --| Church-encoded exception monad
  let ExnK (E : VType) (A : VType) =
    codata
    | .run :
      forall (R : CType) .
        Thk (E -> R) -> Thk (A -> R) -> R
    end
  that
  --| Defunctionalized exception monad
  def ExnDe (E : VType) (A : VType) : CType =
    codata
    | .try :
      forall (E' : VType) .
        Thk (E -> ExnDe E' A) -> ExnDe E' A
    | .kont :
      forall (A' : VType) .
        Thk (A -> ExnDe E A') -> ExnDe E A'
    | .done : Ret (Either E A)
    end
  that
  let ExnCounter = ExnDe Unit Int that

  def mexn : Thk (
    forall (E : VType) .
      Monad (Exn E)
  ) = {
    fn E ->
      comatch
      | .return A a ->
        fn .done ->
          ret +Right(a)
      | .bind A A' m f ->
        do a? <- ! m .done;
        match a?
        | +Left(e) ->
          fn .done ->
            ret +Left(e)
        | +Right(a) ->
          fn .done ->
            ! f a .done
        end
      end
  } that
  def mexnk : Thk (
    forall (E : VType) .
      Monad (ExnK E)
  ) = {
    fn E ->
      comatch
      | .return A a ->
        fn .run R ke ka ->
          ! ka a
      | .bind A A' m f ->
        fn .run R ke ka ->
          ! m .run R ke {
            fn a ->
              ! f a .run R ke ka
          }
      end
  } that
  def mexnde : Thk (
    forall (E : VType) .
      Monad (ExnDe E)
  ) = {
    fix (mexnde : Thk (
      forall (E : VType) .
        Monad (ExnDe E)
    )) ->
      fn E ->
        comatch
        | .return ->
          fn A a ->
            comatch
            | .try ->
              fn E' k ->
                ! mexnde E' .return A a
            | .kont ->
              fn A' k ->
                ! k a
            | .done -> ret +Right(a)
            end
        | .bind ->
          fn A A' m f ->
            ! m .kont A' f
        end
  } that
  def mexnde_err : Thk (
    forall (E : VType) .
      MonadErr E (ExnDe E)
  ) = {
    fix (mexnde_err : Thk (
      forall (E : VType) .
        MonadErr E (ExnDe E)
    )) ->
      fn E ->
        comatch
        | .fail ->
          fn A e ->
            comatch
            | .try ->
              fn E' k ->
                ! k e
            | .kont ->
              fn A' k ->
                ! mexnde_err E .fail A' e
            | .done -> ret +Left(e)
            end
        end
  } that
  --| Proof of the violation of the monad laws of
  --| the defunctionalized exception monad above
  def count_kont : Thk (
    forall (E : VType) .
    forall (A : VType) .
      Int -> Thk (Int -> ExnDe E A) -> ExnDe E A
  ) = {
    fix (count_kont : Thk (
      forall (E : VType) .
      forall (A : VType) .
        Int -> Thk (Int -> ExnDe E A) -> ExnDe E A
    )) ->
      fn E A i fi ->
        comatch
        | .try ->
          fn E' ke ->
            ! count_kont E' A i {
              fn i ->
                ! fi i .try E' ke
            }
        | .kont ->
          fn A' ka ->
            do i' <- ! (api/add) i 1;
            ! count_kont E A' i' {
              fn i ->
                ! fi i .kont A' ka
            }
        | .done -> ! fi i .done
        end
  } that
  def bench : Thk (
    Thk (Thk ExnCounter -> ExnCounter) ->
    Ret Int
  ) = {
    fn impl ->
      do i? <- ! impl {
        ! count_kont Unit Int 0 {
          ! mexnde Unit .return Int
        }
      } .done;
      match i?
      | +Left(e) -> ret -1
      | +Right(i) -> ret i
      end
  } that
  -- LHS and RHS of the associativity law
  def lhs : Thk (
    Thk (Int -> ExnDe Unit Int) ->
    Thk (Int -> ExnDe Unit Int) ->
    Thk (ExnDe Unit Int) ->
    ExnDe Unit Int
  ) = {
    fn f g m ->
      ! mexnde Unit .bind Int Int
        {
          ! mexnde Unit .bind Int Int m f
        }
        g
  } that
  def rhs : Thk (
    Thk (Int -> ExnDe Unit Int) ->
    Thk (Int -> ExnDe Unit Int) ->
    Thk (ExnDe Unit Int) ->
    ExnDe Unit Int
  ) = {
    fn f g m ->
      ! mexnde Unit .bind Int Int m {
        fn i ->
          ! mexnde Unit .bind Int Int { ! f i } g
      }
  } that

  -- Observable violation of the monad laws because the results are different
  let triv : Thk (Int -> ExnDe Unit Int) = {
    ! mexnde Unit .return Int
  } in
  do a <- ! bench {
    fn i ->
      ! lhs triv triv i
  };
  do b <- ! bench {
    fn i ->
      ! rhs triv triv i
  };
  -- syntactic sugar:
  -- do~ M; N ==> M { N }
  ! (api/write_int) a {
    ! (api/write_str) " != " {
      ! (api/write_int) b {
        ! (api/write_str) "\n" {
          ! (api/exit) 0
        }
      }
    }
  }
end
end
