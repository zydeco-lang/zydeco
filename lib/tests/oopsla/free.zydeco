begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  def Empty : VType =
    data
    end
  that
  def Kont :
    (CType) ->
    (VType) ->
    (CType) =
    begin
      param (R : CType) that
      param (A : VType) that
      codata
      | .run : Thk (A -> R) -> R
      end
    end
  that
  let KRead :
    (CType) ->
    (VType) =
    begin
      param (R : CType) that
      Thk (Unit -> Kont R String)
    end
  that
  let KWrite :
    (CType) ->
    (VType) =
    begin
      param (R : CType) that
      Thk (String -> Kont R Unit)
    end
  that
  let KFail :
    (VType) ->
    (CType) ->
    (VType) =
    begin
      param (E : VType) that
      param (R : CType) that
      Thk (E -> Kont R Empty)
    end
  that
  def Free :
    (VType) ->
    (CType) =
    begin
      param (A : VType) that
      codata
      | .run :
        forall (R : CType) .
          KRead R ->
          KWrite R ->
          KFail String R ->
          Kont R A
      end
    end
  that

  def mfree : Thk (Monad Free) = {
    comatch
    | .return A value ->
      fn .run R read write fail ->
      fn .run continuation ->
        ! continuation value
    | .bind A B computation function ->
      fn .run R read write fail ->
      fn .run continuation ->
        ! computation
          .run R read write fail
          .run {
            fn value ->
              ! function value
                .run R read write fail
                .run continuation
          }
    end
  } that
  def read : Thk (Unit -> Free String) = {
    fn () ->
      fn .run R read write fail ->
        ! read ()
  } that
  def write : Thk (String -> Free Unit) = {
    fn string ->
      fn .run R read write fail ->
        ! write string
  } that
  def fail : Thk (String -> Free Empty) = {
    fn string ->
      fn .run R read write fail ->
        ! fail string
  } that
  def read_os : Thk (Unit -> Kont OS String) = {
    fn () ->
      fn .run continuation ->
        ! (api/read_line) continuation
  } that
  def write_os : Thk (String -> Kont OS Unit) = {
    fn string ->
      fn .run continuation ->
        ! (api/write_line) string {
          ! continuation ()
        }
  } that
  def fail_os : Thk (String -> Kont OS Empty) = {
    fn string ->
      fn .run continuation ->
        ! (api/write_line) string {
          ! (api/exit) 1
        }
  } that

  let program : Thk (Free Unit) = {
    ! mfree .bind String Unit { ! read () } {
      fn string ->
        ! write string
    }
  } in
  ! program
    .run OS read_os write_os fail_os
    .run {
      fn () ->
        ! (api/exit) 0
    }
end
end
