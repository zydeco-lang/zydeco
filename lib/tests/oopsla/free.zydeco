--| The Free monad
begin
  let monadic_basis = @[import("../../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  let Empty =
    data
    end
  that
  let Kont (R : CType) (A : VType) =
    codata
    | .run : Thk (A -> R) -> R
    end
  that
  -- Types of handlers
  let KRead (R : CType) =
    Thk (Unit -> Kont R String)
  that
  let KWrite (R : CType) =
    Thk (String -> Kont R Unit)
  that
  let KFail (E : VType) (R : CType) =
    Thk (E -> Kont R Empty)
  that
  -- A specific free monad with three handlers
  let Free (A : VType) =
    codata
    | .run :
      forall (R : CType) .
        KRead R ->
        KWrite R ->
        KFail String R ->
        Kont R A
    end
  that

  def mfree : Thk (Monad Free) = {
    comatch
    | .return A a ->
      fn .run R read write fail ->
      fn .run k ->
        ! k a
    | .bind A A' m f ->
      fn .run R read write fail ->
      fn .run k' ->
        ! m
          .run R read write fail
          .run {
            fn a ->
              ! f a
                .run R read write fail
                .run k'
          }
    end
  } that
  -- The interface for using Free
  def read : Thk (Unit -> Free String) = {
    fn () ->
      fn .run R read write fail ->
        ! read ()
  } that
  def write : Thk (String -> Free Unit) = {
    fn s ->
      fn .run R read write fail ->
        ! write s
  } that
  def fail : Thk (String -> Free Empty) = {
    fn s ->
      fn .run R read write fail ->
        ! fail s
  } that
  def read_os : Thk (Unit -> Kont OS String) = {
    fn () ->
      fn .run k ->
        ! (api/read_line) k
  } that
  def write_os : Thk (String -> Kont OS Unit) = {
    fn s ->
      fn .run k ->
        ! (api/write_line) s {
          ! k ()
        }
  } that
  def fail_os : Thk (String -> Kont OS Empty) = {
    fn s ->
      fn .run k ->
        ! (api/write_line) s {
          ! (api/exit) 1
        }
  } that

  let prog : Thk (Free Unit) = {
    ! mfree .bind String Unit { ! read () } {
      fn s ->
        ! write s
    }
  } in
  ! prog
    .run OS read_os write_os fail_os
    .run {
      fn () ->
        ! (api/exit) 0
    }
end
end
