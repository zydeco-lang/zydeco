param (/numeric; /process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  let monadic_basis = @(import("../../std/effect/monad.zy")) that

  let int = numeric/int that
  let (/Monad; /Algebra) = monadic_basis in
  begin
    def ! ret_monad : Monad Ret =
      comatch
      | .return A value => ret value
      | .bind A B computation function =>
        do value <- ! computation;
        ! function value
      end
    that
    def ! translated = @[monadic] begin
      do value <- ret 1;
      ret value
    end that

    do value <- ! translated Ret ret_monad;
    ! int/eq
      OS
      value
      1
      { ! process/exit 0 }
      { ! process/exit 1 }
  end
end
