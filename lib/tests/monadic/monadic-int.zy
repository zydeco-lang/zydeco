begin
  let monadic_basis = @(import("../../std/control/monad.zy")) that
  param (/numeric; /system; /Ret; /OS; /process; /Int64; builtin) :
  @(import("../../std/builtin.zy")) that
  let int64 = numeric/int64 that
  let (= Monad, = Algebra, ()) = builtin |> monadic_basis in
  begin

    def ! ret_monad : Monad Ret =
      comatch
      | .return A value => ret value
      | .bind A B computation function =>
        do value <- ! computation;
        ! function value
      end
    that
    def ! translated = @[monadic] begin
      do value <- ret 1;
      ret value
    end that

    do value <- ! translated Ret { ! ret_monad };
    ! int64/eq
      OS
      value
      1
      { ! process/exit 0 }
      { ! process/exit 1 }
  end
end
