-- stage: run
-- backends: interpreter, exe
param (/process; builtin) : @(import("../../std/builtin.zy")) in
begin
  let monadic_basis = @(import("../../std/effect/monad.zy")) that

  let (/Monad; /Algebra) = monadic_basis in
  begin
    def ! ret_monad : Monad Ret =
      comatch
      | .return A value => ret value
      | .bind A B computation continuation =>
        do value <- ! computation;
        ! continuation value
      end
    that
    def ! translated = @[monadic] begin
      ret ()
    end that

    do _ <- ! translated Ret ret_monad;
    ! process/exit 0
  end
end
