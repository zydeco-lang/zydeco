param (/process; builtin) : @(import("../../std/builtin.zy")) in
let (/make = make_prelude) = @(import("../../std/prelude.zy")) in
let prelude = make_prelude builtin in
@[prelude(core, from(prelude))]
begin
  def Option (A : VType) =
    data
    | +None : Unit
    | +Some : A
    end
  that
  def OptionT (M : VType -> CType) (A : VType) =
    codata
    | .trans : M (Option A)
    end
  that
  let Return (X : VType) = Ret X that
  let Option' (A : VType) = OptionT Return A that
  def ! o : Option' Int =
    comatch
    | .trans => ret +Some(1)
    end
  that

  ! process/exit 0
end
