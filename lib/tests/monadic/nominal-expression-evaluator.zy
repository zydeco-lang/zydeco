-- A nominal expression type and evaluator translated under State and Exception.
param (/VType; /Thk; /Ret; /Unit; /Int; /numeric; /process; builtin) : @(import(
  "../../std/builtin.zy"
)) in
let basis = @(import("../../std/control/monad.zy")) in
let (/Monad; /Algebra; /WithMonad) = builtin |> basis in
let state = @(import("../../std/control/state.zy")) in
let (/IState; /instance = state_instance) = builtin |> state in
let exception = @(import("../../std/control/exception.zy")) in
let (/IException; /instance = exception_instance) = builtin |> exception in
let evaluate = {
  @[monadic] fn (lookup : Thk (Int -> Ret Int)) (add : Thk (Int -> Int -> Ret Int)) =>
    begin
      def Expr : VType =
        data
        | +Lit : Int
        | +Var : Int
        | +Add : Expr * Expr
        end
      that
      def fix eval (e : Expr) : Ret Int =
        match e
        | +Lit(x) => ret x
        | +Var(x) => ! lookup x
        | +Add(a, b) =>
          do x <- ! eval a;
          do y <- ! eval b;
          ! add x y
        end
      in
      ! eval +Add(+Var(1), +Add(+Lit(2), +Var(2)))
    end
} in
let under_state : Thk (pi ((M, _) : WithMonad (IState Int)) . M Int) = {
  fn ((M, (/monad; /state)) : WithMonad (IState Int)) =>
    ! evaluate M monad {
      fn x =>
        ! monad .bind Int Int { ! state .get } {
          fn s =>
            do s <- ! numeric/int/mul s 10;
            do s <- ! numeric/int/add s x;
            do x <- ! numeric/int/mul x 10;
            ! monad .bind Unit Int { ! state .put s } { fn _ => ! monad .return Int x }
        }
    } {
      fn x y =>
        do z <- ! numeric/int/add x y;
        ! monad .return Int z
    }
} in
let under_exception : Thk (pi ((M, _) : WithMonad (IException Unit)) . M Int) = {
  fn ((M, (/monad; /exception)) : WithMonad (IException Unit)) =>
    ! evaluate M monad {
      fn x =>
        ! numeric/int/eq (M Int) x 1
          { ! monad .return Int 10 } { ! exception .throw Int () }
    } {
      fn x y =>
        do z <- ! numeric/int/add x y;
        ! monad .return Int z
    }
} in
let (S, s) = state_instance Int in
let (E, e) = exception_instance Unit in
do a <- ! under_state (S, s) 0;
do b <- ! under_exception (E, e);
-- State records lookup order 12; Exception rejects the second variable.
match (a, b)
| ((32, 12), +Left()) => ! process/exit 0
| _ => ! process/exit 1
end
