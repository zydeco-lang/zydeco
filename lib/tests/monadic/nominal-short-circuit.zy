-- Unlike std's StateExn, this packed instance keeps State when an exception is raised.
param (/VType; /Thk; /Ret; /Unit; /Int; /numeric; /process; builtin) : @(import(
  "../../std/builtin.zy"
)) in
let (/Monad; /Algebra) = builtin |> (@(import("../../std/effect/monad.zy"))) in
let (/MonadState) = builtin |> (@(import("../../std/effect/state.zy"))) in
let (/MonadThrow) = builtin |> (@(import("../../std/effect/exception.zy"))) in
let (/IStateExn) = builtin |> (@(import("../../std/effect/state-exn.zy"))) in
let E (A : VType) =
  data
  | +Ok : A
  | +Err : Unit
  end
in
let M (A : VType) = Int -> Ret (E A * Int) in
let monad : Thk (Monad M) = {
  comatch
  | .return A x => fn s => ret (+Ok(x), s)
  | .bind A B m k => fn s =>
    do (r, s) <- ! m s;
    match r
    | +Ok(x) => ! k x s
    | +Err() => ret (+Err(), s)
    end
  end
} in
let state : Thk (MonadState Int M) = {
  comatch
  | .get => fn s => ret (+Ok(s), s)
  | .put s => fn _ => ret (+Ok(), s)
  end
} in
let exception : Thk (MonadThrow Unit M) = {
  comatch
  | .throw A _ => fn s => ret (+Err(), s)
  end
} in
let catch : Thk (forall (A : VType) . Thk (M A) -> Thk (Unit -> M A) -> M A) = {
  fn A m h s =>
    do (r, s) <- ! m s;
    match r
    | +Ok(x) => ret (+Ok(x), s)
    | +Err() => ! h () s
    end
} in
let ops = (= monad, (= state, (= exception, = catch))) in
let p = {
  fn ((M, (/monad; /state; /exception)) : IStateExn Int Unit) =>
    let step : Thk (Int -> M Int) = {
      fn x =>
        ! monad .bind Int Int { ! state .get } {
          fn s =>
            do s <- ! numeric/int/add s 1;
            ! monad .bind Unit Int { ! state .put s } {
              fn _ =>
                ! numeric/int/eq (M Int) x 0
                  { ! exception .throw Int () } { ! monad .return Int x }
            }
        }
    } in
    (
      @[monadic] fn (step : Thk (Int -> Ret Int)) (a : Int) (b : Int) =>
        begin
          def T =
            data
            | +T : Int * Int
            end
          in
          do x <- ! step a;
          do y <- ! step b;
          ret (+T(x, y) : T)
        end
    ) M monad step
} in
do a <- ! p (M, ops) 1 2 0;
do b <- ! p (M, ops) 0 2 0;
do c <- ! p (M, ops) 1 0 0;
-- Catch resumes at the failure state, not the initial state.
do d <- ! catch Int {
  fn s =>
    do s <- ! numeric/int/add s 1;
    ret (+Err(), s)
} { fn _ => ! state .get } 3;
match (a, b, c, d)
| ((+Ok(+T(1, 2)), 2), (+Err(), 1), (+Err(), 2), (+Ok(4), 4)) => ! process/exit 0
| _ => ! process/exit 1
end
