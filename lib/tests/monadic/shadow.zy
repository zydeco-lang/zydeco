begin
  let outer_basis = @[import("../../std/monad.zy")] _ that
  param (
    (/Unit = _; builtin) :
    @[import("../../std/builtin.zy")] _
  ) that
  let (= Monad, = Algebra, ()) =
    outer_basis builtin in

  begin
    let inner_basis = @[import("../../std/monad.zy")] _ that
    let (= Monad, = Algebra, ()) =
      inner_basis builtin in

    begin
      @[monadic] begin
        ret ()
      end
    end
  end
end
