param (/OS = _; builtin) : @(import("../../std/builtin.zy")) in
begin
  let outer_basis = @(import("../../std/effect/monad.zy")) that

  let (/Monad; /Algebra) = outer_basis in

  begin
    let inner_basis = @(import("../../std/effect/monad.zy")) that
    let (/Monad; /Algebra) = inner_basis in

    begin
      @[monadic] begin
        ret ()
      end
    end
  end
end
