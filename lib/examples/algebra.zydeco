-- Algebras of relative monads
-- Implementations and examples
-- The interface for the algebra
-- codata Algebra (M: VType -> CType) (R: CType) where
--   | : forall (A: VType) .
--     Thunk (M A) -> Thunk (A -> R) -> R
-- end
begin
  let monadic_basis = @(import("../std/control/monad.zy")) that
  param (
    (/core; /representations; /numeric; /system; builtin) :
    @(import("../std/builtin.zy"))
  ) that
  let (/VType; /CType; /Thk; /Ret) = core that
  let (#Int64 = Int64, int64) = numeric/int64 that
  let (/String) = representations/string that
  let (/OS; /stdio; /process) = system that
  let (= Monad, = Algebra, ()) =
    monadic_basis builtin
  in
  begin

    def Either (E : VType) (A : VType) =
      data
      | +Left : E
      | +Right : A
      end
    that
    def IO (A : VType) =
      codata
      | .run : Thk (A -> OS) -> OS
      end
    that
    def With (L : CType) (R : CType) =
      codata
      | .l : L
      | .r : R
      end
    that
    def FnVar (A : VType) (B : CType) : CType =
      codata
      | .more : A -> FnVar A B
      | .done : B
      end
    that
    -- An example program of echo sum server which may error on add_of

    -- The defunctionalized exception type
    def ExnDe (E : VType) (A : VType) : CType =
      codata
      | .try :
        forall (E' : VType) .
          Thk (E -> ExnDe E' A) -> ExnDe E' A
      | .kont :
        forall (A' : VType) .
          Thk (A -> ExnDe E A') -> ExnDe E A'
      | .done : Ret (Either E A)
      end
    that
    -- codata Monad (M: VType -> CType) where
    --   | .return : forall (A: VType) .
    --     A -> M A
    --   | .bind : forall (A: VType) (A': VType) .
    --     Thunk (M A) -> Thunk (A -> M A') -> M A'
    -- end
    def MonadErr (E : VType) (M : VType -> CType) =
      codata
      | .fail :
        forall (A : VType) .
          E -> M A
      end
    that

    def ! panic (msg : String) : OS =
      ! (stdio/write_line) msg {
        ! (process/exit) 1
      }
    that

    -- Algebra IO OS exists
    def ! alg_io : Algebra IO OS =
      fn A m k =>
        ! m .run k
    that

    -- Algebra Ret R always exists
    def ! alg_ret (R : CType) : Algebra Ret R =
      fn A m k =>
        do a <- ! m;
        ! k a
    that

    -- Algebra M (M V) always exists for M: Monad
    def ! alg_mo
      (
        M :
           VType
        -> CType
      )
      (V : VType)
      (mo : Thk (Monad M))
    : Algebra M (M V) =
        fn A m k =>
          ! mo .bind A V m k
    that

    -- Algebras can be defined on the arrow type
    def ! alg_arrow
      (
        M :
           VType
        -> CType
      )
      (R : CType)
      (A : VType)
      (alg : Thk (Algebra M R))
    : Algebra M (A -> R) =
        fn A' m' f a =>
          ! alg A' m' {
            fn a' =>
              ! f a' a
          }
    that

    -- Algebras can be defined on the with type
    def ! alg_with
      (
        M :
           VType
        -> CType
      )
      (L : CType)
      (R : CType)
      (algl : Thk (Algebra M L))
      (algr : Thk (Algebra M R))
    : Algebra M (With L R) =
        fn A m f =>
          comatch
          | .l =>
            ! algl A m {
              fn a =>
                ! f a .l
            }
          | .r =>
            ! algr A m {
              fn a =>
                ! f a .r
            }
          end
    that

    -- Algebras can be defined on coinductive types like FnVar
    def fix alg_var
      (
        M :
           VType
        -> CType
      )
      (R : CType)
      (alg : Thk (Algebra M R))
      (V : VType)
    : Algebra M (FnVar V R) =
        fn A m ka =>
          let fix loop
            (
              ka :
              Thk (A -> FnVar V R)
            )
          : FnVar V R =
              comatch
              | .more v =>
                ! loop {
                  fn a =>
                    ! ka a .more v
                }
              | .done =>
                ! alg A m {
                  fn a =>
                    ! ka a .done
                }
              end
          in
          ! loop ka
    that
    def fix mexnde (E : VType) : Monad (ExnDe E) =
      comatch
      | .return =>
        fn A a =>
          comatch
          | .try =>
            fn E' k =>
              ! mexnde E' .return A a
          | .kont =>
            fn A' k =>
              ! k a
          | .done => ret +Right(a)
          end
      | .bind =>
        fn A A' m f =>
          ! m .kont A' f
      end
    that
    def fix mexnde_err (E : VType) : MonadErr E (ExnDe E) =
      comatch
      | .fail =>
        fn A e =>
          comatch
          | .try =>
            fn E' k =>
              ! k e
          | .kont =>
            fn A' k =>
              ! mexnde_err E .fail A' e
          | .done => ret +Left(e)
          end
      end
    that
    -- Algebra on the defunctionalized exception type
    def ! alg_exn : Algebra (ExnDe String) OS =
      fn A m k =>
        do a? <- ! m .done;
        match a?
        | +Left(s) => ! panic s
        | +Right(a) => ! k a
        end
    that
    -- add_of errors if the sum >= 256 (8-bit overflow)
    def ! add_of (i : Int64) (sum : Int64) : ExnDe String Int64 =
      do sum <- ! (int64/add) i sum;
      ! (int64/lt)
        (ExnDe String Int64)
        sum
        256
        { ! mexnde String .return Int64 sum }
        { ! mexnde_err String .fail Int64 "sum >= 256" }
    that

    (
      fix (loop : Thk (Int64 -> OS)) =>
        fn sum =>
          ! (stdio/read_int)
            { ! (process/exit) 0 }
            {
              fn i =>
                ! alg_exn Int64 { ! add_of i sum } {
                  fn sum =>
                    ! (stdio/write_int) sum {
                      ! (stdio/write_line) " = sum" {
                        ! loop sum
                      }
                    }
                }
            }
    )
      0
  end
end
