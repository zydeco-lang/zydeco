begin
  let monadic_basis = @[import("../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  let Either :
    (VType) ->
    (VType) ->
    (VType) =
    begin
      param (E : VType) that
      param (A : VType) that
      data
      | +Left : E
      | +Right : A
      end
    end
  that
  def IO :
    (VType) ->
    (CType) =
    begin
      param (A : VType) that
      codata
      | .run : Thk (A -> OS) -> OS
      end
    end
  that
  def With :
    (CType) ->
    (CType) ->
    (CType) =
    begin
      param (L : CType) that
      param (R : CType) that
      codata
      | .l : L
      | .r : R
      end
    end
  that
  def FnVar :
    (VType) ->
    (CType) ->
    (CType) =
    begin
      param (A : VType) that
      param (B : CType) that
      codata
      | .more : A -> FnVar A B
      | .done : B
      end
    end
  that
  def ExnDe :
    (VType) ->
    (VType) ->
    (CType) =
    begin
      param (E : VType) that
      param (A : VType) that
      codata
      | .try :
        forall (F : VType) .
          Thk (E -> ExnDe F A) -> ExnDe F A
      | .kont :
        forall (B : VType) .
          Thk (A -> ExnDe E B) -> ExnDe E B
      | .done : Ret (Either E A)
      end
    end
  that
  def MonadErr :
    (VType) ->
    (
      (
        (VType) ->
        (CType)
      ) ->
      (CType)
    ) =
    begin
      param (E : VType) that
      param (
        M :
        (VType) ->
        (CType)
      ) that
      codata
      | .fail :
        forall (A : VType) .
          E -> M A
      end
    end
  that

  def panic : Thk (String -> OS) = {
    fn message ->
      ! (api/write_line) message {
        ! (api/exit) 1
      }
  } that
  def alg_io : Thk (Algebra IO OS) = {
    fn A computation continuation ->
      ! computation .run continuation
  } that
  def alg_ret : Thk (
    forall (R : CType) .
      Algebra Ret R
  ) = {
    fn R A computation continuation ->
      do value <- ! computation;
      ! continuation value
  } that
  def alg_mo : Thk (
    forall (
      M :
      (VType) ->
      (CType)
    ) .
    forall (V : VType) .
      Thk (Monad M) ->
      Algebra M (M V)
  ) = {
    fn M V monad A computation continuation ->
      ! monad .bind A V computation continuation
  } that
  def alg_arrow : Thk (
    forall (
      M :
      (VType) ->
      (CType)
    ) .
    forall (R : CType) .
    forall (V : VType) .
      Thk (Algebra M R) ->
      Algebra M (V -> R)
  ) = {
    fn M R V algebra A computation continuation value ->
      ! algebra A computation {
        fn result ->
          ! continuation result value
      }
  } that
  def alg_with : Thk (
    forall (
      M :
      (VType) ->
      (CType)
    ) .
    forall (L : CType) .
    forall (R : CType) .
      Thk (Algebra M L) ->
      Thk (Algebra M R) ->
      Algebra M (With L R)
  ) = {
    fn M L R left right A computation continuation ->
      comatch
      | .l ->
        ! left A computation {
          fn result ->
            ! continuation result .l
        }
      | .r ->
        ! right A computation {
          fn result ->
            ! continuation result .r
        }
      end
  } that
  def alg_var : Thk (
    forall (
      M :
      (VType) ->
      (CType)
    ) .
    forall (R : CType) .
      Thk (Algebra M R) ->
      (
        forall (V : VType) .
          Algebra M (FnVar V R)
      )
  ) = {
    fix (alg_var : Thk (
      forall (
        M :
        (VType) ->
        (CType)
      ) .
      forall (R : CType) .
        Thk (Algebra M R) ->
        (
          forall (V : VType) .
            Algebra M (FnVar V R)
        )
    )) ->
      fn M R algebra V A computation continuation ->
        let fix loop (
          continuation :
          Thk (A -> FnVar V R)
        ) : FnVar V R =
          comatch
          | .more value ->
            ! loop {
              fn result ->
                ! continuation result .more value
            }
          | .done ->
            ! algebra A computation {
              fn result ->
                ! continuation result .done
            }
          end
        in
        ! loop continuation
  } that
  def mo_exnde : Thk (
    forall (E : VType) .
      Monad (ExnDe E)
  ) = {
    fix (mo_exnde : Thk (
      forall (E : VType) .
        Monad (ExnDe E)
    )) ->
      fn E ->
        comatch
        | .return ->
          fn A value ->
            comatch
            | .try ->
              fn F continuation ->
                ! mo_exnde F .return A value
            | .kont ->
              fn B continuation ->
                ! continuation value
            | .done -> ret +Right(value)
            end
        | .bind ->
          fn A B computation function ->
            ! computation .kont B function
        end
  } that
  def err_exnde : Thk (
    forall (E : VType) .
      MonadErr E (ExnDe E)
  ) = {
    fix (err_exnde : Thk (
      forall (E : VType) .
        MonadErr E (ExnDe E)
    )) ->
      fn E ->
        comatch
        | .fail ->
          fn A error ->
            comatch
            | .try ->
              fn F continuation ->
                ! continuation error
            | .kont ->
              fn B continuation ->
                ! err_exnde E .fail B error
            | .done -> ret +Left(error)
            end
        end
  } that
  def alg_exn : Thk (Algebra (ExnDe String) OS) = {
    fn A computation continuation ->
      do outcome <- ! computation .done;
      match outcome
      | +Left(message) -> ! panic message
      | +Right(value) -> ! continuation value
      end
  } that
  def add_of : Thk (Int -> Int -> ExnDe String Int) = {
    fn integer sum ->
      do sum <- ! (api/add) integer sum;
      ! (api/int_lt_branch)
        (ExnDe String Int)
        sum
        256
        { ! mo_exnde String .return Int sum }
        { ! err_exnde String .fail Int "sum >= 256" }
  } that

  (fix (loop : Thk (Int -> OS)) ->
    fn sum ->
      ! (api/read_line_as_int_branch)
        { ! (api/exit) 0 }
        {
          fn integer ->
            ! alg_exn Int { ! add_of integer sum } {
              fn sum ->
                ! (api/write_int) sum {
                  ! (api/write_line) " = sum" {
                    ! loop sum
                  }
                }
            }
        })
    0
end
end
