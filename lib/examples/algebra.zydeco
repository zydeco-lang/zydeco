-- Algebras of relative monads
-- Implementations and examples
-- The interface for the algebra
-- codata Algebra (M: VType -> CType) (R: CType) where
--   | : forall (A: VType) .
--     Thunk (M A) -> Thunk (A -> R) -> R
-- end
begin
  let monadic_basis = @[import("../std/monad.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../std/builtin.zy")] _
  ) that
  do (= Monad, = Algebra, ()) <-
    ! monadic_basis (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin

  def Either (E : VType) (A : VType) =
    data
    | +Left : E
    | +Right : A
    end
  that
  def IO (A : VType) =
    codata
    | .run : Thk (A -> OS) -> OS
    end
  that
  def With (L : CType) (R : CType) =
    codata
    | .l : L
    | .r : R
    end
  that
  def FnVar (A : VType) (B : CType) : CType =
    codata
    | .more : A -> FnVar A B
    | .done : B
    end
  that
  -- An example program of echo sum server which may error on add_of

  -- The defunctionalized exception type
  def ExnDe (E : VType) (A : VType) : CType =
    codata
    | .try :
      forall (E' : VType) .
        Thk (E -> ExnDe E' A) -> ExnDe E' A
    | .kont :
      forall (A' : VType) .
        Thk (A -> ExnDe E A') -> ExnDe E A'
    | .done : Ret (Either E A)
    end
  that
  -- codata Monad (M: VType -> CType) where
  --   | .return : forall (A: VType) .
  --     A -> M A
  --   | .bind : forall (A: VType) (A': VType) .
  --     Thunk (M A) -> Thunk (A -> M A') -> M A'
  -- end
  def MonadErr (E : VType) (M : (VType) -> (CType)) =
    codata
    | .fail :
      forall (A : VType) .
        E -> M A
    end
  that

  def panic : Thk (String -> OS) = {
    fn msg ->
      ! (api/write_line) msg {
        ! (api/exit) 1
      }
  } that

  -- Algebra IO OS exists
  def alg_io : Thk (Algebra IO OS) = {
    fn A m k ->
      ! m .run k
  } that

  -- Algebra Ret R always exists
  def alg_ret : Thk (
    forall (R : CType) .
      Algebra Ret R
  ) = {
    fn R A m k ->
      do a <- ! m;
      ! k a
  } that

  -- Algebra M (M V) always exists for M: Monad
  def alg_mo : Thk (
    forall (
      M :
      (VType) ->
      (CType)
    ) .
    forall (V : VType) .
      Thk (Monad M) ->
      Algebra M (M V)
  ) = {
    fn M V mo A m k ->
      ! mo .bind A V m k
  } that

  -- Algebras can be defined on the arrow type
  def alg_arrow : Thk (
    forall (
      M :
      (VType) ->
      (CType)
    ) .
    forall (R : CType) .
    forall (A : VType) .
      Thk (Algebra M R) ->
      Algebra M (A -> R)
  ) = {
    fn M R A alg A' m' f a ->
      ! alg A' m' {
        fn a' ->
          ! f a' a
      }
  } that

  -- Algebras can be defined on the with type
  def alg_with : Thk (
    forall (
      M :
      (VType) ->
      (CType)
    ) .
    forall (L : CType) .
    forall (R : CType) .
      Thk (Algebra M L) ->
      Thk (Algebra M R) ->
      Algebra M (With L R)
  ) = {
    fn M L R algl algr A m f ->
      comatch
      | .l ->
        ! algl A m {
          fn a ->
            ! f a .l
        }
      | .r ->
        ! algr A m {
          fn a ->
            ! f a .r
        }
      end
  } that

  -- Algebras can be defined on coinductive types like FnVar
  def alg_var : Thk (
    forall (
      M :
      (VType) ->
      (CType)
    ) .
    forall (R : CType) .
      Thk (Algebra M R) ->
      (
        forall (V : VType) .
          Algebra M (FnVar V R)
      )
  ) = {
    fix (alg_var : Thk (
      forall (
        M :
        (VType) ->
        (CType)
      ) .
      forall (R : CType) .
        Thk (Algebra M R) ->
        (
          forall (V : VType) .
            Algebra M (FnVar V R)
        )
    )) ->
      fn M R alg V A m ka ->
        let fix loop (
          ka :
          Thk (A -> FnVar V R)
        ) : FnVar V R =
          comatch
          | .more v ->
            ! loop {
              fn a ->
                ! ka a .more v
            }
          | .done ->
            ! alg A m {
              fn a ->
                ! ka a .done
            }
          end
        in
        ! loop ka
  } that
  def mexnde : Thk (
    forall (E : VType) .
      Monad (ExnDe E)
  ) = {
    fix (mexnde : Thk (
      forall (E : VType) .
        Monad (ExnDe E)
    )) ->
      fn E ->
        comatch
        | .return ->
          fn A a ->
            comatch
            | .try ->
              fn E' k ->
                ! mexnde E' .return A a
            | .kont ->
              fn A' k ->
                ! k a
            | .done -> ret +Right(a)
            end
        | .bind ->
          fn A A' m f ->
            ! m .kont A' f
        end
  } that
  def mexnde_err : Thk (
    forall (E : VType) .
      MonadErr E (ExnDe E)
  ) = {
    fix (mexnde_err : Thk (
      forall (E : VType) .
        MonadErr E (ExnDe E)
    )) ->
      fn E ->
        comatch
        | .fail ->
          fn A e ->
            comatch
            | .try ->
              fn E' k ->
                ! k e
            | .kont ->
              fn A' k ->
                ! mexnde_err E .fail A' e
            | .done -> ret +Left(e)
            end
        end
  } that
  -- Algebra on the defunctionalized exception type
  def alg_exn : Thk (Algebra (ExnDe String) OS) = {
    fn A m k ->
      do a? <- ! m .done;
      match a?
      | +Left(s) -> ! panic s
      | +Right(a) -> ! k a
      end
  } that
  -- add_of errors if the sum >= 256 (8-bit overflow)
  def add_of : Thk (Int -> Int -> ExnDe String Int) = {
    fn i sum ->
      do sum <- ! (api/add) i sum;
      ! (api/int_lt_branch)
        (ExnDe String Int)
        sum
        256
        { ! mexnde String .return Int sum }
        { ! mexnde_err String .fail Int "sum >= 256" }
  } that

  (fix (loop : Thk (Int -> OS)) ->
    fn sum ->
      ! (api/read_line_as_int_branch)
        { ! (api/exit) 0 }
        {
          fn i ->
            ! alg_exn Int { ! add_of i sum } {
              fn sum ->
                ! (api/write_int) sum {
                  ! (api/write_line) " = sum" {
                    ! loop sum
                  }
                }
            }
        })
    0
end
end
