-- The Echo Sum Server
-- When the program starts, it waits for a number followed by a newline.
-- It then prints the sum of all numbers received so far, followed by a newline.
-- Then it loops.
-- If the input is not a number, the program exits.
begin
  param (
    (/core; /numeric; /system) :
    @(import("../std/builtin.zy"))
  ) that
  let (/Thk) = core that
  let (= Int64, int64) = numeric/int64 that
  let (/OS; /stdio; /process) = system that

  (
    fix (loop : Thk (Int64 -> OS)) =>
      fn sum =>
        ! (stdio/read_int)
          { ! (process/exit) 0 }
          {
            fn i =>
              do sum <- ! (int64/add) i sum;
              ! (stdio/write_int) sum {
                ! (stdio/write_line) " = sum" {
                  ! loop sum
                }
              }
          }
  )
    0
end
