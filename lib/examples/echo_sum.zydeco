begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../std/builtin.zy")] _
  ) that

  (fix (loop : Thk (Int -> OS)) ->
    fn sum ->
      ! (api/read_line_as_int_branch)
        { ! (api/exit) 0 }
        {
          fn integer ->
            do sum <- ! (api/add) integer sum;
            ! (api/write_int) sum {
              ! (api/write_line) " = sum" {
                ! loop sum
              }
            }
        })
    0
end
