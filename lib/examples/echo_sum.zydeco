-- The Echo Sum Server
-- When the program starts, it waits for a number followed by a newline.
-- It then prints the sum of all numbers received so far, followed by a newline.
-- Then it loops.
-- If the input is not a number, the program exits.
begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../std/builtin.zy")] _
  ) that

  (fix (loop : Thk (Int -> OS)) =>
    fn sum =>
      ! (api/read_line_as_int_branch)
        { ! (api/exit) 0 }
        {
          fn i =>
            do sum <- ! (api/add) i sum;
            ! (api/write_int) sum {
              ! (api/write_line) " = sum" {
                ! loop sum
              }
            }
        })
    0
end
