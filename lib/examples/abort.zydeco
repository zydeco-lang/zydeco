begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../std/builtin.zy")] _
  ) that

  def Fn :
    (VType) ->
    (CType) ->
    (CType) =
    begin
      param (A : VType) that
      param (B : CType) that
      codata
      | .push : A -> B
      end
    end
  that
  def FnOpt :
    (VType) ->
    (CType) ->
    (CType) =
    begin
      param (A : VType) that
      param (B : CType) that
      codata
      | .some : A -> B
      | .none : B
      end
    end
  that
  def FnVar :
    (VType) ->
    (CType) ->
    (CType) =
    begin
      param (A : VType) that
      param (B : CType) that
      codata
      | .more : A -> FnVar A B
      | .done : B
      end
    end
  that
  def abort : Thk (
    forall (A : VType) .
      A -> FnVar A (Ret A)
  ) = {
    fn A first ->
      fix (unwind : Thk (FnVar A (Ret A))) ->
        comatch
        | .more _ -> ! unwind
        | .done -> ret first
        end
  } that

  do status <- ! abort Int 0 .more 1 .more 2 .done;
  ! (api/exit) status
end
