-- Function Types and the abort example
-- Funciton Type
begin
  param (/core; /representations; /system) : @(import("../std/builtin.zy")) that
  let (/VType; /CType; /Thk; /Ret) = core that
  let (/Int64) = representations/i64 that
  let (/process) = system that

  def Fn (A : VType) (B : CType) =
    codata
    | .push : A -> B
    end
  that

  -- Function Type with Optional Argument
  def FnOpt (A : VType) (B : CType) =
    codata
    | .some : A -> B
    | .none : B
    end
  that

  -- Variadic Function Type
  def FnVar (A : VType) (B : CType) : CType =
    codata
    | .more : A -> FnVar A B
    | .done : B
    end
  that

  -- Abort that takes the first argument and removes the rest
  def ! abort (A : VType) (x : A) : FnVar A (Ret A) =
    fix (unwind : Thk (FnVar A (Ret A))) =>
      comatch
      | .more _ => ! unwind
      | .done => ret x
      end
  that

  do i <- ! abort Int64 0 .more 1 .more 2 .done;
  ! (process/exit) i
end
