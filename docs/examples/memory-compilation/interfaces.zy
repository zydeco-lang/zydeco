-- The implemented interfaces, imported with their sealed storage constructors.
begin
  param val (/VType; /CType; /Thk; /Unit; /Addr; /Int; builtin) : @(import(
    "../../../lib/std/builtin.zy"
  )) in
  let (
    /Ptr;
    /Uninit;
    /Init;
    /Storage;
    /DynamicStorage;
    /Codec;
    /DynamicCodec;
    /SizeAlign;
    /allocation;
    /storage = geometry;
    /codecs
  )
  =
    builtin |> (@(import("../../../lib/std/memory/package.zy")))
  in
  let (/StaticAlloc) = allocation in
  let val fixed_geometry (L : VType) (storage : Storage L) : SizeAlign =
    geometry/constant/query L storage
  in
  let val dynamic_geometry (L : VType) (storage : DynamicStorage L) : SizeAlign =
    geometry/runtime/query L storage
  in
  let val select_runtime_codec (L : VType) (A : VType) (codec : Codec L A) : DynamicCodec L A =
    codecs/materialize L A codec
  in
  pack
      (= Ptr : VType -> VType -> VType) is Ptr
      (= Uninit : VType) is Uninit
      (= Init : VType) is Init
      (= Storage : VType -> VType) is Storage
      (= DynamicStorage : VType -> VType) is DynamicStorage
  where
    (= fixed_geometry, = dynamic_geometry, = select_runtime_codec,
      #heap = allocation/static_heap : StaticAlloc Unit)
  end
end
