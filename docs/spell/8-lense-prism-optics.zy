-- # Chapter 8: Lenses from Higher-Kinded Functions

-- This final sketch encodes a lens by quantifying over a value-to-computation
-- type constructor. `Identity` interprets a lens as an update; `Const`
-- interprets the same lens as an observation.

begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../lib/std/builtin.zy")] _
  ) that

  let Lens (S : VType) (A : VType) =
    forall (
      Fun :
      (VType) ->
      (CType)
    ) .
      Thk (A -> Fun A) ->
      S ->
      Fun S
  that
  def Identity (A : VType) =
    codata
    | .identity : Ret A
    end
  that
  def Const (A : VType) (B : VType) =
    codata
    | .constant : Ret A
    end
  that

  def over : Thk (
    forall (S : VType) .
    forall (A : VType) .
      Thk (Lens S A) ->
      Thk (A -> Ret A) ->
      S ->
      Ret S
  ) = {
    fn (S : VType)
       (A : VType)
       lens
       function
       source ->
      (! lens
        Identity
        {
          fn focused ->
            comatch
            | .identity -> ! function focused
            end
        }
        source)
      .identity
  } that
  def view : Thk (
    forall (S : VType) .
    forall (A : VType) .
      Thk (Lens S A) ->
      S ->
      Ret A
  ) = {
    fn (S : VType)
       (A : VType)
       lens
       source ->
      (! lens
        (Const A)
        {
          fn focused ->
            comatch
            | .constant -> ret focused
            end
        }
        source)
      .constant
  } that

  ! (api/exit) 0
end

-- A complete optics library would package these representations and their
-- laws behind an interface. The important point here is that the encoding is
-- composed entirely from ordinary type and term functions.
