begin
  param (
    (
      /VType;
      /CType;
      /Thk;
      /Ret;
      /Unit;
      /Int;
      /String;
      /OS;
      /int_eq_branch;
      /int_lt_branch;
      /str_scalar_length;
      /str_split_once_branch;
      /str_split_at_branch;
      /str_eq_branch;
      /write_str;
      /read_till_eof;
      /exit
    ) :
    @[import("../../lib/std/builtin.zy")] _
  ) that

  def Bool : VType =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def branch : Thk (
    forall (B : CType) .
      Bool -> Thk B -> Thk B -> B
  ) = {
    fn (B : CType)
       condition
       when_true
       when_false =>
      match condition
      | +True() => ! when_true
      | +False() => ! when_false
      end
  } that
  def int_equal : Thk (
    Int -> Int -> Ret Bool
  ) = {
    fn left right =>
      ! (int_eq_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def int_less : Thk (
    Int -> Int -> Ret Bool
  ) = {
    fn left right =>
      ! (int_lt_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def string_equal : Thk (
    String -> String -> Ret Bool
  ) = {
    fn left right =>
      ! (str_eq_branch)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that

  -- Return the line without a leading comment marker and whether one existed.
  def classify_line : Thk (
    String ->
    Ret (String * Bool)
  ) = {
    fn line =>
      do length <- ! (str_scalar_length) line;
      do too_short <- ! int_less length 3;
      ! branch
        (Ret (String * Bool))
        too_short
        {
          do bare_comment <- ! string_equal line "--";
          ! branch
            (Ret (String * Bool))
            bare_comment
            { ret ("", +True()) }
            { ret (line, +False()) }
        }
        {
          ! (str_split_at_branch)
            (Ret (String * Bool))
            line
            3
            { ret (line, +False()) }
            {
              fn prefix remainder =>
                do is_comment <- ! string_equal prefix "-- ";
                ! branch
                  (Ret (String * Bool))
                  is_comment
                  { ret (remainder, +True()) }
                  { ret (line, +False()) }
            }
        }
  } that
  def string_empty : Thk (
    String -> Ret Bool
  ) = {
    fn string =>
      do length <- ! (str_scalar_length) string;
      ! int_equal length 0
  } that

  def loop : Thk (
    String ->
    Bool ->
    OS
  ) = {
    fix (
      loop :
      Thk (
        String ->
        Bool ->
        OS
      )
    ) =>
      fn remaining in_code =>
        ! (str_split_once_branch)
          OS
          remaining
          '\n'
          {
            match in_code
            | +True() =>
              ! (write_str) "\n```\n" {
                ! (exit) 0
              }
            | +False() => ! (exit) 0
            end
          }
          {
            fn line rest =>
              do classified <- ! classify_line line;
              match classified
              | (content, comment) =>
                do empty <- ! string_empty content;
                match in_code
                | +False() =>
                  ! branch
                    OS
                    empty
                    {
                      ! (write_str) "\n\n" {
                        ! loop rest in_code
                      }
                    }
                    {
                      ! branch
                        OS
                        comment
                        {
                          ! (write_str) content {
                            ! (write_str) " " {
                              ! loop rest in_code
                            }
                          }
                        }
                        {
                          ! (write_str) "\n```zydeco\n" {
                            ! (write_str) content {
                              ! loop rest +True()
                            }
                          }
                        }
                    }
                | +True() =>
                  ! branch
                    OS
                    empty
                    {
                      ! (write_str) "\n" {
                        ! loop rest in_code
                      }
                    }
                    {
                      ! branch
                        OS
                        comment
                        {
                          ! (write_str) "\n```\n\n" {
                            ! (write_str) content {
                              ! (write_str) " " {
                                ! loop rest +False()
                              }
                            }
                          }
                        }
                        {
                          ! (write_str) "\n" {
                            ! (write_str) content {
                              ! loop rest in_code
                            }
                          }
                        }
                    }
                end
              end
          }
  } that

  ! (read_till_eof) {
    fn file =>
      ! loop file +False()
  }
end
