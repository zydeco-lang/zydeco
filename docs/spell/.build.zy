begin
  param (
    (/core; /representations; /numeric; /text; /system) :
    @(import("../../lib/std/builtin.zy"))
  ) that
  let (/VType; /CType; /Thk; /Ret; /Unit) = core that
  let (Scalar = Int64, int64) = numeric/int64 that
  let (/Scalar = String) = representations/string that
  let (/string) = text that
  let (/OS; /stdio; /process) = system that

  def Bool : VType = data
  | +True : Unit
  | +False : Unit
  end that
  def branch : Thk (
    forall (B : CType) . Bool -> Thk B -> Thk B -> B
  ) = {
    fn (B : CType)
      condition
      when_true
      when_false
    =>
      match condition
      | +True() => ! when_true
      | +False() => ! when_false
      end
  } that
  def int_equal : Thk (
    Int64 -> Int64 -> Ret Bool
  ) = {
    fn left right =>
      ! (int64/eq)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def int_less : Thk (
    Int64 -> Int64 -> Ret Bool
  ) = {
    fn left right =>
      ! (int64/lt)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that
  def string_equal : Thk (
    String -> String -> Ret Bool
  ) = {
    fn left right =>
      ! (string/eq)
        (Ret Bool)
        left
        right
        { ret +True() }
        { ret +False() }
  } that

  -- Return the line without a leading comment marker and whether one existed.
  def classify_line : Thk (
       String
    -> Ret (String * Bool)
  ) = {
    fn line =>
      do length <- ! (string/length) line;
      do too_short <- ! int_less length 3;
      ! branch
        (Ret (String * Bool))
        too_short
        {
          do bare_comment <- ! string_equal line "--";
          ! branch
            (Ret (String * Bool))
            bare_comment
            { ret ("", +True()) }
            { ret (line, +False()) }
        }
        {
          ! (string/split_at)
            (Ret (String * Bool))
            line
            3
            { ret (line, +False()) }
            {
              fn prefix remainder =>
                do is_comment <- ! string_equal prefix "-- ";
                ! branch
                  (Ret (String * Bool))
                  is_comment
                  { ret (remainder, +True()) }
                  { ret (line, +False()) }
            }
        }
  } that
  def string_empty : Thk (
    String -> Ret Bool
  ) = {
    fn text =>
      do length <- ! (string/length) text;
      ! int_equal length 0
  } that

  def loop : Thk (
       String
    -> Bool
    -> OS
  ) = {
    fix (
      loop :
      Thk (
           String
        -> Bool
        -> OS
      )
    )
    =>
      fn remaining in_code =>
        ! (string/split_once)
          OS
          remaining
          '\n'
          {
            match in_code
            | +True() => ! (stdio/write) "\n```\n" {
              ! (process/exit) 0
            }
            | +False() => ! (process/exit) 0
            end
          }
          {
            fn line rest =>
              do classified <- ! classify_line line;
              match classified
              | (content, comment) =>
                do empty <- ! string_empty content;
                match in_code
                | +False() => ! branch
                  OS
                  empty
                  {
                    ! (stdio/write) "\n\n" {
                      ! loop rest in_code
                    }
                  }
                  {
                    ! branch
                      OS
                      comment
                      {
                        ! (stdio/write) content {
                          ! (stdio/write) " " {
                            ! loop rest in_code
                          }
                        }
                      }
                      {
                        ! (stdio/write) "\n```zydeco\n" {
                          ! (stdio/write) content {
                            ! loop rest +True()
                          }
                        }
                      }
                  }
                | +True() => ! branch
                  OS
                  empty
                  {
                    ! (stdio/write) "\n" {
                      ! loop rest in_code
                    }
                  }
                  {
                    ! branch
                      OS
                      comment
                      {
                        ! (stdio/write) "\n```\n\n" {
                          ! (stdio/write) content {
                            ! (stdio/write) " " {
                              ! loop rest +False()
                            }
                          }
                        }
                      }
                      {
                        ! (stdio/write) "\n" {
                          ! (stdio/write) content {
                            ! loop rest in_code
                          }
                        }
                      }
                  }
                end
              end
          }
  } that

  ! (stdio/read_all) {
    fn file => ! loop file +False()
  }
end
