-- # Chapter 7: Call-by-Need as a Library Boundary

-- Call-by-need shares the result of a suspended computation. A cache requires
-- reference operations, but those operations are not core language
-- declarations. We describe the missing capability as an existential package
-- and make it an explicit parameter of this term.

begin
  param (
    (/core) :
    @(import("../../lib/std/builtin.zy"))
  ) that
  let (/VType; /Thk; /Ret; /Unit) = core that
  def Option (A : VType) =
    data
    | +None : Unit
    | +Some : A
    end
  that

  let ReferenceLibrary = exists
    (
      Ref :
         VType
      -> VType
    )
  .
      (
        allocate :: Thk (
          forall (A : VType) . A -> Ret (Ref A)
        )
      )
    * (
        read :: Thk (
          forall (A : VType) . Ref A -> Ret A
        )
      )
    * (
        write :: Thk (
          forall (A : VType) . Ref A -> A -> Ret Unit
        )
      ) that
  param (
    (Ref, references) :
    ReferenceLibrary
  ) that

  def call_by_need : Thk (
    forall (A : VType) .
         Thk (Ret A)
      -> Ret (Thk (Ret A))
  ) = {
    fn (A : VType)
      (suspended : Thk (Ret A))
    =>
      do cache <- ! (references/allocate) (Option A) +None();
      ret {
        do cached <- ! (references/read) (Option A) cache;
        match cached
        | +Some(value) => ret value
        | +None() =>
          do value <- ! suspended;
          do _ <- ! (references/write) (Option A) cache +Some(value);
          ret value
        end
      }
  } that

  ret call_by_need
end

-- Check this file with:
--
--     cargo run --bin zydeco -- check docs/spell/7-call-by-need.zy
--
-- It is intentionally not executable because no reference package has been
-- supplied. More importantly, assigning these operations the plain `Ret` type
-- conceals their effects. A type-sensible implementation should expose state
-- through an appropriate relative monad and instantiate this pattern with that
-- effectful interface.
