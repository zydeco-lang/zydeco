-- # Chapter 4: A Fixed Point from Codata

-- Zydeco has a primitive computation-level `fix`, but recursion can also be
-- encoded. In a call-by-name reading, a fixed point satisfies `Y f = f (Y f)`.
-- Codata gives the delayed self-application needed to state this safely in
-- call-by-push-value.

begin
  let std = @[import("../../lib/std/std.zy")] _ that
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../lib/std/builtin.zy")] _
  ) that

  def Y :
    (CType) ->
    (CType) =
    begin
      param (B : CType) that
      codata
      | .apply : Thk (Y B) -> B
      end
    end
  that

  def fixed_point : Thk (
    forall (B : CType) .
      Thk (Thk B -> B) ->
      Ret (Thk B)
  ) = {
    fn (B : CType)
       (function : Thk (Thk B -> B)) ->
      let self_application : Thk (Y B) = {
        comatch
        | .apply recursive ->
          ! function { ! recursive .apply recursive }
        end
      } in
      ret { ! self_application .apply self_application }
  } that

  -- The standard-library term is an ordinary dependency. Opening its result
  -- establishes abstract Boolean, option, and list types in the lexical tail.
  do (
    Bool = StdBool,
    Option = StdOption,
    List = StdList,
    Int = StdInt,
    Char = StdChar,
    String = StdString,
    OS = StdOS,
    public
  ) <- ! std (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api);
  begin
    def factorial_step : Thk (
      Thk (StdInt -> Ret StdInt) ->
      StdInt ->
      Ret StdInt
    ) = {
      fn recursive number ->
        do is_zero <- ! (public/int_eq) number 0;
        ! (public/branch)
          (Ret StdInt)
          is_zero
          { ret 1 }
          {
            do predecessor <- ! (public/sub) number 1;
            do rest <- ! recursive predecessor;
            ! (public/mul) number rest
          }
    } that
    def check : Thk (
      Thk (StdInt -> Ret StdInt) ->
      StdInt ->
      StdInt ->
      Thk StdOS ->
      StdOS
    ) = {
      fn factorial input expected continuation ->
        do actual <- ! factorial input;
        do correct <- ! (public/int_eq) actual expected;
        ! (public/branch)
          StdOS
          correct
          { ! continuation }
          { ! (public/exit) 1 }
    } that

    do factorial <-
      ! fixed_point (StdInt -> Ret StdInt) factorial_step;
    ! check factorial 5 120 {
      ! check factorial 10 3628800 {
        ! (public/write_line) "factorial results are correct" {
          ! (public/exit) 0
        }
      }
    }
  end
end

-- This construction also demonstrates why unrestricted recursion makes
-- Zydeco a partial language: a fixed point need not terminate.
