-- # Chapter 4: A Fixed Point from Codata

-- Zydeco has a primitive computation-level `fix`, but recursion can also be
-- encoded. In a call-by-name reading, a fixed point satisfies `Y f = f (Y f)`.
-- Codata gives the delayed self-application needed to state this safely in
-- call-by-push-value.

begin
  let make_std = @(import("../../lib/std/std.zy")) that
  param (
    (/core; /representations; /system; builtin) :
    @(import("../../lib/std/builtin.zy"))
  ) that
  let (/CType; /Thk; /Ret) = core that
  let (/Scalar = Int64) = representations/i64 that
  let (/OS) = system that

  def Y (B : CType) : CType =
    codata
    | .apply : Thk (Y B) -> B
    end
  that

  def fixed_point : Thk (
    forall (B : CType) .
         Thk (Thk B -> B)
      -> Ret (Thk B)
  ) = {
    fn
      (B : CType)
      (function : Thk (Thk B -> B))
    =>
      let self_application : Thk (Y B) = {
        comatch
        | .apply recursive =>
          ! function { ! recursive .apply recursive }
        end
      } in
      ret { ! self_application .apply self_application }
  } that

  -- The standard-library term is an ordinary dependency. Opening its result
  -- establishes abstract Boolean, option, and list types in the lexical tail.
  let (/bool; /int64; /string; /stdio; /process) = make_std builtin in
  begin
    def factorial_step : Thk (
         Thk (Int64 -> Ret Int64)
      -> Int64
      -> Ret Int64
    ) = {
      fn recursive number =>
        do is_zero <- ! (int64/eq) number 0;
        ! (bool/if)
          (Ret Int64)
          is_zero
          { ret 1 }
          {
            do predecessor <- ! (int64/sub) number 1;
            do rest <- ! recursive predecessor;
            ! (int64/mul) number rest
          }
    } that
    def check : Thk (
         Thk (Int64 -> Ret Int64)
      -> Int64
      -> Int64
      -> Thk OS
      -> OS
    ) = {
      fn factorial input expected continuation =>
        do actual <- ! factorial input;
        do correct <- ! (int64/eq) actual expected;
        ! (bool/if)
          OS
          correct
          { ! continuation }
          { ! (process/exit) 1 }
    } that

    do factorial <-
      ! fixed_point (Int64 -> Ret Int64) factorial_step;
    ! check factorial 5 120 {
      ! check factorial 10 3628800 {
        ! (stdio/write_line) "factorial results are correct" {
          fn _ => ! (process/exit) 0
        }
      }
    }
  end
end

-- This construction also demonstrates why unrestricted recursion makes
-- Zydeco a partial language: a fixed point need not terminate.
