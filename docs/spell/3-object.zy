-- # Chapter 3: Objects as Codata

-- Codata describes a computation by the observations a consumer may perform.
-- This gives a compact encoding of an object: its destructors play the role of
-- methods, while a comatch supplies their implementations.

begin
  param (
    (/core; /representations; /numeric; /system) :
    @(import("../../lib/std/builtin.zy"))
  ) that
  let (/CType; /Thk; /Ret) = core that
  let (/Scalar = String) = representations/string that
  let (Scalar = Int64, int64) = numeric/int64 that
  let (/stdio; /process) = system that

  def Counter : CType = codata
  | .number : Ret Int64
  | .increment : Int64 -> Counter
  | .format : Ret String
  end that

  -- `make_counter` closes over `current`. The local fixed point named `this`
  -- permits one method to invoke another method on the same object.
  def make_counter : Thk (Int64 -> Counter) = {
    fix (make_counter : Thk (Int64 -> Counter)) =>
      fn current =>
        fix (this : Thk Counter) =>
          comatch
          | .number => ret current
          | .increment amount =>
            do previous <- ! this .number;
            do next <- ! (int64/add) previous amount;
            ! make_counter next
          | .format =>
            do value <- ! this .number;
            ! (int64/to_string) value
          end
  } that

  let counter_42 : Thk Counter = {
    ! make_counter 42
  } in
  do rendered <- ! counter_42 .format;
  ! (stdio/write_line) rendered {
    do zero <- ! counter_42 .increment -42 .number;
    ! (process/exit) zero
  }
end

-- Method-call-like punctuation is therefore ordinary force and codata
-- elimination. No separate object or module layer is required for this
-- example.
