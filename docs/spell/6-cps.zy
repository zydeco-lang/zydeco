-- # Chapter 6: Continuation-Passing Style

-- The Builtin `OS` operations expose sequencing explicitly. An output
-- operation receives the thunked computation that should run after the host
-- action completes. This is continuation-passing style at the source level.

begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../lib/std/builtin.zy")] _
  ) that

  def List (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * List A
    end
  that
  def values : List String =
    +Cons(
      "1",
      +Cons(
        "2",
        +Cons(
          "3",
          +Cons("not only you and me", +Nil())
        )
      )
    )
  that

  def print_list : Thk (
    List String ->
    Thk OS ->
    OS
  ) = {
    fix (
      print_list :
      Thk (
        List String ->
        Thk OS ->
        OS
      )
    ) ->
      fn remaining continuation ->
        match remaining
        | +Nil() -> ! continuation
        | +Cons(head, tail) ->
          ! (api/write_line) head {
            ! print_list tail continuation
          }
        end
  } that

  ! print_list values {
    ! (api/exit) 0
  }
end

-- The continuation is a value and can therefore be stored, selected, wrapped,
-- or invoked more than once when its type permits. Later effect abstractions
-- can hide this plumbing without changing the underlying CBPV structure.
