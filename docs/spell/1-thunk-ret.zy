-- # Chapter 1: Values and Computations

-- Call-by-push-value distinguishes values from computations. We conventionally
-- write `A` for a value type and `B` for a computation type. The term grammar
-- remains uniform: context tells the checker which form a particular term must
-- inhabit.

begin
  param (/core; /numeric; /system) : @(import("../../lib/std/builtin.zy")) that
  let (/Thk; /Ret) = core that
  let (= Int64, int64) = numeric/int64 that
  let (/process) = system that

  -- Integers, characters, and strings are host value types supplied by the
  -- Builtin package. A sealed value definition may bind one directly.
  def zero : Int64 = 0 that

  -- `Ret A` is the simplest computation type: a computation that returns an
  -- `A`. Braces suspend a computation as a value of type `Thk B`.
  def lazy_one : Thk (Ret Int64) = {
    ret 1
  } that

  -- A thunk captures values from its lexical environment. It is not executed
  -- until forced with `!`.
  def lazy_add_one_zero : Thk (Ret Int64) = {
    do x <- ! lazy_one;
    do y <- ret zero;
    ! int64/add x y
  } that

  -- `do x <- computation; tail` eliminates `Ret A`, binding the returned value
  -- in the tail. The right-hand side need not be written literally as `ret`.

  -- Function types `A -> B` are computation types. Consequently, a reusable
  -- function is commonly stored as a thunked computation.
  def decrement : Thk (
       Thk (Ret Int64)
    -> Ret Int64
  ) = {
    fn suspended =>
      do value <- ! suspended;
      ! int64/sub value 1
  } that

  -- The dependency order differs from the presentation order without changing
  -- lexical meaning: all four definitions are candidates within this block.
  -- The final computation forces them and returns an `OS` result.
  do result <- ! decrement lazy_add_one_zero;
  ! process/exit result
end

-- `Thk` and `Ret` are core CBPV constructors bound by opening the Builtin
-- package. Their intrinsic definitions occur once in that package's signature.
-- Arithmetic and process termination are host capabilities selected from the
-- same package; neither class of operation arrives through an ambient prelude.
