-- # Chapter 5: Mutual Recursion through Codata

-- A codata value can collect several observations behind one fixed point.
-- Those observations may invoke one another through the shared value, giving a
-- direct representation of mutually recursive operations.

begin
  param (
    (VType, CType, Thk, Ret, Unit, Int, Char, String, OS, api) :
    @[import("../../lib/std/builtin.zy")] _
  ) that

  def Nat : VType =
    data
    | +Zero : Unit
    | +Successor : Nat
    end
  that
  def Bool =
    data
    | +True : Unit
    | +False : Unit
    end
  that
  def EvenOdd =
    codata
    | .even : Nat -> Ret Bool
    | .odd : Nat -> Ret Bool
    end
  that

  def even_odd : Thk EvenOdd = {
    fix (even_odd : Thk EvenOdd) ->
      comatch
      | .even number ->
        match number
        | +Zero() -> ret +True()
        | +Successor(predecessor) ->
          ! even_odd .odd predecessor
        end
      | .odd number ->
        match number
        | +Zero() -> ret +False()
        | +Successor(predecessor) ->
          ! even_odd .even predecessor
        end
      end
  } that

  -- These wrappers are ordinary projections from the shared recursive object.
  def even : Thk (Nat -> Ret Bool) = {
    fn number ->
      ! even_odd .even number
  } that
  def odd : Thk (Nat -> Ret Bool) = {
    fn number ->
      ! even_odd .odd number
  } that

  def assert_equal : Thk (
    Bool ->
    Bool ->
    Thk OS ->
    OS
  ) = {
    fn actual expected continuation ->
      match actual
      | +True() ->
        match expected
        | +True() -> ! continuation
        | +False() -> ! (api/exit) 1
        end
      | +False() ->
        match expected
        | +True() -> ! (api/exit) 1
        | +False() -> ! continuation
        end
      end
  } that

  do even_two <- ! even +Successor(+Successor(+Zero()));
  do odd_three <-
    ! odd +Successor(+Successor(+Successor(+Zero())));
  do even_one <- ! even +Successor(+Zero());
  do odd_two <- ! odd +Successor(+Successor(+Zero()));
  ! assert_equal even_two +True() {
    ! assert_equal odd_three +True() {
      ! assert_equal even_one +False() {
        ! assert_equal odd_two +False() {
          ! (api/exit) 0
        }
      }
    }
  }
end

-- Type definitions may form recursive SCCs in a block. Term recursion remains
-- explicit: the single computation-level `fix` above is what ties the
-- `even_odd` object to itself.
