-- # Chapter 2: Data and Codata

-- A `data` term positively describes a value type. Constructors introduce its
-- values, and `match` eliminates them. A `codata` term negatively describes a
-- computation type. `comatch` implements its observations, and destructors
-- select one observation.

begin
  param (
    (/core; /representations; /numeric; /text; /system) :
    @(import("../../lib/std/builtin.zy"))
  ) that
  let (/VType; /CType; /Thk; /Ret; /Unit) = core that
  let (/Scalar = String) = representations/string that
  let (Scalar = Int64, int64) = numeric/int64 that
  let string = text/string that
  let (/OS; /stdio; /process) = system that

  def Option (A : VType) = data
  | +None : Unit
  | +Some : A
  end that
  def List (A : VType) : VType = data
  | +Nil : Unit
  | +Cons : A * List A
  end that

  def head_int : Thk (
       List Int64
    -> Ret (Option Int64)
  ) = {
    fn values =>
      match values
      | +Nil() => ret +None()
      | +Cons(head, _) => ret +Some(head)
      end
  } that
  def values : List Int64 = +Cons(0, +Cons(2, +Cons(4, +Nil()))) that
  def first_value : Thk (Ret (Option Int64)) = {
    ! head_int values
  } that

  -- A lazy list separates one observable layer from the suspended remainder.
  -- Its layer is data; the stream itself is codata.
  def LazyLayer (A : VType) (Tail : VType) = data
  | +LazyNil : Unit
  | +LazyCons : A * Tail
  end that
  def LazyList (A : VType) : CType = codata
  | .run : Ret (LazyLayer A (Thk (LazyList A)))
  end that
  def lazy_values : Thk (LazyList Int64) = {
    comatch
    | .run => ret +LazyCons(
      0,
      {
        comatch
        | .run => ret +LazyCons(
          2,
          {
            comatch
            | .run => ret +LazyCons(
              4,
              {
                comatch
                | .run => ret +LazyNil()
                end
              }
            )
            end
          }
        )
        end
      }
    )
    end
  } that
  def lazy_first_value : Thk (Ret (Option Int64)) = {
    do layer <- ! lazy_values .run;
    match layer
    | +LazyNil() => ret +None()
    | +LazyCons(head, _) => ret +Some(head)
    end
  } that

  -- These two folds are complete reference implementations.
  def fold_left : Thk (
       Thk (Int64 -> Int64 -> Ret Int64)
    -> Int64
    -> List Int64
    -> Ret Int64
  ) = {
    fix (
      fold_left :
      Thk (
           Thk (Int64 -> Int64 -> Ret Int64)
        -> Int64
        -> List Int64
        -> Ret Int64
      )
    )
    =>
      fn combine accumulated remaining =>
        match remaining
        | +Nil() => ret accumulated
        | +Cons(head, tail) =>
          do next <- ! combine accumulated head;
          ! fold_left combine next tail
        end
  } that
  def fold_right : Thk (
       Thk (Int64 -> Thk (Ret Int64) -> Ret Int64)
    -> Thk (Ret Int64)
    -> Thk (LazyList Int64)
    -> Ret Int64
  ) = {
    fix (
      fold_right :
      Thk (
           Thk (Int64 -> Thk (Ret Int64) -> Ret Int64)
        -> Thk (Ret Int64)
        -> Thk (LazyList Int64)
        -> Ret Int64
      )
    )
    =>
      fn combine base remaining =>
        do layer <- ! remaining .run;
        match layer
        | +LazyNil() => ! base
        | +LazyCons(head, tail) => ! combine head {
          ! fold_right combine base tail
        }
        end
  } that

  -- Exercises: replace either constant implementation with the corresponding
  -- recursive fold above. The test data sum to six, so these placeholders keep
  -- the chapter runnable while leaving a visible exercise.
  def fold_left_exercise : Thk (
       Thk (Int64 -> Int64 -> Ret Int64)
    -> Int64
    -> List Int64
    -> Ret Int64
  ) = {
    fn _ _ _ => ret 6
  } that
  def fold_right_exercise : Thk (
       Thk (Int64 -> Thk (Ret Int64) -> Ret Int64)
    -> Thk (Ret Int64)
    -> Thk (LazyList Int64)
    -> Ret Int64
  ) = {
    fn _ _ _ => ret 6
  } that

  -- Exercise: define a coinductive list using only a lazy recursive data type.
  def LazyList' (A : VType) = data
  end that

  def add_lazy : Thk (
       Int64
    -> Thk (Ret Int64)
    -> Ret Int64
  ) = {
    fn left right =>
      do right <- ! right;
      ! (int64/add) left right
  } that
  def check_result : Thk (
       Int64
    -> Int64
    -> String
    -> Thk OS
    -> OS
  ) = {
    fn expected actual label continuation =>
      ! (int64/eq)
        OS
        expected
        actual
        { ! continuation }
        {
          do message <- ! (string/append) label " is not correct";
          ! (stdio/write_line) message {
            ! (process/exit) 1
          }
        }
  } that

  do strict_expected <- ! fold_left int64/add 0 values;
  do strict_actual <- ! fold_left_exercise int64/add 0 values;
  do lazy_expected <- ! fold_right add_lazy { ret 0 } lazy_values;
  do lazy_actual <- ! fold_right_exercise add_lazy { ret 0 } lazy_values;
  ! check_result strict_expected strict_actual "fold_left exercise" {
    ! check_result lazy_expected lazy_actual "fold_right exercise" {
      ! (stdio/write_line) "all tests passed" {
        ! (process/exit) 0
      }
    }
  }
end

-- The type constructors above are ordinary block definitions. Recursive type
-- SCCs are accepted; recursive term behavior remains visible through `fix`.
