-- # Chapter 2: Data and Codata

-- A `data` term positively describes a value type. Constructors introduce its
-- values, and `match` eliminates them. A `codata` term negatively describes a
-- computation type. `comatch` implements its observations, and destructors
-- select one observation.

begin
  param (
    (
      /VType;
      /CType;
      /Thk;
      /Ret;
      /Unit;
      /Int;
      /String;
      /OS;
      /add;
      /int_eq_branch;
      /str_append;
      /write_line;
      /exit
    ) :
    @[import("../../lib/std/builtin.zy")] _
  ) that

  def Option (A : VType) =
    data
    | +None : Unit
    | +Some : A
    end
  that
  def List (A : VType) : VType =
    data
    | +Nil : Unit
    | +Cons : A * List A
    end
  that

  def head_int : Thk (
    List Int ->
    Ret (Option Int)
  ) = {
    fn values =>
      match values
      | +Nil() => ret +None()
      | +Cons(head, _) => ret +Some(head)
      end
  } that
  def values : List Int =
    +Cons(0, +Cons(2, +Cons(4, +Nil())))
  that
  def first_value : Thk (Ret (Option Int)) = {
    ! head_int values
  } that

  -- A lazy list separates one observable layer from the suspended remainder.
  -- Its layer is data; the stream itself is codata.
  def LazyLayer (A : VType) (Tail : VType) =
    data
    | +LazyNil : Unit
    | +LazyCons : A * Tail
    end
  that
  def LazyList (A : VType) : CType =
    codata
    | .run : Ret (LazyLayer A (Thk (LazyList A)))
    end
  that
  def lazy_values : Thk (LazyList Int) = {
    comatch
    | .run =>
      ret +LazyCons(0, {
        comatch
        | .run =>
          ret +LazyCons(2, {
            comatch
            | .run =>
              ret +LazyCons(4, {
                comatch
                | .run => ret +LazyNil()
                end
              })
            end
          })
        end
      })
    end
  } that
  def lazy_first_value : Thk (Ret (Option Int)) = {
    do layer <- ! lazy_values .run;
    match layer
    | +LazyNil() => ret +None()
    | +LazyCons(head, _) => ret +Some(head)
    end
  } that

  -- These two folds are complete reference implementations.
  def fold_left : Thk (
    Thk (Int -> Int -> Ret Int) ->
    Int ->
    List Int ->
    Ret Int
  ) = {
    fix (
      fold_left :
      Thk (
        Thk (Int -> Int -> Ret Int) ->
        Int ->
        List Int ->
        Ret Int
      )
    ) =>
      fn combine accumulated remaining =>
        match remaining
        | +Nil() => ret accumulated
        | +Cons(head, tail) =>
          do next <- ! combine accumulated head;
          ! fold_left combine next tail
        end
  } that
  def fold_right : Thk (
    Thk (Int -> Thk (Ret Int) -> Ret Int) ->
    Thk (Ret Int) ->
    Thk (LazyList Int) ->
    Ret Int
  ) = {
    fix (
      fold_right :
      Thk (
        Thk (Int -> Thk (Ret Int) -> Ret Int) ->
        Thk (Ret Int) ->
        Thk (LazyList Int) ->
        Ret Int
      )
    ) =>
      fn combine base remaining =>
        do layer <- ! remaining .run;
        match layer
        | +LazyNil() => ! base
        | +LazyCons(head, tail) =>
          ! combine head {
            ! fold_right combine base tail
          }
        end
  } that

  -- Exercises: replace either constant implementation with the corresponding
  -- recursive fold above. The test data sum to six, so these placeholders keep
  -- the chapter runnable while leaving a visible exercise.
  def fold_left_exercise : Thk (
    Thk (Int -> Int -> Ret Int) ->
    Int ->
    List Int ->
    Ret Int
  ) = {
    fn _ _ _ =>
      ret 6
  } that
  def fold_right_exercise : Thk (
    Thk (Int -> Thk (Ret Int) -> Ret Int) ->
    Thk (Ret Int) ->
    Thk (LazyList Int) ->
    Ret Int
  ) = {
    fn _ _ _ =>
      ret 6
  } that

  -- Exercise: define a coinductive list using only a lazy recursive data type.
  def LazyList' (A : VType) =
    data
    end
  that

  def add_lazy : Thk (
    Int ->
    Thk (Ret Int) ->
    Ret Int
  ) = {
    fn left right =>
      do right <- ! right;
      ! (add) left right
  } that
  def check_result : Thk (
    Int ->
    Int ->
    String ->
    Thk OS ->
    OS
  ) = {
    fn expected actual label continuation =>
      ! (int_eq_branch)
        OS
        expected
        actual
        { ! continuation }
        {
          do message <- ! (str_append) label " is not correct";
          ! (write_line) message {
            ! (exit) 1
          }
        }
  } that

  do strict_expected <- ! fold_left (add) 0 values;
  do strict_actual <- ! fold_left_exercise (add) 0 values;
  do lazy_expected <- ! fold_right add_lazy { ret 0 } lazy_values;
  do lazy_actual <- ! fold_right_exercise add_lazy { ret 0 } lazy_values;
  ! check_result strict_expected strict_actual "fold_left exercise" {
    ! check_result lazy_expected lazy_actual "fold_right exercise" {
      ! (write_line) "all tests passed" {
        ! (exit) 0
      }
    }
  }
end

-- The type constructors above are ordinary block definitions. Recursive type
-- SCCs are accepted; recursive term behavior remains visible through `fix`.
