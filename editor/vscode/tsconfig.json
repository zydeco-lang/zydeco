{
	"compilerOptions": {
		"module": "Node16",
		"target": "es2019",
		"moduleResolution": "Node16",
		"lib": [
			"ES2019"
		],
		"types": [
			"node",
			"vscode"
		],
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
