{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VS Code Extension Prelaunch",
      "dependsOn": [
        "Build Cajun",
        "Compile VS Code Extension"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Build Cajun",
      "type": "cargo",
      "command": "build",
      "args": [
        "-p",
        "cajun"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "Compile VS Code Extension",
      "type": "npm",
      "script": "compile",
      "path": "vscode/",
      "problemMatcher": [
        "$tsc"
      ],
      "group": "build"
    }
  ]
}
